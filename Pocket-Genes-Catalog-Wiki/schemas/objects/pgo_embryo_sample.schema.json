{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_embryo_sample/1.0.0/schema.json",
  "title": "pgo_embryo_sample content",
  "type": "object",
  "description": "Minimal domain content for pgo_embryo_sample.",
  "properties": {
    "sample_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual label or identifier used to distinguish the specimen."
    },
    "material_kind": {
      "type": "string",
      "enum": [
        "embryo_biopsy",
        "whole_embryo",
        "polar_body",
        "other"
      ],
      "description": "Kind of embryo-derived material.",
      "x-enum-labels": [
        "Embryo biopsy",
        "Whole embryo",
        "Polar body",
        "Other"
      ]
    },
    "embryo_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Associated embryo identifier when known."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "sample_label",
    "material_kind"
  ],
  "additionalProperties": false
}
