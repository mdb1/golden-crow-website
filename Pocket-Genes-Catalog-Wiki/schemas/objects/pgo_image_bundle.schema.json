{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_image_bundle/1.0.0/schema.json",
  "title": "pgo_image_bundle content",
  "type": "object",
  "description": "Minimal domain content for pgo_image_bundle.",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Human-facing title."
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "One downloadable image.",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Unique image key within this object."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Readable image name."
          },
          "download_url": {
            "type": "string",
            "minLength": 1,
            "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#\\\\\\s]+(?:[/?#]|$)",
            "description": "HTTPS URL used to download this image."
          }
        },
        "required": [
          "key",
          "name",
          "download_url"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "title",
    "images"
  ],
  "additionalProperties": false
}
