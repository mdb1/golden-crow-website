{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_bundle_of_candidate_genes"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "description": "Candidate gene bundle: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "description": "Synthetic or platform-assigned subject identifier; do not infer identity from a filename."
        },
        "gene_namespace": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier system used by all gene_id entries."
        },
        "genes": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One candidate gene, not a confirmed disease-causing finding.",
            "properties": {
              "gene_id": {
                "type": "string",
                "minLength": 1,
                "description": "Gene identifier in gene_namespace."
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "description": "Provider-assigned candidate rank."
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "Reason for including this candidate."
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One entry."
                },
                "minItems": 1,
                "description": "References supporting inclusion; may point to observation or source identifiers.",
                "uniqueItems": true
              }
            },
            "required": [
              "gene_id",
              "rank",
              "rationale",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Candidate genes selected by the provider."
        },
        "source_symptoms_ref": {
          "type": "object",
          "description": "Symptom bundle used by the provider.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "Method name or version used for prioritization."
        }
      },
      "required": [
        "subject_id",
        "gene_namespace",
        "genes",
        "source_symptoms_ref",
        "method"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.pocketgenes.example/objects/pgo_bundle_of_candidate_genes/1.0.0/schema.json",
  "title": "Candidate gene bundle object"
}
