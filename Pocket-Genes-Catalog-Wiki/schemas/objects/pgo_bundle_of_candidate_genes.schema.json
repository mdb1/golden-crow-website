{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_bundle_of_candidate_genes/1.0.0/schema.json",
  "title": "pgo_bundle_of_candidate_genes content",
  "type": "object",
  "description": "Minimal domain content for pgo_bundle_of_candidate_genes.",
  "properties": {
    "genes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Gene symbol."
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "genes"
  ],
  "additionalProperties": false
}
