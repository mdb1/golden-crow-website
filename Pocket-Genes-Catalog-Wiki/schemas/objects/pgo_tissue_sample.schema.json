{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_tissue_sample/1.0.0/schema.json",
  "title": "pgo_tissue_sample content",
  "type": "object",
  "description": "Minimal domain content for pgo_tissue_sample.",
  "properties": {
    "sample_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual label or identifier used to distinguish the specimen."
    },
    "anatomical_site": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Readable anatomical site."
    },
    "preparation": {
      "type": "string",
      "enum": [
        "fresh",
        "frozen",
        "formalin_fixed_unembedded",
        "ffpe",
        "alcohol_preserved",
        "other"
      ],
      "description": "Tissue preparation.",
      "x-enum-labels": [
        "Fresh",
        "Frozen",
        "Formalin-fixed, unembedded",
        "FFPE",
        "Alcohol-preserved",
        "Other"
      ]
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "sample_label"
  ],
  "additionalProperties": false
}
