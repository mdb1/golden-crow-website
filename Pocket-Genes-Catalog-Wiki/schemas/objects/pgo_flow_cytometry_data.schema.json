{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_flow_cytometry_data"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "description": "Flow cytometry data: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "description": "Synthetic or platform-assigned subject identifier; do not infer identity from a filename."
        },
        "order_ref": {
          "type": "object",
          "description": "Related test order when applicable.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "source_sample_ref": {
          "type": "object",
          "description": "Physical sample used in acquisition.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "fcs_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the native FCS format."
        },
        "panel_id": {
          "type": "string",
          "minLength": 1,
          "description": "Versioned panel identifier."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One acquired channel.",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Native FCS channel name."
              },
              "marker": {
                "type": "string",
                "minLength": 1,
                "description": "Marker or signal description."
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "description": "Measurement unit or scale label."
              }
            },
            "required": [
              "name",
              "marker",
              "unit"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Measurement channels present in the file."
        },
        "event_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of acquired events in the native payload."
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "description": "Instrument identifier."
        },
        "acquired_at": {
          "type": "string",
          "minLength": 1,
          "description": "Acquisition time.",
          "format": "date-time"
        },
        "analysis_profile": {
          "type": "string",
          "minLength": 1,
          "description": "Panel and signal interpretation contract accepted by a receiving analysis service."
        }
      },
      "required": [
        "subject_id",
        "source_sample_ref",
        "fcs_version",
        "panel_id",
        "channels",
        "event_count",
        "instrument_id",
        "acquired_at",
        "analysis_profile"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.pocketgenes.example/objects/pgo_flow_cytometry_data/1.0.0/schema.json",
  "title": "Flow cytometry data object"
}
