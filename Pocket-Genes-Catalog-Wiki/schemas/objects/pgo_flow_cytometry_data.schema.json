{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_flow_cytometry_data/1.0.0/schema.json",
  "title": "pgo_flow_cytometry_data content",
  "type": "object",
  "description": "Minimal domain content for pgo_flow_cytometry_data.",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Human-facing title."
    },
    "download_url": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#\\\\\\s]+(?:[/?#]|$)",
      "description": "HTTPS URL used to download the native file."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "title",
    "download_url"
  ],
  "additionalProperties": false
}
