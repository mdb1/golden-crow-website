{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_bundle_of_symptoms/1.0.0/schema.json",
  "title": "pgo_bundle_of_symptoms content",
  "type": "object",
  "description": "Minimal domain content for pgo_bundle_of_symptoms.",
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "One symptom observation.",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Readable symptom or observation."
          },
          "presence": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "uncertain"
            ],
            "description": "Observation presence."
          },
          "code": {
            "type": "object",
            "description": "Optional terminology code.",
            "properties": {
              "system": {
                "type": "string",
                "enum": [
                  "hpo",
                  "snomed_ct",
                  "other"
                ],
                "description": "Terminology system."
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Code in the selected terminology system."
              }
            },
            "required": [
              "system",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "observations"
  ],
  "additionalProperties": false
}
