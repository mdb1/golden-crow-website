{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_interactive_report/1.0.0/schema.json",
  "title": "Interactive genomic report object",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_interactive_report"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^obj_[A-Za-z0-9_]+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "data": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string"
        },
        "order_ref": {
          "type": "object",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "reference_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "analysis_support": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "sufficient",
                "partial",
                "unassessed"
              ]
            },
            "evaluated_genes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "supported_variant_classes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "reference",
                  "summary"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "evaluated_genes",
            "supported_variant_classes",
            "evidence",
            "limitations"
          ],
          "additionalProperties": false
        },
        "native_format": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "extension": {
                  "const": ".pgi1.json"
                },
                "api_model": {
                  "const": "MDMAPIModel"
                },
                "schema_path": {
                  "const": "schemas/protocol/pgi1-mdm.schema.json"
                },
                "provider_format": {
                  "const": "mdm"
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "extension",
                "api_model",
                "schema_path",
                "provider_format",
                "model_version"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "extension": {
                  "const": ".pgi2.json"
                },
                "api_model": {
                  "const": "AGAPIModel"
                },
                "schema_path": {
                  "const": "schemas/protocol/pgi2-ag.schema.json"
                },
                "provider_format": {
                  "const": "ag"
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "extension",
                "api_model",
                "schema_path",
                "provider_format",
                "model_version"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "extension": {
                  "const": ".pgi3.json"
                },
                "api_model": {
                  "const": "TwoPQAPIModel"
                },
                "schema_path": {
                  "const": "schemas/protocol/pgi3-2pq.schema.json"
                },
                "provider_format": {
                  "const": "2pq"
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "extension",
                "api_model",
                "schema_path",
                "provider_format",
                "model_version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "payload_ref": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "role",
            "path",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "additionalProperties": false
        },
        "source_variants_ref": {
          "type": "object",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "result_summary": {
          "type": "string"
        },
        "method_summary": {
          "type": "string"
        },
        "produced_by": {
          "type": "string"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source_kind": {
              "type": "string",
              "enum": [
                "imported",
                "provider_generated"
              ]
            },
            "source_label": {
              "type": "string"
            },
            "imported_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "producer_label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "source_kind",
            "source_label"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "subject_id",
        "reference_id",
        "profile_id",
        "analysis_support",
        "native_format",
        "payload_ref",
        "result_summary",
        "method_summary",
        "produced_by",
        "produced_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "native_format": {
                "properties": {
                  "extension": {
                    "const": ".pgi1.json"
                  }
                },
                "required": [
                  "extension"
                ]
              }
            },
            "required": [
              "native_format"
            ]
          },
          "then": {
            "properties": {
              "payload_ref": {
                "properties": {
                  "path": {
                    "pattern": "\\.pgi1\\.json$"
                  },
                  "media_type": {
                    "const": "application/vnd.pocketgenes.pgi1+json"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_format": {
                "properties": {
                  "extension": {
                    "const": ".pgi2.json"
                  }
                },
                "required": [
                  "extension"
                ]
              }
            },
            "required": [
              "native_format"
            ]
          },
          "then": {
            "properties": {
              "payload_ref": {
                "properties": {
                  "path": {
                    "pattern": "\\.pgi2\\.json$"
                  },
                  "media_type": {
                    "const": "application/vnd.pocketgenes.pgi2+json"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_format": {
                "properties": {
                  "extension": {
                    "const": ".pgi3.json"
                  }
                },
                "required": [
                  "extension"
                ]
              }
            },
            "required": [
              "native_format"
            ]
          },
          "then": {
            "properties": {
              "payload_ref": {
                "properties": {
                  "path": {
                    "pattern": "\\.pgi3\\.json$"
                  },
                  "media_type": {
                    "const": "application/vnd.pocketgenes.pgi3+json"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false
}
