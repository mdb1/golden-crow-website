{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_pdf_report/1.0.0/schema.json",
  "title": "pgo_pdf_report content",
  "type": "object",
  "description": "Minimal domain content for pgo_pdf_report.",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Human-facing title."
    },
    "download_url": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#\\\\\\s]+/[^?#\\\\\\s]*\\.[Pp][Dd][Ff](?:[?#][^\\\\\\s]*)?$",
      "description": "Valid HTTPS URL ending in .pdf, optionally followed by a query string or fragment."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "title",
    "download_url"
  ],
  "additionalProperties": false
}
