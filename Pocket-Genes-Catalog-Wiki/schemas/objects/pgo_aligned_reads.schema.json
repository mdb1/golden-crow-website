{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_aligned_reads/1.0.0/schema.json",
  "title": "pgo_aligned_reads content",
  "type": "object",
  "description": "Minimal domain content for pgo_aligned_reads.",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Human-facing title."
    },
    "download_url": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#\\\\\\s]+(?:[/?#]|$)",
      "description": "HTTPS URL used to download the aligned reads."
    },
    "index_download_url": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#\\\\\\s]+(?:[/?#]|$)",
      "description": "HTTPS URL used to download the optional alignment index."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "title",
    "download_url"
  ],
  "additionalProperties": false
}
