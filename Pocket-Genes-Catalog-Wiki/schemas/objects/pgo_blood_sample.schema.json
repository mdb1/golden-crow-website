{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_blood_sample/1.0.0/schema.json",
  "title": "pgo_blood_sample content",
  "type": "object",
  "description": "Minimal domain content for pgo_blood_sample.",
  "properties": {
    "sample_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual label or identifier used to distinguish the specimen."
    },
    "material": {
      "type": "string",
      "enum": [
        "whole_blood",
        "plasma",
        "serum",
        "buffy_coat",
        "dried_blood_spot",
        "other"
      ],
      "description": "Blood material.",
      "x-enum-labels": [
        "Whole blood",
        "Plasma",
        "Serum",
        "Buffy coat",
        "Dried blood spot",
        "Other"
      ]
    },
    "container": {
      "type": "string",
      "enum": [
        "edta_tube",
        "heparin_tube",
        "citrate_tube",
        "serum_tube",
        "dna_stabilization_tube",
        "rna_stabilization_tube",
        "sterile_container",
        "swab_collection_kit",
        "saliva_collection_kit",
        "cryovial",
        "filter_paper_card",
        "formalin_container",
        "other"
      ],
      "description": "Specimen container.",
      "x-enum-labels": [
        "EDTA tube",
        "Heparin tube",
        "Citrate tube",
        "Serum tube",
        "DNA stabilization tube",
        "RNA stabilization tube",
        "Sterile container",
        "Swab collection kit",
        "Saliva collection kit",
        "Cryovial",
        "Filter paper card",
        "Formalin container",
        "Other"
      ]
    },
    "volume_ml": {
      "type": "number",
      "minimum": 0,
      "description": "Volume in millilitres."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "sample_label"
  ],
  "additionalProperties": false
}
