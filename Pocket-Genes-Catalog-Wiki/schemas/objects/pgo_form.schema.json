{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_form/1.0.0/schema.json",
  "title": "pgo_form content",
  "type": "object",
  "description": "Minimal domain content for pgo_form.",
  "properties": {
    "form_shape": {
      "type": "object",
      "description": "Frozen form shape.",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "description": "Stable field key.",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Human-readable field label.",
                "maxLength": 120
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "long_text",
                  "email",
                  "phone",
                  "url",
                  "address",
                  "postal_code",
                  "country_code",
                  "identifier",
                  "number",
                  "integer",
                  "positive_integer",
                  "percentage",
                  "boolean",
                  "date",
                  "datetime",
                  "time",
                  "enum",
                  "multi_enum",
                  "string_list",
                  "integer_list",
                  "number_list"
                ],
                "description": "Field value and validation type."
              },
              "required": {
                "type": "boolean",
                "description": "Whether an answer must be present."
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "description": "One enum choice.",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128,
                      "description": "Stable stored option value."
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S",
                      "maxLength": 120,
                      "description": "Human-readable option label frozen with the form."
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "description": "Allowed choices. Present only for enum and multi_enum."
              },
              "help_info_text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Optional guidance displayed by the native form.",
                "maxLength": 500
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "required"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "enum",
                        "multi_enum"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "options"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "options"
                    ]
                  }
                }
              }
            ]
          },
          "description": "Ordered frozen field definitions used to render and validate this submission."
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One submitted answer.",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Key of a field declared by form_shape.fields."
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            ],
            "description": "Typed answer validated against the matching frozen field definition."
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "description": "Submitted answers."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "form_shape",
    "fields"
  ],
  "additionalProperties": false
}
