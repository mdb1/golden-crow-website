{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_collection_request/1.0.0/schema.json",
  "title": "pgo_collection_request content",
  "type": "object",
  "description": "Minimal domain content for pgo_collection_request.",
  "properties": {
    "patient": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Patient/source name or meaningful identifier for collection."
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "blood",
        "dried_blood_spot",
        "saliva",
        "buccal_swab",
        "tissue",
        "skin_biopsy",
        "bone_marrow_aspirate",
        "bone_marrow_core",
        "amniotic_fluid",
        "chorionic_villi",
        "cord_blood",
        "cerebrospinal_fluid",
        "urine",
        "stool",
        "hair_follicles",
        "nail_clippings",
        "semen",
        "embryo_biopsy",
        "whole_embryo",
        "polar_body",
        "other"
      ],
      "description": "Biological material to obtain.",
      "x-enum-labels": [
        "Blood",
        "Dried blood spot",
        "Saliva",
        "Buccal swab",
        "Tissue",
        "Skin biopsy",
        "Bone marrow aspirate",
        "Bone marrow core biopsy",
        "Amniotic fluid",
        "Chorionic villi",
        "Cord blood",
        "Cerebrospinal fluid",
        "Urine",
        "Stool",
        "Hair follicles",
        "Nail clippings",
        "Semen",
        "Embryo biopsy",
        "Whole embryo",
        "Polar body",
        "Other"
      ]
    },
    "collection_method": {
      "type": "string",
      "enum": [
        "venous_blood_draw",
        "capillary_blood_collection",
        "buccal_swab",
        "saliva_collection",
        "needle_aspiration",
        "core_biopsy",
        "surgical_biopsy",
        "skin_punch_biopsy",
        "amniocentesis",
        "chorionic_villus_sampling",
        "lumbar_puncture",
        "embryo_biopsy",
        "polar_body_biopsy",
        "self_collection",
        "other"
      ],
      "description": "Method used to obtain the biological material.",
      "x-enum-labels": [
        "Venous blood draw",
        "Capillary blood collection",
        "Buccal swab",
        "Saliva collection",
        "Needle aspiration",
        "Core biopsy",
        "Surgical biopsy",
        "Skin punch biopsy",
        "Amniocentesis",
        "Chorionic villus sampling",
        "Lumbar puncture",
        "Embryo biopsy",
        "Polar body biopsy",
        "Self-collection",
        "Other"
      ]
    },
    "container": {
      "type": "string",
      "enum": [
        "edta_tube",
        "heparin_tube",
        "citrate_tube",
        "serum_tube",
        "dna_stabilization_tube",
        "rna_stabilization_tube",
        "sterile_container",
        "swab_collection_kit",
        "saliva_collection_kit",
        "cryovial",
        "filter_paper_card",
        "formalin_container",
        "other"
      ],
      "description": "Collection container or kit.",
      "x-enum-labels": [
        "EDTA tube",
        "Heparin tube",
        "Citrate tube",
        "Serum tube",
        "DNA stabilization tube",
        "RNA stabilization tube",
        "Sterile container",
        "Swab collection kit",
        "Saliva collection kit",
        "Cryovial",
        "Filter paper card",
        "Formalin container",
        "Other"
      ]
    },
    "requested_quantity": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Readable quantity including its unit, for example 2 mL."
    },
    "collection_site": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Readable collection location."
    },
    "scheduled_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Scheduled collection time.",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "patient",
    "sample_type"
  ],
  "additionalProperties": false
}
