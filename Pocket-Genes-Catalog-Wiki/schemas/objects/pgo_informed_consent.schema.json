{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_informed_consent/1.0.0/schema.json",
  "title": "pgo_informed_consent content",
  "type": "object",
  "description": "Minimal domain content for pgo_informed_consent.",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Consent title."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual consent text."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "withdrawn"
      ],
      "description": "Consent workflow state."
    },
    "accepted_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual person who accepted the consent."
    },
    "accepted_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual acceptance time.",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "title",
    "text"
  ],
  "additionalProperties": false
}
