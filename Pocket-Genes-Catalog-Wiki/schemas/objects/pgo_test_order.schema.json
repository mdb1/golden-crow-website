{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_test_order/1.0.0/schema.json",
  "title": "pgo_test_order content",
  "type": "object",
  "description": "Minimal domain content for pgo_test_order.",
  "properties": {
    "patient": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Patient/source name or meaningful identifier supplied for this order."
    },
    "test_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual requested test name."
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "blood",
        "dried_blood_spot",
        "saliva",
        "buccal_swab",
        "tissue",
        "skin_biopsy",
        "bone_marrow_aspirate",
        "bone_marrow_core",
        "amniotic_fluid",
        "chorionic_villi",
        "cord_blood",
        "cerebrospinal_fluid",
        "urine",
        "stool",
        "hair_follicles",
        "nail_clippings",
        "semen",
        "embryo_biopsy",
        "whole_embryo",
        "polar_body",
        "plasma",
        "serum",
        "extracted_dna",
        "extracted_rna",
        "other"
      ],
      "description": "Specimen or material expected by the testing provider.",
      "x-enum-labels": [
        "Blood",
        "Dried blood spot",
        "Saliva",
        "Buccal swab",
        "Tissue",
        "Skin biopsy",
        "Bone marrow aspirate",
        "Bone marrow core biopsy",
        "Amniotic fluid",
        "Chorionic villi",
        "Cord blood",
        "Cerebrospinal fluid",
        "Urine",
        "Stool",
        "Hair follicles",
        "Nail clippings",
        "Semen",
        "Embryo biopsy",
        "Whole embryo",
        "Polar body",
        "Plasma",
        "Serum",
        "Extracted DNA",
        "Extracted RNA",
        "Other"
      ]
    },
    "test_type": {
      "type": "string",
      "enum": [
        "single_gene",
        "gene_panel",
        "exome_sequencing",
        "genome_sequencing",
        "targeted_variant_testing",
        "repeat_expansion_testing",
        "methylation_analysis",
        "chromosomal_microarray",
        "karyotype",
        "fish",
        "other"
      ],
      "description": "Optional broad test category.",
      "x-enum-labels": [
        "Single-gene test",
        "Gene panel",
        "Exome sequencing",
        "Genome sequencing",
        "Targeted variant testing",
        "Repeat expansion testing",
        "Methylation analysis",
        "Chromosomal microarray",
        "Karyotype",
        "FISH",
        "Other"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Optional objective for the test."
    },
    "clinical_suspicion": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Optional clinical suspicion."
    },
    "genes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Gene symbol."
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "patient",
    "test_name",
    "sample_type"
  ],
  "additionalProperties": false
}
