{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/objects/pgo_dna_sample/1.0.0/schema.json",
  "title": "pgo_dna_sample content",
  "type": "object",
  "description": "Minimal domain content for pgo_dna_sample.",
  "properties": {
    "sample_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Actual label or identifier used to distinguish the specimen."
    },
    "volume_ul": {
      "type": "number",
      "minimum": 0,
      "description": "Volume in microlitres."
    },
    "concentration_ng_ul": {
      "type": "number",
      "minimum": 0,
      "description": "Concentration in nanograms per microlitre."
    },
    "notes": {
      "type": "string",
      "description": "Optional additional information the person wants to communicate. It may be empty."
    }
  },
  "required": [
    "sample_label"
  ],
  "additionalProperties": false
}
