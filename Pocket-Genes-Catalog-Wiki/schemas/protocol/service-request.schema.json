{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/protocol/service-request/1.0.0/schema.json",
  "title": "Pocket Genes service request v1.0.0",
  "description": "Self-contained draft protocol schema for the proposed v1 mock catalog. Structural validation does not replace role, identity, scope or analytical-sufficiency checks.",
  "$ref": "#/$defs/service_request",
  "$defs": {
    "object_reference": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^obj_[A-Za-z0-9_]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "object_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "role_reference": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object_ref": {
          "$ref": "#/$defs/object_reference"
        }
      },
      "required": [
        "role",
        "object_ref"
      ],
      "additionalProperties": false
    },
    "field_option": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "field_definition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "integer",
            "boolean",
            "date",
            "datetime",
            "enum",
            "multi_enum",
            "string_list"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_option"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "enum",
                  "multi_enum"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        }
      ]
    },
    "form_shape": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgfs_[A-Za-z0-9_]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_definition"
          },
          "minItems": 2,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "key": {
                    "const": "requested_at"
                  },
                  "type": {
                    "const": "datetime"
                  },
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "key",
                  "type",
                  "required"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "key": {
                    "const": "requested_by"
                  },
                  "type": {
                    "const": "text"
                  },
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "key",
                  "type",
                  "required"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "fields"
      ],
      "additionalProperties": false
    },
    "form_field": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "form_data": {
      "type": "object",
      "description": "Form: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "form_shape_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the form_shape published by the requested service."
        },
        "form_shape_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Exact integer version of the form_shape used to fill and validate this form."
        },
        "form_shape": {
          "type": "object",
          "description": "Immutable copy of the exact published form shape used for this submission. It makes the form independently reconstructable after the offer changes.",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "allow_unknown_fields": {
              "const": false
            },
            "fields": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "text",
                      "number",
                      "integer",
                      "boolean",
                      "date",
                      "datetime",
                      "enum",
                      "multi_enum",
                      "string_list"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "value",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "key",
                  "label",
                  "type",
                  "required",
                  "options"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "enum",
                            "multi_enum"
                          ]
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "options": {
                          "minItems": 1
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "options": {
                          "maxItems": 0
                        }
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "const": "requested_at"
                      },
                      "type": {
                        "const": "datetime"
                      },
                      "required": {
                        "const": true
                      }
                    },
                    "required": [
                      "key",
                      "type",
                      "required"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "const": "requested_by"
                      },
                      "type": {
                        "const": "text"
                      },
                      "required": {
                        "const": true
                      }
                    },
                    "required": [
                      "key",
                      "type",
                      "required"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          },
          "required": [
            "id",
            "version",
            "allow_unknown_fields",
            "fields"
          ],
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One filled field.",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "description": "Field key declared in the service form_shape."
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "array"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Filled value. Actual type, requiredness, and enum options are enforced by the referenced form_shape."
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "description": "Filled request fields, including requested_at and requested_by."
        }
      },
      "required": [
        "form_shape_id",
        "form_shape_version",
        "form_shape",
        "fields"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "fields": {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "requested_at"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        },
        {
          "properties": {
            "fields": {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "requested_by"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      ]
    },
    "file_descriptor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "role",
        "path",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "form_object": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^obj_[A-Za-z0-9_]+$"
        },
        "object_type": {
          "const": "pgo_form"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_reference"
          },
          "minItems": 0
        },
        "data": {
          "$ref": "#/$defs/form_data"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_descriptor"
          },
          "minItems": 0
        }
      },
      "required": [
        "object_id",
        "object_type",
        "schema_version",
        "revision",
        "created_at",
        "created_by",
        "input_refs",
        "data",
        "files"
      ],
      "additionalProperties": false
    },
    "cardinality": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "const": 1
        },
        "max": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "input_slot": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "accepted_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pgo_form",
              "pgo_bundle_of_symptoms",
              "pgo_bundle_of_candidate_genes",
              "pgo_informed_consent",
              "pgo_test_order",
              "pgo_collection_request",
              "pgo_blood_sample",
              "pgo_tissue_sample",
              "pgo_embryo_sample",
              "pgo_dna_sample",
              "pgo_sequence_reads",
              "pgo_sequence_data",
              "pgo_aligned_reads",
              "pgo_unannotated_vcf",
              "pgo_annotated_vcf",
              "pgo_interactive_report",
              "pgo_pdf_report",
              "pgo_image_bundle",
              "pgo_karyotype_result",
              "pgo_flow_cytometry_data"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1
        },
        "required": {
          "type": "boolean",
          "const": true
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        }
      },
      "required": [
        "role",
        "accepted_types",
        "required",
        "cardinality"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "pgo_form"
              }
            },
            "required": [
              "objectType"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "form"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accepted_types": {
                "contains": {
                  "const": "pgo_form"
                }
              }
            },
            "required": [
              "accepted_types"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "form"
              }
            }
          }
        }
      ]
    },
    "output_slot": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "pgo_bundle_of_symptoms",
                "pgo_bundle_of_candidate_genes",
                "pgo_informed_consent",
                "pgo_test_order",
                "pgo_collection_request",
                "pgo_blood_sample",
                "pgo_tissue_sample",
                "pgo_embryo_sample",
                "pgo_dna_sample",
                "pgo_sequence_reads",
                "pgo_sequence_data",
                "pgo_aligned_reads",
                "pgo_unannotated_vcf",
                "pgo_annotated_vcf",
                "pgo_interactive_report",
                "pgo_pdf_report",
                "pgo_image_bundle",
                "pgo_karyotype_result",
                "pgo_flow_cytometry_data"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^same_as:[a-z][a-z0-9_]*$"
            }
          ]
        },
        "mutation_mode": {
          "type": "string",
          "enum": [
            "new_object",
            "new_revision"
          ]
        },
        "same_identity_as_input": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "role",
        "object_type",
        "mutation_mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mutation_mode": {
                "const": "new_revision"
              }
            }
          },
          "then": {
            "required": [
              "same_identity_as_input"
            ]
          },
          "else": {
            "not": {
              "required": [
                "same_identity_as_input"
              ]
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "object_ref": {
          "$ref": "#/$defs/object_reference"
        },
        "retryable_after_correction": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "service_request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgr_[A-Za-z0-9_]+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "validating",
            "accepted",
            "queued",
            "running",
            "awaiting_input",
            "delivered",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        }
      },
      "required": [
        "request_id",
        "service_id",
        "service_version",
        "inputs"
      ],
      "additionalProperties": false
    },
    "service_result": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgr_[A-Za-z0-9_]+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "validating",
            "accepted",
            "queued",
            "running",
            "awaiting_input",
            "delivered",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        }
      },
      "required": [
        "request_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "delivered"
              }
            }
          },
          "then": {
            "required": [
              "outputs"
            ],
            "properties": {
              "outputs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "commercial_terms": {
      "type": "object",
      "properties": {
        "price": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z]{3}$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "summary"
              ]
            },
            {
              "required": [
                "amount",
                "currency"
              ]
            }
          ]
        },
        "turnaround": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[1-9][0-9]*(w|d|h|m)$"
        },
        "turnaround_starts_at": {
          "type": "string",
          "minLength": 1
        },
        "tax_and_payment_policy": {
          "type": "string",
          "minLength": 1
        },
        "failure_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pricingModel": {
                "const": "fixed"
              }
            },
            "required": [
              "pricingModel"
            ]
          },
          "then": {
            "required": [
              "price"
            ],
            "properties": {
              "price": {
                "required": [
                  "amount",
                  "currency"
                ]
              }
            }
          }
        }
      ]
    },
    "service_definition": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
