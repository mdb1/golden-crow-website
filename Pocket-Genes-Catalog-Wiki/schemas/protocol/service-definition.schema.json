{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/protocol/service-definition/1.0.0/schema.json",
  "title": "Pocket Genes service definition v1.0.0",
  "description": "Self-contained draft protocol schema for the proposed v1 mock catalog. Structural validation does not replace role, identity, scope or analytical-sufficiency checks.",
  "$ref": "#/$defs/service_definition",
  "$defs": {
    "object_reference": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^obj_[A-Za-z0-9_]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "object_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "role_reference": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object_ref": {
          "$ref": "#/$defs/object_reference"
        }
      },
      "required": [
        "role",
        "object_ref"
      ],
      "additionalProperties": false
    },
    "field_option": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "field_definition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Stable lower snake-case field key.",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Human-readable label.",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "long_text",
            "email",
            "phone",
            "url",
            "address",
            "postal_code",
            "country_code",
            "identifier",
            "number",
            "integer",
            "positive_integer",
            "percentage",
            "boolean",
            "date",
            "datetime",
            "time",
            "enum",
            "multi_enum",
            "string_list",
            "integer_list",
            "number_list"
          ],
          "description": "Field value and validation type."
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "description": "One enum choice.",
            "properties": {
             "value": {
               "type": "string",
               "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
               "description": "Stable stored option value."
             },
             "label": {
               "type": "string",
               "minLength": 1,
               "pattern": "\\S",
                "maxLength": 120,
               "description": "Human-readable option label frozen with the form."
             }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "helpInfoText": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Optional requester-facing guidance.",
          "maxLength": 500
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "enum",
                  "multi_enum"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        }
      ]
    },
    "form_shape": {
      "type": "object",
      "description": "Published service-offer form configuration.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgfs_[A-Za-z0-9_]+$",
          "description": "Generated pgfs_ form-shape identifier."
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "description": "Stable lower snake-case field key.",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Human-readable label.",
                "maxLength": 120
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "long_text",
                  "email",
                  "phone",
                  "url",
                  "address",
                  "postal_code",
                  "country_code",
                  "identifier",
                  "number",
                  "integer",
                  "positive_integer",
                  "percentage",
                  "boolean",
                  "date",
                  "datetime",
                  "time",
                  "enum",
                  "multi_enum",
                  "string_list",
                  "integer_list",
                  "number_list"
                ],
                "description": "Field value and validation type."
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "description": "One enum choice.",
                  "properties": {
                   "value": {
                     "type": "string",
                     "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128,
                     "description": "Stable stored option value."
                   },
                   "label": {
                     "type": "string",
                     "minLength": 1,
                     "pattern": "\\S",
                      "maxLength": 120,
                     "description": "Human-readable option label frozen with the form."
                   }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "helpInfoText": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Optional requester-facing guidance.",
                "maxLength": 500
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "required"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "enum",
                        "multi_enum"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "options"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "options"
                    ]
                  }
                }
              }
            ]
          }
        },
        "allowUnknownFields": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "id",
        "version",
        "fields",
        "allowUnknownFields"
      ],
      "additionalProperties": false
    },
    "form_field": {
      "type": "object",
      "description": "One submitted answer.",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Key of a field declared by form_shape.fields."
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          ],
          "description": "Typed answer validated against the matching frozen field definition."
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "form_data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.pocketgenes.example/objects/pgo_form/1.0.0/schema.json",
      "title": "pgo_form content",
      "type": "object",
      "description": "Minimal domain content for pgo_form.",
      "properties": {
        "form_shape": {
          "type": "object",
          "description": "Frozen form shape.",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "description": "Stable field key.",
                    "maxLength": 64
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Human-readable field label.",
                    "maxLength": 120
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "long_text",
                      "email",
                      "phone",
                      "url",
                      "address",
                      "postal_code",
                      "country_code",
                      "identifier",
                      "number",
                      "integer",
                      "positive_integer",
                      "percentage",
                      "boolean",
                      "date",
                      "datetime",
                      "time",
                      "enum",
                      "multi_enum",
                      "string_list",
                      "integer_list",
                      "number_list"
                    ],
                    "description": "Field value and validation type."
                  },
                  "required": {
                    "type": "boolean",
                    "description": "Whether an answer must be present."
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "description": "One enum choice.",
                      "properties": {
                       "value": {
                         "type": "string",
                         "minLength": 1,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "maxLength": 128,
                         "description": "Stable stored option value."
                       },
                       "label": {
                         "type": "string",
                         "minLength": 1,
                         "pattern": "\\S",
                          "maxLength": 120,
                         "description": "Human-readable option label frozen with the form."
                       }
                      },
                      "required": [
                        "value",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Allowed choices. Present only for enum and multi_enum."
                  },
                  "help_info_text": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Optional guidance displayed by the native form.",
                    "maxLength": 500
                  }
                },
                "required": [
                  "key",
                  "label",
                  "type",
                  "required"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "enum",
                            "multi_enum"
                          ]
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "required": [
                        "options"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "options"
                        ]
                      }
                    }
                  }
                ]
              },
              "description": "Ordered frozen field definitions used to render and validate this submission."
            }
          },
          "required": [
            "fields"
          ],
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One submitted answer.",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Key of a field declared by form_shape.fields."
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  }
                ],
                "description": "Typed answer validated against the matching frozen field definition."
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          },
          "description": "Submitted answers."
        },
        "notes": {
          "type": "string",
          "description": "Optional additional information the person wants to communicate. It may be empty."
        }
      },
      "required": [
        "form_shape",
        "fields"
      ],
      "additionalProperties": false
    },
    "form_object": {
      "type": "object",
      "description": "Platform fixture surrounding strict pgo_form content.",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^obj_[A-Za-z0-9_]+$",
          "description": "Platform-managed object identity."
        },
        "object_type": {
          "const": "pgo_form"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Platform-managed creator identity."
        },
        "data": {
          "$ref": "#/$defs/form_data"
        }
      },
      "required": [
        "object_id",
        "object_type",
        "schema_version",
        "revision",
        "created_at",
        "created_by",
        "data"
      ],
      "additionalProperties": false
    },
    "cardinality": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "const": 1
        },
        "max": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "input_slot": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "type": "string",
          "enum": [
            "pgo_form",
            "pgo_bundle_of_symptoms",
            "pgo_bundle_of_candidate_genes",
            "pgo_informed_consent",
            "pgo_test_order",
            "pgo_collection_request",
            "pgo_blood_sample",
            "pgo_tissue_sample",
            "pgo_embryo_sample",
            "pgo_dna_sample",
            "pgo_sequence_reads",
            "pgo_sequence_data",
            "pgo_aligned_reads",
            "pgo_unannotated_vcf",
            "pgo_annotated_vcf",
            "pgo_interactive_report",
            "pgo_pdf_report",
            "pgo_image_bundle",
            "pgo_karyotype_result",
            "pgo_flow_cytometry_data"
          ]
        },
        "acceptedTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pgo_form",
              "pgo_bundle_of_symptoms",
              "pgo_bundle_of_candidate_genes",
              "pgo_informed_consent",
              "pgo_test_order",
              "pgo_collection_request",
              "pgo_blood_sample",
              "pgo_tissue_sample",
              "pgo_embryo_sample",
              "pgo_dna_sample",
              "pgo_sequence_reads",
              "pgo_sequence_data",
              "pgo_aligned_reads",
              "pgo_unannotated_vcf",
              "pgo_annotated_vcf",
              "pgo_interactive_report",
              "pgo_pdf_report",
              "pgo_image_bundle",
              "pgo_karyotype_result",
              "pgo_flow_cytometry_data"
            ]
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean",
          "const": true
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        }
      },
      "required": [
        "role",
        "objectType",
        "acceptedTypes",
        "required",
        "cardinality"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "pgo_form"
              }
            },
            "required": [
              "objectType"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "form"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accepted_types": {
                "contains": {
                  "const": "pgo_form"
                }
              }
            },
            "required": [
              "accepted_types"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "form"
              }
            }
          }
        }
      ]
    },
    "output_slot": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "pgo_bundle_of_symptoms",
                "pgo_bundle_of_candidate_genes",
                "pgo_informed_consent",
                "pgo_test_order",
                "pgo_collection_request",
                "pgo_blood_sample",
                "pgo_tissue_sample",
                "pgo_embryo_sample",
                "pgo_dna_sample",
                "pgo_sequence_reads",
                "pgo_sequence_data",
                "pgo_aligned_reads",
                "pgo_unannotated_vcf",
                "pgo_annotated_vcf",
                "pgo_interactive_report",
                "pgo_pdf_report",
                "pgo_image_bundle",
                "pgo_karyotype_result",
                "pgo_flow_cytometry_data"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^same_as:[a-z][a-z0-9_]*$"
            }
          ]
        },
        "mutationMode": {
          "type": "string",
          "enum": [
            "new_object",
            "new_revision"
          ]
        },
        "sameIdentityAsInput": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "role",
        "objectType",
        "mutationMode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mutationMode": {
                "const": "new_revision"
              }
            }
          },
          "then": {
            "required": [
              "sameIdentityAsInput"
            ]
          },
          "else": {
            "not": {
              "required": [
                "sameIdentityAsInput"
              ]
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "object_ref": {
          "$ref": "#/$defs/object_reference"
        },
        "retryable_after_correction": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "service_request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgr_[A-Za-z0-9_]+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "validating",
            "accepted",
            "queued",
            "running",
            "awaiting_input",
            "delivered",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        }
      },
      "required": [
        "request_id",
        "service_id",
        "service_version",
        "inputs"
      ],
      "additionalProperties": false
    },
    "service_result": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgr_[A-Za-z0-9_]+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "validating",
            "accepted",
            "queued",
            "running",
            "awaiting_input",
            "delivered",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "issues": {
