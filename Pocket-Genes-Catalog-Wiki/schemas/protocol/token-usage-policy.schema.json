{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/protocol/token-usage-policy/1.2.0/schema.json",
  "title": "Pocket Genes functional service usage policy v1.2.0",
  "description": "Service-request limits whose mutable state is always projected from root service transactions and is never persisted as counters, balances, last-use dates or deadlines.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "policy_id": {
      "type": "string",
      "const": "pg_usage_policy_service_requests_v1"
    },
    "status": {
      "type": "string",
      "const": "proposed"
    },
    "calendar_timezone": {
      "type": "string",
      "const": "UTC"
    },
    "policy_configuration_defaults": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "const": "pg_usage_policy_service_requests_v1"
        },
        "total_transaction_limit": {
          "type": "integer",
          "const": 20
        },
        "daily_transaction_limit": {
          "type": "integer",
          "const": 5
        },
        "cooldown_seconds": {
          "type": "integer",
          "const": 300
        }
      },
      "required": [
        "policy_id",
        "total_transaction_limit",
        "daily_transaction_limit",
        "cooldown_seconds"
      ],
      "additionalProperties": false
    },
    "functional_accounting": {
      "type": "object",
      "properties": {
        "authoritative_collection": {
          "type": "string",
          "const": "service_transactions"
        },
        "requester_field": {
          "type": "string",
          "const": "requestedByUserId"
        },
        "transaction_time_field": {
          "type": "string",
          "const": "requestedAt"
        },
        "daily_count_interval": {
          "type": "string",
          "minLength": 1
        },
        "daily_count_timezone": {
          "type": "string",
          "const": "UTC"
        },
        "deduplication_key": {
          "type": "string",
          "minLength": 1
        },
        "remaining_total_formula": {
          "type": "string",
          "minLength": 1
        },
        "today_count_formula": {
          "type": "string",
          "minLength": 1
        },
        "last_transaction_formula": {
          "type": "string",
          "minLength": 1
        },
        "cooldown_deadline_formula": {
          "type": "string",
          "minLength": 1
        },
        "next_allowed_formula": {
          "type": "string",
          "minLength": 1
        },
        "seven_day_formula": {
          "type": "string",
          "minLength": 1
        },
        "recompute_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "forbidden_persisted_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "admitted_usage_count",
              "admitted_usage_day_start",
              "today_usage_count",
              "tokens_consumed_today",
              "tokens_remaining_today",
              "last_request_at",
              "next_request_at",
              "cooldown_started_at",
              "cooldown_ends_at",
              "pending_admissions",
              "token_balance"
            ]
          },
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true
        }
      },
      "required": [
        "authoritative_collection",
        "requester_field",
        "transaction_time_field",
        "daily_count_interval",
        "daily_count_timezone",
        "deduplication_key",
        "remaining_total_formula",
        "today_count_formula",
        "last_transaction_formula",
        "cooldown_deadline_formula",
        "next_allowed_formula",
        "seven_day_formula",
        "recompute_on",
        "forbidden_persisted_fields"
      ],
      "additionalProperties": false
    },
    "admission_gate": {
      "type": "object",
      "properties": {
        "must_run_before_provider_dispatch": {
          "type": "boolean",
          "const": true
        },
        "must_run_before_form_object_persistence": {
          "type": "boolean",
          "const": true
        },
        "must_reload_root_transactions": {
          "type": "boolean",
          "const": true
        },
        "derived_state_persistence_forbidden": {
          "type": "boolean",
          "const": true
        },
        "post_approval_limit_revalidation_forbidden": {
          "type": "boolean",
          "const": true
        },
        "only_external_io_failures_may_interrupt_after_approval": {
          "type": "boolean",
          "const": true
        },
        "ordered_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 10,
          "maxItems": 10
        },
        "denied_attempts_do_not": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 7
        }
      },
      "required": [
        "must_run_before_provider_dispatch",
        "must_run_before_form_object_persistence",
        "must_reload_root_transactions",
        "derived_state_persistence_forbidden",
        "post_approval_limit_revalidation_forbidden",
        "only_external_io_failures_may_interrupt_after_approval",
        "ordered_steps",
        "denied_attempts_do_not"
      ],
      "additionalProperties": false
    },
    "pipeline_policy": {
      "type": "object",
      "properties": {
        "planning_consumes_capacity": {
          "type": "boolean",
          "const": false
        },
        "each_created_service_transaction_counts_once": {
          "type": "boolean",
          "const": true
        },
        "combined_published_service_counts_as": {
          "type": "integer",
          "const": 1
        },
        "blocked_step_state": {
          "type": "string",
          "const": "waiting_for_limits"
        },
        "automatic_retry_must_recalculate_from_transactions": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "planning_consumes_capacity",
        "each_created_service_transaction_counts_once",
        "combined_published_service_counts_as",
        "blocked_step_state",
        "automatic_retry_must_recalculate_from_transactions"
      ],
      "additionalProperties": false
    },
    "stable_error_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "token_balance_exhausted",
          "token_daily_limit_reached",
          "token_cooldown_active"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "end_user_presentation": {
      "type": "object",
      "properties": {
        "preferred_term": {
          "type": "string",
          "const": "Limits"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "contact_suffix": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "object",
          "properties": {
            "token_daily_limit_reached": {
              "type": "string",
              "minLength": 1
            },
            "token_balance_exhausted": {
              "type": "string",
              "minLength": 1
            },
            "token_cooldown_active": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "token_daily_limit_reached",
            "token_balance_exhausted",
            "token_cooldown_active"
          ],
          "additionalProperties": false
        },
        "account_status": {
          "type": "object",
          "properties": {
            "day_bucket_timezone": {
              "type": "string",
              "const": "UTC"
            },
            "reset_timestamp_display_timezone": {
              "type": "string",
              "const": "device_local"
            },
            "seven_day_chart_bucket_timezone": {
              "type": "string",
              "const": "UTC"
            },
            "countdown_refresh_seconds": {
              "type": "integer",
              "const": 1
            },
            "overlapping_wait_rule": {
              "type": "string",
              "const": "later_deadline"
            },
            "visible_metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 7,
              "maxItems": 7,
              "uniqueItems": true
            }
          },
          "required": [
            "day_bucket_timezone",
            "reset_timestamp_display_timezone",
            "seven_day_chart_bucket_timezone",
            "countdown_refresh_seconds",
            "overlapping_wait_rule",
            "visible_metrics"
          ],
          "additionalProperties": false
        },
        "disallowed_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "preferred_term",
        "explanation",
        "contact_suffix",
        "messages",
        "account_status",
        "disallowed_patterns"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "status",
    "calendar_timezone",
    "policy_configuration_defaults",
    "functional_accounting",
    "admission_gate",
    "pipeline_policy",
    "stable_error_codes",
    "end_user_presentation"
  ],
  "additionalProperties": false
}
