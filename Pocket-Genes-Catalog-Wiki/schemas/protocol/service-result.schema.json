{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pocketgenes.example/protocol/service-result/1.0.0/schema.json",
  "title": "Pocket Genes service result v1.0.0",
  "description": "Self-contained draft protocol schema for the proposed v1 mock catalog. Structural validation does not replace role, identity, scope or analytical-sufficiency checks.",
  "$ref": "#/$defs/service_result",
  "$defs": {
    "object_reference": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^obj_[A-Za-z0-9_]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "object_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "role_reference": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object_ref": {
          "$ref": "#/$defs/object_reference"
        }
      },
      "required": [
        "role",
        "object_ref"
      ],
      "additionalProperties": false
    },
    "field_option": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "field_definition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "integer",
            "boolean",
            "date",
            "datetime",
            "enum",
            "multi_enum",
            "string_list"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_option"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "enum",
                  "multi_enum"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        }
      ]
    },
    "form_shape": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgfs_[A-Za-z0-9_]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_definition"
          },
          "minItems": 2,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "key": {
                    "const": "requested_at"
                  },
                  "type": {
                    "const": "datetime"
                  },
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "key",
                  "type",
                  "required"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "key": {
                    "const": "requested_by"
                  },
                  "type": {
                    "const": "text"
                  },
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "key",
                  "type",
                  "required"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "fields"
      ],
      "additionalProperties": false
    },
    "form_field": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "form_data": {
      "type": "object",
      "properties": {
        "form_shape_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgfs_[A-Za-z0-9_]+$"
        },
        "form_shape_version": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/form_field"
          },
          "minItems": 2
        }
      },
      "required": [
        "form_shape_id",
        "form_shape_version",
        "fields"
      ],
      "additionalProperties": false
    },
    "file_descriptor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "role",
        "path",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "form_object": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^obj_[A-Za-z0-9_]+$"
        },
        "object_type": {
          "const": "pgo_form"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_reference"
          },
          "minItems": 0
        },
        "data": {
          "$ref": "#/$defs/form_data"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_descriptor"
          },
          "minItems": 0
        }
      },
      "required": [
        "object_id",
        "object_type",
        "schema_version",
        "revision",
        "created_at",
        "created_by",
        "input_refs",
        "data",
        "files"
      ],
      "additionalProperties": false
    },
    "cardinality": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "input_slot": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "accepted_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pgo_form",
              "pgo_bundle_of_symptoms",
              "pgo_bundle_of_candidate_genes",
              "pgo_informed_consent",
              "pgo_test_order",
              "pgo_collection_request",
              "pgo_blood_sample",
              "pgo_tissue_sample",
              "pgo_embryo_sample",
              "pgo_dna_sample",
              "pgo_sequence_reads",
              "pgo_sequence_data",
              "pgo_aligned_reads",
              "pgo_unannotated_vcf",
              "pgo_annotated_vcf",
              "pgo_interactive_report",
              "pgo_pdf_report",
              "pgo_image_bundle",
              "pgo_karyotype_result",
              "pgo_flow_cytometry_data"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1
        },
        "required": {
          "type": "boolean"
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        }
      },
      "required": [
        "role",
        "accepted_types",
        "required",
        "cardinality"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "cardinality": {
                "properties": {
                  "min": {
                    "minimum": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "cardinality": {
                "properties": {
                  "min": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "output_slot": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "pgo_bundle_of_symptoms",
                "pgo_bundle_of_candidate_genes",
                "pgo_informed_consent",
                "pgo_test_order",
                "pgo_collection_request",
                "pgo_blood_sample",
                "pgo_tissue_sample",
                "pgo_embryo_sample",
                "pgo_dna_sample",
                "pgo_sequence_reads",
                "pgo_sequence_data",
                "pgo_aligned_reads",
                "pgo_unannotated_vcf",
                "pgo_annotated_vcf",
                "pgo_interactive_report",
                "pgo_pdf_report",
                "pgo_image_bundle",
                "pgo_karyotype_result",
                "pgo_flow_cytometry_data"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^same_as:[a-z][a-z0-9_]*$"
            }
          ]
        },
        "mutation_mode": {
          "type": "string",
          "enum": [
            "new_object",
            "new_revision"
          ]
        },
        "same_identity_as_input": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "role",
        "object_type",
        "mutation_mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mutation_mode": {
                "const": "new_revision"
              }
            }
          },
          "then": {
            "required": [
              "same_identity_as_input"
            ]
          },
          "else": {
            "not": {
              "required": [
                "same_identity_as_input"
              ]
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "object_ref": {
          "$ref": "#/$defs/object_reference"
        },
        "retryable_after_correction": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "service_request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgr_[A-Za-z0-9_]+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "validating",
            "accepted",
            "queued",
            "running",
            "awaiting_input",
            "completed",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        }
      },
      "required": [
        "service_id",
        "service_version",
        "inputs"
      ],
      "additionalProperties": false
    },
    "service_result": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgr_[A-Za-z0-9_]+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "validating",
            "accepted",
            "queued",
            "running",
            "awaiting_input",
            "completed",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_reference"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        }
      },
      "required": [
        "request_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "outputs"
            ],
            "properties": {
              "outputs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "commercial_terms": {
      "type": "object",
      "properties": {
        "price": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z]{3}$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "summary"
              ]
            },
            {
              "required": [
                "amount",
                "currency"
              ]
            }
          ]
        },
        "turnaround": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[1-9][0-9]*(w|d|h|m)$"
        },
        "turnaround_starts_at": {
          "type": "string",
          "minLength": 1
        },
        "tax_and_payment_policy": {
          "type": "string",
          "minLength": 1
        },
        "failure_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "service_definition": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgs_[A-Za-z0-9_]+$"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "service_version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "test_planning",
              "wet_lab",
              "bioinformatics"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "availability": {
          "type": "string",
          "enum": [
            "mock_catalog_only"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "short_contract": {
          "type": "string",
          "minLength": 1
        },
        "provider_work": {
          "type": "string",
          "minLength": 1
        },
        "form_shape": {
          "$ref": "#/$defs/form_shape"
        },
        "sample_form_data": {
          "$ref": "#/$defs/form_data"
        },
        "sample_form_object": {
          "$ref": "#/$defs/form_object"
        },
        "input_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_slot"
          },
          "minItems": 0
        },
        "output_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output_slot"
          },
          "minItems": 1
        },
        "accepted_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "scope_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "mock_commercial_terms": {
          "$ref": "#/$defs/commercial_terms"
        },
        "sample_request": {
          "$ref": "#/$defs/service_request"
        },
        "sample_result": {
          "$ref": "#/$defs/service_result"
        }
      },
      "required": [
        "service_id",
        "schema_version",
        "service_version",
        "name",
        "provider_id",
        "stages",
        "availability",
        "description",
        "short_contract",
        "provider_work",
        "input_slots",
        "output_slots",
        "sample_request",
        "sample_result"
      ],
      "additionalProperties": false
    },
    "api_capability": {
      "type": "object",
      "properties": {
        "status": {
          "const": "illustrative_not_live"
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "execution_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "completion_model": {
          "const": "asynchronous"
        },
        "callbacks": {
          "const": "signed_callback_to_preregistered_pocket_genes_endpoint"
        },
        "state_semantics": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "complete_example_contract": {
          "type": "string",
          "minLength": 1
        },
        "clinical_role": {
          "type": "string",
          "minLength": 1
        },
        "stage_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "contract_id",
        "base_url",
        "execution_modes",
        "completion_model",
        "callbacks"
      ],
      "additionalProperties": false
    },
    "provider_definition": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pgp_[A-Za-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "bioinformatics_company",
            "cytogenetics_analysis_company",
            "laboratory",
            "professional_services_organization",
            "report_production_company",
            "sample_collection_and_transport_provider"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "supported_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "test_planning",
              "wet_lab",
              "bioinformatics"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "country_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "service_ids": {
          "type": "array",
          "items": {
            "type": "string",
