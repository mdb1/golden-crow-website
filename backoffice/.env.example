# backoffice/.env.example — gc-fitness (Phase 2) runtime env vars
#
# NOTE: this file documents env vars required ONLY for the new
# gc-fitness feature surface added in Phase 2. Existing MyDNAMap /
# Pocket Gyms env vars (NEXT_PUBLIC_FIREBASE_*, NEXTAUTH_*, SDK URLs)
# remain documented in `.env.local.example` — copy from there too
# when bootstrapping a fresh local environment.
#
# DOC DEBT (for plan 02-11 to resolve): merge this file into
# `.env.local.example` once the gc-fitness wiring lands so we have
# a single env-var manifest for the backoffice.

# --- Firebase Web SDK config (client-side, bundle-public) -----------
NEXT_PUBLIC_GC_FITNESS_FIREBASE_API_KEY=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only) -------------------------------
# Service-account fields from the gcfitness-3476b Firebase project.
# GC_FITNESS_FIREBASE_ADMIN_PRIVATE_KEY is base64-encoded to avoid
# newline-escape issues in the Vercel env UI:
#   echo -n "$RAW_PRIVATE_KEY" | base64
GC_FITNESS_FIREBASE_ADMIN_CLIENT_EMAIL=
GC_FITNESS_FIREBASE_ADMIN_PRIVATE_KEY=

# --- gc-fitness app-specific config ---------------------------------
# Comma-separated, lowercased trainer email allowlist. Single source of
# truth for who can access /gc-fitness/* trainer routes.
GC_FITNESS_TEAM_ALLOWLIST=

# Cookie signature key for next-firebase-auth-edge session cookies.
# Generate once: openssl rand -hex 32
# Rotate annually.
GC_FITNESS_COOKIE_SIGNATURE_KEY=
