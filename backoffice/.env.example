# backoffice/.env.example — gc-fitness (Phase 2) runtime env vars
#
# NOTE: this file documents env vars required ONLY for the new
# gc-fitness feature surface added in Phase 2. Existing MyDNAMap /
# Pocket Gyms env vars (NEXT_PUBLIC_FIREBASE_*, NEXTAUTH_*, SDK URLs)
# remain documented in `.env.local.example` — copy from there too
# when bootstrapping a fresh local environment.
#
# DOC DEBT (for plan 02-11 to resolve): merge this file into
# `.env.local.example` once the gc-fitness wiring lands so we have
# a single env-var manifest for the backoffice.

# =====================================================================
# GC Fitness (gcfitness-3476b) — runtime env vars
# =====================================================================
# Phase 11 BO-10 — full Vercel-setup runbook in
# .planning/phases/11-backoffice-slot-in/11-08-env-vars-setup-PLAN.md
# (step-by-step paste flow + troubleshooting).

# --- Firebase Web SDK config (client-side, bundle-public) -----------
# Source: Firebase console -> Project settings (gcfitness-3476b) ->
#   General -> Your apps -> Web app -> Config object. The 6 fields below
#   map 1:1 to the apiKey / authDomain / projectId / storageBucket /
#   messagingSenderId / appId fields of that object.
NEXT_PUBLIC_GC_FITNESS_FIREBASE_API_KEY=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_PROJECT_ID=gcfitness-3476b
NEXT_PUBLIC_GC_FITNESS_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_GC_FITNESS_FIREBASE_APP_ID=
# #378 — Brave / privacy-browser sign-in fix. Set to "true" in PRODUCTION only.
# When enabled, the gc-fitness Web SDK authDomain becomes the app's own origin
# and the Firebase Auth handler is served same-origin via the /__/auth/* +
# /__/firebase/* rewrites in next.config.ts (fixes Brave/Safari/Firefox blocking
# the cross-origin handler). REQUIRES the production domain to be added to the
# gcfitness-3476b project's Firebase Auth → Settings → Authorized domains.
# Leave empty on preview/localhost (keeps the default firebaseapp.com domain).
NEXT_PUBLIC_GC_FITNESS_AUTH_SELF_HOSTED=

# --- Firebase Admin SDK (server-only) -------------------------------
# Source: Firebase console -> Project settings (gcfitness-3476b) ->
#   Service accounts -> Generate new private key. Download the JSON,
#   then extract:
#     - CLIENT_EMAIL = client_email field of the JSON
#     - PRIVATE_KEY  = BASE64-encoded private_key field of the JSON
#
# Why BASE64 (not raw): the Vercel env-var UI mangles the multi-line
#   PEM-formatted private_key (newline-escape issues). Encoding once
#   sidesteps every shell-escape pitfall. The runtime base64-decodes
#   via:
#     Buffer.from(privateKeyB64, "base64").toString("utf8")
#   in `lib/firebase/gc-fitness-admin.ts`.
#
# Encode locally with:
#   printf '%s' '<paste private_key here>' | base64
# Or directly from the downloaded JSON file:
#   python3 -c 'import json,base64,sys; print(base64.b64encode(json.load(open(sys.argv[1]))["private_key"].encode()).decode())' /path/to/service-account.json
#
# NEVER commit the JSON download. Treat the service-account JSON
# like a password — rotate the key in Firebase console if it ever
# leaks (or is suspected to have leaked).
GC_FITNESS_FIREBASE_ADMIN_CLIENT_EMAIL=
GC_FITNESS_FIREBASE_ADMIN_PRIVATE_KEY=

# --- gc-fitness app-specific config ---------------------------------
# Comma-separated, lowercased trainer email allowlist. Single source of
# truth for who can access /gc-fitness/* trainer routes (the auth-helpers.ts
# `getCurrentTrainer()` lowercases on read).
#
# Example:
#   GC_FITNESS_TEAM_ALLOWLIST=manuherrera8@gmail.com,cordero@example.com
#
# Adding / removing an email here takes effect on the NEXT request
# (the allowlist is read on every getCurrentTrainer() call) — no
# redeploy required for allowlist edits in Vercel.
GC_FITNESS_TEAM_ALLOWLIST=

# Cookie signature key for next-firebase-auth-edge session cookies.
# Generate once with:
#   openssl rand -hex 32
# Produces a 64-character hex string. Rotating it invalidates all
# live trainer sessions (everyone must sign in again). Rotate annually
# or whenever a key is suspected of leaking. Use a different value for
# Production vs Preview vs Development environments.
GC_FITNESS_COOKIE_SIGNATURE_KEY=

# --- Client invitation email (#970) — SMTP ---------------------------
# Sending the client an email when a coach adds them.
#
# ⚠️ WHY SMTP AND NOT "SOMETHING IN FIREBASE": Firebase has no
# transactional-email API. The only mail Firebase sends on its own is
# Auth's own (verification / password reset / sign-in link) — console
# templates, auth-flow semantics, and enabling one would add an auth
# provider we deliberately do not have. The `firestore-send-email`
# extension is not an exception either: it asks for SMTP credentials
# exactly like this block does.
#
# CHEAPEST SETUP, NO NEW VENDOR — Gmail / Google Workspace SMTP:
#   1. The sending Google account needs 2-Step Verification ON.
#   2. https://myaccount.google.com/apppasswords -> create an App
#      Password (16 characters). That is the value of
#      GC_FITNESS_SMTP_PASSWORD — NOT the account password.
#   3. HOST=smtp.gmail.com, PORT=465, USER=the full address.
# Free, no signup, no DNS records. Gmail rewrites the From header to the
# authenticated mailbox, so GC_FITNESS_MAIL_FROM is a display name there.
#
# Nothing here is Gmail-specific: switching to Resend / SES / a Workspace
# domain later is these four values and zero code.
#
# LEAVING THESE EMPTY IS A SUPPORTED STATE, and the right one for local
# dev, CI and Vercel previews: no mail is attempted, the send is recorded
# as `skipped`, and the client add succeeds exactly as before. A preview
# deploy emailing a real roster would be an incident, not a test.
GC_FITNESS_SMTP_HOST=
GC_FITNESS_SMTP_PORT=465
GC_FITNESS_SMTP_USER=
GC_FITNESS_SMTP_PASSWORD=
# Optional. Defaults to `GC Fitness <GC_FITNESS_SMTP_USER>`.
GC_FITNESS_MAIL_FROM=
