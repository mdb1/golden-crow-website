{
  "description": "#1648 — habit quantities (agua, pasos). A quantity habit is a BINARY habit (type stays 'binary') with an OPTIONAL daily target: habits.quantityTarget (integer 1…100000) + habits.quantityUnit ('glasses'|'steps'|'minutes'|'times'; absent/unknown ⇒ 'times'). The day's progress lives in habit_logs.quantity (number ≥ 0); habit_logs.value stays the ONLY 'done?' bit every compliance twin reads, written as quantity >= target. 'steps' habits auto-complete from Apple Health / Health Connect. Runners: GCFitnessCoreTests/HabitQuantityTwinVectorTests.swift (HabitQuantity), android core HabitQuantityTwinVectorTest.kt (HabitQuantity), backoffice habit-quantity.test.ts (pinned copy, mdb1/golden-crow-website). target(raw): finite number, rounded half-up, kept only inside 1…100000 — else null. unit(raw): exact known raw value, else 'times'. step(unit): glasses 1, steps 1000, minutes 5, times 1. fraction(q,t) = clamp(q/t, 0, 1). tap(target, unit, log): the row's single control — a live log already done (value true) ⇒ reset (soft-delete); otherwise write quantity = (live ? log.quantity ?? 0 : 0) + step(unit), capped at 1000000, value = quantity >= target. A log is live when it exists and deleted != true; a missing/negative/non-finite log.quantity counts as 0. autoSteps(target, log, steps): steps rounded half-up; steps <= 0 ⇒ no write (null); a soft-deleted log (the client reset the day) ⇒ no write; else quantity = min(max(log.quantity ?? 0, steps), 1000000) (Health never lowers a logged amount), value = log.value == true || quantity >= target (it never un-completes a day); returns null when the live log already has exactly that quantity and value.",
  "target": [
    { "raw": 8, "expected": 8 },
    { "raw": 10000, "expected": 10000 },
    { "raw": 1, "expected": 1 },
    { "raw": 100000, "expected": 100000 },
    { "raw": 7.6, "expected": 8 },
    { "raw": 2.5, "expected": 3 },
    { "raw": 0.4, "expected": null },
    { "raw": 0, "expected": null },
    { "raw": -3, "expected": null },
    { "raw": 100001, "expected": null },
    { "raw": null, "expected": null }
  ],
  "unit": [
    { "raw": "glasses", "expected": "glasses" },
    { "raw": "steps", "expected": "steps" },
    { "raw": "minutes", "expected": "minutes" },
    { "raw": "times", "expected": "times" },
    { "raw": null, "expected": "times" },
    { "raw": "liters", "expected": "times" },
    { "raw": "Steps", "expected": "times" },
    { "raw": "", "expected": "times" }
  ],
  "step": [
    { "unit": "glasses", "expected": 1 },
    { "unit": "steps", "expected": 1000 },
    { "unit": "minutes", "expected": 5 },
    { "unit": "times", "expected": 1 }
  ],
  "fraction": [
    { "quantity": 0, "target": 8, "expected": 0 },
    { "quantity": 3, "target": 8, "expected": 0.375 },
    { "quantity": 8, "target": 8, "expected": 1 },
    { "quantity": 12, "target": 8, "expected": 1 },
    { "quantity": 6240, "target": 10000, "expected": 0.624 },
    { "quantity": -2, "target": 8, "expected": 0 }
  ],
  "tap": [
    { "name": "first tap of the day", "target": 8, "unit": "glasses", "log": null,
      "expected": { "action": "write", "quantity": 1, "value": false } },
    { "name": "adds to the live amount", "target": 8, "unit": "glasses", "log": { "quantity": 3, "value": false },
      "expected": { "action": "write", "quantity": 4, "value": false } },
    { "name": "reaching the target completes the day", "target": 8, "unit": "glasses", "log": { "quantity": 7, "value": false },
      "expected": { "action": "write", "quantity": 8, "value": true } },
    { "name": "steps step is 1000", "target": 10000, "unit": "steps", "log": { "quantity": 9500, "value": false },
      "expected": { "action": "write", "quantity": 10500, "value": true } },
    { "name": "minutes step is 5", "target": 30, "unit": "minutes", "log": { "quantity": 10, "value": false },
      "expected": { "action": "write", "quantity": 15, "value": false } },
    { "name": "a done day resets", "target": 8, "unit": "glasses", "log": { "quantity": 8, "value": true },
      "expected": { "action": "reset" } },
    { "name": "done by an old client or the widget (no quantity) resets too", "target": 8, "unit": "glasses", "log": { "value": true },
      "expected": { "action": "reset" } },
    { "name": "a reset day starts again from zero", "target": 8, "unit": "glasses", "log": { "quantity": 8, "value": true, "deleted": true },
      "expected": { "action": "write", "quantity": 1, "value": false } },
    { "name": "a live log without quantity counts as zero", "target": 2, "unit": "times", "log": { "value": false },
      "expected": { "action": "write", "quantity": 1, "value": false } },
    { "name": "a negative quantity counts as zero", "target": 2, "unit": "times", "log": { "quantity": -5, "value": false },
      "expected": { "action": "write", "quantity": 1, "value": false } },
    { "name": "capped at one million", "target": 100000, "unit": "steps", "log": { "quantity": 999500, "value": false },
      "expected": { "action": "write", "quantity": 1000000, "value": true } },
    { "name": "target of one completes on the first tap", "target": 1, "unit": "times", "log": null,
      "expected": { "action": "write", "quantity": 1, "value": true } }
  ],
  "autoSteps": [
    { "name": "no log yet, below target", "target": 10000, "log": null, "steps": 6240,
      "expected": { "quantity": 6240, "value": false } },
    { "name": "no log yet, target reached", "target": 10000, "log": null, "steps": 12000,
      "expected": { "quantity": 12000, "value": true } },
    { "name": "exact target completes", "target": 10000, "log": null, "steps": 10000,
      "expected": { "quantity": 10000, "value": true } },
    { "name": "Health moved up", "target": 10000, "log": { "quantity": 6240, "value": false }, "steps": 8100,
      "expected": { "quantity": 8100, "value": false } },
    { "name": "same number, no write", "target": 10000, "log": { "quantity": 8100, "value": false }, "steps": 8100,
      "expected": null },
    { "name": "Health never lowers a logged amount", "target": 10000, "log": { "quantity": 9000, "value": false }, "steps": 4000,
      "expected": null },
    { "name": "a lower read keeps the higher manual amount but fills value", "target": 10000, "log": { "quantity": 11000, "value": false }, "steps": 4000,
      "expected": { "quantity": 11000, "value": true } },
    { "name": "never un-completes a day", "target": 10000, "log": { "quantity": 3000, "value": true }, "steps": 5000,
      "expected": { "quantity": 5000, "value": true } },
    { "name": "done without quantity gets the number", "target": 10000, "log": { "value": true }, "steps": 4200,
      "expected": { "quantity": 4200, "value": true } },
    { "name": "zero steps, no write", "target": 10000, "log": null, "steps": 0,
      "expected": null },
    { "name": "a reset day is respected", "target": 10000, "log": { "quantity": 12000, "value": true, "deleted": true }, "steps": 13000,
      "expected": null },
    { "name": "fractional Health sum rounds", "target": 10000, "log": null, "steps": 9999.5,
      "expected": { "quantity": 10000, "value": true } },
    { "name": "capped at one million", "target": 10000, "log": null, "steps": 2500000,
      "expected": { "quantity": 1000000, "value": true } }
  ]
}
