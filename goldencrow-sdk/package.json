{
  "name": "goldencrow-sdk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/check-server-deps.mjs && tsc && node scripts/smoke-boot.mjs && npm test",
    "smoke": "node scripts/smoke-boot.mjs",
    "generate:pgo-schemas": "node scripts/generate-pgo-object-schemas.mjs",
    "generate:pgi-schemas": "node scripts/generate-pgi-native-schemas.mjs",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.cjs",
    "check:no-default-app": "bash ../scripts/check-no-default-app.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^13.10.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vercel/node": "^24.0.1",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
