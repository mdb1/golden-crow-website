FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
TEAM_ALLOWLIST=
PORT=3000
NODE_ENV=development
BACKOFFICE_ORIGIN=http://localhost:3001
GOLDENCROW_OPENAPI_INTERNAL_TOKEN=
# Optional dedicated HMAC secret for one-year native service-notification tokens.
# Use at least 32 bytes. If blank, the server derives an isolated key from the
# configured MyDNAMap Firebase Admin private key.
SERVICE_TRANSACTION_NOTIFICATION_TOKEN_SIGNING_SECRET=
MAIL_FROM=
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SIGNATURE_HTML=
# Optional verified send-as identity for new service-request notifications.
# Defaults to the authenticated Gmail mailbox with a "Pocket Genes no-reply" display name.
SERVICE_TRANSACTION_MAIL_FROM=
CRM_MAIL_FROM=
CRM_GMAIL_USER=
CRM_GMAIL_CLIENT_ID=
CRM_GMAIL_CLIENT_SECRET=
CRM_GMAIL_REFRESH_TOKEN=
CRM_GMAIL_SIGNATURE_HTML=
