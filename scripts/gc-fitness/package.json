    "translate:fexd:prompt": "tsx translate-fexd-batch.ts --emit-prompt",
    "verify-fexd-assets": "tsx verify-fexd-assets.ts",
    "test": "jest"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "gif-encoder-2": "^1.0.5",
    "jpeg-js": "^0.4.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
