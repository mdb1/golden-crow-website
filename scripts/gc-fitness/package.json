{
  "name": "@gc-fitness/curate-library",
  "version": "0.1.0",
  "private": true,
  "description": "GC Fitness exercise-library curation toolkit. Read-only auditor + curation script. Binds firebase-admin to project gcfitness-3476b via the same env-var contract as backoffice/scripts/seed-gc-fitness-library.cjs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit": "tsx audit-exercise-library.ts",
    "audit-fexd": "tsx audit-fexd-library.ts",
    "apply:dry": "tsx curate-exercise-library.ts",
    "apply": "tsx curate-exercise-library.ts --apply",
    "backfill-series-id": "tsx backfill-series-id.ts",
    "backfill-series-id:apply": "tsx backfill-series-id.ts --apply",
    "backfill:fexd-vocab": "tsx backfill-fexd-vocabulary.ts",
    "backfill:fexd-vocab:apply": "tsx backfill-fexd-vocabulary.ts --apply",
    "fetch-fexd-assets": "tsx fetch-fexd-assets.ts",
    "fetch-fexd-assets:apply": "tsx fetch-fexd-assets.ts --apply",
    "rewrite:exercise-refs": "tsx rewrite-exercise-refs.ts",
    "rewrite:exercise-refs:apply": "tsx rewrite-exercise-refs.ts --apply",
    "soft-delete:wger-survivors": "tsx soft-delete-wger-survivors.ts",
    "soft-delete:wger-survivors:apply": "tsx soft-delete-wger-survivors.ts --apply",
    "seed-fexd": "tsx seed-from-fexd.ts",
    "seed-fexd:apply": "tsx seed-from-fexd.ts --apply",
