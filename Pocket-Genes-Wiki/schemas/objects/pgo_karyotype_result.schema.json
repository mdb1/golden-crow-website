{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_karyotype_result"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "description": "Karyotype result: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "description": "Synthetic or platform-assigned subject identifier; do not infer identity from a filename."
        },
        "order_ref": {
          "type": "object",
          "description": "Linked test order when one governs this service.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "source_images_ref": {
          "type": "object",
          "description": "Metaphase image bundle analyzed by the provider.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "notation_system": {
          "type": "string",
          "minLength": 1,
          "description": "System used for the result notation; fixtures use PG_DEMO_NOTATION."
        },
        "result_notation": {
          "type": "string",
          "minLength": 1,
          "description": "Result in the declared notation system."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One finding supported by the submitted images.",
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1,
                "description": "Unique finding identifier."
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "Chromosome finding or observation statement."
              },
              "supporting_image_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One entry."
                },
                "minItems": 1,
                "description": "Images from source_images_ref supporting this finding.",
                "uniqueItems": true
              }
            },
            "required": [
              "finding_id",
              "description",
              "supporting_image_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "description": "Findings supported by the analyzed images."
        },
        "analyzed_image_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of submitted images used in this result."
        },
        "review_status": {
          "type": "string",
          "minLength": 1,
          "description": "Provider-recorded review state.",
          "enum": [
            "automated_draft",
            "professional_reviewed"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the reviewer when professionally reviewed."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One stated limitation."
          },
          "minItems": 0,
          "description": "Limits of the analysis or submitted images."
        }
      },
      "required": [
        "subject_id",
        "source_images_ref",
        "notation_system",
        "result_notation",
        "findings",
        "analyzed_image_count",
        "review_status",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "professional_reviewed"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "required": [
              "reviewer_id"
            ]
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.pocketgenes.example/objects/pgo_karyotype_result/1.0.0/schema.json",
  "title": "Karyotype result object"
}
