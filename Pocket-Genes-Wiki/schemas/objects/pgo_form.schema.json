{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_form"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "description": "Form: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "form_shape_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the form_shape published by the requested service."
        },
        "form_shape_version": {
          "type": "string",
          "minLength": 1,
          "description": "Exact version of the form_shape used to fill and validate this form."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One filled field.",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "description": "Field key declared in the service form_shape."
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "array"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Filled value. Actual type, requiredness, and enum options are enforced by the referenced form_shape."
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "description": "Filled request fields, including requested_at and requested_by."
        }
      },
      "required": [
        "form_shape_id",
        "form_shape_version",
        "fields"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "fields": {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "requested_at"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        },
        {
          "properties": {
            "fields": {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "requested_by"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.pocketgenes.example/objects/pgo_form/1.0.0/schema.json",
  "title": "Form object"
}
