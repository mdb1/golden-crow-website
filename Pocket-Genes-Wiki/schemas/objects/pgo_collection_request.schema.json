{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_collection_request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "description": "Collection request: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "order_ref": {
          "type": "object",
          "description": "Parent test order.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "sample_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Physical sample to pick up.",
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable object identifier.",
                "pattern": "^obj_[A-Za-z0-9_]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "Pinned object revision."
              }
            },
            "required": [
              "object_id",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Identified samples included in this pickup."
        },
        "assigned_provider_id": {
          "type": "string",
          "minLength": 1,
          "description": "Company formally asked to fulfill the request."
        },
        "pickup": {
          "type": "object",
          "description": "Location and contact information for a logistics instruction.",
          "properties": {
            "location_id": {
              "type": "string",
              "minLength": 1,
              "description": "Registered pickup or destination location identifier."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Location display name."
            },
            "address_line": {
              "type": "string",
              "minLength": 1,
              "description": "Address needed by the selected company."
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "description": "City."
            },
            "country_code": {
              "type": "string",
              "minLength": 1,
              "description": "Country code.",
              "pattern": "^[A-Z]{2}$"
            },
            "contact_name": {
              "type": "string",
              "minLength": 1,
              "description": "Contact at the site."
            },
            "contact_phone": {
              "type": "string",
              "minLength": 1,
              "description": "Contact phone used for the request; synthetic in the fixture."
            }
          },
          "required": [
            "location_id",
            "name",
            "address_line",
            "city",
            "country_code",
            "contact_name",
            "contact_phone"
          ],
          "additionalProperties": false
        },
        "destination": {
          "type": "object",
          "description": "Location and contact information for a logistics instruction.",
          "properties": {
            "location_id": {
              "type": "string",
              "minLength": 1,
              "description": "Registered pickup or destination location identifier."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Location display name."
            },
            "address_line": {
              "type": "string",
              "minLength": 1,
              "description": "Address needed by the selected company."
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "description": "City."
            },
            "country_code": {
              "type": "string",
              "minLength": 1,
              "description": "Country code.",
              "pattern": "^[A-Z]{2}$"
            },
            "contact_name": {
              "type": "string",
              "minLength": 1,
              "description": "Contact at the site."
            },
            "contact_phone": {
              "type": "string",
              "minLength": 1,
              "description": "Contact phone used for the request; synthetic in the fixture."
            }
          },
          "required": [
            "location_id",
            "name",
            "address_line",
            "city",
            "country_code",
            "contact_name",
            "contact_phone"
          ],
          "additionalProperties": false
        },
        "window_start": {
          "type": "string",
          "minLength": 1,
          "description": "Start of the requested pickup window.",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "minLength": 1,
          "description": "End of the requested pickup window.",
          "format": "date-time"
        },
        "handling_profile": {
          "type": "string",
          "minLength": 1,
          "description": "Handling profile accepted by the logistics provider."
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "description": "Collection-request lifecycle status.",
          "enum": [
            "requested",
            "accepted",
            "picked_up",
            "delivered",
            "cancelled"
          ]
        }
      },
      "required": [
        "order_ref",
        "sample_refs",
        "assigned_provider_id",
        "pickup",
        "destination",
        "window_start",
        "window_end",
        "handling_profile",
        "status"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.pocketgenes.example/objects/pgo_collection_request/1.0.0/schema.json",
  "title": "Collection request object"
}
