{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "const": "pgo_bundle_of_symptoms"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "description": "Symptom bundle: data payload in the shared Pocket Genes object envelope.",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "description": "Synthetic or platform-assigned subject identifier; do not infer identity from a filename."
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One structured symptom or observation.",
            "properties": {
              "observation_id": {
                "type": "string",
                "minLength": 1,
                "description": "Local identifier for this observation."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Reported symptom or clinical observation text."
              },
              "code_system": {
                "type": "string",
                "minLength": 1,
                "description": "Identifier namespace; demo fixtures use PG_DEMO_OBSERVATION."
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Code in the selected namespace."
              },
              "presence": {
                "type": "string",
                "minLength": 1,
                "description": "Whether the observation was reported present, absent, or uncertain.",
                "enum": [
                  "present",
                  "absent",
                  "uncertain"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "How the observation was obtained.",
                "enum": [
                  "self_report",
                  "professional_observation",
                  "submitted_form"
                ]
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1,
                "description": "Time the observation was recorded.",
                "format": "date-time"
              }
            },
            "required": [
              "observation_id",
              "label",
              "code_system",
              "code",
              "presence",
              "source",
              "recorded_at"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Structured observations for this subject."
        },
        "source_form_ref": {
          "type": "object",
          "description": "Completed form from which this bundle was created.",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable object identifier.",
              "pattern": "^obj_[A-Za-z0-9_]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Pinned object revision."
            }
          },
          "required": [
            "object_id",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "subject_id",
        "observations",
        "source_form_ref"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "revision",
    "created_at",
    "created_by",
    "input_refs",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.pocketgenes.example/objects/pgo_bundle_of_symptoms/1.0.0/schema.json",
  "title": "Symptom bundle object"
}
