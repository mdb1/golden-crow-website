---
import { formatBrandText } from '../utils/brandFormatting';

const { title, description, color, panelKeys = '' } = Astro.props;

const colorMapping = {
  primary: {
    gradient: 'linear-gradient(145deg, #ffe984 0%, #f6c44b 48%, #e0981e 100%)',
    soft: 'rgba(235, 171, 42, 0.1)',
    wash: 'linear-gradient(135deg, rgba(235, 171, 42, 0.11), rgba(235, 171, 42, 0.03))',
    border: 'rgba(235, 171, 42, 0.42)',
    glow: 'rgba(235, 171, 42, 0.28)',
  },
  secondary: {
    gradient: 'linear-gradient(145deg, #ff9f88 0%, #ff6474 46%, #da3464 100%)',
    soft: 'rgba(239, 82, 100, 0.1)',
    wash: 'linear-gradient(135deg, rgba(239, 82, 100, 0.11), rgba(239, 82, 100, 0.03))',
    border: 'rgba(239, 82, 100, 0.4)',
    glow: 'rgba(239, 82, 100, 0.28)',
  },
  success: {
    gradient: 'linear-gradient(145deg, #ffacd9 0%, #d56fab 50%, #9f4d96 100%)',
    soft: 'rgba(211, 101, 166, 0.1)',
    wash: 'linear-gradient(135deg, rgba(211, 101, 166, 0.11), rgba(211, 101, 166, 0.03))',
    border: 'rgba(211, 101, 166, 0.4)',
    glow: 'rgba(211, 101, 166, 0.28)',
  },
  accent: {
    gradient: 'linear-gradient(145deg, #c2b7ff 0%, #8d72ff 48%, #6844d7 100%)',
    soft: 'rgba(129, 103, 238, 0.1)',
    wash: 'linear-gradient(135deg, rgba(129, 103, 238, 0.12), rgba(129, 103, 238, 0.03))',
    border: 'rgba(129, 103, 238, 0.42)',
    glow: 'rgba(129, 103, 238, 0.3)',
  },
  warning: {
    gradient: 'linear-gradient(145deg, #d2ff9c 0%, #8ee17a 30%, #39bb7b 50%, #ffab55 70%, #ff773c 100%)',
    soft: 'rgba(82, 183, 105, 0.1)',
    wash: 'linear-gradient(135deg, rgba(82, 183, 105, 0.1), rgba(255, 145, 65, 0.1))',
    border: 'rgba(117, 190, 90, 0.4)',
    glow: 'rgba(255, 145, 65, 0.26)',
  },
};

const colorTokens = colorMapping[color] || {
  gradient: color || 'linear-gradient(145deg, #ffe984 0%, #f6c44b 48%, #e0981e 100%)',
  soft: 'rgba(175, 130, 50, 0.1)',
  wash: 'linear-gradient(135deg, rgba(175, 130, 50, 0.1), rgba(175, 130, 50, 0.03))',
  border: 'rgba(175, 130, 50, 0.42)',
  glow: 'rgba(175, 130, 50, 0.26)',
};

const panelStyle = [
  `--panel-gradient: ${colorTokens.gradient}`,
  `--panel-soft: ${colorTokens.soft}`,
  `--panel-wash: ${colorTokens.wash}`,
  `--panel-border-color: ${colorTokens.border}`,
  `--panel-glow-color: ${colorTokens.glow}`,
].join('; ');
---

<div
    class="panel-item"
    data-color={color}
    data-panel-card
    data-panel-keys={panelKeys}
    tabindex="0"
    style={panelStyle}
>
    <div class="icon-wrapper">
        <div class="gradient-icon"></div>
    </div>
    <div class="content">
        <h3 class="panel-title" set:html={formatBrandText(title)} />
        <p class="panel-description" set:html={formatBrandText(description)} />
    </div>
    <div class="hover-effect"></div>
</div>

<style>
    .panel-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem;
        margin: 1rem 0;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 1.5rem;
        box-shadow: var(--card-shadow);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        overflow: hidden;
    }

    .panel-item:hover {
        transform: translateY(-8px) translateX(8px);
        box-shadow: var(--card-shadow-hover);
        border-color: var(--panel-border-color);
    }

    .panel-item:focus-visible {
        outline: 3px solid rgba(175, 130, 50, 0.28);
        outline-offset: 4px;
    }

    .panel-item.is-linked-active {
        border-color: var(--panel-border-color);
        box-shadow: 0 18px 44px rgba(17, 24, 39, 0.12), 0 0 0 1px var(--panel-glow-color);
        transform: translateY(-8px) translateX(8px);
    }

    .panel-item.is-linked-dimmed {
        opacity: 0.54;
        transform: scale(0.985);
    }

    .icon-wrapper {
        position: relative;
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--panel-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .panel-item:hover .icon-wrapper,
    .panel-item.is-linked-active .icon-wrapper {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 8px 25px var(--panel-glow-color);
    }

    .gradient-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--panel-gradient);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }

    .panel-item:hover .gradient-icon,
    .panel-item.is-linked-active .gradient-icon {
        transform: scale(1.2);
        box-shadow: 0 8px 22px var(--panel-glow-color);
        filter: brightness(1.1);
    }

    .content {
        flex: 1;
        z-index: 2;
    }

    .panel-title {
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.75rem 0;
        line-height: 1.3;
        transition: all 0.3s ease;
    }

    .panel-item:hover .panel-title,
    .panel-item.is-linked-active .panel-title {
        color: var(--brand-color);
    }

    .panel-description {
        font-size: clamp(0.95rem, 2.5vw, 1.15rem);
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.6;
        transition: color 0.3s ease;
    }

    .panel-item:hover .panel-description,
    .panel-item.is-linked-active .panel-description {
        color: var(--text-primary);
    }

    .hover-effect {
        position: absolute;
        inset: 0;
        background: var(--panel-wash);
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }

    .panel-item:hover .hover-effect,
    .panel-item.is-linked-active .hover-effect {
        opacity: 1;
    }

    /* Pulse animation for gradient icons */
    @keyframes iconPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .gradient-icon {
        animation: iconPulse 3s ease-in-out infinite;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .panel-item {
            padding: 1.5rem;
            gap: 1rem;
        }

        .panel-item:hover {
            transform: translateY(-4px);
        }

        .icon-wrapper {
            width: 50px;
            height: 50px;
        }

        .gradient-icon {
            width: 30px;
            height: 30px;
        }
    }

    @media (max-width: 480px) {
        .panel-item {
            padding: 1.25rem;
            margin: 0.75rem 0;
        }

        .icon-wrapper {
            width: 45px;
            height: 45px;
        }

        .gradient-icon {
            width: 25px;
            height: 25px;
        }
    }
</style>
