---
const { title, description, color, panelKeys = '' } = Astro.props;

const colorMapping = {
  primary: 'var(--primary-gradient)',
  secondary: 'var(--secondary-gradient)',
  accent: 'var(--accent-gradient)',
  success: 'var(--success-gradient)',
  warning: 'var(--warning-gradient)'
};

const gradientColor = colorMapping[color] || color || 'var(--primary-gradient)';
---

<div
    class="panel-item"
    data-color={color}
    data-panel-card
    data-panel-keys={panelKeys}
    tabindex="0"
>
    <div class="icon-wrapper">
        <div class="gradient-icon" style={`background: ${gradientColor}`}></div>
    </div>
    <div class="content">
        <h3 class="panel-title">{title}</h3>
        <p class="panel-description">{description}</p>
    </div>
    <div class="hover-effect"></div>
</div>

<style>
    .panel-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem;
        margin: 1rem 0;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 1.5rem;
        box-shadow: var(--card-shadow);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        overflow: hidden;
    }

    .panel-item:hover {
        transform: translateY(-8px) translateX(8px);
        box-shadow: var(--card-shadow-hover);
    }

    .panel-item:focus-visible {
        outline: 3px solid rgba(175, 130, 50, 0.28);
        outline-offset: 4px;
    }

    .panel-item.is-linked-active {
        border-color: rgba(175, 130, 50, 0.42);
        box-shadow: 0 18px 44px rgba(17, 24, 39, 0.12), 0 0 0 1px rgba(175, 130, 50, 0.14);
        transform: translateY(-8px) translateX(8px);
    }

    .panel-item.is-linked-dimmed {
        opacity: 0.54;
        transform: scale(0.985);
    }

    .icon-wrapper {
        position: relative;
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(175, 130, 50, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .panel-item:hover .icon-wrapper,
    .panel-item.is-linked-active .icon-wrapper {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 8px 25px rgba(175, 130, 50, 0.15);
    }

    .gradient-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }

    .panel-item:hover .gradient-icon,
    .panel-item.is-linked-active .gradient-icon {
        transform: scale(1.2);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        filter: brightness(1.1);
    }

    .content {
        flex: 1;
        z-index: 2;
    }

    .panel-title {
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.75rem 0;
        line-height: 1.3;
        transition: all 0.3s ease;
    }

    .panel-item:hover .panel-title,
    .panel-item.is-linked-active .panel-title {
        color: var(--brand-color);
    }

    .panel-description {
        font-size: clamp(0.95rem, 2.5vw, 1.15rem);
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.6;
        transition: color 0.3s ease;
    }

    .panel-item:hover .panel-description,
    .panel-item.is-linked-active .panel-description {
        color: var(--text-primary);
    }

    .hover-effect {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(175, 130, 50, 0.04) 0%,
            rgba(175, 130, 50, 0.02) 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }

    .panel-item:hover .hover-effect,
    .panel-item.is-linked-active .hover-effect {
        opacity: 1;
    }

    /* Pulse animation for gradient icons */
    @keyframes iconPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .gradient-icon {
        animation: iconPulse 3s ease-in-out infinite;
    }

    /* Color-specific animations */
    .panel-item[data-color="primary"]:hover {
        border-color: rgba(175, 130, 50, 0.3);
    }

    .panel-item[data-color="secondary"]:hover {
        border-color: rgba(175, 130, 50, 0.25);
    }

    .panel-item[data-color="accent"]:hover {
        border-color: rgba(175, 130, 50, 0.3);
    }

    .panel-item[data-color="success"]:hover {
        border-color: rgba(175, 130, 50, 0.25);
    }

    .panel-item[data-color="warning"]:hover {
        border-color: rgba(175, 130, 50, 0.25);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .panel-item {
            padding: 1.5rem;
            gap: 1rem;
        }

        .panel-item:hover {
            transform: translateY(-4px);
        }

        .icon-wrapper {
            width: 50px;
            height: 50px;
        }

        .gradient-icon {
            width: 30px;
            height: 30px;
        }
    }

    @media (max-width: 480px) {
        .panel-item {
            padding: 1.25rem;
            margin: 0.75rem 0;
        }

        .icon-wrapper {
            width: 45px;
            height: 45px;
        }

        .gradient-icon {
            width: 25px;
            height: 25px;
        }
    }
</style>
