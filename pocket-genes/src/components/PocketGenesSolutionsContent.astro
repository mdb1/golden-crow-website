---
import PocketGenesPublicLayout from '../layouts/PocketGenesPublicLayout.astro';
import ClientBookingWidget from './ClientBookingWidget.astro';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const locale = isEnglish ? 'en' : 'es';
const localizePath = (path: string) => (isEnglish ? `/en${path === '/' ? '/' : path}` : path);

type JigsawSide = 'top' | 'right' | 'bottom' | 'left';
type JigsawJoint = 'tab' | 'socket';
type JigsawTone = 'rose' | 'teal' | 'blue' | 'green' | 'amber';
type CatalogKey =
  | 'reports'
  | 'consents'
  | 'samples'
  | 'processing'
  | 'education'
  | 'discover'
  | 'community'
  | 'network'
  | 'operations'
  | 'communication'
  | 'backoffice';

type JigsawBlueprint = {
  key: string;
  targetKey: CatalogKey;
  kind: 'center' | 'node';
  nodeIndex?: number;
  col: number;
  row: number;
  cols: number;
  rows: number;
  tone: JigsawTone;
};

type JigsawConnector = {
  side: JigsawSide;
  shape: JigsawJoint;
  center: number;
  radius: number;
  depth: number;
};

type JigsawPiece = JigsawBlueprint & {
  title: string;
  subtitle?: string;
  href: string;
  path: string;
  fill: string;
  stroke: string;
  pathStyle: string;
  labelStyle: string;
};

type JourneyStepCopy = {
  phase: string;
  title: string;
  detail: string;
};

type JourneyDirection = 'right' | 'left' | 'down' | 'end';

type JourneyStep = JourneyStepCopy & {
  number: string;
  direction: JourneyDirection;
  style: string;
};

const jigsawGrid = {
  columns: 12,
  rows: 5,
  cell: 100,
} as const;

const journeyGrid = {
  columns: 4,
} as const;

const jigsawTones: Record<JigsawTone, { fill: string; stroke: string; glow: string }> = {
  rose: {
    fill: '#fff8fb',
    stroke: 'rgba(228, 80, 128, 0.42)',
    glow: 'rgba(228, 80, 128, 0.16)',
  },
  teal: {
    fill: '#f5fffd',
    stroke: 'rgba(20, 149, 143, 0.36)',
    glow: 'rgba(20, 149, 143, 0.14)',
  },
  blue: {
    fill: '#f6fbff',
    stroke: 'rgba(33, 118, 174, 0.34)',
    glow: 'rgba(33, 118, 174, 0.14)',
  },
  green: {
    fill: '#f7fff9',
    stroke: 'rgba(60, 155, 104, 0.34)',
    glow: 'rgba(60, 155, 104, 0.14)',
  },
  amber: {
    fill: '#fffaf1',
    stroke: 'rgba(217, 146, 50, 0.34)',
    glow: 'rgba(217, 146, 50, 0.14)',
  },
};

const jigsawBlueprints: readonly JigsawBlueprint[] = [
  { key: 'backoffice', targetKey: 'backoffice', kind: 'center', col: 4, row: 1, cols: 6, rows: 2, tone: 'rose' },
  { key: 'reports', targetKey: 'reports', kind: 'node', nodeIndex: 0, col: 10, row: 1, cols: 3, rows: 2, tone: 'blue' },
  { key: 'consents', targetKey: 'consents', kind: 'node', nodeIndex: 1, col: 1, row: 1, cols: 3, rows: 2, tone: 'teal' },
  { key: 'samples', targetKey: 'samples', kind: 'node', nodeIndex: 2, col: 1, row: 3, cols: 2, rows: 2, tone: 'green' },
  { key: 'processing', targetKey: 'processing', kind: 'node', nodeIndex: 3, col: 3, row: 3, cols: 3, rows: 2, tone: 'rose' },
  { key: 'education', targetKey: 'education', kind: 'node', nodeIndex: 4, col: 6, row: 3, cols: 2, rows: 2, tone: 'blue' },
  { key: 'discover', targetKey: 'discover', kind: 'node', nodeIndex: 5, col: 8, row: 3, cols: 3, rows: 2, tone: 'amber' },
  { key: 'community', targetKey: 'community', kind: 'node', nodeIndex: 6, col: 11, row: 3, cols: 2, rows: 2, tone: 'teal' },
  { key: 'network', targetKey: 'network', kind: 'node', nodeIndex: 7, col: 1, row: 5, cols: 4, rows: 1, tone: 'blue' },
  { key: 'operations', targetKey: 'operations', kind: 'node', nodeIndex: 8, col: 5, row: 5, cols: 4, rows: 1, tone: 'rose' },
  { key: 'communication', targetKey: 'communication', kind: 'node', nodeIndex: 9, col: 9, row: 5, cols: 4, rows: 1, tone: 'green' },
] as const;

const jigsawWidth = jigsawGrid.columns * jigsawGrid.cell;
const jigsawHeight = jigsawGrid.rows * jigsawGrid.cell;

const numberFormat = new Intl.NumberFormat('en-US', {
  maximumFractionDigits: 2,
  useGrouping: false,
});

const formatPathNumber = (value: number) => numberFormat.format(value);

const getJigsawBox = (piece: JigsawBlueprint) => ({
  left: (piece.col - 1) * jigsawGrid.cell,
  top: (piece.row - 1) * jigsawGrid.cell,
  right: (piece.col - 1 + piece.cols) * jigsawGrid.cell,
  bottom: (piece.row - 1 + piece.rows) * jigsawGrid.cell,
});

const getOverlap = (startA: number, endA: number, startB: number, endB: number) => {
  const start = Math.max(startA, startB);
  const end = Math.min(endA, endB);
  return end > start ? { start, end } : null;
};

const validateJigsawPlan = () => {
  const occupied = new Map<string, string>();

  for (const piece of jigsawBlueprints) {
    if (
      piece.col < 1 ||
      piece.row < 1 ||
      piece.col + piece.cols - 1 > jigsawGrid.columns ||
      piece.row + piece.rows - 1 > jigsawGrid.rows
    ) {
      throw new Error(`Jigsaw piece "${piece.key}" is outside the ${jigsawGrid.columns}x${jigsawGrid.rows} grid.`);
    }

    for (let row = piece.row; row < piece.row + piece.rows; row += 1) {
      for (let col = piece.col; col < piece.col + piece.cols; col += 1) {
        const cellKey = `${col}:${row}`;
        const existingPiece = occupied.get(cellKey);

        if (existingPiece) {
          throw new Error(`Jigsaw pieces "${existingPiece}" and "${piece.key}" both occupy cell ${cellKey}.`);
        }

        occupied.set(cellKey, piece.key);
      }
    }
  }

  const expectedCells = jigsawGrid.columns * jigsawGrid.rows;

  if (occupied.size !== expectedCells) {
    throw new Error(`Jigsaw plan covers ${occupied.size} cells, but ${expectedCells} cells are required.`);
  }
};

const shouldFirstPieceTab = (first: JigsawBlueprint, second: JigsawBlueprint) => {
  const checksum =
    first.col * 11 +
    first.row * 13 +
    first.cols * 17 +
    first.rows * 19 +
    second.col * 23 +
    second.row * 29 +
    second.cols * 31 +
    second.rows * 37;

  return checksum % 2 === 0;
};

const addJigsawConnector = (
  connectorMap: Map<string, JigsawConnector[]>,
  piece: JigsawBlueprint,
  side: JigsawSide,
  shape: JigsawJoint,
  axisStart: number,
  axisEnd: number,
) => {
  const span = axisEnd - axisStart;
  const radius = Math.min(26, Math.max(18, span * 0.22));
  const center = Math.min(axisEnd - radius * 1.3, Math.max(axisStart + radius * 1.3, axisStart + span / 2));

  connectorMap.get(piece.key)?.push({
    side,
    shape,
    center,
    radius,
    depth: radius * 1.12,
  });
};

const createJigsawConnectors = () => {
  const connectorMap = new Map(jigsawBlueprints.map((piece) => [piece.key, [] as JigsawConnector[]]));

  for (let firstIndex = 0; firstIndex < jigsawBlueprints.length; firstIndex += 1) {
    for (let secondIndex = firstIndex + 1; secondIndex < jigsawBlueprints.length; secondIndex += 1) {
      const first = jigsawBlueprints[firstIndex];
      const second = jigsawBlueprints[secondIndex];
      const firstBox = getJigsawBox(first);
      const secondBox = getJigsawBox(second);
      const firstGetsTab = shouldFirstPieceTab(first, second);
      const firstShape: JigsawJoint = firstGetsTab ? 'tab' : 'socket';
      const secondShape: JigsawJoint = firstGetsTab ? 'socket' : 'tab';

      if (firstBox.right === secondBox.left) {
        const overlap = getOverlap(firstBox.top, firstBox.bottom, secondBox.top, secondBox.bottom);

        if (overlap) {
          addJigsawConnector(connectorMap, first, 'right', firstShape, overlap.start, overlap.end);
          addJigsawConnector(connectorMap, second, 'left', secondShape, overlap.start, overlap.end);
        }
      }

      if (secondBox.right === firstBox.left) {
        const overlap = getOverlap(firstBox.top, firstBox.bottom, secondBox.top, secondBox.bottom);

        if (overlap) {
          addJigsawConnector(connectorMap, first, 'left', firstShape, overlap.start, overlap.end);
          addJigsawConnector(connectorMap, second, 'right', secondShape, overlap.start, overlap.end);
        }
      }

      if (firstBox.bottom === secondBox.top) {
        const overlap = getOverlap(firstBox.left, firstBox.right, secondBox.left, secondBox.right);

        if (overlap) {
          addJigsawConnector(connectorMap, first, 'bottom', firstShape, overlap.start, overlap.end);
          addJigsawConnector(connectorMap, second, 'top', secondShape, overlap.start, overlap.end);
        }
      }

      if (secondBox.bottom === firstBox.top) {
        const overlap = getOverlap(firstBox.left, firstBox.right, secondBox.left, secondBox.right);

        if (overlap) {
          addJigsawConnector(connectorMap, first, 'top', firstShape, overlap.start, overlap.end);
          addJigsawConnector(connectorMap, second, 'bottom', secondShape, overlap.start, overlap.end);
        }
      }
    }
  }

  return connectorMap;
};

const connectorPath = (side: JigsawSide, connector: JigsawConnector, fixedAxis: number) => {
  const { center, radius, depth, shape } = connector;

  if (side === 'top') {
    const peak = fixedAxis + (shape === 'tab' ? -depth : depth);

    return [
      `L ${formatPathNumber(center - radius)} ${formatPathNumber(fixedAxis)}`,
      `C ${formatPathNumber(center - radius * 0.62)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center - radius * 0.95)} ${formatPathNumber(peak)} ${formatPathNumber(center)} ${formatPathNumber(peak)}`,
      `C ${formatPathNumber(center + radius * 0.95)} ${formatPathNumber(peak)} ${formatPathNumber(center + radius * 0.62)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center + radius)} ${formatPathNumber(fixedAxis)}`,
    ];
  }

  if (side === 'right') {
    const peak = fixedAxis + (shape === 'tab' ? depth : -depth);

    return [
      `L ${formatPathNumber(fixedAxis)} ${formatPathNumber(center - radius)}`,
      `C ${formatPathNumber(fixedAxis)} ${formatPathNumber(center - radius * 0.62)} ${formatPathNumber(peak)} ${formatPathNumber(center - radius * 0.95)} ${formatPathNumber(peak)} ${formatPathNumber(center)}`,
      `C ${formatPathNumber(peak)} ${formatPathNumber(center + radius * 0.95)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center + radius * 0.62)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center + radius)}`,
    ];
  }

  if (side === 'bottom') {
    const peak = fixedAxis + (shape === 'tab' ? depth : -depth);

    return [
      `L ${formatPathNumber(center + radius)} ${formatPathNumber(fixedAxis)}`,
      `C ${formatPathNumber(center + radius * 0.62)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center + radius * 0.95)} ${formatPathNumber(peak)} ${formatPathNumber(center)} ${formatPathNumber(peak)}`,
      `C ${formatPathNumber(center - radius * 0.95)} ${formatPathNumber(peak)} ${formatPathNumber(center - radius * 0.62)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center - radius)} ${formatPathNumber(fixedAxis)}`,
    ];
  }

  const peak = fixedAxis + (shape === 'tab' ? -depth : depth);

  return [
    `L ${formatPathNumber(fixedAxis)} ${formatPathNumber(center + radius)}`,
    `C ${formatPathNumber(fixedAxis)} ${formatPathNumber(center + radius * 0.62)} ${formatPathNumber(peak)} ${formatPathNumber(center + radius * 0.95)} ${formatPathNumber(peak)} ${formatPathNumber(center)}`,
    `C ${formatPathNumber(peak)} ${formatPathNumber(center - radius * 0.95)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center - radius * 0.62)} ${formatPathNumber(fixedAxis)} ${formatPathNumber(center - radius)}`,
  ];
};

const buildJigsawPath = (piece: JigsawBlueprint, connectors: readonly JigsawConnector[]) => {
  const box = getJigsawBox(piece);
  const topConnectors = connectors.filter((connector) => connector.side === 'top').sort((a, b) => a.center - b.center);
  const rightConnectors = connectors.filter((connector) => connector.side === 'right').sort((a, b) => a.center - b.center);
  const bottomConnectors = connectors.filter((connector) => connector.side === 'bottom').sort((a, b) => b.center - a.center);
  const leftConnectors = connectors.filter((connector) => connector.side === 'left').sort((a, b) => b.center - a.center);
  const commands = [`M ${formatPathNumber(box.left)} ${formatPathNumber(box.top)}`];

  for (const connector of topConnectors) {
    commands.push(...connectorPath('top', connector, box.top));
  }

  commands.push(`L ${formatPathNumber(box.right)} ${formatPathNumber(box.top)}`);

  for (const connector of rightConnectors) {
    commands.push(...connectorPath('right', connector, box.right));
  }

  commands.push(`L ${formatPathNumber(box.right)} ${formatPathNumber(box.bottom)}`);

  for (const connector of bottomConnectors) {
    commands.push(...connectorPath('bottom', connector, box.bottom));
  }

  commands.push(`L ${formatPathNumber(box.left)} ${formatPathNumber(box.bottom)}`);

  for (const connector of leftConnectors) {
    commands.push(...connectorPath('left', connector, box.left));
  }

  commands.push('Z');

  return commands.join(' ');
};

const createJigsawPieces = (nodes: readonly string[], centerTitle: string, centerBody: string): JigsawPiece[] => {
  validateJigsawPlan();
  const connectorMap = createJigsawConnectors();

  return jigsawBlueprints.map((blueprint, index) => {
    const title = blueprint.kind === 'center' ? centerTitle : nodes[blueprint.nodeIndex ?? -1];

    if (!title) {
      throw new Error(`Missing label for jigsaw piece "${blueprint.key}".`);
    }

    const box = getJigsawBox(blueprint);
    const tone = jigsawTones[blueprint.tone];

    return {
      ...blueprint,
      title,
      subtitle: blueprint.kind === 'center' ? centerBody : undefined,
      href: `#solution-${blueprint.targetKey}`,
      path: buildJigsawPath(blueprint, connectorMap.get(blueprint.key) ?? []),
      fill: tone.fill,
      stroke: tone.stroke,
      pathStyle: [
        `--piece-fill: ${tone.fill}`,
        `--piece-stroke: ${tone.stroke}`,
        `--piece-glow: ${tone.glow}`,
        `--piece-delay: ${index * 48}ms`,
      ].join(';'),
      labelStyle: [
        `--label-left: ${(box.left / jigsawWidth) * 100}%`,
        `--label-top: ${(box.top / jigsawHeight) * 100}%`,
        `--label-width: ${((box.right - box.left) / jigsawWidth) * 100}%`,
        `--label-height: ${((box.bottom - box.top) / jigsawHeight) * 100}%`,
        `--piece-fill: ${tone.fill}`,
        `--piece-stroke: ${tone.stroke}`,
        `--piece-glow: ${tone.glow}`,
        `--piece-delay: ${index * 48}ms`,
      ].join(';'),
    };
  });
};

const createJourneyRoadmap = (steps: readonly JourneyStepCopy[]): JourneyStep[] =>
  steps.map((step, index) => {
    const zeroBasedRow = Math.floor(index / journeyGrid.columns);
    const positionInRow = index % journeyGrid.columns;
    const isReverseRow = zeroBasedRow % 2 === 1;
    const row = zeroBasedRow + 1;
    const column = isReverseRow ? journeyGrid.columns - positionInRow : positionInRow + 1;
    const isLast = index === steps.length - 1;
    const isRowTurn = !isLast && positionInRow === journeyGrid.columns - 1;
    const direction: JourneyDirection = isLast ? 'end' : isRowTurn ? 'down' : isReverseRow ? 'left' : 'right';

    return {
      ...step,
      number: String(index + 1).padStart(2, '0'),
      direction,
      style: [
        `--journey-index: ${index}`,
        `--journey-row: ${row}`,
        `--journey-col: ${column}`,
      ].join(';'),
    };
  });

