<script>
  const initSolutionJigsaw = (root) => {
    if (root.dataset.jigsawReady === 'true') return;

    root.dataset.jigsawReady = 'true';

    const triggers = Array.from(root.querySelectorAll('[data-jigsaw-trigger]'));
    const paths = Array.from(root.querySelectorAll('[data-jigsaw-piece]'));
    const shines = Array.from(root.querySelectorAll('[data-jigsaw-shine-piece]'));
    const rows = Array.from(document.querySelectorAll('[data-catalog-target]'));
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hoverPiece = '';
    let selectedPiece = '';
    let pulseTimer = 0;

    const targetForPiece = (pieceKey) => {
      const trigger = triggers.find((item) => item.getAttribute('data-jigsaw-trigger') === pieceKey);
      return trigger?.getAttribute('data-jigsaw-target') || '';
    };

    const renderActiveState = () => {
      const activePiece = hoverPiece || selectedPiece;
      const activeTarget = activePiece ? targetForPiece(activePiece) : '';

      root.classList.toggle('is-interacting', Boolean(activePiece));

      if (activePiece) {
        root.dataset.activePiece = activePiece;
      } else {
        root.removeAttribute('data-active-piece');
      }

      for (const path of paths) {
        const pieceKey = path.getAttribute('data-jigsaw-piece');
        const isActive = pieceKey === activePiece;
        path.classList.toggle('is-active', isActive);
        path.classList.toggle('is-selected', pieceKey === selectedPiece);
        path.classList.toggle('is-muted', Boolean(activePiece) && !isActive);
      }

      for (const shine of shines) {
        const pieceKey = shine.getAttribute('data-jigsaw-shine-piece');
        const isActive = pieceKey === activePiece;
        shine.classList.toggle('is-active', isActive);
        shine.classList.toggle('is-selected', pieceKey === selectedPiece);
      }

      for (const trigger of triggers) {
        const pieceKey = trigger.getAttribute('data-jigsaw-trigger');
        const isActive = pieceKey === activePiece;
        trigger.classList.toggle('is-active', isActive);
        trigger.classList.toggle('is-selected', pieceKey === selectedPiece);
        trigger.classList.toggle('is-muted', Boolean(activePiece) && !isActive);
        trigger.setAttribute('aria-current', pieceKey === selectedPiece ? 'true' : 'false');
      }

      for (const row of rows) {
        const rowTarget = row.getAttribute('data-catalog-target');
        row.classList.toggle('is-active', Boolean(activeTarget) && rowTarget === activeTarget);
      }
    };

    const scrollToCatalogTarget = (targetKey, href) => {
      const target = rows.find((row) => row.getAttribute('data-catalog-target') === targetKey);

      if (!target) return;

      target.classList.remove('is-pulsing');
      window.clearTimeout(pulseTimer);
      target.scrollIntoView({ block: 'center', behavior: prefersReducedMotion ? 'auto' : 'smooth' });
      window.history.replaceState(null, '', href);

      window.requestAnimationFrame(() => {
        target.classList.add('is-pulsing');
        pulseTimer = window.setTimeout(() => target.classList.remove('is-pulsing'), 1100);
      });
    };

    const selectFromHash = () => {
      const targetKey = window.location.hash.replace('#solution-', '');

      if (!targetKey) return;

      const trigger = triggers.find((item) => item.getAttribute('data-jigsaw-target') === targetKey);

      if (!trigger) return;

      selectedPiece = trigger.getAttribute('data-jigsaw-trigger') || '';
      renderActiveState();
    };

    for (const trigger of triggers) {
      const pieceKey = trigger.getAttribute('data-jigsaw-trigger') || '';
      const targetKey = trigger.getAttribute('data-jigsaw-target') || '';
      const href = trigger.getAttribute('href') || `#solution-${targetKey}`;

      trigger.addEventListener('mouseenter', () => {
        hoverPiece = pieceKey;
        renderActiveState();
      });

      trigger.addEventListener('focus', () => {
        hoverPiece = pieceKey;
        renderActiveState();
      });

      trigger.addEventListener('mouseleave', () => {
        hoverPiece = '';
        renderActiveState();
      });

      trigger.addEventListener('blur', () => {
        hoverPiece = '';
        renderActiveState();
      });

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        selectedPiece = pieceKey;
        hoverPiece = '';
        renderActiveState();
        scrollToCatalogTarget(targetKey, href);
      });
    }

    window.addEventListener('hashchange', selectFromHash);
    selectFromHash();
    renderActiveState();
  };

  document.querySelectorAll('[data-solution-jigsaw]').forEach(initSolutionJigsaw);

  const initSolutionJourney = (root) => {
    if (root.dataset.solutionJourneyReady === 'true') return;

    root.dataset.solutionJourneyReady = 'true';

    const cards = Array.from(root.querySelectorAll('[data-journey-card]'));
    const nodes = Array.from(root.querySelectorAll('[data-journey-node]'));
    const hubs = Array.from(root.querySelectorAll('[data-journey-hub]'));
    const interactiveElements = [...cards, ...nodes, ...hubs];

    const readKeys = (element) =>
      (element.getAttribute('data-journey-keys') || '')
        .split(/\s+/)
        .filter(Boolean);

    const hasSharedKey = (element, activeKeys) => {
      const keys = readKeys(element);
      return keys.some((key) => activeKeys.includes(key));
    };

    const setActive = (source) => {
      const activeKeys = readKeys(source);

      if (!activeKeys.length) return;

      root.setAttribute('data-active-journey', activeKeys.join(' '));

      for (const element of [...cards, ...nodes]) {
        const isActive = hasSharedKey(element, activeKeys);
        element.classList.toggle('is-linked-active', isActive);
        element.classList.toggle('is-linked-dimmed', !isActive);
      }

      for (const hub of hubs) {
        hub.classList.add('is-linked-active');
      }
    };

    const clearActive = () => {
      root.removeAttribute('data-active-journey');

      for (const element of interactiveElements) {
        element.classList.remove('is-linked-active', 'is-linked-dimmed');
      }
    };

    for (const element of interactiveElements) {
      element.addEventListener('pointerenter', () => setActive(element));
      element.addEventListener('pointerleave', clearActive);
      element.addEventListener('focusin', () => setActive(element));
      element.addEventListener('focusout', clearActive);
    }
  };

  document.querySelectorAll('[data-solution-journey]').forEach(initSolutionJourney);

  const initReactiveCards = (zone) => {
    if (zone.dataset.reactiveCardsReady === 'true') return;

    zone.dataset.reactiveCardsReady = 'true';

    const cards = Array.from(zone.querySelectorAll('[data-reactive-card]'));
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clearCard = (card) => {
      card.classList.remove('is-active');
      card.style.removeProperty('--card-x');
      card.style.removeProperty('--card-y');
      card.style.removeProperty('--card-tilt-x');
      card.style.removeProperty('--card-tilt-y');
    };

    const setActiveCard = (activeCard) => {
      zone.classList.toggle('is-reacting', Boolean(activeCard));

      for (const card of cards) {
        card.classList.toggle('is-active', card === activeCard);
      }
    };

    for (const card of cards) {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        const tiltX = prefersReducedMotion ? 0 : (x - 50) * 0.08;
        const tiltY = prefersReducedMotion ? 0 : (50 - y) * 0.08;

        card.style.setProperty('--card-x', `${x}%`);
        card.style.setProperty('--card-y', `${y}%`);
        card.style.setProperty('--card-tilt-x', `${tiltX}deg`);
        card.style.setProperty('--card-tilt-y', `${tiltY}deg`);
      });

      card.addEventListener('pointerenter', () => setActiveCard(card));
      card.addEventListener('focus', () => setActiveCard(card));

      card.addEventListener('pointerleave', () => {
        clearCard(card);
        setActiveCard(null);
      });

      card.addEventListener('blur', () => {
        clearCard(card);
        setActiveCard(null);
      });
    }
  };

  document.querySelectorAll('[data-reactive-card-zone]').forEach(initReactiveCards);
</script>

