const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const locale = isEnglish ? 'en' : 'es';
const localizePath = (path: string) => (isEnglish ? `/en${path === '/' ? '/' : path}` : path);

type JigsawSide = 'top' | 'right' | 'bottom' | 'left';
type JigsawJoint = 'tab' | 'socket';
type JigsawTone = 'rose' | 'teal' | 'blue' | 'green' | 'amber';
type JigsawConnectorOffsetAxis = 'x' | 'y';
type CatalogKey =
  | 'reports'
  | 'consents'
  | 'samples'
  | 'processing'
  | 'education'
  | 'discover'
  | 'community'
  | 'network'
  | 'operations'
  | 'communication'
  | 'backoffice';

type CatalogItemCopy = {
  key: CatalogKey;
  title: string;
  summary: string;
  example: string;
};

type JigsawBlueprint = {
  key: string;
  targetKey: CatalogKey;
  kind: 'center' | 'node';
  nodeIndex?: number;
  col: number;
  row: number;
  cols: number;
  rows: number;
  tone: JigsawTone;
};

type JigsawConnector = {
  side: JigsawSide;
  shape: JigsawJoint;
  center: number;
  radius: number;
  depth: number;
};

type JigsawConnectorOffsetSetting = {
  axis: JigsawConnectorOffsetAxis;
  offset: -20 | 0 | 20;
};

type JigsawPiece = JigsawBlueprint & {
  title: string;
  subtitle?: string;
  href: string;
  path: string;
  maskId: string;
  shineX: number;
  shineY: number;
  shineWidth: number;
  shineHeight: number;
  fill: string;
  stroke: string;
  pathStyle: string;
  labelStyle: string;
};

type JourneyStepCopy = {
  phase: string;
  title: string;
  detail: string;
};

type JourneyBranchCopy = {
  title: string;
  detail: string;
};

type JourneyPanelColor = 'primary' | 'secondary' | 'success' | 'accent' | 'warning';

type JourneyPanelPlan = {
  key: string;
  startIndex: number;
  endIndex: number;
  color: JourneyPanelColor;
};

type JourneyPanel = JourneyBranchCopy & {
  key: string;
  range: string;
  keys: string;
  color: JourneyPanelColor;
};

type JourneyNode = JourneyStepCopy & {
  number: string;
  key: string;
  keys: string;
  className: string;
  label: string;
};

type JourneyOrbitNode = JourneyNode & {
  visualClassName: string;
};

type AudienceBlueprint = {
  col: number;
  row: number;
  cols: number;
  rows: number;
  tone: JigsawTone;
};

type AudienceTile = AudienceBlueprint & {
  label: string;
  number: string;
  style: string;
};

type ProofStatCopy = {
