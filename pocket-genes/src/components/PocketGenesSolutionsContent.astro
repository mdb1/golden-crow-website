        title: 'La construimos con vos',
        body:
          'Sumá un pequeño equipo de Golden Crow VS que trabaje junto al tuyo de forma continua.',
        points: ['Equipo dedicado', 'Tus prioridades', 'Trabajo diario', 'Roadmap continuo'],
        cta: 'Sumar un equipo',
        href: '#solutions-call',
      },
    ],
    exampleEyebrow: 'Un problema, tres opciones',
    exampleTitle: 'Por ejemplo: mejorar la recolección de muestras.',
    exampleBody:
      'Lo mismo aplica a informes, consentimientos, educación, APIs, Discover, comunidad, CRM y el resto de nuestras soluciones.',
    exampleFlow: ['Solicitud', 'Asignación', 'Mapa', 'Tracking', 'Retiro', 'Cadena de custodia', 'Laboratorio'],
    exampleOptions: [
      {
        title: 'Pocket Genes',
        body: 'Integramos el circuito como parte de la plataforma.',
      },
      {
        title: 'Producto propio',
        body: 'Golden Crow VS desarrolla el sistema para tu organización.',
      },
      {
        title: 'Tu equipo + el nuestro',
        body: 'Nuestros desarrolladores trabajan con tu equipo para construirlo dentro de tu infraestructura.',
      },
    ],
    audienceEyebrow: 'Construido alrededor del ecosistema genético',
    audienceTitle: 'Para equipos donde biología, operación y software se cruzan.',
    audiences: [
      'Laboratorios genéticos',
      'Empresas de estudios genéticos',
      'Clínicas de fertilidad',
      'Centros de reproducción asistida',
      'Hospitales y clínicas',
      'Bioinformática y diagnóstico',
      'Fundaciones y organizaciones EPOF',
      'Profesionales y redes de salud',
      'Empresas de logística de muestras',
    ],
    whyEyebrow: 'Por qué Golden Crow VS',
    whyTitle: 'Tecnología, producto y genética.',
    whyBody:
      'Pocket Genes está construido por Golden Crow VS. Nuestro equipo combina experiencia en desarrollo de productos digitales con una mirada biotecnológica para trabajar sobre problemas reales del ecosistema genético.',
    proofPoints: ['10+ años construyendo productos digitales', '20+ proyectos lanzados', 'Experiencia en ingeniería, diseño, producto y biotecnología'],
    bookingEyebrow: 'No hace falta empezar con todo',
    bookingTitle: 'Empecemos por el problema que más tiempo te está haciendo perder.',
    bookingQuestion:
      '¿Qué parte de tu operación todavía depende demasiado de emails, planillas, PDFs o procesos manuales?',
    bookingBody:
      'En una llamada de 30 minutos podemos recorrer tu proceso, identificar dónde hay trabajo manual o fragmentado y evaluar qué solución tiene sentido.',
    bookingContext: 'pocket-genes-solutions',
    bookingEventTitle: 'Llamada de Soluciones',
  },
} as const;

const copy = pageCopy[locale];
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/solutions"
>
  <main id="main" class="pg-page pg-solutions">
    <section class="pg-solutions-hero">
      <div class="pg-container pg-solutions-hero-grid">
        <div class="pg-solutions-hero-copy">
          <p class="pg-eyebrow">{copy.heroEyebrow}</p>
          <h1>{copy.heroTitle}</h1>
          <p class="pg-solutions-lead">{copy.heroBody}</p>
          <p class="pg-solutions-key">{copy.heroKey}</p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href="#solutions-call">{copy.heroPrimary}</a>
            <a class="pg-button pg-button-secondary" href="#solution-catalog">{copy.heroSecondary}</a>
          </div>
        </div>

        <figure class="pg-solutions-hero-visual" aria-label={copy.heroVisualLabel}>
          <div class="pg-solution-phone-row">
            {copy.heroScreenshots.map((screenshot, index) => (
              <img
                class:list={['pg-solution-phone', `phone-${index + 1}`]}
                src={screenshot.src}
                alt={screenshot.alt}
                fetchpriority={index === 0 ? 'high' : 'auto'}
              />
            ))}
          </div>
          <figcaption>{copy.hubCenterTitle}</figcaption>
        </figure>
      </div>
    </section>

    <section class="pg-section pg-solutions-hub" aria-labelledby="solutions-hub-title">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.hubEyebrow}</p>
          <h2 id="solutions-hub-title">{copy.hubTitle}</h2>
          <p>{copy.hubBody}</p>
        </div>

        <div class="pg-solution-map" aria-label={copy.hubEyebrow}>
          <article class="pg-solution-map-center">
            <img src="/pocket-genes/icon_simple.png" alt="" width="48" height="48" />
            <h3>{copy.hubCenterTitle}</h3>
            <p>{copy.hubCenterBody}</p>
          </article>
          {copy.hubNodes.map((node, index) => (
            <span class="pg-solution-node" style={`--node-index: ${index};`}>{node}</span>
          ))}
        </div>
      </div>
    </section>

    <section id="solution-catalog" class="pg-section pg-solutions-catalog" aria-labelledby="solutions-catalog-title">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.catalogEyebrow}</p>
          <h2 id="solutions-catalog-title">{copy.catalogTitle}</h2>
          <p>{copy.catalogBody}</p>
        </div>

        <div class="pg-catalog-grid">
          {copy.catalogItems.map((item) => (
            <article class="pg-catalog-card">
              <div class="pg-catalog-card-head">
                <span>{item.number}</span>
                <h3>{item.title}</h3>
              </div>
              <p class="pg-catalog-summary">{item.summary}</p>
              <ul class="pg-feature-list">
                {item.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <p class="pg-catalog-example">{item.example}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-solutions-journey" aria-labelledby="solutions-journey-title">
      <div class="pg-container pg-journey-layout">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.journeyEyebrow}</p>
          <h2 id="solutions-journey-title">{copy.journeyTitle}</h2>
          <p>{copy.journeyBody}</p>
        </div>

        <ol class="pg-journey-track">
          {copy.journeySteps.map((step, index) => (
            <li style={`--journey-index: ${index};`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {step}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="pg-section pg-solutions-proof" aria-labelledby="solutions-proof-title">
      <div class="pg-container pg-proof-layout">
        <div class="pg-proof-copy">
          <p class="pg-eyebrow">{copy.proofEyebrow}</p>
          <h2 id="solutions-proof-title">{copy.proofTitle}</h2>
          <p>{copy.proofBody}</p>
          <div class="pg-proof-columns">
            {copy.proofColumns.map((column) => (
              <article>
                <h3>{column.title}</h3>
                <ul>
                  {column.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>

        <div class="pg-proof-screens" aria-label={copy.screenshotsLabel}>
          {copy.screenshots.map((screenshot) => (
            <figure>
              <img src={screenshot.src} alt={screenshot.alt} loading="lazy" />
              <figcaption>{screenshot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-solutions-models" aria-labelledby="solutions-models-title">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.modelsEyebrow}</p>
          <h2 id="solutions-models-title">{copy.modelsTitle}</h2>
        </div>

        <div class="pg-model-grid">
          {copy.models.map((model) => (
            <article class="pg-model-card">
              <span class="pg-model-number">{model.number}</span>
              <h3>{model.title}</h3>
              <p>{model.body}</p>
              <ul>
                {model.points.map((point) => <li>{point}</li>)}
              </ul>
              <a class="pg-button pg-button-secondary" href={model.href.startsWith('#') ? model.href : localizePath(model.href)}>
                {model.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-solutions-example" aria-labelledby="solutions-example-title">
      <div class="pg-container">
        <div class="pg-example-panel">
          <div class="pg-section-heading">
            <p class="pg-eyebrow">{copy.exampleEyebrow}</p>
            <h2 id="solutions-example-title">{copy.exampleTitle}</h2>
            <p>{copy.exampleBody}</p>
          </div>

          <ol class="pg-example-flow">
            {copy.exampleFlow.map((step, index) => (
              <li style={`--flow-index: ${index};`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {step}
              </li>
            ))}
          </ol>

          <div class="pg-example-options">
            {copy.exampleOptions.map((option) => (
              <article>
                <h3>{option.title}</h3>
                <p>{option.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section pg-solutions-audience" aria-labelledby="solutions-audience-title">
      <div class="pg-container pg-audience-layout">
        <div>
          <p class="pg-eyebrow">{copy.audienceEyebrow}</p>
          <h2 id="solutions-audience-title">{copy.audienceTitle}</h2>
        </div>
        <div class="pg-audience-grid">
          {copy.audiences.map((audience) => <span>{audience}</span>)}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-solutions-why" aria-labelledby="solutions-why-title">
      <div class="pg-container pg-why-layout">
        <div>
          <p class="pg-eyebrow">{copy.whyEyebrow}</p>
          <h2 id="solutions-why-title">{copy.whyTitle}</h2>
          <p>{copy.whyBody}</p>
        </div>
        <ul class="pg-proof-point-list">
          {copy.proofPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </section>

    <section id="solutions-call" class="pg-section pg-solutions-booking" aria-labelledby="solutions-booking-title">
      <div class="pg-container pg-solutions-booking-grid">
        <div class="pg-booking-copy">
          <p class="pg-eyebrow">{copy.bookingEyebrow}</p>
          <h2 id="solutions-booking-title">{copy.bookingTitle}</h2>
          <p class="pg-booking-question">{copy.bookingQuestion}</p>
          <p>{copy.bookingBody}</p>
        </div>
        <div class="pg-solutions-calendar-wrapper">
          <ClientBookingWidget
            context={copy.bookingContext}
            eventTitle={copy.bookingEventTitle}
          />
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-solutions {
    --solution-navy: #172033;
    --solution-teal: #14958f;
    --solution-rose: #e45080;
    --solution-blue: #2176ae;
    --solution-green: #3c9b68;
    --solution-amber: #d99232;
    --solution-ink-soft: #46556f;
    --solution-border: #dce4ec;
    --solution-surface: #ffffff;
    overflow-x: hidden;
  }

  .pg-solutions .pg-section-heading {
    max-width: 860px;
  }

  .pg-solutions .pg-section-heading h2 {
    font-size: 3rem;
  }

  .pg-solutions-hero {
    position: relative;
    isolation: isolate;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: 124px 0 76px;
    background:
      linear-gradient(90deg, rgba(251, 252, 253, 0.98) 0%, rgba(251, 252, 253, 0.94) 44%, rgba(251, 252, 253, 0.74) 100%),
      url("/mobile2.webp");
    background-position: center right;
    background-size: cover;
  }

  .pg-solutions-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(115deg, rgba(20, 149, 143, 0.1) 0 16%, transparent 16% 46%, rgba(228, 80, 128, 0.08) 46% 64%, transparent 64%),
      repeating-linear-gradient(90deg, rgba(23, 32, 51, 0.04) 0 1px, transparent 1px 96px);
  }

  .pg-solutions-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(380px, 1.06fr);
    gap: 52px;
    align-items: center;
  }

  .pg-solutions-hero-copy h1 {
    max-width: 760px;
    margin: 0;
    color: var(--solution-navy);
    font-size: 4.8rem;
    font-weight: 920;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .pg-solutions-lead {
    max-width: 720px;
    margin: 22px 0 0;
    color: var(--solution-ink-soft);
    font-size: 1.18rem;
    line-height: 1.68;
  }

  .pg-solutions-key {
    max-width: 680px;
    margin: 18px 0 0;
    border-left: 4px solid var(--solution-teal);
    color: var(--solution-navy);
    font-size: 1.08rem;
    font-weight: 820;
    line-height: 1.55;
    padding-left: 16px;
  }

  .pg-solutions-hero-copy .pg-button-row {
    margin-top: 30px;
  }

  .pg-solutions-hero-visual {
    position: relative;
    min-height: 560px;
    margin: 0;
  }

  .pg-solution-phone-row {
    position: relative;
    min-height: 520px;
  }

  .pg-solution-phone {
    position: absolute;
    display: block;
    width: 246px;
    aspect-ratio: 560 / 1218;
    object-fit: cover;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: 0 22px 58px rgba(23, 32, 51, 0.18);
  }

  .pg-solution-phone.phone-1 {
    top: 42px;
    left: 26px;
    transform: rotate(-4deg);
  }

  .pg-solution-phone.phone-2 {
    top: 0;
    left: 206px;
    z-index: 2;
  }

  .pg-solution-phone.phone-3 {
    top: 88px;
    right: 8px;
    transform: rotate(4deg);
  }

  .pg-solutions-hero-visual figcaption {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    border: 1px solid rgba(20, 149, 143, 0.22);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 14px 34px rgba(23, 32, 51, 0.12);
    color: var(--solution-navy);
    font-weight: 900;
    padding: 10px 14px;
    white-space: nowrap;
  }

  .pg-solutions-hub {
    background:
      linear-gradient(180deg, #ffffff, #f5fbfa);
  }

  .pg-solution-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-top: 34px;
    border: 1px solid var(--solution-border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(232, 250, 247, 0.8), rgba(255, 240, 245, 0.55), rgba(236, 245, 255, 0.8)),
      repeating-linear-gradient(135deg, rgba(23, 32, 51, 0.05) 0 1px, transparent 1px 28px);
    padding: 24px;
  }

  .pg-solution-map::before {
    content: "";
    position: absolute;
    inset: 50% 7%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(20, 149, 143, 0.12), rgba(228, 80, 128, 0.34), rgba(33, 118, 174, 0.34), rgba(60, 155, 104, 0.18));
  }

  .pg-solution-map-center,
  .pg-solution-node {
    position: relative;
    z-index: 1;
    min-height: 112px;
    border: 1px solid rgba(197, 210, 223, 0.86);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 28px rgba(23, 32, 51, 0.08);
  }

  .pg-solution-map-center {
    grid-column: 2 / span 3;
    display: grid;
    place-items: center;
    gap: 6px;
    min-height: 168px;
    border-color: rgba(228, 80, 128, 0.28);
    background: #ffffff;
    color: var(--solution-navy);
    padding: 24px;
    text-align: center;
  }

  .pg-solution-map-center img {
    border-radius: 10px;
    box-shadow: 0 10px 22px rgba(228, 80, 128, 0.22);
  }

  .pg-solution-map-center h3 {
    margin: 0;
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .pg-solution-map-center p {
    margin: 0;
    color: var(--solution-ink-soft);
    font-weight: 760;
  }

  .pg-solution-node {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--solution-navy);
    font-weight: 860;
    line-height: 1.25;
    padding: 16px;
    text-align: center;
  }

  .pg-solution-node:nth-of-type(3n + 1) {
    border-color: rgba(20, 149, 143, 0.24);
  }

  .pg-solution-node:nth-of-type(3n + 2) {
    border-color: rgba(33, 118, 174, 0.24);
  }

  .pg-solution-node:nth-of-type(3n + 3) {
    border-color: rgba(228, 80, 128, 0.22);
  }

  .pg-solutions-catalog {
    background: #fbfcfd;
  }

  .pg-catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .pg-catalog-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    border: 1px solid var(--solution-border);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(23, 32, 51, 0.05);
    padding: 22px;
  }

  .pg-catalog-card-head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .pg-catalog-card-head span,
  .pg-model-number,
  .pg-journey-track span,
  .pg-example-flow span {
    flex: 0 0 auto;
    min-width: 40px;
    border-radius: 8px;
    background: #eef8f5;
    color: #0e6f6b;
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
    padding: 10px;
    text-align: center;
  }

  .pg-catalog-card h3 {
    margin: 0;
    color: var(--solution-navy);
    font-size: 1.26rem;
    line-height: 1.18;
  }

  .pg-catalog-summary {
    margin: 16px 0 0;
    color: var(--solution-navy);
    font-weight: 820;
    line-height: 1.45;
  }

  .pg-feature-list,
  .pg-proof-columns ul,
  .pg-model-card ul,
  .pg-proof-point-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pg-feature-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .pg-feature-list li {
    border: 1px solid #e5edf4;
    border-radius: 8px;
    background: #f8fbfd;
    color: var(--solution-ink-soft);
    font-size: 0.86rem;
    font-weight: 720;
    line-height: 1.25;
    padding: 7px 9px;
  }

  .pg-catalog-example {
    margin: auto 0 0;
    border-top: 1px solid #edf2f6;
    color: var(--solution-ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
    padding-top: 16px;
  }

  .pg-solutions-journey {
    background: #ffffff;
  }

  .pg-journey-layout {
    display: grid;
    gap: 24px;
  }

  .pg-journey-track {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-journey-track li {
    position: relative;
    display: grid;
    min-height: 98px;
    align-content: center;
    gap: 10px;
    border: 1px solid var(--solution-border);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 8px 18px rgba(23, 32, 51, 0.06);
    color: var(--solution-navy);
    font-weight: 850;
    line-height: 1.25;
    padding: 14px;
  }

  .pg-journey-track li::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -10px;
    z-index: 2;
    width: 10px;
    height: 2px;
    background: var(--solution-blue);
    transform: translateY(-50%);
  }

  .pg-journey-track li:nth-child(6n)::after,
  .pg-journey-track li:last-child::after {
    display: none;
  }

  .pg-solutions-proof {
    background:
      linear-gradient(135deg, rgba(232, 250, 247, 0.88), rgba(255, 255, 255, 0.9) 45%, rgba(255, 246, 221, 0.8));
  }

  .pg-proof-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(480px, 1.1fr);
    gap: 42px;
    align-items: center;
  }

  .pg-proof-copy h2,
  .pg-audience-layout h2,
  .pg-why-layout h2,
  .pg-booking-copy h2 {
    margin: 0;
    color: var(--solution-navy);
    font-size: 3rem;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .pg-proof-copy > p:not(.pg-eyebrow),
  .pg-why-layout p,
  .pg-booking-copy p {
    margin: 18px 0 0;
    color: var(--solution-ink-soft);
    font-size: 1.06rem;
    line-height: 1.68;
  }

  .pg-proof-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .pg-proof-columns article {
    border: 1px solid rgba(197, 210, 223, 0.86);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    padding: 20px;
  }

  .pg-proof-columns h3 {
    margin: 0 0 12px;
    color: var(--solution-navy);
    font-size: 1.12rem;
  }

  .pg-proof-columns li,
  .pg-model-card li,
  .pg-proof-point-list li {
    position: relative;
    color: var(--solution-ink-soft);
    line-height: 1.45;
    padding-left: 18px;
  }

  .pg-proof-columns li + li,
  .pg-model-card li + li,
  .pg-proof-point-list li + li {
    margin-top: 8px;
  }

  .pg-proof-columns li::before,
  .pg-model-card li::before,
  .pg-proof-point-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.64em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--solution-teal);
  }

  .pg-proof-screens {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
