    background: linear-gradient(90deg, var(--solution-teal), var(--solution-blue), var(--solution-rose));
  }

  .pg-journey-intro .pg-eyebrow {
    grid-column: 1 / -1;
  }

  .pg-journey-intro h2 {
    max-width: 760px;
  }

  .pg-journey-intro > p:not(.pg-eyebrow) {
    margin: 0;
    border-left: 3px solid rgba(20, 149, 143, 0.28);
    color: var(--solution-ink-soft);
    font-size: 1.02rem;
    line-height: 1.62;
    padding-left: 18px;
  }

  .pg-journey-roadmap {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--journey-columns), minmax(0, 1fr));
    gap: 18px 20px;
    margin: 0;
    border: 1px solid rgba(197, 210, 223, 0.9);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(236, 245, 255, 0.72)),
      repeating-linear-gradient(135deg, rgba(20, 149, 143, 0.04) 0 1px, transparent 1px 24px);
    list-style: none;
    padding: clamp(18px, 2.4vw, 30px);
    box-shadow: 0 20px 54px rgba(23, 32, 51, 0.08);
  }

  .pg-journey-roadmap::before {
    content: "";
    position: absolute;
    inset: clamp(18px, 2.4vw, 30px);
    border-radius: 8px;
    background:
      radial-gradient(circle at 12% 18%, rgba(20, 149, 143, 0.18), transparent 18%),
      radial-gradient(circle at 87% 82%, rgba(217, 146, 50, 0.14), transparent 22%);
    opacity: 0.72;
    pointer-events: none;
  }

  .pg-journey-step {
    position: relative;
    z-index: 1;
    grid-column: var(--journey-col);
    grid-row: var(--journey-row);
    min-width: 0;
    animation: pgJourneyStepIn 0.52s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--journey-index) * 54ms);
  }

  .pg-journey-step::before {
    content: "";
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(20, 149, 143, 0.42), rgba(33, 118, 174, 0.36), rgba(228, 80, 128, 0.3));
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.72);
    opacity: 0.7;
    pointer-events: none;
  }

  .pg-journey-step.is-right::before {
    top: 41px;
    left: calc(50% + 34px);
    right: calc(-50% - 14px);
    height: 3px;
  }

  .pg-journey-step.is-left::before {
    top: 41px;
    right: calc(50% + 34px);
    left: calc(-50% - 14px);
    height: 3px;
  }

  .pg-journey-step.is-down::before {
    top: 41px;
    left: 31px;
    width: 3px;
    height: calc(100% + 22px);
    background: linear-gradient(180deg, rgba(20, 149, 143, 0.42), rgba(33, 118, 174, 0.36), rgba(228, 80, 128, 0.3));
  }

  .pg-journey-step.is-end::before {
    display: none;
  }

  .pg-journey-card {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 168px;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    border: 1px solid rgba(197, 210, 223, 0.92);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(248, 252, 255, 0.9)),
      #ffffff;
    box-shadow: 0 10px 26px rgba(23, 32, 51, 0.07);
    color: var(--solution-navy);
    overflow: hidden;
    padding: 18px;
    transition:
      border-color 0.24s ease,
      box-shadow 0.24s ease,
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pg-journey-card::before {
    content: "";
    position: absolute;
    top: -10%;
    right: auto;
    bottom: -10%;
    left: -44%;
    width: 72%;
    background: var(--solution-shine-band);
    filter: blur(2px);
    mask-image: var(--solution-shine-mask);
    -webkit-mask-image: var(--solution-shine-mask);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-125%) skewX(-10deg);
    transition: opacity 0.28s ease, transform 0.82s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pg-journey-card:hover,
  .pg-journey-card:focus-within {
    border-color: rgba(20, 149, 143, 0.34);
    box-shadow: 0 18px 36px rgba(23, 32, 51, 0.12);
    transform: translateY(-5px);
  }

  .pg-journey-card:hover::before,
  .pg-journey-card:focus-within::before {
    opacity: 0.42;
    transform: translateX(245%) skewX(-10deg);
  }

  .pg-journey-marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid rgba(20, 149, 143, 0.32);
    border-radius: 999px;
    background:
      radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.92), transparent 34%),
      linear-gradient(145deg, #e8fbf8 0%, #ccefeb 100%);
    box-shadow: 0 12px 28px rgba(20, 149, 143, 0.12);
    color: var(--solution-teal);
    font-size: 0.84rem;
    font-weight: 950;
    line-height: 1;
  }

  .pg-journey-marker::after {
    content: "";
    position: absolute;
    right: 5px;
    bottom: 6px;
    width: 10px;
    height: 10px;
    border: 2px solid #ffffff;
    border-radius: 999px;
    background: var(--solution-rose);
  }

  .pg-journey-phase {
    display: inline-flex;
    margin-bottom: 8px;
    color: var(--solution-teal);
    font-size: 0.76rem;
    font-weight: 920;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .pg-journey-card-copy {
    display: grid;
    align-content: start;
    min-width: 0;
  }

  .pg-journey-card h3 {
    margin: 0;
    color: var(--solution-navy);
    font-size: 1.16rem;
    min-block-size: 2.4em;
    line-height: 1.2;
  }

  .pg-journey-card p {
    margin: 8px 0 0;
    color: var(--solution-ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
    min-block-size: 4.5em;
  }

  @keyframes pgJourneyStepIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .pg-journey-layout {
    grid-template-columns: minmax(320px, 0.56fr) minmax(620px, 1.44fr);
    gap: clamp(32px, 5vw, 68px);
    align-items: center;
  }

  .pg-journey-intro {
    align-content: center;
    grid-template-columns: 1fr;
  }

  .pg-journey-intro .pg-eyebrow {
    grid-column: auto;
    color: var(--solution-teal);
  }

  .pg-journey-intro h2 {
    max-width: 520px;
  }

  .pg-journey-intro > p:not(.pg-eyebrow) {
    max-width: 520px;
    margin: 18px 0 0;
    font-size: 1.06rem;
    line-height: 1.68;
  }

  .pg-journey-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(220px, 1fr) minmax(220px, 0.86fr);
    grid-template-areas:
      "entry movement core"
      "result support core";
    gap: 16px;
    min-height: 650px;
    border: 1px solid rgba(197, 210, 223, 0.9);
    border-radius: 8px;
    background:
      radial-gradient(circle at 82% 48%, rgba(20, 149, 143, 0.16), transparent 31%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(236, 245, 255, 0.76)),
      repeating-linear-gradient(135deg, rgba(20, 149, 143, 0.038) 0 1px, transparent 1px 24px);
    box-shadow: 0 20px 54px rgba(23, 32, 51, 0.08);
    overflow: hidden;
    padding: clamp(18px, 2.2vw, 28px);
    perspective: 900px;
  }

  .pg-journey-stage::before,
  .pg-journey-stage::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .pg-journey-stage::before {
    inset: clamp(18px, 2.2vw, 28px);
    border-radius: 8px;
    background:
      linear-gradient(90deg, transparent 0 64%, rgba(20, 149, 143, 0.12) 64% 66%, transparent 66%),
      linear-gradient(180deg, transparent 0 49%, rgba(33, 118, 174, 0.12) 49% 51%, transparent 51%);
    opacity: 0.5;
  }

  .pg-journey-stage::after {
    top: 12%;
    right: 8%;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(20, 149, 143, 0.1), transparent 64%);
    animation: pgJourneyAmbientPulse 5.8s ease-in-out infinite;
  }

  .pg-journey-connector {
    position: absolute;
    z-index: 1;
    right: 25%;
    width: 29%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(20, 149, 143, 0.42), rgba(33, 118, 174, 0.26), rgba(228, 80, 128, 0.16));
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.62), 0 0 18px rgba(20, 149, 143, 0.12);
    opacity: 0.58;
    pointer-events: none;
    transform-origin: right center;
  }

  .pg-journey-connector.is-entry {
    top: 26%;
    transform: rotate(-17deg);
  }

  .pg-journey-connector.is-movement {
    top: 34%;
    width: 15%;
    transform: rotate(-7deg);
  }

  .pg-journey-connector.is-result {
    top: 68%;
    transform: rotate(16deg);
  }

  .pg-journey-connector.is-support {
    top: 61%;
    width: 15%;
    transform: rotate(7deg);
  }

  .pg-journey-core {
    position: relative;
    z-index: 3;
    grid-area: core;
    align-self: center;
    justify-self: center;
    display: grid;
    place-items: center;
    width: min(100%, 250px);
    aspect-ratio: 1;
    border: 0;
    border-radius: 999px;
    background:
      radial-gradient(circle at var(--card-x, 34%) var(--card-y, 24%), rgba(255, 255, 255, 0.96) 0 6%, rgba(142, 233, 221, 0.9) 7%, rgba(20, 149, 143, 0.96) 42%, #2176ae 100%);
    box-shadow:
      inset 0 1px 20px rgba(255, 255, 255, 0.42),
      inset 0 -28px 44px rgba(23, 32, 51, 0.18),
      0 30px 76px rgba(20, 149, 143, 0.26);
    color: #ffffff;
    cursor: pointer;
    isolation: isolate;
    text-align: center;
    padding: clamp(24px, 3vw, 34px);
    transform: perspective(900px) rotateX(0) rotateY(0) scale(1);
    transition:
      filter 0.28s ease,
      box-shadow 0.28s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pg-journey-core::before,
  .pg-journey-core::after {
    content: "";
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
  }

  .pg-journey-core::before {
    inset: -18px;
    z-index: -2;
    background: conic-gradient(from 120deg, rgba(142, 233, 221, 0.1), rgba(33, 118, 174, 0.22), rgba(228, 80, 128, 0.08), rgba(142, 233, 221, 0.1));
    filter: blur(20px);
    opacity: 0.52;
    animation: pgJourneyHaloDrift 12s linear infinite;
  }

  .pg-journey-core::after {
    inset: 13%;
    background:
      radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.24), transparent 38%),
      radial-gradient(circle at 72% 76%, rgba(255, 255, 255, 0.12), transparent 30%);
    mix-blend-mode: screen;
  }

  .pg-journey-core-ring {
    position: absolute;
    inset: var(--ring-inset);
    z-index: -1;
    border-radius: inherit;
    border: var(--ring-width) solid rgba(20, 149, 143, var(--ring-opacity));
    box-shadow: 0 0 22px rgba(20, 149, 143, 0.12);
    animation: pgJourneyRingBreath var(--ring-speed) ease-in-out infinite;
  }

  .pg-journey-core-ring.is-outer {
    --ring-inset: -52px;
    --ring-width: 1px;
    --ring-opacity: 0.16;
    --ring-speed: 6.4s;
  }

  .pg-journey-core-ring.is-middle {
    --ring-inset: -32px;
    --ring-width: 2px;
    --ring-opacity: 0.2;
    --ring-speed: 5.2s;
  }

  .pg-journey-core-ring.is-inner {
    --ring-inset: -14px;
    --ring-width: 1px;
    --ring-opacity: 0.28;
    --ring-speed: 4.4s;
  }

  .pg-journey-core-kicker,
  .pg-journey-core strong,
  .pg-journey-core > span:last-child {
    position: relative;
    z-index: 1;
  }

  .pg-journey-core-kicker {
    align-self: end;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pg-journey-core strong {
    max-width: 190px;
    color: #ffffff;
    font-size: clamp(1.34rem, 2vw, 1.74rem);
    font-weight: 940;
    line-height: 1.08;
    text-shadow: 0 2px 16px rgba(23, 32, 51, 0.24);
  }

  .pg-journey-core > span:last-child {
    max-width: 190px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.86rem;
    font-weight: 720;
    line-height: 1.38;
  }

  .pg-journey-core:hover,
  .pg-journey-core:focus-visible,
  .pg-journey-core.is-active {
    filter: saturate(1.12) brightness(1.04);
    box-shadow:
      inset 0 1px 24px rgba(255, 255, 255, 0.46),
      inset 0 -28px 44px rgba(23, 32, 51, 0.16),
      0 38px 92px rgba(20, 149, 143, 0.34);
    transform:
      perspective(900px)
      rotateX(var(--card-tilt-y, 0deg))
      rotateY(var(--card-tilt-x, 0deg))
      scale(1.045);
  }

  .pg-journey-core:focus-visible {
    outline: 3px solid rgba(20, 149, 143, 0.32);
    outline-offset: 36px;
  }

  .pg-journey-branch-card {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: start;
    gap: 16px;
    min-width: 0;
    min-height: 292px;
    grid-area: var(--branch-area);
    border: 1px solid var(--branch-stroke);
    border-radius: 8px;
    background:
      radial-gradient(circle at var(--card-x, 50%) var(--card-y, 32%), rgba(255, 255, 255, 0.96), transparent 32%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.96), var(--branch-fill));
    box-shadow: 0 12px 28px var(--branch-glow);
    color: var(--solution-navy);
    cursor: pointer;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(18px, 1.8vw, 22px);
    transform: perspective(900px) rotateX(0) rotateY(0) translateY(0);
    transition:
      opacity 0.24s ease,
      border-color 0.24s ease,
      box-shadow 0.24s ease,
      filter 0.24s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    animation: pgJourneyBranchIn 0.56s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--branch-index) * 88ms);
  }

  .pg-journey-branch-card.is-entry {
    --branch-area: entry;
  }

  .pg-journey-branch-card.is-movement {
    --branch-area: movement;
  }

  .pg-journey-branch-card.is-result {
    --branch-area: result;
  }

  .pg-journey-branch-card.is-support {
    --branch-area: support;
  }

  .pg-journey-branch-card::before,
  .pg-journey-branch-card::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .pg-journey-branch-card::before {
    z-index: -1;
    background:
      radial-gradient(circle at var(--card-x, 50%) var(--card-y, 32%), rgba(255, 255, 255, 0.42), transparent 36%),
      linear-gradient(135deg, rgba(20, 149, 143, 0.055), transparent 54%, rgba(228, 80, 128, 0.04));
    transition: opacity 0.24s ease;
  }

  .pg-journey-branch-card::after {
    z-index: 0;
    top: -12%;
    right: auto;
    bottom: -12%;
    left: -42%;
    width: 74%;
    background: var(--solution-shine-band);
    filter: blur(2px);
    mask-image: var(--solution-shine-mask);
    -webkit-mask-image: var(--solution-shine-mask);
    mix-blend-mode: screen;
    transform: translateX(-125%) skewX(-10deg);
    transition: opacity 0.24s ease, transform 0.88s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pg-journey-branch-card:hover,
  .pg-journey-branch-card:focus-visible,
  .pg-journey-branch-card.is-active {
    border-color: rgba(20, 149, 143, 0.42);
    box-shadow: 0 22px 42px rgba(23, 32, 51, 0.14), 0 0 0 1px rgba(20, 149, 143, 0.08);
    transform:
      perspective(900px)
      rotateX(var(--card-tilt-y, 0deg))
      rotateY(var(--card-tilt-x, 0deg))
      translateY(-8px);
  }

  .pg-journey-branch-card:hover::before,
  .pg-journey-branch-card:focus-visible::before,
  .pg-journey-branch-card.is-active::before {
    opacity: 0.58;
  }

  .pg-journey-branch-card:hover::after,
  .pg-journey-branch-card:focus-visible::after,
  .pg-journey-branch-card.is-active::after {
    opacity: 0.4;
    transform: translateX(245%) skewX(-10deg);
  }

  .pg-journey-stage.is-reacting .pg-journey-branch-card:not(.is-active) {
    opacity: 0.55;
    filter: saturate(0.74);
  }

  .pg-journey-stage.is-reacting .pg-journey-core:not(.is-active) {
    opacity: 0.82;
    filter: saturate(0.9);
  }

  .pg-journey-branch-card:focus-visible {
    outline: 3px solid rgba(20, 149, 143, 0.3);
    outline-offset: 5px;
  }

  .pg-journey-branch-head,
  .pg-journey-leaves {
    position: relative;
    z-index: 1;
  }

  .pg-journey-branch-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .pg-journey-branch-range {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 1px solid rgba(20, 149, 143, 0.32);
    border-radius: 999px;
    background:
      radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.92), transparent 34%),
      linear-gradient(145deg, #e8fbf8 0%, #ccefeb 100%);
    box-shadow: 0 12px 28px rgba(20, 149, 143, 0.12);
    color: var(--solution-teal);
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
  }

  .pg-journey-branch-range::after {
    content: "";
    position: absolute;
    right: 5px;
    bottom: 6px;
    width: 10px;
    height: 10px;
    border: 2px solid #ffffff;
    border-radius: 999px;
    background: var(--solution-rose);
  }

  .pg-journey-branch-head h3 {
    margin: 0;
    color: var(--solution-navy);
    font-size: clamp(1.12rem, 1.7vw, 1.34rem);
    line-height: 1.12;
  }

  .pg-journey-branch-head p {
    margin: 7px 0 0;
    color: var(--solution-ink-soft);
    font-size: 0.94rem;
    line-height: 1.48;
  }

  .pg-journey-leaves {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-journey-leaves li {
    display: grid;
    grid-template-columns: var(--leaf-size) minmax(0, 1fr);
    gap: 10px;
    align-items: start;
  }

  .pg-journey-leaf-marker {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--leaf-size);
    aspect-ratio: 1;
    border: 1px solid var(--branch-stroke);
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 8px 18px var(--branch-glow);
    color: var(--solution-teal);
    font-size: 0.68rem;
    font-weight: 920;
    transition: transform 0.26s ease, box-shadow 0.26s ease;
  }

  .pg-journey-leaf-marker::after {
    content: "";
    position: absolute;
    right: -4px;
    bottom: -2px;
    width: max(6px, calc(var(--leaf-size) * 0.24));
    aspect-ratio: 1;
    border: 2px solid #ffffff;
    border-radius: inherit;
    background: var(--solution-amber);
  }

  .pg-journey-branch-card:hover .pg-journey-leaf-marker,
  .pg-journey-branch-card:focus-visible .pg-journey-leaf-marker,
  .pg-journey-branch-card.is-active .pg-journey-leaf-marker {
    box-shadow: 0 10px 22px var(--branch-glow);
    transform: translateY(calc(var(--leaf-index) * -2px)) scale(1.04);
  }

  .pg-journey-leaves .pg-journey-phase {
    margin-bottom: 3px;
    font-size: 0.7rem;
    letter-spacing: 0.07em;
  }

  .pg-journey-leaves strong {
    display: block;
    color: var(--solution-navy);
    font-size: 0.98rem;
    font-weight: 900;
    line-height: 1.16;
  }

  .pg-journey-leaves p {
    margin: 4px 0 0;
    color: var(--solution-ink-soft);
    font-size: 0.86rem;
    line-height: 1.42;
  }

  @keyframes pgJourneyBranchIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.975);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes pgJourneyRingBreath {
    0%,
    100% {
      opacity: 0.28;
      transform: scale(0.96);
    }

    50% {
      opacity: 0.52;
      transform: scale(1.04);
    }
  }

  @keyframes pgJourneyHaloDrift {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes pgJourneyAmbientPulse {
    0%,
    100% {
      opacity: 0.26;
      transform: scale(0.96);
    }

    50% {
      opacity: 0.44;
      transform: scale(1.04);
    }
  }

  .pg-solutions-journey {
    position: relative;
    z-index: 10;
    display: flex;
    min-height: 100vh;
    align-items: center;
    overflow: hidden;
    scroll-margin-top: 96px;
    background: var(--solution-surface);
    padding: clamp(3rem, 6vw, 5rem) clamp(2%, 5vw, 5%);
  }

  .pg-solutions-journey::before {
    display: none;
  }

  .pg-journey-content-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: clamp(3rem, 4.5vw, 5rem);
  }

  .pg-journey-panels-container {
    flex: 1;
    max-width: 50%;
  }

  .pg-journey-section-header {
    margin-bottom: 32px;
  }

  .pg-journey-section-title {
    margin: 0;
    color: var(--solution-navy);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .pg-journey-subtitle {
    max-width: 90%;
    margin: 16px 0 0;
    color: var(--solution-ink-soft);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .pg-journey-panels-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pg-journey-panel-card {
    --journey-gradient: linear-gradient(145deg, #ffe984 0%, #f6c44b 48%, #e0981e 100%);
    --journey-soft: rgba(235, 171, 42, 0.1);
    --journey-wash: linear-gradient(135deg, rgba(235, 171, 42, 0.11), rgba(235, 171, 42, 0.03));
    --journey-border-color: rgba(235, 171, 42, 0.42);
    --journey-glow-color: rgba(235, 171, 42, 0.28);
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0;
    border: 1px solid var(--solution-border);
    border-radius: 1.5rem;
    background: var(--solution-surface);
    box-shadow: 0 1px 3px rgba(23, 32, 51, 0.08), 0 1px 2px rgba(23, 32, 51, 0.06);
    cursor: pointer;
    overflow: hidden;
    padding: clamp(1.05rem, 1.65vw, 1.4rem);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .pg-journey-panel-card.is-secondary {
    --journey-gradient: linear-gradient(145deg, #ff9f88 0%, #ff6474 46%, #da3464 100%);
    --journey-soft: rgba(239, 82, 100, 0.1);
    --journey-wash: linear-gradient(135deg, rgba(239, 82, 100, 0.11), rgba(239, 82, 100, 0.03));
    --journey-border-color: rgba(239, 82, 100, 0.4);
    --journey-glow-color: rgba(239, 82, 100, 0.28);
  }

  .pg-journey-panel-card.is-success {
    --journey-gradient: linear-gradient(145deg, #ffacd9 0%, #d56fab 50%, #9f4d96 100%);
    --journey-soft: rgba(211, 101, 166, 0.1);
    --journey-wash: linear-gradient(135deg, rgba(211, 101, 166, 0.11), rgba(211, 101, 166, 0.03));
    --journey-border-color: rgba(211, 101, 166, 0.4);
    --journey-glow-color: rgba(211, 101, 166, 0.28);
  }

  .pg-journey-panel-card.is-accent {
    --journey-gradient: linear-gradient(145deg, #c2b7ff 0%, #8d72ff 48%, #6844d7 100%);
    --journey-soft: rgba(129, 103, 238, 0.1);
    --journey-wash: linear-gradient(135deg, rgba(129, 103, 238, 0.12), rgba(129, 103, 238, 0.03));
    --journey-border-color: rgba(129, 103, 238, 0.42);
    --journey-glow-color: rgba(129, 103, 238, 0.3);
  }

  .pg-journey-panel-card.is-warning {
    --journey-gradient: linear-gradient(145deg, #d2ff9c 0%, #8ee17a 30%, #39bb7b 50%, #ffab55 70%, #ff773c 100%);
    --journey-soft: rgba(82, 183, 105, 0.1);
    --journey-wash: linear-gradient(135deg, rgba(82, 183, 105, 0.1), rgba(255, 145, 65, 0.1));
    --journey-border-color: rgba(117, 190, 90, 0.4);
    --journey-glow-color: rgba(255, 145, 65, 0.26);
  }

  .pg-journey-panel-card:hover,
  .pg-journey-panel-card.is-linked-active {
    border-color: var(--journey-border-color);
    box-shadow: 0 10px 25px -5px rgba(23, 32, 51, 0.08);
    transform: translateY(-8px) translateX(8px);
  }

  .pg-journey-panel-card:focus-visible {
    outline: 3px solid rgba(175, 130, 50, 0.28);
    outline-offset: 4px;
  }

  .pg-journey-panel-card.is-linked-dimmed {
    opacity: 0.54;
    transform: scale(0.985);
  }

  .pg-journey-icon-wrapper {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    width: 60px;
    height: 60px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--journey-soft);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pg-journey-panel-card:hover .pg-journey-icon-wrapper,
  .pg-journey-panel-card.is-linked-active .pg-journey-icon-wrapper {
    box-shadow: 0 8px 25px var(--journey-glow-color);
    transform: scale(1.1) rotate(5deg);
  }

  .pg-journey-gradient-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--journey-gradient);
    box-shadow: 0 4px 15px rgba(23, 32, 51, 0.16);
    transition: transform 0.3s ease, box-shadow 0.3s ease, filter 0.3s ease;
    animation: pgJourneyIconPulse 3s ease-in-out infinite;
  }

  .pg-journey-panel-card:hover .pg-journey-gradient-icon,
  .pg-journey-panel-card.is-linked-active .pg-journey-gradient-icon {
    box-shadow: 0 8px 22px var(--journey-glow-color);
    filter: brightness(1.1);
    transform: scale(1.2);
  }

  .pg-journey-card-content {
    position: relative;
    z-index: 2;
    flex: 1;
    min-width: 0;
  }

  .pg-journey-card-range {
    display: inline-flex;
    margin-bottom: 0.45rem;
    color: var(--journey-border-color);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .pg-journey-panel-card h3 {
    margin: 0 0 0.4rem;
    color: var(--solution-navy);
    font-size: clamp(1.08rem, 1.9vw, 1.42rem);
    font-weight: 760;
    line-height: 1.25;
    transition: color 0.3s ease;
  }

  .pg-journey-panel-card p {
    margin: 0;
    color: var(--solution-ink-soft);
    font-size: clamp(0.92rem, 1.25vw, 1rem);
    line-height: 1.5;
    transition: color 0.3s ease;
  }

  .pg-journey-panel-card:hover h3,
  .pg-journey-panel-card.is-linked-active h3 {
    color: var(--solution-teal);
  }

  .pg-journey-panel-card:hover p,
  .pg-journey-panel-card.is-linked-active p {
    color: var(--solution-navy);
  }

  .pg-journey-card-wash {
    position: absolute;
    inset: 0;
    background: var(--journey-wash);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .pg-journey-panel-card:hover .pg-journey-card-wash,
  .pg-journey-panel-card.is-linked-active .pg-journey-card-wash {
    opacity: 1;
  }

  .pg-journey-image-wrapper {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .pg-journey-orbit {
    position: relative;
    display: flex;
    width: 100%;
    max-width: 880px;
    min-height: clamp(560px, 62vh, 760px);
    align-items: center;
    justify-content: center;
    gap: clamp(0.25rem, 0.85vw, 0.9rem);
    margin: 0 auto;
    isolation: isolate;
    overflow: visible;
  }

  .pg-journey-node-column {
    --journey-node-size: clamp(72px, 5.35vw, 96px);
    --journey-node-font-size: clamp(0.58rem, 0.86vw, 0.82rem);
    --journey-node-margin: clamp(0.18rem, 0.45vw, 0.42rem);
    --journey-node-ring-gap: clamp(0.28rem, 0.62vw, 0.58rem);
    --journey-node-ring-width: clamp(1px, 0.18vw, 2px);

    display: flex;
    flex: 0 1 clamp(76px, 7.2vw, 116px);
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    min-height: clamp(430px, 52vh, 650px);
    gap: clamp(0.55rem, 1vw, 1.05rem);
  }

  .pg-journey-node-column.is-column-one,
  .pg-journey-node-column.is-column-five {
    --journey-node-size: clamp(54px, 4.1vw, 70px);
    --journey-node-font-size: clamp(0.48rem, 0.68vw, 0.64rem);
    --journey-node-margin: clamp(0.08rem, 0.22vw, 0.18rem);
    --journey-node-ring-gap: clamp(0.16rem, 0.34vw, 0.3rem);
    --journey-node-ring-width: 1px;

    flex-basis: clamp(58px, 5vw, 82px);
    min-height: clamp(350px, 45vh, 520px);
    transform: translateY(1.15rem);
  }

  .pg-journey-node-column.is-column-two,
  .pg-journey-node-column.is-column-four {
    --journey-node-size: clamp(66px, 4.9vw, 86px);
    --journey-node-font-size: clamp(0.54rem, 0.78vw, 0.74rem);
    --journey-node-ring-gap: clamp(0.22rem, 0.46vw, 0.44rem);

    flex-basis: clamp(70px, 6.2vw, 100px);
    min-height: clamp(455px, 54vh, 660px);
    transform: translateY(-0.45rem);
  }

  .pg-journey-node-column.is-column-three {
    --journey-node-size: clamp(76px, 5.6vw, 98px);
    --journey-node-font-size: clamp(0.58rem, 0.86vw, 0.82rem);

    flex-basis: clamp(170px, 15vw, 238px);
    min-height: clamp(520px, 60vh, 720px);
    gap: clamp(0.75rem, 1.25vw, 1.35rem);
  }

  .pg-journey-node,
  .pg-journey-orbit-core {
    --node-text: #ffffff;
    --node-gradient: linear-gradient(145deg, #8ee8ff 0%, #4f7cff 52%, #5b35dd 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(110, 203, 255, 0.92) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(80, 128, 255, 0.3);
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 100%;
    background: var(--node-gradient);
    color: var(--node-text);
    cursor: pointer;
    isolation: isolate;
    transition:
      box-shadow 0.28s ease,
      filter 0.28s ease,
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .pg-journey-node {
    --ring-gap: var(--journey-node-ring-gap);
    --ring-width: var(--journey-node-ring-width);
    width: var(--journey-node-size);
    height: var(--journey-node-size);
    margin: var(--journey-node-margin);
    padding: clamp(0.4rem, 0.86vw, 0.76rem);
    box-shadow:
      inset 0 1px 14px rgba(255, 255, 255, 0.44),
      inset 0 -18px 28px rgba(0, 0, 0, 0.12),
      0 16px 34px var(--glow-color);
  }

  .pg-journey-node::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--ring-gap));
    z-index: -1;
    border-radius: inherit;
    background: var(--ring-gradient);
    filter: drop-shadow(0 0 10px var(--glow-color));
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--ring-width) - 1px),
      #000 calc(100% - var(--ring-width)),
      #000 calc(100% - 1px),
      transparent 100%
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--ring-width) - 1px),
      #000 calc(100% - var(--ring-width)),
      #000 calc(100% - 1px),
      transparent 100%
    );
  }

  .pg-journey-node::after {
    content: "";
    position: absolute;
    inset: 12%;
    border-radius: inherit;
    background: radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.34), transparent 38%);
    pointer-events: none;
  }

  .pg-journey-node p {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: var(--journey-node-font-size);
    font-weight: 760;
    line-height: 1.08;
    text-align: center;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.12);
    white-space: pre-line;
  }

  .pg-journey-orbit-core {
    width: clamp(170px, 15vw, 238px);
    height: clamp(170px, 15vw, 238px);
    margin: clamp(0.5rem, 1vw, 1rem);
    padding: clamp(1.5rem, 3vw, 3.2rem);
    background:
      radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.92) 0 6%, rgba(95, 231, 255, 0.9) 7%, rgba(58, 108, 255, 0.96) 42%, #263bd6 70%, #6726d6 100%);
    box-shadow:
      inset 0 1px 18px rgba(255, 255, 255, 0.36),
      inset 0 -28px 48px rgba(26, 31, 135, 0.22),
      0 24px 60px rgba(38, 65, 214, 0.28);
    flex-direction: column;
    gap: 0.45rem;
    text-align: center;
  }

  .pg-journey-orbit-core::before {
    content: "";
    position: absolute;
    inset: -0.8rem;
    z-index: -1;
    border-radius: inherit;
    background: conic-gradient(from 120deg, rgba(82, 218, 255, 0.18), rgba(124, 88, 255, 0.5), rgba(82, 218, 255, 0.18));
    filter: blur(12px);
    opacity: 0.9;
  }

  .pg-journey-orbit-core-ring {
    position: absolute;
    inset: var(--ring-inset);
    z-index: -1;
    border-radius: inherit;
    border: var(--ring-width) solid rgba(82, 218, 255, var(--ring-opacity));
    box-shadow: 0 0 22px rgba(80, 128, 255, 0.12);
    animation: pgJourneyRingBreath var(--ring-speed) ease-in-out infinite;
  }

  .pg-journey-orbit-core-ring.is-outer {
    --ring-inset: -46px;
    --ring-width: 1px;
    --ring-opacity: 0.18;
    --ring-speed: 6.4s;
  }

  .pg-journey-orbit-core-ring.is-middle {
    --ring-inset: -28px;
    --ring-width: 2px;
    --ring-opacity: 0.22;
    --ring-speed: 5.2s;
  }

  .pg-journey-orbit-core-ring.is-inner {
    --ring-inset: -12px;
    --ring-width: 1px;
    --ring-opacity: 0.3;
    --ring-speed: 4.4s;
  }

  .pg-journey-orbit-core p {
    position: relative;
    z-index: 1;
    max-width: 190px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(1.2rem, 2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    text-shadow: 0 2px 16px rgba(18, 23, 80, 0.36);
    white-space: pre-line;
  }

  .pg-journey-node:hover,
  .pg-journey-node.is-linked-active {
    box-shadow:
      inset 0 1px 16px rgba(255, 255, 255, 0.5),
      inset 0 -18px 28px rgba(0, 0, 0, 0.12),
      0 24px 54px var(--glow-color);
    filter: saturate(1.18) brightness(1.06);
    transform: translateY(-8px) scale(1.12);
  }

  .pg-journey-node:hover::before,
  .pg-journey-node.is-linked-active::before {
    animation: pgJourneyRingSpin 6s linear infinite;
    filter: drop-shadow(0 0 16px var(--glow-color));
  }

  .pg-journey-node.is-linked-dimmed {
    opacity: 0.36;
    filter: grayscale(0.2) saturate(0.78);
    transform: scale(0.94);
  }

  .pg-journey-orbit-core:hover,
  .pg-journey-orbit-core.is-linked-active {
    box-shadow:
      inset 0 1px 20px rgba(255, 255, 255, 0.42),
      inset 0 -28px 48px rgba(26, 31, 135, 0.2),
      0 30px 78px rgba(38, 65, 214, 0.36);
    filter: saturate(1.16) brightness(1.04);
    transform: scale(1.06);
  }

  .pg-journey-orbit-core.is-linked-dimmed {
    opacity: 0.58;
  }

  .pg-journey-node:focus-visible,
  .pg-journey-orbit-core:focus-visible {
    outline: 3px solid rgba(175, 130, 50, 0.3);
    outline-offset: 8px;
  }

  .pg-journey-node.is-first {
    --node-text: #3c2700;
    --node-gradient: linear-gradient(145deg, #ffe984 0%, #f6c44b 48%, #e0981e 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(255, 215, 85, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(235, 171, 42, 0.34);
  }

  .pg-journey-node.is-second,
  .pg-journey-node.is-eighth {
    --node-gradient: linear-gradient(145deg, #ffacd9 0%, #d56fab 50%, #9f4d96 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(226, 112, 175, 0.94) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(211, 101, 166, 0.32);
  }

  .pg-journey-node.is-third,
  .pg-journey-node.is-ninth {
    --node-gradient: linear-gradient(145deg, #ff9f88 0%, #ff6474 46%, #da3464 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(255, 92, 108, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(239, 82, 100, 0.34);
  }

  .pg-journey-node.is-fourth,
  .pg-journey-node.is-tenth {
    --node-gradient: linear-gradient(145deg, #c2b7ff 0%, #8d72ff 48%, #6844d7 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(139, 115, 255, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(129, 103, 238, 0.34);
  }

  .pg-journey-node.is-fifth,
  .pg-journey-node.is-eleventh {
    --node-text: #0d361f;
    --node-gradient: linear-gradient(145deg, #d2ff9c 0%, #8ee17a 47%, #39bb7b 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(107, 205, 95, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(82, 183, 105, 0.32);
  }

  .pg-journey-node.is-sixth,
  .pg-journey-node.is-twelfth {
    --node-text: #4a2100;
    --node-gradient: linear-gradient(145deg, #ffd58f 0%, #ffab55 46%, #ff773c 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(255, 164, 75, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(255, 145, 65, 0.34);
  }

  .pg-journey-node.is-seventh {
    --node-gradient: linear-gradient(145deg, #8ee8ff 0%, #4f7cff 52%, #5b35dd 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(110, 203, 255, 0.92) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(80, 128, 255, 0.3);
  }

  .pg-journey-node.is-first,
  .pg-journey-node.is-twelfth {
    --journey-node-size: clamp(50px, 3.75vw, 64px);
    --journey-node-font-size: clamp(0.44rem, 0.62vw, 0.58rem);
  }

  .pg-journey-node.is-second,
  .pg-journey-node.is-eleventh {
    --journey-node-size: clamp(58px, 4.25vw, 74px);
    --journey-node-font-size: clamp(0.48rem, 0.68vw, 0.64rem);
  }

  @keyframes pgJourneyIconPulse {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.05);
    }
  }

  @keyframes pgJourneyRingSpin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (max-width: 1200px) {
    .pg-journey-content-wrapper {
      flex-direction: column;
      gap: 4rem;
      text-align: center;
    }

    .pg-journey-panels-container {
      max-width: 100%;
    }

    .pg-journey-section-header {
      margin-bottom: 2.5rem;
    }

    .pg-journey-subtitle {
      max-width: 100%;
      margin-inline: auto;
    }

    .pg-journey-panels-grid {
      max-width: 680px;
      margin: 0 auto;
    }

    .pg-journey-orbit {
      max-width: 860px;
    }
  }

  @media (max-width: 850px) {
    .pg-solutions-journey {
      padding: 3rem 4%;
    }

    .pg-journey-content-wrapper {
      gap: 3rem;
    }

    .pg-journey-section-header {
      margin-bottom: 2rem;
    }

    .pg-journey-panels-grid {
      gap: 1rem;
    }

    .pg-journey-panel-card {
      gap: 1rem;
      padding: 1.35rem;
      text-align: left;
    }

    .pg-journey-icon-wrapper {
      width: 52px;
      height: 52px;
    }

    .pg-journey-gradient-icon {
      width: 34px;
      height: 34px;
    }

    .pg-journey-orbit {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      min-height: auto;
      padding: 1rem 0;
    }

    .pg-journey-node-column {
      display: contents;
    }

    .pg-journey-orbit-core {
      grid-column: 1 / -1;
      justify-self: center;
      order: -1;
    }

    .pg-journey-node {
      justify-self: center;
      width: clamp(70px, 18vw, 96px);
      height: clamp(70px, 18vw, 96px);
      margin: 0.35rem;
    }
  }

  @media (max-width: 520px) {
    .pg-solutions-journey {
      padding: 2.5rem 4%;
    }

    .pg-journey-content-wrapper {
      gap: 2rem;
    }

    .pg-journey-panel-card {
      align-items: flex-start;
      border-radius: 1.1rem;
      padding: 1.2rem;
    }

    .pg-journey-orbit {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .pg-journey-node {
      width: clamp(64px, 24vw, 86px);
      height: clamp(64px, 24vw, 86px);
      --ring-gap: 0.28rem;
      --ring-width: 1px;
    }

