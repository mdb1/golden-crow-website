---
const {time, text_1, text_2, items} = Astro.props;
---
<div class="container">
    <h3 class="time">{time}</h3>
    <div class="description">
        <p class="description_1">{text_1}</p>
        <p class="description_2">{text_2}</p>
    </div>

    <ul>
        {items.map((item: string) => (
            <li>
                <p class="item">{item}</p>
            </li>
        ))}
    </ul>
</div>

<style>
    .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-primary);
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 2rem;
        padding: 2.5rem 2rem;
        margin: 1rem;
        box-shadow: var(--card-shadow);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        max-width: 300px;
        min-height: 400px;
    }

    .container:hover {
        transform: translateY(-8px);
        box-shadow: var(--card-shadow-hover);
    }

    .time {
        text-align: center;
        color: var(--text-primary);
        font-size: clamp(1rem, 2vw, 2rem);
        font-weight: 700;
        padding: 1rem 2rem;
        background: rgba(64, 37, 239, 0.06);
        border: 1px solid var(--card-border);
        border-radius: 2rem;
        box-shadow: var(--card-shadow);
        margin-bottom: 2rem;
        min-width: 200px;
        transition: all 0.3s ease;
    }

    .container:hover .time {
        transform: scale(1.05);
    }

    .description {
        background: rgba(64, 37, 239, 0.06);
        border: 1px solid var(--card-border);
        color: var(--text-primary);
        font-size: clamp(1rem, 1.3vw, 1.3rem);
        font-weight: 700;
        text-align: center;
        padding: 1.5rem 2rem;
        border-radius: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
    }

    .container:hover .description {
        transform: scale(1.02);
    }

    ul {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
    }

    li {
        background: var(--bg-tertiary);
        border: 1px solid var(--card-border);
        border-radius: 0.75rem;
        margin: 0.75rem 0;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    li::before {
        content: '•';
        color: var(--brand-color);
        font-size: 1.5rem;
        margin-right: 0.5rem;
        font-weight: bold;
    }

    li:hover {
        transform: translateX(5px);
    }

    .item {
        font-size: clamp(1rem, 1.2vw, 1.3rem);
        font-weight: 600;
        margin: 0;
        color: var(--text-secondary);
        line-height: 1.4;
    }

    .description_1 {
        font-size: clamp(1rem, 1.3vw, 1.3rem);
        font-weight: 700;
        margin: 0;
        line-height: 1.3;
    }

    .description_2 {
        font-size: clamp(1rem, 1.3vw, 1.3rem);
        font-weight: 700;
        margin: 0.5rem 0 0 0;
        line-height: 1.3;
    }
</style>