  });

  if (!contentId) {
    openLink.setAttribute('aria-disabled', 'true');
    openLink.removeAttribute('href');
    setStatusMessage(copy.missing);
  } else {
    const query = `?id=${encodeURIComponent(contentId)}`;
    const customURL = `${customSchemeBase}${query}`;
    const androidIntent = `intent://${area}/${resource}${query}#Intent;scheme=pocketgenes;package=goldencrowvs.pocketgenes;S.browser_fallback_url=${encodeURIComponent(PLAY_STORE_URL)};end`;
    const isAndroid = /Android/i.test(navigator.userAgent);
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    const appURL = isAndroid ? androidIntent : customURL;

    openLink.setAttribute('href', appURL);

    if (isMobile) {
      setStatusRetry(copy.openingPrefix, copy.retryLink, copy.openingSuffix);
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') {
          window.location.assign(appURL);
        }
      }, 150);
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') {
          setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
        }
      }, 1600);
    } else {
      setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
    }

    loadSharedPreview(contentId);
  }

  function setStatusMessage(message) {
    if (statusPrefix) statusPrefix.textContent = message;
    if (statusSuffix) statusSuffix.textContent = '';
    if (openLink) {
      openLink.textContent = '';
      openLink.hidden = true;
    }
  }

  function randomTitle(options) {
    return options[Math.floor(Math.random() * options.length)] ?? options[0];
  }

  function setStatusRetry(prefix, linkText, suffix) {
    if (statusPrefix) statusPrefix.textContent = prefix;
    if (statusSuffix) statusSuffix.textContent = suffix;
    if (openLink) {
      openLink.textContent = linkText;
      openLink.hidden = false;
    }
  }

  function loadSharedPreview(id) {
    if (!preview || area !== 'discover' || !['feed_entries', 'organizations'].includes(resource)) {
      return;
    }

    const collection = resource === 'organizations' ? 'feed_organizations' : 'feed_items';
    const encodedId = encodeURIComponent(id);
    const url = `https://firestore.googleapis.com/v1/projects/${FIRESTORE_PROJECT_ID}/databases/(default)/documents/${collection}/${encodedId}?key=${FIRESTORE_API_KEY}`;

    fetch(url)
      .then((response) => {
        if (!response.ok) {
          throw new Error('Preview unavailable');
        }
        return response.json();
      })
      .then((document) => {
        const fields = parseFirestoreFields(document.fields ?? {});
        const previewData =
          resource === 'organizations'
            ? organizationPreviewData(fields)
            : feedEntryPreviewData(fields);

        if (!previewData) {
          return;
        }

        renderPreview(previewData);
      })
      .catch(() => {
        preview.hidden = true;
      });
  }

  function updateStoreCard(card, labels) {
    if (!card) return;
    card.setAttribute('aria-label', labels.ariaLabel);
    const kicker = card.querySelector('[data-store-kicker]');
    const note = card.querySelector('[data-store-note]');
    const badge = card.querySelector('.store-badge');
    if (kicker) kicker.textContent = labels.kicker;
    if (note) note.textContent = labels.note;
    if (badge) badge.setAttribute('alt', labels.imageAlt);
  }

  function parseFirestoreFields(fields) {
    return Object.fromEntries(
      Object.entries(fields).map(([key, value]) => [key, parseFirestoreValue(value)])
    );
  }

  function parseFirestoreValue(value) {
    if (!value || typeof value !== 'object') {
      return null;
    }
    if ('stringValue' in value) return value.stringValue;
    if ('booleanValue' in value) return Boolean(value.booleanValue);
    if ('integerValue' in value) return Number(value.integerValue);
    if ('doubleValue' in value) return Number(value.doubleValue);
    if ('timestampValue' in value) return value.timestampValue;
    if ('nullValue' in value) return null;
    if ('arrayValue' in value) {
      return (value.arrayValue.values ?? []).map(parseFirestoreValue);
    }
    if ('mapValue' in value) {
      return parseFirestoreFields(value.mapValue.fields ?? {});
    }
    return null;
  }

  function cleanText(value) {
    return typeof value === 'string' && value.trim() ? value.trim() : '';
  }

  function externalUrl(value) {
    const text = cleanText(value);
    if (!text) return '';
    if (/^(mailto:|tel:)/i.test(text)) return text;

    try {
      const url = new URL(/^https?:\/\//i.test(text) ? text : `https://${text}`);
      return ['http:', 'https:'].includes(url.protocol) ? url.toString() : '';
    } catch {
      return '';
    }
  }

  function imageSource(value) {
    const text = cleanText(value);
    if (!text) return '';
    if (/^data:image\/(?:png|jpe?g|webp|gif|svg\+xml);base64,/i.test(text)) {
      return text;
    }
    if (text.startsWith('/')) {
      return text;
    }
    return externalUrl(text);
  }

  function socialHref(key, value) {
    const text = cleanText(value);
    if (!text) return '';
    if (key === 'email' && !/^(mailto:|https?:\/\/)/i.test(text)) {
      return `mailto:${text}`;
    }
    return externalUrl(text);
  }

  function typeLabel(type) {
    return copy.types[type] ?? humanize(type);
  }

  function humanize(value) {
    return cleanText(value)
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function formatDate(value) {
    const text = cleanText(value);
    if (!text) return '';

    const date = new Date(text);
    if (Number.isNaN(date.getTime())) {
      return '';
    }

    return new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(date);
  }

  function organizationPreviewData(fields) {
    if (cleanText(fields.status) !== 'active') {
      return null;
    }

    const name = cleanText(fields.name);
    const body = localizedDescription(fields);
    if (!name || !body) {
      return null;
    }
    const categories = labelsForCsv(fields.organizationType, organizationCategoryLabelByKey);
    const countries = countriesForCsv(fields.countryCode);
    const reports =
      fields.isGeneticReportProvider === true
        ? labelsForCsv(fields.geneticReportCategory, geneticReportCategoryLabelByKey)
        : [];
    const socials = socialLinksForPreview(fields.social);
    const isHighlighted = fields.isGrcHighlighted === true;
    const websiteUrl = externalUrl(fields.websiteUrl);

    return {
      kind: 'organization',
      eyebrow: copy.organizationPreview,
      publisher: '',
      title: name,
      pageTitle: isEnglish ? `${name}\non Pocket Genes` : `${name}\nen Pocket Genes`,
      pageDescription: copy.organizationDescription,
      summary: '',
      body,
      imageUrl: imageSource(fields.imageUrl) || imageSource(fields.imageUploadDataUrl),
      bannerUrl: isHighlighted
        ? imageSource(fields.bannerImageUrl) || imageSource(fields.bannerImageUploadDataUrl)
        : '',
      mediaUrl: '',
      websiteUrl,
      websiteLabel: websiteUrl ? compactUrlLabel(websiteUrl) : copy.website,
      badges: [
        fields.verified === true ? copy.verified : '',
        fields.isGeneticReportProvider === true ? copy.geneticReportProvider : '',
        isHighlighted ? copy.highlighted : '',
      ].filter(Boolean),
      categories,
      countries,
      reports,
      socials,
      meta: [],
      accent: readColor(fields.colorHex),
    };
  }

  function feedEntryPreviewData(fields) {
    if (cleanText(fields.status) !== 'published') {
      return null;
    }

    const type = cleanText(fields.type) || 'news';
    const payloadKey = discoverFeedPayloadKeys[type] ?? type;
    const payload = fields[payloadKey] && typeof fields[payloadKey] === 'object' ? fields[payloadKey] : {};
    const title = cleanText(fields.title) || cleanText(payload.title);
    const summary = cleanText(fields.subtitle) || cleanText(fields.summary) || cleanText(payload.summary);
    const body = cleanText(fields.body) || cleanText(payload.detailBody);

    if (!title || (!summary && !body)) {
      return null;
    }

    const eventPreview = type === 'upcoming_event' ? eventPreviewData(payload) : null;
    const eventDate = eventPreview ? '' : formatDate(payload.date || payload.startsAt);
    const meta = [
      eventDate,
      eventPreview ? '' : cleanText(payload.location),
      Array.isArray(payload.genes) ? payload.genes.slice(0, 3).join(', ') : '',
      Array.isArray(payload.conditions) ? payload.conditions.slice(0, 2).join(', ') : '',
      cleanText(payload.journal),
      cleanText(payload.opportunityType),
    ].filter(Boolean);

    return {
      kind: 'feed',
      eyebrow: copy.feedPreview,
      publisher: cleanText(fields.publisherSnapshot?.name) || 'Pocket Genes',
      title,
      summary,
      body,
      imageUrl:
        imageSource(fields.publisherSnapshot?.imageUrl) ||
        imageSource(fields.publisherSnapshot?.imageUploadDataUrl) ||
        '/pocket-genes/icon_simple.png',
      bannerUrl: '',
      mediaUrl:
        imageSource(fields.imageUrl) ||
        imageSource(fields.imageUploadDataUrl) ||
        imageSource(payload.imageUrl),
      websiteUrl: externalUrl(fields.sourceUrl),
      websiteLabel: copy.website,
      badges: [typeLabel(type)],
      categories: [],
      countries: [],
      reports: [],
      socials: [],
      meta,
      event: eventPreview,
      accent: '',
    };
  }

  function eventPreviewData(payload) {
    if (!payload || typeof payload !== 'object') {
      return null;
    }

    const startDate = datePartsFromValue(payload.date || payload.startsAt);
    if (!startDate) {
      return null;
    }

    const duration = positiveInteger(payload.multiDayLength) || 1;
    const endDate = addCalendarDays(startDate, duration - 1);
    const kind = enumLabel(payload.eventKind, copy.event.kinds);
    const status = eventStatusLabel(payload.eventStatus);
    const schedule = eventScheduleData(payload, startDate, endDate, duration);
    const facts = eventFactData(payload);
    const takingPart = eventTakingPartData(payload);
    const organizer = eventOrganizerData(payload);
    const actions = eventActionData(payload.actionButtons);

    return {
      classification: kind,
      duration: duration > 1 ? `${duration} ${duration === 1 ? copy.event.day : copy.event.days}` : '',
      status,
      listedSchedule: ['cancelled', 'postponed'].includes(cleanText(payload.eventStatus)),
      date: formatEventDateRange(startDate, endDate),
      year: sameDateYear(startDate, endDate) ? String(startDate.year) : '',
      schedule,
      facts,
      takingPart,
      organizer,
      actions,
    };
  }

  function positiveInteger(value) {
    const number = Number(value);
    return Number.isInteger(number) && number > 0 ? number : null;
  }

  function uniqueCleanArray(value) {
    if (!Array.isArray(value)) return [];
    const seen = new Set();
    return value
      .map((entry) => cleanText(entry))
      .filter((entry) => {
        if (!entry || seen.has(entry)) return false;
        seen.add(entry);
        return true;
      });
  }

  function enumLabel(value, labels) {
    const key = cleanText(value);
    return key && labels[key] ? labels[key] : '';
  }

  function datePartsFromValue(value) {
    const text = cleanText(value);
    if (!text) return null;
    const date = new Date(text);
    if (Number.isNaN(date.getTime())) return null;
    return {
      year: date.getUTCFullYear(),
      month: date.getUTCMonth() + 1,
      day: date.getUTCDate(),
    };
  }

  function dateFromParts(parts) {
    return new Date(Date.UTC(parts.year, parts.month - 1, parts.day));
  }

  function addCalendarDays(parts, days) {
    const date = dateFromParts(parts);
    date.setUTCDate(date.getUTCDate() + days);
    return {
      year: date.getUTCFullYear(),
      month: date.getUTCMonth() + 1,
      day: date.getUTCDate(),
    };
  }

  function sameDateYear(start, end) {
    return start.year === end.year;
  }

  function sameCalendarDay(start, end) {
    return start.year === end.year && start.month === end.month && start.day === end.day;
  }

  function monthName(parts, width = 'long') {
    return new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', {
      month: width,
      timeZone: 'UTC',
    }).format(dateFromParts(parts));
  }

  function dayMonth(parts, width = 'long') {
    const month = monthName(parts, width);
    return isEnglish ? `${parts.day} ${month}` : `${parts.day} de ${month}`;
  }

  function dayMonthYear(parts, width = 'short') {
    return `${dayMonth(parts, width)} ${parts.year}`;
  }

  function formatEventDateRange(start, end) {
    if (sameCalendarDay(start, end)) {
      return dayMonth(start, 'long');
    }
    if (start.year === end.year && start.month === end.month) {
      const month = monthName(start, 'long');
      return isEnglish
        ? `${start.day}\u2013${end.day} ${month}`
        : `${start.day}\u2013${end.day} de ${month}`;
    }
    if (start.year === end.year) {
      return `${dayMonth(start, 'short')}\u2013${dayMonth(end, 'short')}`;
    }
    return `${dayMonthYear(start)}\u2013${dayMonthYear(end)}`;
  }

  function eventStatusLabel(value) {
    const status = cleanText(value);
    if (!status || status === 'scheduled' || status === 'normal') return '';
    return copy.event.status[status] ?? '';
  }

  function validClock(value) {
    return /^([01]\d|2[0-3]):[0-5]\d$/.test(cleanText(value));
  }

  function clockValue(value) {
    const text = cleanText(value);
    return validClock(text) ? text : '';
  }

  function clockStatement(startValue, endValue, duration) {
    const start = clockValue(startValue);
    const end = clockValue(endValue);
    let value = '';
    if (start && end) value = `${start}\u2013${end}`;
    else if (start) value = `${copy.event.starts} ${start}`;
    else if (end) value = `${copy.event.ends} ${end}`;
    if (value && duration > 1) value = `${value} ${copy.event.eachDay}`;
    return value;
  }

  function timezoneLabel(timezone, startDate, endDate) {
    const zone = cleanText(timezone);
    if (!zone) return '';
    try {
      new Intl.DateTimeFormat('en', { timeZone: zone }).format(new Date());
    } catch {
      return '';
    }

    const city = zone.split('/').pop()?.replace(/_/g, ' ') || zone;
    const startOffset = timezoneOffsetLabel(zone, startDate);
    const endOffset = timezoneOffsetLabel(zone, endDate);
    return startOffset && startOffset === endOffset ? `${city} · ${startOffset}` : city;
  }

  function timezoneOffsetLabel(timezone, parts) {
    try {
      const formatter = new Intl.DateTimeFormat('en', {
        timeZone: timezone,
        timeZoneName: 'shortOffset',
        hour: '2-digit',
        minute: '2-digit',
      });
      const label = formatter
        .formatToParts(dateFromParts(parts))
        .find((part) => part.type === 'timeZoneName')?.value;
      if (!label) return '';
      return label
        .replace(/^GMT$/, 'UTC')
        .replace(/^GMT([+-])/, (_, sign) => `UTC${sign === '-' ? '\u2212' : '+'}`);
    } catch {
      return '';
    }
  }

  function eventMap(value) {
    if (!value || typeof value !== 'object' || Array.isArray(value)) return {};
    return Object.fromEntries(
      Object.entries(value)
        .map(([key, entry]) => [cleanText(key).toUpperCase(), cleanText(entry)])
        .filter(([key, entry]) => /^[A-Z]{2}$/.test(key) && entry)
    );
  }

  function countryName(code) {
    const countryDisplayNames =
      typeof Intl.DisplayNames === 'function'
        ? new Intl.DisplayNames([isEnglish ? 'en' : 'es'], { type: 'region' })
        : null;
    return countryDisplayNames?.of(code) ?? code;
  }

  function regionalTimeRows(payload, startDate, endDate, duration) {
    const starts = eventMap(payload.countryDailyStartTimes);
    const ends = eventMap(payload.countryDailyEndTimes);
    const zones = eventMap(payload.countryTimezones);
    const codes = [...new Set([...Object.keys(starts), ...Object.keys(ends), ...Object.keys(zones)])];
    return codes
      .map((code) => ({
        code,
        country: countryName(code),
        time: clockStatement(starts[code], ends[code], duration),
        timezone: timezoneLabel(zones[code], startDate, endDate),
      }))
      .filter((row) => row.time || row.timezone)
      .sort((a, b) => a.country.localeCompare(b.country));
  }

  function eventScheduleData(payload, startDate, endDate, duration) {
    const timeKind = cleanText(payload.timeKind);
    if (timeKind === 'dateOnly') {
      return null;
    }

    const regionalRows =
      timeKind === 'regionalTimes'
        ? regionalTimeRows(payload, startDate, endDate, duration)
        : [];
    let primary = '';
    if (timeKind === 'allDay') primary = copy.event.allDay;
    else if (timeKind === 'timeTba') primary = copy.event.timeTba;
    else primary = clockStatement(payload.dailyStartTime, payload.dailyEndTime, duration);
    if (!primary && timeKind === 'regionalTimes') {
      primary = copy.event.timesVary;
    }

    const timezone =
      timeKind === 'timed' || primary
        ? timezoneLabel(payload.timezone, startDate, endDate)
      : '';
    const location = cleanText(payload.location);
    const attendance = enumLabel(payload.attendanceMode, copy.event.attendance);
    const locationPrimary = location || attendance;
    const locationSecondary =
      location && attendance && location.toLowerCase() !== attendance.toLowerCase()
        ? attendance
        : '';

    return {
      time: primary ? { value: primary, detail: timezone } : null,
      location: locationPrimary ? { value: locationPrimary, detail: locationSecondary } : null,
      regionalRows,
    };
  }

  function eventFactData(payload) {
    const facts = [];
    const admission = admissionLabel(payload);
    const hasCapacityField = Object.prototype.hasOwnProperty.call(payload, 'maxAttendance');
    const capacity = positiveInteger(payload.maxAttendance);
    if (admission) {
      facts.push({ label: copy.event.admission, value: admission });
    }
    if (capacity) {
      facts.push({ label: copy.event.capacity, value: copy.event.upToPeople(capacity) });
    } else if (hasCapacityField && payload.maxAttendance === null) {
      facts.push({ label: copy.event.capacity, value: copy.event.noLimit });
    }
    return facts;
  }

  function admissionLabel(payload) {
    const costType = cleanText(payload.costType);
    if (!costType) return '';
    if (costType === 'free') return copy.event.free;
    if (costType === 'donation') return copy.event.donation;
    if (costType === 'varies') return copy.event.varies;
    if (costType === 'unknown') return copy.event.costUnknown;
    if (costType !== 'paid') return '';
    const currency = cleanText(payload.currency).toUpperCase();
    const price = Number(payload.priceMinorUnits);
    if (!/^[A-Z]{3}$/.test(currency) || !Number.isFinite(price) || price < 0) {
      return copy.event.paid;
    }
    try {
      return new Intl.NumberFormat(isEnglish ? 'en' : 'es-AR', {
        style: 'currency',
        currency,
        currencyDisplay: 'code',
        maximumFractionDigits: Number.isInteger(price) ? 0 : 2,
      }).format(price);
    } catch {
      return copy.event.paid;
    }
  }

  function eventTakingPartData(payload) {
    const audience = labelList(uniqueCleanArray(payload.audience), copy.event.audience);
    const languages = labelList(uniqueCleanArray(payload.languages), copy.event.languages);
    const accessibility = labelList(
      uniqueCleanArray(payload.accessibilityFeatures),
      copy.event.accessibilityValues
    );
    const groups = [];
    if (audience.length) {
      groups.push({
        kind: 'tags',
        label: copy.event.whoFor,
        values: audience,
        preview: valuePreview(audience),
      });
    }
    if (languages.length) {
      groups.push({
        kind: 'text',
        label: copy.event.eventLanguages,
        values: [languages.join(', ')],
        preview: valuePreview(languages),
      });
    }
    if (accessibility.length) {
      groups.push({
        kind: 'checks',
        label: copy.event.accessibility,
        values: accessibility,
        preview: valuePreview(accessibility),
      });
    }
    return groups.length
      ? {
          title: copy.event.takingPart,
          preview: groups[0].preview,
          groups,
          collapsible: groups.length > 1,
        }
      : null;
  }

  function eventOrganizerData(payload) {
    const groups = [];
    const organizerName = cleanText(payload.organizerName);
    const relationship = enumLabel(payload.publisherRelationshipToEvent, copy.event.relationships);
    const disclosure = cleanText(payload.publisherDisclosure);
    if (organizerName) {
      groups.push({
        kind: 'text',
        label: copy.event.organizedBy,
        values: [organizerName],
        preview: `${copy.event.organizedBy} ${organizerName}`,
      });
    }
    if (relationship) {
      groups.push({
        kind: 'text',
        label: copy.event.publisherRole,
        values: [relationship],
        preview: relationship,
      });
    }
    if (disclosure) {
      groups.push({
        kind: 'text',
        label: copy.event.fromPublisher,
        values: [disclosure],
        preview: disclosure,
      });
    }
    return groups.length
      ? {
          title: copy.event.organizer,
          preview: groups[0].preview,
          groups,
          collapsible: groups.length > 1,
        }
      : null;
  }

  function labelList(values, labels) {
    return values.map((value) => labels[value] ?? humanize(value)).filter(Boolean);
  }

  function valuePreview(values) {
    if (values.length <= 2) return values.join(' · ');
    return `${values.slice(0, 2).join(' · ')} +${values.length - 2}`;
  }

  function eventActionData(value) {
    if (!Array.isArray(value)) return [];
    const seen = new Set();
    const supportedTypes = new Set(Object.keys(copy.event.actions));
    return value
      .map((entry) => {
        if (!entry || typeof entry !== 'object') return null;
        const type = cleanText(entry.type);
        const url = externalUrl(entry.url);
        if (!supportedTypes.has(type) || !url || seen.has(type)) return null;
        seen.add(type);
        const title = cleanText(entry.title);
        return {
          type,
          title: title && title.length <= 56 ? title : copy.event.actions[type],
          url,
          external: /^https?:\/\//i.test(url),
        };
      })
      .filter(Boolean);
  }

  function localizedDescription(fields) {
    const baseDescription = cleanText(fields.description);
    const englishDescription = cleanText(fields.descriptionEn);
    return isEnglish ? englishDescription || baseDescription : baseDescription || englishDescription;
  }

  function parseCsv(value) {
    const seen = new Set();
    return cleanText(value)
      .split(',')
      .map((token) => token.trim())
      .filter((token) => {
        if (!token || seen.has(token)) {
          return false;
        }
        seen.add(token);
        return true;
      });
  }

  function labelsForCsv(value, labelMap) {
    return parseCsv(value)
      .map((key) => labelMap.get(key))
      .filter(Boolean);
  }

  function countriesForCsv(value) {
    const countryDisplayNames =
      typeof Intl.DisplayNames === 'function'
        ? new Intl.DisplayNames([isEnglish ? 'en' : 'es'], { type: 'region' })
        : null;

    return parseCsv(value)
      .map((code) => code.toUpperCase())
      .filter((code) => code === 'GLOBAL' || /^[A-Z]{2}$/.test(code))
      .map((code) => ({
        label:
          code === 'GLOBAL'
            ? 'Global'
            : `${countryDisplayNames?.of(code) ?? code} (${code})`,
        flag: countryFlag(code),
      }));
  }

  function countryFlag(code) {
    if (code === 'GLOBAL') {
      return '🌐';
    }

    return code.replace(/[A-Z]/g, (char) =>
      String.fromCodePoint(0x1f1e6 + char.charCodeAt(0) - 65)
    );
  }

  function socialLinksForPreview(social) {
    if (!social || typeof social !== 'object') {
      return [];
    }

    return socialPreviewOptions
      .map((option) => {
        const value = cleanText(social[option.key]);
        const href = socialHref(option.key, value);
        return value && href
          ? {
              label: option.label,
              href,
              assetName: option.assetName,
            }
          : null;
      })
      .filter(Boolean);
  }

  function compactUrlLabel(value) {
    const label = cleanText(value).replace(/^(https?:\/\/|mailto:)/i, '').replace(/\/$/, '');
    return label.length > 32 ? `${label.slice(0, 29)}...` : label;
  }

  function readColor(value) {
    const color = cleanText(value);
    return /^#[0-9a-fA-F]{6}$/.test(color) ? color : '';
  }

  function renderPreview(data) {
    preview.dataset.kind = data.kind;
    if (data.accent) {
      preview.style.setProperty('--shared-preview-accent', data.accent);
    } else {
      preview.style.removeProperty('--shared-preview-accent');
    }

    if (data.pageTitle) {
      title.textContent = data.pageTitle;
    }
    if (data.pageDescription) {
      description.textContent = data.pageDescription;
    }

    setOptionalText('[data-preview-publisher]', data.publisher);
    setText('[data-preview-title]', data.title);
    setOptionalText('[data-preview-summary]', data.summary);
    setOptionalText('[data-preview-body]', data.body);
    renderImage('[data-preview-banner]', data.bannerUrl);
    renderBanner(data.bannerUrl);
    renderImage('[data-preview-image]', data.imageUrl);
    renderImage('[data-preview-media]', data.mediaUrl);
    renderBadges(data.badges);
    renderPreviewSections(data);
    renderMeta(data.meta);
    renderEventPreview(data.event);
    renderWebsite(data.websiteUrl, data.websiteLabel);

    const fallback = preview.querySelector('[data-preview-fallback]');
    if (fallback) {
      fallback.textContent = data.kind === 'organization' ? 'DNA' : 'PG';
      fallback.hidden = Boolean(data.imageUrl);
    }

    preview.hidden = false;
  }

  function setText(selector, value) {
    const node = preview.querySelector(selector);
    if (node) {
      node.textContent = value;
    }
  }

  function setOptionalText(selector, value) {
    const node = preview.querySelector(selector);
    if (!node) return;
    const text = cleanText(value);
    node.textContent = text;
    node.hidden = !text;
  }

  function renderImage(selector, src) {
    const image = preview.querySelector(selector);
    if (!image) return;
    const url = imageSource(src);
    image.hidden = !url;
    if (url) {
      image.setAttribute('src', url);
    } else {
      image.removeAttribute('src');
    }
  }

  function renderBanner(src) {
    const shell = preview.querySelector('[data-preview-banner-shell]');
    if (!shell) return;
    shell.hidden = !imageSource(src);
  }

  function renderBadges(badges) {
    const container = preview.querySelector('[data-preview-badges]');
    if (!container) return;
    container.replaceChildren(
      ...badges.map((badge) => {
        const element = document.createElement('span');
        element.className = 'shared-preview-badge';
        element.textContent = badge;
        return element;
      })
    );
  }

  function renderMeta(meta) {
    const container = preview.querySelector('[data-preview-meta]');
    if (!container) return;
    container.hidden = meta.length === 0;
    container.replaceChildren(
      ...meta.map((item) => {
        const element = document.createElement('span');
        element.textContent = item;
        return element;
      })
    );
  }

  function renderEventPreview(event) {
    const container = preview.querySelector('[data-preview-event]');
    if (!container) return;
    container.replaceChildren();
    container.hidden = !event;
    if (!event) return;

    const nodes = [];
    if (event.classification || event.duration) {
      const row = document.createElement('div');
      row.className = 'shared-event-classification';
      if (event.classification) {
        const kind = document.createElement('span');
        kind.className = 'shared-event-category';
        kind.textContent = event.classification;
        row.append(kind);
      }
      if (event.duration) {
        const duration = document.createElement('span');
        duration.className = 'shared-event-duration';
        duration.textContent = event.duration;
        row.append(duration);
      }
      nodes.push(row);
    }

    if (event.status) {
      const status = document.createElement('p');
      status.className = 'shared-event-status';
      status.textContent = event.status;
      nodes.push(status);
    }

    if (event.listedSchedule) {
      const listed = document.createElement('p');
      listed.className = 'shared-event-listed-schedule';
      listed.textContent = copy.event.listedSchedule;
      nodes.push(listed);
    }

    const date = document.createElement('div');
    date.className = 'shared-event-date';
    const mainDate = document.createElement('p');
    mainDate.className = 'shared-event-date-main';
    mainDate.textContent = event.date;
    date.append(mainDate);
    if (event.year) {
      const year = document.createElement('p');
      year.className = 'shared-event-date-year';
      year.textContent = event.year;
      date.append(year);
    }
    nodes.push(date);

    const schedule = renderEventSchedule(event.schedule);
    if (schedule) nodes.push(schedule);

    const facts = renderEventFacts(event.facts);
    if (facts) nodes.push(facts);

    const takingPart = renderEventDisclosure(event.takingPart);
    if (takingPart) nodes.push(takingPart);

    const organizer = renderEventDisclosure(event.organizer);
    if (organizer) nodes.push(organizer);

    const actions = renderEventActions(event.actions);
    if (actions) nodes.push(actions);

    container.append(...nodes);
  }

  function renderEventSchedule(schedule) {
    if (!schedule || (!schedule.time && !schedule.location && !schedule.regionalRows.length)) {
      return null;
    }
    const section = document.createElement('section');
    section.className = 'shared-event-schedule';
    if (schedule.time) {
      section.append(renderEventInfoRow('◷', schedule.time.value, schedule.time.detail));
    }
    if (schedule.regionalRows.length) {
      const regional = document.createElement('div');
      regional.className = 'shared-event-regional';
      const title = document.createElement('h4');
      title.textContent = copy.event.timesByCountry;
      regional.append(title);
      schedule.regionalRows.forEach((row) => {
        const item = document.createElement('div');
        item.className = 'shared-event-regional-row';
        const country = document.createElement('p');
        country.className = 'shared-event-regional-country';
        country.textContent = row.country;
        item.append(country);
        if (row.time) {
          const time = document.createElement('p');
          time.className = 'shared-event-regional-detail';
          time.textContent = row.time;
          item.append(time);
        }
        if (row.timezone) {
          const zone = document.createElement('p');
          zone.className = 'shared-event-regional-detail';
          zone.textContent = row.timezone;
          item.append(zone);
        }
        regional.append(item);
      });
      section.append(regional);
    }
    if (schedule.location) {
      section.append(renderEventInfoRow('⌖', schedule.location.value, schedule.location.detail));
    }
    return section;
  }

  function renderEventInfoRow(icon, value, detail) {
    const row = document.createElement('div');
    row.className = 'shared-event-info-row';
    const symbol = document.createElement('span');
    symbol.className = 'shared-event-info-icon';
    symbol.setAttribute('aria-hidden', 'true');
    symbol.textContent = icon;
    const text = document.createElement('div');
    const main = document.createElement('p');
    main.className = 'shared-event-info-value';
    main.textContent = value;
    text.append(main);
    if (detail) {
      const secondary = document.createElement('p');
      secondary.className = 'shared-event-info-detail';
      secondary.textContent = detail;
      text.append(secondary);
    }
    row.append(symbol, text);
    return row;
  }

  function renderEventFacts(facts) {
    if (!facts?.length) return null;
    const section = document.createElement('section');
    section.className = 'shared-event-facts';
    facts.forEach((fact) => {
      const item = document.createElement('div');
      item.className = 'shared-event-fact';
      const label = document.createElement('p');
      label.className = 'shared-event-field-label';
      label.textContent = fact.label;
      const value = document.createElement('p');
      value.className = 'shared-event-fact-value';
      value.textContent = fact.value;
      item.append(label, value);
      section.append(item);
    });
    return section;
  }

  function renderEventDisclosure(sectionData) {
    if (!sectionData?.groups?.length) return null;
    if (!sectionData.collapsible) {
      const section = document.createElement('section');
      section.className = 'shared-event-disclosure shared-event-disclosure-static';
      const heading = document.createElement('h3');
      heading.textContent = sectionData.title;
      const content = document.createElement('div');
      content.className = 'shared-event-disclosure-content';
      appendEventGroups(content, sectionData.groups);
      section.append(heading, content);
      return section;
    }

    const details = document.createElement('details');
    details.className = 'shared-event-disclosure';
    details.open = true;
    const summary = document.createElement('summary');
    const title = document.createElement('span');
    title.className = 'shared-event-disclosure-title';
    title.textContent = sectionData.title;
    const previewText = document.createElement('span');
    previewText.className = 'shared-event-disclosure-preview';
    previewText.textContent = sectionData.preview;
    const chevron = document.createElement('span');
    chevron.className = 'shared-event-disclosure-chevron';
    chevron.setAttribute('aria-hidden', 'true');
    chevron.textContent = '⌄';
    summary.append(title, previewText, chevron);
    const content = document.createElement('div');
    content.className = 'shared-event-disclosure-content';
    appendEventGroups(content, sectionData.groups);
    details.append(summary, content);
    return details;
  }

  function appendEventGroups(container, groups) {
    groups.forEach((group) => {
      const block = document.createElement('div');
      block.className = 'shared-event-detail-group';
      const label = document.createElement('p');
      label.className = 'shared-event-field-label';
      label.textContent = group.label;
      block.append(label);

      if (group.kind === 'tags') {
        const tags = document.createElement('div');
        tags.className = 'shared-event-tag-list';
        group.values.forEach((value) => {
          const tag = document.createElement('span');
          tag.className = 'shared-event-tag';
          tag.textContent = value;
          tags.append(tag);
        });
        block.append(tags);
      } else if (group.kind === 'checks') {
        const list = document.createElement('ul');
        list.className = 'shared-event-check-list';
        group.values.forEach((value) => {
          const item = document.createElement('li');
          const check = document.createElement('span');
          check.setAttribute('aria-hidden', 'true');
          check.textContent = '✓';
          item.append(check, document.createTextNode(value));
          list.append(item);
        });
        block.append(list);
      } else {
        group.values.forEach((value) => {
          const paragraph = document.createElement('p');
          paragraph.className = 'shared-event-detail-value';
          paragraph.textContent = value;
          block.append(paragraph);
        });
      }

      container.append(block);
    });
  }

  function renderEventActions(actions) {
    if (!actions?.length) return null;
    const section = document.createElement('section');
    section.className = 'shared-event-actions';
    const heading = document.createElement('h3');
    heading.textContent = copy.event.eventActions;
    section.append(heading);
    actions.forEach((action) => {
      const link = document.createElement('a');
      link.className = 'shared-event-action-row';
      link.href = action.url;
      link.rel = action.external ? 'noopener noreferrer' : '';
      link.target = action.external ? '_blank' : '';
      const icon = document.createElement('span');
      icon.className = 'shared-event-action-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = eventActionIcon(action.type);
      const label = document.createElement('span');
      label.textContent = action.title;
      link.append(icon, label);
      if (action.external) {
        const external = document.createElement('span');
        external.className = 'shared-event-action-external';
        external.setAttribute('aria-hidden', 'true');
        external.textContent = '↗';
        link.append(external);
      }
      section.append(link);
    });
    return section;
  }

  function eventActionIcon(type) {
    return {
      register: '→',
      join: '▶',
      learnMore: 'i',
      viewAgenda: '≡',
      watchRecording: '▶',
      downloadMaterials: '↓',
      contactOrganizer: '@',
    }[type] ?? '→';
  }

  function renderPreviewSections(data) {
    renderPillsSection(
      '[data-preview-categories-section]',
      '[data-preview-categories-title]',
      '[data-preview-categories]',
      copy.categories,
      data.categories
    );
    renderPillsSection(
      '[data-preview-countries-section]',
      '[data-preview-countries-title]',
      '[data-preview-countries]',
      copy.countries,
      data.countries
    );
    renderReports(data.reports);
    renderSocials(data.socials);

    const sections = preview.querySelector('[data-preview-sections]');
    if (sections) {
      sections.hidden =
        !data.categories.length &&
        !data.countries.length &&
        !data.reports.length &&
        !data.socials.length;
    }
  }

  function renderPillsSection(sectionSelector, titleSelector, listSelector, titleText, items) {
    const section = preview.querySelector(sectionSelector);
    const titleNode = preview.querySelector(titleSelector);
    const list = preview.querySelector(listSelector);
    if (!section || !titleNode || !list) return;

    section.hidden = items.length === 0;
    titleNode.textContent = titleText;
    list.replaceChildren(
      ...items.map((item) => {
        const element = document.createElement('span');
        element.className = 'shared-preview-badge shared-preview-data-pill';
        if (typeof item === 'object' && item.flag) {
          const flag = document.createElement('span');
          flag.setAttribute('aria-hidden', 'true');
          flag.textContent = item.flag;
          element.append(flag, document.createTextNode(item.label));
        } else {
          element.textContent = typeof item === 'object' ? item.label : item;
        }
        return element;
      })
    );
  }

  function renderReports(reports) {
    const section = preview.querySelector('[data-preview-reports-section]');
    const titleNode = preview.querySelector('[data-preview-reports-title]');
    const list = preview.querySelector('[data-preview-reports]');
    if (!section || !titleNode || !list) return;

    section.hidden = reports.length === 0;
    titleNode.textContent = copy.geneticReports;
    list.replaceChildren(
      ...reports.map((report) => {
        const item = document.createElement('li');
        item.textContent = report;
        return item;
      })
    );
  }

  function renderSocials(socials) {
    const section = preview.querySelector('[data-preview-socials-section]');
    const titleNode = preview.querySelector('[data-preview-socials-title]');
    const list = preview.querySelector('[data-preview-socials]');
    if (!section || !titleNode || !list) return;

    section.hidden = socials.length === 0;
    titleNode.textContent = copy.socialLinks;
    list.replaceChildren(
      ...socials.map((social) => {
        const link = document.createElement('a');
        const image = document.createElement('img');
        link.className = 'shared-preview-social-link';
        link.href = social.href;
        link.target = social.href.startsWith('mailto:') ? '' : '_blank';
        link.rel = social.href.startsWith('mailto:') ? '' : 'noopener noreferrer';
        link.ariaLabel = social.label;
        link.title = social.label;
        image.src = `/discover/social-network-assets/${social.assetName}.png`;
        image.alt = '';
        image.loading = 'lazy';
        link.append(image);
        return link;
      })
    );
  }

  function renderWebsite(url, label) {
    const link = preview.querySelector('[data-preview-website]');
    if (!link) return;
    link.hidden = !url;
    if (url) {
      link.setAttribute('href', url);
      link.textContent = label || copy.website;
    } else {
      link.removeAttribute('href');
    }
  }
</script>

