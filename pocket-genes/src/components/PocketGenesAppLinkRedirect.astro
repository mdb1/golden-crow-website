---
import PocketGenesPublicLayout from '../layouts/PocketGenesPublicLayout.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/pocketGenesPublic';
import {
  getWizardCategoryOptions,
  getWizardGeneticReportCategoryOptions,
  getWizardSocialOptions,
} from '../data/discoverPublisherWizard';

interface Props {
  area: 'discover' | 'learn' | 'community';
  resource: 'feed_entries' | 'organizations' | 'lesson' | 'posts';
}

const { area, resource } = Astro.props;
const customSchemeBase = `pocketgenes://${area}/${resource}`;
const isEnglishPage = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const pageLang = isEnglishPage ? 'en' : 'es';
const canonicalSocialFieldKey = (value: string) =>
  ({
    stack_overflow: 'stackOverflow',
    hugging_face: 'huggingFace',
    researchgate: 'researchGate',
    google_scholar: 'googleScholar',
    web_of_science: 'webOfScience',
    protocols_io: 'protocolsIo',
  })[value] ?? value;
const organizationCategoryOptions = getWizardCategoryOptions('organization', pageLang);
const geneticReportCategoryOptions = getWizardGeneticReportCategoryOptions(pageLang);
const socialPreviewOptions = getWizardSocialOptions(pageLang).map((option) => ({
  key: canonicalSocialFieldKey(option.value),
  label: option.label,
  assetName: option.assetName,
}));
const initialCopy = isEnglishPage
  ? {
      layoutTitle: 'Open in Pocket Genes',
      layoutDescription: 'Open shared content in Pocket Genes or download the app.',
      title: 'Someone sent this link using Pocket Genes.',
      description: 'Install the app to view the complete item on your phone.',
      storeGridLabel: 'Pocket Genes download options',
      availableNow: 'Available now',
      appStoreAlt: 'Download on the App Store',
      appStoreNote: 'For iPhone',
      googlePlayAlt: 'Get it on Google Play',
      playStoreNote: 'For Android',
      retryPrefix: 'If the app is already installed, tap ',
      retryLink: 'here',
      retrySuffix: ' to open it.',
      website: 'Website',
    }
  : {
      layoutTitle: 'Abrir en Pocket Genes',
      layoutDescription: 'Abrí el contenido compartido en Pocket Genes o descargá la app.',
      title: 'Alguien te compartió este link desde Pocket Genes.',
      description: 'Descargá Pocket Genes para verlo completo en tu teléfono.',
      storeGridLabel: 'Dónde descargar Pocket Genes',
      availableNow: 'Disponible ahora',
      appStoreAlt: 'Descargar Pocket Genes en App Store',
      appStoreNote: 'Para iPhone',
      googlePlayAlt: 'Descargar Pocket Genes en Google Play',
      playStoreNote: 'Para Android',
      retryPrefix: 'Si ya tenés la app instalada, tocá ',
      retryLink: 'acá',
      retrySuffix: ' para abrirla.',
      website: 'Sitio web',
    };
---

<PocketGenesPublicLayout
  title={initialCopy.layoutTitle}
  description={initialCopy.layoutDescription}
  canonicalPath={Astro.url.pathname}
  showFooter={false}
  image="/pocket-genes/banner.png"
>
  <main id="main" class="app-link-page">
    <section class="app-link-content" aria-labelledby="app-link-title">
      <img class="app-icon" src="/pocket-genes/icon_simple.png" alt="" width="112" height="112" />
      <p class="app-kicker">Pocket Genes</p>
      <h1 id="app-link-title">{initialCopy.title}</h1>
      <p id="app-link-description" class="app-description">
        {initialCopy.description}
      </p>

      <div class="app-link-actions">
        <div id="download-store-grid" class="app-link-store-grid" aria-label={initialCopy.storeGridLabel}>
          <a id="download-app-store" class="store-card store-card-live" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="store-card-glow" aria-hidden="true"></span>
            <span class="store-kicker" data-store-kicker>{initialCopy.availableNow}</span>
            <img class="store-badge app-store-badge" src="/pocket-genes/app-store-badge.svg" alt={initialCopy.appStoreAlt} width="180" height="60" />
            <span class="store-note" data-store-note>{initialCopy.appStoreNote}</span>
          </a>

          <a id="download-play-store" class="store-card store-card-live store-card-play" href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="store-card-glow" aria-hidden="true"></span>
            <span class="store-kicker" data-store-kicker>{initialCopy.availableNow}</span>
            <span class="play-badge-wrap">
              <img class="store-badge google-play-badge" src="/pocket-genes/google-play-badge.png" alt={initialCopy.googlePlayAlt} width="194" height="75" />
            </span>
            <span class="store-note" data-store-note>{initialCopy.playStoreNote}</span>
          </a>
        </div>
      </div>

      <p id="app-link-status" class="app-link-status" role="status">
        <span data-status-prefix>{initialCopy.retryPrefix}</span>
        <a id="open-pocket-genes" class="app-link-retry" href={customSchemeBase}>{initialCopy.retryLink}</a>
        <span data-status-suffix>{initialCopy.retrySuffix}</span>
      </p>

      <article
        id="shared-preview"
        class="shared-preview"
        hidden
        aria-label={isEnglishPage ? 'Shared content preview' : 'Vista previa del contenido compartido'}
      >
        <div class="shared-preview-banner" data-preview-banner-shell hidden>
          <img data-preview-banner alt="" hidden />
        </div>
        <div class="shared-preview-topline">
          <div class="shared-preview-avatar" data-preview-avatar>
            <span data-preview-fallback>DNA</span>
            <img data-preview-image alt="" hidden />
          </div>
          <div class="shared-preview-heading">
            <p class="shared-preview-publisher" data-preview-publisher></p>
            <h2 data-preview-title></h2>
            <div class="shared-preview-badges" data-preview-badges></div>
          </div>
        </div>
        <p class="shared-preview-summary" data-preview-summary hidden></p>
        <p class="shared-preview-body" data-preview-body hidden></p>
        <img class="shared-preview-media" data-preview-media alt="" hidden />
        <section class="shared-preview-event" data-preview-event hidden></section>
        <div class="shared-preview-sections" data-preview-sections hidden>
          <section class="shared-preview-section" data-preview-categories-section hidden>
            <h3 data-preview-categories-title></h3>
            <div class="shared-preview-pill-row" data-preview-categories></div>
          </section>
          <section class="shared-preview-section" data-preview-countries-section hidden>
            <h3 data-preview-countries-title></h3>
            <div class="shared-preview-pill-row" data-preview-countries></div>
          </section>
          <section class="shared-preview-section shared-preview-report-section" data-preview-reports-section hidden>
            <h3 data-preview-reports-title></h3>
            <ul data-preview-reports></ul>
          </section>
          <section class="shared-preview-section" data-preview-socials-section hidden>
            <h3 data-preview-socials-title></h3>
            <div class="shared-preview-socials" data-preview-socials></div>
          </section>
        </div>
        <div class="shared-preview-meta" data-preview-meta hidden></div>
        <a class="shared-preview-website" data-preview-website href="#" target="_blank" rel="noopener noreferrer" hidden>
          {initialCopy.website}
        </a>
      </article>
    </section>
  </main>
</PocketGenesPublicLayout>

