---
import PocketGenesPublicLayout from '../layouts/PocketGenesPublicLayout.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/pocketGenesPublic';

interface Props {
  area: 'discover' | 'learn' | 'community';
  resource: 'feed_entries' | 'organizations' | 'lesson' | 'posts';
}

const { area, resource } = Astro.props;
const customSchemeBase = `pocketgenes://${area}/${resource}`;
---

<PocketGenesPublicLayout
  title="Abrir en Pocket Genes"
  description="Abrí el contenido compartido en Pocket Genes o descargá la app."
  canonicalPath={Astro.url.pathname}
  showFooter={false}
  image="/pocket-genes/banner.png"
>
  <main id="main" class="app-link-page">
    <section class="app-link-content" aria-labelledby="app-link-title">
      <img class="app-icon" src="/pocket-genes/icon.png" alt="" width="112" height="112" />
      <p class="app-kicker">Pocket Genes</p>
      <h1 id="app-link-title">Abrir contenido compartido</h1>
      <p id="app-link-description" class="app-description">
        Abrí este contenido en Pocket Genes para verlo completo.
      </p>

      <div class="app-link-actions">
        <div id="download-store-grid" class="app-link-store-grid" aria-label="Dónde descargar Pocket Genes">
          <a id="download-app-store" class="store-card store-card-live" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="store-card-glow" aria-hidden="true"></span>
            <span class="store-kicker" data-store-kicker>Disponible ahora</span>
            <img class="store-badge app-store-badge" src="/pocket-genes/app-store-badge.svg" alt="Descargar Pocket Genes en App Store" width="180" height="60" />
            <span class="store-note" data-store-note>Para iPhone</span>
          </a>

          <a id="download-play-store" class="store-card store-card-live store-card-play" href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="store-card-glow" aria-hidden="true"></span>
            <span class="store-kicker" data-store-kicker>Disponible ahora</span>
            <span class="play-badge-wrap">
              <img class="store-badge google-play-badge" src="/pocket-genes/google-play-badge.png" alt="Descargar Pocket Genes en Google Play" width="194" height="75" />
            </span>
            <span class="store-note" data-store-note>Para Android</span>
          </a>
        </div>
      </div>

      <p id="app-link-status" class="app-link-status" role="status">
        <span data-status-prefix>Si ya tenés la app, intentamos abrirla automáticamente. Tocá </span>
        <a id="open-pocket-genes" class="app-link-retry" href={customSchemeBase}>acá</a>
        <span data-status-suffix> para volver a intentarlo.</span>
      </p>

      <article id="shared-preview" class="shared-preview" hidden aria-label="Vista previa del contenido compartido">
        <div class="shared-preview-topline">
          <div class="shared-preview-avatar" data-preview-avatar>
            <span data-preview-fallback>DNA</span>
            <img data-preview-image alt="" hidden />
          </div>
          <div class="shared-preview-heading">
            <p class="shared-preview-publisher" data-preview-publisher></p>
            <h2 data-preview-title></h2>
            <div class="shared-preview-badges" data-preview-badges></div>
          </div>
        </div>
        <p class="shared-preview-summary" data-preview-summary hidden></p>
        <p class="shared-preview-body" data-preview-body hidden></p>
        <img class="shared-preview-media" data-preview-media alt="" hidden />
        <div class="shared-preview-meta" data-preview-meta hidden></div>
        <a class="shared-preview-website" data-preview-website href="#" target="_blank" rel="noopener noreferrer" hidden>
          Sitio web
        </a>
      </article>
    </section>
  </main>
</PocketGenesPublicLayout>

<script define:vars={{ area, resource, customSchemeBase, APP_STORE_URL, PLAY_STORE_URL }}>
  const FIRESTORE_PROJECT_ID = 'goldencrow-pocketgenes';
  const FIRESTORE_API_KEY = 'AIzaSyCTiL_RwICvnngYEqE721_MwVmDqGyYZ64';

  const params = new URLSearchParams(window.location.search);
  const contentId = params.get('id')?.trim();
  const openLink = document.querySelector('#open-pocket-genes');
  const title = document.querySelector('#app-link-title');
  const description = document.querySelector('#app-link-description');
  const status = document.querySelector('#app-link-status');
  const statusPrefix = status?.querySelector('[data-status-prefix]');
  const statusSuffix = status?.querySelector('[data-status-suffix]');
  const appStoreLink = document.querySelector('#download-app-store');
  const playStoreLink = document.querySelector('#download-play-store');
  const storeGrid = document.querySelector('#download-store-grid');
  const preview = document.querySelector('#shared-preview');
  const isEnglish = navigator.language.toLowerCase().startsWith('en');

  const copy = isEnglish
    ? {
        titleOptions: [
          'Someone sent this link using Pocket Genes.',
          'Check out this link someone sent from Pocket Genes.',
          'Here is a cool share from the Pocket Genes app.',
          'Take a look at this link via Pocket Genes.',
          'Here is an item shared from the Pocket Genes app.',
        ],
        description: 'Install the app to view the complete item on your phone.',
        retryPrefix: 'If the app is already installed, tap ',
        retryLink: 'here',
        retrySuffix: ' to open it.',
        storeGridLabel: 'Pocket Genes download options',
        availableNow: 'Available now',
        appStoreAlt: 'Download on the App Store',
        appStoreNote: 'For iPhone',
        playStoreKicker: 'Available now',
        googlePlayAlt: 'Get it on Google Play',
        playStoreNote: 'For Android',
        missing: 'This shared link is incomplete. Ask the sender to share it again.',
        openingPrefix: 'Opening the app automatically. If nothing happens, tap ',
        openingSuffix: ' to try again.',
        organizationPreview: 'Organization preview',
        feedPreview: 'Post preview',
        verified: 'Verified',
        website: 'Website',
        types: {
          company: 'Company',
          foundation: 'Foundation',
          hospital: 'Hospital',
          university: 'University',
          laboratory: 'Laboratory',
          research_institute: 'Research institute',
          patient_advocacy_group: 'Advocacy group',
          public_health_agency: 'Public health',
          conference_organizer: 'Events',
          other: 'Organization',
          news: 'News',
          research_update: 'Research',
          upcoming_event: 'Event',
          opportunity: 'Opportunity',
        },
      }
    : {
        titleOptions: [
          'Alguien te compartió este link desde Pocket Genes.',
          'Mirá este link que te enviaron desde Pocket Genes.',
          'Te compartieron algo interesante desde Pocket Genes.',
          'Dale una mirada a este link de Pocket Genes.',
          'Este contenido viene compartido desde Pocket Genes.',
        ],
        description: 'Descargá Pocket Genes para verlo completo en tu teléfono.',
        retryPrefix: 'Si ya tenés la app instalada, tocá ',
        retryLink: 'acá',
        retrySuffix: ' para abrirla.',
        storeGridLabel: 'Dónde descargar Pocket Genes',
        availableNow: 'Disponible ahora',
        appStoreAlt: 'Descargar Pocket Genes en App Store',
        appStoreNote: 'Para iPhone',
        playStoreKicker: 'Disponible ahora',
        googlePlayAlt: 'Descargar Pocket Genes en Google Play',
        playStoreNote: 'Para Android',
        missing: 'Este enlace compartido está incompleto. Pedile a quien lo envió que vuelva a compartirlo.',
        openingPrefix: 'Intentando abrir la app automáticamente. Si no pasa nada, tocá ',
        openingSuffix: ' para volver a intentarlo.',
        organizationPreview: 'Vista previa de organización',
        feedPreview: 'Vista previa del post',
        verified: 'Verificada',
        website: 'Sitio web',
        types: {
          company: 'Empresa',
          foundation: 'Fundación',
          hospital: 'Hospital',
          university: 'Universidad',
          laboratory: 'Laboratorio',
          research_institute: 'Instituto de investigación',
          patient_advocacy_group: 'Grupo de pacientes',
          public_health_agency: 'Salud pública',
          conference_organizer: 'Eventos',
          other: 'Organización',
          news: 'Noticias',
          research_update: 'Investigación',
          upcoming_event: 'Evento',
          opportunity: 'Oportunidad',
        },
      };

  title.textContent = randomTitle(copy.titleOptions);
  description.textContent = copy.description;
  setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
  storeGrid?.setAttribute('aria-label', copy.storeGridLabel);
  updateStoreCard(appStoreLink, {
    ariaLabel: copy.appStoreAlt,
    kicker: copy.availableNow,
    imageAlt: copy.appStoreAlt,
    note: copy.appStoreNote,
  });
  updateStoreCard(playStoreLink, {
    ariaLabel: copy.googlePlayAlt,
    kicker: copy.playStoreKicker,
    imageAlt: copy.googlePlayAlt,
    note: copy.playStoreNote,
  });

  if (!contentId) {
    openLink.setAttribute('aria-disabled', 'true');
    openLink.removeAttribute('href');
    setStatusMessage(copy.missing);
  } else {
    const query = `?id=${encodeURIComponent(contentId)}`;
    const customURL = `${customSchemeBase}${query}`;
    const androidIntent = `intent://${area}/${resource}${query}#Intent;scheme=pocketgenes;package=goldencrowvs.pocketgenes;S.browser_fallback_url=${encodeURIComponent(PLAY_STORE_URL)};end`;
    const isAndroid = /Android/i.test(navigator.userAgent);
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    const appURL = isAndroid ? androidIntent : customURL;

    openLink.setAttribute('href', appURL);

    if (isMobile) {
      setStatusRetry(copy.openingPrefix, copy.retryLink, copy.openingSuffix);
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') {
          window.location.assign(appURL);
        }
      }, 150);
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') {
          setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
        }
      }, 1600);
    } else {
      setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
    }

    loadSharedPreview(contentId);
  }

  function setStatusMessage(message) {
    if (statusPrefix) statusPrefix.textContent = message;
    if (statusSuffix) statusSuffix.textContent = '';
    if (openLink) {
      openLink.textContent = '';
      openLink.hidden = true;
    }
  }

  function randomTitle(options) {
    return options[Math.floor(Math.random() * options.length)] ?? options[0];
  }

  function setStatusRetry(prefix, linkText, suffix) {
    if (statusPrefix) statusPrefix.textContent = prefix;
    if (statusSuffix) statusSuffix.textContent = suffix;
    if (openLink) {
      openLink.textContent = linkText;
      openLink.hidden = false;
    }
  }

  function loadSharedPreview(id) {
    if (!preview || area !== 'discover' || !['feed_entries', 'organizations'].includes(resource)) {
      return;
    }

    const collection = resource === 'organizations' ? 'feed_organizations' : 'feed_items';
    const encodedId = encodeURIComponent(id);
    const url = `https://firestore.googleapis.com/v1/projects/${FIRESTORE_PROJECT_ID}/databases/(default)/documents/${collection}/${encodedId}?key=${FIRESTORE_API_KEY}`;

    fetch(url)
      .then((response) => {
        if (!response.ok) {
          throw new Error('Preview unavailable');
        }
        return response.json();
      })
      .then((document) => {
        const fields = parseFirestoreFields(document.fields ?? {});
        const previewData =
          resource === 'organizations'
            ? organizationPreviewData(fields)
            : feedEntryPreviewData(fields);

        if (!previewData) {
          return;
        }

        renderPreview(previewData);
      })
      .catch(() => {
        preview.hidden = true;
      });
  }

  function updateStoreCard(card, labels) {
    if (!card) return;
    card.setAttribute('aria-label', labels.ariaLabel);
    const kicker = card.querySelector('[data-store-kicker]');
    const note = card.querySelector('[data-store-note]');
    const badge = card.querySelector('.store-badge');
    if (kicker) kicker.textContent = labels.kicker;
    if (note) note.textContent = labels.note;
    if (badge) badge.setAttribute('alt', labels.imageAlt);
  }

  function parseFirestoreFields(fields) {
    return Object.fromEntries(
      Object.entries(fields).map(([key, value]) => [key, parseFirestoreValue(value)])
    );
  }

  function parseFirestoreValue(value) {
    if (!value || typeof value !== 'object') {
      return null;
    }
    if ('stringValue' in value) return value.stringValue;
    if ('booleanValue' in value) return Boolean(value.booleanValue);
    if ('integerValue' in value) return Number(value.integerValue);
    if ('doubleValue' in value) return Number(value.doubleValue);
    if ('timestampValue' in value) return value.timestampValue;
    if ('nullValue' in value) return null;
    if ('arrayValue' in value) {
      return (value.arrayValue.values ?? []).map(parseFirestoreValue);
    }
    if ('mapValue' in value) {
      return parseFirestoreFields(value.mapValue.fields ?? {});
    }
    return null;
  }

  function cleanText(value) {
    return typeof value === 'string' && value.trim() ? value.trim() : '';
  }

  function validUrl(value) {
    const text = cleanText(value);
    if (!text) return '';

    try {
      const url = new URL(text);
      return url.protocol === 'https:' ? url.toString() : '';
    } catch {
      return '';
    }
  }

  function typeLabel(type) {
    return copy.types[type] ?? humanize(type);
  }

  function humanize(value) {
    return cleanText(value)
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function formatDate(value) {
    const text = cleanText(value);
    if (!text) return '';

    const date = new Date(text);
    if (Number.isNaN(date.getTime())) {
      return '';
    }

    return new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(date);
  }

  function organizationPreviewData(fields) {
    if (cleanText(fields.status) !== 'active') {
      return null;
    }

    const name = cleanText(fields.name);
    const body = cleanText(fields.description);
    if (!name || !body) {
      return null;
    }

    return {
      kind: 'organization',
      eyebrow: copy.organizationPreview,
      publisher: '',
      title: name,
      summary: '',
      body,
      imageUrl: validUrl(fields.imageUrl),
      mediaUrl: '',
      websiteUrl: validUrl(fields.websiteUrl),
      badges: [
        fields.verified === true ? copy.verified : '',
        typeLabel(cleanText(fields.organizationType) || 'other'),
        cleanText(fields.countryCode),
      ].filter(Boolean),
      meta: [],
      accent: readColor(fields.color_hex) || readColor(fields.colorHex),
    };
  }

  function feedEntryPreviewData(fields) {
    if (cleanText(fields.status) !== 'published') {
      return null;
    }

    const type = cleanText(fields.type) || 'news';
    const payload = fields[type] && typeof fields[type] === 'object' ? fields[type] : {};
    const title = cleanText(fields.title) || cleanText(payload.title);
    const summary = cleanText(fields.subtitle) || cleanText(fields.summary) || cleanText(payload.summary);
    const body = cleanText(fields.body) || cleanText(payload.detailBody);

    if (!title || (!summary && !body)) {
      return null;
    }

    const eventDate = formatDate(payload.date || payload.startsAt);
    const meta = [
      eventDate,
      cleanText(payload.location),
      Array.isArray(payload.genes) ? payload.genes.slice(0, 3).join(', ') : '',
      Array.isArray(payload.conditions) ? payload.conditions.slice(0, 2).join(', ') : '',
      cleanText(payload.journal),
      cleanText(payload.opportunity_type || payload.opportunityType),
    ].filter(Boolean);

    return {
      kind: 'feed',
      eyebrow: copy.feedPreview,
      publisher: cleanText(fields.publisherSnapshot?.name) || 'Pocket Genes',
      title,
      summary,
      body,
      imageUrl: validUrl(fields.publisherSnapshot?.imageUrl) || '/pocket-genes/icon.png',
      mediaUrl: validUrl(fields.image_url) || validUrl(fields.imageUrl) || validUrl(payload.imageUrl),
      websiteUrl: validUrl(fields.source_url) || validUrl(fields.sourceUrl),
      badges: [typeLabel(type)],
      meta,
      accent: '',
    };
  }

  function readColor(value) {
    const color = cleanText(value);
    return /^#[0-9a-fA-F]{6}$/.test(color) ? color : '';
  }

  function renderPreview(data) {
    preview.dataset.kind = data.kind;
    if (data.accent) {
      preview.style.setProperty('--shared-preview-accent', data.accent);
    }

    setText('[data-preview-publisher]', data.publisher || data.eyebrow);
    setText('[data-preview-title]', data.title);
    setOptionalText('[data-preview-summary]', data.summary);
    setOptionalText('[data-preview-body]', data.body);
    renderImage('[data-preview-image]', data.imageUrl);
    renderImage('[data-preview-media]', data.mediaUrl);
    renderBadges(data.badges);
    renderMeta(data.meta);
    renderWebsite(data.websiteUrl);

    const fallback = preview.querySelector('[data-preview-fallback]');
    if (fallback) {
      fallback.textContent = data.kind === 'organization' ? 'DNA' : 'PG';
      fallback.hidden = Boolean(data.imageUrl);
    }

    preview.hidden = false;
  }

  function setText(selector, value) {
    const node = preview.querySelector(selector);
    if (node) {
      node.textContent = value;
    }
  }

  function setOptionalText(selector, value) {
    const node = preview.querySelector(selector);
    if (!node) return;
    const text = cleanText(value);
    node.textContent = text;
    node.hidden = !text;
  }

  function renderImage(selector, src) {
    const image = preview.querySelector(selector);
    if (!image) return;
    const url = validUrl(src) || (typeof src === 'string' && src.startsWith('/') ? src : '');
    image.hidden = !url;
    if (url) {
      image.setAttribute('src', url);
    } else {
      image.removeAttribute('src');
    }
  }

  function renderBadges(badges) {
    const container = preview.querySelector('[data-preview-badges]');
    if (!container) return;
    container.replaceChildren(
      ...badges.map((badge) => {
        const element = document.createElement('span');
        element.className = 'shared-preview-badge';
        element.textContent = badge;
        return element;
      })
    );
  }

  function renderMeta(meta) {
    const container = preview.querySelector('[data-preview-meta]');
    if (!container) return;
    container.hidden = meta.length === 0;
    container.replaceChildren(
      ...meta.map((item) => {
        const element = document.createElement('span');
        element.textContent = item;
        return element;
      })
    );
  }

  function renderWebsite(url) {
    const link = preview.querySelector('[data-preview-website]');
    if (!link) return;
    link.hidden = !url;
    if (url) {
      link.setAttribute('href', url);
      link.textContent = copy.website;
    } else {
      link.removeAttribute('href');
    }
  }
</script>

<style>
  .app-link-page {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 8.5rem 1rem 3rem;
    background:
      radial-gradient(circle at 15% 18%, rgba(228, 80, 128, 0.13), transparent 28rem),
      radial-gradient(circle at 86% 78%, rgba(20, 149, 143, 0.12), transparent 24rem),
      linear-gradient(135deg, rgba(33, 118, 174, 0.08), transparent 45%),
      #f8fbfd;
  }

  .app-link-content {
    width: min(100%, 560px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .app-icon {
    width: 96px;
    height: 96px;
    border-radius: 8px;
    box-shadow: 0 18px 44px rgba(23, 32, 51, 0.18);
  }

  .app-kicker {
    margin: 1.25rem 0 0;
    color: var(--pg-teal);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 520px;
    margin: 0.35rem 0 0;
    font-size: clamp(1.7rem, 6vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .app-description {
    max-width: 440px;
    margin: 1rem 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.08rem;
  }

  .app-link-actions {
    width: 100%;
    display: grid;
    margin-top: 1.75rem;
  }

  .app-link-store-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
  }

  .store-card {
    position: relative;
    isolation: isolate;
    min-height: 158px;
    min-width: 0;
    overflow: hidden;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    border: 1px solid rgba(197, 210, 223, 0.95);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(246, 253, 252, 0.9)),
      #ffffff;
    padding: 14px 10px;
    color: var(--pg-ink);
    text-align: center;
    text-decoration: none;
    box-shadow: 0 20px 54px rgba(23, 32, 51, 0.1);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .store-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(110deg, transparent 0 34%, rgba(20, 149, 143, 0.13) 48%, transparent 64%);
    transform: translateX(-130%);
    transition: transform 520ms ease;
  }

  .store-card-play::before {
    background:
      linear-gradient(110deg, transparent 0 34%, rgba(228, 80, 128, 0.14) 48%, transparent 64%);
  }

  .store-card-live:hover,
  .store-card-live:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(20, 149, 143, 0.42);
    box-shadow: 0 26px 72px rgba(20, 149, 143, 0.18);
  }

  .store-card-live:hover::before,
  .store-card-live:focus-visible::before {
    transform: translateX(130%);
  }

  .store-card-play:hover,
  .store-card-play:focus-visible {
    border-color: rgba(228, 80, 128, 0.36);
    box-shadow: 0 26px 72px rgba(228, 80, 128, 0.15);
  }

  .store-card-glow {
    position: absolute;
    inset: auto -18% -48% 12%;
    z-index: -1;
    height: 118px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(20, 149, 143, 0.24), transparent 70%);
    filter: blur(18px);
  }

  .store-card-play .store-card-glow {
    background: radial-gradient(circle, rgba(228, 80, 128, 0.22), transparent 70%);
  }

  .store-kicker,
  .store-note {
    margin: 0;
    letter-spacing: 0;
  }

  .store-kicker {
    color: #14958f;
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .store-card-play .store-kicker {
    color: #e45080;
  }

  .store-badge {
    display: block;
    width: min(100%, 140px);
    height: auto;
    filter: drop-shadow(0 12px 22px rgba(23, 32, 51, 0.12));
  }

  .google-play-badge {
    width: min(100%, 150px);
    margin: -8px 0;
  }

  .play-badge-wrap {
    display: grid;
    place-items: center;
    width: 100%;
  }

  .store-note {
    color: var(--pg-muted);
    font-size: 0.82rem;
    font-weight: 760;
    line-height: 1.15;
  }

  .app-link-status {
    min-height: 3rem;
    margin: 1.25rem 0 0;
    color: var(--pg-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .app-link-retry {
    color: var(--pg-blue);
    font-weight: 900;
