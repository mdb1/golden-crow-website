            en: 'Inglés',
            'pt-BR': 'Portugués (Brasil)',
            pt: 'Portugués',
            fr: 'Francés',
            de: 'Alemán',
            it: 'Italiano',
            ca: 'Catalán',
          },
          accessibilityValues: {
            captions: 'Subtítulos',
            liveTranscript: 'Transcripción en vivo',
            signLanguage: 'Lengua de señas',
            wheelchairAccessible: 'Accesible para silla de ruedas',
            recordingAvailable: 'Grabación disponible',
            quietRoom: 'Sala tranquila',
            translatedMaterials: 'Materiales traducidos',
          },
          relationships: {
            organizer: 'Organizador',
            coOrganizer: 'Coorganizador',
            speaker: 'Disertante',
            sponsor: 'Auspicia',
            partner: 'Aliado del evento',
            participant: 'Participante',
            attendee: 'Asistente',
            mentioning: 'Difunde el evento',
            unknown: 'No especificado',
          },
          actions: {
            register: 'Registrarse',
            join: 'Entrar al evento',
            learnMore: 'Ver más',
            viewAgenda: 'Ver agenda',
            watchRecording: 'Ver grabación',
            downloadMaterials: 'Descargar materiales',
            contactOrganizer: 'Contactar organizador',
          },
        },
      };

  const organizationCategoryLabelByKey = new Map(
    organizationCategoryOptions.map((option) => [option.value, option.label])
  );
  const geneticReportCategoryLabelByKey = new Map(
    geneticReportCategoryOptions.map((option) => [option.value, option.label])
  );
  const discoverFeedPayloadKeys = {
    news: 'news',
    research_update: 'researchUpdate',
    upcoming_event: 'upcomingEvent',
    opportunity: 'opportunity',
    video: 'video',
    external_article: 'externalArticle',
    podcast_episode: 'podcastEpisode',
    survey: 'survey',
    organization_spotlight: 'organizationSpotlight',
    professional_spotlight: 'professionalSpotlight',
    community_invitation: 'communityInvitation',
    bioinformatics_tool: 'bioinformaticsTool',
    genomic_database: 'genomicDatabase',
    health_guidance: 'healthGuidance',
    educational_explainer: 'educationalExplainer',
    gene_spotlight: 'geneSpotlight',
    condition_spotlight: 'conditionSpotlight',
    genetic_test_guide: 'geneticTestGuide',
    report_explainer: 'reportExplainer',
    clinical_guideline: 'clinicalGuideline',
    clinical_trial: 'clinicalTrial',
    patient_registry: 'patientRegistry',
    research_participation: 'researchParticipation',
    screening_program: 'screeningProgram',
    support_service: 'supportService',
    course: 'course',
    downloadable_resource: 'downloadableResource',
    lived_experience_story: 'livedExperienceStory',
    expert_qa: 'expertQa',
    advocacy_campaign: 'advocacyCampaign',
  };

  title.textContent = randomTitle(copy.titleOptions);
  description.textContent = copy.description;
  setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
  storeGrid?.setAttribute('aria-label', copy.storeGridLabel);
  updateStoreCard(appStoreLink, {
    ariaLabel: copy.appStoreAlt,
    kicker: copy.availableNow,
    imageAlt: copy.appStoreAlt,
    note: copy.appStoreNote,
  });
  updateStoreCard(playStoreLink, {
    ariaLabel: copy.googlePlayAlt,
    kicker: copy.playStoreKicker,
    imageAlt: copy.googlePlayAlt,
    note: copy.playStoreNote,
  });
  if (!contentId) {
    disableOpenAppLink(openLink);
    setStatusMessage(copy.missing);
  } else {
    const query = `?id=${encodeURIComponent(contentId)}`;
    const customURL = `${customSchemeBase}${query}`;
    const androidIntent = `intent://${area}/${resource}${query}#Intent;scheme=pocketgenes;package=goldencrowvs.pocketgenes;S.browser_fallback_url=${encodeURIComponent(PLAY_STORE_URL)};end`;
    const isAndroid = /Android/i.test(navigator.userAgent);
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    const appURL = isAndroid ? androidIntent : customURL;

    enableOpenAppLink(openLink, appURL);

    if (isMobile) {
      setStatusRetry(copy.openingPrefix, copy.retryLink, copy.openingSuffix);
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') {
          window.location.assign(appURL);
        }
      }, 150);
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') {
          setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
        }
      }, 1600);
    } else {
      setStatusRetry(copy.retryPrefix, copy.retryLink, copy.retrySuffix);
    }

    loadSharedPreview(contentId);
  }

  function setStatusMessage(message) {
    if (statusPrefix) statusPrefix.textContent = message;
    if (statusSuffix) statusSuffix.textContent = '';
    if (openLink) {
      openLink.textContent = '';
      openLink.hidden = true;
    }
  }

  function randomTitle(options) {
    return options[Math.floor(Math.random() * options.length)] ?? options[0];
  }

  function setStatusRetry(prefix, linkText, suffix) {
    if (statusPrefix) statusPrefix.textContent = prefix;
    if (statusSuffix) statusSuffix.textContent = suffix;
    if (openLink) {
      openLink.textContent = linkText;
      openLink.hidden = false;
    }
  }

  function enableOpenAppLink(link, href) {
    if (!link) return;
    link.setAttribute('href', href);
    link.removeAttribute('aria-disabled');
  }

  function disableOpenAppLink(link) {
    if (!link) return;
    link.setAttribute('aria-disabled', 'true');
    link.removeAttribute('href');
  }

  async function loadSharedPreview(id) {
    if (!preview || area !== 'discover' || !['feed_entries', 'organizations'].includes(resource)) {
      return;
    }

    const collection = resource === 'organizations' ? 'feed_organizations' : 'feed_items';
    const encodedId = encodeURIComponent(id);
    const url = `https://firestore.googleapis.com/v1/projects/${FIRESTORE_PROJECT_ID}/databases/(default)/documents/${collection}/${encodedId}?key=${FIRESTORE_API_KEY}`;

    try {
      const response = await fetch(url);
      if (!response.ok) {
        throw new Error('Preview unavailable');
      }
      const document = await response.json();
      const fields = parseFirestoreFields(document.fields ?? {});
      const previewData =
        resource === 'organizations'
          ? organizationPreviewData(fields)
          : feedEntryPreviewData(fields);

      if (!previewData) {
        return;
      }

      if (resource === 'feed_entries' && previewData.event && !previewData.imageUrl) {
        previewData.imageUrl = await fetchPublisherImage(fields);
      }

      renderPreview(previewData);
    } catch {
      preview.hidden = true;
    }
  }

  async function fetchPublisherImage(fields) {
    const organizationId = cleanText(fields.publisherOrganizationId);
    const individualId = cleanText(fields.publisherIndividualId);
    const collection = organizationId ? 'feed_organizations' : individualId ? 'feed_individuals' : '';
    const publisherId = organizationId || individualId;
    if (!collection || !publisherId) {
      return '';
    }

    const encodedId = encodeURIComponent(publisherId);
    const url = `https://firestore.googleapis.com/v1/projects/${FIRESTORE_PROJECT_ID}/databases/(default)/documents/${collection}/${encodedId}?key=${FIRESTORE_API_KEY}`;
    try {
      const response = await fetch(url);
      if (!response.ok) {
        return '';
      }
      const document = await response.json();
      const publisherFields = parseFirestoreFields(document.fields ?? {});
      return imageSource(publisherFields.imageUrl) || imageSource(publisherFields.imageUploadDataUrl);
    } catch {
      return '';
    }
  }

  function updateStoreCard(card, labels) {
    if (!card) return;
    card.setAttribute('aria-label', labels.ariaLabel);
    const kicker = card.querySelector('[data-store-kicker]');
    const note = card.querySelector('[data-store-note]');
    const badge = card.querySelector('.store-badge');
    if (kicker) kicker.textContent = labels.kicker;
    if (note) note.textContent = labels.note;
    if (badge) badge.setAttribute('alt', labels.imageAlt);
  }

  function parseFirestoreFields(fields) {
    return Object.fromEntries(
      Object.entries(fields).map(([key, value]) => [key, parseFirestoreValue(value)])
    );
  }

  function parseFirestoreValue(value) {
    if (!value || typeof value !== 'object') {
      return null;
    }
    if ('stringValue' in value) return value.stringValue;
    if ('booleanValue' in value) return Boolean(value.booleanValue);
    if ('integerValue' in value) return Number(value.integerValue);
    if ('doubleValue' in value) return Number(value.doubleValue);
    if ('timestampValue' in value) return value.timestampValue;
    if ('nullValue' in value) return null;
    if ('arrayValue' in value) {
      return (value.arrayValue.values ?? []).map(parseFirestoreValue);
    }
    if ('mapValue' in value) {
      return parseFirestoreFields(value.mapValue.fields ?? {});
    }
    return null;
  }

  function cleanText(value) {
    return typeof value === 'string' && value.trim() ? value.trim() : '';
  }

  function contentBodyData(htmlValue, plainValue) {
    const html = sanitizeHtmlBody(htmlValue);
    if (html && htmlToText(html)) {
      return { kind: 'html', value: html };
    }

    const text = cleanText(plainValue);
    return text ? { kind: 'text', value: text } : null;
  }

  function bodyHasContent(body) {
    if (!body) return false;
    if (typeof body === 'string') return Boolean(cleanText(body));
    return Boolean(cleanText(body.value));
  }

  function sanitizeHtmlBody(value) {
    const normalized = cleanText(value);
    if (!normalized) return '';

    return normalized
      .replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, '')
      .replace(/<style[\s\S]*?>[\s\S]*?<\/style>/gi, '')
      .replace(
        /<\/?(iframe|object|embed|form|input|button|textarea|select|option|link|meta|base)[^>]*>/gi,
        ''
      )
      .replace(/\son[a-z]+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '')
      .replace(/\s(href|src)\s*=\s*(['"])\s*javascript:[\s\S]*?\2/gi, ' $1="#"')
      .trim();
  }

  function htmlToText(value) {
    const element = document.createElement('div');
    element.innerHTML = value;
    return element.textContent?.replace(/\s+/g, ' ').trim() ?? '';
  }

  function plainTextBodyHtml(value) {
    const paragraphs = cleanText(value)
      .split(/\n{2,}/)
      .map((paragraph) => paragraph.trim())
      .filter(Boolean);
    return paragraphs
      .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, '<br>')}</p>`)
      .join('');
  }

  function escapeHtml(value) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function externalUrl(value) {
    const text = cleanText(value);
    if (!text) return '';
    if (/^(mailto:|tel:)/i.test(text)) return text;

    try {
      const url = new URL(/^https?:\/\//i.test(text) ? text : `https://${text}`);
      return ['http:', 'https:'].includes(url.protocol) ? url.toString() : '';
    } catch {
      return '';
    }
  }

  function imageSource(value) {
    const text = cleanText(value);
    if (!text) return '';
    if (/^data:image\/(?:png|jpe?g|webp|gif|svg\+xml);base64,/i.test(text)) {
      return text;
    }
    if (text.startsWith('/')) {
      return text;
    }
    try {
      const url = new URL(text);
      if (url.hostname === 'goldencrowvs.com') {
        return `${url.pathname}${url.search}`;
      }
    } catch {
      // Fall through to the general external URL sanitizer.
    }
    return externalUrl(text);
  }

  function socialHref(key, value) {
    const text = cleanText(value);
    if (!text) return '';
    if (key === 'email' && !/^(mailto:|https?:\/\/)/i.test(text)) {
      return `mailto:${text}`;
    }
    return externalUrl(text);
  }

  function typeLabel(type) {
    return copy.types[type] ?? humanize(type);
  }

  function humanize(value) {
    return cleanText(value)
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function formatDate(value) {
    const text = cleanText(value);
    if (!text) return '';

    const date = new Date(text);
    if (Number.isNaN(date.getTime())) {
      return '';
    }

    return new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(date);
  }

  function organizationPreviewData(fields) {
    if (cleanText(fields.status) !== 'active') {
      return null;
    }

    const name = cleanText(fields.name);
    const body = localizedDescription(fields);
    if (!name || !body) {
      return null;
    }
    const categories = labelsForCsv(fields.organizationType, organizationCategoryLabelByKey);
    const countries = countriesForCsv(fields.countryCode);
    const reports =
      fields.isGeneticReportProvider === true
        ? labelsForCsv(fields.geneticReportCategory, geneticReportCategoryLabelByKey)
        : [];
    const socials = socialLinksForPreview(fields.social);
    const isHighlighted = fields.isGrcHighlighted === true;
    const websiteUrl = externalUrl(fields.websiteUrl);

    return {
      kind: 'organization',
      eyebrow: copy.organizationPreview,
      publisher: '',
      title: name,
      pageTitle: isEnglish ? `${name}\non Pocket Genes` : `${name}\nen Pocket Genes`,
      pageDescription: copy.organizationDescription,
      summary: '',
      body,
      imageUrl: imageSource(fields.imageUrl) || imageSource(fields.imageUploadDataUrl),
      bannerUrl: isHighlighted
        ? imageSource(fields.bannerImageUrl) || imageSource(fields.bannerImageUploadDataUrl)
        : '',
      mediaUrl: '',
      websiteUrl,
      websiteLabel: websiteUrl ? compactUrlLabel(websiteUrl) : copy.website,
      badges: [
        fields.verified === true ? copy.verified : '',
        fields.isGeneticReportProvider === true ? copy.geneticReportProvider : '',
        isHighlighted ? copy.highlighted : '',
      ].filter(Boolean),
      categories,
      countries,
      reports,
      socials,
      meta: [],
      accent: readColor(fields.colorHex),
    };
  }

  function feedEntryPreviewData(fields) {
    if (cleanText(fields.status) !== 'published') {
      return null;
    }

    const type = cleanText(fields.type) || 'news';
    const payloadKey = discoverFeedPayloadKeys[type] ?? type;
    const payload = fields[payloadKey] && typeof fields[payloadKey] === 'object' ? fields[payloadKey] : {};
    const isEventType = type === 'upcoming_event';
    const eventPreview = isEventType ? eventPreviewData(payload) : null;
    const title = cleanText(fields.title) || (!isEventType ? cleanText(payload.title) : '');
    const summary =
      cleanText(fields.subtitle) ||
      (!isEventType ? cleanText(fields.summary) || cleanText(payload.summary) : '');
    const body = contentBodyData(
      fields.htmlBody,
      cleanText(fields.body) || (!isEventType ? cleanText(payload.detailBody) : '')
    );

    if (!title || (isEventType ? !eventPreview : !summary && !bodyHasContent(body))) {
      return null;
    }

    const eventDate = eventPreview ? '' : formatDate(payload.date || payload.startsAt);
    const meta = [
      eventDate,
      eventPreview ? '' : cleanText(payload.location),
      Array.isArray(payload.genes) ? payload.genes.slice(0, 3).join(', ') : '',
      Array.isArray(payload.conditions) ? payload.conditions.slice(0, 2).join(', ') : '',
      cleanText(payload.journal),
      cleanText(payload.opportunityType),
    ].filter(Boolean);
    const publisherImage =
      imageSource(fields.publisherSnapshot?.imageUrl) ||
      imageSource(fields.publisherSnapshot?.imageUploadDataUrl);
    const sourceButtonText = cleanText(fields.sourceButtonText);

    return {
      kind: 'feed',
      eyebrow: copy.feedPreview,
      publisher: cleanText(fields.publisherSnapshot?.name) || 'Pocket Genes',
      publisherSupport: '',
      title,
      summary,
      body,
      imageUrl: publisherImage || (eventPreview ? '' : '/pocket-genes/icon_simple.png'),
      bannerUrl: '',
      mediaUrl:
        imageSource(fields.imageUrl) ||
        imageSource(fields.imageUploadDataUrl) ||
        (!eventPreview ? imageSource(payload.imageUrl) : ''),
      websiteUrl: externalUrl(fields.sourceUrl),
      websiteLabel: sourceButtonText || copy.website,
      badges: [typeLabel(type)],
      categories: [],
      countries: [],
      reports: [],
      socials: [],
      meta,
      event: eventPreview,
      accent: '',
    };
  }

  function eventPreviewData(payload) {
    if (!payload || typeof payload !== 'object') {
      return null;
    }

    const eventDateSource = payload.date;
    const startDate = datePartsFromValue(eventDateSource);
    if (!startDate) {
      return null;
    }

    const timeKind = cleanText(payload.timeKind);
    const duration = eventMultiDayLength(payload, timeKind);
    const endDate = addCalendarDays(startDate, duration - 1);
    const kind = enumLabel(payload.eventKind, copy.event.kinds);
    const status = eventStatusLabel(payload.eventStatus);
    const schedule = eventScheduleData(payload, startDate, endDate, duration, eventDateSource, timeKind);
    const participationFacts = eventParticipationFactData(payload);
    const organizer = eventOrganizerData(payload);
    const actions = eventActionData(payload.actionButtons, payload.virtualMeetingLink);

    return {
      eyebrow: eventEyebrow(kind),
      dateSpan: duration > 1 ? `${duration} ${copy.event.days}` : '',
      status,
      dateParts: startDate,
      schedule,
      participationFacts,
      organizer,
      actions,
    };
  }

  function positiveInteger(value) {
    const number = Number(value);
    return Number.isInteger(number) && number > 0 ? number : null;
  }

  function positiveIntegerInRange(value, min, max) {
    const number = Number(value);
    return Number.isInteger(number) && number >= min && number <= max ? number : null;
  }

  function hasOwn(object, key) {
    return Boolean(object && typeof object === 'object' && Object.prototype.hasOwnProperty.call(object, key));
  }

  function eventMultiDayLength(payload, timeKind) {
    if (!['allDay', 'timeTba', 'regionalTimes'].includes(timeKind)) {
      return 1;
    }
    return positiveIntegerInRange(payload.multiDayLength, 1, 365) || 1;
  }

  function uniqueCleanArray(value) {
    if (!Array.isArray(value)) return [];
    const seen = new Set();
    return value
      .map((entry) => cleanText(entry))
      .filter((entry) => {
        if (!entry || seen.has(entry)) return false;
        seen.add(entry);
        return true;
      });
  }

  function enumLabel(value, labels) {
    const key = cleanText(value);
    return key && labels[key] ? labels[key] : '';
  }

  function datePartsFromValue(value) {
    const text = cleanText(value);
    if (!text) return null;
    const date = new Date(text);
    if (Number.isNaN(date.getTime())) return null;
    return {
      year: date.getUTCFullYear(),
      month: date.getUTCMonth() + 1,
      day: date.getUTCDate(),
    };
  }

  function datePartsInTimezone(value, timezone) {
    const text = cleanText(value);
    const zone = cleanText(timezone);
    if (!text || !isValidTimezone(zone)) return null;
    if (/^\d{4}-\d{2}-\d{2}$/.test(text)) {
      return datePartsFromValue(text);
    }
    const date = new Date(text);
    if (Number.isNaN(date.getTime())) return null;
    try {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: zone,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(date);
      const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      return {
        year: Number(values.year),
        month: Number(values.month),
        day: Number(values.day),
      };
    } catch {
      return null;
    }
  }

  function isValidTimezone(timezone) {
    const zone = cleanText(timezone);
    if (!zone) return false;
    try {
      new Intl.DateTimeFormat('en', { timeZone: zone }).format(new Date());
      return true;
    } catch {
      return false;
    }
  }

  function dateFromParts(parts) {
    return new Date(Date.UTC(parts.year, parts.month - 1, parts.day));
  }

  function addCalendarDays(parts, days) {
    const date = dateFromParts(parts);
    date.setUTCDate(date.getUTCDate() + days);
    return {
      year: date.getUTCFullYear(),
      month: date.getUTCMonth() + 1,
      day: date.getUTCDate(),
    };
  }

  function sameDateYear(start, end) {
    return start.year === end.year;
  }

  function sameCalendarDay(start, end) {
    return start.year === end.year && start.month === end.month && start.day === end.day;
  }

  function monthName(parts, width = 'long') {
    return new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', {
      month: width,
      timeZone: 'UTC',
    }).format(dateFromParts(parts));
  }

  function capitalize(value) {
    const text = cleanText(value);
    return text ? `${text.charAt(0).toLocaleUpperCase(isEnglish ? 'en' : 'es')}${text.slice(1)}` : '';
  }

  function weekdayName(parts) {
    return new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', {
      weekday: 'long',
      timeZone: 'UTC',
    }).format(dateFromParts(parts));
  }

  function eventDateDisplay(parts) {
    return {
      day: String(parts.day),
      month: capitalize(monthName(parts, 'long')),
      meta: `${capitalize(weekdayName(parts))} · ${parts.year}`,
    };
  }

  function dayMonth(parts, width = 'long') {
    const month = monthName(parts, width);
    return isEnglish ? `${parts.day} ${month}` : `${parts.day} de ${month}`;
  }

  function dayMonthYear(parts, width = 'short') {
    return `${dayMonth(parts, width)} ${parts.year}`;
  }

  function formatEventDateRange(start, end) {
    if (sameCalendarDay(start, end)) {
      return dayMonth(start, 'long');
    }
    if (start.year === end.year && start.month === end.month) {
      const month = monthName(start, 'long');
      return isEnglish
        ? `${start.day}\u2013${end.day} ${month}`
        : `${start.day}\u2013${end.day} de ${month}`;
    }
    if (start.year === end.year) {
      return `${dayMonth(start, 'short')}\u2013${dayMonth(end, 'short')}`;
    }
    return `${dayMonthYear(start)}\u2013${dayMonthYear(end)}`;
  }

  function eventStatusLabel(value) {
    const status = cleanText(value);
    if (!status || status === 'scheduled' || status === 'normal') return '';
    return copy.event.status[status] ?? '';
  }

  function eventEyebrow(kind) {
    return (kind || copy.types.upcoming_event).toLocaleUpperCase(isEnglish ? 'en' : 'es');
  }

  function validClock(value) {
    return /^([01]\d|2[0-3]):[0-5]\d$/.test(cleanText(value));
  }

  function clockValue(value) {
    const text = cleanText(value);
    return validClock(text) ? text : '';
  }

  function clockStatement(startValue, endValue, duration) {
    const start = clockValue(startValue);
    const end = clockValue(endValue);
    let value = '';
    if (start && end) value = `${start}\u2013${end}`;
    else if (start) value = `${copy.event.starts} ${start}`;
    if (value && duration > 1) value = `${value} ${copy.event.eachDay}`;
    return value;
  }

  function clockMinutes(value) {
    const text = clockValue(value);
    if (!text) return null;
    const [hours, minutes] = text.split(':').map(Number);
    return hours * 60 + minutes;
  }

  function clockDurationMinutes(startValue, endValue) {
    const start = clockMinutes(startValue);
    const end = clockMinutes(endValue);
    if (start === null || end === null) return null;
    const duration = end - start;
    return duration > 0 ? duration : null;
  }

  function compactDurationLabel(minutes) {
    if (!Number.isInteger(minutes) || minutes <= 0) return '';
    const hours = Math.floor(minutes / 60);
    const remainingMinutes = minutes % 60;
    if (!hours) return `${remainingMinutes}m`;
    if (!remainingMinutes) return `${hours}h`;
    return `${hours}h ${remainingMinutes}m`;
  }

  function timezoneLabel(timezone, startDate, endDate) {
    const zone = cleanText(timezone);
    if (!isValidTimezone(zone)) return '';

    const city = zone.split('/').pop()?.replace(/_/g, ' ') || zone;
    const startOffset = timezoneOffsetLabel(zone, startDate);
    const endOffset = timezoneOffsetLabel(zone, endDate);
    return startOffset && startOffset === endOffset ? `${city} · ${startOffset}` : city;
  }

  function timezoneOffsetLabel(timezone, parts) {
    try {
      const formatter = new Intl.DateTimeFormat('en', {
        timeZone: timezone,
        timeZoneName: 'shortOffset',
        hour: '2-digit',
        minute: '2-digit',
      });
      const label = formatter
        .formatToParts(dateFromParts(parts))
        .find((part) => part.type === 'timeZoneName')?.value;
      if (!label) return '';
      return label
        .replace(/^GMT$/, 'UTC')
        .replace(/^GMT([+-])/, (_, sign) => `UTC${sign === '-' ? '\u2212' : '+'}`);
    } catch {
      return '';
    }
  }

  function eventMap(value) {
    if (!value || typeof value !== 'object' || Array.isArray(value)) return {};
    return Object.fromEntries(
      Object.entries(value)
        .map(([key, entry]) => [cleanText(key).toUpperCase(), cleanText(entry)])
        .filter(([key, entry]) => /^[A-Z]{2}$/.test(key) && entry)
    );
  }

  function countryName(code) {
    const countryDisplayNames =
      typeof Intl.DisplayNames === 'function'
        ? new Intl.DisplayNames([isEnglish ? 'en' : 'es'], { type: 'region' })
        : null;
    return countryDisplayNames?.of(code) ?? code;
  }

  function regionalTimeRows(payload, startDate, endDate, duration, dateSource) {
    const starts = eventMap(payload.regionalStartTimes);
    const ends = eventMap(payload.regionalEndTimes);
    const zones = eventMap(payload.regionalTimezones);
    const codes = [...new Set([...Object.keys(starts), ...Object.keys(ends), ...Object.keys(zones)])];
    return codes
      .map((code) => {
        const timezoneId = cleanText(zones[code]);
        const dateParts = datePartsInTimezone(dateSource, timezoneId) || startDate;
        const durationMinutes = clockDurationMinutes(starts[code], ends[code]);
        const tableDuration = compactDurationLabel(durationMinutes);
        return {
          code,
          country: countryName(code),
          flag: countryFlag(code),
          time: clockStatement(starts[code], ends[code], duration),
          startTime: clockValue(starts[code]),
          tableDuration,
          timezone: timezoneLabel(timezoneId, dateParts, dateParts),
          timezoneId,
          dateParts,
        };
      })
      .filter((row) => row.time)
      .sort((a, b) => a.country.localeCompare(b.country));
  }

  function eventScheduleData(payload, startDate, endDate, duration, dateSource, timeKind) {
    const location = eventLocationData(payload);
    if (timeKind === 'regionalTimes') {
      const regionalRows = regionalTimeRows(payload, startDate, endDate, duration, dateSource);
      return regionalRows.length || location
        ? {
            time: null,
            location,
            regionalRows,
            regionalTableRows: regionalRows.filter((row) => row.startTime && row.tableDuration),
          }
        : null;
    }

    let primary = '';
    let detail = '';
    let dateParts = startDate;
    if (timeKind === 'timed') {
      primary = clockStatement(payload.dailyStartTime, payload.dailyEndTime, 1);
      detail = primary ? timezoneLabel(payload.timezone, startDate, endDate) : '';
      dateParts = primary ? datePartsInTimezone(dateSource, payload.timezone) || startDate : startDate;
    } else if (timeKind === 'allDay') {
      primary = copy.event.allDay;
    } else if (timeKind === 'timeTba') {
      primary = copy.event.timeTba;
    }

    return primary || location
      ? {
          time: primary
            ? {
                value: primary,
                detail,
                dateParts,
              }
            : null,
          location,
          regionalRows: [],
          regionalTableRows: [],
        }
      : null;
  }

  function eventLocationData(payload) {
    const location = cleanText(payload.location);
    if (!location) return null;

    const attendanceMode = cleanText(payload.attendanceMode);
    const normalized = location
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase(isEnglish ? 'en' : 'es');
    if (attendanceMode === 'online' && ['online', 'en linea', 'virtual'].includes(normalized)) {
      return null;
    }
    return { value: location, detail: '' };
  }

  function eventParticipationFactData(payload) {
    const facts = [];
    const attendanceMode = enumLabel(payload.attendanceMode, copy.event.attendance);
    const capacity = capacityLabel(payload);
    const languages = labelList(uniqueCleanArray(payload.languages), copy.event.languages);
    const cost = costLabel(payload);
    const audience = labelList(uniqueCleanArray(payload.audience), copy.event.audience);
    const accessibility = labelList(
      uniqueCleanArray(payload.accessibilityFeatures),
      copy.event.accessibilityValues
    );

    if (attendanceMode) {
      facts.push({ key: 'attendance', label: copy.event.attendanceMode, value: attendanceMode });
    }
    if (capacity) {
      facts.push({ key: 'capacity', label: copy.event.capacity, value: capacity });
    }
    if (languages.length) {
      facts.push({ key: 'languages', label: copy.event.eventLanguages, value: languages.join(', ') });
    }
    if (cost) {
      facts.push({ key: 'cost', label: copy.event.cost, value: cost });
    }
    if (audience.length) {
      facts.push({ key: 'audience', label: copy.event.whoFor, value: audience.join(', ') });
    }
    if (accessibility.length) {
      facts.push({ key: 'accessibility', label: copy.event.accessibility, value: accessibility.join(', ') });
    }
    return facts;
  }

  function capacityLabel(payload) {
    if (!hasOwn(payload, 'maxAttendance')) return '';
    if (payload.maxAttendance === null) return copy.event.noLimit;
    const capacity = positiveInteger(payload.maxAttendance);
    return capacity ? copy.event.upToPeople(capacity) : '';
  }

  function costLabel(payload) {
    const costType = cleanText(payload.costType);
    if (!costType) return '';
    if (costType === 'free') return copy.event.free;
    if (costType === 'donation') return copy.event.donation;
    if (costType === 'varies') return copy.event.varies;
    if (costType === 'unknown') return copy.event.costUnknown;
    if (costType !== 'paid') return '';
    const currency = cleanText(payload.currency).toUpperCase();
    if (!hasOwn(payload, 'priceMinorUnits') || payload.priceMinorUnits === null) {
      return copy.event.paid;
    }
    const price = Number(payload.priceMinorUnits);
    if (!/^[A-Z]{3}$/.test(currency) || !Number.isInteger(price) || price < 0) {
      return copy.event.paid;
    }
    try {
      return new Intl.NumberFormat(isEnglish ? 'en' : 'es-AR', {
        style: 'currency',
        currency,
        currencyDisplay: 'code',
        maximumFractionDigits: Number.isInteger(price) ? 0 : 2,
      }).format(price);
    } catch {
      return copy.event.paid;
    }
  }

  function eventOrganizerData(payload) {
    const facts = [];
    const organizerName = cleanText(payload.organizerName);
    const relationship = enumLabel(payload.publisherRelationshipToEvent, copy.event.relationships);
    const disclosure = cleanText(payload.publisherDisclosure);
    if (organizerName) {
      facts.push({ key: 'organizer', label: copy.event.organizedBy, value: organizerName });
    }
    if (relationship) {
      facts.push({ key: 'publisher-role', label: copy.event.publisherRole, value: relationship });
    }
    return facts.length || disclosure
      ? {
          facts,
          disclosure,
        }
      : null;
  }

  function labelList(values, labels) {
    return values.map((value) => labels[value] ?? humanize(value)).filter(Boolean);
  }

  function eventActionData(value, virtualMeetingLink) {
    const seen = new Set();
    const supportedTypes = new Set(Object.keys(copy.event.actions));
    const actions = Array.isArray(value)
      ? value
      .map((entry) => {
        if (!entry || typeof entry !== 'object') return null;
        const type = cleanText(entry.type);
        const url = eventActionUrl(type, entry.url);
        if (!supportedTypes.has(type) || !url || seen.has(type)) return null;
        seen.add(type);
        const title = cleanText(entry.title);
        return {
          type,
          title: title && title.length <= 56 ? title : copy.event.actions[type],
          url,
          external: /^https:\/\//i.test(url),
        };
      })
      .filter(Boolean)
      : [];

    const legacyJoinUrl = eventActionUrl('join', virtualMeetingLink);
    if (legacyJoinUrl && !seen.has('join')) {
      actions.push({
        type: 'join',
        title: copy.event.actions.join,
        url: legacyJoinUrl,
        external: true,
      });
    }
    return actions;
  }

  function eventActionUrl(type, value) {
    const text = cleanText(value);
    if (!text) return '';
    if (type === 'contactOrganizer' && /^mailto:[^\s@]+@[^\s@]+\.[^\s@]+$/i.test(text)) {
      return text;
    }
    try {
      const url = new URL(text);
      return url.protocol === 'https:' ? url.toString() : '';
    } catch {
      return '';
    }
  }

  function localizedDescription(fields) {
    const baseDescription = cleanText(fields.description);
    const englishDescription = cleanText(fields.descriptionEn);
    return isEnglish ? englishDescription || baseDescription : baseDescription || englishDescription;
  }

  function parseCsv(value) {
    const seen = new Set();
    return cleanText(value)
      .split(',')
      .map((token) => token.trim())
      .filter((token) => {
        if (!token || seen.has(token)) {
          return false;
        }
        seen.add(token);
        return true;
      });
  }

  function labelsForCsv(value, labelMap) {
    return parseCsv(value)
      .map((key) => labelMap.get(key))
      .filter(Boolean);
  }

  function countriesForCsv(value) {
    const countryDisplayNames =
      typeof Intl.DisplayNames === 'function'
        ? new Intl.DisplayNames([isEnglish ? 'en' : 'es'], { type: 'region' })
        : null;

    return parseCsv(value)
      .map((code) => code.toUpperCase())
      .filter((code) => code === 'GLOBAL' || /^[A-Z]{2}$/.test(code))
      .map((code) => ({
        label:
          code === 'GLOBAL'
            ? 'Global'
            : `${countryDisplayNames?.of(code) ?? code} (${code})`,
        flag: countryFlag(code),
      }));
  }

  function countryFlag(code) {
    if (code === 'GLOBAL') {
      return '🌐';
    }

    return code.replace(/[A-Z]/g, (char) =>
      String.fromCodePoint(0x1f1e6 + char.charCodeAt(0) - 65)
    );
  }

  function socialLinksForPreview(social) {
    if (!social || typeof social !== 'object') {
      return [];
    }

    return socialPreviewOptions
      .map((option) => {
        const value = cleanText(social[option.key]);
        const href = socialHref(option.key, value);
        return value && href
          ? {
              label: option.label,
              href,
              assetName: option.assetName,
            }
          : null;
      })
      .filter(Boolean);
  }

  function compactUrlLabel(value) {
    const label = cleanText(value).replace(/^(https?:\/\/|mailto:)/i, '').replace(/\/$/, '');
    return label.length > 32 ? `${label.slice(0, 29)}...` : label;
  }

  function readColor(value) {
    const color = cleanText(value);
    return /^#[0-9a-fA-F]{6}$/.test(color) ? color : '';
  }

  function publisherInitials(value) {
    const words = cleanText(value)
      .split(/\s+/)
      .filter(Boolean);
    const initials = words.slice(0, 2).map((word) => word[0]?.toLocaleUpperCase(isEnglish ? 'en' : 'es')).join('');
    return initials || 'PG';
  }

  function renderPreview(data) {
    const isEventPreview = Boolean(data.event);
    preview.dataset.kind = data.kind;
    preview.classList.toggle('shared-preview--event', isEventPreview);
    page?.classList.toggle('has-event-preview', isEventPreview);
    if (hero) hero.hidden = isEventPreview;
    if (breadcrumb) breadcrumb.hidden = !isEventPreview;
    if (appPromotion) appPromotion.hidden = !isEventPreview;

    if (data.accent) {
      preview.style.setProperty('--shared-preview-accent', data.accent);
    } else {
      preview.style.removeProperty('--shared-preview-accent');
    }

    if (!isEventPreview && data.pageTitle) {
      title.textContent = data.pageTitle;
    }
    if (!isEventPreview && data.pageDescription) {
      description.textContent = data.pageDescription;
    }

    setOptionalText('[data-preview-eyebrow]', isEventPreview ? data.event.eyebrow : data.eyebrow);
    setOptionalText('[data-preview-publisher]', data.publisher);
    setOptionalText('[data-preview-publisher-support]', isEventPreview ? data.publisherSupport : '');
    setText('[data-preview-title]', data.title);
    setOptionalText('[data-preview-summary]', data.summary);
    renderBody(data.body);
    renderImage('[data-preview-banner]', data.bannerUrl);
    renderBanner(data.bannerUrl);
    renderImage('[data-preview-image]', data.imageUrl);
    renderMedia(data.mediaUrl);
    renderBadges(isEventPreview ? [] : data.badges);
    renderPreviewSections(data);
    renderMeta(data.meta);
    renderEventPreview(data.event);
    renderWebsite(data.websiteUrl, data.websiteLabel, data.event?.actionSupport);

    const fallback = preview.querySelector('[data-preview-fallback]');
    if (fallback) {
      fallback.textContent = publisherInitials(data.publisher || data.title);
      fallback.hidden = Boolean(data.imageUrl);
    }

    if (isEventPreview) {
      document.title = `${data.title} | Pocket Genes`;
    }

    preview.hidden = false;
  }

  function setText(selector, value) {
    const node = preview.querySelector(selector);
    if (node) {
      node.textContent = value;
    }
  }

  function setOptionalText(selector, value) {
    const node = preview.querySelector(selector);
    if (!node) return;
    const text = cleanText(value);
    node.textContent = text;
    node.hidden = !text;
  }

  function renderBody(body) {
    const shell = preview.querySelector('[data-preview-body-shell]');
    const node = preview.querySelector('[data-preview-body]');
    if (!node) return;

    if (!bodyHasContent(body)) {
      node.replaceChildren();
      node.hidden = true;
      if (shell) shell.hidden = true;
      return;
    }

    const content =
      typeof body === 'string'
        ? { kind: 'text', value: body }
        : body;
    node.innerHTML =
      content.kind === 'html'
        ? content.value
        : plainTextBodyHtml(content.value);
    node.hidden = false;
    if (shell) shell.hidden = false;
  }

  function renderImage(selector, src) {
    const image = preview.querySelector(selector);
    if (!image) return;
    const url = imageSource(src);
    image.hidden = !url;
    if (url) {
      image.setAttribute('src', url);
    } else {
      image.removeAttribute('src');
    }
  }

  function renderMedia(src) {
    const image = preview.querySelector('[data-preview-media]');
    const figure = preview.querySelector('[data-preview-cover]');
    const url = imageSource(src);
    if (figure) {
      figure.hidden = !url;
    }
    if (image) {
      image.hidden = !url;
      image.onerror = () => {
        image.hidden = true;
        image.removeAttribute('src');
        if (figure) figure.hidden = true;
      };
      if (url) {
        image.setAttribute('src', url);
      } else {
        image.removeAttribute('src');
      }
    }
  }

  function renderBanner(src) {
    const shell = preview.querySelector('[data-preview-banner-shell]');
    if (!shell) return;
    shell.hidden = !imageSource(src);
  }

  function renderBadges(badges) {
    const container = preview.querySelector('[data-preview-badges]');
    if (!container) return;
    container.hidden = badges.length === 0;
    container.replaceChildren(
      ...badges.map((badge) => {
        const element = document.createElement('span');
        element.className = 'shared-preview-badge';
        element.textContent = badge;
        return element;
      })
    );
  }

  function renderMeta(meta) {
    const container = preview.querySelector('[data-preview-meta]');
    if (!container) return;
    container.hidden = meta.length === 0;
    container.replaceChildren(
      ...meta.map((item) => {
        const element = document.createElement('span');
        element.textContent = item;
        return element;
      })
    );
  }

  function renderEventPreview(event) {
    const container = preview.querySelector('[data-preview-event]');
    if (!container) return;
    container.replaceChildren();
    container.hidden = !event;
    if (!event) return;

    const nodes = [];
    if (event.status) {
      const statusRow = document.createElement('p');
      statusRow.className = 'shared-event-status-row';
      const dot = document.createElement('span');
      dot.setAttribute('aria-hidden', 'true');
      statusRow.append(dot, document.createTextNode(event.status));
      nodes.push(statusRow);
    }

    const date = renderEventDate(event.dateParts, event.dateSpan);
    nodes.push(date);

    const schedule = renderEventSchedule(event.schedule, event.dateParts, date);
    if (schedule) nodes.push(schedule);

    const facts = renderEventFacts(event.participationFacts);
    if (facts) nodes.push(facts);

    const organizer = renderEventOrganizerContext(event.organizer);
    if (organizer) nodes.push(organizer);

    const actions = renderEventActions(event.actions);
    if (actions) nodes.push(actions);

    container.append(...nodes);
  }

  function renderEventDate(parts, dateSpan = '') {
    const date = document.createElement('div');
    date.className = 'shared-event-date';
    const day = document.createElement('p');
    day.className = 'shared-event-date-day';
    day.setAttribute('data-event-date-day', '');
    const text = document.createElement('div');
    text.className = 'shared-event-date-text';
    const month = document.createElement('p');
    month.className = 'shared-event-date-month';
    month.setAttribute('data-event-date-month', '');
    const meta = document.createElement('p');
    meta.className = 'shared-event-date-meta';
    meta.setAttribute('data-event-date-meta', '');
    text.append(month, meta);
    if (dateSpan) {
      const span = document.createElement('p');
      span.className = 'shared-event-date-span';
      span.textContent = dateSpan;
      text.append(span);
    }
    date.append(day, text);
    updateEventDate(date, parts);
    return date;
  }

  function updateEventDate(container, parts) {
    const display = eventDateDisplay(parts);
    const day = container.querySelector('[data-event-date-day]');
    const month = container.querySelector('[data-event-date-month]');
    const meta = container.querySelector('[data-event-date-meta]');
    if (day) day.textContent = display.day;
    if (month) month.textContent = display.month;
    if (meta) meta.textContent = display.meta;
  }

  function renderEventSchedule(schedule, fallbackDateParts, dateContainer) {
    if (!schedule || (!schedule.time && !schedule.location && !schedule.regionalRows.length)) {
      return null;
    }
    const section = document.createElement('section');
    section.className = 'shared-event-schedule';

    let selected = null;
    let timeRow = null;
    if (schedule.regionalRows.length) {
      selected = selectedScheduleOption(schedule, fallbackDateParts);
      if (selected.time || selected.timezone) {
        timeRow = renderEventInfoRow('clock', selected.time, selected.timezone);
        timeRow.querySelector('.shared-event-info-value')?.setAttribute('data-event-selected-time', '');
        timeRow.querySelector('.shared-event-info-detail')?.setAttribute('data-event-selected-timezone', '');
        section.append(timeRow);
      }
    } else if (schedule.time) {
      timeRow = renderEventInfoRow('clock', schedule.time.value, schedule.time.detail);
      section.append(timeRow);
    }

    if (schedule.regionalRows.length > 1) {
      const selectorWrap = document.createElement('div');
      selectorWrap.className = 'shared-event-region-selector';

      const label = document.createElement('label');
      const selectorId = `event-region-${Math.random().toString(36).slice(2)}`;
      label.setAttribute('for', selectorId);
      label.textContent = copy.event.timezoneSelector;

      const select = document.createElement('select');
      select.id = selectorId;
      schedule.regionalRows.forEach((row) => {
        const option = document.createElement('option');
        option.value = row.code;
        option.textContent = `${row.flag ? `${row.flag} ` : ''}${row.country}`;
        select.append(option);
      });
      select.value = selected.code;
      select.addEventListener('change', () => {
        const next = schedule.regionalRows.find((row) => row.code === select.value) || selected;
        updateEventDate(dateContainer, next.dateParts || fallbackDateParts);
        if (timeRow) updateSelectedSchedule(timeRow, next);
        updateSelectedRegionalTable(section, next.code);
      });

      selectorWrap.append(label, select);
      section.append(selectorWrap);
    } else if (schedule.regionalRows.length === 1) {
      const singleRegion = document.createElement('p');
      singleRegion.className = 'shared-event-single-region';
      singleRegion.textContent = schedule.regionalRows[0].country;
      section.append(singleRegion);
    }

    if (schedule.location) {
      section.append(renderEventInfoRow('location', schedule.location.value, schedule.location.detail));
    }

    const regionalTable = renderEventRegionalTable(schedule.regionalTableRows, selected?.code || '');
    if (regionalTable) section.append(regionalTable);
    return section;
  }

  function selectedScheduleOption(schedule, fallbackDateParts) {
    if (schedule.regionalRows.length) {
      const browserRegion = browserRegionCode();
      const preferredCodes = [
        browserRegion,
        isEnglish ? 'US' : 'AR',
        'AR',
        'US',
      ].filter(Boolean);
      return (
        preferredCodes
          .map((code) => schedule.regionalRows.find((row) => row.code === code))
          .find(Boolean) || schedule.regionalRows[0]
      );
    }
    return {
      code: '',
      country: '',
      flag: '',
      time: schedule.time?.value || '',
      timezone: schedule.time?.detail || '',
      dateParts: schedule.time?.dateParts || fallbackDateParts,
    };
  }

  function browserRegionCode() {
    const locale = navigator.languages?.[0] || navigator.language || '';
    const match = locale.match(/[-_]([A-Za-z]{2})\b/);
    return match ? match[1].toUpperCase() : '';
  }

  function updateSelectedSchedule(row, option) {
    const value = row.querySelector('[data-event-selected-time]');
    const detail = row.querySelector('[data-event-selected-timezone]');
    if (value) value.textContent = option.time || '';
    if (detail) {
      detail.textContent = option.timezone || '';
      detail.hidden = !option.timezone;
    }
  }

  function renderEventRegionalTable(rows, selectedCode) {
    if (!rows?.length) return null;
    const table = document.createElement('table');
    table.className = 'shared-event-regional-table';
    const thead = document.createElement('thead');
    const headerRow = document.createElement('tr');
    [copy.event.tableRegion, copy.event.tableStart, copy.event.tableDuration].forEach((label) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.textContent = label;
      headerRow.append(cell);
    });
    thead.append(headerRow);

    const tbody = document.createElement('tbody');
    rows.forEach((row) => {
      const tableRow = document.createElement('tr');
      tableRow.dataset.regionCode = row.code;
      tableRow.classList.toggle('is-selected', row.code === selectedCode);

      const flagCell = document.createElement('td');
      const flag = document.createElement('span');
      flag.className = 'shared-event-regional-flag';
      flag.setAttribute('role', 'img');
      flag.setAttribute('aria-label', row.country);
      flag.textContent = row.flag;
      flagCell.append(flag);

      const startCell = document.createElement('td');
      startCell.textContent = row.startTime;

      const durationCell = document.createElement('td');
      durationCell.textContent = row.tableDuration;

      tableRow.append(flagCell, startCell, durationCell);
      tbody.append(tableRow);
    });
    table.append(thead, tbody);
    return table;
  }

  function updateSelectedRegionalTable(container, selectedCode) {
    container.querySelectorAll('.shared-event-regional-table tr[data-region-code]').forEach((row) => {
      row.classList.toggle('is-selected', row.dataset.regionCode === selectedCode);
    });
  }

  function renderEventInfoRow(icon, value, detail) {
    const row = document.createElement('div');
    row.className = `shared-event-info-row shared-event-info-row--${icon}`;
    const symbol = document.createElement('span');
    symbol.className = `shared-event-info-icon shared-event-info-icon--${icon}`;
    symbol.setAttribute('aria-hidden', 'true');
    symbol.textContent = icon === 'clock' ? '◷' : '◌';
    const text = document.createElement('div');
    const main = document.createElement('p');
    main.className = 'shared-event-info-value';
    main.textContent = value;
    text.append(main);
    const secondary = document.createElement('p');
    secondary.className = 'shared-event-info-detail';
    secondary.textContent = detail || '';
    secondary.hidden = !detail;
    text.append(secondary);
    row.append(symbol, text);
    return row;
  }

  function renderEventFacts(facts) {
    if (!facts?.length) return null;
    const section = document.createElement('section');
    section.className = 'shared-event-facts';
    const capacity = facts.find((fact) => fact.key === 'capacity');
    const languages = facts.find((fact) => fact.key === 'languages');
    facts.forEach((fact) => {
      if (fact.key === 'capacity' && languages) {
        const pair = document.createElement('div');
        pair.className = 'shared-event-fact-pair';
        pair.append(createEventFact(capacity), createEventFact(languages));
        section.append(pair);
        return;
      }
      if (fact.key === 'languages' && capacity) {
        return;
      }
      section.append(createEventFact(fact));
    });
    return section;
  }

  function createEventFact(fact) {
    const item = document.createElement('div');
    item.className = `shared-event-fact shared-event-fact--${fact.key}`;
    const label = document.createElement('p');
    label.className = 'shared-event-field-label';
    label.textContent = fact.label;
    const value = document.createElement('p');
    value.className = 'shared-event-fact-value';
    value.textContent = fact.value;
    item.append(label, value);
    return item;
  }

  function renderEventOrganizerContext(sectionData) {
    if (!sectionData || (!sectionData.facts?.length && !sectionData.disclosure)) return null;
    const section = document.createElement('section');
    section.className = 'shared-event-context';
    sectionData.facts?.forEach((fact) => {
      section.append(createEventFact(fact));
    });
    if (sectionData.disclosure) {
      const disclosure = document.createElement('p');
      disclosure.className = 'shared-event-context-disclosure';
      disclosure.textContent = sectionData.disclosure;
      section.append(disclosure);
    }
    return section;
  }

  function renderEventActions(actions) {
    if (!actions?.length) return null;
    const section = document.createElement('section');
    section.className = 'shared-event-actions';
    const heading = document.createElement('h2');
    heading.className = 'shared-event-actions-title';
    heading.textContent = copy.event.eventActions;
    section.append(heading);
    actions.forEach((action) => {
      const link = document.createElement('a');
      link.className = 'shared-event-action-row';
      link.href = action.url;
      link.rel = action.external ? 'noopener noreferrer' : '';
      link.target = action.external ? '_blank' : '';
      const icon = document.createElement('span');
      icon.className = 'shared-event-action-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = eventActionIcon(action.type);
      const label = document.createElement('span');
      label.textContent = action.title;
      link.append(icon, label);
      if (action.external) {
        const external = document.createElement('span');
        external.className = 'shared-event-action-external';
        external.setAttribute('aria-hidden', 'true');
        external.textContent = '↗';
        link.append(external);
      }
      section.append(link);
    });
    return section;
  }

  function eventActionIcon(type) {
    return {
      register: '→',
      join: '▶',
      learnMore: 'i',
      viewAgenda: '≡',
      watchRecording: '▶',
      downloadMaterials: '↓',
      contactOrganizer: '@',
    }[type] ?? '→';
  }

  function renderPreviewSections(data) {
    renderPillsSection(
      '[data-preview-categories-section]',
      '[data-preview-categories-title]',
      '[data-preview-categories]',
      copy.categories,
      data.categories
    );
    renderPillsSection(
      '[data-preview-countries-section]',
      '[data-preview-countries-title]',
      '[data-preview-countries]',
      copy.countries,
      data.countries
    );
    renderReports(data.reports);
    renderSocials(data.socials);

    const sections = preview.querySelector('[data-preview-sections]');
    if (sections) {
      sections.hidden =
        !data.categories.length &&
        !data.countries.length &&
        !data.reports.length &&
        !data.socials.length;
    }
  }

  function renderPillsSection(sectionSelector, titleSelector, listSelector, titleText, items) {
    const section = preview.querySelector(sectionSelector);
    const titleNode = preview.querySelector(titleSelector);
    const list = preview.querySelector(listSelector);
    if (!section || !titleNode || !list) return;

    section.hidden = items.length === 0;
    titleNode.textContent = titleText;
    list.replaceChildren(
      ...items.map((item) => {
        const element = document.createElement('span');
        element.className = 'shared-preview-badge shared-preview-data-pill';
        if (typeof item === 'object' && item.flag) {
          const flag = document.createElement('span');
          flag.setAttribute('aria-hidden', 'true');
          flag.textContent = item.flag;
          element.append(flag, document.createTextNode(item.label));
        } else {
          element.textContent = typeof item === 'object' ? item.label : item;
        }
        return element;
      })
    );
  }

  function renderReports(reports) {
    const section = preview.querySelector('[data-preview-reports-section]');
    const titleNode = preview.querySelector('[data-preview-reports-title]');
    const list = preview.querySelector('[data-preview-reports]');
    if (!section || !titleNode || !list) return;

    section.hidden = reports.length === 0;
    titleNode.textContent = copy.geneticReports;
    list.replaceChildren(
      ...reports.map((report) => {
        const item = document.createElement('li');
        item.textContent = report;
        return item;
      })
    );
  }

  function renderSocials(socials) {
    const section = preview.querySelector('[data-preview-socials-section]');
    const titleNode = preview.querySelector('[data-preview-socials-title]');
    const list = preview.querySelector('[data-preview-socials]');
    if (!section || !titleNode || !list) return;

    section.hidden = socials.length === 0;
    titleNode.textContent = copy.socialLinks;
    list.replaceChildren(
      ...socials.map((social) => {
        const link = document.createElement('a');
        const image = document.createElement('img');
        link.className = 'shared-preview-social-link';
        link.href = social.href;
        link.target = social.href.startsWith('mailto:') ? '' : '_blank';
        link.rel = social.href.startsWith('mailto:') ? '' : 'noopener noreferrer';
        link.ariaLabel = social.label;
        link.title = social.label;
        image.src = `/discover/social-network-assets/${social.assetName}.png`;
        image.alt = '';
        image.loading = 'lazy';
        link.append(image);
        return link;
      })
    );
  }

  function renderWebsite(url, label, supportText = '') {
    const link = preview.querySelector('[data-preview-website]');
    const action = preview.querySelector('[data-preview-primary-action]');
    const support = preview.querySelector('[data-preview-primary-action-support]');
    if (!link) return;
    link.hidden = !url;
    if (action) action.hidden = !url;
    if (url) {
      link.setAttribute('href', url);
      link.textContent = label || copy.website;
    } else {
      link.removeAttribute('href');
    }
    if (support) {
      const text = cleanText(supportText);
      support.textContent = text;
      support.hidden = !text;
    }
  }
</script>

