---
const { src, alt, text, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href } : {};
---

<Tag class="experience-card" {...linkProps}>
  <div class="image-wrapper">
    <img class="image-card" src={src} alt={alt} />
    <div class="image-overlay">
      <div class="company-badge">
        <span class="badge-text">{text}</span>
      </div>
    </div>
  </div>
  <div class="card-content">
    <h3 class="company-name">{text}</h3>
    <p class="description_card">{description}</p>
    <div class="card-footer">
      <span class="success-indicator">✓ Successful Partnership</span>
    </div>
  </div>
</Tag>

<style>
  a.experience-card {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .experience-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    padding: 2rem;
    box-shadow: var(--card-shadow);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .experience-card:hover {
    transform: translateY(-12px);
    box-shadow: var(--card-shadow-hover);
  }

  .image-wrapper {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .image-card {
    width: 100%;
    height: auto;
    max-height: 200px;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .experience-card:hover .image-card {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(64, 37, 239, 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .experience-card:hover .image-overlay {
    opacity: 1;
  }

  .company-badge {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--card-border);
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .experience-card:hover .company-badge {
    transform: translateY(0);
  }

  .badge-text {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .card-content {
    text-align: center;
  }

  .company-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .description_card {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--card-border);
  }

  .success-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-color);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .experience-card {
      padding: 1.5rem;
    }

    .image-card {
      max-height: 220px;
    }

    .company-name {
      font-size: 1.5rem;
    }

    .description_card {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .experience-card {
      padding: 1.25rem;
    }

    .image-card {
      max-height: 180px;
    }

    .company-name {
      font-size: 1.25rem;
    }

    .description_card {
      font-size: 0.9rem;
    }
  }
</style>
