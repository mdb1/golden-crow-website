---
const { src, alt, width, height } = Astro.props
---

<div class="image">
    <img class="image-card" src={src} alt={alt} loading="lazy" width={width} height={height} />
</div>

<style>
    .image{
        aspect-ratio: 800 / 467;
        width: min(100%, 520px);
        margin: 10px;
        overflow: hidden;
        border-radius: 20px;
        box-shadow: var(--card-shadow);
    }
    
    .image-card{
        display: block;
        width: 100%;
        height: 100%;
        border-radius: inherit;
        object-fit: cover;
        object-position: center;
    }

    @media screen and (max-width: 1200px) {
        .image {
            width: min(42vw, 520px);
        }
    }

    @media screen and (max-width: 768px) {
        .image {
            width: min(100%, 420px);
        }
    }
</style>
