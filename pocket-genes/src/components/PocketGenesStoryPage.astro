---
// Envoltorio de compatibilidad: resuelve el copy de Pocket Genes por slug y
// delega la maqueta en ProductStoryPage (la misma de siempre, extraída para
// poder reusarla en GC Fitness). Las 8 páginas de /pocket-genes siguen
// llamando a este componente con `slug`, sin cambios.
import ProductStoryPage from './ProductStoryPage.astro';
import { defaultLang, type Lang } from '../i18n/ui';
import {
  getPocketGenesStoryNav,
  getPocketGenesStoryPage,
  type PocketGenesStorySlug,
} from '../data/pocketGenesStory';

interface Props {
  slug: PocketGenesStorySlug;
}

const { slug } = Astro.props;
const lang = (Astro.currentLocale || defaultLang) as Lang;
const pocketGenesIcon = '/pocket-genes/icon_simple.png';
const pocketGenesSocialImage = '/pocket-genes/banner.png';
---

<ProductStoryPage
  page={getPocketGenesStoryPage(lang, slug)}
  navItems={getPocketGenesStoryNav(lang)}
  activeSlug={slug}
  brandLogoSrc={pocketGenesIcon}
  brandLogoAlt="Pocket Genes app icon"
  brandText="Pocket Genes"
  brandHref="/pocket-genes"
  faviconHref={pocketGenesIcon}
  favicon32Href={pocketGenesIcon}
  favicon16Href={pocketGenesIcon}
  appleTouchIconHref={pocketGenesIcon}
  socialImage={pocketGenesSocialImage}
  socialImageWidth={1024}
  socialImageHeight={500}
  socialImageType="image/png"
/>
