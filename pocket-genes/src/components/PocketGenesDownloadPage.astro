---
import PocketGenesPublicLayout from '../layouts/PocketGenesPublicLayout.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/pocketGenesPublic';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const pageCopy = {
  en: {
    title: 'Download Pocket Genes',
    description: 'Download Pocket Genes for iPhone and Android.',
    headingLineOne: 'Download',
    lead: 'Keep genetic reports, learning, and rare-gene community context close at hand.',
    storeGridLabel: 'Pocket Genes download options',
    availableNow: 'Available now',
    appStoreAlt: 'Download on the App Store',
    appStoreNote: 'For iPhone',
    playStoreKicker: 'Available now',
    googlePlayAlt: 'Get it on Google Play',
    playStoreNote: 'For Android',
  },
  es: {
    title: 'Descargar Pocket Genes',
    description: 'Descargá Pocket Genes para iPhone y Android.',
    headingLineOne: 'Descargar',
    lead: 'Mantené informes genéticos, aprendizaje y contexto comunitario de genes raros siempre cerca.',
    storeGridLabel: 'Opciones de descarga de Pocket Genes',
    availableNow: 'Disponible ahora',
    appStoreAlt: 'Descargar en App Store',
    appStoreNote: 'Para iPhone',
    playStoreKicker: 'Disponible ahora',
    googlePlayAlt: 'Obtener en Google Play',
    playStoreNote: 'Para Android',
  },
} as const;

const copy = pageCopy[isEnglish ? 'en' : 'es'];
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/download"
  showFooter={false}
  image="/pocket-genes/banner.png"
>
  <main id="main" class="download-page">
    <section class="download-hero" aria-labelledby="download-title">
      <div class="download-ambient" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="download-shell">
        <div class="download-copy">
          <h1 id="download-title">
            <span>{copy.headingLineOne}</span>
            <span>Pocket Genes</span>
          </h1>
          <p class="download-lead">
            {copy.lead}
          </p>

          <div class="store-grid" aria-label={copy.storeGridLabel}>
            <a class="store-card store-card-live" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
              <span class="store-card-glow" aria-hidden="true"></span>
              <span class="store-kicker">{copy.availableNow}</span>
              <img class="store-badge app-store-badge" src="/pocket-genes/app-store-badge.svg" alt={copy.appStoreAlt} width="180" height="60" />
              <span class="store-note">{copy.appStoreNote}</span>
            </a>

            <a class="store-card store-card-live store-card-play" href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
              <span class="store-card-glow" aria-hidden="true"></span>
              <span class="store-kicker">{copy.playStoreKicker}</span>
              <span class="play-badge-wrap">
                <img class="store-badge google-play-badge" src="/pocket-genes/google-play-badge.png" alt={copy.googlePlayAlt} width="194" height="75" />
              </span>
              <span class="store-note">{copy.playStoreNote}</span>
            </a>
          </div>
        </div>

        <div class="download-visual" aria-hidden="true">
          <div class="orbit-ring orbit-one"></div>
          <div class="orbit-ring orbit-two"></div>
          <div class="phone-stage">
            <div class="phone-card phone-card-left">
              <img src="/pocket-genes/screenshots/sample-01.webp" alt="" width="560" height="1218" />
            </div>
            <div class="phone-card phone-card-main">
              <img src="/pocket-genes/screenshots/sample-09.webp" alt="" width="560" height="1218" />
            </div>
            <div class="phone-card phone-card-right">
              <img src="/pocket-genes/screenshots/sample-07.webp" alt="" width="560" height="1218" />
            </div>
            <img class="floating-icon" src="/pocket-genes/icon.png" alt="" width="120" height="120" />
          </div>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .download-page {
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(115deg, rgba(20, 149, 143, 0.12), transparent 34%),
      linear-gradient(245deg, rgba(228, 80, 128, 0.1), transparent 36%),
      linear-gradient(180deg, #f8fcfc 0%, #ffffff 47%, #f7fbff 100%);
    color: var(--pg-ink);
  }

  .download-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(7rem, 12vw, 8.5rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .download-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(20, 149, 143, 0.065) 1px, transparent 1px),
      linear-gradient(90deg, rgba(33, 118, 174, 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 16%, #000 74%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 16%, #000 74%, transparent);
    opacity: 0.45;
    pointer-events: none;
  }

  .download-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .download-copy {
    position: relative;
    min-width: 0;
  }

  .store-kicker,
  .store-note {
    margin: 0;
    letter-spacing: 0;
  }

  .download-copy h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(3.35rem, 8vw, 7.2rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .download-copy h1 span {
    display: block;
  }

  .download-lead {
    max-width: 610px;
    margin: 1.35rem 0 0;
    color: var(--pg-ink-soft);
    font-size: clamp(1.1rem, 2.1vw, 1.35rem);
    line-height: 1.55;
  }

  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: clamp(2rem, 5vw, 3rem);
    min-width: 0;
  }

  .store-card {
    position: relative;
    isolation: isolate;
    min-height: 210px;
    overflow: hidden;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 14px;
    border: 1px solid rgba(197, 210, 223, 0.95);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(246, 253, 252, 0.86)),
      #ffffff;
    padding: clamp(1.1rem, 3vw, 1.55rem);
    color: var(--pg-ink);
    text-decoration: none;
    min-width: 0;
    box-shadow: 0 24px 64px rgba(23, 32, 51, 0.11);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .store-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(110deg, transparent 0 34%, rgba(20, 149, 143, 0.12) 48%, transparent 64%);
    transform: translateX(-130%);
    transition: transform 520ms ease;
  }

  .store-card-live:hover {
    transform: translateY(-5px);
    border-color: rgba(20, 149, 143, 0.42);
    box-shadow: 0 30px 86px rgba(20, 149, 143, 0.18);
  }

  .store-card-live:hover::before {
    transform: translateX(130%);
  }

  .store-card-soon {
    color: var(--pg-ink-soft);
  }

  .store-card-glow {
    position: absolute;
    inset: auto -20% -44% 18%;
    z-index: -1;
    height: 140px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(20, 149, 143, 0.24), transparent 70%);
    filter: blur(18px);
  }

  .store-card-soon .store-card-glow {
    background: radial-gradient(circle, rgba(228, 80, 128, 0.22), transparent 70%);
  }

  .store-kicker {
    color: #7de4d7;
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .store-badge {
    display: block;
    width: min(100%, 188px);
    height: auto;
  }

  .app-store-badge {
    filter: drop-shadow(0 12px 22px rgba(23, 32, 51, 0.12));
  }

  .google-play-badge {
    width: min(100%, 204px);
    margin: -12px 0;
    filter: drop-shadow(0 12px 22px rgba(23, 32, 51, 0.12));
  }

  .play-badge-wrap {
    position: relative;
    display: inline-block;
  }

  .play-badge-wrap span {
    position: absolute;
    right: 0;
    top: -6px;
    border: 1px solid rgba(255, 255, 255, 0.68);
    border-radius: 999px;
    background: #e45080;
    padding: 5px 9px;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 0 10px 24px rgba(228, 80, 128, 0.34);
  }

  .store-note {
    color: var(--pg-muted);
    font-size: 0.95rem;
    font-weight: 760;
  }

  .download-visual {
    position: relative;
    min-height: 590px;
  }

  .download-visual::before {
    content: "";
    position: absolute;
    inset: 11% 0 5%;
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(20, 149, 143, 0.18), transparent 60%),
      radial-gradient(circle at 72% 28%, rgba(228, 80, 128, 0.18), transparent 42%);
    filter: blur(8px);
  }

  .phone-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .phone-card {
    position: absolute;
    width: clamp(150px, 17vw, 220px);
    overflow: hidden;
    border: 6px solid #050811;
    border-radius: 28px;
    background: #050811;
    box-shadow:
      0 32px 74px rgba(23, 32, 51, 0.22),
      0 0 0 1px rgba(255, 255, 255, 0.18);
    animation: phoneFloat 6.5s ease-in-out infinite;
  }

  .phone-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .phone-card-left {
    transform: translate3d(-120px, 38px, -80px) rotate(-10deg);
    opacity: 0.78;
    animation-delay: -1.4s;
  }

  .phone-card-main {
    width: clamp(176px, 20vw, 264px);
    transform: translate3d(10px, -10px, 0) rotate(3deg);
    z-index: 2;
  }

  .phone-card-right {
    transform: translate3d(142px, 34px, -90px) rotate(11deg);
    opacity: 0.78;
    animation-delay: -2.7s;
  }

  .floating-icon {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 8%;
    width: clamp(74px, 9vw, 116px);
    height: clamp(74px, 9vw, 116px);
    border-radius: 24px;
    box-shadow:
      0 24px 58px rgba(228, 80, 128, 0.22),
      0 0 0 1px rgba(255, 255, 255, 0.72);
    transform: translateX(-50%);
    animation: iconPulse 4.8s ease-in-out infinite;
  }

  .orbit-ring {
    position: absolute;
    border: 1px solid rgba(20, 149, 143, 0.26);
    border-radius: 999px;
    animation: orbitDrift 9s ease-in-out infinite;
  }

  .orbit-one {
    width: 86%;
    height: 58%;
    top: 17%;
    left: 7%;
    transform: rotate(-14deg);
  }

  .orbit-two {
    width: 64%;
    height: 46%;
    top: 28%;
    left: 19%;
    border-color: rgba(228, 80, 128, 0.24);
    animation-delay: -3.6s;
  }

  .download-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .download-ambient span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #14958f;
    box-shadow: 0 0 22px rgba(20, 149, 143, 0.5);
    animation: sparkFloat 8s ease-in-out infinite;
  }

  .download-ambient span:nth-child(1) {
    top: 17%;
    left: 9%;
  }

  .download-ambient span:nth-child(2) {
    top: 22%;
    right: 13%;
    background: #e45080;
    box-shadow: 0 0 22px rgba(228, 80, 128, 0.48);
    animation-delay: -2s;
  }

  .download-ambient span:nth-child(3) {
    left: 47%;
    bottom: 15%;
    background: #2176ae;
    box-shadow: 0 0 22px rgba(33, 118, 174, 0.48);
    animation-delay: -4.4s;
  }

  @keyframes phoneFloat {
    0%,
    100% {
      margin-top: 0;
    }
    50% {
      margin-top: -16px;
    }
  }

  @keyframes iconPulse {
    0%,
    100% {
      transform: translateX(-50%) translateY(0) scale(1);
    }
    50% {
      transform: translateX(-50%) translateY(-10px) scale(1.04);
    }
  }

  @keyframes orbitDrift {
    0%,
    100% {
      opacity: 0.5;
      transform: rotate(-14deg) scale(1);
    }
    50% {
      opacity: 0.85;
      transform: rotate(-8deg) scale(1.04);
    }
  }

  @keyframes sparkFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 0.48;
    }
    50% {
      transform: translate3d(16px, -20px, 0);
      opacity: 1;
    }
  }

  @media (max-width: 980px) {
    .download-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .download-visual {
      min-height: 480px;
    }

    .download-copy {
      text-align: center;
    }

    .download-lead {
      margin-left: auto;
      margin-right: auto;
    }

    .store-grid {
      max-width: 620px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 640px) {
    .download-hero {
      align-items: flex-start;
      padding-top: 7.5rem;
    }

    .download-visual {
      min-height: 360px;
    }

    .store-grid {
      grid-template-columns: 1fr;
    }

    .store-card {
      min-height: 180px;
      justify-items: center;
      text-align: center;
    }

    .phone-card-left {
      transform: translate3d(-72px, 30px, -80px) rotate(-10deg);
    }

    .phone-card-right {
      transform: translate3d(82px, 30px, -90px) rotate(11deg);
    }
  }

  @media (max-width: 420px) {
    .download-copy h1 {
      font-size: clamp(2.35rem, 10.5vw, 2.85rem);
      line-height: 0.95;
    }

    .play-badge-wrap span {
      right: 4px;
      top: -10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-ambient span,
    .phone-card,
    .floating-icon,
    .orbit-ring {
      animation: none;
    }

    .store-card,
    .store-card::before {
      transition: none;
    }
  }
</style>
