---
import PocketGenesPublicLayout from '../layouts/PocketGenesPublicLayout.astro';
import { APP_STORE_URL } from '../data/pocketGenesPublic';
---

<PocketGenesPublicLayout
  title="Download Pocket Genes"
  description="Download Pocket Genes for iPhone. Google Play support is coming soon."
  canonicalPath="/pocket-genes/download"
  showFooter={false}
>
  <main id="main" class="download-page">
    <section class="download-center" aria-labelledby="download-title">
      <div class="download-shell">
        <p class="download-eyebrow">Pocket Genes</p>
        <h1 id="download-title">Download Pocket Genes</h1>
        <p class="download-lead">Available on iPhone. Android is coming soon.</p>

        <div class="store-grid" aria-label="Pocket Genes download options">
          <a class="store-card store-card-live" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="store-icon app-store-icon" aria-hidden="true">
              <svg viewBox="0 0 72 72" role="img">
                <rect width="72" height="72" rx="18"></rect>
                <path d="M27 47.5 43.4 18" />
                <path d="M28.7 18 45 47.5" />
                <path d="M21.5 42h29" />
              </svg>
            </span>
            <span class="store-copy">
              <span class="store-kicker">Download on the</span>
              <strong>App Store</strong>
              <span class="store-note">For iPhone</span>
            </span>
          </a>

          <article class="store-card store-card-soon" aria-disabled="true">
            <span class="store-icon play-store-icon" aria-hidden="true">
              <svg viewBox="0 0 72 72" role="img">
                <rect width="72" height="72" rx="18"></rect>
                <path class="play-blue" d="M24 18v36l16.8-18z" />
                <path class="play-green" d="M24 18 52 34.8 40.8 36z" />
                <path class="play-yellow" d="M40.8 36 52 37.2 24 54z" />
                <path class="play-red" d="M40.8 36 52 34.8v2.4z" />
              </svg>
            </span>
            <span class="store-copy">
              <span class="store-kicker">Coming soon on</span>
              <strong>Google Play</strong>
              <span class="store-note">Android</span>
            </span>
          </article>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .download-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 50% 8%, rgba(20, 149, 143, 0.1), transparent 34rem),
      linear-gradient(180deg, #f9fbfc 0%, #ffffff 58%, #f7fafb 100%);
    color: #172033;
  }

  .download-center {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 6.75rem 1.25rem 3rem;
  }

  .download-shell {
    width: min(900px, 100%);
    text-align: center;
  }

  .download-eyebrow {
    margin: 0 0 0.8rem;
    color: #14958f;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .download-shell h1 {
    margin: 0;
    font-size: clamp(2.9rem, 6.3vw, 5rem);
    font-weight: 850;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .download-lead {
    margin: 1rem auto 0;
    max-width: 520px;
    color: #68758b;
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    line-height: 1.55;
  }

  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 1.5rem);
    width: min(660px, 100%);
    margin: clamp(2rem, 4vw, 3rem) auto 0;
  }

  .store-card {
    aspect-ratio: 1;
    min-height: 250px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    border: 1px solid rgba(197, 210, 223, 0.82);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 20px 60px rgba(23, 32, 51, 0.1);
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .store-card-live:hover {
    transform: translateY(-4px);
    border-color: rgba(20, 149, 143, 0.38);
    box-shadow: 0 28px 76px rgba(23, 32, 51, 0.16);
  }

  .store-card-soon {
    color: #66758d;
  }

  .store-icon {
    width: clamp(4.8rem, 10vw, 6.4rem);
    height: clamp(4.8rem, 10vw, 6.4rem);
    display: inline-flex;
  }

  .store-icon svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .app-store-icon rect {
    fill: #111827;
  }

  .app-store-icon path {
    fill: none;
    stroke: #ffffff;
    stroke-width: 5.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .play-store-icon rect {
    fill: #ffffff;
    stroke: #dce4ec;
  }

  .play-blue {
    fill: #1a73e8;
  }

  .play-green {
    fill: #34a853;
  }

  .play-yellow {
    fill: #fbbc04;
  }

  .play-red {
    fill: #ea4335;
  }

  .store-copy {
    display: grid;
    gap: 0.2rem;
  }

  .store-kicker,
  .store-note {
    color: #68758b;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .store-copy strong {
    color: #172033;
    font-size: clamp(1.8rem, 4vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  @media (max-width: 720px) {
    .download-center {
      padding-top: 7.75rem;
    }

    .store-grid {
      grid-template-columns: 1fr;
      max-width: 390px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 420px) {
    .store-card {
      min-height: 250px;
      border-radius: 28px;
    }
  }
</style>
