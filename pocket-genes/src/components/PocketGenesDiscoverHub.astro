---

<PocketGenesPublicLayout
  title={pageCopy.title}
  description={pageCopy.description}
  canonicalPath={canonicalPath}
  showFooter={true}
  image="/pocket-genes/banner.png"
>
  <main id="main" class="discover-hub" data-discover-hub data-locale={lang}>
    <section class="discover-hero">
      <div class="discover-shell discover-hero-grid">
        <div class="discover-hero-copy">
          <nav class="discover-breadcrumb" aria-label="Breadcrumb">
            <a href={isEnglish ? '/en/pocket-genes/home' : '/pocket-genes/home'}>{pageCopy.breadcrumbHome}</a>
            <span aria-hidden="true"></span>
            <span aria-current="page">Discover</span>
          </nav>
          <p class="discover-eyebrow">{pageCopy.eyebrow}</p>
          <h1>{pageCopy.heading}</h1>
          <p>{pageCopy.intro}</p>
        </div>
        <div class="discover-live-panel" aria-hidden="true">
          <div class="discover-phone-frame">
            <div class="discover-phone-top"></div>
            <div class="discover-phone-card discover-phone-card-primary"></div>
            <div class="discover-phone-card"></div>
            <div class="discover-phone-card discover-phone-card-compact"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="discover-shell discover-workbench" aria-label="Discover feed">
      <div class="discover-filter-bar">
        <div class="discover-filter-row" role="group" aria-label="Discover filters">
          {primaryFilters.map((filter) => (
            <button
              class="discover-filter"
              type="button"
              data-filter={filter.value}
              aria-pressed={filter.value === 'all' ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))}
          <button class="discover-filter discover-filter-extra" type="button" data-extra-filter hidden aria-pressed="false"></button>
          <div class="discover-more">
            <button
              class="discover-more-button"
              type="button"
              data-more-toggle
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label={pageCopy.more}
            >
              <span aria-hidden="true">+</span>
            </button>
            <div class="discover-more-menu" data-more-menu role="menu" hidden></div>
          </div>
        </div>
        <p class="discover-result-summary" data-result-summary aria-live="polite"></p>
      </div>

      <div class="discover-status" data-status hidden>
        <h2 data-status-title></h2>
        <p data-status-body></p>
        <button class="discover-status-action" type="button" data-status-retry hidden>{pageCopy.retry}</button>
      </div>

      <div class="discover-skeleton" data-skeleton aria-label={pageCopy.loading}>
        <div class="discover-skeleton-card discover-skeleton-feature"></div>
        <div class="discover-skeleton-card"></div>
        <div class="discover-skeleton-card"></div>
      </div>

      <div class="discover-feed" data-feed></div>

      <div class="discover-pagination" data-pagination hidden>
        <button class="discover-load-more" type="button" data-load-more>{pageCopy.loadMore}</button>
      </div>
    </section>

    <section class="discover-shell discover-download">
      <div>
        <h2>{pageCopy.appTitle}</h2>
        <p>{pageCopy.appBody}</p>
      </div>
      <div class="discover-store-row">
        <a class="discover-store-button" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" aria-label={pageCopy.appStoreAlt}>
          <img src="/appStore.png" alt={pageCopy.appStoreAlt} />
        </a>
        <a class="discover-store-button" href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" aria-label={pageCopy.googlePlayAlt}>
          <img src="/pocket-genes/google-play-badge.png" alt={pageCopy.googlePlayAlt} />
        </a>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

