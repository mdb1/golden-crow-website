const primaryFilters = [
  { value: 'all', label: pageCopy.all },
  { value: 'upcoming_event', label: pageCopy.events },
  { value: 'news', label: pageCopy.news },
  { value: 'research_update', label: pageCopy.research },
  { value: 'opportunity', label: pageCopy.opportunities },
