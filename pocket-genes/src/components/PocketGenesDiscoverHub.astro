  function buildMoreMenu() {
    if (!moreMenu) return;
    moreMenu.replaceChildren(
      ...extraTypes.map((type) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.role = 'menuitem';
        button.dataset.moreFilter = type;
        button.textContent = typeLabels[type] ?? humanize(type);
        return button;
      })
    );
  }

  function bindFilters() {
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => setFilter(button.dataset.filter || 'all'));
    });
    moreToggle?.addEventListener('click', () => {
      const isOpen = moreMenu && !moreMenu.hidden;
      setMoreMenuOpen(!isOpen);
    });
    moreMenu?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-more-filter]');
      if (!button) return;
      setFilter(button.dataset.moreFilter || 'all');
      setMoreMenuOpen(false);
    });
    loadMoreButton?.addEventListener('click', () => loadNextPage());
    statusRetry?.addEventListener('click', () => loadInitial());
    document.addEventListener('click', (event) => {
      if (!event.target.closest('.discover-more')) {
        setMoreMenuOpen(false);
      }
    });
  }

  function setMoreMenuOpen(isOpen) {
    if (!moreMenu || !moreToggle) return;
    moreMenu.hidden = !isOpen;
    moreToggle.setAttribute('aria-expanded', String(isOpen));
  }

  function setFilter(filter) {
    if (state.activeFilter === filter || state.loading) return;
    state.activeFilter = filter;
    updateActiveFilters();
    loadInitial();
  }

  async function loadInitial() {
    state.cursor = null;
    state.items = [];
    state.exhausted = false;
    state.requestToken += 1;
    const token = state.requestToken;
    feed?.replaceChildren();
    setStatus(null);
    setSkeleton(true);
    setLoading(true);
    await loadPage(token);
    setSkeleton(false);
    setLoading(false);
  }

  async function loadNextPage() {
    if (state.loading || state.exhausted) return;
    state.requestToken += 1;
    const token = state.requestToken;
    setLoading(true);
    await loadPage(token);
    setLoading(false);
  }

  async function loadPage(token) {
    try {
      const nextItems = [];
      let cursor = state.cursor;
      let exhausted = state.exhausted;
      let attempts = 0;
      while (nextItems.length < PAGE_SIZE && !exhausted && attempts < MAX_FETCH_ATTEMPTS) {
        attempts += 1;
        const page = await fetchRawPage(state.activeFilter, cursor);
        cursor = page.cursor;
        exhausted = page.exhausted;
        nextItems.push(...page.items.filter((item) => itemVisibleForFilter(item, state.activeFilter)));
      }
      if (token !== state.requestToken) return;
      state.cursor = cursor;
      state.exhausted = exhausted;
      state.items = state.items.concat(nextItems);
      renderItems();
    } catch (error) {
      if (token !== state.requestToken) return;
      state.exhausted = true;
      renderItems();
      setStatus('error');
    }
  }

  async function fetchRawPage(filter, cursor) {
    const query = {
      structuredQuery: {
        from: [{ collectionId: 'feed_items' }],
        where: {
          compositeFilter: {
            op: 'AND',
            filters: queryFilters(filter),
          },
        },
        orderBy: [
          { field: { fieldPath: 'publishedAt' }, direction: 'DESCENDING' },
          { field: { fieldPath: '__name__' }, direction: 'DESCENDING' },
        ],
        limit: FETCH_BATCH_SIZE,
      },
    };

    if (cursor?.publishedAt && cursor?.name) {
      query.structuredQuery.startAt = {
        before: false,
        values: [
          { timestampValue: cursor.publishedAt },
          { referenceValue: cursor.name },
        ],
      };
    }

    const url = `https://firestore.googleapis.com/v1/projects/${FIRESTORE_PROJECT_ID}/databases/(default)/documents:runQuery?key=${FIRESTORE_API_KEY}`;
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(query),
    });
    if (!response.ok) {
      throw new Error('Discover query failed');
    }

    const rows = await response.json();
    const documents = rows.map((row) => row.document).filter(Boolean);
    const items = documents.map(normalizeDocument).filter(Boolean);
    const lastDocument = documents.at(-1);
    const lastFields = lastDocument ? parseFirestoreFields(lastDocument.fields ?? {}) : null;
    return {
      items,
      cursor:
        lastDocument && cleanText(lastFields?.publishedAt)
          ? { name: lastDocument.name, publishedAt: cleanText(lastFields.publishedAt) }
          : null,
      exhausted: documents.length < FETCH_BATCH_SIZE,
    };
  }

  function queryFilters(filter) {
    const filters = [
      { fieldFilter: { field: { fieldPath: 'status' }, op: 'EQUAL', value: { stringValue: 'published' } } },
      { fieldFilter: { field: { fieldPath: 'language' }, op: 'EQUAL', value: { stringValue: pageLang } } },
    ];
    if (filter !== 'all') {
      filters.push({
        fieldFilter: { field: { fieldPath: 'type' }, op: 'EQUAL', value: { stringValue: filter } },
      });
    }
    return filters;
  }

  function normalizeDocument(document) {
    const fields = parseFirestoreFields(document.fields ?? {});
    const id = cleanText(fields.id) || document.name.split('/').pop();
    const type = cleanText(fields.type);
    const title = cleanText(fields.title);
    const subtitle = cleanText(fields.subtitle);
    const publisherSnapshot = fields.publisherSnapshot && typeof fields.publisherSnapshot === 'object'
      ? fields.publisherSnapshot
      : {};
    const publisher = cleanText(publisherSnapshot.name);
    const publisherOrganizationId = cleanText(fields.publisherOrganizationId);
    const publisherIndividualId = cleanText(fields.publisherIndividualId);
    const hasSinglePublisher = Boolean(publisherOrganizationId) !== Boolean(publisherIndividualId);
    const payloadKey = payloadKeys[type] ?? type;
    const payload = fields[payloadKey] && typeof fields[payloadKey] === 'object' ? fields[payloadKey] : null;
    const isSupportedType = Object.prototype.hasOwnProperty.call(typeLabels, type);
    const isEvent = type === 'upcoming_event';
    const event = isEvent ? eventData(payload) : null;

    if (
      !id ||
      !type ||
      !title ||
      !subtitle ||
      !publisher ||
      !hasSinglePublisher ||
      cleanText(fields.status) !== 'published' ||
      cleanText(fields.language) !== pageLang ||
      (isSupportedType && !payload) ||
      (isEvent && !event)
    ) {
      return null;
    }

    const mediaUrl = imageSource(fields.imageUrl) || imageSource(fields.imageUploadDataUrl);
    const publisherImage =
      imageSource(publisherSnapshot.imageUrl) || imageSource(publisherSnapshot.imageUploadDataUrl);
    const accents = typeAccents[type] ?? ['#6B40B4', '#2176AE'];

    return {
      id,
      name: document.name,
      type,
      typeLabel: typeLabels[type] ?? humanize(type),
      title,
      subtitle,
      publisher,
      publisherImage,
      mediaUrl,
      publishedAt: cleanText(fields.publishedAt),
      showInDiscoverFeed: fields.showInDiscoverFeed,
      payload: payload ?? {},
      event,
      detailUrl: `${detailPath}?id=${encodeURIComponent(id)}`,
      accent: accents[0],
      accentEnd: accents[1],
      chips: metadataChips(type, payload ?? {}, fields, event),
      footer: footerText(type, fields, event),
    };
  }

  function itemVisibleForFilter(item, filter) {
    if (!item) return false;
    if (filter === 'upcoming_event') {
      return item.type === 'upcoming_event' && Boolean(item.event);
    }
    return item.showInDiscoverFeed !== false;
  }

  function renderItems() {
    const orderedItems = orderedVisibleItems();
    feed?.replaceChildren(...orderedItems.map((item, index) => createCard(item, index === 0)));
    root?.classList.toggle('is-events-filter', state.activeFilter === 'upcoming_event');
    setStatus(orderedItems.length ? null : 'empty');
    renderSummary(orderedItems.length);
    renderPagination();
  }

  function orderedVisibleItems() {
    if (state.activeFilter !== 'upcoming_event') return state.items;
    const today = startOfUtcDay(new Date()).getTime();
    return [...state.items].sort((a, b) => {
      const aTime = a.event?.startDate?.getTime() ?? 0;
      const bTime = b.event?.startDate?.getTime() ?? 0;
      const aFuture = aTime >= today;
      const bFuture = bTime >= today;
      if (aFuture !== bFuture) return aFuture ? -1 : 1;
      return aFuture ? aTime - bTime : bTime - aTime;
    });
  }

  function createCard(item, isFeature) {
    const card = document.createElement('a');
    card.className = `discover-card${isFeature ? ' discover-card-feature' : ''}${item.event ? ' discover-event-card' : ''}`;
    card.href = item.detailUrl;
    card.style.setProperty('--card-accent', item.accent);
    card.style.setProperty('--card-accent-end', item.accentEnd);

    const header = document.createElement('div');
    header.className = 'discover-card-header';
    header.append(createPublisherAvatar(item), createPublisherBlock(item), createTypeBadge(item));

    const media = item.mediaUrl ? createMedia(item) : createVisualFallback(item);
    const text = document.createElement('div');
    text.className = 'discover-card-text';
    if (item.event) {
      text.append(createEventDateTile(item.event));
    }
    const title = document.createElement('h2');
    title.textContent = item.title;
    const subtitle = document.createElement('p');
    subtitle.textContent = item.subtitle;
    text.append(title, subtitle);

    const chips = document.createElement('div');
    chips.className = 'discover-chip-row';
    chips.hidden = item.chips.length === 0;
    chips.replaceChildren(...item.chips.map(createChip));

    const footer = document.createElement('div');
    footer.className = 'discover-card-footer';
    const date = document.createElement('span');
    date.textContent = item.footer || copy.recently;
    const action = document.createElement('span');
    action.className = 'discover-open-action';
    action.textContent = item.event ? copy.openEvent : copy.openNote;
    footer.append(date, action);

    card.append(header, media, text, chips, footer);
    return card;
  }

  function createPublisherAvatar(item) {
    const avatar = document.createElement('span');
    avatar.className = 'discover-avatar';
    if (item.publisherImage) {
      const image = document.createElement('img');
      image.src = item.publisherImage;
      image.alt = '';
      image.loading = 'lazy';
      avatar.append(image);
    } else {
      avatar.textContent = initials(item.publisher);
    }
    return avatar;
  }

  function createPublisherBlock(item) {
    const block = document.createElement('span');
    block.className = 'discover-publisher';
    const support = document.createElement('span');
    support.textContent = copy.publishedBy;
    const name = document.createElement('strong');
    name.textContent = item.publisher;
    block.append(support, name);
    return block;
  }

  function createTypeBadge(item) {
    const badge = document.createElement('span');
    badge.className = 'discover-type-badge';
    badge.textContent = item.typeLabel;
    return badge;
  }

  function createMedia(item) {
    const figure = document.createElement('figure');
    figure.className = 'discover-card-media';
    const image = document.createElement('img');
    image.src = item.mediaUrl;
    image.alt = '';
    image.loading = 'lazy';
    figure.append(image);
    return figure;
  }

  function createVisualFallback(item) {
    const fallback = document.createElement('div');
    fallback.className = 'discover-card-media discover-card-fallback';
    const label = document.createElement('span');
    label.textContent = item.typeLabel;
    fallback.append(label);
    return fallback;
  }

  function createEventDateTile(event) {
    const tile = document.createElement('div');
    tile.className = 'discover-event-date';
    const day = document.createElement('strong');
    day.textContent = String(event.day);
    const month = document.createElement('span');
    month.textContent = event.month;
    tile.append(day, month);
    return tile;
  }

  function createChip(value) {
    const chip = document.createElement('span');
    chip.className = 'discover-chip';
    chip.textContent = value;
    return chip;
  }

  function renderSummary(count) {
    if (!summary) return;
    const filterLabel = state.activeFilter === 'all' ? '' : typeLabels[state.activeFilter] ?? humanize(state.activeFilter);
    summary.textContent = count ? copy.count(count, filterLabel) : '';
  }

  function renderPagination() {
    if (!pagination || !loadMoreButton) return;
    const hasItems = state.items.length > 0;
    pagination.hidden = !hasItems || state.exhausted;
    loadMoreButton.disabled = state.loading;
    loadMoreButton.textContent = state.loading ? copy.loadingMore : copy.loadMore;
  }

  function setLoading(isLoading) {
    state.loading = isLoading;
    root?.classList.toggle('is-loading-more', isLoading && state.items.length > 0);
    renderPagination();
  }

  function setSkeleton(isVisible) {
    if (skeleton) skeleton.hidden = !isVisible;
  }

  function setStatus(kind) {
    if (!statusPanel || !statusTitle || !statusBody) return;
    statusPanel.hidden = !kind;
    if (!kind) return;
    const isError = kind === 'error';
    statusTitle.textContent = isError ? copy.errorTitle : copy.emptyTitle;
    statusBody.textContent = isError ? copy.errorBody : copy.emptyBody;
    if (statusRetry) statusRetry.hidden = !isError;
  }

  function updateActiveFilters() {
    filterButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.filter === state.activeFilter));
    });

    const isExtra = !primaryFilterValues.has(state.activeFilter);
    if (extraFilterButton) {
      extraFilterButton.hidden = !isExtra;
      extraFilterButton.textContent = isExtra ? typeLabels[state.activeFilter] ?? humanize(state.activeFilter) : '';
      extraFilterButton.dataset.filter = isExtra ? state.activeFilter : '';
      extraFilterButton.setAttribute('aria-pressed', String(isExtra));
      extraFilterButton.onclick = isExtra ? () => setFilter(state.activeFilter) : null;
    }
  }

  function metadataChips(type, payload, fields, event) {
    const definitions = metadataDefinitions[type] ?? fallbackMetadataDefinitions(payload);
    return definitions
      .map((definition) => metadataValue(definition, payload, fields, event))
      .filter(Boolean)
      .slice(0, 3);
  }

  function metadataValue(definition, payload, fields, event) {
    if (definition.source === 'root') {
      return formatMetadataValue(fields[definition.key], definition.kind);
    }
    if (definition.source === 'computed') {
      if (definition.key === 'eventDate') return event?.dateLabel || '';
      if (definition.key === 'eventTime') return event?.timeLabel || '';
    }
    return formatMetadataValue(payload?.[definition.key], definition.kind);
  }

  function formatMetadataValue(value, kind) {
    if (kind === 'date') return formatDate(value);
    if (kind === 'duration') return durationSecondsLabel(value);
    if (kind === 'minutes') {
      const minutes = positiveInteger(value);
      return minutes ? (isEnglish ? `${minutes} min` : `${minutes} min`) : '';
    }
    if (kind === 'pages') {
      const pages = positiveInteger(value);
      return pages ? (isEnglish ? `${pages} p.` : `${pages} pág.`) : '';
    }
    if (kind === 'questions') {
      const questions = positiveInteger(value);
      return questions ? (isEnglish ? `${questions} questions` : `${questions} preguntas`) : '';
    }
    if (kind === 'boolean') {
      return typeof value === 'boolean' ? (value ? (isEnglish ? 'Yes' : 'Sí') : 'No') : '';
    }
    if (kind === 'region') return regionLabel(value);
    if (kind === 'regionArray') return uniqueCleanArray(value).map(regionLabel).filter(Boolean).join(', ');
    if (kind === 'array' || Array.isArray(value)) {
      return uniqueCleanArray(value).map(presentToken).join(', ');
    }
    return presentToken(cleanText(value));
  }

  function fallbackMetadataDefinitions(payload) {
    return Object.keys(payload ?? {})
      .filter((key) => !['title', 'subtitle', 'summary', 'body', 'detailBody', 'htmlBody', 'imageUrl', 'sourceUrl', 'sourceButtonText'].includes(key))
      .sort()
      .slice(0, 3)
      .map((key) => ({ key }));
  }

  function footerText(type, fields, event) {
    if (type === 'upcoming_event' && event) return event.dateLabel;
    return formatDate(fields.publishedAt) || copy.recently;
  }

  function eventData(payload) {
    if (!payload || typeof payload !== 'object') return null;
    const startDate = eventDateFromValue(payload.date);
    if (!startDate) return null;
    const multiDayLength = eventMultiDayLength(payload);
    const endDate = multiDayLength > 1 ? addUtcDays(startDate, multiDayLength - 1) : startDate;
    const dateLabel = multiDayLength > 1
      ? `${formatDate(startDate)} - ${formatDate(endDate)}`
      : formatDate(startDate);
    return {
      startDate,
      endDate,
      day: startDate.getUTCDate(),
      month: monthLabel(startDate),
      dateLabel,
      timeLabel: eventTimeLabel(payload),
    };
  }

  function eventDateFromValue(value) {
    if (!value) return null;
    if (value instanceof Date && !Number.isNaN(value.getTime())) {
      return startOfUtcDay(value);
    }
    if (typeof value === 'string') {
      const dateOnly = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (dateOnly) {
        return new Date(Date.UTC(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3])));
      }
      const parsed = new Date(value);
      return Number.isNaN(parsed.getTime()) ? null : startOfUtcDay(parsed);
    }
    return null;
  }

  function eventMultiDayLength(payload) {
    const timeKind = cleanText(payload.timeKind);
    if (!['allDay', 'timeTba', 'regionalTimes'].includes(timeKind)) return 1;
    const length = positiveInteger(payload.multiDayLength);
    return length ? Math.min(length, 365) : 1;
  }

  function eventTimeLabel(payload) {
    const timeKind = cleanText(payload.timeKind);
    if (timeKind === 'allDay') return copy.allDay;
    if (timeKind === 'dateOnly') return copy.dateOnly;
    if (timeKind === 'timeTba') return copy.timeTba;
    if (timeKind === 'timed') {
      const start = cleanText(payload.dailyStartTime);
      const end = cleanText(payload.dailyEndTime);
      if (!/^\d{2}:\d{2}$/.test(start)) return '';
      return /^\d{2}:\d{2}$/.test(end) ? `${start}-${end}` : `${copy.starts} ${start}`;
    }
    if (timeKind === 'regionalTimes') {
      const times = payload.regionalStartTimes && typeof payload.regionalStartTimes === 'object'
        ? Object.values(payload.regionalStartTimes).map(cleanText).filter(Boolean)
        : [];
      return times[0] || '';
    }
    return '';
  }

  function parseFirestoreFields(fields) {
    return Object.fromEntries(
      Object.entries(fields).map(([key, value]) => [key, parseFirestoreValue(value)])
    );
  }

  function parseFirestoreValue(value) {
    if (!value || typeof value !== 'object') return null;
    if ('stringValue' in value) return value.stringValue;
    if ('booleanValue' in value) return Boolean(value.booleanValue);
    if ('integerValue' in value) return Number(value.integerValue);
    if ('doubleValue' in value) return Number(value.doubleValue);
    if ('timestampValue' in value) return value.timestampValue;
    if ('nullValue' in value) return null;
    if ('arrayValue' in value) return (value.arrayValue.values ?? []).map(parseFirestoreValue);
    if ('mapValue' in value) return parseFirestoreFields(value.mapValue.fields ?? {});
    return null;
  }

  function formatDate(value) {
    const date = value instanceof Date ? value : typeof value === 'string' ? new Date(value) : null;
    if (!date || Number.isNaN(date.getTime())) return '';
    return new Intl.DateTimeFormat(locale, {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(date);
  }

  function monthLabel(date) {
    return new Intl.DateTimeFormat(locale, {
      month: 'short',
      timeZone: 'UTC',
    }).format(date);
  }

  function startOfUtcDay(date) {
    return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
  }

  function addUtcDays(date, days) {
    return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() + days));
  }

  function durationSecondsLabel(value) {
    const seconds = positiveInteger(value);
    if (!seconds) return '';
    const minutes = Math.max(1, Math.round(seconds / 60));
    if (minutes < 60) return `${minutes} min`;
    const hours = Math.floor(minutes / 60);
    const remaining = minutes % 60;
    return remaining ? `${hours} h ${remaining} min` : `${hours} h`;
  }

  function positiveInteger(value) {
    const number = typeof value === 'number' ? value : Number(value);
    return Number.isInteger(number) && number > 0 ? number : 0;
  }

  function uniqueCleanArray(value) {
    const values = Array.isArray(value) ? value : cleanText(value) ? [value] : [];
    return [...new Set(values.map(cleanText).filter(Boolean))];
  }

  function regionLabel(value) {
    const text = cleanText(value);
    if (!text) return '';
    const code = text.toUpperCase();
    if (code === 'GLOBAL') return 'Global';
    if (/^[A-Z]{2}$/.test(code)) {
      try {
        return new Intl.DisplayNames([fieldLocale], { type: 'region' }).of(code) || code;
      } catch {
        return code;
      }
    }
    return presentToken(text);
  }

  function presentToken(value) {
    const text = cleanText(value);
    if (!text) return '';
    if (/^[a-z][a-z0-9_]*$/i.test(text) && !/[A-Z]{2,}/.test(text)) {
      return humanize(text);
    }
    return text;
  }

  function humanize(value) {
    return cleanText(value)
      .replace(/([a-z])([A-Z])/g, '$1 $2')
      .replace(/[_-]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/^./, (letter) => letter.toLocaleUpperCase(fieldLocale));
  }

  function imageSource(value) {
    const text = cleanText(value);
    if (!text) return '';
    const lower = text.toLocaleLowerCase('en');
    return lower.startsWith('https://') ||
      lower.startsWith('http://') ||
      lower.startsWith('data:image/') ||
      text.startsWith('/')
      ? text
      : '';
  }

  function initials(value) {
    const words = cleanText(value).split(/\s+/).filter(Boolean);
    return words.slice(0, 2).map((word) => word[0]?.toLocaleUpperCase(fieldLocale)).join('') || 'PG';
  }

  function cleanText(value) {
    return typeof value === 'string' && value.trim() ? value.trim() : '';
  }
</script>

