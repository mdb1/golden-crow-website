      news: 'Noticias',
      research: 'Investigación',
      opportunities: 'Oportunidades',
      more: 'Más tipos',
      loading: 'Cargando Discover',
      loadMore: 'Cargar más',
      retry: 'Reintentar',
      emptyTitle: 'Todavía no hay publicaciones en Discover',
      emptyBody: 'Cuando los publicadores confiables agreguen eventos o notas, van a aparecer acá.',
