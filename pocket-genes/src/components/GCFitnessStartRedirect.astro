---
// `/gc-fitness/start` — the ONE link to put in a bio, a story or an ad.
//
// It renders nothing worth reading: it detects the OS and hands off to the matching store
// immediately, the way `hevy.go.link/download` does. `/gc-fitness/download` stays as the
// human-facing page (screenshots, copy, both badges) — this one is a turnstile.
//
// ## Why a client-side redirect and not a server one
//
// The site is Astro `output: 'static'` deployed to GitHub Pages (`.github/workflows/deploy.yml`).
// There is no server to sniff the user agent on, so the redirect has to run in the page. That
// is also what Adjust does for Hevy: `hevy.go.link/download` 302s to an `app.adjust.com`
// landing page which then sends the browser to `https://apps.apple.com/app/id…`.
//
// ## What #782 got right, and what it got too broad
//
// #782 established — correctly, and it is still true — that on iOS EVERY `apps.apple.com` URL
// answers `301 → itms-appss://`, so there is no https page of the App Store to render inside a
// web view. Measured again while building this page, with an Instagram user agent, for OUR app
// and for Hevy's:
//
//     GET https://apps.apple.com/ar/app/gc-fitness/id6771836254   → 301 itms-appss://…
//     GET https://apps.apple.com/app/id1458862350                 → 301 itms-appss://…
//
// Identical. So whatever makes a store link work from inside Instagram, it is NOT the URL —
// both chains end on the same scheme hand-off.
//
// Where #782 over-generalized is the next step: it concluded that because a WKWebView does not
// hand unknown schemes to the OS *by default*, no in-app browser can ever reach the App Store.
// The host app only has to implement `decidePolicyFor` and call `UIApplication.open()` — and
// Instagram, whose business is App Store install ads, evidently does. The report that Hevy's
// link opens the store from an Instagram web view is direct evidence of it.
//
// This page therefore does the hand-off, and does NOT assume it will succeed. If we are still
// on screen a moment later, the hand-off was swallowed and the escape hatch appears — the same
// one `/download` shows, because that lesson stands for whichever web views really do drop it.
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/gcFitnessPublic';
import { defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as Lang;

const copy = {
  es: {
    title: 'Abriendo GC Fitness…',
    description: 'Te llevamos a la tienda de tu teléfono para descargar GC Fitness.',
    working: 'Abriendo la tienda…',
    // An INVITATION, not a diagnosis. For the Meta web views this card is the first thing on
    // screen and the tap on it is the mechanism, not a consolation prize — so the copy must
    // not open by apologizing for a failure the visitor never saw.
    tapTitle: 'Descargá GC Fitness',
    tapBody: 'Tocá el botón para abrir la tienda.',
    tapCta: 'Abrir la App Store',
    tapCtaAndroid: 'Abrir Google Play',
    // Secondary, and deliberately phrased as a conditional: it only matters if the tap above
    // did nothing, and until then it is noise that competes with the real action.
    escapeHint:
      '¿No se abre? Tocá los ⋯ arriba a la derecha y elegí “Abrir en el navegador”.',
    appStore: 'Descargar en la App Store',
    playStore: 'Disponible en Google Play',
    copyLink: 'Copiar link',
    copied: '¡Link copiado!',
    seeMore: 'Ver la página completa',
  },
  en: {
    title: 'Opening GC Fitness…',
    description: "Taking you to your phone's store to download GC Fitness.",
    working: 'Opening the store…',
    tapTitle: 'Get GC Fitness',
    tapBody: 'Tap the button to open the store.',
    tapCta: 'Open the App Store',
    tapCtaAndroid: 'Open Google Play',
    escapeHint: 'Nothing happens? Tap the ⋯ at the top right and choose “Open in browser”.',
    appStore: 'Download on the App Store',
    playStore: 'Get it on Google Play',
    copyLink: 'Copy link',
    copied: 'Link copied!',
    seeMore: 'See the full page',
  },
} as const;

const t = copy[lang] ?? copy.es;
const downloadHref = lang === 'en' ? '/en/gc-fitness/download' : '/gc-fitness/download';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <!-- A turnstile has nothing to index, and `/download` is the page that should rank. -->
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://goldencrowvs.com${downloadHref}`} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!--
      Safari's Smart App Banner. Costs one tag and covers the case the redirect cannot: the
      app is ALREADY installed, and the banner offers "Open" instead of a store round trip.
      Ignored everywhere else, including inside web views.
    -->
    <meta name="apple-itunes-app" content="app-id=6771836254" />

    <!--
      In <head>, BEFORE the body paints. Every millisecond here is a millisecond of blank
      turnstile the visitor has to look at.
    -->
    <script is:inline define:vars={{ APP_STORE_URL, PLAY_STORE_URL, downloadHref }}>
      (() => {
        const ua = navigator.userAgent || '';

        // Twin of the detection in `GCFitnessDownloadPage.astro` — keep the two in step.
        // iPadOS 13+ reports "Macintosh"; `maxTouchPoints` is what gives it away (0 on a
        // desktop Mac, 5 on an iPad). Do NOT go back to `typeof document.ontouchend`: that
        // exists in touchless environments and called every Mac an iPad.
        const isIOS =
          /iPhone|iPad|iPod/i.test(ua) ||
          (/Macintosh/i.test(ua) && (navigator.maxTouchPoints || 0) > 1);
        const isAndroid = /Android/i.test(ua);

        // Stamped before the body paints so the card never flashes the wrong store's badge.
        document.documentElement.setAttribute(
          'data-gcf-os',
          isIOS ? 'ios' : isAndroid ? 'android' : 'desktop',
        );

        // Desktop has no store app to hand off to, so send it to the real page instead of
        // dropping someone on an Argentine storefront they cannot install from.
        if (!isIOS && !isAndroid) {
          window.location.replace(downloadHref);
          return;
        }

        // ── The Meta web views, and why they get NO redirect at all ─────────────────────
        //
        // MEASURED ON A REAL PHONE, which is the only way this was ever going to be
        // settled. Same URL, same iOS build, two host apps:
        //
        //   WhatsApp  → native "open in App Store?" prompt. Works.
        //   Instagram → WHITE SCREEN. Nothing else.
        //
        // So the difference is the HOST APP, not the platform and not the URL: WhatsApp's
        // web view implements `decidePolicyFor` + `UIApplication.open()` for the store
        // scheme, and Instagram's does not. #782 was right about Instagram all along; the
        // earlier reading of the Hevy link (that Instagram must hand the scheme off, since
        // Hevy's chain ends on the identical `301 → itms-appss://`) was wrong.
        //
        // The white screen is worse than a dead button, and worth understanding: a
        // top-level `location.replace()` makes the web view COMMIT to leaving — it tears
        // down the current document and paints nothing — and only then does the scheme
        // navigation fail. There is no "it didn't work, carry on" state to recover from,
        // and the safety net below cannot save it either: `pagehide` has already fired by
        // then, and the timer dies with the document.
        //
        // The only fix is therefore to NOT START the navigation here.
        //
        // ── And what these visitors get INSTEAD is the real mechanism, not a consolation ──
        //
        // Instagram blocks the PROGRAMMATIC navigation to the store scheme. It does NOT
        // block a navigation carrying a user gesture. The proof is the page we were asked
        // to copy: `hevy.go.link/download` 302s to an `app.adjust.com` landing page that
        // contains NO automatic redirect at all — no `location.replace`, no meta refresh —
        // just an app icon and an "Open app" button, both plain `<a href="https://…">`.
        // That is why their URL carries `enforce_landing_page=1`. The interstitial is not
        // laziness; it IS the mechanism, and the App Store prompt reported from Instagram
        // was a tap on it.
        //
        // So this branch renders a tap-to-install card whose primary action is an anchor to
        // the store. The "open in browser" hint stays, demoted to a contingency for the case
        // where even the gesture is refused.

        //
        // Scoped to iOS on purpose. On Android the same web views render the Play Store
        // https page perfectly well, so redirecting there is still the better experience.
        const isMetaWebView = /Instagram|FBAN|FBAV|FB_IAB|FBIOS|Messenger|Threads/i.test(ua);
        if (isIOS && isMetaWebView) {
          document.documentElement.setAttribute('data-gcf-stuck', 'true');
          return;
        }

        // `https`, NOT `itms-apps://` / `market://`.
        //
        // In a real browser the scheme would save one 301, but inside a web view that drops
        // it the page dies with nothing rendered — whereas the https URL at least renders the
        // Play Store web page on Android. #782 has the measurements.
        const storeUrl = isIOS ? APP_STORE_URL : PLAY_STORE_URL;

        // `replace`, not `href`: the turnstile must not sit in history, or "back" from the
        // store lands the visitor right back on it and bounces them to the store again.
        window.location.replace(storeUrl);

        // ── Safety net for the web views we have NOT measured ───────────────────────────
        //
        // It cannot rescue the blank-screen case above — by the time a web view commits to
        // the navigation, this document is gone. What it does cover is the milder failure:
        // a host app that CANCELS the navigation without tearing the document down, leaving
        // us alive and visible with a spinner that will never finish.
        //
        // Only `visibilitychange` and `pagehide` count as proof we left. `blur` was tempting
        // as a third signal and is deliberately NOT here: it fires for reasons that have
        // nothing to do with leaving (focus moving, a keyboard dismissing), and a false
        // positive strands someone on that spinner. When in doubt, show the way out.
        let handedOff = false;
        const markHandedOff = () => {
          handedOff = true;
        };
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') markHandedOff();
        });
        window.addEventListener('pagehide', markHandedOff);

        setTimeout(() => {
          if (handedOff || document.visibilityState === 'hidden') return;
          document.documentElement.setAttribute('data-gcf-stuck', 'true');
        }, 1600);
      })();
    </script>

    <noscript>
      <meta http-equiv="refresh" content={`0; url=${downloadHref}`} />
    </noscript>

    <style>
      :root {
        --gcf-amber: #e7b24a;
        --gcf-amber-deep: #a9761a;
        --gcf-ink: #1b1305;
        --gcf-muted: #6b5c3f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: radial-gradient(circle at 50% 0%, #fffaee 0%, #f6efe0 100%);
        color: var(--gcf-ink);
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        text-align: center;
      }

      .gcf-turnstile {
        display: grid;
        gap: 18px;
        justify-items: center;
        max-width: 26rem;
      }

      .gcf-logo {
        width: 84px;
        height: 84px;
        border-radius: 22px;
        box-shadow: 0 12px 32px rgba(27, 19, 5, 0.18);
      }

      .gcf-spinner {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 3px solid rgba(169, 118, 26, 0.25);
        border-top-color: var(--gcf-amber-deep);
        animation: gcf-spin 0.9s linear infinite;
      }

      @keyframes gcf-spin {
        to {
          transform: rotate(360deg);
        }
      }

      /* Someone who prefers reduced motion gets a static ring, not a strobe. */
      @media (prefers-reduced-motion: reduce) {
        .gcf-spinner {
          animation: none;
        }
      }

      .gcf-working {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--gcf-muted);
      }

      /* The escape hatch is hidden until the redirect proves it did not land. */
      .gcf-stuck {
        display: none;
        gap: 14px;
        justify-items: center;
      }

      :root[data-gcf-stuck='true'] .gcf-working,
      :root[data-gcf-stuck='true'] .gcf-spinner {
        display: none;
      }

      :root[data-gcf-stuck='true'] .gcf-stuck {
        display: grid;
      }

      .gcf-stuck h1 {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.3;
      }

      .gcf-stuck p {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--gcf-muted);
      }

      /* The primary tap target. Sized like a native CTA because in a Meta web view it IS the
         mechanism — everything else on this card is a contingency. */
      .gcf-cta {
        display: inline-block;
        background: var(--gcf-amber-deep);
        color: #fff;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        padding: 16px 32px;
        border-radius: 999px;
        box-shadow: 0 10px 24px rgba(169, 118, 26, 0.32);
      }

      .gcf-badges {
        display: grid;
        gap: 10px;
        justify-items: center;
      }

      .gcf-badges img {
        height: 52px;
        width: auto;
      }

      /* Show only the badge for the OS we are on — offering an iPhone owner a Play badge is
         noise next to the one button that matters. `data-gcf-os` is stamped in <head>. */
      :root[data-gcf-os='ios'] .gcf-badges a:last-child,
      :root[data-gcf-os='android'] .gcf-badges a:first-child {
        display: none;
      }

      :root[data-gcf-os='android'] [data-gcf-cta-ios] {
        display: none;
      }

      :root[data-gcf-os='android'] [data-gcf-cta-android] {
        display: inline;
      }

      .gcf-escape {
        font-size: 0.85rem;
        color: var(--gcf-muted);
        max-width: 22rem;
      }

      .gcf-copy {
        appearance: none;
        border: 1px solid rgba(169, 118, 26, 0.45);
        background: rgba(255, 255, 255, 0.9);
        color: var(--gcf-ink);
        font: inherit;
        font-weight: 600;
        padding: 10px 22px;
        border-radius: 999px;
        cursor: pointer;
      }

      .gcf-more {
        font-size: 0.9rem;
        color: var(--gcf-amber-deep);
      }
    </style>
  </head>

  <body>
    <main class="gcf-turnstile">
      <!--
        The icon is a LINK, not decoration — copied from Adjust, and for their reason: it is
        the biggest tap target on the screen, and in a Meta web view a tap is the only thing
        that reaches the store at all.
      -->
      <a class="gcf-logo-link" href={APP_STORE_URL} data-gcf-store-link rel="noopener">
        <img class="gcf-logo" src="/gc-fitness/icon.png" alt="GC Fitness" width="256" height="256" />
      </a>

      <div class="gcf-spinner" role="status" aria-label={t.working}></div>
      <p class="gcf-working">{t.working}</p>

      <div class="gcf-stuck">
        <h1>{t.tapTitle}</h1>
        <p>{t.tapBody}</p>

        <!--
          PRIMARY action. An `<a>` and never a scripted navigation: the whole point of this
          branch is that the store hand-off must carry a user gesture.
        -->
        <a class="gcf-cta" href={APP_STORE_URL} data-gcf-store-link rel="noopener">
          <span data-gcf-cta-ios>{t.tapCta}</span>
          <span data-gcf-cta-android hidden>{t.tapCtaAndroid}</span>
        </a>

        <div class="gcf-badges">
          <a href={APP_STORE_URL} data-gcf-store-link rel="noopener">
            <img src="/gc-fitness/app-store-badge.svg" alt={t.appStore} height="52" width="156" />
          </a>
          <a href={PLAY_STORE_URL} rel="noopener">
            <img src="/gc-fitness/google-play-badge.png" alt={t.playStore} height="52" width="175" />
          </a>
        </div>

        <!-- Secondary. Only matters if the tap above did nothing, so it reads that way. -->
        <p class="gcf-escape">{t.escapeHint}</p>

        <button class="gcf-copy" id="gcf-copy" type="button" data-copied={t.copied}>
          {t.copyLink}
        </button>

        <a class="gcf-more" href={downloadHref}>{t.seeMore}</a>
      </div>
    </main>

    <script is:inline define:vars={{ PLAY_STORE_URL }}>
      // On Android every store link on the card points at Play. The markup is authored once
      // with the App Store URL and rewritten here rather than duplicated per platform, so a
      // future URL change has exactly one place to be wrong.
      (() => {
        if (document.documentElement.getAttribute('data-gcf-os') !== 'android') return;
        document.querySelectorAll('[data-gcf-store-link]').forEach((link) => {
          link.setAttribute('href', PLAY_STORE_URL);
        });
      })();

      // Copy-the-link, for the web views where "Open in browser" is buried. Same shape as the
      // one on `/download`: `navigator.clipboard` is missing in plenty of web views, so the
      // off-screen textarea + `execCommand` fallback is not optional.
      (() => {
        const button = document.getElementById('gcf-copy');
        if (!button) return;

        const original = button.textContent;
        const copied = button.dataset.copied || original;

        button.addEventListener('click', async () => {
          // THIS page's URL, not `/download`.
          //
          // The instruction right above the button is "paste it into Safari", and in Safari
          // this page does exactly what it was built to do: hand off to the store with no
          // further taps. Copying `/download` instead would land them on a page where they
          // still have to find and press a badge — trading one tap for another for no
          // reason. It is also the right thing to hand to someone else.
          const link = window.location.href;

          try {
            await navigator.clipboard.writeText(link);
          } catch {
            const field = document.createElement('textarea');
            field.value = link;
            field.setAttribute('readonly', '');
            field.style.position = 'absolute';
            field.style.left = '-9999px';
            document.body.appendChild(field);
            field.select();
            try {
              document.execCommand('copy');
            } catch {
              /* Nothing left to try — leave the button label alone. */
              document.body.removeChild(field);
              return;
            }
            document.body.removeChild(field);
          }

          button.textContent = copied;
          setTimeout(() => {
            button.textContent = original;
          }, 2000);
        });
      })();
    </script>
  </body>
</html>
