---
import { defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { escapeHtml, formatBrandText } from '../utils/brandFormatting';

interface Props {
  context?: string;
  eventTitle?: string;
  brandName?: string;
  emphasizeBrandName?: boolean;
  logoSrc?: string;
}

const lang = (Astro.currentLocale || defaultLang) as Lang;
const isEnglish = lang === 'en';
const {
  context = 'general',
  eventTitle = isEnglish ? 'Consultation Call' : 'Llamada de Consultoría',
  brandName = 'Golden Crow Venture Studio',
  emphasizeBrandName = true,
  logoSrc = '/logo1024.webp',
} = Astro.props;
const sdkUrl =
  import.meta.env.PUBLIC_GOLDENCROW_SDK_URL || 'https://golden-crow-sdk.vercel.app';

const baseCopy = isEnglish
  ? {
      locale: 'en',
      localeTag: 'en-US',
      brandName,
      eventTitle,
      duration: '30 min',
      logoAlt: `${brandName} logo`,
      calendarTitle: 'Select Date & Time',
      detailsTitle: 'Enter details',
      successTitle: 'Meeting requested',
      successBody:
        'Thanks. We received your request and will contact you to confirm the meeting details.',
      backLabel: 'Back',
      previousMonth: 'Previous month',
      nextMonth: 'Next month',
      timeZoneTitle: 'Time zone',
      timeZoneLabel: 'GMT-03:00 America/Buenos_Aires (GMT-3)',
      selectTimeLabel: 'Available times',
      selectedDateFallback: 'Select a date',
      loadingTimes: 'Checking availability…',
      noTimes: 'No times are available this month. Try another month.',
      availabilityError: 'We could not load available times.',
      retry: 'Try again',
      slotTaken: 'That time was just booked. Please choose another.',
      submitLabel: 'Schedule meeting',
      submittingLabel: 'Scheduling...',
      errorMessage: 'We could not schedule the meeting. Please try again.',
      fullNameLabel: 'Full name *',
      fullNamePlaceholder: 'Full name',
      emailLabel: 'Email *',
      emailPlaceholder: 'Email',
      whatsappLabel: 'WhatsApp number *',
      whatsappPlaceholder: 'We will send meeting information here',
      companyLabel: 'Company name *',
      companyPlaceholder: 'Company name',
      companyRequired: true,
    }
  : {
      locale: 'es',
      localeTag: 'es-AR',
      brandName,
      eventTitle,
      duration: '30 min',
      logoAlt: `${brandName} logo`,
      calendarTitle: 'Seleccioná fecha y hora',
      detailsTitle: 'Ingresá tus datos',
      successTitle: 'Reunión solicitada',
      successBody:
        'Gracias. Recibimos tu solicitud y te vamos a contactar para confirmar los detalles de la reunión.',
      backLabel: 'Volver',
      previousMonth: 'Mes anterior',
      nextMonth: 'Mes siguiente',
      timeZoneTitle: 'Zona horaria',
      timeZoneLabel: 'GMT-03:00 America/Buenos_Aires (GMT-3)',
      selectTimeLabel: 'Horarios disponibles',
      selectedDateFallback: 'Seleccioná una fecha',
      loadingTimes: 'Buscando horarios disponibles…',
      noTimes: 'No hay horarios disponibles este mes. Probá con otro mes.',
      availabilityError: 'No pudimos cargar los horarios disponibles.',
      retry: 'Reintentar',
      slotTaken: 'Ese horario ya fue reservado. Elegí otro, por favor.',
      submitLabel: 'Agendar reunión',
      submittingLabel: 'Agendando...',
      errorMessage: 'No pudimos agendar la reunión. Intentá nuevamente.',
      fullNameLabel: 'Nombre completo *',
      fullNamePlaceholder: 'Nombre completo',
      emailLabel: 'Email *',
      emailPlaceholder: 'Email',
      whatsappLabel: 'Número de WhatsApp *',
      whatsappPlaceholder: 'Vamos a enviarte la información por acá',
      companyLabel: 'Nombre de la empresa *',
      companyPlaceholder: 'Nombre de la empresa',
      companyRequired: true,
    };

const isPocketGenesJoinUs = context === 'pocket-genes-join-us';
const isPocketGenesSupport = context === 'pocket-genes-support';
const joinCopy =
  !isEnglish && isPocketGenesJoinUs
    ? {
        ...baseCopy,
        duration: '30 minutos',
        logoAlt: 'Logo de Pocket Genes',
        calendarTitle: 'Seleccioná fecha y hora',
        detailsTitle: 'Dejanos tus datos',
        successTitle: 'Recibimos tu solicitud',
        successBody:
          'Gracias por tu interés en sumarte a Pocket Genes. Te vamos a contactar para confirmar el horario y los detalles de la reunión.',
        timeZoneTitle: 'Zona horaria',
        selectedDateFallback: 'Seleccioná una fecha',
        submitLabel: 'Solicitar reunión',
        submittingLabel: 'Enviando solicitud...',
        errorMessage: 'No pudimos enviar tu solicitud. Intentá nuevamente.',
        fullNameLabel: 'Nombre completo',
        fullNamePlaceholder: 'Tu nombre y apellido',
        emailLabel: 'Correo electrónico',
        emailPlaceholder: 'Tu correo electrónico',
        whatsappLabel: 'Número de WhatsApp',
        whatsappPlaceholder: 'Tu número con código de país',
        companyLabel: 'Organización o institución (opcional)',
        companyPlaceholder: 'Nombre de la organización, si corresponde',
        companyRequired: false,
      }
    : baseCopy;
const copy = isPocketGenesSupport
  ? {
      ...joinCopy,
      ...(isEnglish
        ? {
            detailsTitle: 'Your details',
            successTitle: 'Thanks for booking!',
            successBody: 'Your time is reserved. We’ll email you the meeting details.',
            submitLabel: 'Book meeting',
            submittingLabel: 'Booking…',
            fullNameLabel: 'Full name',
            fullNamePlaceholder: 'Your first and last name',
            emailLabel: 'Email address',
            emailPlaceholder: 'Your email address',
            whatsappLabel: 'WhatsApp number',
            whatsappPlaceholder: 'Your number including country code',
            companyLabel: 'Organization or institution (optional)',
            companyPlaceholder: 'Organization name, if applicable',
          }
        : {
            duration: '30 minutos',
            logoAlt: 'Logo de Pocket Genes',
            detailsTitle: 'Dejanos tus datos',
            successTitle: '¡Gracias por reservar!',
            successBody: 'Tu horario está reservado. Te vamos a enviar por correo los detalles de la reunión.',
            submitLabel: 'Reservar reunión',
            submittingLabel: 'Reservando…',
            fullNameLabel: 'Nombre completo',
            fullNamePlaceholder: 'Tu nombre y apellido',
            emailLabel: 'Correo electrónico',
            emailPlaceholder: 'Tu correo electrónico',
            whatsappLabel: 'Número de WhatsApp',
            whatsappPlaceholder: 'Tu número con código de país',
            companyLabel: 'Organización o institución (opcional)',
            companyPlaceholder: 'Nombre de la organización, si corresponde',
          }),
      companyRequired: false,
    }
  : joinCopy;
const supportReasons = [
  { value: 'account_access', label: isEnglish ? 'Account access' : 'Acceso a la cuenta' },
  { value: 'publishing', label: isEnglish ? 'Publishing and content' : 'Publicaciones y contenido' },
  { value: 'app_configuration', label: isEnglish ? 'App setup and configuration' : 'Configuración de la app' },
  { value: 'services_and_transactions', label: isEnglish ? 'Services and transactions' : 'Servicios y transacciones' },
  { value: 'billing', label: isEnglish ? 'Billing' : 'Facturación' },
  { value: 'technical_issue', label: isEnglish ? 'Technical issue' : 'Problema técnico' },
  { value: 'other', label: isEnglish ? 'Other' : 'Otro' },
];

const weekdayLabels = isEnglish
  ? ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
  : ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
const renderedBrandName = emphasizeBrandName ? formatBrandText(copy.brandName) : escapeHtml(copy.brandName);
---

<div
  class="client-booking-widget"
  data-client-booking-widget
  data-context={context}
  data-sdk-url={sdkUrl}
  data-copy={JSON.stringify(copy)}
  data-weekdays={JSON.stringify(weekdayLabels)}
>
  <article class="booking-shell">
    <aside class="booking-summary">
      <img class="booking-logo" src={logoSrc} alt={copy.logoAlt} width="78" height="78" />
      <p class="booking-brand" set:html={renderedBrandName} />
      <h3>{copy.eventTitle}</h3>
      <div class="booking-meta">
        <span class="booking-meta-row">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          {copy.duration}
        </span>
        <span class="booking-meta-row" data-summary-date-row>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="5" width="16" height="15" rx="2"></rect>
            <path d="M8 3v4M16 3v4M4 10h16"></path>
          </svg>
          <span data-summary-date>{copy.selectedDateFallback}</span>
        </span>
        <span class="booking-meta-row" data-summary-time-row hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"></path>
            <path d="M12 7v5l4 2"></path>
          </svg>
          <span data-summary-time></span>
        </span>
        <span class="booking-meta-row">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9S14.5 18.4 12 21M12 3c-2.5 2.6-3.7 5.6-3.7 9s1.2 6.4 3.7 9"></path>
          </svg>
          America/Buenos_Aires (GMT-3)
        </span>
      </div>
    </aside>

    <section class="booking-main">
      <button class="booking-back" type="button" data-booking-back aria-label={copy.backLabel} hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
      </button>

      <div class="booking-panel is-active" data-booking-panel="calendar">
        <h3 tabindex="-1">{copy.calendarTitle}</h3>
        <div class="booking-calendar-layout">
          <div class="booking-calendar-area">
            <div class="booking-month-row">
              <button type="button" data-prev-month aria-label={copy.previousMonth}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </button>
              <strong data-month-label aria-live="polite"></strong>
              <button type="button" data-next-month aria-label={copy.nextMonth}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            </div>
            <div class="booking-weekdays">
              {weekdayLabels.map((weekday) => <span>{weekday}</span>)}
            </div>
            <div class="booking-days" data-days-grid></div>
            <div class="booking-timezone">
              <strong>{copy.timeZoneTitle}</strong>
              <span>{copy.timeZoneLabel}</span>
            </div>
          </div>
          <div class="booking-time-area">
            <p class="booking-availability-status" data-availability-status role="status">{copy.loadingTimes}</p>
            <button class="booking-retry" type="button" data-availability-retry hidden>{copy.retry}</button>
            <div class="booking-times" role="group" aria-label={copy.selectTimeLabel} data-times-list></div>
          </div>
        </div>
      </div>

      <div class="booking-panel" data-booking-panel="form" hidden>
        <h3 tabindex="-1">{copy.detailsTitle}</h3>
        <form class="booking-form" data-booking-form>
          {isPocketGenesSupport && (
            <label>
              <span>{isEnglish ? 'Reason' : 'Motivo'}</span>
              <select name="reason" required>
                <option value="">{isEnglish ? 'Select a reason' : 'Seleccioná un motivo'}</option>
                {supportReasons.map(({ value, label }) => <option value={value}>{label}</option>)}
              </select>
            </label>
          )}
          <label>
            <span>{copy.fullNameLabel}</span>
            <input name="fullName" type="text" autocomplete="name" maxlength="120" placeholder={copy.fullNamePlaceholder} required />
          </label>
          <label>
            <span>{copy.emailLabel}</span>
            <input name="email" type="email" autocomplete="email" maxlength="180" placeholder={copy.emailPlaceholder} required />
          </label>
          <label>
            <span>{copy.whatsappLabel}</span>
            <input name="whatsapp" type="tel" autocomplete="tel" minlength="5" maxlength="50" placeholder={copy.whatsappPlaceholder} required />
          </label>
          <label>
            <span>{copy.companyLabel}</span>
            <input name="companyName" type="text" autocomplete="organization" maxlength="160" placeholder={copy.companyPlaceholder} required={copy.companyRequired} />
          </label>
          <p class="booking-error" data-booking-error role="alert" hidden>{copy.errorMessage}</p>
          <div class="booking-submit-row">
            <button type="submit" data-booking-submit>{copy.submitLabel}</button>
          </div>
        </form>
      </div>

      <div class="booking-panel booking-success-panel" data-booking-panel="success" hidden>
        {isPocketGenesSupport && <span class="booking-success-burst" aria-hidden="true"></span>}
        <div class="booking-success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>
        <h3 tabindex="-1">{copy.successTitle}</h3>
        <p>{copy.successBody}</p>
        <div class="booking-success-details">
          <span>{copy.duration}</span>
          <span data-success-date></span>
          <span data-success-time></span>
          {isPocketGenesSupport && <span data-success-reason></span>}
          <span>{copy.timeZoneLabel}</span>
        </div>
      </div>
    </section>
  </article>
</div>

<script>
  const BOOKING_TIMEZONE = 'America/Argentina/Buenos_Aires';
  const BOOKING_DURATION_MINUTES = 30;
  const SUPPORT_CONTEXT = 'pocket-genes-support';

  type BookingStep = 'calendar' | 'form' | 'success';
  type Availability = Record<string, string[]>;

  function utcDate(year: number, monthIndex: number, day: number) {
    return new Date(Date.UTC(year, monthIndex, day, 12));
  }

  function buenosAiresToday() {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: BOOKING_TIMEZONE,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const byType = Object.fromEntries(parts.map(({ type, value }) => [type, Number(value)]));
    return utcDate(byType.year, byType.month - 1, byType.day);
  }

  function dateKey(date: Date) {
    return date.toISOString().slice(0, 10);
  }

  function monthKey(date: Date) {
    return dateKey(date).slice(0, 7);
  }

  function formatMonth(date: Date, localeTag: string) {
    const formatted = new Intl.DateTimeFormat(localeTag, {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(date);
    return formatted.charAt(0).toUpperCase() + formatted.slice(1);
  }

  function formatDate(key: string, localeTag: string) {
    return new Intl.DateTimeFormat(localeTag, {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(`${key}T12:00:00Z`));
  }

  function formatTime(time: string, localeTag: string) {
    return new Intl.DateTimeFormat(localeTag, {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'UTC',
    }).format(new Date(`2000-01-01T${time}:00Z`));
  }

  function addMinutesToTime(time: string, minutesToAdd: number) {
    const [hour, minute] = time.split(':').map(Number);
    const total = hour * 60 + minute + minutesToAdd;
    return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
  }

  function toBuenosAiresIso(dayKey: string, time: string) {
    return new Date(`${dayKey}T${time}:00-03:00`).toISOString();
  }

  function initBookingWidget(root: HTMLElement) {
    if (root.dataset.bookingReady === 'true') return;
    root.dataset.bookingReady = 'true';

    const copy = JSON.parse(root.dataset.copy || '{}');
    const localeTag = copy.localeTag || 'en-US';
    const sdkUrl = (root.dataset.sdkUrl || 'https://golden-crow-sdk.vercel.app').replace(/\/$/, '');
    const context = root.dataset.context || 'general';
    const isSupport = context === SUPPORT_CONTEXT;
    const today = buenosAiresToday();
    let firstDay = utcDate(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate() + 1);
    while (firstDay.getUTCDay() === 0 || firstDay.getUTCDay() === 6) {
      firstDay = utcDate(firstDay.getUTCFullYear(), firstDay.getUTCMonth(), firstDay.getUTCDate() + 1);
    }
    const firstMonth = monthKey(firstDay);
    let viewDate = utcDate(firstDay.getUTCFullYear(), firstDay.getUTCMonth(), 1);
    let selectedDate = '';
    let selectedTime = '';
    let availability: Availability = {};
    let pendingAvailability: AbortController | undefined;

    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-booking-panel]'));
    const backButton = root.querySelector<HTMLButtonElement>('[data-booking-back]');
    const previousButton = root.querySelector<HTMLButtonElement>('[data-prev-month]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-next-month]');
    const monthLabel = root.querySelector<HTMLElement>('[data-month-label]');
    const daysGrid = root.querySelector<HTMLElement>('[data-days-grid]');
    const timesList = root.querySelector<HTMLElement>('[data-times-list]');
    const availabilityStatus = root.querySelector<HTMLElement>('[data-availability-status]');
    const availabilityRetry = root.querySelector<HTMLButtonElement>('[data-availability-retry]');
    const form = root.querySelector<HTMLFormElement>('[data-booking-form]');
    const submitButton = root.querySelector<HTMLButtonElement>('[data-booking-submit]');
    const error = root.querySelector<HTMLElement>('[data-booking-error]');
    const summaryDate = root.querySelector<HTMLElement>('[data-summary-date]');
    const summaryTime = root.querySelector<HTMLElement>('[data-summary-time]');
    const summaryTimeRow = root.querySelector<HTMLElement>('[data-summary-time-row]');
    const successDate = root.querySelector<HTMLElement>('[data-success-date]');
    const successTime = root.querySelector<HTMLElement>('[data-success-time]');
    const successReason = root.querySelector<HTMLElement>('[data-success-reason]');

    function setStep(step: BookingStep, focus = true) {
      root.dataset.step = step;
      for (const panel of panels) {
        const isActive = panel.dataset.bookingPanel === step;
        panel.hidden = !isActive;
        panel.classList.toggle('is-active', isActive);
        if (isActive && focus) panel.querySelector('h3')?.focus();
      }
      if (backButton) backButton.hidden = step === 'calendar';
    }

    function updateSummary(includeTime = false) {
      const dayText = selectedDate ? formatDate(selectedDate, localeTag) : copy.selectedDateFallback;
      const timeText = includeTime && selectedTime
        ? `${formatTime(selectedTime, localeTag)} – ${formatTime(addMinutesToTime(selectedTime, BOOKING_DURATION_MINUTES), localeTag)}`
        : '';
      if (summaryDate) summaryDate.textContent = dayText;
      if (summaryTime) summaryTime.textContent = timeText;
      if (summaryTimeRow) summaryTimeRow.hidden = !timeText;
      if (successDate) successDate.textContent = dayText;
      if (successTime) successTime.textContent = timeText;
    }

    function renderCalendar() {
      if (!daysGrid || !monthLabel) return;
      monthLabel.textContent = formatMonth(viewDate, localeTag);
      if (previousButton) previousButton.disabled = monthKey(viewDate) <= firstMonth;
      daysGrid.replaceChildren();

      const year = viewDate.getUTCFullYear();
      const month = viewDate.getUTCMonth();
      const leadingBlanks = utcDate(year, month, 1).getUTCDay();
      const daysInMonth = utcDate(year, month + 1, 0).getUTCDate();

      for (let index = 0; index < leadingBlanks; index += 1) {
        const blank = document.createElement('span');
        blank.className = 'booking-day is-empty';
        daysGrid.appendChild(blank);
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const key = dateKey(utcDate(year, month, day));
        const available = Boolean(availability[key]?.length);
        const element = document.createElement(available ? 'button' : 'span');
        element.className = 'booking-day';
        element.textContent = String(day);
        if (element instanceof HTMLButtonElement) {
          element.type = 'button';
          element.setAttribute('aria-label', formatDate(key, localeTag));
          element.classList.toggle('is-selected', key === selectedDate);
          element.setAttribute('aria-pressed', String(key === selectedDate));
          element.addEventListener('click', () => {
            selectedDate = key;
            selectedTime = '';
            for (const dateButton of daysGrid.querySelectorAll('button')) {
              const isSelected = dateButton === element;
              dateButton.classList.toggle('is-selected', isSelected);
              dateButton.setAttribute('aria-pressed', String(isSelected));
            }
            updateSummary();
            renderTimes();
          });
        } else {
          element.classList.add('is-disabled');
        }
        daysGrid.appendChild(element);
      }
    }

    function renderTimes() {
      if (!timesList) return;
      timesList.replaceChildren();
      for (const time of availability[selectedDate] ?? []) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'booking-time-button';
        button.textContent = formatTime(time, localeTag);
        button.addEventListener('click', () => {
          selectedTime = time;
          updateSummary(true);
          setStep('form');
        });
        timesList.appendChild(button);
      }
    }

    function showAvailabilityStatus(message = '', allowRetry = false) {
      if (availabilityStatus) {
        availabilityStatus.textContent = message;
        availabilityStatus.hidden = !message;
      }
      if (availabilityRetry) availabilityRetry.hidden = !allowRetry;
    }

    async function loadAvailability(message?: string) {
      pendingAvailability?.abort();
      const controller = new AbortController();
      pendingAvailability = controller;
      const month = monthKey(viewDate);
      availability = {};
      selectedTime = '';
      showAvailabilityStatus(message || copy.loadingTimes);
      renderCalendar();
      renderTimes();

      try {
        const query = new URLSearchParams({ month, context });
        const response = await fetch(`${sdkUrl}/client-bookings/availability?${query}`, {
          credentials: 'omit',
          cache: 'no-store',
          signal: controller.signal,
        });
        if (!response.ok) throw new Error('Availability request failed');
        const result = await response.json() as { month: string; slotsByDate: Availability };
        if (controller.signal.aborted) return;
        if (result.month !== month || !result.slotsByDate) throw new Error('Invalid availability response');

        availability = result.slotsByDate;
        const availableDates = Object.keys(availability).filter((date) => availability[date].length).sort();
        if (!availability[selectedDate]?.length) selectedDate = availableDates[0] || '';
        showAvailabilityStatus(selectedDate ? message : copy.noTimes);
      } catch {
        if (controller.signal.aborted) return;
        availability = {};
        selectedDate = '';
        showAvailabilityStatus(copy.availabilityError, true);
      }

      renderCalendar();
      renderTimes();
      updateSummary();
    }

    function changeMonth(amount: number) {
      const next = utcDate(viewDate.getUTCFullYear(), viewDate.getUTCMonth() + amount, 1);
      if (monthKey(next) < firstMonth) return;
      viewDate = next;
      selectedDate = '';
      updateSummary();
      void loadAvailability();
    }

    previousButton?.addEventListener('click', () => changeMonth(-1));
    nextButton?.addEventListener('click', () => changeMonth(1));
    availabilityRetry?.addEventListener('click', () => { void loadAvailability(); });
    backButton?.addEventListener('click', () => {
      const wasSuccess = root.dataset.step === 'success';
      setStep('calendar');
      updateSummary();
      if (wasSuccess) void loadAvailability();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitButton?.disabled || !form.reportValidity()) return;
      if (!availability[selectedDate]?.includes(selectedTime)) {
        setStep('calendar');
        void loadAvailability(copy.slotTaken);
        return;
      }

      const data = new FormData(form);
      const locale = copy.locale || document.documentElement.lang || 'en';
      const formData = {
        fullName: String(data.get('fullName') || '').trim(),
        email: String(data.get('email') || '').trim(),
        whatsapp: String(data.get('whatsapp') || '').trim(),
        companyName: String(data.get('companyName') || '').trim(),
      };
      const day = selectedDate;
      const startTime = selectedTime;
      const endTime = addMinutesToTime(startTime, BOOKING_DURATION_MINUTES);
      const payload = isSupport
        ? {
            ...formData,
            companyName: formData.companyName || undefined,
            date: day,
            startTime,
            reason: String(data.get('reason') || ''),
            locale,
          }
        : {
            source: {
              context,
              locale,
              pageUrl: window.location.href,
              path: window.location.pathname,
              referrer: document.referrer || undefined,
            },
            event: {
              title: copy.eventTitle,
              durationMinutes: BOOKING_DURATION_MINUTES,
              timezone: BOOKING_TIMEZONE,
              timezoneLabel: copy.timeZoneLabel,
              date: day,
              startTime,
              endTime,
              startsAt: toBuenosAiresIso(day, startTime),
              endsAt: toBuenosAiresIso(day, endTime),
            },
            form: formData,
          };

      if (error) error.hidden = true;
      if (backButton) backButton.disabled = true;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = copy.submittingLabel;
      }

      try {
        const endpoint = isSupport ? 'support-bookings' : 'client-bookings';
        const response = await fetch(`${sdkUrl}/${endpoint}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
          credentials: 'omit',
        });

        if (response.status === 409) {
          setStep('calendar');
          updateSummary();
          void loadAvailability(copy.slotTaken);
          return;
        }
        if (!response.ok) {
          const result = !isSupport && response.status === 502
            ? await response.json().catch(() => null)
            : null;
          if (result?.status !== 'notification_failed' || typeof result.bookingId !== 'string' || !result.bookingId.trim()) {
            throw new Error('Booking request failed');
          }
        }

        if (successReason) {
          successReason.textContent = form.querySelector<HTMLSelectElement>('[name="reason"]')?.selectedOptions[0]?.textContent || '';
        }
        updateSummary(true);
        setStep('success');
        form.reset();
      } catch {
        if (error) error.hidden = false;
      } finally {
        if (backButton) backButton.disabled = false;
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = copy.submitLabel;
        }
      }
    });

    updateSummary();
    setStep('calendar', false);
    void loadAvailability();
  }

  function initBookingWidgets() {
    const widgets = document.querySelectorAll<HTMLElement>('[data-client-booking-widget]');
    if (!('IntersectionObserver' in window)) {
      widgets.forEach(initBookingWidget);
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting || !(target instanceof HTMLElement)) continue;
        observer.unobserve(target);
        initBookingWidget(target);
      }
    }, { rootMargin: '200px' });
    widgets.forEach((widget) => observer.observe(widget));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingWidgets);
  } else {
    initBookingWidgets();
  }
</script>

