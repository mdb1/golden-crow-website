---
import { useTranslations } from '../i18n/index';
import { formatBrandText } from '../utils/brandFormatting';

const t = useTranslations(Astro.currentLocale);
---

<div class="container">
  <div class="first_column">
    <div class="panel first" data-panel-node data-panel-keys="reports" tabindex="0" aria-label={t.panels.healthTitle}>
      <p set:html={formatBrandText(t.panels.imageHealth)} />
    </div>
    <div class="panel second" data-panel-node data-panel-keys="medical-questions" tabindex="0" aria-label={t.panels.medicationTitle}>
      <p set:html={formatBrandText(t.panels.imageAncestry)} />
    </div>
  </div>
  <div class="second_column">
    <div class="panel third" data-panel-node data-panel-keys="genetics-learning" tabindex="0" aria-label={t.panels.nutritionTitle}>
      <p set:html={formatBrandText(t.panels.imageNutrition)} />
    </div>
    <div class="central_panel" data-panel-hub data-panel-keys="reports genetics-learning medical-questions rarefriends provider-directory resources" tabindex="0" aria-label={t.panels.imageCenter}>
      <p set:html={formatBrandText(t.panels.imageCenter)} />
    </div>
    <div class="panel fourth" data-panel-node data-panel-keys="rarefriends" tabindex="0" aria-label={t.panels.ancestryTitle}>
      <p set:html={formatBrandText(t.panels.imageCommunity)} />
    </div>
  </div>
  <div class="third_column">
    <div class="panel fifth" data-panel-node data-panel-keys="provider-directory" tabindex="0" aria-label={t.panels.educationTitle}>
      <p set:html={formatBrandText(t.panels.imageMedication)} />
    </div>
    <div class="panel sixth" data-panel-node data-panel-keys="resources" tabindex="0" aria-label={t.panels.educationTitle}>
      <p set:html={formatBrandText(t.panels.imageEducation)} />
    </div>
  </div>
</div>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: clamp(400px, 40vh, 600px);
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    overflow: visible;
    position: relative;
    isolation: isolate;
  }

  .central_panel {
    z-index: 10;
    position: relative;
    border: 0;
    border-radius: 100%;
    background:
      radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.92) 0 6%, rgba(95, 231, 255, 0.9) 7%, rgba(58, 108, 255, 0.96) 42%, #263bd6 70%, #6726d6 100%);
    color: #fff;
    padding: clamp(2rem, 4vw, 4rem);
    margin: clamp(0.5rem, 1vw, 1rem);
    width: clamp(180px, 18vw, 280px);
    height: clamp(180px, 18vw, 280px);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 1px 18px rgba(255, 255, 255, 0.36),
      inset 0 -28px 48px rgba(26, 31, 135, 0.22),
      0 24px 60px rgba(38, 65, 214, 0.28);
    cursor: pointer;
    transition: transform 0.28s ease, box-shadow 0.28s ease, filter 0.28s ease, opacity 0.28s ease;
  }

  .central_panel::before {
    content: '';
    position: absolute;
    inset: -0.8rem;
    z-index: -1;
    border-radius: inherit;
    background: conic-gradient(from 120deg, rgba(82, 218, 255, 0.18), rgba(124, 88, 255, 0.5), rgba(82, 218, 255, 0.18));
    filter: blur(12px);
    opacity: 0.9;
  }

  .central_panel p {
    position: relative;
    text-align: center;
    font-size: clamp(1.2rem, 2vw, 2.35rem);
    margin: 0;
    line-height: 1.15;
    font-weight: 800;
    white-space: pre-line;
    text-shadow: 0 2px 16px rgba(18, 23, 80, 0.36);
  }

  .first_column {
    display: flex;
    justify-content: center;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 2rem);
  }
  
  .second_column {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .third_column {
    display: flex;
    justify-content: center;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .panel {
    --node-text: #fff;
    --node-gradient: linear-gradient(145deg, #8ee8ff 0%, #4f7cff 52%, #5b35dd 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(110, 203, 255, 0.92) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(80, 128, 255, 0.3);
    --ring-gap: clamp(0.95rem, 1.65vw, 1.65rem);
    --ring-width: clamp(2px, 0.32vw, 4px);
    width: clamp(100px, 12vw, 120px);
    height: clamp(100px, 12vw, 120px);
    z-index: 10;
    position: relative;
    border-radius: 100%;
    margin: clamp(1rem, 3vw, 3rem) clamp(1rem, 2vw, 2rem);
    padding: clamp(0.8rem, 1.5vw, 1.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--node-gradient);
    color: var(--node-text);
    box-shadow:
      inset 0 1px 14px rgba(255, 255, 255, 0.44),
      inset 0 -18px 28px rgba(0, 0, 0, 0.12),
      0 16px 34px var(--glow-color);
    cursor: pointer;
    transition: transform 0.28s ease, box-shadow 0.28s ease, filter 0.28s ease, opacity 0.28s ease;
  }

  .panel::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--ring-gap));
    z-index: -1;
    border-radius: inherit;
    background: var(--ring-gradient);
    filter: drop-shadow(0 0 10px var(--glow-color));
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--ring-width) - 1px),
      #000 calc(100% - var(--ring-width)),
      #000 calc(100% - 1px),
      transparent 100%
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--ring-width) - 1px),
      #000 calc(100% - var(--ring-width)),
      #000 calc(100% - 1px),
      transparent 100%
    );
  }

  .panel::after {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: inherit;
    background: radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.42), transparent 36%);
    pointer-events: none;
  }

  .panel p {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: clamp(0.8rem, 1.2vw, 1.2rem);
    margin: 0;
    line-height: 1.2;
    font-weight: 750;
    white-space: pre-line;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.12);
  }

  .panel:focus-visible,
  .central_panel:focus-visible {
    outline: 3px solid rgba(175, 130, 50, 0.3);
    outline-offset: 8px;
  }

  .panel:hover,
  .panel.is-linked-active {
    transform: translateY(-8px) scale(1.12);
    filter: saturate(1.18) brightness(1.06);
    box-shadow:
      inset 0 1px 16px rgba(255, 255, 255, 0.5),
      inset 0 -18px 28px rgba(0, 0, 0, 0.12),
      0 24px 54px var(--glow-color);
  }

  .panel:hover::before,
  .panel.is-linked-active::before {
    animation: ringSpin 6s linear infinite;
    filter: drop-shadow(0 0 16px var(--glow-color));
  }

  .panel.is-linked-dimmed {
    opacity: 0.36;
    filter: grayscale(0.2) saturate(0.78);
    transform: scale(0.94);
  }

  .central_panel:hover,
  .central_panel.is-linked-active {
    transform: scale(1.06);
    filter: saturate(1.16) brightness(1.04);
    box-shadow:
      inset 0 1px 20px rgba(255, 255, 255, 0.42),
      inset 0 -28px 48px rgba(26, 31, 135, 0.2),
      0 30px 78px rgba(38, 65, 214, 0.36);
  }

  .central_panel.is-linked-dimmed {
    opacity: 0.58;
  }

  @keyframes ringSpin {
    to {
      transform: rotate(1turn);
    }
  }

  .first {
    --node-text: #3c2700;
    --node-gradient: linear-gradient(145deg, #ffe984 0%, #f6c44b 48%, #e0981e 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(255, 215, 85, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(235, 171, 42, 0.34);
  }

  .second {
    --node-gradient: linear-gradient(145deg, #ffacd9 0%, #d56fab 50%, #9f4d96 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(226, 112, 175, 0.94) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(211, 101, 166, 0.32);
  }

  .third {
    --node-gradient: linear-gradient(145deg, #ff9f88 0%, #ff6474 46%, #da3464 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(255, 92, 108, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(239, 82, 100, 0.34);
  }

  .fourth {
    --node-gradient: linear-gradient(145deg, #c2b7ff 0%, #8d72ff 48%, #6844d7 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(139, 115, 255, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(129, 103, 238, 0.34);
  }

  .fourth p {
    font-size: clamp(0.72rem, 1.05vw, 1.05rem);
  }

  .fifth {
    --node-text: #0d361f;
    --node-gradient: linear-gradient(145deg, #d2ff9c 0%, #8ee17a 47%, #39bb7b 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(107, 205, 95, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(82, 183, 105, 0.32);
  }

  .sixth {
    --node-text: #4a2100;
    --node-gradient: linear-gradient(145deg, #ffd58f 0%, #ffab55 46%, #ff773c 100%);
    --ring-gradient: repeating-conic-gradient(from -10deg, rgba(255, 164, 75, 0.98) 0 7deg, transparent 7deg 15deg);
    --glow-color: rgba(255, 145, 65, 0.34);
  }

  /* Extra small devices - smaller than iPhone SE */
  @media (max-width: 375px) {
    .container {
      flex-direction: column;
      min-height: auto;
      max-width: 100%;
      padding: 0.5rem;
      gap: 0.5rem;
    }
    
    .first_column, .second_column, .third_column {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0.2rem;
      flex-wrap: wrap;
    }
    
    .panel {
      width: 60px;
      height: 60px;
      margin: 0.2rem;
      padding: 0.3rem;
      --ring-gap: 0.22rem;
      --ring-width: 1px;
    }
    
    .panel p {
      font-size: 0.5rem;
      line-height: 1;
    }
    
    .central_panel {
      width: 100px;
      height: 100px;
      margin: 0.5rem;
      padding: 0.8rem;
      order: -1;
    }
    
    .central_panel p {
      font-size: 0.9rem;
      line-height: 1;
    }
  }

  /* Mobile devices - iPhone SE and similar small screens */
  @media (max-width: 480px) and (min-width: 376px) {
    .container {
      flex-direction: column;
      min-height: auto;
      max-width: 100%;
      padding: 1rem;
      gap: 1rem;
    }
    
    .first_column, .second_column, .third_column {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    
    .panel {
      width: clamp(70px, 18vw, 90px);
      height: clamp(70px, 18vw, 90px);
      margin: clamp(0.3rem, 1vw, 0.5rem);
      padding: clamp(0.5rem, 1vw, 0.8rem);
      --ring-gap: clamp(0.3rem, 1vw, 0.5rem);
      --ring-width: clamp(1px, 0.3vw, 2px);
    }
    
    .panel p {
      font-size: clamp(0.6rem, 2vw, 0.8rem);
      line-height: 1.1;
    }
    
    .central_panel {
      width: clamp(120px, 30vw, 160px);
      height: clamp(120px, 30vw, 160px);
      margin: clamp(0.5rem, 1vw, 1rem);
      padding: clamp(1rem, 3vw, 2rem);
      order: -1;
    }
    
    .central_panel p {
      font-size: clamp(1rem, 3vw, 1.4rem);
    }
  }

  /* Tablet and medium screens */
  @media (max-width: 768px) and (min-width: 481px) {
    .container {
      max-width: 100%;
      padding: 1rem;
    }
    
    .panel {
      width: clamp(80px, 10vw, 100px);
      height: clamp(80px, 10vw, 100px);
      margin: clamp(0.5rem, 2vw, 1.5rem);
      --ring-gap: clamp(0.5rem, 1vw, 1rem);
      --ring-width: clamp(1px, 0.2vw, 3px);
    }
    
    .panel p {
      font-size: clamp(0.7rem, 1.5vw, 1rem);
    }
    
    .central_panel {
      width: clamp(140px, 16vw, 200px);
      height: clamp(140px, 16vw, 200px);
      padding: clamp(1.5rem, 3vw, 3rem);
    }
    
    .central_panel p {
      font-size: clamp(1.1rem, 2vw, 1.8rem);
    }
  }

  /* Large tablets and small desktops */
  @media (max-width: 1024px) and (min-width: 769px) {
    .container {
      max-width: 700px;
    }
    
    .panel {
      width: clamp(90px, 8vw, 110px);
      height: clamp(90px, 8vw, 110px);
    }
    
    .central_panel {
      width: clamp(160px, 15vw, 240px);
      height: clamp(160px, 15vw, 240px);
    }
  }
</style>
