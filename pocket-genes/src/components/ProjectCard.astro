---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasStoreBadges = Boolean(project.appStoreUrl || project.googlePlayUrl);
const extraLinks = project.links ?? [];

// A card that carries its own links inside cannot itself be an <a> — nested
// anchors are invalid HTML and browsers unnest them, breaking both the outer
// and the inner link. Cards defined the legacy way (a single `websiteUrl`, no
// badges, no extra links) keep the whole surface clickable exactly as before;
// `projects.ts` asserts the two styles are never mixed.
const wholeCardIsLink = Boolean(project.websiteUrl);

// Segunda forma de hacer clickeable la card, para las que SÍ tienen links
// adentro: un ancla estirada por encima de toda la superficie pero por DEBAJO
// de las badges y las píldoras. Tocar la card lleva a la página del producto;
// tocar una badge o una píldora sigue yendo a su destino. Sin anclas anidadas.
const overlayHref = !wholeCardIsLink ? project.pageUrl : undefined;
const isExternal = (href: string) => !href.startsWith('/');
const Tag = wholeCardIsLink ? 'a' : 'div';
const linkProps = wholeCardIsLink
  ? {
      href: project.websiteUrl,
      ...(isExternal(project.websiteUrl!) ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
    }
  : {};
---

<Tag
  class:list={[
    'project-card',
    { 'project-card--clickable': wholeCardIsLink || Boolean(overlayHref) },
  ]}
  {...linkProps}
>
  {overlayHref && (
    <a class="card-overlay-link" href={overlayHref} aria-label={project.title}></a>
  )}
  <div class="card-image">
    <img src={project.image} alt={project.title} loading="lazy" />
  </div>
  <div class="card-body">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="card-tags">
      {project.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    {hasStoreBadges && (
      <div class="card-links">
        {project.appStoreUrl && (
          <a href={project.appStoreUrl} target="_blank" rel="noopener noreferrer" class="store-badge">
            <img src="/appStore.png" alt="App Store" loading="lazy" />
          </a>
        )}
        {project.googlePlayUrl && (
          <a href={project.googlePlayUrl} target="_blank" rel="noopener noreferrer" class="store-badge">
            <img src="/googlePlay.png" alt="Google Play" loading="lazy" />
          </a>
        )}
      </div>
    )}

    {extraLinks.length > 0 && (
      <div class="card-pills">
        {extraLinks.map((link) => (
          <a
            href={link.href}
            class="card-pill"
            {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</Tag>

<style>
  .project-card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: block;
    height: 100%;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--card-shadow-hover);
  }

  /* El ancla estirada va debajo de todo lo clickeable de adentro: la card
     entera navega, pero las badges y las píldoras ganan el click. */
  .card-overlay-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .card-links,
  .card-pills {
    position: relative;
    z-index: 2;
  }

  .card-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: var(--bg-tertiary);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .card-body p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background: rgba(175, 130, 50, 0.08);
    color: var(--brand-color);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--card-border);
  }

  .store-badge img {
    height: 36px;
    width: auto;
  }

  .card-pills {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 0.75rem;
  }

  .card-links + .card-pills {
    border-top: none;
  }

  .card-pill {
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    padding: 0.3rem 0.85rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .card-pill:hover {
    border-color: var(--brand-color);
    background: rgba(175, 130, 50, 0.08);
    color: var(--brand-color);
  }

  a.project-card {
    text-decoration: none;
    color: inherit;
  }

  .project-card--clickable {
    cursor: pointer;
  }
</style>
