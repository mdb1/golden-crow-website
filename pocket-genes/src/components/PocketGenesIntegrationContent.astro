---
import Hero from '../layouts/Hero.astro';
import IntroPlan from '../layouts/IntroPlan.astro';
import Plan from '../layouts/Plan.astro';
import Panels from '../layouts/Panels.astro';
import SecondSection from '../layouts/SecondSection.astro';
import AppScreenshots from '../layouts/AppScreenshots.astro';
import ThirdSection from '../layouts/ThirdSection.astro';
import IntegrationOutcome from '../layouts/IntegrationOutcome.astro';
import ProviderDiscovery from '../layouts/ProviderDiscovery.astro';
import IntegrationJourney from '../layouts/IntegrationJourney.astro';
import TrustBoundaries from '../layouts/TrustBoundaries.astro';
import Experience from '../layouts/Experience.astro';
import { useTranslations } from '../i18n/index';

const t = useTranslations(Astro.currentLocale);
const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const bookingCopy = isEnglish
  ? {
      eyebrow: 'INTEGRATION MEETING',
      titleAccent: 'BRING YOUR REPORTS',
      titleMain: 'INTO POCKET GENES',
    }
  : {
      eyebrow: 'REUNIÓN DE INTEGRACIÓN',
      titleAccent: 'INTEGRÁ TUS INFORMES',
      titleMain: 'A POCKET GENES',
    };
---

<main id="main" class="pocket-genes-page">
  <Hero />
  <ThirdSection />
  <IntegrationOutcome />
  <SecondSection />
  <AppScreenshots />
  <Panels />
  <ProviderDiscovery />
  <IntegrationJourney />
  <IntroPlan />
  <Plan />
  <TrustBoundaries />
  <Experience />

  <section id="booking" class="booking-section">
    <div class="container">
      <div class="booking-content">
        <div class="booking-header">
          <p class="booking-eyebrow">{bookingCopy.eyebrow}</p>
          <h2 class="booking-title">
            <span class="title-accent">{bookingCopy.titleAccent}</span>
            <span class="title-main">{bookingCopy.titleMain}</span>
          </h2>
          <p>{t.pocketGenes.integrationCtaDesc}</p>
        </div>
        <div class="calendar-wrapper">
          <iframe src="https://link.centralize.es/widget/booking/0K86F8BvSkmicNKU6Nyj" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="0K86F8BvSkmicNKU6Nyj_1770156246220"></iframe>
        </div>
      </div>
    </div>
  </section>
</main>

<style is:global>
  :root {
    --brand-color: #AF8232;
    --brand-hover: #8D6928;
    --bg-primary: #f9fafb;
    --bg-secondary: #ffffff;
    --bg-tertiary: #f3f4f6;
    --text-primary: #111827;
    --text-secondary: #4b5563;
    --text-tertiary: #9ca3af;
    --text-accent: #AF8232;
    --card-bg: #ffffff;
    --card-border: #e5e7eb;
    --card-shadow: 0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px -1px rgba(0,0,0,0.1);
    --card-shadow-hover: 0 10px 25px -5px rgba(0,0,0,0.08);
    --dark-bg: var(--bg-primary);
    --dark-surface: var(--bg-secondary);
    --dark-elevated: var(--bg-tertiary);
    --glass-bg: var(--card-bg);
    --glass-border: var(--card-border);
    --glass-shadow: var(--card-shadow);
    --primary-gradient: #D4A94E;
    --secondary-gradient: #e06666;
    --accent-gradient: #c27ba0;
    --success-gradient: #93c47d;
    --warning-gradient: #f6b26b;
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 4rem;
  }

  body {
    font-weight: 400;
  }

  .pocket-genes-page {
    margin-top: clamp(60px, 10vw, 80px);
  }

  .pocket-genes-page .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  @media (min-width: 1400px) {
    .pocket-genes-page .container {
      max-width: 1400px;
    }
  }

  .pocket-genes-page > * {
    border-top: 1px solid rgba(17, 24, 39, 0.06);
  }

  .pocket-genes-page > :first-child {
    border-top: 0;
  }

  .pocket-genes-page > :nth-child(odd) {
    background: var(--bg-secondary) !important;
  }

  .pocket-genes-page > :nth-child(even) {
    background: var(--bg-primary) !important;
  }

  .pocket-genes-page section {
    position: relative;
    overflow: hidden;
  }

  .pocket-genes-page button,
  .pocket-genes-page a {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pocket-genes-page button {
    font-family: inherit;
    cursor: pointer;
  }

  .pocket-genes-page ::selection {
    background: rgba(175, 130, 50, 0.2);
    color: var(--text-primary);
  }

  .pocket-genes-page .booking-section {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background: var(--bg-secondary);
  }

  .pocket-genes-page .booking-content {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .pocket-genes-page .booking-header {
    max-width: 760px;
  }

  .pocket-genes-page .booking-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--brand-color);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pocket-genes-page .booking-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.15rem, 5vw, 4.1rem);
    font-weight: 900;
    line-height: 1.06;
  }

  .pocket-genes-page .booking-title .title-accent,
  .pocket-genes-page .booking-title .title-main {
    display: block;
  }

  .pocket-genes-page .booking-title .title-accent {
    color: var(--text-secondary);
    font-size: 0.58em;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .pocket-genes-page .booking-header p:last-child {
    max-width: 700px;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.65;
  }

  .pocket-genes-page .calendar-wrapper {
    min-height: 600px;
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    background: var(--card-bg);
    padding: clamp(1rem, 3vw, 2rem);
  }

  .pocket-genes-page .calendar-wrapper iframe {
    min-height: 550px;
  }

  @media (max-width: 768px) {
    .pocket-genes-page .booking-section {
      padding: clamp(3rem, 6vw, 4rem) 0;
    }
  }

  @media (max-width: 480px) {
    .pocket-genes-page .booking-section {
      padding: clamp(2.5rem, 6vw, 3.5rem) 0;
    }
  }
</style>
