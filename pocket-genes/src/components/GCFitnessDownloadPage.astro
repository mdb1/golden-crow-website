---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/gcFitnessPublic';
import { defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as Lang;

const copy = {
  es: {
    title: 'Descargar GC Fitness',
    description:
      'Descargá GC Fitness para iPhone y Android. Entrenamientos, hábitos y progreso en una sola app, con coach o por tu cuenta.',
    h1a: 'Descargá',
    h1b: 'GC Fitness',
    lead:
      'Entrenamientos, hábitos y progreso en una sola app. Con coach o por tu cuenta, en iPhone, Android y Apple Watch.',
    chips: [
      'Con coach o por tu cuenta',
      'Registrá cada serie sin fricción',
      'Descansos automáticos',
      'Progreso medido, no estimado',
    ],
    kicker: 'Disponible ahora',
    appStoreAlt: 'Descargar en la App Store',
    playStoreAlt: 'Disponible en Google Play',
    appStoreNote: 'iPhone y Apple Watch',
    playStoreNote: 'Android',
    storeGridLabel: 'Opciones de descarga de GC Fitness',
    legal: 'Privacidad',
    legalHref: '/gc-fitness/privacy',
    terms: 'Términos de uso',
    termsHref: '/gc-fitness/terms',
  },
  en: {
    title: 'Download GC Fitness',
    description:
      'Download GC Fitness for iPhone and Android. Workouts, habits and progress in one app, with a coach or on your own.',
    h1a: 'Download',
    h1b: 'GC Fitness',
    lead:
      'Workouts, habits and progress in one app. With a coach or on your own, on iPhone, Android and Apple Watch.',
    chips: [
      'With a coach or on your own',
      'Log every set, friction-free',
      'Automatic rest timers',
      'Progress measured, not guessed',
    ],
    kicker: 'Available now',
    appStoreAlt: 'Download on the App Store',
    playStoreAlt: 'Get it on Google Play',
    appStoreNote: 'iPhone and Apple Watch',
    playStoreNote: 'Android',
    storeGridLabel: 'GC Fitness download options',
    legal: 'Privacy',
    legalHref: '/en/gc-fitness/privacy',
    terms: 'Terms of Use',
    termsHref: '/en/gc-fitness/terms',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description} showFooter={false}>
  <main id="main" class="gcf-download-page">
    <section class="gcf-hero" aria-labelledby="gcf-download-title">
      <div class="gcf-ambient" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="gcf-shell">
        <div class="gcf-copy">
          <h1 id="gcf-download-title">
            <span>{copy.h1a}</span>
            <span>{copy.h1b}</span>
          </h1>
          <p class="gcf-lead">{copy.lead}</p>

          <ul class="gcf-chips">
            {copy.chips.map((chip) => <li>{chip}</li>)}
          </ul>

          <div class="gcf-store-grid" aria-label={copy.storeGridLabel}>
            <!--
              #782 — SIN `target="_blank"`, y no es un descuido.

              En Safari el tap "no hacía nada". La cadena que se rompe es ésta: `_blank` abre
              una pestaña NUEVA, esa pestaña se come el 301 de
              `apps.apple.com/app/id…` → `apps.apple.com/us/app/gc-fitness/id…`, y RECIÉN
              entonces intenta el handoff a la App Store. Para ese momento el salto a la app
              nativa ya no está dentro del gesto del usuario que lo originó, y Safari lo
              descarta en silencio: ni pestaña visible ni App Store. El usuario ve un botón
              muerto.

              El hermano que sí anda lo confirma: Pocket Genes apunta a la URL canónica
              (`/ar/app/pocket-genes/id…`, sin redirect) con el mismo `_blank`. La diferencia
              entre los dos links es el 301, no el atributo.

              Navegando en la MISMA pestaña el gesto sobrevive al redirect y el handoff ocurre.
              Y se puede dejar la URL corta —que Apple redirige al storefront de cada visitante,
              que es a propósito (ver `gcFitnessPublic.ts`)— en vez de clavar un país.

              No se pierde nada: un link de store es un destino terminal; en móvil te saca del
              sitio igual para abrir la app nativa.
            -->
            <a class="gcf-store-card" href={APP_STORE_URL}>
              <span class="gcf-store-glow" aria-hidden="true"></span>
              <span class="gcf-store-kicker">{copy.kicker}</span>
              <img
                class="gcf-badge gcf-badge-apple"
                src="/gc-fitness/app-store-badge.svg"
                alt={copy.appStoreAlt}
                width="180"
                height="60"
                loading="lazy"
              />
              <span class="gcf-store-note">{copy.appStoreNote}</span>
            </a>

            <!-- Misma navegación que la tarjeta de arriba, para que las dos se comporten
                 igual. En Play el handoff no se rompía (no hay app nativa que abrir desde
                 Safari), pero dejar una con `_blank` y la otra sin él se lee como un olvido. -->
            <a class="gcf-store-card" href={PLAY_STORE_URL}>
              <span class="gcf-store-glow" aria-hidden="true"></span>
              <span class="gcf-store-kicker">{copy.kicker}</span>
              <img
                class="gcf-badge gcf-badge-play"
                src="/gc-fitness/google-play-badge.png"
                alt={copy.playStoreAlt}
                width="194"
                height="75"
                loading="lazy"
              />
              <span class="gcf-store-note">{copy.playStoreNote}</span>
            </a>
          </div>

          <p class="gcf-legal">
            <a href={copy.legalHref}>{copy.legal}</a>
            <span aria-hidden="true"> · </span>
            <a href={copy.termsHref}>{copy.terms}</a>
          </p>
        </div>

        <div class="gcf-visual" aria-hidden="true">
          <div class="gcf-orbit gcf-orbit-one"></div>
          <div class="gcf-orbit gcf-orbit-two"></div>
          <div class="gcf-phone-stage">
            <div class="gcf-phone gcf-phone-left">
              <img src="/gc-fitness/screenshots/logging.webp" alt="" width="560" height="1217" />
            </div>
            <div class="gcf-phone gcf-phone-main">
              <img src="/gc-fitness/screenshots/dashboard.webp" alt="" width="560" height="1217" />
            </div>
            <div class="gcf-phone gcf-phone-right">
              <img src="/gc-fitness/screenshots/progress.webp" alt="" width="560" height="1217" />
            </div>
            <div class="gcf-watch">
              <img src="/gc-fitness/screenshots/watch.webp" alt="" width="374" height="446" />
            </div>
            <img class="gcf-floating-icon" src="/gc-fitness/icon.png" alt="" width="256" height="256" />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .gcf-download-page {
    --gcf-amber: #e7b24a;
    --gcf-amber-deep: #a9761a;
    --gcf-ink: #1b1305;
    --gcf-ink-soft: #4a3a1c;
    --gcf-muted: #6b5c3f;

    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(115deg, rgba(231, 178, 74, 0.18), transparent 36%),
      linear-gradient(245deg, rgba(169, 118, 26, 0.12), transparent 38%),
      linear-gradient(180deg, #fffdf7 0%, #ffffff 46%, #fdf6e6 100%);
    color: var(--gcf-ink);
  }

  .gcf-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(7rem, 12vw, 8.5rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .gcf-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(169, 118, 26, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(169, 118, 26, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 16%, #000 74%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 16%, #000 74%, transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  .gcf-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .gcf-copy {
    position: relative;
    min-width: 0;
  }

  .gcf-copy h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.4rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .gcf-copy h1 span {
    display: block;
    white-space: nowrap;
  }

  .gcf-copy h1 span:last-child {
    color: var(--gcf-amber-deep);
  }

  .gcf-lead {
    max-width: 610px;
    margin: 1.15rem 0 0;
    color: var(--gcf-ink-soft);
    font-size: clamp(1.1rem, 2.1vw, 1.35rem);
    line-height: 1.55;
  }

  .gcf-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .gcf-chips li {
    border: 1px solid rgba(169, 118, 26, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    padding: 7px 14px;
    color: var(--gcf-muted);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .gcf-store-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: clamp(1.4rem, 3vw, 1.9rem);
    min-width: 0;
  }

  .gcf-store-card {
    position: relative;
    isolation: isolate;
    min-height: 186px;
    overflow: hidden;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 14px;
    border: 1px solid rgba(169, 118, 26, 0.24);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(255, 250, 238, 0.88)),
      #ffffff;
    padding: clamp(1.1rem, 3vw, 1.55rem);
    color: var(--gcf-ink);
    text-decoration: none;
    min-width: 0;
    box-shadow: 0 24px 64px rgba(51, 36, 8, 0.12);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .gcf-store-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, transparent 0 34%, rgba(231, 178, 74, 0.2) 48%, transparent 64%);
    transform: translateX(-130%);
    transition: transform 520ms ease;
  }

  .gcf-store-card:hover {
    transform: translateY(-5px);
    border-color: rgba(169, 118, 26, 0.55);
    box-shadow: 0 30px 86px rgba(169, 118, 26, 0.22);
  }

  .gcf-store-card:hover::before {
    transform: translateX(130%);
  }

  .gcf-store-glow {
    position: absolute;
    inset: auto -20% -44% 18%;
    z-index: -1;
    height: 140px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(231, 178, 74, 0.32), transparent 70%);
    filter: blur(18px);
  }

  .gcf-store-kicker {
    margin: 0;
    color: var(--gcf-amber-deep);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gcf-badge {
    display: block;
    width: min(100%, 188px);
    height: auto;
    filter: drop-shadow(0 12px 22px rgba(51, 36, 8, 0.14));
  }

  .gcf-badge-play {
    width: min(100%, 204px);
    margin: -12px 0;
  }

  .gcf-store-note {
    margin: 0;
    color: var(--gcf-muted);
    font-size: 0.95rem;
    font-weight: 760;
  }

  .gcf-legal {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .gcf-legal a {
    color: var(--gcf-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gcf-visual {
    position: relative;
    min-height: 590px;
  }

  .gcf-visual::before {
    content: "";
    position: absolute;
    inset: 11% 0 5%;
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(231, 178, 74, 0.26), transparent 60%),
      radial-gradient(circle at 72% 28%, rgba(169, 118, 26, 0.18), transparent 42%);
    filter: blur(8px);
  }

  .gcf-phone-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .gcf-phone {
    position: absolute;
    width: clamp(150px, 17vw, 220px);
    overflow: hidden;
    border: 6px solid #050505;
    border-radius: 28px;
    background: #050505;
    box-shadow:
      0 32px 74px rgba(51, 36, 8, 0.26),
      0 0 0 1px rgba(255, 255, 255, 0.18);
    animation: gcfPhoneFloat 6.5s ease-in-out infinite;
  }

  .gcf-phone img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gcf-phone-left {
    transform: translate3d(-120px, 38px, -80px) rotate(-10deg);
    opacity: 0.82;
    animation-delay: -1.4s;
  }

  .gcf-phone-main {
    width: clamp(176px, 20vw, 264px);
    transform: translate3d(10px, -10px, 0) rotate(3deg);
    z-index: 2;
  }

  .gcf-phone-right {
    transform: translate3d(142px, 34px, -90px) rotate(11deg);
    opacity: 0.82;
    animation-delay: -2.7s;
  }

  .gcf-watch {
    position: absolute;
    z-index: 5;
    right: 5%;
    top: 5%;
    width: clamp(78px, 9vw, 118px);
    overflow: hidden;
    border: 5px solid #17171a;
    border-radius: 26px;
    background: #050505;
    box-shadow:
      0 22px 46px rgba(51, 36, 8, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.2);
    transform: rotate(-8deg);
    animation: gcfPhoneFloat 7.4s ease-in-out infinite;
    animation-delay: -3.4s;
  }

  .gcf-watch img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gcf-floating-icon {
    position: absolute;
    z-index: 4;
    left: 24%;
    bottom: 0;
    width: clamp(74px, 9vw, 116px);
    height: clamp(74px, 9vw, 116px);
    border-radius: 24px;
    box-shadow:
      0 24px 58px rgba(169, 118, 26, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.72);
    transform: translateX(-50%);
    animation: gcfIconPulse 4.8s ease-in-out infinite;
  }

  .gcf-orbit {
    position: absolute;
    border: 1px solid rgba(169, 118, 26, 0.26);
    border-radius: 999px;
    animation: gcfOrbitDrift 9s ease-in-out infinite;
  }

  .gcf-orbit-one {
    width: 86%;
    height: 58%;
    top: 17%;
    left: 7%;
    transform: rotate(-14deg);
  }

  .gcf-orbit-two {
    width: 64%;
    height: 46%;
    top: 28%;
    left: 19%;
    border-color: rgba(231, 178, 74, 0.34);
    animation-delay: -3.6s;
  }

  .gcf-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .gcf-ambient span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--gcf-amber);
    box-shadow: 0 0 22px rgba(231, 178, 74, 0.6);
    animation: gcfSparkFloat 8s ease-in-out infinite;
  }

  .gcf-ambient span:nth-child(1) {
    top: 17%;
    left: 9%;
  }

  .gcf-ambient span:nth-child(2) {
    top: 22%;
    right: 13%;
    background: var(--gcf-amber-deep);
    animation-delay: -2s;
  }

  .gcf-ambient span:nth-child(3) {
    left: 47%;
    bottom: 15%;
    animation-delay: -4.4s;
  }

  @keyframes gcfPhoneFloat {
    0%,
    100% {
      margin-top: 0;
    }
    50% {
      margin-top: -16px;
    }
  }

  @keyframes gcfIconPulse {
    0%,
    100% {
      transform: translateX(-50%) translateY(0) scale(1);
    }
    50% {
      transform: translateX(-50%) translateY(-10px) scale(1.04);
    }
  }

  @keyframes gcfOrbitDrift {
    0%,
    100% {
      opacity: 0.5;
      transform: rotate(-14deg) scale(1);
    }
    50% {
      opacity: 0.85;
      transform: rotate(-8deg) scale(1.04);
    }
  }

  @keyframes gcfSparkFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 0.48;
    }
    50% {
      transform: translate3d(16px, -20px, 0);
      opacity: 1;
    }
  }

  @media (max-width: 980px) {
    .gcf-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .gcf-visual {
      min-height: 480px;
    }

    .gcf-copy {
      text-align: center;
    }

    .gcf-lead {
      margin-left: auto;
      margin-right: auto;
    }

    .gcf-chips {
      justify-content: center;
    }

    .gcf-store-grid {
      max-width: 620px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 640px) {
    .gcf-hero {
      align-items: flex-start;
      padding-top: 7.5rem;
    }

    .gcf-visual {
      min-height: 380px;
    }

    .gcf-store-grid {
      grid-template-columns: 1fr;
    }

    .gcf-store-card {
      min-height: 180px;
      justify-items: center;
      text-align: center;
    }

    .gcf-phone-left {
      transform: translate3d(-72px, 30px, -80px) rotate(-10deg);
    }

    .gcf-phone-right {
      transform: translate3d(82px, 30px, -90px) rotate(11deg);
    }

    .gcf-watch {
      right: 0;
      top: 2%;
    }
  }

  @media (max-width: 420px) {
    .gcf-copy h1 {
      font-size: clamp(2.35rem, 10.5vw, 2.85rem);
      line-height: 0.95;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gcf-ambient span,
    .gcf-phone,
    .gcf-watch,
    .gcf-floating-icon,
    .gcf-orbit {
      animation: none;
    }

    .gcf-store-card,
    .gcf-store-card::before {
      transition: none;
    }
  }
</style>
