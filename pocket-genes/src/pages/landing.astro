  .orb-2 {
    width: 220px;
    height: 220px;
    background: linear-gradient(135deg, rgba(240, 147, 251, 0.25) 0%, rgba(103, 126, 234, 0.15) 100%);
    bottom: 20%;
    right: 10%;
    animation-delay: -8s;
  }

  .orb-3 {
    width: 160px;
    height: 160px;
    background: linear-gradient(135deg, rgba(79, 172, 254, 0.3) 0%, rgba(240, 147, 251, 0.18) 100%);
    top: 60%;
    left: 70%;
    animation-delay: -15s;
  }

  @keyframes floating {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25% { transform: translateY(-40px) rotate(90deg); }
    50% { transform: translateY(25px) rotate(180deg); }
    75% { transform: translateY(-20px) rotate(270deg); }
