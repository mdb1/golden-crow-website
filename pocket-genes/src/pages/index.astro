---
import BaseLayout from '../layouts/BaseLayout.astro';
import SuccessCarousel from '../components/SuccessCarousel.astro';
import AboutUs from '../layouts/AboutUs.astro';
import TrustedBy from '../components/TrustedBy.astro';
import Challenges from '../components/Challenges.astro';
import FoundersNote from '../components/FoundersNote.astro';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import type { Lang } from '../i18n/ui';
import { defaultLang } from '../i18n/ui';
import { getProjects } from '../data/projects';

const t = useTranslations(Astro.currentLocale);
const lang = (Astro.currentLocale || defaultLang) as Lang;

function localPath(path: string) {
  return getLocalizedPath(path, lang);
}

const projects = getProjects(t);
---

<BaseLayout title={t.index.title} extraHeadScripts={["https://link.centralize.es/js/form_embed.js"]}>
  <main class="home-page">
    <!-- Section 1: Hero -->
    <section class="hero-section">
      <div id="tsparticles"></div>
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            <span class="title-main">{t.index.heroMain}</span>
            <span class="title-accent">{t.index.heroAccent}</span>
          </h1>
          <p class="hero-subtitle">{t.index.heroSubtitle}</p>
          <div class="hero-actions">
            <a href="#booking" class="btn-primary">{t.index.ctaPrimary}</a>
            <a href="#projects" class="btn-secondary">{t.index.ctaSecondary}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted-by strip -->
    <TrustedBy />

    <!-- Challenges (problem-first) -->
    <Challenges />

    <!-- Section 3: Success Stories -->
    <section class="projects-section" id="projects">
      <div class="container">
        <h2>{t.index.projectsTitle}</h2>
        <p class="section-subtitle">{t.index.projectsSubtitle}</p>
        <SuccessCarousel projects={projects} />
      </div>
    </section>

    <!-- Section 4: Why Us -->
    <section class="why-us-section" id="why-us">
      <div class="container">
        <div class="why-us-header">
          <h2>{t.index.statsTitle}</h2>
          <p class="why-us-subtitle">{t.index.statsSubtitle}</p>
        </div>

        <div class="why-us-stats">
          <div class="why-us-stat">
            <span class="why-us-stat-number">{t.index.whyUsYearsStat}</span>
            <span class="why-us-stat-label">{t.index.whyUsYearsLabel}</span>
          </div>
          <div class="why-us-stat">
            <span class="why-us-stat-number">{t.index.whyUsDecadeStat}</span>
            <span class="why-us-stat-label">{t.index.whyUsDecadeLabel}</span>
          </div>
          <div class="why-us-stat">
            <span class="why-us-stat-number">{t.index.whyUsProjectsStat}</span>
            <span class="why-us-stat-label">{t.index.whyUsProjectsLabel}</span>
          </div>
        </div>

        <div class="why-us-content">
          <p class="why-us-body">{t.index.whyUsParagraph2}</p>
          <p class="why-us-accent">{t.index.whyUsParagraph3}</p>
        </div>

        <div class="why-us-closing">
          <p class="why-us-offer">{t.index.whyUsClosing}</p>
        </div>

        <!-- Development Process Timeline -->
        <div class="process-journey">
          <h3 class="process-heading">{t.index.processTitle}</h3>
          <div class="why-us-process">
            <div class="process-step">
              <div class="step-num">01</div>
              <h4 class="step-title">{t.index.discoveryTitle}</h4>
              <p class="step-desc">{t.index.discoveryDesc}</p>
            </div>
            <div class="process-step">
              <div class="step-num">02</div>
              <h4 class="step-title">{t.index.analysisTitle}</h4>
              <p class="step-desc">{t.index.analysisDesc}</p>
            </div>
            <div class="process-step">
              <div class="step-num">03</div>
              <h4 class="step-title">{t.index.designTitle}</h4>
              <p class="step-desc">{t.index.designDesc}</p>
            </div>
            <div class="process-step">
              <div class="step-num">04</div>
              <h4 class="step-title">{t.index.developmentTitle}</h4>
              <p class="step-desc">{t.index.developmentDesc}</p>
            </div>
            <div class="process-step">
              <div class="step-num">05</div>
              <h4 class="step-title">{t.index.testingTitle}</h4>
              <p class="step-desc">{t.index.testingDesc}</p>
            </div>
            <div class="process-step">
              <div class="step-num">06</div>
              <h4 class="step-title">{t.index.launchTitle}</h4>
              <p class="step-desc">{t.index.launchDesc}</p>
            </div>
          </div>

          <a href="#booking" class="btn-primary">{t.index.whyUsCtaButton}</a>
        </div>
      </div>
    </section>

    <!-- Section 5: Team -->
    <section class="team-section" id="team">
      <AboutUs />
    </section>

    <!-- Founder's note -->
    <FoundersNote />

    <!-- Section 6: Contact CTA -->
    <section class="cta-section">
      <div class="container">
        <h2>{t.index.ctaTitle}</h2>
        <p>{t.index.ctaDesc}</p>
        <a href="#booking" class="btn-primary">{t.index.ctaButton}</a>
      </div>
    </section>

    <!-- Section 7: Booking -->
    <section id="booking" class="booking-section">
      <div class="container">
        <div class="booking-content">
          <h2>{t.index.bookingTitle}</h2>
          <p>{t.index.bookingDesc}</p>
          <p class="booking-permission">{t.index.bookingPermission}</p>
          <div class="calendar-wrapper">
            <iframe src="https://link.centralize.es/widget/booking/0K86F8BvSkmicNKU6Nyj" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="0K86F8BvSkmicNKU6Nyj_1770156246220"></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  #tsparticles {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: clamp(600px, 100vh, 1200px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg-primary);
    margin-top: clamp(60px, 10vw, 80px);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  .title-accent {
    display: block;
    color: var(--brand-color);
    font-size: clamp(1.5rem, 4.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.15;
    margin-top: clamp(0.25rem, 1vw, 0.75rem);
    letter-spacing: -0.01em;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--brand-color);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--brand-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(175, 130, 50, 0.3);
  }

  .btn-secondary {
    background: transparent;
    border: 2px solid var(--card-border);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--brand-color);
    color: var(--brand-color);
  }

  /* Projects Section */
  .projects-section {
    padding: clamp(3rem, 8vw, 6rem) 0;
    background: var(--bg-primary);
  }

  .projects-section h2 {
    text-align: center;
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .section-subtitle {
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Why Us Section */
  .why-us-section {
    padding: clamp(4rem, 10vw, 8rem) 0;
    background: var(--bg-secondary);
  }

  .why-us-header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .why-us-header h2 {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .why-us-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .why-us-stats {
    display: flex;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2rem) 0;
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .why-us-stat { text-align: center; flex: 1; }

  .why-us-stat-number {
    display: block;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--brand-color);
    line-height: 1.1;
  }

  .why-us-stat-label {
    display: block;
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-weight: 500;
  }

  .why-us-content {
    max-width: 800px;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .why-us-body {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .why-us-accent {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    line-height: 1.7;
    font-weight: 600;
    color: var(--text-accent);
    font-style: italic;
  }

  .why-us-closing {
    text-align: center;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    padding: clamp(2rem, 4vw, 3rem);
    max-width: 700px;
    margin: 0 auto;
  }

  .why-us-offer {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.6;
    margin: 0;
  }

  .process-journey {
    text-align: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .process-heading {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 700;
    color: var(--brand-color);
    margin-bottom: 1.5rem;
  }

  .why-us-process {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
    text-align: left;
  }

  @media (min-width: 640px) {
    .why-us-process { grid-template-columns: repeat(2, 1fr); }
    .process-step:nth-child(2n)::after { display: none; }
  }

  @media (min-width: 960px) {
    .why-us-process { grid-template-columns: repeat(3, 1fr); }
    .process-step:nth-child(2n)::after { display: inline; }
    .process-step:nth-child(3n)::after { display: none; }
  }

  .process-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.35rem;
    border-radius: 0.75rem;
    background: var(--bg-secondary);
    border-top: 3px solid var(--brand-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .process-step::after {
    content: '›';
    position: absolute;
    top: 50%;
    right: calc(clamp(1rem, 2vw, 1.5rem) / -2);
    transform: translate(50%, -50%);
    color: var(--brand-color);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }

  .process-step:last-child::after {
    display: none;
  }

  .process-step:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.5rem;
    background: var(--brand-color);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .step-title {
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .step-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Team Section */
  .team-section {
    padding: 0;
  }

  /* Booking Section */
  .booking-section {
    padding: clamp(3rem, 8vw, 6rem) 0;
    background: var(--bg-secondary);
  }

  .booking-content {
    text-align: center;
  }

  .booking-content h2 {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .booking-content > p {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .booking-permission {
    font-style: italic;
    color: var(--text-tertiary);
    max-width: 600px;
    margin: -1rem auto 2rem;
    font-size: clamp(0.9rem, 2vw, 1rem) !important;
    line-height: 1.6;
  }

  .calendar-wrapper {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    padding: clamp(1rem, 3vw, 2rem);
    min-height: 600px;
  }

  .calendar-wrapper iframe {
    min-height: 550px;
  }

  /* CTA Section */
  .cta-section {
    padding: clamp(4rem, 10vw, 8rem) 0;
    text-align: center;
    background: var(--bg-primary);
  }

  .cta-section h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .cta-section p {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .process-step::after { display: none; }
  }

  @media (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      max-width: 280px;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      min-height: clamp(500px, 80vh, 600px);
    }

    .why-us-stats { flex-direction: column; gap: 1.5rem; padding: 1.5rem 0; }
  }

  @media (min-width: 1800px) {
    .hero-title {
      font-size: clamp(4rem, 6vw, 8rem);
    }

    .hero-subtitle {
      font-size: clamp(1.5rem, 2vw, 2rem);
    }
  }
</style>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  async function initParticles() {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isMobile = window.innerWidth < 768;

    await loadSlim(tsParticles);

    await tsParticles.load({
      id: "tsparticles",
      options: {
        fullScreen: { enable: false },
        background: { color: "transparent" },
        particles: {
          number: {
            value: 100,
            density: { enable: true, area: 800 },
          },
          color: { value: "#AF8232" },
          opacity: { value: { min: 0.15, max: 0.4 } },
          size: { value: { min: 1, max: 3 } },
          move: {
            enable: !prefersReducedMotion,
            speed: { min: 0.5, max: 1.5 },
            direction: "none",
            outModes: { default: "bounce" },
          },
          links: {
            enable: true,
            color: "#AF8232",
            distance: 180,
            opacity: 0.2,
            width: 1,
          },
        },
        interactivity: {
          events: {
            onHover: { enable: !isMobile, mode: "grab" },
            onClick: { enable: false, mode: "push" },
          },
          modes: {
            grab: { distance: 250, links: { opacity: 0.5 } },
            push: { quantity: 4 },
          },
        },
        detectRetina: true,
      },
    });
  }

  initParticles();
</script>
