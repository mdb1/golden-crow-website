        <div class="pg-home-copy">
          <h1>
            <span>Pocket</span>
            <span>Genes</span>
          </h1>
          <p class="pg-home-lead">
            {copy.heroLead}
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={localizePath('/pocket-genes/download')}>
              {copy.downloadCta}
            </a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/join-us')}>
              {copy.joinUsCta}
            </a>
          </div>
        </div>

        <figure class="pg-home-visual" aria-label={copy.appPreviewLabel}>
          <img class="pg-home-phone pg-home-phone-main" src="/pocket-genes/screenshots/sample-01.webp" alt={copy.exploreAlt} width="560" height="1218" fetchpriority="high" decoding="async" />
          <img class="pg-home-phone pg-home-phone-side" src="/pocket-genes/screenshots/discover-simulator-light.webp" alt={copy.discoverSimulatorAlt} width="560" height="1218" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="pg-section pg-home-identity">
      <div class="pg-container pg-identity-stage">
        <div class="pg-identity-copy">
          <p class="pg-eyebrow">{copy.identityEyebrow}</p>
          <h2>{copy.identityTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
          <p>
            {copy.identityBody}
          </p>
          <div class="pg-identity-actions">
            <a class="pg-button pg-button-primary" href={localizePath('/pocket-genes/download')}>{copy.downloadApp}</a>
            <a class="pg-button pg-button-secondary" href="#consultation-call">{copy.talkCta}</a>
          </div>
        </div>

        <div class="pg-identity-board">
          <div class="pg-identity-flow" aria-label={copy.userFlowLabel}>
            {identityFlow.map((step, index) => (
              <span style={`--flow-index: ${index};`}>
                <small>{String(index + 1).padStart(2, '0')}</small>
                {step}
              </span>
            ))}
          </div>

          <div class="pg-identity-card-grid">
            {identityCards.map((card, index) => (
              <article
                class:list={['pg-identity-card', { 'is-featured': index === 0 }]}
                tabindex="0"
                style={`--identity-accent: ${card.accent}; --identity-surface: ${card.surface}; --identity-delay: ${index * 80}ms;`}
              >
                <span>{card.kicker}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))}
          </div>

          <div class="pg-identity-contact">
            <span>{copy.contactPrompt}</span>
            <a href={`mailto:${POCKET_GENES_EMAILS.hello}`}>{POCKET_GENES_EMAILS.hello}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section pg-home-product">
      <div class="pg-container">
        <div class="pg-home-product-header">
          <p class="pg-eyebrow">{copy.productEyebrow}</p>
          <h2>{copy.productTitle}</h2>
          <p>
            {copy.productBody}
          </p>
        </div>

        <div class="pg-moment-layout">
          <div class="pg-moment-grid" aria-label={copy.productFlowLabel}>
            {productMoments.map((moment, index) => (
              <article
                class:list={['pg-moment-card', { 'is-active': index === 0 }]}
                tabindex="0"
                data-moment-card
                data-title={moment.title}
                data-detail={moment.detail}
                data-chip={moment.chip}
                style={`--moment-accent: ${moment.accent}; --moment-pastel: ${moment.pastel}; --moment-soft: ${moment.soft};`}
              >
                <span class="pg-moment-number">{String(index + 1).padStart(2, '0')}</span>
                <p>{moment.eyebrow}</p>
                <h3>{moment.title}</h3>
                <span>{moment.body}</span>
              </article>
            ))}
          </div>

          <aside
            class="pg-moment-focus"
            aria-live="polite"
            data-moment-focus
            style={`--moment-accent: ${productMoments[0].accent}; --moment-pastel: ${productMoments[0].pastel}; --moment-soft: ${productMoments[0].soft};`}
