---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';
import { APP_STORE_URL, POCKET_GENES_EMAILS } from '../../data/pocketGenesPublic';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const productPillars = [
  {
    title: 'Private personal context',
    body: 'Your report, genes, saved findings, interests, and journey stage give every resource more relevance.',
  },
  {
    title: 'Understanding',
    body: 'Plain-language explanations and guided learning help you understand your own information better than before.',
  },
  {
    title: 'Belonging',
    body: 'Optional community tools help you connect by gene, condition, symptoms, role, language, country, or journey stage.',
  },
  {
    title: 'Navigation and action',
    body: 'Move from result to explanation, learning, community, events, and saved questions for an appointment.',
  },
  {
    title: 'Relevant updates',
    body: 'Follow updates that match your gene, condition, country, organization, event interests, or stage of the journey.',
  },
];

const identityFacts = [
  {
    label: 'Pocket Genes',
    value:
      'A personal genomic companion for reports, notes, education, and next steps.',
  },
  {
    label: 'Privacy',
    value: 'Reports and exact genetic details stay private by default.',
  },
  {
    label: 'Contact',
    value: POCKET_GENES_EMAILS.hello,
  },
];

const trustPreview = [
  {
    title: 'Privacy Policy',
    category: 'Privacy',
    summary: 'What Pocket Genes collects, stores, and lets you control.',
    href: '/pocket-genes/trust-center/privacy-policy',
  },
  {
    title: 'Security Overview',
    category: 'Security',
    summary: 'How Pocket Genes protects report and account information.',
    href: '/pocket-genes/trust-center/security-overview',
  },
  {
    title: 'Data Flow',
    category: 'Data',
    summary: 'How a report becomes a private Pocket Genes experience.',
    href: '/pocket-genes/trust-center/data-flow-diagram',
  },
  {
    title: 'Retention and Deletion',
    category: 'Data',
    summary: 'How stored information can be removed or retained.',
    href: '/pocket-genes/trust-center/data-retention-deletion',
  },
  {
    title: 'Incident Reporting',
    category: 'Safety',
    summary: 'Where to report privacy, safety, or security concerns.',
    href: '/pocket-genes/trust-center/incident-reporting',
  },
  {
    title: 'Intended Use',
    category: 'Product',
    summary: 'What Pocket Genes is built to do, and what it is not.',
    href: '/pocket-genes/trust-center/regulatory-intended-use',
  },
];

---

<PocketGenesPublicLayout
  title="Pocket Genes - Personal genomic companion"
  description="Pocket Genes helps people organize genetic reports, understand key concepts, and prepare safer next steps."
  canonicalPath="/pocket-genes/home"
>
  <main id="main" class="pg-page pg-home">
    <section class="pg-home-hero">
      <div class="pg-container pg-home-hero-grid">
        <div class="pg-home-copy">
          <div class="pg-home-logo" aria-label="Pocket Genes logo">
            <span class="pg-home-logo-mark" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
            <span>Pocket Genes</span>
          </div>
          <h1>Pocket Genes</h1>
          <p class="pg-home-lead">
            Pocket Genes helps you understand a genetic result, find trusted connections, and choose a clear next step without making your private report public by default.
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
              Download on the App Store
            </a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/rarefriends')}>
              Explore community
            </a>
          </div>
        </div>

        <figure class="pg-home-visual" aria-label="Pocket Genes app preview">
          <img class="pg-home-phone pg-home-phone-main" src="/pocket-genes/screenshots/sample-01.webp" alt="Pocket Genes Explore screen showing genomics education and report categories" fetchpriority="high" />
          <img class="pg-home-phone pg-home-phone-side" src="/pocket-genes/screenshots/sample-03.webp" alt="Pocket Genes sample pathology detail screen" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section pg-home-identity">
      <div class="pg-container pg-home-split">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">At a glance</p>
          <h2>Pocket Genes in one place.</h2>
          <p>
            Learn what the app does, download it, contact Pocket Genes, and see how privacy and trust are handled.
          </p>
        </div>

        <div class="pg-fact-list" aria-label="Pocket Genes identity facts">
          {identityFacts.map((fact) => (
            <article class="pg-fact">
              <h3>{fact.label}</h3>
              <p>{fact.value}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-home-product">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">What the product does</p>
          <h2>A private result becomes understanding, belonging, and a useful next step.</h2>
        </div>
        <div class="pg-card-grid pg-pillar-grid">
          {productPillars.map((pillar) => (
            <article class="pg-card">
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-home-trust">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">Trust Center</p>
          <h2>Privacy, safety, and data handling in one place.</h2>
          <p>
            See the privacy, security, data, and safety pages for Pocket Genes.
          </p>
        </div>
        <div class="pg-trust-preview-grid">
          {trustPreview.map((document) => (
            <a class="pg-trust-preview" href={localizePath(document.href)}>
              <span>{document.category}</span>
              <strong>{document.title}</strong>
              <p>{document.summary}</p>
            </a>
          ))}
        </div>
        <div class="pg-home-inline-action">
          <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>Open the full Trust Center</a>
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-home-store">
      <div class="pg-container pg-store-band">
        <div>
          <p class="pg-eyebrow">Get Pocket Genes</p>
          <h2>Available for iPhone. Google Play is planned.</h2>
          <p>
            Download the iPhone app today. Android support is coming later.
          </p>
        </div>
        <div class="pg-store-actions">
          <a class="pg-store-app" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span>Download for iPhone</span>
            <img src="/appStore.png" alt="Download Pocket Genes on the App Store" />
          </a>
          <button class="pg-store-disabled" type="button" disabled>
            <span>Google Play</span>
            <strong>Coming soon</strong>
          </button>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-home-hero {
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: 112px 0 64px;
    background:
      linear-gradient(90deg, rgba(251, 252, 253, 0.98) 0%, rgba(251, 252, 253, 0.9) 48%, rgba(251, 252, 253, 0.6) 100%),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center right;
    overflow: hidden;
  }

  .pg-home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
    gap: 56px;
    align-items: center;
  }

  .pg-home-copy h1 {
    margin: 18px 0 0;
    font-size: 4.4rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .pg-home-lead {
    max-width: 680px;
    margin: 20px 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.22rem;
    line-height: 1.66;
  }

  .pg-home-copy .pg-button-row {
    margin-top: 28px;
  }

  .pg-home-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--pg-ink);
    font-size: 1.04rem;
    font-weight: 900;
  }

  .pg-home-logo-mark {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: #eef8f5;
    border: 1px solid #c8ebe4;
    position: relative;
    overflow: hidden;
    display: inline-grid;
    place-items: center;
  }

  .pg-home-logo-mark::before,
  .pg-home-logo-mark::after {
    content: "";
    position: absolute;
    width: 30px;
    height: 30px;
    border: 3px solid var(--pg-teal);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 999px;
    transform: rotate(45deg);
  }

  .pg-home-logo-mark::after {
    border-color: var(--pg-rose);
    border-right-color: transparent;
    border-top-color: transparent;
    transform: rotate(45deg) translate(2px, -2px);
  }

  .pg-home-logo-mark span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--pg-blue);
  }

  .pg-home-logo-mark span:first-child {
    transform: translate(-8px, 8px);
  }

  .pg-home-logo-mark span:last-child {
    transform: translate(9px, -8px);
  }

  .pg-home-visual {
    position: relative;
    min-height: 580px;
    margin: 0;
  }

  .pg-home-phone {
    position: absolute;
    display: block;
    width: 270px;
    aspect-ratio: 560 / 1218;
    object-fit: cover;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-home-phone-main {
    right: 170px;
    top: 16px;
  }

  .pg-home-phone-side {
    right: 0;
    top: 86px;
  }

  .pg-home-split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: 44px;
    align-items: start;
  }

  .pg-fact-list {
    display: grid;
    gap: 12px;
  }

  .pg-fact {
    border-left: 4px solid var(--pg-teal);
    border-radius: 8px;
    background: #ffffff;
    padding: 18px 20px;
    box-shadow: 0 1px 2px rgba(23, 32, 51, 0.05);
  }

  .pg-fact h3 {
    margin: 0 0 4px;
    font-size: 0.92rem;
    color: var(--pg-muted);
  }

  .pg-fact p {
    margin: 0;
    color: var(--pg-ink);
    font-weight: 760;
  }

  .pg-home-product {
    background: #ffffff;
  }

  .pg-pillar-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .pg-home-trust {
    background: #eef5f7;
  }

  .pg-trust-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .pg-trust-preview {
    min-height: 100%;
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    padding: 20px;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .pg-trust-preview:hover {
    transform: translateY(-2px);
    border-color: var(--pg-teal);
    box-shadow: 0 12px 28px rgba(20, 149, 143, 0.12);
  }

  .pg-trust-preview span {
    display: block;
    margin-bottom: 8px;
    color: var(--pg-teal);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-trust-preview strong {
    display: block;
    font-size: 1.06rem;
    line-height: 1.25;
  }

  .pg-trust-preview p {
    margin: 10px 0 0;
    color: var(--pg-ink-soft);
  }

  .pg-home-inline-action {
    margin-top: 24px;
  }

  .pg-home-store {
    background: #ffffff;
  }

  .pg-store-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, auto);
    gap: 28px;
    align-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 28px;
  }

  .pg-store-band h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-store-band p {
    margin: 12px 0 0;
    color: var(--pg-ink-soft);
  }

  .pg-store-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }

  .pg-store-app,
  .pg-store-disabled {
    min-height: 74px;
    border-radius: 8px;
    padding: 12px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font: inherit;
  }

  .pg-store-app {
    background: var(--pg-ink);
    color: #ffffff;
    text-decoration: none;
  }

  .pg-store-app span,
  .pg-store-disabled span {
    font-weight: 850;
  }

  .pg-store-app img {
    width: 132px;
  }

  .pg-store-disabled {
    border: 1px solid var(--pg-border-strong);
    background: #ffffff;
    color: var(--pg-muted);
    cursor: not-allowed;
  }

  .pg-store-disabled strong {
    color: var(--pg-rose);
    font-size: 0.86rem;
  }

  @media (max-width: 1040px) {
    .pg-home-hero-grid,
    .pg-home-split,
    .pg-store-band {
      grid-template-columns: 1fr;
    }

    .pg-home-visual {
      min-height: 520px;
    }

    .pg-home-phone-main {
      left: 80px;
      right: auto;
    }

    .pg-home-phone-side {
      left: 320px;
      right: auto;
    }

    .pg-pillar-grid,
    .pg-trust-preview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pg-store-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 720px) {
    .pg-home-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-home-copy h1 {
      font-size: 3.2rem;
    }

    .pg-home-lead {
      font-size: 1.08rem;
    }

    .pg-home-visual {
      min-height: 390px;
    }

    .pg-home-phone {
      width: 210px;
      border-width: 7px;
      border-radius: 24px;
    }

    .pg-home-phone-main {
      left: 0;
      top: 0;
    }

    .pg-home-phone-side {
      left: 150px;
      top: 54px;
    }

    .pg-pillar-grid,
    .pg-trust-preview-grid {
      grid-template-columns: 1fr;
    }

    .pg-store-actions,
    .pg-store-app,
    .pg-store-disabled {
      width: 100%;
    }

    .pg-store-app,
    .pg-store-disabled {
      justify-content: space-between;
    }
  }

  @media (max-width: 440px) {
    .pg-home-copy h1 {
      font-size: 2.72rem;
    }

    .pg-home-visual {
      min-height: 340px;
    }

    .pg-home-phone {
      width: 185px;
    }

    .pg-home-phone-side {
      left: 118px;
      top: 48px;
    }

  }
</style>
