---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';
import { APP_STORE_URL, POCKET_GENES_EMAILS } from '../../data/pocketGenesPublic';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const productMoments = [
  {
    eyebrow: 'Private report',
    title: 'Keep it organized',
    body: 'Store your report, notes, saved findings, and questions without exposing exact details by default.',
    detail: 'Your original file stays private while the app keeps the pieces you need easy to revisit.',
    chip: 'Start here',
    accent: '#1d8f8f',
    pastel: '#e8faf7',
    soft: '#f6fffd',
  },
  {
    eyebrow: 'Learn',
    title: 'Make terms clearer',
    body: 'Turn genes, panels, variants, and unfamiliar report language into context you can come back to.',
    detail: 'Plain-language explanations help a dense genetic result feel easier to review over time.',
    chip: 'Learn',
    accent: '#d85b7f',
    pastel: '#fff0f5',
    soft: '#fff8fb',
  },
  {
    eyebrow: 'People',
    title: 'Find relevant support',
    body: 'Discover people, caregivers, groups, and events by gene, condition, symptoms, role, language, or journey stage.',
    detail: 'Start from exact matches when they exist, or widen to related groups and shared experiences when that is more useful.',
    chip: 'Find support',
    accent: '#2176ae',
    pastel: '#ecf5ff',
    soft: '#f7fbff',
  },
  {
    eyebrow: 'Prepare',
    title: 'Save what matters',
    body: 'Keep questions, resources, event interests, and appointment notes close to the result that raised them.',
    detail: 'Use what you learn to prepare better questions, save useful resources, or plan a practical follow-up.',
    chip: 'Prepare',
    accent: '#d99232',
    pastel: '#fff6dd',
    soft: '#fffdf5',
  },
  {
    eyebrow: 'Updates',
    title: 'Follow useful signals',
    body: 'Follow updates that match your gene, condition, country, organization, event interests, or stage of the journey.',
    detail: 'Keep relevant updates near your own context instead of searching from scratch every time.',
    chip: 'Stay current',
    accent: '#3c9b68',
    pastel: '#edf9ef',
    soft: '#f8fff9',
  },
];

const identityFacts = [
  {
    label: 'Pocket Genes',
    value:
      'A personal genomic companion for reports, notes, education, and next steps.',
  },
  {
    label: 'Privacy',
    value: 'Reports and exact genetic details stay private by default.',
  },
  {
    label: 'Contact',
    value: POCKET_GENES_EMAILS.hello,
  },
];

---

<PocketGenesPublicLayout
  title="Pocket Genes - Personal genomic companion"
  description="Pocket Genes helps people organize genetic reports, understand key concepts, and prepare safer next steps."
  canonicalPath="/pocket-genes/home"
>
  <main id="main" class="pg-page pg-home">
    <section class="pg-home-hero">
      <div class="pg-container pg-home-hero-grid">
        <div class="pg-home-copy">
          <div class="pg-home-logo" aria-label="Pocket Genes logo">
            <span class="pg-home-logo-mark" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
            <span>Pocket Genes</span>
          </div>
          <h1>Pocket Genes</h1>
          <p class="pg-home-lead">
            Pocket Genes helps you understand a genetic result, find trusted connections, and choose a clear next step without making your private report public by default.
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
              Download on the App Store
            </a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/rarefriends')}>
              Explore community
            </a>
          </div>
        </div>

        <figure class="pg-home-visual" aria-label="Pocket Genes app preview">
          <img class="pg-home-phone pg-home-phone-main" src="/pocket-genes/screenshots/sample-01.webp" alt="Pocket Genes Explore screen showing genomics education and report categories" fetchpriority="high" />
          <img class="pg-home-phone pg-home-phone-side" src="/pocket-genes/screenshots/sample-03.webp" alt="Pocket Genes sample pathology detail screen" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section pg-home-identity">
      <div class="pg-container pg-home-split">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">At a glance</p>
          <h2>Pocket Genes in one place.</h2>
          <p>
            Learn what the app does, download it, contact Pocket Genes, and see how privacy and trust are handled.
          </p>
        </div>

        <div class="pg-fact-list" aria-label="Pocket Genes identity facts">
          {identityFacts.map((fact) => (
            <article class="pg-fact">
              <h3>{fact.label}</h3>
              <p>{fact.value}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-home-product">
      <div class="pg-container">
        <div class="pg-home-product-header">
          <p class="pg-eyebrow">Inside Pocket Genes</p>
          <h2>Understand your result, find relevant support, and keep the next step close.</h2>
          <p>
            Your report stays private while Pocket Genes helps you learn, connect, prepare questions, and follow updates that match your situation.
          </p>
        </div>

        <div class="pg-moment-layout">
          <div class="pg-moment-grid" aria-label="Pocket Genes product flow">
            {productMoments.map((moment, index) => (
              <article
                class:list={['pg-moment-card', { 'is-active': index === 0 }]}
                tabindex="0"
                data-moment-card
                data-title={moment.title}
                data-detail={moment.detail}
                data-chip={moment.chip}
                style={`--moment-accent: ${moment.accent}; --moment-pastel: ${moment.pastel}; --moment-soft: ${moment.soft};`}
              >
                <span class="pg-moment-number">{String(index + 1).padStart(2, '0')}</span>
                <p>{moment.eyebrow}</p>
                <h3>{moment.title}</h3>
                <span>{moment.body}</span>
              </article>
            ))}
          </div>

          <aside
            class="pg-moment-focus"
            aria-live="polite"
            data-moment-focus
            style={`--moment-accent: ${productMoments[0].accent}; --moment-pastel: ${productMoments[0].pastel}; --moment-soft: ${productMoments[0].soft};`}
          >
            <span data-moment-focus-chip>{productMoments[0].chip}</span>
            <h3 data-moment-focus-title>{productMoments[0].title}</h3>
            <p data-moment-focus-detail>{productMoments[0].detail}</p>
            <div class="pg-moment-flow" aria-label="Pocket Genes flow">
              <strong>Save</strong>
              <strong>Learn</strong>
              <strong>Find</strong>
              <strong>Prepare</strong>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-home-store">
      <div class="pg-container pg-store-band">
        <div>
          <p class="pg-eyebrow">Get Pocket Genes</p>
          <h2>Available for iPhone. Google Play is planned.</h2>
          <p>
            Download the iPhone app today. Android support is coming later.
          </p>
        </div>
        <div class="pg-store-actions">
          <a class="pg-store-app" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span>Download for iPhone</span>
            <img src="/appStore.png" alt="Download Pocket Genes on the App Store" />
          </a>
          <button class="pg-store-disabled" type="button" disabled>
            <span>Google Play</span>
            <strong>Coming soon</strong>
          </button>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<script>
  const productSection = document.querySelector('.pg-home-product');

  if (productSection) {
    const cards = Array.from(productSection.querySelectorAll('[data-moment-card]'));
    const focusPanel = productSection.querySelector('[data-moment-focus]');
    const focusChip = productSection.querySelector('[data-moment-focus-chip]');
    const focusTitle = productSection.querySelector('[data-moment-focus-title]');
    const focusDetail = productSection.querySelector('[data-moment-focus-detail]');

    const setActiveCard = (card) => {
      for (const item of cards) {
        item.classList.toggle('is-active', item === card);
      }

      if (!focusPanel || !focusChip || !focusTitle || !focusDetail) return;

      focusPanel.style.setProperty('--moment-accent', card.style.getPropertyValue('--moment-accent'));
      focusPanel.style.setProperty('--moment-pastel', card.style.getPropertyValue('--moment-pastel'));
      focusPanel.style.setProperty('--moment-soft', card.style.getPropertyValue('--moment-soft'));
      focusChip.textContent = card.dataset.chip || '';
      focusTitle.textContent = card.dataset.title || '';
      focusDetail.textContent = card.dataset.detail || '';
    };

    for (const card of cards) {
      card.addEventListener('pointerenter', () => setActiveCard(card));
      card.addEventListener('focusin', () => setActiveCard(card));
      card.addEventListener('click', () => setActiveCard(card));
    }
  }
</script>

<style>
  .pg-home-hero {
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: 112px 0 64px;
    background:
      linear-gradient(90deg, rgba(251, 252, 253, 0.98) 0%, rgba(251, 252, 253, 0.9) 48%, rgba(251, 252, 253, 0.6) 100%),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center right;
    overflow: hidden;
  }

  .pg-home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
    gap: 56px;
    align-items: center;
  }

  .pg-home-copy h1 {
    margin: 18px 0 0;
    font-size: 4.4rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .pg-home-lead {
    max-width: 680px;
    margin: 20px 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.22rem;
    line-height: 1.66;
  }

  .pg-home-copy .pg-button-row {
    margin-top: 28px;
  }

  .pg-home-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--pg-ink);
    font-size: 1.04rem;
    font-weight: 900;
  }

  .pg-home-logo-mark {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: #eef8f5;
    border: 1px solid #c8ebe4;
    position: relative;
    overflow: hidden;
    display: inline-grid;
    place-items: center;
  }

  .pg-home-logo-mark::before,
  .pg-home-logo-mark::after {
    content: "";
    position: absolute;
    width: 30px;
    height: 30px;
    border: 3px solid var(--pg-teal);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 999px;
    transform: rotate(45deg);
  }

  .pg-home-logo-mark::after {
    border-color: var(--pg-rose);
    border-right-color: transparent;
    border-top-color: transparent;
    transform: rotate(45deg) translate(2px, -2px);
  }

  .pg-home-logo-mark span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--pg-blue);
  }

  .pg-home-logo-mark span:first-child {
    transform: translate(-8px, 8px);
  }

  .pg-home-logo-mark span:last-child {
    transform: translate(9px, -8px);
  }

  .pg-home-visual {
    position: relative;
    min-height: 580px;
    margin: 0;
  }

  .pg-home-phone {
    position: absolute;
    display: block;
    width: 270px;
    aspect-ratio: 560 / 1218;
    object-fit: cover;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-home-phone-main {
    right: 170px;
    top: 16px;
  }

  .pg-home-phone-side {
    right: 0;
    top: 86px;
  }

  .pg-home-split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: 44px;
    align-items: start;
  }

  .pg-fact-list {
    display: grid;
    gap: 12px;
  }

  .pg-fact {
    border-left: 4px solid var(--pg-teal);
    border-radius: 8px;
    background: #ffffff;
    padding: 18px 20px;
    box-shadow: 0 1px 2px rgba(23, 32, 51, 0.05);
  }

  .pg-fact h3 {
    margin: 0 0 4px;
    font-size: 0.92rem;
    color: var(--pg-muted);
  }

  .pg-fact p {
    margin: 0;
    color: var(--pg-ink);
    font-weight: 760;
  }

  .pg-home-product {
    background:
      linear-gradient(135deg, rgba(232, 250, 247, 0.82), rgba(255, 240, 245, 0.72) 44%, rgba(236, 245, 255, 0.82));
    overflow: hidden;
  }

  .pg-home-product-header {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .pg-home-product-header h2 {
    margin: 0;
    color: var(--pg-ink);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .pg-home-product-header p:last-child {
    max-width: 680px;
    margin: 18px 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.04rem;
    line-height: 1.65;
  }

  .pg-moment-layout {
    display: grid;
    gap: 14px;
  }

  .pg-moment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px;
  }

  .pg-moment-card {
    position: relative;
    isolation: isolate;
    min-height: 226px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--moment-accent), white 68%);
    border-radius: 8px;
    background: linear-gradient(145deg, var(--moment-soft), var(--moment-pastel));
    box-shadow: 0 14px 34px rgba(23, 32, 51, 0.08);
    display: flex;
    flex-direction: column;
    padding: 18px;
    outline: none;
    cursor: pointer;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, background 220ms ease;
  }

  .pg-moment-card::before,
  .pg-moment-card::after {
    content: "";
    position: absolute;
    pointer-events: none;
    z-index: -1;
    opacity: 0;
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .pg-moment-card::before {
    inset: 0;
    background: linear-gradient(135deg, color-mix(in srgb, var(--moment-accent), transparent 84%), transparent 58%);
  }

  .pg-moment-card::after {
    right: -44px;
    top: -44px;
    width: 130px;
    height: 130px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--moment-accent), transparent 78%);
    transform: scale(0.7);
  }

  .pg-moment-card:hover,
  .pg-moment-card:focus-visible,
  .pg-moment-card.is-active {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--moment-accent), white 18%);
    box-shadow: 0 24px 58px rgba(23, 32, 51, 0.14);
  }

  .pg-moment-card:hover::before,
  .pg-moment-card:hover::after,
  .pg-moment-card:focus-visible::before,
  .pg-moment-card:focus-visible::after,
  .pg-moment-card.is-active::before,
  .pg-moment-card.is-active::after {
    opacity: 1;
  }

  .pg-moment-card:hover::after,
  .pg-moment-card:focus-visible::after,
  .pg-moment-card.is-active::after {
    transform: scale(1);
  }

  .pg-moment-number {
    display: inline-grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--moment-accent);
    font-weight: 900;
  }

  .pg-moment-card p {
    margin: 16px 0 0;
    color: var(--moment-accent);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pg-moment-card h3 {
    margin: 8px 0 0;
    color: var(--pg-ink);
    font-size: 1.16rem;
    line-height: 1.18;
  }

  .pg-moment-card > span:last-child {
    display: block;
    margin-top: 10px;
    color: var(--pg-ink-soft);
    line-height: 1.55;
  }

  .pg-moment-focus {
    display: grid;
    grid-template-columns: minmax(180px, 0.42fr) minmax(0, 1fr) minmax(320px, 0.56fr);
    gap: 18px;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--moment-accent), white 58%);
    border-radius: 8px;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.92), color-mix(in srgb, var(--moment-pastel), white 28%)),
      var(--moment-soft);
    box-shadow: 0 24px 58px rgba(23, 32, 51, 0.11);
    padding: 22px;
    transition: border-color 220ms ease, background 220ms ease;
  }

  .pg-moment-focus > span {
    width: fit-content;
    border-radius: 999px;
    background: color-mix(in srgb, var(--moment-accent), white 84%);
    color: var(--moment-accent);
    font-size: 0.78rem;
    font-weight: 900;
    padding: 8px 12px;
    text-transform: uppercase;
  }

  .pg-moment-focus h3 {
    margin: 0;
    color: var(--pg-ink);
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    line-height: 1.1;
  }

  .pg-moment-focus p {
    margin: 0;
    color: var(--pg-ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  .pg-moment-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .pg-moment-flow strong {
    min-height: 46px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.68);
    color: var(--pg-ink);
    font-size: 0.82rem;
    line-height: 1.1;
    text-align: center;
  }

  .pg-home-store {
    background: #ffffff;
  }

  .pg-store-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, auto);
    gap: 28px;
    align-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 28px;
  }

  .pg-store-band h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-store-band p {
    margin: 12px 0 0;
    color: var(--pg-ink-soft);
  }

  .pg-store-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }

  .pg-store-app,
  .pg-store-disabled {
    min-height: 74px;
    border-radius: 8px;
    padding: 12px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font: inherit;
  }

  .pg-store-app {
    background: var(--pg-ink);
    color: #ffffff;
    text-decoration: none;
  }

  .pg-store-app span,
  .pg-store-disabled span {
    font-weight: 850;
  }

  .pg-store-app img {
    width: 132px;
  }

  .pg-store-disabled {
    border: 1px solid var(--pg-border-strong);
    background: #ffffff;
    color: var(--pg-muted);
    cursor: not-allowed;
  }

  .pg-store-disabled strong {
    color: var(--pg-rose);
    font-size: 0.86rem;
  }

  @media (max-width: 1040px) {
    .pg-home-hero-grid,
    .pg-home-split,
    .pg-moment-layout,
    .pg-store-band {
      grid-template-columns: 1fr;
    }

    .pg-home-visual {
      min-height: 520px;
    }

    .pg-home-phone-main {
      left: 80px;
      right: auto;
    }

    .pg-home-phone-side {
      left: 320px;
      right: auto;
    }

    .pg-moment-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pg-moment-focus {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    }

    .pg-moment-flow {
      grid-column: 1 / -1;
    }

    .pg-store-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 720px) {
    .pg-home-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-home-copy h1 {
      font-size: 3.2rem;
    }

    .pg-home-lead {
      font-size: 1.08rem;
    }

    .pg-home-visual {
      min-height: 390px;
    }

    .pg-home-phone {
      width: 210px;
      border-width: 7px;
      border-radius: 24px;
    }

    .pg-home-phone-main {
      left: 0;
      top: 0;
    }

    .pg-home-phone-side {
      left: 150px;
      top: 54px;
    }

    .pg-moment-grid,
    .pg-moment-focus,
    .pg-moment-flow {
      grid-template-columns: 1fr;
    }

    .pg-moment-flow {
      grid-column: auto;
    }

    .pg-store-actions,
    .pg-store-app,
    .pg-store-disabled {
      width: 100%;
    }

    .pg-store-app,
    .pg-store-disabled {
      justify-content: space-between;
    }
  }

  @media (max-width: 440px) {
    .pg-home-copy h1 {
      font-size: 2.72rem;
    }

    .pg-home-visual {
      min-height: 340px;
    }

    .pg-home-phone {
      width: 185px;
    }

    .pg-home-phone-side {
      left: 118px;
      top: 48px;
    }

  }
</style>
