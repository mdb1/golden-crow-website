          </a>
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-trust-contact" aria-labelledby="pg-home-contact-title">
      <div class="pg-container">
        <div class="pg-trust-contact-band">
          <div class="pg-contact-orbits" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="pg-contact-main">
            <p class="pg-eyebrow">{copy.contactEyebrow}</p>
            <h2 id="pg-home-contact-title">{copy.contactTitle}</h2>
            <p>
              {copy.contactBody}
            </p>
          </div>
          <div class="pg-contact-panel">
            <div class="pg-contact-actions">
              <a class="pg-contact-email" href={`mailto:${POCKET_GENES_EMAILS.hello}?subject=${trustMailSubject}`}>
                <span>{copy.primaryInbox}</span>
                <strong>{POCKET_GENES_EMAILS.hello}</strong>
              </a>
              <button class="pg-contact-copy-button" type="button" data-copy-email={POCKET_GENES_EMAILS.hello} data-copy-label={copy.copyEmail} data-copied-label={copy.copied}>
                {copy.copyEmail}
              </button>
            </div>
            <div class="pg-contact-route-grid" aria-label={copy.contactTopicsLabel}>
              {copy.contactRoutes.map((route) => (
                <article class={`pg-contact-route tone-${route.tone}`}>
                  <span class="pg-route-marker" aria-hidden="true"></span>
                  <div>
                    <h3>{route.title}</h3>
                    <p>{route.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="consultation-call" class="pg-section pg-home-booking">
      <div class="pg-container pg-home-booking-grid">
        <div>
          <p class="pg-eyebrow">{copy.bookingEyebrow}</p>
          <h2>{copy.bookingTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
          <p>
            {copy.bookingBody}
          </p>
        </div>
        <div class="pg-home-calendar-wrapper">
          <ClientBookingWidget context="pocket-genes-home" />
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<script>
  const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

  copyEmailButtons.forEach((button) => {
    const originalText = button.textContent?.trim() || button.getAttribute('data-copy-label') || '';
    const copiedText = button.getAttribute('data-copied-label') || originalText;
    const email = button.getAttribute('data-copy-email');

    button.addEventListener('click', async () => {
      if (!email || !navigator.clipboard) return;

      try {
        await navigator.clipboard.writeText(email);
        button.textContent = copiedText;
        window.setTimeout(() => {
          button.textContent = originalText;
        }, 1800);
      } catch {
        button.textContent = originalText;
      }
    });
  });

  const productSection = document.querySelector('.pg-home-product');

  if (productSection) {
    const cards = Array.from(productSection.querySelectorAll('[data-moment-card]'));
    const focusPanel = productSection.querySelector('[data-moment-focus]');
    const focusChip = productSection.querySelector('[data-moment-focus-chip]');
    const focusTitle = productSection.querySelector('[data-moment-focus-title]');
    const focusDetail = productSection.querySelector('[data-moment-focus-detail]');

    const setActiveCard = (card) => {
      for (const item of cards) {
        item.classList.toggle('is-active', item === card);
      }

      if (!focusPanel || !focusChip || !focusTitle || !focusDetail) return;

      focusPanel.style.setProperty('--moment-accent', card.style.getPropertyValue('--moment-accent'));
      focusPanel.style.setProperty('--moment-pastel', card.style.getPropertyValue('--moment-pastel'));
      focusPanel.style.setProperty('--moment-soft', card.style.getPropertyValue('--moment-soft'));
      focusChip.textContent = card.dataset.chip || '';
      focusTitle.textContent = card.dataset.title || '';
      focusDetail.textContent = card.dataset.detail || '';
    };

    for (const card of cards) {
      card.addEventListener('pointerenter', () => setActiveCard(card));
      card.addEventListener('focusin', () => setActiveCard(card));
      card.addEventListener('click', () => setActiveCard(card));
    }
  }
</script>

<style>
