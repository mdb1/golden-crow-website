const copy = pageCopy[isEnglish ? 'en' : 'es'];
const productMoments = copy.productMoments;
const identityCards = copy.identityCards;
const identityFlow = copy.identityFlow;

---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/home"
>
  <main id="main" class="pg-page pg-home">
    <section class="pg-home-hero">
      <div class="pg-container pg-home-hero-grid">
        <div class="pg-home-copy">
          <div class="pg-home-logo" aria-label={copy.logoLabel}>
            <span class="pg-home-logo-mark" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
            <span>Pocket Genes</span>
          </div>
          <h1>Pocket Genes</h1>
          <p class="pg-home-lead">
            {copy.heroLead}
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
              {copy.appStoreCta}
            </a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/rarefriends')}>
              {copy.communityCta}
            </a>
          </div>
        </div>

        <figure class="pg-home-visual" aria-label={copy.appPreviewLabel}>
          <img class="pg-home-phone pg-home-phone-main" src="/pocket-genes/screenshots/sample-01.webp" alt={copy.exploreAlt} fetchpriority="high" />
          <img class="pg-home-phone pg-home-phone-side" src="/pocket-genes/screenshots/sample-03.webp" alt={copy.pathologyAlt} fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section pg-home-identity">
      <div class="pg-container pg-identity-stage">
        <div class="pg-identity-copy">
          <p class="pg-eyebrow">{copy.identityEyebrow}</p>
          <h2>{copy.identityTitle}</h2>
          <p>
            {copy.identityBody}
          </p>
          <div class="pg-identity-actions">
            <a class="pg-button pg-button-primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">{copy.downloadApp}</a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
          </div>
        </div>

        <div class="pg-identity-board">
          <div class="pg-identity-flow" aria-label={copy.userFlowLabel}>
            {identityFlow.map((step, index) => (
              <span style={`--flow-index: ${index};`}>
                <small>{String(index + 1).padStart(2, '0')}</small>
                {step}
              </span>
            ))}
          </div>

          <div class="pg-identity-card-grid">
            {identityCards.map((card, index) => (
              <article
                class:list={['pg-identity-card', { 'is-featured': index === 0 }]}
                tabindex="0"
                style={`--identity-accent: ${card.accent}; --identity-surface: ${card.surface}; --identity-delay: ${index * 80}ms;`}
              >
                <span>{card.kicker}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))}
          </div>

          <div class="pg-identity-contact">
            <span>{copy.contactPrompt}</span>
            <a href={`mailto:${POCKET_GENES_EMAILS.hello}`}>{POCKET_GENES_EMAILS.hello}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section pg-home-product">
      <div class="pg-container">
        <div class="pg-home-product-header">
          <p class="pg-eyebrow">{copy.productEyebrow}</p>
          <h2>{copy.productTitle}</h2>
          <p>
            {copy.productBody}
          </p>
        </div>

        <div class="pg-moment-layout">
          <div class="pg-moment-grid" aria-label={copy.productFlowLabel}>
            {productMoments.map((moment, index) => (
              <article
                class:list={['pg-moment-card', { 'is-active': index === 0 }]}
                tabindex="0"
                data-moment-card
                data-title={moment.title}
                data-detail={moment.detail}
                data-chip={moment.chip}
                style={`--moment-accent: ${moment.accent}; --moment-pastel: ${moment.pastel}; --moment-soft: ${moment.soft};`}
              >
                <span class="pg-moment-number">{String(index + 1).padStart(2, '0')}</span>
                <p>{moment.eyebrow}</p>
                <h3>{moment.title}</h3>
                <span>{moment.body}</span>
              </article>
            ))}
          </div>

          <aside
            class="pg-moment-focus"
            aria-live="polite"
            data-moment-focus
            style={`--moment-accent: ${productMoments[0].accent}; --moment-pastel: ${productMoments[0].pastel}; --moment-soft: ${productMoments[0].soft};`}
          >
            <span data-moment-focus-chip>{productMoments[0].chip}</span>
            <h3 data-moment-focus-title>{productMoments[0].title}</h3>
            <p data-moment-focus-detail>{productMoments[0].detail}</p>
            <div class="pg-moment-flow" aria-label={copy.momentFlowLabel}>
              {copy.momentFlow.map((step) => <strong>{step}</strong>)}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-home-store">
      <div class="pg-container pg-store-band">
        <div>
          <p class="pg-eyebrow">{copy.storeEyebrow}</p>
          <h2>{copy.storeTitle}</h2>
          <p>
            {copy.storeBody}
          </p>
        </div>
        <div class="pg-store-actions">
          <a class="pg-store-app" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span>{copy.downloadIphone}</span>
            <img src="/appStore.png" alt={copy.appStoreAlt} />
          </a>
          <button class="pg-store-disabled" type="button" disabled>
            <span>{copy.googlePlay}</span>
            <strong>{copy.comingSoon}</strong>
          </button>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<script>
  const productSection = document.querySelector('.pg-home-product');

  if (productSection) {
    const cards = Array.from(productSection.querySelectorAll('[data-moment-card]'));
    const focusPanel = productSection.querySelector('[data-moment-focus]');
    const focusChip = productSection.querySelector('[data-moment-focus-chip]');
    const focusTitle = productSection.querySelector('[data-moment-focus-title]');
    const focusDetail = productSection.querySelector('[data-moment-focus-detail]');

    const setActiveCard = (card) => {
      for (const item of cards) {
        item.classList.toggle('is-active', item === card);
      }

      if (!focusPanel || !focusChip || !focusTitle || !focusDetail) return;

      focusPanel.style.setProperty('--moment-accent', card.style.getPropertyValue('--moment-accent'));
      focusPanel.style.setProperty('--moment-pastel', card.style.getPropertyValue('--moment-pastel'));
      focusPanel.style.setProperty('--moment-soft', card.style.getPropertyValue('--moment-soft'));
      focusChip.textContent = card.dataset.chip || '';
      focusTitle.textContent = card.dataset.title || '';
      focusDetail.textContent = card.dataset.detail || '';
    };

    for (const card of cards) {
      card.addEventListener('pointerenter', () => setActiveCard(card));
      card.addEventListener('focusin', () => setActiveCard(card));
      card.addEventListener('click', () => setActiveCard(card));
    }
  }
</script>

<style>
  .pg-home-hero {
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: 112px 0 64px;
    background:
      linear-gradient(90deg, rgba(251, 252, 253, 0.98) 0%, rgba(251, 252, 253, 0.9) 48%, rgba(251, 252, 253, 0.6) 100%),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center right;
    overflow: hidden;
  }

  .pg-home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
    gap: 56px;
    align-items: center;
  }

  .pg-home-copy h1 {
    margin: 18px 0 0;
    font-size: 4.4rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .pg-home-lead {
    max-width: 680px;
    margin: 20px 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.22rem;
    line-height: 1.66;
  }

  .pg-home-copy .pg-button-row {
    margin-top: 28px;
  }

  .pg-home-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--pg-ink);
    font-size: 1.04rem;
    font-weight: 900;
  }

  .pg-home-logo-mark {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: #eef8f5;
    border: 1px solid #c8ebe4;
    position: relative;
    overflow: hidden;
    display: inline-grid;
    place-items: center;
  }

  .pg-home-logo-mark::before,
  .pg-home-logo-mark::after {
    content: "";
    position: absolute;
    width: 30px;
    height: 30px;
    border: 3px solid var(--pg-teal);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 999px;
    transform: rotate(45deg);
  }

  .pg-home-logo-mark::after {
    border-color: var(--pg-rose);
    border-right-color: transparent;
    border-top-color: transparent;
    transform: rotate(45deg) translate(2px, -2px);
  }

  .pg-home-logo-mark span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--pg-blue);
  }

  .pg-home-logo-mark span:first-child {
    transform: translate(-8px, 8px);
  }

  .pg-home-logo-mark span:last-child {
    transform: translate(9px, -8px);
  }

  .pg-home-visual {
    position: relative;
    min-height: 580px;
    margin: 0;
  }

  .pg-home-phone {
    position: absolute;
    display: block;
    width: 270px;
    aspect-ratio: 560 / 1218;
    object-fit: cover;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-home-phone-main {
    right: 170px;
    top: 16px;
  }

  .pg-home-phone-side {
    right: 0;
    top: 86px;
  }

  .pg-home-identity {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.96), rgba(239, 248, 247, 0.9) 48%, rgba(255, 246, 251, 0.86)),
      repeating-linear-gradient(135deg, rgba(20, 149, 143, 0.05) 0 1px, transparent 1px 22px);
  }

  .pg-home-identity::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent, rgba(20, 149, 143, 0.08), transparent);
    opacity: 0.7;
    transform: translateX(-100%);
    animation: pg-identity-scan 9s ease-in-out infinite;
  }

  .pg-identity-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(520px, 1.18fr);
    gap: 52px;
    align-items: center;
  }

  .pg-identity-copy {
    display: grid;
    align-content: start;
  }

  .pg-identity-copy h2 {
    max-width: 620px;
    margin: 0;
    color: var(--pg-ink);
    font-size: 3.25rem;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .pg-identity-copy p:not(.pg-eyebrow) {
    max-width: 620px;
    margin: 22px 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.1rem;
    line-height: 1.72;
  }

  .pg-identity-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .pg-identity-board {
    display: grid;
    gap: 16px;
  }

  .pg-identity-flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .pg-identity-flow::before {
    content: "";
    position: absolute;
    left: 7%;
    right: 7%;
    top: 50%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(20, 149, 143, 0.12), rgba(216, 91, 127, 0.45), rgba(33, 118, 174, 0.45), rgba(217, 146, 50, 0.35), rgba(20, 149, 143, 0.12));
    background-size: 220% 100%;
    transform: translateY(-50%);
    animation: pg-identity-track 5.5s linear infinite;
  }

  .pg-identity-flow span {
    position: relative;
    display: grid;
    gap: 6px;
    min-height: 82px;
    align-content: center;
    border: 1px solid rgba(20, 149, 143, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 12px 34px rgba(23, 32, 51, 0.08);
    color: var(--pg-ink);
    font-size: 0.92rem;
    font-weight: 850;
    padding: 14px;
    transform: translateY(0);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, background 220ms ease;
    animation: pg-identity-rise 520ms ease both;
    animation-delay: calc(var(--flow-index) * 80ms);
