---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const pageCopy = {
  en: {
    title: '100 genomics personalities in Argentina | Pocket Genes',
    description:
      'Join the Pocket Genes campaign to introduce genomics work in Argentina, share useful resources, and participate in interviews and community gatherings.',
    eyebrowStart: 'A Pocket Genes campaign',
    eyebrowEnd: 'Argentina',
    titleAccent: '100 personalities',
    titleMiddle: 'recognized in',
    titlePhrase: 'genomics in Argentina.',
    heroBody:
      'We want to learn about your work and share it with people who research, teach, communicate, and work in genomics in Argentina.',
    cta: 'I want to participate',
    secondaryCta: 'See the options',
    reassurance: 'Creating your profile and participating in the campaign is free.',
    artTopLeft: 'Interview cycle',
    artTopRight: 'Pocket Genes',
    artTitleTop: 'Genomics',
    artTitleBottom: 'in Argentina.',
    artFooter: ['Interviews', 'Ideas', 'Gatherings'],
    featureEyebrow: 'Campaign launch',
    featureTitle: 'A place to publish the conversations already happening in the field.',
    featureBody:
      'Pocket Genes is opening this campaign to introduce professionals, researchers, educators, communicators, and organizations connected to genomics. The profile is the starting point: from there we can coordinate interviews, publish resources, and invite you to community activities.',
    featureByline: 'Hosted by Federico Bustos Fierro',
    featureRole: 'Co-founder · Golden Crow Venture Studio',
    featureQuote:
      'The goal is to make useful work easier to discover, without turning participation into a heavy application process.',
    optionsTitle: 'What would you like to share?',
    optionsIntro:
      'Choose the format that best fits your work. You can start with one option and add more later from your Pocket Genes profile.',
    productCaption:
      'Discover is where Pocket Genes can surface interviews, articles, events, and resources for people following genomics topics.',
    productAlt: 'Pocket Genes Discover screen with genomics content and updates',
    options: [
      {
        icon: 'interviews',
        title: 'Interviews',
        body: 'A conversation about your work, a project, or a topic you want to explain to the community.',
      },
      {
        icon: 'resources',
        title: 'Articles and resources',
        body: 'Texts, references, news, or educational material that can help other people in the field.',
      },
      {
        icon: 'community',
        title: 'Community gatherings',
        body: 'Invitations to meetings, talks, and shared activities connected to genomics in Argentina.',
      },
    ],
    processTitle: 'How joining works',
    processIntro:
      'The form creates an individual profile request and tells us how you want to participate.',
    interviewReview:
      'For interviews, we coordinate the topic, date, and format with you before preparing anything for publication.',
    processSteps: [
      {
        title: 'Create your profile',
        body: 'Share your name, professional context, country, contact email, and the topics you want to discuss.',
      },
      {
        title: 'We review the request',
        body: 'Once approved, we send your access details and use the profile as your public reference.',
      },
      {
        title: 'We coordinate the format',
        body: 'We agree on the best way to publish, share, or present what you want to contribute.',
      },
    ],
    faqTitle: 'Frequently asked questions',
    faqIntro:
      'These are the practical details people usually want to clarify before joining the campaign.',
    faqs: [
      {
        question: 'Who can join?',
        answer:
          'Health professionals, researchers, educators, communicators, and organization leaders connected to genomics in Argentina.',
      },
      {
        question: 'Does participation cost anything?',
        answer: 'No. Creating your profile and participating in the campaign is free.',
      },
      {
        question: 'Can I join without participating in an interview?',
        answer:
          'Yes. Interviews are one option. You can also create your profile and share articles, resources, or events.',
      },
      {
        question: 'How much time does it require?',
        answer:
          'It depends on the activity. Before coordinating anything, we explain what it involves and how much time it usually takes.',
      },
      {
        question: 'Can I review the interview before publication?',
        answer:
          'Yes. We send the interview or article prepared by our team so you can review it before it is published.',
      },
      {
        question: 'Why 100?',
        answer:
          'It is a first campaign goal: to bring together 100 people from different areas of genomics in Argentina and make their work easier to find.',
      },
    ],
    finalTitle: 'Join the campaign',
    finalBody:
      'Create your profile at no cost and tell us what you would like to share with the Pocket Genes community.',
  },
  es: {
    title: '100 personalidades de la genómica en Argentina | Pocket Genes',
    description:
      'Sumate a la campaña de Pocket Genes para dar a conocer trabajos en genómica en Argentina, compartir recursos y participar en entrevistas y encuentros.',
    eyebrowStart: 'Una campaña de Pocket Genes',
    eyebrowEnd: 'Argentina',
    titleAccent: '100 personalidades',
    titleMiddle: 'destacadas de la',
    titlePhrase: 'genómica en Argentina.',
    heroBody:
      'Queremos conocer tu trabajo y compartirlo con quienes investigan, enseñan, comunican y trabajan en genómica en Argentina.',
    cta: 'Quiero participar',
    secondaryCta: 'Ver las opciones',
    reassurance: 'Crear tu perfil y participar en la campaña es gratis.',
    artTopLeft: 'Ciclo de entrevistas',
    artTopRight: 'Pocket Genes',
    artTitleTop: 'Genómica',
    artTitleBottom: 'en Argentina.',
    artFooter: ['Entrevistas', 'Ideas', 'Encuentros'],
    featureEyebrow: 'Lanzamiento de campaña',
    featureTitle: 'Un espacio para publicar las conversaciones que ya existen en el sector.',
    featureBody:
      'Desde Pocket Genes abrimos esta campaña para presentar profesionales, investigadores, docentes, comunicadores y organizaciones vinculadas con la genómica. El perfil es el punto de partida: desde ahí podemos coordinar entrevistas, publicar recursos e invitarte a actividades de la comunidad.',
    featureByline: 'Organiza Federico Bustos Fierro',
    featureRole: 'Co-founder · Golden Crow Venture Studio',
    featureQuote:
      'La idea es que el trabajo útil sea más fácil de encontrar, sin convertir la participación en un trámite pesado.',
    optionsTitle: '¿Qué te gustaría compartir?',
    optionsIntro:
      'Elegí el formato que mejor se adapte a tu trabajo. Podés empezar por una opción y sumar otras más adelante desde tu perfil de Pocket Genes.',
    productCaption:
      'Discover es el espacio donde Pocket Genes puede mostrar entrevistas, artículos, eventos y recursos a quienes siguen temas de genómica.',
    productAlt: 'Pantalla Discover de Pocket Genes con contenidos y novedades sobre genómica',
    options: [
      {
        icon: 'interviews',
        title: 'Entrevistas',
        body: 'Una conversación sobre tu trabajo, un proyecto o un tema que quieras explicar a la comunidad.',
      },
      {
        icon: 'resources',
        title: 'Artículos y recursos',
        body: 'Textos, referencias, novedades o material educativo que pueda servirle a otras personas del sector.',
      },
      {
        icon: 'community',
        title: 'Encuentros con la comunidad',
        body: 'Invitaciones a reuniones, charlas y actividades compartidas sobre genómica en Argentina.',
      },
    ],
    processTitle: 'Cómo sumarte',
    processIntro:
      'El formulario crea una solicitud de perfil individual y nos cuenta cómo querés participar.',
    interviewReview:
      'Para entrevistas, coordinamos con vos el tema, la fecha y el formato antes de preparar cualquier publicación.',
    processSteps: [
      {
        title: 'Creás tu perfil',
        body: 'Compartís tu nombre, contexto profesional, país de trabajo, email de contacto y temas de interés.',
      },
      {
        title: 'Revisamos la solicitud',
        body:
          'Una vez aprobada, te enviamos los datos de acceso y usamos el perfil como referencia pública.',
      },
      {
        title: 'Coordinamos el formato',
        body:
          'Acordamos la mejor forma de publicar, compartir o presentar aquello que quieras aportar.',
      },
    ],
    faqTitle: 'Preguntas frecuentes',
    faqIntro:
      'Estos son los puntos prácticos que suelen aparecer antes de sumarse a la campaña.',
    faqs: [
      {
        question: '¿Quiénes pueden sumarse?',
        answer:
          'Profesionales de la salud, investigadores, docentes, comunicadores y referentes de organizaciones vinculadas con la genómica en Argentina.',
      },
      {
        question: '¿Participar tiene algún costo?',
        answer: 'No. Crear tu perfil y participar en la campaña es gratuito.',
      },
      {
        question: '¿Puedo sumarme sin participar en una entrevista?',
        answer:
          'Sí. Las entrevistas son una opción. También podés crear tu perfil y compartir artículos, recursos o eventos.',
      },
      {
        question: '¿Cuánto tiempo requiere participar?',
        answer:
          'Depende de la actividad. Antes de coordinar cualquier cosa, te contamos en qué consiste y cuánto tiempo suele llevar.',
      },
      {
        question: '¿Puedo revisar la entrevista antes de que se publique?',
        answer:
          'Sí. Te enviamos la entrevista o el artículo que prepare nuestro equipo para que lo revises antes de publicarlo.',
      },
      {
        question: '¿Por qué 100?',
        answer:
          'Es una primera meta de campaña: reunir 100 personas de distintas áreas de la genómica en Argentina y hacer que su trabajo sea más fácil de encontrar.',
      },
    ],
    finalTitle: 'Sumate a la campaña',
    finalBody:
      'Creá tu perfil sin costo y contanos qué te gustaría compartir con la comunidad de Pocket Genes.',
  },
} as const;

const copy = pageCopy[isEnglish ? 'en' : 'es'];
const participateHref = `${localizePath('/pocket-genes/join-us/new/')}?type=individual&campaign=100-publishers`;
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/100-publishers"
  image="/pocket-genes/100-publishers-og.png"
  imageWidth={1200}
  imageHeight={630}
>
  <main id="main" class="pg-page pg100-page">
    <section class="pg100-hero">
      <div class="pg-container">
        <div class="pg100-hero-grid">
          <div class="pg100-hero-copy">
            <p class="pg100-eyebrow">
              <span>{copy.eyebrowStart}</span>
              <span class="pg100-eyebrow-dot" aria-hidden="true"></span>
              <span>{copy.eyebrowEnd}</span>
            </p>
            <h1 class="pg100-title">
              <span class="pg100-title-accent">{copy.titleAccent}</span>
              {copy.titleMiddle}
              <span>{copy.titlePhrase}</span>
            </h1>
            <p class="pg100-lead">{copy.heroBody}</p>
            <div class="pg100-actions">
              <a class="pg100-button pg100-button-primary" href={participateHref}>{copy.cta}</a>
              <a class="pg100-button pg100-button-secondary" href="#opciones">{copy.secondaryCta}</a>
            </div>
            <p class="pg100-reassurance">{copy.reassurance}</p>
          </div>

          <aside class="pg100-art" aria-label="Pocket Genes 100">
            <div class="pg100-art-top">
              <span>{copy.artTopLeft}</span>
              <span>{copy.artTopRight}</span>
            </div>
            <div class="pg100-art-body">
              <div class="pg100-art-number">100</div>
              <p class="pg100-art-title">{copy.artTitleTop}<br />{copy.artTitleBottom}</p>
            </div>
            <div class="pg100-art-footer">
              {copy.artFooter.map((item) => <span>{item}</span>)}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="pg100-section pg100-feature">
      <div class="pg-container">
        <article class="pg100-feature-grid">
          <figure class="pg100-feature-media">
            <img
              src="/team/federico-bustos-gray.webp"
              alt="Federico Bustos Fierro"
              width="600"
              height="600"
              loading="lazy"
            />
            <figcaption>
              <strong>{copy.featureByline}</strong>
              <span>{copy.featureRole}</span>
            </figcaption>
          </figure>
          <div class="pg100-feature-copy">
            <p class="pg100-eyebrow">{copy.featureEyebrow}</p>
            <h2>{copy.featureTitle}</h2>
            <p>{copy.featureBody}</p>
            <blockquote>{copy.featureQuote}</blockquote>
          </div>
        </article>
      </div>
    </section>

    <section id="opciones" class="pg100-section pg100-options">
      <div class="pg-container">
        <div class="pg100-options-grid">
          <div class="pg100-options-copy">
            <div class="pg100-section-head">
              <h2>{copy.optionsTitle}</h2>
              <p>{copy.optionsIntro}</p>
            </div>
            <div class="pg100-option-list">
              {copy.options.map((option) => (
                <article class="pg100-option-item">
                  <span class={`pg100-option-icon icon-${option.icon}`} aria-hidden="true"></span>
                  <div>
                    <h3>{option.title}</h3>
                    <p>{option.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <figure class="pg100-product-demo">
            <div class="pg100-product-frame">
              <img
                src="/pocket-genes/screenshots/discover-simulator-light.webp"
                alt={copy.productAlt}
                width="560"
                height="1217"
                loading="lazy"
              />
            </div>
            <figcaption>{copy.productCaption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="como-funciona" class="pg100-section pg100-process">
      <div class="pg-container">
        <div class="pg100-split-grid">
          <div class="pg100-section-head">
            <h2>{copy.processTitle}</h2>
            <p>{copy.processIntro}</p>
          </div>
          <ol class="pg100-process-list">
            {copy.processSteps.map((step, index) => (
              <li>
                <span class="pg100-step-number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                  {index === 2 && <p class="pg100-step-note">{copy.interviewReview}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="preguntas" class="pg100-section pg100-faq">
      <div class="pg-container">
        <div class="pg100-split-grid">
          <div class="pg100-section-head">
            <h2>{copy.faqTitle}</h2>
            <p>{copy.faqIntro}</p>
          </div>
          <div class="pg100-faq-list">
            {copy.faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pg100-final">
      <div class="pg-container">
        <div class="pg100-final-panel">
          <div>
            <h2>{copy.finalTitle}</h2>
            <p>{copy.finalBody}</p>
          </div>
          <a class="pg100-button pg100-button-final" href={participateHref}>{copy.cta}</a>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg100-page {
    --pg100-ink: #172033;
    --pg100-muted: #526075;
    --pg100-action: #c22f65;
    --pg100-action-hover: #a92556;
    --pg100-blush: #fff8fb;
    --pg100-border: #e7e0e8;
    background: #ffffff;
    color: var(--pg100-ink);
  }

  .pg100-hero,
  .pg100-section,
  .pg100-final {
    scroll-margin-top: 112px;
  }

  .pg100-hero {
    background: var(--pg100-blush);
    padding: 148px 0 96px;
  }

  .pg100-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 608px) minmax(0, 456px);
    gap: 56px;
    align-items: center;
  }

  .pg100-hero-copy,
  .pg100-art,
  .pg100-feature-copy,
  .pg100-feature-media,
  .pg100-product-demo,
  .pg100-product-frame {
    min-width: 0;
  }

  .pg100-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 20px;
    color: #8a2851;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pg100-eyebrow-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: #c9a4b7;
  }

  .pg100-title {
    max-width: 608px;
    margin: 0 0 24px;
    color: var(--pg100-ink);
    font-size: 56px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .pg100-title span {
    display: inline;
  }

  .pg100-title-accent {
    color: var(--pg100-action);
  }

  .pg100-lead {
    max-width: 520px;
    margin: 0 0 32px;
    color: var(--pg100-muted);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
  }

  .pg100-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .pg100-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 14px 24px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .pg100-button:focus-visible,
  .pg100-faq summary:focus-visible,
  .pg100-page a:focus-visible {
    outline: 3px solid #6e3dd9;
    outline-offset: 3px;
  }

  .pg100-button-primary {
    border-color: var(--pg100-action);
    background: var(--pg100-action);
    color: #ffffff;
  }

  .pg100-button-primary:hover {
    background: var(--pg100-action-hover);
    border-color: var(--pg100-action-hover);
  }

  .pg100-button-secondary {
    border-color: #d7d4dc;
    background: transparent;
    color: var(--pg100-ink);
  }

  .pg100-button-secondary:hover {
    border-color: var(--pg100-action);
    background: #fff0f5;
  }

  .pg100-reassurance {
    margin: 12px 0 0;
    color: var(--pg100-muted);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
  }

  .pg100-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 24px;
    background: linear-gradient(145deg, #a53371 0%, #6f3a91 49%, #302656 100%);
    box-shadow: 0 20px 48px rgba(48, 38, 86, 0.14);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pg100-art::after {
    content: "";
    position: absolute;
    width: 410px;
    height: 410px;
    right: -202px;
    bottom: -130px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    box-shadow:
      0 0 0 46px rgba(255, 255, 255, 0.04),
      0 0 0 94px rgba(255, 255, 255, 0.025);
    pointer-events: none;
  }

  .pg100-art-top,
  .pg100-art-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .pg100-art-top span,
  .pg100-art-footer span {
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pg100-art-body {
    position: relative;
    z-index: 1;
  }

  .pg100-art-number {
    margin: 16px 0 12px;
    color: #ffd4e5;
    font-size: 184px;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .pg100-art-title {
    max-width: 280px;
    margin: 0;
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .pg100-art-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 18px;
  }

  .pg100-section {
    padding: 96px 0;
    background: #ffffff;
  }

  .pg100-feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px;
    align-items: center;
  }

  .pg100-feature-media {
    margin: 0;
  }

  .pg100-feature-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    object-fit: cover;
    object-position: center 38%;
    filter: grayscale(1);
  }

  .pg100-feature-media figcaption {
    border-left: 3px solid var(--pg100-action);
    margin-top: 18px;
    padding-left: 16px;
  }

  .pg100-feature-media strong,
  .pg100-feature-media span {
    display: block;
  }

  .pg100-feature-media strong {
    color: var(--pg100-ink);
    font-size: 16px;
    line-height: 1.35;
  }

  .pg100-feature-media span,
  .pg100-product-demo figcaption {
    color: var(--pg100-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .pg100-feature-copy h2,
  .pg100-section-head h2,
  .pg100-final h2 {
    margin: 0 0 18px;
    color: var(--pg100-ink);
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .pg100-feature-copy p,
  .pg100-section-head p {
    margin: 0;
    color: var(--pg100-muted);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
  }

  .pg100-feature-copy blockquote {
    margin: 30px 0 0;
    border-top: 1px solid var(--pg100-border);
    border-bottom: 1px solid var(--pg100-border);
    padding: 22px 0;
    color: var(--pg100-ink);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.45;
  }

  .pg100-options {
    background: #ffffff;
    border-top: 1px solid var(--pg100-border);
  }

  .pg100-options-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px;
    align-items: center;
  }

  .pg100-section-head {
    margin-bottom: 32px;
  }

  .pg100-option-list {
    display: grid;
    gap: 0;
  }

  .pg100-option-item {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 16px;
    border-top: 1px solid var(--pg100-border);
    padding: 24px 0;
  }

  .pg100-option-item:last-child {
    border-bottom: 1px solid var(--pg100-border);
  }

  .pg100-option-icon {
    position: relative;
    width: 20px;
    height: 20px;
    margin-top: 3px;
    color: var(--pg100-action);
  }

  .pg100-option-icon::before,
  .pg100-option-icon::after {
    content: "";
    position: absolute;
    box-sizing: border-box;
  }

  .icon-interviews::before {
    left: 7px;
    top: 1px;
    width: 7px;
    height: 12px;
    border: 1.75px solid currentColor;
    border-radius: 6px;
  }

  .icon-interviews::after {
    left: 4px;
