    eyebrow: 'A Pocket Genes initiative · Argentina',
    titleAccent: '100 voices',
    titleRest: 'in genomics in Argentina.',
    heroBody:
      'We invite you to showcase your work, share your own content, and participate in interview cycles and gatherings with the Pocket Genes community.',
    cta: 'I want to participate',
    secondaryCta: 'How to participate',
    reassurance: 'Creating your profile and participating in the campaign is free.',
    artTopLeft: 'Interview cycle',
    artTopRight: 'Pocket Genes',
    artTitleTop: 'Genomics',
    artTitleBottom: 'in Argentina.',
    benefitItems: [
      {
        title: 'Your network profile',
        body: 'Present your experience and contact information.',
      },
      {
        title: 'Original content',
        body: 'Share articles, resources, and news from your area.',
      },
      {
        title: 'Interviews and gatherings',
        body: 'Join conversations about your work and topics of interest.',
      },
    ],
    formatsTitle: 'Choose how you want to participate',
    formatsIntro:
      'You can join an interview, share your own content, or participate in community gatherings.',
    formats: [
      {
        icon: 'microphone',
        title: 'Interviews',
        body: 'Let’s talk about your work, your projects, or a topic you want to share with the community.',
      },
      {
        icon: 'document',
        title: 'Original content',
        body: 'Publish your articles, share resources, and circulate news from your area of work.',
      },
      {
        icon: 'calendar',
        title: 'Talks and gatherings',
        body: 'Receive invitations to genomics talks and gatherings and meet other people in the field.',
      },
    ],
    profileTitle: 'Your Pocket Genes profile',
    profileItems: [
      'Present your specialty, background, and contact information.',
      'Publish your articles, news, and upcoming events.',
      'Connect with professionals and organizations in the field.',
    ],
    processTitle: 'How to join',
    processIntro:
      'The first step is to create your profile. Then you can choose the proposals that interest you.',
    processSteps: [
      {
        title: 'Create your profile',
        body: 'Complete the form with your information and a brief description of your activity.',
      },
      {
        title: 'Receive your access details',
        body: 'Once your request is approved, we send your login details by email.',
      },
      {
        title: 'Choose how to participate',
        body: 'You can share content, publish events, and join interviews and activities that interest you.',
      },
    ],
    interviewNoteLabel: 'If you participate in an interview',
    interviewNote:
      'We agree on the topic and meeting with you. Our team prepares the material and sends it to you for review before publishing.',
    faqTitle: 'Frequently asked questions',
    faqs: [
      {
        question: 'Who can join?',
        answer:
          'Health professionals, researchers, educators, communicators, and organization leaders connected to genomics in Argentina.',
      },
      {
        question: 'Does participation cost anything?',
        answer: 'No. Creating your profile and participating in the campaign is free.',
      },
      {
        question: 'Can I join without participating in an interview?',
        answer:
          'Yes. You can create your profile and share content with the network. Interviews are one of the campaign proposals.',
      },
      {
        question: 'How much time does participation require?',
        answer:
          'It depends on the activity you choose. Before coordinating it, we explain what it involves and how much time it takes.',
      },
      {
        question: 'Can I review the interview before it is published?',
        answer:
          'Yes. We send you the interview or article prepared by our team so you can review it before publication.',
      },
      {
        question: 'Why 100?',
        answer:
          'We want to bring together 100 people from different areas of genomics in Argentina to showcase their work and share their knowledge.',
      },
    ],
    finalTitle: 'Join the campaign',
    finalBody:
      'Create your profile at no cost and tell us what you would like to share with the community.',
  },
  es: {
    title: '100 personalidades de la genómica en Argentina | Pocket Genes',
    description:
      'Sumate a la campaña de Pocket Genes para dar a conocer tu trabajo en genómica, compartir contenido y participar en entrevistas y encuentros.',
    eyebrow: 'Una iniciativa de Pocket Genes · Argentina',
    titleAccent: '100 personalidades',
    titleRest: 'destacadas de la genómica en Argentina.',
    heroBody:
      'Te invitamos a dar a conocer tu trabajo, compartir contenido propio y participar en ciclos de entrevistas y encuentros con la comunidad de Pocket Genes.',
    cta: 'Quiero participar',
    secondaryCta: 'Cómo participar',
    reassurance: 'Crear tu perfil y participar en la campaña es gratis.',
    artTopLeft: 'Ciclo de entrevistas',
    artTopRight: 'Pocket Genes',
    artTitleTop: 'Genómica',
    artTitleBottom: 'en Argentina.',
    benefitItems: [
      {
        title: 'Tu perfil en la red',
        body: 'Presentá tu experiencia y tus datos de contacto.',
      },
      {
        title: 'Contenido propio',
        body: 'Compartí artículos, recursos y novedades de tu área.',
      },
      {
        title: 'Entrevistas y encuentros',
        body: 'Participá en conversaciones sobre tu trabajo y temas de tu interés.',
      },
    ],
    formatsTitle: 'Elegí cómo querés participar',
    formatsIntro:
      'Podés sumarte a una entrevista, compartir contenido propio o participar en encuentros con la comunidad.',
    formats: [
      {
        icon: 'microphone',
        title: 'Entrevistas',
        body:
          'Conversemos sobre tu trabajo, tus proyectos o algún tema que te interese compartir con la comunidad.',
      },
      {
        icon: 'document',
        title: 'Contenido propio',
        body: 'Publicá tus artículos, compartí recursos y difundí novedades de tu área de trabajo.',
      },
      {
        icon: 'calendar',
        title: 'Charlas y encuentros',
        body:
          'Recibí invitaciones a charlas y encuentros sobre genómica y conocé a otras personas del sector.',
      },
    ],
    profileTitle: 'Tu perfil en Pocket Genes',
    profileItems: [
      'Presentá tu especialidad, tu trayectoria y tus datos de contacto.',
      'Publicá tus artículos, novedades y próximos eventos.',
      'Conectá con profesionales y organizaciones del sector.',
    ],
    processTitle: 'Cómo sumarte',
    processIntro:
      'El primer paso es crear tu perfil. Después, podés elegir las propuestas que te interesen.',
    processSteps: [
      {
        title: 'Creás tu perfil',
        body: 'Completás el formulario con tus datos y una breve descripción de tu actividad.',
      },
      {
        title: 'Recibís tus datos de acceso',
        body:
          'Una vez aprobada tu solicitud, te enviamos por email los datos para ingresar.',
      },
      {
        title: 'Elegís cómo participar',
        body:
          'Podés compartir contenido, publicar eventos y sumarte a las entrevistas y actividades que te interesen.',
      },
    ],
    interviewNoteLabel: 'Si participás en una entrevista',
    interviewNote:
      'Acordamos el tema y el encuentro con vos. Nuestro equipo prepara el material y te lo envía para que lo revises antes de publicarlo.',
    faqTitle: 'Preguntas frecuentes',
    faqs: [
      {
        question: '¿Quiénes pueden sumarse?',
        answer:
          'Profesionales de la salud, investigadores, docentes, comunicadores y referentes de organizaciones vinculadas con la genómica en Argentina.',
      },
      {
        question: '¿Participar tiene algún costo?',
        answer: 'No. Crear tu perfil y participar en la campaña es gratuito.',
      },
      {
        question: '¿Puedo sumarme sin participar en una entrevista?',
        answer:
          'Sí. Podés crear tu perfil y compartir contenido con la red. Las entrevistas son una de las propuestas de la campaña.',
      },
      {
        question: '¿Cuánto tiempo requiere participar?',
        answer:
          'Depende de la actividad que elijas. Antes de coordinarla, te contamos en qué consiste y cuánto tiempo lleva.',
      },
      {
        question: '¿Puedo revisar la entrevista antes de que se publique?',
        answer:
          'Sí. Te enviamos la entrevista o el artículo que prepare nuestro equipo para que lo revises antes de publicarlo.',
      },
      {
        question: '¿Por qué 100?',
        answer:
          'Queremos reunir a 100 personas de distintas áreas de la genómica en Argentina para dar a conocer su trabajo y compartir sus conocimientos.',
      },
    ],
    finalTitle: 'Sumate a la campaña',
    finalBody:
      'Creá tu perfil sin costo y contanos qué te gustaría compartir con la comunidad.',
  },
} as const;

const copy = pageCopy[isEnglish ? 'en' : 'es'];
const participateHref = `${localizePath('/pocket-genes/join-us/new/')}?type=individual&campaign=100-publishers`;

function renderFormatIcon(icon: string) {
  if (icon === 'microphone') {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z"/><path d="M5 10v1a7 7 0 0 0 14 0v-1"/><path d="M12 18v3"/><path d="M8 21h8"/></svg>`;
  }
  if (icon === 'document') {
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v5h4"/><path d="M10 12h5"/><path d="M10 16h5"/></svg>`;
  }
  return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v3"/><path d="M17 4v3"/><path d="M5 8h14"/><path d="M6 6h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"/><path d="M8 12h3"/><path d="M8 16h5"/></svg>`;
}
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/100-publishers"
  image="/pocket-genes/100-publishers-og.png"
  imageWidth={1200}
  imageHeight={630}
>
  <main id="main" class="pg-page pg100-page">
    <section class="pg100-hero">
      <div class="pg100-shell">
        <div class="pg100-hero-grid">
          <div class="pg100-hero-copy">
            <p class="pg100-eyebrow">{copy.eyebrow}</p>
            <h1 class="pg100-title">
              <span class="pg100-title-accent">{copy.titleAccent}</span> {copy.titleRest}
            </h1>
            <p class="pg100-lead">{copy.heroBody}</p>
            <div class="pg100-actions">
              <a class="pg100-button pg100-button-primary" href={participateHref}>{copy.cta}</a>
              <a class="pg100-button pg100-button-secondary" href="#como-participar">{copy.secondaryCta}</a>
            </div>
            <p class="pg100-reassurance">{copy.reassurance}</p>
          </div>

          <aside class="pg100-art" aria-label="Pocket Genes 100">
            <div class="pg100-art-top">
              <span>{copy.artTopLeft}</span>
              <span>{copy.artTopRight}</span>
            </div>
            <div class="pg100-art-body">
              <div class="pg100-art-number">100</div>
              <p class="pg100-art-title">{copy.artTitleTop}<br />{copy.artTitleBottom}</p>
            </div>
            <div class="pg100-art-footer">
              <span>{copy.benefitItems[2].title.split(' ')[0]}</span>
              <span>{isEnglish ? 'Ideas' : 'Ideas'}</span>
              <span>{isEnglish ? 'Gatherings' : 'Encuentros'}</span>
            </div>
          </aside>
        </div>

        <div class="pg100-benefit-strip" aria-label={copy.formatsTitle}>
          {copy.benefitItems.map((item, index) => (
            <article class={`pg100-benefit-item item-${index + 1}`}>
              <h2>{item.title}</h2>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como-participar" class="pg100-section pg100-formats">
      <div class="pg100-shell">
        <div class="pg100-section-head">
          <h2>{copy.formatsTitle}</h2>
          <p>{copy.formatsIntro}</p>
        </div>
        <div class="pg100-format-grid">
          {copy.formats.map((format) => (
            <article class="pg100-format-card">
              <span class="pg100-format-icon" set:html={renderFormatIcon(format.icon)} />
              <div>
                <h3>{format.title}</h3>
                <p>{format.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg100-section pg100-profile">
      <div class="pg100-shell pg100-profile-inner">
        <h2>{copy.profileTitle}</h2>
        <ul>
          {copy.profileItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="como-funciona" class="pg100-section pg100-process">
      <div class="pg100-shell">
        <div class="pg100-section-head">
          <h2>{copy.processTitle}</h2>
          <p>{copy.processIntro}</p>
        </div>
        <ol class="pg100-process-list">
          {copy.processSteps.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
        <div class="pg100-interview-note">
          <strong>{copy.interviewNoteLabel}</strong>
          <p>{copy.interviewNote}</p>
        </div>
      </div>
    </section>

    <section id="preguntas" class="pg100-section pg100-faq">
      <div class="pg100-faq-inner">
        <h2>{copy.faqTitle}</h2>
        <div class="pg100-faq-list">
          {copy.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pg100-final">
      <div class="pg100-final-inner">
        <h2>{copy.finalTitle}</h2>
        <p>{copy.finalBody}</p>
        <a class="pg100-button pg100-button-primary" href={participateHref}>{copy.cta}</a>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg100-page {
    --pg100-ink: #172033;
    --pg100-muted: #526075;
    --pg100-action: #c22f65;
    --pg100-action-hover: #a82657;
    --pg100-purple: #6e3dd9;
    --pg100-blush: #fff4f8;
    --pg100-hero-bg: #fff8fb;
    --pg100-border: #e5dfe7;
    --pg100-soft-border: #eadfe7;
    --pg100-final: #171d3c;
    background: #ffffff;
    color: var(--pg100-ink);
    font-family: Arial, Helvetica, sans-serif;
  }

  .pg100-shell {
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 36px;
  }

  .pg100-hero,
  .pg100-section,
  .pg100-final {
    scroll-margin-top: 112px;
  }

  .pg100-hero {
    background: var(--pg100-hero-bg);
    padding: 138px 0 0;
  }

  .pg100-hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 0 4px 54px;
  }

  .pg100-eyebrow {
    margin: 0 0 18px;
    color: #8a2851;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: 1.25px;
    text-transform: uppercase;
  }

  .pg100-title {
    margin: 0 0 24px;
    color: #172033;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -2px;
  }

  .pg100-title-accent {
    color: #c22f65;
  }

  .pg100-lead {
    max-width: 470px;
    margin: 0 0 26px;
    color: #526075;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
  }

  .pg100-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pg100-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 13px 19px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .pg100-button-primary {
    border-color: #c22f65;
    background: #c22f65;
    color: #ffffff;
  }

  .pg100-button-primary:hover {
    background: #a82657;
  }

  .pg100-button-secondary {
    border-color: #d7d4dc;
    background: #ffffff;
    color: #172033;
  }

  .pg100-button-secondary:hover {
    background: #fff0f5;
  }

  .pg100-reassurance {
    margin: 15px 0 0;
    color: #526075;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.6;
  }

  .pg100-art {
    position: relative;
    min-height: 468px;
    overflow: hidden;
    border-radius: 22px;
    background: linear-gradient(145deg, #a53371 0%, #6f3a91 49%, #302656 100%);
    box-shadow: 0 22px 48px #49204820;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pg100-art::after {
    content: "";
    position: absolute;
    width: 410px;
    height: 410px;
    right: -202px;
    bottom: -130px;
    border: 1px solid #ffffff26;
    border-radius: 50%;
    box-shadow:
      0 0 0 46px #ffffff06,
      0 0 0 94px #ffffff04;
    pointer-events: none;
  }

  .pg100-art-top,
  .pg100-art-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .pg100-art-top span {
    color: #ffe3ef;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .pg100-art-body {
    position: relative;
    z-index: 1;
  }

  .pg100-art-number {
    margin: 14px 0;
    color: #ffd1e2;
    font-size: clamp(140px, 20vw, 204px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -13px;
  }

  .pg100-art-title {
    max-width: 240px;
    margin: 0 0 20px;
    color: #ffffff;
    font-size: 31px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.8px;
  }

  .pg100-art-footer {
    border-top: 1px solid #ffffff40;
    padding-top: 17px;
  }

  .pg100-art-footer span {
    color: #ffe3ef;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .pg100-benefit-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    border-top: 1px solid #eadfe7;
    background: #ffffff;
    padding: 34px 40px 38px;
  }

  .pg100-benefit-item {
    border-left: 3px solid #e45080;
    padding-left: 17px;
  }

  .pg100-benefit-item.item-2 {
    border-left-color: #6e3dd9;
  }

  .pg100-benefit-item.item-3 {
    border-left-color: #172033;
  }

  .pg100-benefit-item h2 {
    margin: 0 0 8px;
    color: #172033;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.25px;
  }

  .pg100-benefit-item p {
    margin: 0;
    color: #526075;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
  }

  .pg100-section {
    padding: 64px 0;
  }

  .pg100-section-head {
    max-width: 720px;
  }

  .pg100-section-head h2,
  .pg100-profile-inner h2,
  .pg100-faq-inner h2,
  .pg100-final h2 {
    margin: 0 0 16px;
    color: #172033;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.8px;
  }

  .pg100-section-head p {
    max-width: 620px;
    margin: 0 0 28px;
    color: #526075;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
  }

  .pg100-format-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .pg100-format-card {
    display: grid;
    gap: 20px;
    border: 1px solid #e5dfe7;
    border-radius: 16px;
    background: #ffffff;
    padding: 24px;
  }

  .pg100-format-icon {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid #e7d9e3;
    border-radius: 12px;
    color: #c22f65;
  }

  .pg100-format-icon :global(svg) {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .pg100-format-card h3 {
    margin: 0 0 12px;
    color: #172033;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.3px;
  }

  .pg100-format-card p {
    margin: 0;
    color: #526075;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }

  .pg100-profile {
    background: #fff4f8;
  }

  .pg100-profile-inner {
    max-width: 720px;
  }

  .pg100-profile-inner ul {
    display: grid;
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .pg100-profile-inner li {
    border-left: 3px solid #c22f65;
    padding-left: 17px;
    color: #172033;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
  }

  .pg100-process-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg100-process-list li {
    border-top: 2px solid #e7c8d7;
    padding-top: 13px;
  }

  .pg100-process-list span {
    display: block;
    margin-bottom: 12px;
    color: #c22f65;
    font-size: 12px;
    font-weight: 700;
  }

  .pg100-process-list h3 {
    margin: 0 0 10px;
    color: #172033;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }

  .pg100-process-list p {
    margin: 0;
    color: #526075;
