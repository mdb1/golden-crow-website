---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const pageCopy = {
  en: {
    title: '100 voices campaign | Pocket Genes',
    description:
      'An invitation for genomics leaders in Argentina to join interviews, share knowledge, and participate in Pocket Genes events.',
    heroTitle: '100 leading voices in genomics in Argentina.',
    heroBody:
      'We are inviting people whose work in companies, institutions, research, care, advocacy, education, or communication gives them something valuable to contribute to the Pocket Genes network.',
    heroNote:
      'Our team coordinates the conversations, edits the material, and publishes each contribution with participant review before publication.',
    cta: 'I want to participate',
    secondaryCta: 'See how it works',
    purposeTitle: 'The campaign and its purpose',
    purposeBody:
      'The goal is to bring real experience and ideas from the Argentine genomics ecosystem into Pocket Genes: practical knowledge, field stories, research paths, institutional work, communication efforts, and projects that can help more people understand what is happening in the sector.',
    activitiesTitle: 'What participation looks like',
    activitiesIntro: 'People can choose the activities that interest them. Participation can include one format or several.',
    activities: [
      {
        title: 'Interviews',
        body: 'Conversations about your work, experience, projects, and the challenges facing the genomics sector.',
      },
      {
        title: 'Content',
        body: 'Our team turns those conversations into interviews, articles, excerpts, and educational pieces for Pocket Genes.',
      },
      {
        title: 'Events',
        body: 'Participants receive invitations to talks, meetings, and discussions, with opportunities to join as guests or speakers when relevant.',
      },
    ],
    valueTitle: 'Why participate',
    valueItems: [
      'Give visibility to your work and point of view.',
      'Reach people interested in your expertise.',
      'Introduce projects, initiatives, research, or educational work.',
      'Make contacts across companies, institutions, research, care, advocacy, and communication.',
    ],
    participationNote:
      'Participation is free. Pocket Genes handles coordination, editing, and publication, and participants review their contributions before anything is published.',
    processTitle: 'How it works',
    processSteps: [
      'Express interest',
      'Have an introductory conversation',
      'Agree on a topic and format',
      'Schedule the activity',
    ],
    processBody:
      'Joining should feel manageable. We discuss the expected time commitment before scheduling anything.',
    invitationTitle: 'The invitation',
    invitationBody:
      'The interest form asks for your name, email, role, organization if applicable, topics you would like to discuss, and an optional public profile link so we can understand your background.',
    upcomingTitle: 'Published conversations and upcoming activities',
    upcomingBody:
      'As interviews, articles, and events become available, this page can feature the work produced together and make the campaign visible through real contributions.',
    upcomingStatus: 'Coming soon',
  },
  es: {
    title: 'Campaña 100 personalidades | Pocket Genes',
    description:
      'Una invitación para que referentes de la genómica en Argentina participen en entrevistas, compartan conocimiento y formen parte de eventos de Pocket Genes.',
    heroTitle: '100 personalidades destacadas de la genómica en Argentina.',
    heroBody:
      'Estamos invitando a personas cuyo trabajo en empresas, instituciones, investigación, atención, comunicación, educación o comunidad tiene algo valioso para aportar a la red de Pocket Genes.',
    heroNote:
      'Nuestro equipo coordina las conversaciones, edita el material y publica cada contribución con revisión previa de quienes participan.',
    cta: 'Quiero participar',
    secondaryCta: 'Ver cómo funciona',
    purposeTitle: 'La campaña y su propósito',
    purposeBody:
      'El objetivo es acercar a Pocket Genes experiencias e ideas reales del ecosistema genómico argentino: conocimiento práctico, recorridos profesionales, investigación, trabajo institucional, comunicación científica y proyectos que puedan ayudar a más personas a entender qué está pasando en el sector.',
    activitiesTitle: 'Cómo podés participar',
    activitiesIntro: 'Cada persona puede elegir las actividades que le interesen. La participación puede ser en uno o varios formatos.',
    activities: [
      {
        title: 'Entrevistas',
        body: 'Conversaciones sobre tu trabajo, experiencia, proyectos y los desafíos que enfrenta el sector genómico.',
      },
      {
        title: 'Contenido',
        body: 'Nuestro equipo transforma esas conversaciones en entrevistas, artículos, fragmentos y piezas educativas para Pocket Genes.',
      },
      {
        title: 'Eventos',
        body: 'Quienes participan reciben invitaciones a charlas, encuentros y discusiones, con oportunidades de sumarse como invitados o speakers cuando corresponda.',
      },
    ],
    valueTitle: 'Por qué participar',
    valueItems: [
      'Dar visibilidad a tu trabajo y a tu mirada.',
      'Llegar a personas interesadas en tu experiencia.',
      'Presentar proyectos, iniciativas, investigación o trabajo educativo.',
      'Generar contactos entre empresas, instituciones, investigación, salud, comunidad y comunicación.',
    ],
    participationNote:
      'La participación es gratuita. Pocket Genes se ocupa de la coordinación, edición y publicación, y cada participante revisa sus contribuciones antes de que se publiquen.',
    processTitle: 'Cómo funciona',
    processSteps: [
      'Expresás interés',
      'Tenemos una conversación introductoria',
      'Acordamos tema y formato',
      'Coordinamos la actividad',
    ],
    processBody:
      'Sumarse tiene que ser manejable. Conversamos el tiempo requerido antes de agendar cualquier actividad.',
    invitationTitle: 'La invitación',
    invitationBody:
      'El formulario de interés pide tu nombre, email, rol, organización si corresponde, los temas sobre los que te gustaría conversar y un enlace público opcional para entender mejor tu recorrido.',
    upcomingTitle: 'Conversaciones publicadas y próximas actividades',
    upcomingBody:
      'A medida que haya entrevistas, artículos y eventos disponibles, esta página puede mostrar el trabajo producido en conjunto y darle sustancia a la campaña con contribuciones reales.',
    upcomingStatus: 'Próximamente',
  },
} as const;

const copy = pageCopy[isEnglish ? 'en' : 'es'];
const participateHref = `${localizePath('/pocket-genes/join-us/new/')}?type=individual&campaign=100-publishers`;
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/100-publishers"
>
  <main id="main" class="pg-page pg-100-page">
    <section class="pg-100-hero">
      <div class="pg-container pg-100-hero-inner">
        <h1>{copy.heroTitle}</h1>
        <p class="pg-100-lead">{copy.heroBody}</p>
        <div class="pg-100-hero-actions">
          <a class="pg-100-hero-cta" href={participateHref}>{copy.cta}</a>
          <a class="pg-100-secondary-link" href="#como-funciona">{copy.secondaryCta}</a>
        </div>
        <div class="pg-100-hero-note">
          <span aria-hidden="true"></span>
          <p>{copy.heroNote}</p>
        </div>
      </div>
      <span class="pg-100-hero-number" aria-hidden="true">100</span>
    </section>

    <div class="pg-100-shared-band">
      <section class="pg-section pg-100-purpose">
        <div class="pg-container pg-100-split">
          <div>
            <p class="pg-eyebrow">01</p>
            <h2>{copy.purposeTitle}</h2>
          </div>
          <p>{copy.purposeBody}</p>
        </div>
      </section>

      <section class="pg-section-tight pg-100-activities">
        <div class="pg-container">
          <div class="pg-section-heading">
            <p class="pg-eyebrow">02</p>
            <h2>{copy.activitiesTitle}</h2>
            <p>{copy.activitiesIntro}</p>
          </div>
          <div class="pg-100-activity-grid">
            {copy.activities.map((activity, index) => (
              <article class="pg-100-activity-card">
                <span class={`pg-100-activity-icon icon-${index + 1}`} aria-hidden="true"></span>
                <strong>{String(index + 1).padStart(2, '0')}</strong>
                <h3>{activity.title}</h3>
                <p>{activity.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="pg-section pg-100-value">
        <div class="pg-container pg-100-value-grid">
          <div>
            <p class="pg-eyebrow">03</p>
            <h2>{copy.valueTitle}</h2>
            <p>{copy.participationNote}</p>
          </div>
          <ul>
            {copy.valueItems.map((item) => (
              <li>
                <span aria-hidden="true"></span>
                <p>{item}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <section id="como-funciona" class="pg-section-tight pg-100-process">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">04</p>
          <h2>{copy.processTitle}</h2>
          <p>{copy.processBody}</p>
        </div>
        <ol class="pg-100-process-list">
          {copy.processSteps.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="pg-section pg-100-invitation">
      <div class="pg-container pg-100-invitation-panel">
        <div>
          <p class="pg-eyebrow">05</p>
          <h2>{copy.invitationTitle}</h2>
          <p>{copy.invitationBody}</p>
        </div>
        <div class="pg-100-invitation-action">
          <a class="pg-100-hero-cta" href={participateHref}>{copy.cta}</a>
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-100-upcoming">
      <div class="pg-container pg-100-upcoming-panel">
        <div>
          <span>{copy.upcomingStatus}</span>
          <h2>{copy.upcomingTitle}</h2>
          <p>{copy.upcomingBody}</p>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-100-page {
    background: #ffffff;
  }

  .pg-100-hero {
    position: relative;
    isolation: isolate;
    min-height: 620px;
    display: flex;
    align-items: flex-end;
    padding: 124px 0 34px;
    background: #ffffff;
    color: var(--pg-ink);
    overflow: hidden;
  }

  .pg-100-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(1240px, calc(100% - 32px));
    max-width: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pg-100-hero h1 {
    max-width: 1180px;
    margin: 0;
    font-size: clamp(2.65rem, 4.8vw, 4.35rem);
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .pg-100-hero-number {
    position: absolute;
    right: max(18px, calc((100vw - 1120px) / 2));
    bottom: -0.28em;
    z-index: 0;
    color: rgba(228, 80, 128, 0.08);
    font-size: clamp(9rem, 25vw, 19rem);
    font-weight: 950;
    line-height: 1;
    pointer-events: none;
  }

  .pg-100-lead {
    max-width: 780px;
    margin: 24px 0 0;
    color: var(--pg-ink-soft);
    font-size: clamp(1.06rem, 2vw, 1.22rem);
    line-height: 1.62;
    text-wrap: balance;
  }

  .pg-100-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 42px;
  }

  .pg-100-hero-cta,
  .pg-100-secondary-link {
    display: inline-flex;
    min-height: 64px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 34px;
    font-size: 1.12rem;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .pg-100-hero-cta {
    background: #2d7edc;
    color: #ffffff;
    box-shadow: 0 14px 30px rgba(33, 118, 174, 0.16), 0 5px 14px rgba(41, 49, 139, 0.08);
  }

  .pg-100-hero-cta:hover {
    background: #3389ed;
    box-shadow: 0 18px 34px rgba(33, 118, 174, 0.21), 0 8px 18px rgba(41, 49, 139, 0.1);
    transform: translateY(-2px);
  }

  .pg-100-secondary-link {
    border: 1px solid var(--pg-border-strong);
    background: #ffffff;
    color: var(--pg-ink-soft);
  }

  .pg-100-secondary-link:hover {
    border-color: var(--pg-blue);
    color: var(--pg-blue);
    box-shadow: 0 10px 24px rgba(33, 118, 174, 0.12);
    transform: translateY(-2px);
  }

  .pg-100-hero-note {
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr);
    gap: 14px;
    max-width: 760px;
    margin-top: 38px;
    text-align: left;
  }

  .pg-100-hero-note span {
    width: 4px;
    min-height: 100%;
    border-radius: 999px;
    background: var(--pg-rose);
  }

  .pg-100-hero-note p {
    margin: 0;
    color: var(--pg-ink-soft);
    font-size: 1rem;
    line-height: 1.55;
  }

  .pg-100-shared-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      linear-gradient(132deg, #141a45 0%, #172033 42%, #29318b 67%, #0d6d70 100%),
      linear-gradient(90deg, rgba(228, 80, 128, 0.26), rgba(20, 149, 143, 0.2));
    color: #ffffff;
  }

  .pg-100-shared-band::before {
    content: "";
    position: absolute;
    top: -64px;
    left: 50%;
    z-index: 0;
    width: 118%;
    height: 128px;
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #ffffff 42%,
      rgba(255, 255, 255, 0.96) 62%,
      rgba(255, 255, 255, 0.68) 80%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: translateX(-50%);
    pointer-events: none;
  }

  .pg-100-shared-band > section {
    position: relative;
    z-index: 1;
  }

  .pg-100-purpose {
    padding-top: 168px;
  }

  .pg-100-split,
  .pg-100-value-grid,
  .pg-100-invitation-panel {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .pg-100-split h2,
  .pg-100-value h2,
  .pg-100-invitation h2,
  .pg-100-upcoming h2 {
    margin: 0;
    font-size: clamp(2.15rem, 4vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .pg-100-shared-band .pg-eyebrow {
    color: #6bd0c9;
  }

  .pg-100-shared-band .pg-section-heading {
    max-width: 840px;
  }

  .pg-100-shared-band .pg-section-heading h2 {
    color: #ffffff;
  }

  .pg-100-shared-band .pg-section-heading p {
    color: rgba(255, 255, 255, 0.72);
  }

  .pg-100-split > p,
  .pg-100-value-grid > div p,
  .pg-100-invitation-panel p {
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.12rem;
    line-height: 1.72;
  }

  .pg-100-activity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .pg-100-activity-card {
    position: relative;
    overflow: hidden;
    min-height: 280px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.07);
    padding: 26px;
  }

  .pg-100-activity-card strong {
    display: block;
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .pg-100-activity-card h3 {
    margin: 12px 0 8px;
    color: #ffffff;
    font-size: 1.28rem;
    line-height: 1.22;
  }

  .pg-100-activity-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.55;
  }

  .pg-100-activity-icon {
    position: relative;
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--pg-teal);
  }

  .pg-100-activity-icon::before,
  .pg-100-activity-icon::after {
    content: "";
    position: absolute;
    background: currentColor;
  }

  .icon-1::before {
    width: 24px;
    height: 16px;
    left: 12px;
    top: 13px;
    border-radius: 10px 10px 10px 3px;
  }

  .icon-1::after {
    width: 12px;
    height: 3px;
    left: 18px;
    top: 20px;
    border-radius: 999px;
    background: #ffffff;
  }

  .icon-2 {
    color: var(--pg-rose);
  }

  .icon-2::before {
    width: 22px;
    height: 26px;
    left: 13px;
    top: 11px;
    border-radius: 4px;
  }

  .icon-2::after {
    width: 12px;
    height: 2px;
    left: 18px;
    top: 19px;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 6px 0 #ffffff;
  }

  .icon-3 {
    color: #d99232;
  }

  .icon-3::before {
    width: 24px;
    height: 22px;
    left: 12px;
    top: 14px;
    border-radius: 5px;
  }

  .icon-3::after {
    width: 24px;
    height: 5px;
    left: 12px;
    top: 18px;
    background: #ffffff;
  }

  .pg-100-value ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-100-value li {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding: 18px 0;
  }

  .pg-100-value li:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .pg-100-value li span {
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 999px;
    background: var(--pg-rose);
  }

  .pg-100-value li:nth-child(2n) span {
    background: #6bd0c9;
  }

  .pg-100-value li p {
    margin: 0;
    color: #ffffff;
    font-weight: 740;
    line-height: 1.48;
  }

  .pg-100-process {
    background: #ffffff;
    padding-top: 84px;
  }

  .pg-100-process-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .pg-100-process-list li {
    min-height: 168px;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #fbfcfd;
    padding: 22px;
  }

  .pg-100-process-list span {
    display: block;
    color: var(--pg-rose);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .pg-100-process-list strong {
    display: block;
    margin-top: 34px;
    color: var(--pg-ink);
    font-size: 1.06rem;
    line-height: 1.32;
  }

  .pg-100-invitation {
    background: #fbfcfd;
    color: var(--pg-ink);
  }

  .pg-100-invitation .pg-eyebrow {
    color: var(--pg-rose);
  }

  .pg-100-invitation-panel {
    align-items: center;
    border-top: 1px solid var(--pg-border);
    border-bottom: 1px solid var(--pg-border);
    padding: 44px 0;
  }

  .pg-100-invitation-panel p {
    color: var(--pg-ink-soft);
    margin-top: 16px;
  }

  .pg-100-invitation-action {
    justify-self: end;
  }

  .pg-100-upcoming {
    background: #ffffff;
  }

  .pg-100-upcoming-panel {
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #fbfcfd;
    padding: clamp(24px, 4vw, 42px);
  }

  .pg-100-upcoming span {
    display: inline-flex;
    margin-bottom: 14px;
    border-radius: 999px;
    background: #edf6ff;
    color: #155f8d;
    padding: 7px 12px;
    font-size: 0.82rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-100-upcoming p {
    max-width: 820px;
    color: var(--pg-ink-soft);
    margin-top: 14px;
  }

  @media (max-width: 920px) {
    .pg-100-hero {
      min-height: auto;
      padding: 108px 0 56px;
    }

    .pg-100-split,
    .pg-100-value-grid,
    .pg-100-invitation-panel {
      grid-template-columns: 1fr;
    }

    .pg-100-activity-grid {
      grid-template-columns: 1fr;
    }

    .pg-100-activity-card {
      min-height: auto;
    }

    .pg-100-process-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pg-100-invitation-action {
      justify-self: start;
    }
  }

  @media (max-width: 640px) {
    .pg-100-hero {
      padding-top: 104px;
    }

    .pg-100-hero h1 {
      font-size: 2.35rem;
    }

    .pg-100-hero-actions,
    .pg-100-hero-cta,
    .pg-100-secondary-link {
      width: 100%;
    }

    .pg-100-lead {
      font-size: 1.04rem;
    }

    .pg-100-process-list {
      grid-template-columns: 1fr;
    }
  }
</style>
