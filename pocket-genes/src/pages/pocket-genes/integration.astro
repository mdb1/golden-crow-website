---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../layouts/Hero.astro';
import IntroPlan from '../../layouts/IntroPlan.astro';
import Plan from '../../layouts/Plan.astro';
import Panels from '../../layouts/Panels.astro';
import SecondSection from '../../layouts/SecondSection.astro';
import AppScreenshots from '../../layouts/AppScreenshots.astro';
import ThirdSection from '../../layouts/ThirdSection.astro';
import IntegrationOutcome from '../../layouts/IntegrationOutcome.astro';
import ProviderDiscovery from '../../layouts/ProviderDiscovery.astro';
import IntegrationJourney from '../../layouts/IntegrationJourney.astro';
import TrustBoundaries from '../../layouts/TrustBoundaries.astro';
import Experience from '../../layouts/Experience.astro';
import { useTranslations } from '../../i18n/index';

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t.pocketGenes.integrationTitle} showFooter={false} extraHeadScripts={["https://link.centralize.es/js/form_embed.js"]}>
  <main class="pocket-genes-page">
    <Hero />
    <ThirdSection />
    <IntegrationOutcome />
    <SecondSection />
    <AppScreenshots />
    <Panels />
    <ProviderDiscovery />
    <IntegrationJourney />
    <IntroPlan />
    <Plan />
    <TrustBoundaries />
    <Experience />

    <section class="contact-cta-section">
      <div class="contact-cta-container">
        <div class="cta-content">
          <h2>{t.pocketGenes.integrationCtaTitle}</h2>
          <p>{t.pocketGenes.integrationCtaDesc}</p>
          <a href="#booking" class="contact-cta-button">{t.pocketGenes.integrationCtaButton}</a>
        </div>
      </div>
    </section>

    <section id="booking" class="booking-section">
      <div class="container">
        <div class="booking-content">
          <h2>{t.index.bookingTitle.toLocaleUpperCase('es-AR')}</h2>
          <p>{t.index.bookingDesc}</p>
          <div class="calendar-wrapper">
            <iframe src="https://link.centralize.es/widget/booking/0K86F8BvSkmicNKU6Nyj" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="0K86F8BvSkmicNKU6Nyj_1770156246220"></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 4rem;
  }

  body {
    font-weight: 400;
  }

  .pocket-genes-page {
    margin-top: clamp(60px, 10vw, 80px);
  }

  :global(.pocket-genes-page > *) {
    border-top: 1px solid rgba(17, 24, 39, 0.06);
  }

  :global(.pocket-genes-page > :first-child) {
    border-top: 0;
  }

  :global(.pocket-genes-page > :nth-child(odd)) {
    background: var(--bg-secondary) !important;
  }

  :global(.pocket-genes-page > :nth-child(even)) {
    background: var(--bg-primary) !important;
  }

  .contact-cta-section {
    padding: 6rem 0;
    background: var(--bg-secondary);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .contact-cta-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 2;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .cta-content p {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.6;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 3rem;
    background: var(--brand-color);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    border-radius: 50px;
    box-shadow: 0 4px 15px rgba(175, 130, 50, 0.3);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(175, 130, 50, 0.4);
  }

  .contact-cta-button:active {
    transform: translateY(-1px);
  }

  .booking-section {
    padding: clamp(3rem, 8vw, 6rem) 0;
    background: var(--bg-secondary);
  }

  .booking-content {
    text-align: center;
  }

  .booking-content h2 {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .booking-content > p {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .calendar-wrapper {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    padding: clamp(1rem, 3vw, 2rem);
    min-height: 600px;
  }

  .calendar-wrapper iframe {
    min-height: 550px;
  }

  section {
    position: relative;
    overflow: hidden;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  a {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  ::selection {
    background: rgba(175, 130, 50, 0.2);
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .contact-cta-section {
      padding: clamp(3rem, 6vw, 4rem) 0;
    }

    .contact-cta-container {
      padding: 0 clamp(1rem, 3vw, 1.5rem);
    }

    .contact-cta-button {
      padding: clamp(1rem, 2vw, 1rem) clamp(2rem, 4vw, 2.5rem);
      font-size: clamp(0.95rem, 2vw, 1rem);
    }
  }

  @media (max-width: 480px) {
    .contact-cta-section {
      padding: clamp(2rem, 4vw, 3rem) 0;
    }

    .contact-cta-container {
      padding: 0 clamp(1rem, 3vw, 1rem);
    }

    .contact-cta-button {
      padding: clamp(0.875rem, 2vw, 0.875rem) clamp(1.5rem, 4vw, 2rem);
      font-size: clamp(0.9rem, 2vw, 0.95rem);
    }
  }

  @media (min-width: 1400px) {
    .contact-cta-container {
      max-width: 900px;
    }
  }

  @media (max-width: 1024px) {
    .contact-cta-section {
      padding: clamp(3rem, 5vw, 5rem) 0;
    }
  }
</style>
