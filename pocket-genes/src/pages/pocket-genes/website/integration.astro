---
import PocketGenesIntegrationContent from '../../../components/PocketGenesIntegrationContent.astro';
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import { useTranslations } from '../../../i18n/index';

const t = useTranslations(Astro.currentLocale);
---

<PocketGenesPublicLayout
  title={t.pocketGenes.integrationTitle}
  description="Bring genomic reports into Pocket Genes with a structured implementation path for laboratories, clinics, and report providers."
  canonicalPath="/pocket-genes/website/integration"
  showFooter={false}
  extraHeadScripts={["https://link.centralize.es/js/form_embed.js"]}
>
  <PocketGenesIntegrationContent />
</PocketGenesPublicLayout>
