---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import { POCKET_GENES_EMAILS } from '../../../data/pocketGenesPublic';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const locale = isEnglish ? 'en' : 'es';

const pageCopy = {
  en: {
    title: 'Pocket Genes Pricing for Organizations',
    description:
      'Join the Pocket Genes network for free. Trusted organizations can publish, connect with users, and pay only when delivering genomic reports.',
    heroEyebrow: 'Pricing for organizations',
    heroTitle: 'Join the Pocket Genes network for free.',
    heroBody:
      'Trusted organizations can publish, connect with users, support their communities, and remain discoverable at no cost. You pay only when your organization delivers genomic reports through Pocket Genes.',
    heroPrimaryCta: 'Join as a trusted organization',
    heroSecondaryCta: 'Explore report delivery',
    heroReassurance: 'No credit card required. Report delivery is optional.',
    pricingCards: [
      {
        id: 'trusted-organization-card',
        label: 'Most organizations use Pocket Genes for free',
        title: 'Trusted Organization',
        price: '$0',
        description:
          'Join the Pocket Genes network, build an organizational presence, and communicate with the people you support without paying a platform fee.',
        includedLabel: 'Included',
        included: [
          'Publish news, educational content, and organizational updates',
          'Promote events',
          'Offer professional services',
          'Share research, employment, collaboration, and support opportunities',
          'Participate in community conversations',
          'Receive and respond to user tags',
          'Create closed circles',
          'Maintain an ongoing communication channel with users',
          'Become eligible to appear in relevant go-to lists',
          'Publish up to five curated posts per week',
        ],
        cta: 'I want to be a trusted organization',
        href: '#trusted-organization-meeting',
        note: 'Trusted organizations are reviewed. Trusted status cannot be purchased.',
        tone: 'light',
      },
      {
        id: 'report-delivery-card',
        label: '',
        title: 'Report Delivery',
        price: 'Usage-based',
        description:
          'Deliver interactive genomic reports through Pocket Genes and continue supporting recipients after they open their results.',
        includedLabel: 'Included',
        included: [
          'Interactive, mobile-first reports',
          'Six-character report access',
          'Organized panels, genes, variants, and summaries',
          'Connections to learning, resources, events, and organizations',
          'An ongoing channel with report recipients',
          'Trusted Organization benefits included',
          'Pricing based on report requirements and volume',
        ],
        cta: 'Discuss report delivery',
        href: '#trusted-organization-meeting',
        note: 'You pay for delivered reports, not for participating in the network.',
        tone: 'dark',
      },
    ],
    contactEyebrow: 'Direct contacts',
    contactTitle: 'Contact Pocket Genes about privacy, security, or accessibility.',
    contactBody: 'One inbox routes trust requests to the right review path.',
    primaryInbox: 'Primary inbox',
    copyEmail: 'Copy email',
    copied: 'Copied',
    contactTopicsLabel: 'Contact topics',
    contactRoutes: [
      {
        title: 'Privacy',
        body: 'Data access, deletion, and account questions.',
        tone: 'teal',
      },
      {
        title: 'Security',
        body: 'Incident reports and sensitive platform concerns.',
        tone: 'rose',
      },
      {
        title: 'Accessibility',
        body: 'Usability barriers, assistive access, and content issues.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'I want to be a trusted organization',
    bookingTitle: 'Coordinate a trusted organization review.',
    bookingBody:
      'If your organization supports genetics, rare disease, patient advocacy, education, or care navigation, schedule a meeting with us. We will review fit, publishing standards, and how curated posts or events can appear inside Pocket Genes.',
  },
  es: {
    title: 'Precios para organizaciones en Pocket Genes',
    description:
      'Sumate gratis a la red de Pocket Genes. Las organizaciones evaluadas pueden publicar, conectar con usuarios y pagar solo cuando entregan informes genómicos.',
    heroEyebrow: 'Precios para organizaciones',
    heroTitle: 'Sumate gratis a la red de Pocket Genes.',
    heroBody:
      'Las organizaciones de confianza pueden publicar, conectar con usuarios, apoyar a sus comunidades y mantenerse visibles sin costo. Solo pagás cuando tu organización entrega informes genómicos a través de Pocket Genes.',
    heroPrimaryCta: 'Sumarme como organización de confianza',
    heroSecondaryCta: 'Explorar entrega de informes',
    heroReassurance: 'No se requiere tarjeta de crédito. La entrega de informes es opcional.',
    pricingCards: [
      {
        id: 'trusted-organization-card',
        label: 'La mayoría de las organizaciones usa Pocket Genes gratis',
        title: 'Organización de confianza',
        price: '$0',
        description:
          'Sumate a la red de Pocket Genes, construí una presencia organizacional y comunicate con las personas que acompañás sin pagar una tarifa de plataforma.',
        includedLabel: 'Incluye',
        included: [
          'Publicar noticias, contenido educativo y novedades institucionales',
          'Promocionar eventos',
          'Ofrecer servicios profesionales',
          'Compartir oportunidades de investigación, empleo, colaboración y apoyo',
          'Participar en conversaciones de la comunidad',
          'Recibir y responder etiquetas de usuarios',
          'Crear círculos cerrados',
          'Mantener un canal de comunicación continuo con usuarios',
          'Ser elegible para aparecer en listas relevantes de próximos pasos',
          'Publicar hasta cinco posts curados por semana',
        ],
        cta: 'Quiero ser una organización de confianza',
        href: '#trusted-organization-meeting',
        note: 'Las organizaciones son evaluadas. El estado de confianza no se puede comprar.',
        tone: 'light',
      },
      {
        id: 'report-delivery-card',
        label: '',
        title: 'Entrega de informes',
        price: 'Basado en uso',
        description:
          'Entregá informes genómicos interactivos a través de Pocket Genes y seguí acompañando a quienes los reciben después de abrir sus resultados.',
        includedLabel: 'Incluye',
        included: [
          'Informes interactivos pensados para mobile',
          'Acceso al informe con código de seis caracteres',
          'Paneles, genes, variantes y resúmenes organizados',
          'Conexiones con aprendizaje, recursos, eventos y organizaciones',
          'Un canal continuo con quienes reciben informes',
          'Beneficios de Organización de confianza incluidos',
          'Precio basado en requisitos y volumen de informes',
        ],
        cta: 'Conversar sobre entrega de informes',
        href: '#trusted-organization-meeting',
        note: 'Pagás por informes entregados, no por participar en la red.',
        tone: 'dark',
      },
    ],
    contactEyebrow: 'Contacto directo',
    contactTitle: 'Contactá a Pocket Genes por temas de privacidad, seguridad o accesibilidad.',
    contactBody: 'Un único correo nos permite dirigir cada consulta al equipo correspondiente.',
    primaryInbox: 'Correo de contacto',
    copyEmail: 'Copiar correo',
    copied: 'Copiado',
    contactTopicsLabel: 'Temas de contacto',
    contactRoutes: [
      {
        title: 'Privacidad',
        body: 'Solicitudes de acceso o eliminación y consultas sobre tus datos o tu cuenta.',
        tone: 'teal',
      },
      {
        title: 'Seguridad',
        body: 'Problemas de seguridad, posibles vulnerabilidades o incidentes relacionados con la plataforma.',
        tone: 'rose',
      },
      {
        title: 'Accesibilidad',
        body: 'Barreras de uso, compatibilidad con tecnologías de asistencia o dificultades para acceder al contenido.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'Quiero solicitar la evaluación de mi organización',
    bookingTitle: 'Solicitá una evaluación para participar en Pocket Genes.',
    bookingBody:
      'Si tu organización trabaja en genética, enfermedades poco frecuentes (EPOF), enfermedades raras, apoyo a pacientes, educación o navegación del sistema de salud, podés solicitar una reunión. Evaluaremos su experiencia, sus recursos y sus estándares de contenido para determinar cómo podría participar en Pocket Genes.',
  },
} as const;

const copy = pageCopy[locale];
const trustMailSubject = encodeURIComponent(
  isEnglish
    ? 'Pocket Genes privacy, security, or platform standards question'
    : 'Consulta sobre privacidad, seguridad o estándares de Pocket Genes',
);
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/pricing"
  extraHeadScripts={["https://link.centralize.es/js/form_embed.js"]}
>
  <main id="main" class="pg-page pg-trust-page">
    <section class="pg-trust-hero">
      <div class="pg-container pg-trust-hero-grid">
        <div>
          <p class="pg-eyebrow">{copy.heroEyebrow}</p>
          <h1>{copy.heroTitle}</h1>
          <p>
            {copy.heroBody}
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href="#trusted-organization-meeting">{copy.heroPrimaryCta}</a>
            <a class="pg-button pg-button-secondary" href="#report-delivery-card">{copy.heroSecondaryCta}</a>
          </div>
          <p class="pg-hero-reassurance">{copy.heroReassurance}</p>
        </div>
      </div>
    </section>

    <section class="pg-section pg-pricing-options" aria-label={copy.heroEyebrow}>
      <div class="pg-container">
        <div class="pg-pricing-card-grid">
          {copy.pricingCards.map((card) => (
            <article id={card.id} class={`pg-pricing-card tone-${card.tone}`}>
              {card.label && <p class="pg-pricing-label">{card.label}</p>}
              <h2>{card.title}</h2>
              <strong class="pg-pricing-price">{card.price}</strong>
              <p class="pg-pricing-description">{card.description}</p>
              <div class="pg-pricing-included">
                <p>{card.includedLabel}</p>
                <ul>
                  {card.included.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <a class="pg-button pg-button-primary" href={card.href}>{card.cta}</a>
              <p class="pg-pricing-note">{card.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-trust-contact" aria-labelledby="pg-pricing-contact-title">
      <div class="pg-container">
        <div class="pg-trust-contact-band">
          <div class="pg-contact-orbits" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="pg-contact-main">
            <p class="pg-eyebrow">{copy.contactEyebrow}</p>
            <h2 id="pg-pricing-contact-title">{copy.contactTitle}</h2>
            <p>
              {copy.contactBody}
            </p>
          </div>
          <div class="pg-contact-panel">
            <div class="pg-contact-actions">
              <a class="pg-contact-email" href={`mailto:${POCKET_GENES_EMAILS.hello}?subject=${trustMailSubject}`}>
                <span>{copy.primaryInbox}</span>
                <strong>{POCKET_GENES_EMAILS.hello}</strong>
              </a>
              <button class="pg-contact-copy-button" type="button" data-copy-email={POCKET_GENES_EMAILS.hello} data-copy-label={copy.copyEmail} data-copied-label={copy.copied}>
                {copy.copyEmail}
              </button>
            </div>
            <div class="pg-contact-route-grid" aria-label={copy.contactTopicsLabel}>
              {copy.contactRoutes.map((route) => (
                <article class={`pg-contact-route tone-${route.tone}`}>
                  <span class="pg-route-marker" aria-hidden="true"></span>
                  <div>
                    <h3>{route.title}</h3>
                    <p>{route.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="trusted-organization-meeting" class="pg-section pg-trusted-booking">
      <div class="pg-container pg-trusted-booking-grid">
        <div>
          <p class="pg-eyebrow">{copy.bookingEyebrow}</p>
          <h2>{copy.bookingTitle}</h2>
          <p>
            {copy.bookingBody}
          </p>
        </div>
        <div class="pg-trusted-calendar-wrapper">
          <iframe src="https://link.centralize.es/widget/booking/0K86F8BvSkmicNKU6Nyj" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="0K86F8BvSkmicNKU6Nyj_1770156246220"></iframe>
        </div>
      </div>
    </section>
    <script>
      const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

      copyEmailButtons.forEach((button) => {
        const originalText = button.textContent?.trim() || button.getAttribute('data-copy-label') || '';
        const copiedText = button.getAttribute('data-copied-label') || originalText;
        const email = button.getAttribute('data-copy-email');

        button.addEventListener('click', async () => {
          if (!email || !navigator.clipboard) return;

          try {
            await navigator.clipboard.writeText(email);
            button.textContent = copiedText;
            window.setTimeout(() => {
              button.textContent = originalText;
            }, 1800);
          } catch {
            button.textContent = originalText;
          }
        });
      });
    </script>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-hero {
    min-height: 620px;
    display: flex;
    align-items: center;
    padding: 112px 0 60px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.72)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
  }

  .pg-trust-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr);
    gap: 48px;
    align-items: center;
  }

  .pg-trust-hero h1 {
    margin: 0;
    max-width: 760px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-trust-hero p {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-trust-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-hero .pg-button-row {
    margin-top: 26px;
  }

  .pg-hero-reassurance {
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.96rem;
    font-weight: 760;
  }

  .pg-pricing-options {
    background: #eef8f7;
  }

  .pg-pricing-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .pg-pricing-card {
    min-height: 100%;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: clamp(24px, 4vw, 34px);
    box-shadow: var(--pg-shadow);
  }

  .pg-pricing-card.tone-dark {
    border-color: rgba(20, 149, 143, 0.28);
    background: #172033;
    color: #ffffff;
  }

  .pg-pricing-label {
    display: inline-flex;
    margin: 0 0 14px;
    border: 1px solid rgba(20, 149, 143, 0.28);
    border-radius: 999px;
    background: #eef8f5;
    color: #0e6f6b;
    padding: 6px 10px;
    font-size: 0.78rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .tone-dark .pg-pricing-label {
    border-color: rgba(125, 228, 215, 0.32);
    background: rgba(125, 228, 215, 0.12);
    color: #7de4d7;
  }

  .pg-pricing-card h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .pg-pricing-price {
    display: block;
    margin-top: 14px;
    color: var(--pg-rose);
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .tone-dark .pg-pricing-price {
    color: #7de4d7;
  }

  .pg-pricing-description {
    margin: 16px 0 0;
    color: var(--pg-ink-soft);
    font-size: 1.05rem;
  }

  .tone-dark .pg-pricing-description,
  .tone-dark .pg-pricing-note,
  .tone-dark .pg-pricing-included li {
    color: rgba(255, 255, 255, 0.78);
  }

  .pg-pricing-included {
    margin-top: 24px;
  }

  .pg-pricing-included p {
    margin: 0 0 12px;
    color: var(--pg-muted);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .tone-dark .pg-pricing-included p {
    color: #7de4d7;
  }

  .pg-pricing-included ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-pricing-included li {
    position: relative;
    padding-left: 22px;
    color: var(--pg-ink-soft);
  }

  .pg-pricing-included li::before {
    content: "";
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--pg-teal);
  }

  .pg-pricing-card .pg-button {
    width: 100%;
    margin-top: 26px;
  }

  .pg-pricing-note {
    margin: 14px 0 0;
    color: var(--pg-muted);
    font-size: 0.94rem;
  }

  .pg-contact-copy-button {
    min-height: 42px;
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    color: var(--pg-ink);
    padding: 9px 14px;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .pg-contact-copy-button:hover {
    transform: translateY(-1px);
    border-color: var(--pg-blue);
    box-shadow: 0 10px 24px rgba(33, 118, 174, 0.12);
  }

  .pg-trust-contact {
    background:
      radial-gradient(circle at 10% 0%, rgba(20, 149, 143, 0.13), transparent 34%),
      linear-gradient(180deg, #ffffff 0%, #eef8f7 100%);
  }

  .pg-trust-contact-band {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(24px, 4vw, 46px);
    align-items: center;
    min-height: 330px;
    overflow: hidden;
    border: 1px solid rgba(125, 228, 215, 0.28);
    border-radius: 8px;
    background:
      radial-gradient(circle at 0% 0%, rgba(41, 49, 139, 0.48), transparent 34%),
      radial-gradient(circle at 24% 24%, rgba(77, 102, 214, 0.2), transparent 32%),
      radial-gradient(circle at 78% 12%, rgba(60, 94, 199, 0.18), transparent 26%),
      linear-gradient(135deg, #141a45 0%, #172033 48%, #0d3d49 100%);
    padding: clamp(26px, 5vw, 54px);
    color: #ffffff;
    box-shadow:
      0 34px 80px rgba(23, 32, 51, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .pg-trust-contact-band::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: 0;
    background:
      linear-gradient(110deg, transparent 0 34%, rgba(255, 255, 255, 0.16) 46%, transparent 62%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 72px);
    opacity: 0.55;
    pointer-events: none;
    transform: translateX(-58%);
    animation: contactSweep 7.5s ease-in-out infinite;
  }

  .pg-trust-contact-band::after {
    content: "";
    position: absolute;
    inset: auto -12% -44% 34%;
    z-index: 0;
    height: 260px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(20, 149, 143, 0.48), transparent 68%);
    filter: blur(20px);
    opacity: 0.72;
    pointer-events: none;
  }

  .pg-contact-orbits {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .pg-contact-orbits span {
    position: absolute;
    border: 1px solid rgba(125, 228, 215, 0.28);
    border-radius: 999px;
    opacity: 0.72;
    animation: floatSignal 8s ease-in-out infinite;
  }

  .pg-contact-orbits span:nth-child(1) {
    width: 190px;
    height: 190px;
    top: -74px;
    right: 17%;
  }

  .pg-contact-orbits span:nth-child(2) {
    width: 330px;
    height: 330px;
    right: -74px;
    bottom: -152px;
    border-color: rgba(88, 112, 230, 0.22);
    animation-delay: -2.5s;
  }

  .pg-contact-orbits span:nth-child(3) {
    width: 124px;
    height: 124px;
    left: 43%;
    bottom: 28px;
    border-color: rgba(33, 118, 174, 0.34);
    animation-delay: -5s;
  }

  .pg-contact-main,
  .pg-contact-panel {
    position: relative;
    z-index: 1;
  }

  .pg-trust-contact .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-contact h2 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(2.25rem, 4.5vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-contact-main p:not(.pg-eyebrow) {
    max-width: 520px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.08rem;
  }

  .pg-contact-panel {
    display: grid;
    gap: 16px;
  }

  .pg-contact-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: stretch;
  }

  .pg-trust-contact .pg-contact-email,
  .pg-trust-contact .pg-contact-copy-button,
  .pg-trust-contact .pg-contact-route {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .pg-contact-email {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 16px 18px;
    color: #ffffff;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .pg-contact-email:hover {
    transform: translateY(-3px);
    border-color: rgba(125, 228, 215, 0.62);
    background: rgba(255, 255, 255, 0.15);
  }

  .pg-contact-email span {
    color: #7de4d7;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pg-contact-email strong {
    overflow-wrap: anywhere;
    font-size: clamp(1.08rem, 2vw, 1.45rem);
    line-height: 1.15;
  }

  .pg-trust-contact .pg-contact-copy-button {
    min-width: 112px;
    padding: 0 18px;
    color: #ffffff;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .pg-trust-contact .pg-contact-copy-button:hover {
    transform: translateY(-3px);
    border-color: rgba(228, 80, 128, 0.72);
    background: rgba(228, 80, 128, 0.22);
  }

  .pg-contact-route-grid {
    display: grid;
    gap: 10px;
  }

  .pg-contact-route {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
