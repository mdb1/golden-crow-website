  },
} as const;

const copy = pageCopy[locale];
const [trustedNetworkOption, reportDeliveryOption] = copy.comparisonOptions;
const trustMailSubject = encodeURIComponent(
  isEnglish
    ? 'Pocket Genes privacy, security, or platform standards question'
    : 'Consulta sobre privacidad, seguridad o estándares de Pocket Genes',
);
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/pricing"
  extraHeadScripts={["https://link.centralize.es/js/form_embed.js"]}
>
  <main id="main" class="pg-page pg-trust-page">
    <section class="pg-trust-hero pg-pricing-hero">
      <div class="pg-container pg-trust-hero-grid">
        <div class="pg-hero-copy">
          <p class="pg-eyebrow">{copy.heroEyebrow}</p>
          <h1>
            {copy.heroTitleLead}
            <span>{copy.heroTitleEmphasis}</span>
          </h1>
          <p class="pg-hero-statement">{copy.heroStatement}</p>
          <p class="pg-hero-description">
            {copy.heroBody}
          </p>
          <div class="pg-hero-actions">
            <a class="pg-button pg-button-primary" href="#trusted-organization-meeting">{copy.heroPrimaryCta}</a>
            <a class="pg-quiet-link" href="#free-benefits">{copy.heroSecondaryCta}</a>
          </div>
          <p class="pg-hero-reassurance">{copy.heroReassurance}</p>
        </div>

        <div class="pg-hero-product-visual" aria-label={copy.heroVisualLabel}>
          <article class="pg-interface-card pg-interface-profile">
            <div class="pg-interface-card-header">
              <span class="pg-interface-avatar" aria-hidden="true"></span>
              <span>{copy.heroVisual.profileLabel}</span>
            </div>
            <strong>{copy.heroVisual.profileName}</strong>
            <p>{copy.heroVisual.profileBody}</p>
            <div class="pg-profile-tags" aria-hidden="true">
              {copy.heroVisual.profileTags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>

          <article class="pg-interface-card pg-interface-discover">
            <span class="pg-interface-kicker">{copy.heroVisual.discoverLabel}</span>
            <h2>{copy.heroVisual.discoverTitle}</h2>
            <p>{copy.heroVisual.discoverMeta}</p>
          </article>

          <article class="pg-interface-card pg-interface-community">
            <span class="pg-interface-kicker">{copy.heroVisual.communityLabel}</span>
            <p>{copy.heroVisual.communityBody}</p>
          </article>

          <article class="pg-interface-card pg-interface-channel">
            <span>{copy.heroVisual.channelLabel}</span>
            <strong>{copy.heroVisual.channelValue}</strong>
          </article>
        </div>
      </div>
    </section>

    <section id="free-benefits" class="pg-section pg-free-benefits" aria-labelledby="free-benefits-title">
      <div class="pg-container">
        <div class="pg-section-heading">
          <h2 id="free-benefits-title">{copy.freeBenefitsTitle}</h2>
          <p>
            {copy.freeBenefitsBody}
          </p>
        </div>

        <div class="pg-benefits-package">
          <div class="pg-benefits-grid">
            {copy.freeBenefits.map((benefit) => (
              <article class="pg-benefit-item">
                <span class={`pg-benefit-icon icon-${benefit.icon}`} aria-hidden="true"></span>
                <div>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.body}</p>
                  {benefit.qualifier && <small>{benefit.qualifier}</small>}
                </div>
              </article>
            ))}
          </div>

          <div class="pg-benefits-close">
            <p>{copy.freeBenefitsStatement}</p>
            <a class="pg-button pg-button-primary" href="#trusted-organization-meeting">{copy.freeBenefitsCta}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section pg-pricing-options" aria-labelledby="pricing-comparison-title">
      <div class="pg-container">
        <div class="pg-section-heading">
          <h2 id="pricing-comparison-title">{copy.comparisonTitle}</h2>
          <p>
            {copy.comparisonBody}
          </p>
        </div>

        <div class="pg-comparison-grid">
          <article id={trustedNetworkOption.id} class={`pg-comparison-card tone-${trustedNetworkOption.tone}`}>
            <p class="pg-comparison-step">{trustedNetworkOption.step}</p>
            <h3>{trustedNetworkOption.title}</h3>
            <strong class="pg-comparison-price">{trustedNetworkOption.price}</strong>
            <p class="pg-comparison-statement">{trustedNetworkOption.statement}</p>
            <ul>
              {trustedNetworkOption.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="pg-button pg-button-primary" href={trustedNetworkOption.href}>{trustedNetworkOption.cta}</a>
            <p class="pg-comparison-note">{trustedNetworkOption.note}</p>
          </article>

          <div class="pg-comparison-connector" aria-hidden="true">{copy.comparisonConnector}</div>

          <article id={reportDeliveryOption.id} class={`pg-comparison-card tone-${reportDeliveryOption.tone}`}>
            <p class="pg-comparison-step">{reportDeliveryOption.step}</p>
            <h3>{reportDeliveryOption.title}</h3>
            <strong class="pg-comparison-price">{reportDeliveryOption.price}</strong>
            <p class="pg-comparison-statement">{reportDeliveryOption.statement}</p>
            <ul>
              {reportDeliveryOption.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="pg-button pg-button-secondary" href={localizePath(reportDeliveryOption.href)}>{reportDeliveryOption.cta}</a>
            <p class="pg-comparison-note">{reportDeliveryOption.note}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-policy-documents" aria-labelledby="policy-documents-title">
      <div class="pg-container pg-policy-layout">
        <div class="pg-policy-main">
          <div class="pg-section-heading">
            <p class="pg-eyebrow">{copy.documentsEyebrow}</p>
            <h2 id="policy-documents-title">{copy.documentsTitle}</h2>
            <p>
              {copy.documentsBody}
            </p>
          </div>

          <div class="pg-policy-category-stack">
            {categories.map(({ category, documents }, categoryIndex) => (
              <div class="pg-policy-category" role="group" aria-labelledby={`policy-category-${categoryIndex}`}>
                <h3 id={`policy-category-${categoryIndex}`}>{category}</h3>
                <div class="pg-policy-link-grid">
                  {documents.map((document) => (
                    <a class="pg-policy-link" href={localizePath(`/pocket-genes/trust-center/${document.slug}`)}>
                      <span>{document.status}</span>
                      <strong>{document.title}</strong>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <aside class="pg-policy-contact" aria-labelledby="pg-pricing-contact-title">
          <p class="pg-eyebrow">{copy.contactEyebrow}</p>
          <h3 id="pg-pricing-contact-title">{copy.contactTitle}</h3>
          <p>
            {copy.contactBody}
          </p>
          <div class="pg-contact-actions">
            <a class="pg-contact-email" href={`mailto:${POCKET_GENES_EMAILS.hello}?subject=${trustMailSubject}`}>
              <span>{copy.primaryInbox}</span>
              <strong>{POCKET_GENES_EMAILS.hello}</strong>
            </a>
            <button class="pg-contact-copy-button" type="button" data-copy-email={POCKET_GENES_EMAILS.hello} data-copy-label={copy.copyEmail} data-copied-label={copy.copied}>
              {copy.copyEmail}
            </button>
          </div>
          <div class="pg-contact-route-grid" aria-label={copy.contactTopicsLabel}>
            {copy.contactRoutes.map((route) => (
              <article class={`pg-contact-route tone-${route.tone}`}>
                <span class="pg-route-marker" aria-hidden="true"></span>
                <div>
                  <h4>{route.title}</h4>
                  <p>{route.body}</p>
                </div>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section id="trusted-organization-meeting" class="pg-section pg-trusted-booking">
      <div class="pg-container pg-trusted-booking-grid">
        <div>
          <p class="pg-eyebrow">{copy.bookingEyebrow}</p>
          <h2>{copy.bookingTitle}</h2>
          <p>
            {copy.bookingBody}
          </p>
        </div>
        <div class="pg-trusted-calendar-wrapper">
          <iframe src="https://link.centralize.es/widget/booking/0K86F8BvSkmicNKU6Nyj" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="0K86F8BvSkmicNKU6Nyj_1770156246220"></iframe>
        </div>
      </div>
    </section>
    <script>
      const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

      copyEmailButtons.forEach((button) => {
        const originalText = button.textContent?.trim() || button.getAttribute('data-copy-label') || '';
        const copiedText = button.getAttribute('data-copied-label') || originalText;
        const email = button.getAttribute('data-copy-email');

        button.addEventListener('click', async () => {
          if (!email || !navigator.clipboard) return;

          try {
            await navigator.clipboard.writeText(email);
            button.textContent = copiedText;
            window.setTimeout(() => {
              button.textContent = originalText;
            }, 1800);
          } catch {
            button.textContent = originalText;
          }
        });
      });
    </script>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-pricing-hero {
    position: relative;
    isolation: isolate;
    min-height: 650px;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 112px 0 72px;
    background:
      linear-gradient(132deg, #141a45 0%, #172033 42%, #29318b 67%, #0d6d70 100%),
      linear-gradient(90deg, rgba(228, 80, 128, 0.28), rgba(20, 149, 143, 0.2));
    color: #ffffff;
  }

  .pg-pricing-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(116deg, transparent 0 34%, rgba(255, 255, 255, 0.08) 34% 35%, transparent 35% 54%, rgba(125, 228, 215, 0.1) 54% 55%, transparent 55%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 92px);
    opacity: 0.72;
  }

  .pg-trust-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(340px, 0.9fr);
    gap: 54px;
    align-items: center;
  }

  .pg-hero-copy {
    max-width: 880px;
  }

  .pg-pricing-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-pricing-hero h1 {
    margin: 0;
    max-width: 860px;
    font-size: 4.5rem;
    line-height: 0.96;
    letter-spacing: 0;
