      {
        icon: 'community',
        title: 'Participación comunitaria',
        body: 'Sumate a conversaciones y respondé cuando los usuarios mencionen o etiqueten a tu organización.',
        qualifier: '',
      },
      {
        icon: 'circles',
        title: 'Círculos cerrados',
        body: 'Creá espacios enfocados para programas, comunidades, profesionales o receptores de informes.',
        qualifier: '',
      },
      {
        icon: 'communication',
        title: 'Comunicación continua',
        body: 'Mantené un canal directo con las personas que siguen e interactúan con tu organización.',
        qualifier: '',
      },
      {
        icon: 'discovery',
        title: 'Descubrimiento relevante',
        body:
          'Volvete elegible para aparecer cuando los usuarios buscan organizaciones, servicios, recursos, informes o un próximo paso apropiado.',
        qualifier: '',
      },
    ],
    freeBenefitsStatement: 'Todo esto está disponible sin costo para organizaciones de confianza aprobadas.',
    freeBenefitsCta: 'Sumarme a la red — gratis',
    comparisonTitle: 'Entonces, ¿cuándo pagás?',
    comparisonBody: 'Solo si y cuando tu organización usa Pocket Genes para entregar informes genómicos.',
    comparisonConnector: '¿Necesitás entregar informes? Agregá Report Delivery →',
    comparisonOptions: [
      {
        id: 'trusted-network-card',
        step: '1 — Empezá acá',
