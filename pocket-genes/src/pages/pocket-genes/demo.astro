---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';

const labFields = [
  { label: 'Sample ID', value: 'PG-SYN-2048' },
  { label: 'Report type', value: 'Synthetic rare disease carrier panel' },
  { label: 'Laboratory date', value: '2026-07-12' },
  { label: 'Gene', value: 'HBB' },
  { label: 'Variant', value: 'c.20A>T (p.Glu7Val)' },
  { label: 'Zygosity', value: 'Heterozygous' },
  { label: 'Laboratory classification', value: 'Reported pathogenic carrier finding' },
  { label: 'Lab note', value: 'Clinical interpretation requires professional review and patient context.' },
];

const reformattedItems = [
  {
    title: 'Report timeline',
    body: 'The lab date, provider name, report type, and sample ID become a chronological report card.',
  },
  {
    title: 'Variant display',
    body: 'Gene, transcript-style notation, zygosity, and classification are separated into readable fields.',
  },
  {
    title: 'Panel context',
    body: 'The condition group and tested category are surfaced so users can explain what was reviewed.',
  },
  {
    title: 'Question list',
    body: 'The user can prepare non-diagnostic questions for a clinician or genetic counselor.',
  },
];

const educationItems = [
  {
    title: 'What does heterozygous mean?',
    body: 'An educational definition explains that one of two gene copies carries the reported variant.',
  },
  {
    title: 'What is a carrier finding?',
    body: 'Pocket Genes explains carrier terminology without telling the user what medical action to take.',
  },
  {
    title: 'Why professional review matters',
    body: 'The experience states that personal and family context can change what questions matter next.',
  },
];

const shareRules = [
  { item: 'Nickname, journey stage, and broad community interests', canShare: 'Yes, optional' },
  { item: 'Condition category or broad report summary', canShare: 'Yes, optional' },
  { item: 'Exact variant notation', canShare: 'Only if the user explicitly chooses' },
  { item: 'Original uploaded PDF', canShare: 'No, private by default' },
  { item: 'Medical recommendations or diagnosis from Pocket Genes', canShare: 'Not created by Pocket Genes' },
];
---

<PocketGenesPublicLayout
  title="Pocket Genes Public Demo"
  description="Synthetic Pocket Genes demo showing a sample report, the original PDF, report reformatting, educational additions, and sharing boundaries."
  canonicalPath="/pocket-genes/demo"
>
  <main id="main" class="pg-page pg-demo-page">
    <section class="pg-demo-hero">
      <div class="pg-container pg-demo-hero-grid">
        <div>
          <p class="pg-eyebrow">Public demo</p>
          <h1>From synthetic report to Pocket Genes experience.</h1>
          <p>
            This demonstration uses synthetic data only. It shows what came from the laboratory, what Pocket Genes reformatted, what educational explanations were added, and what a user can or cannot share.
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href="/pocket-genes/demo/sample-report.pdf">Open original sample PDF</a>
            <a class="pg-button pg-button-secondary" href="#lineage">View data lineage</a>
          </div>
        </div>
        <figure class="pg-demo-hero-visual">
          <img src="/pocket-genes/screenshots/sample-03.webp" alt="Pocket Genes pathology detail screen for report information" fetchpriority="high" />
          <img src="/pocket-genes/screenshots/sample-01.webp" alt="Pocket Genes Explore screen" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section pg-demo-report">
      <div class="pg-container pg-demo-report-grid">
        <article class="pg-sample-report" aria-labelledby="sample-report-title">
          <p class="pg-eyebrow">Synthetic sample report</p>
          <h2 id="sample-report-title">PG-SYN-2048</h2>
          <p class="pg-demo-disclaimer">
            This is not a real person, not a clinical report, and not medical advice. It exists only to demonstrate product behavior.
          </p>
          <dl>
            {labFields.map((field) => (
              <div>
                <dt>{field.label}</dt>
                <dd>{field.value}</dd>
              </div>
            ))}
          </dl>
        </article>

        <aside class="pg-pdf-panel" aria-label="Original sample PDF">
          <h2>Original sample PDF</h2>
          <p>
            Institutional visitors can inspect the same synthetic source material that the demo uses. The PDF is intentionally simple so the data lineage stays clear.
          </p>
          <a class="pg-button pg-button-secondary" href="/pocket-genes/demo/sample-report.pdf">Open PDF</a>
        </aside>
      </div>
    </section>

    <section id="lineage" class="pg-section pg-demo-lineage">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">Data lineage</p>
          <h2>What came from the laboratory versus what Pocket Genes added.</h2>
        </div>

        <div class="pg-lineage-grid">
          <article class="pg-lineage-column">
            <h3>Laboratory source</h3>
            <ul>
              <li>Sample ID, report type, provider date, and report category.</li>
              <li>Gene name, variant notation, zygosity, and lab classification.</li>
              <li>Lab note that interpretation requires professional review.</li>
            </ul>
          </article>

          <article class="pg-lineage-column">
            <h3>Pocket Genes reformatted</h3>
            <div class="pg-mini-list">
              {reformattedItems.map((item) => (
                <section>
                  <h4>{item.title}</h4>
                  <p>{item.body}</p>
                </section>
              ))}
            </div>
          </article>

          <article class="pg-lineage-column">
            <h3>Education added</h3>
            <div class="pg-mini-list">
              {educationItems.map((item) => (
                <section>
                  <h4>{item.title}</h4>
                  <p>{item.body}</p>
                </section>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="pg-section pg-demo-experience">
      <div class="pg-container pg-experience-grid">
        <div>
          <p class="pg-eyebrow">Corresponding experience</p>
          <h2>Pocket Genes turns the source report into navigable user context.</h2>
          <p>
            The app screen does not replace the original PDF. It makes the report easier to review, separates reported facts from educational context, and keeps private material private by default.
          </p>
        </div>
        <div class="pg-screen-strip" aria-label="Pocket Genes demo screenshots">
          <img src="/pocket-genes/screenshots/sample-01.webp" alt="Pocket Genes Explore dashboard" loading="lazy" />
          <img src="/pocket-genes/screenshots/sample-03.webp" alt="Pocket Genes pathology details" loading="lazy" />
          <img src="/pocket-genes/screenshots/sample-04.webp" alt="Pocket Genes ancestry analysis screen" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="pg-section pg-demo-sharing">
      <div class="pg-container pg-sharing-grid">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">Sharing boundaries</p>
          <h2>What the user can and cannot share.</h2>
          <p>
            RareFriends by Pocket Genes should be opt-in. The default product behavior should not expose raw reports, exact variants, or private notes.
          </p>
        </div>

        <div class="pg-share-table" role="table" aria-label="Pocket Genes sharing rules">
          <div class="pg-share-row pg-share-head" role="row">
            <span role="columnheader">Information</span>
            <span role="columnheader">Sharing state</span>
          </div>
          {shareRules.map((rule) => (
            <div class="pg-share-row" role="row">
              <span role="cell">{rule.item}</span>
              <strong role="cell">{rule.canShare}</strong>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-demo-hero {
    min-height: 690px;
    display: flex;
    align-items: center;
    padding: 112px 0 64px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.72)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
    overflow: hidden;
  }

  .pg-demo-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 1.08fr);
    gap: 52px;
    align-items: center;
  }

  .pg-demo-hero h1 {
    margin: 0;
    max-width: 720px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-demo-hero p {
    max-width: 720px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-demo-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-demo-hero .pg-button-row {
    margin-top: 28px;
  }

  .pg-demo-hero-visual {
    position: relative;
    min-height: 540px;
    margin: 0;
  }

  .pg-demo-hero-visual img {
    position: absolute;
    width: 260px;
    aspect-ratio: 560 / 1218;
    object-fit: cover;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-demo-hero-visual img:first-child {
    left: 60px;
    top: 0;
  }

  .pg-demo-hero-visual img:last-child {
    left: 260px;
    top: 76px;
  }

  .pg-demo-report {
    background: #ffffff;
  }

  .pg-demo-report-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 28px;
    align-items: start;
  }

  .pg-sample-report,
  .pg-pdf-panel {
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 26px;
  }

  .pg-sample-report {
    box-shadow: 0 1px 2px rgba(23, 32, 51, 0.04);
  }

  .pg-sample-report h2,
  .pg-pdf-panel h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-demo-disclaimer,
  .pg-pdf-panel p {
    margin: 12px 0 0;
    color: var(--pg-ink-soft);
  }

  .pg-sample-report dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0 0;
  }

  .pg-sample-report dl div {
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 14px;
  }

  .pg-sample-report dt {
    color: var(--pg-muted);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-sample-report dd {
    margin: 5px 0 0;
    color: var(--pg-ink);
    font-weight: 780;
  }

  .pg-pdf-panel {
    position: sticky;
    top: 100px;
  }

  .pg-pdf-panel .pg-button {
    margin-top: 18px;
  }

  .pg-demo-lineage {
    background: #eef5f7;
  }

  .pg-lineage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .pg-lineage-column {
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    padding: 22px;
  }

  .pg-lineage-column h3 {
    margin: 0 0 14px;
    font-size: 1.2rem;
  }

  .pg-lineage-column ul {
    margin: 0;
    padding-left: 20px;
    color: var(--pg-ink-soft);
  }

  .pg-lineage-column li + li {
    margin-top: 10px;
  }

  .pg-mini-list {
    display: grid;
    gap: 12px;
  }

  .pg-mini-list section {
    border-left: 4px solid var(--pg-teal);
    padding-left: 12px;
  }

  .pg-mini-list h4 {
    margin: 0 0 3px;
    font-size: 1rem;
  }

  .pg-mini-list p {
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-demo-experience {
    background: #172033;
    color: #ffffff;
  }

  .pg-experience-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(420px, 1.2fr);
    gap: 40px;
    align-items: center;
  }

  .pg-experience-grid h2 {
    margin: 0;
    font-size: 2.7rem;
    line-height: 1.08;
  }

  .pg-experience-grid p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.08rem;
  }

  .pg-demo-experience .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-screen-strip {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding: 8px 4px 18px;
  }

  .pg-screen-strip img {
    flex: 0 0 198px;
    width: 198px;
    border: 7px solid #101522;
    border-radius: 24px;
    background: #101522;
  }

  .pg-sharing-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 34px;
    align-items: start;
  }

  .pg-share-table {
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    overflow: hidden;
  }

  .pg-share-row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(180px, 0.8fr);
  }

  .pg-share-row + .pg-share-row {
    border-top: 1px solid var(--pg-border);
  }

  .pg-share-row span,
  .pg-share-row strong {
    padding: 16px;
  }

  .pg-share-row span {
    color: var(--pg-ink-soft);
  }

  .pg-share-row strong {
    color: var(--pg-ink);
  }

  .pg-share-head {
    background: #eef8f5;
  }

  .pg-share-head span {
    color: #0e6f6b;
    font-weight: 850;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  @media (max-width: 980px) {
    .pg-demo-hero-grid,
    .pg-demo-report-grid,
    .pg-experience-grid,
    .pg-sharing-grid {
      grid-template-columns: 1fr;
    }

    .pg-pdf-panel {
      position: static;
    }

    .pg-lineage-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .pg-demo-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-demo-hero h1 {
      font-size: 2.75rem;
    }

    .pg-demo-hero-visual {
      min-height: 390px;
    }

    .pg-demo-hero-visual img {
      width: 200px;
      border-width: 7px;
      border-radius: 24px;
    }

    .pg-demo-hero-visual img:first-child {
      left: 0;
    }

    .pg-demo-hero-visual img:last-child {
      left: 142px;
      top: 54px;
    }

    .pg-sample-report dl {
      grid-template-columns: 1fr;
    }

    .pg-share-row {
      grid-template-columns: 1fr;
    }

    .pg-share-row strong {
      padding-top: 0;
    }
  }

  @media (max-width: 440px) {
    .pg-demo-hero-visual {
      min-height: 350px;
    }

    .pg-demo-hero-visual img {
      width: 182px;
    }

    .pg-demo-hero-visual img:last-child {
      left: 118px;
    }
  }
</style>
