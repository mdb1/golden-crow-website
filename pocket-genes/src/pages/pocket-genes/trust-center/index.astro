---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import ClientBookingWidget from '../../../components/ClientBookingWidget.astro';
import { POCKET_GENES_EMAILS, POCKET_GENES_OPERATOR, getLocalizedTrustDocuments } from '../../../data/pocketGenesPublic';
import { escapeHtml, formatBrandHtml, formatBrandText } from '../../../utils/brandFormatting';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);
const locale = isEnglish ? 'en' : 'es';
const formatTrustText = (value: string) => formatBrandHtml(escapeHtml(value).replaceAll('*tab*', '<em>tab</em>'));
const trustDocuments = getLocalizedTrustDocuments(locale);
const categories = Array.from(new Set(trustDocuments.map((document) => document.category))).map((category) => ({
  category,
  documents: trustDocuments.filter((document) => document.category === category),
}));

const pageCopy = {
  en: {
    title: 'Pocket Genes Trust Center',
    description: 'Privacy, safety, security, data handling, scientific methodology, trusted-organization standards, and intended-use material for Pocket Genes.',
    heroEyebrow: 'Trust Center',
    heroTitle: 'Pocket Genes Trust Center',
    heroBody:
      'Pocket Genes is designed to make genetic information easier to access, understand, and navigate while keeping privacy, security, and user control at the center of the experience.',
    contactTrust: 'Contact Trust',
    download: 'Download Pocket Genes',
    snapshotLabel: 'Pocket Genes trust snapshot',
    snapshot: [
      {
        label: 'Operator',
        value: POCKET_GENES_OPERATOR.legalName,
        body: 'Responsible for the Pocket Genes account, access, education, organization, and community layers it operates.',
      },
      {
        label: 'Product contact',
        value: POCKET_GENES_EMAILS.hello,
        body: 'Use this address for Pocket Genes support, trust, accessibility, and incident reporting.',
      },
      {
        label: 'Trusted organizations',
        value: 'Carefully reviewed',
        body: 'Selected organizations can publish curated posts, events, and resources that help users move from result to understanding to action.',
      },
    ],
    overviewEyebrow: 'Consultas comunes',
    overviewTitle: 'Frequently asked questions',
    overviewBody:
      'This Trust Center uses one consistent data map: providers remain responsible for their reports, Pocket Genes operates the mobile access and support experience around them, and community participation is optional and separate from private report access.',
    atAGlanceTitle: 'At a glance',
    atAGlance: [
      {
        title: 'Information Pocket Genes processes',
        body: 'Pocket Genes processes limited account, contact, authentication, integration, platform decision records, community, support, and technical information depending on the features used.',
      },
      {
        title: 'How report access works',
        body: 'Reports remain connected to the participating provider. Pocket Genes helps authorized users reach the provider-connected report experience through a mobile path.',
      },
      {
        title: 'What remains private',
        body: 'Creating an account, accessing a report, following an organization, or joining RareFriends does not automatically publish private information or a genetic report.',
      },
      {
        title: 'How integrations begin',
        body: 'A provider or organization may provide limited contact information to start an invitation, report-access, informed-consent upload, or resource workflow for an intended person.',
      },
      {
        title: 'Infrastructure',
        body: 'Pocket Genes uses established service providers, including Amazon Web Services and Google Firebase, to operate different technical components of the platform.',
      },
      {
        title: 'User rights',
        body: 'Users can request access, correction, deletion, account closure, or changes to platform preferences where available through the contact channel, subject to applicable limits.',
      },
    ],
    responsibilityTitle: 'Who is responsible for Pocket Genes',
    responsibilityRows: [
      ['Legal operator/controller', POCKET_GENES_OPERATOR.legalName],
      ['Country', POCKET_GENES_OPERATOR.country],
      ['Product name', POCKET_GENES_OPERATOR.productName],
      ['Contact', POCKET_GENES_EMAILS.hello],
    ],
    trustedHubEyebrow: 'Trusted Organizations Hub',
    trustedHubTitle: 'We review organizations before giving them a trusted place in the ecosystem.',
    trustedHubBody:
      'Pocket Genes is not only file storage. As genetic testing becomes more common, people need more than a PDF: they need context, support, and trustworthy next steps. Selected organizations can help fill that gap by sharing useful posts, events, resources, and education updates with the broader Pocket Genes community.',
    trustedOrganizationCriteria: [
      {
        title: 'Clear public identity',
        body: 'We look for an accountable organization, a real mission, and a clear way for members to understand who is publishing.',
      },
      {
        title: 'Relevant community value',
        body: 'Priority goes to organizations that help people move from a genetic result into understanding, useful resources, events, and a clearer next step.',
      },
      {
        title: 'Curated content standards',
        body: 'Posts should be useful, reviewed before publishing, and appropriate for a community that includes patients, families, caregivers, and people newly trying to understand results.',
      },
      {
        title: 'Safety and trust fit',
        body: 'Organizations must respect privacy boundaries, avoid medical pressure, and keep promotional content clearly separated from education, support, and patient-engagement material.',
      },
    ],
    trustedOutputsEyebrow: 'What trusted organizations can receive',
    trustedOutputsTitle: 'A curated publishing space inside Pocket Genes.',
    trustedOrganizationOutputs: [
      'A trusted organization profile inside the Pocket Genes environment.',
      'Curated posts, event announcements, resources, and education updates for people navigating the post-result journey.',
      'A review path for organizations that want to become visible to users looking for trustworthy next steps after confusing reports.',
      'Up to 5 curated posts per week for free as a trusted organization.',
    ],
    trustedOrganizationCta: 'I want to be a trusted organization',
    documentsEyebrow: 'Pages',
    documentsTitle: 'Privacy, safety, and data use in Pocket Genes.',
    documentsBody:
      'Read the privacy, security, community safety, data retention, accessibility, and intended-use pages for Pocket Genes.',
    documentCta: 'Open page',
    approachEyebrow: 'Trust principles',
    approachItems: [
      {
        title: 'Privacy by design',
        body: 'Pocket Genes limits the personal information it processes to what is needed to operate the platform, support users, and provide specific integrations.',
      },
      {
        title: 'Reports stay connected to their source',
        body: 'Pocket Genes provides a simpler mobile experience for accessing genetic reports delivered by participating providers while preserving the relationship with the original report and its source.',
      },
      {
        title: 'Controlled access',
        body: 'Account, integration, and private platform functionality are protected through authentication and access controls.',
      },
      {
        title: 'User choice',
        body: 'Community participation and intentional sharing are separate from private report access.',
      },
      {
        title: 'Clear responsibilities',
        body: 'Pocket Genes distinguishes between information originating from a report provider, educational information provided by the platform, and content published by users or organizations.',
      },
      {
        title: 'Trusted infrastructure',
        body: 'Pocket Genes uses established infrastructure and service providers, including Amazon Web Services and Google Firebase, to operate different parts of the platform.',
      },
    ],
    contactEyebrow: 'Direct contacts',
    contactTitle: 'Contact Pocket Genes about privacy, security, or accessibility.',
    contactBody: 'One inbox routes trust requests to the right review path.',
    primaryInbox: 'Primary inbox',
    copyEmail: 'Copy email',
    copied: 'Copied',
    contactTopicsLabel: 'Contact topics',
    contactRoutes: [
      {
        title: 'Privacy',
        body: 'Data access, deletion, and account questions.',
        tone: 'teal',
      },
      {
        title: 'Security',
        body: 'Incident reports and sensitive platform concerns.',
        tone: 'rose',
      },
      {
        title: 'Accessibility',
        body: 'Accessible-use questions, assistive access, and content support.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'I want to be a trusted organization',
    bookingTitle: 'Coordinate a trusted organization review.',
    bookingBody:
      'If your organization supports genetics, rare disease, patient advocacy, education, or care navigation, schedule a meeting with us. We will review fit, publishing standards, and how curated posts or events can appear inside Pocket Genes.',
  },
  es: {
    title: 'Pocket Genes Trust Center',
    description: 'Privacidad, seguridad, uso de datos, metodología científica, estándares de organizaciones de confianza y alcance del producto.',
    heroEyebrow: 'Privacidad, seguridad y transparencia',
    heroTitle: 'Pocket Genes Trust Center',
    heroBody:
      'Pocket Genes está pensado para que puedas acceder a información genética, entenderla y encontrar con más facilidad los recursos que necesitás.',
    contactTrust: 'Contactar al equipo de privacidad y seguridad',
    download: 'Descargar Pocket Genes',
    snapshotLabel: 'Resumen de privacidad y seguridad de Pocket Genes',
    snapshot: [
      {
        label: 'Operador',
        value: POCKET_GENES_OPERATOR.legalName,
        body: 'Golden Crow Venture Studio es responsable de las funciones de cuenta, acceso, contenido educativo, organizaciones y comunidad que ofrece Pocket Genes.',
      },
      {
        label: 'Contacto',
        value: POCKET_GENES_EMAILS.hello,
        body: 'Escribinos por consultas de soporte, privacidad, seguridad, accesibilidad o para informar un incidente.',
      },
      {
        label: 'Organizaciones de confianza',
        value: 'Evaluadas antes de publicar contenido',
        body: 'Pueden compartir recursos, eventos y contenido revisado que ayuden a entender los resultados y decidir qué hacer después.',
      },
    ],
    overviewEyebrow: 'FAQ',
    overviewTitle: 'Preguntas frecuentes',
    overviewBody:
      'Encontrá respuestas sobre los datos que usa Pocket Genes, el acceso a informes, las integraciones, la privacidad y tus derechos.',
    atAGlanceTitle: 'En síntesis',
    atAGlance: [
      {
        title: '¿Qué datos usa Pocket Genes?',
        body: 'Según la función, Pocket Genes puede usar datos básicos, como nombre, apellido, correo y teléfono, además de lo necesario para crear tu cuenta y darte soporte. No produce ni manipula reportes genéticos ni guarda en sus bases de datos información sensible de los usuarios, es solo un canal de comunicación seguro entre el proveedor y el usuario final, tanto médicos como pacientes',
      },
      {
        title: '¿Cómo accedo a un informe?',
        body: 'El informe sigue vinculado al proveedor que lo emitió. Pocket Genes facilita a las personas autorizadas el acceso desde el celular. Para acceder debes bajarte la aplicación e ir a la *tab* reportes donde encontrarás el acceso a todos tus reportes asociados.',
      },
      {
        title: '¿Cómo empieza una integración?',
        body: 'Un proveedor puede compartir tus datos de contacto para invitarte, facilitar el acceso a un informe o pedirte que subas el consentimiento informado requerido para el estudio.',
      },
      {
        title: '¿Qué servicios?',
        body: 'Pocket Genes usa Amazon Web Services y Google Firebase para distintas funciones técnicas de la plataforma.',
      },
      {
        title: '¿Qué derechos tengo?',
        body: 'Podés pedir acceso, corrección o eliminación de tus datos y solicitar el cierre de tu cuenta escribiendo a nuestro contacto de privacidad.',
      },
    ],
    responsibilityTitle: '¿Quién opera Pocket Genes?',
    responsibilityRows: [
      ['Operador de Pocket Genes', POCKET_GENES_OPERATOR.legalName],
      ['País', POCKET_GENES_OPERATOR.country],
      ['Producto', POCKET_GENES_OPERATOR.productName],
      ['Contacto', POCKET_GENES_EMAILS.hello],
    ],
    trustedHubEyebrow: 'Organizaciones de confianza',
    trustedHubTitle: 'Evaluamos a cada organización antes de que publique en Pocket Genes.',
    trustedHubBody:
      'Cada vez más personas reciben un informe genético sin saber cómo interpretarlo o qué hacer después. Las organizaciones evaluadas pueden acercar explicaciones, recursos, eventos y novedades útiles para acompañarlas.',
    trustedOrganizationCriteria: [
      {
        title: 'Identidad transparente',
        body: 'Debe quedar claro quién publica, cuál es la misión de la organización y cómo contactarla.',
      },
      {
        title: 'Utilidad para la comunidad',
        body: 'Priorizamos organizaciones que ayuden a entender resultados, encontrar apoyo, conocer recursos o participar en actividades relevantes.',
      },
      {
        title: 'Contenido revisado',
        body: 'El contenido debe ser claro, útil y adecuado para personas y familias que buscan entender un resultado genético.',
      },
      {
        title: 'Información y promoción',
        body: 'Las organizaciones deben respetar la privacidad, evitar consejos médicos sin respaldo e indicar con claridad el contenido promocional.',
      },
    ],
    trustedOutputsEyebrow: 'Qué pueden hacer en Pocket Genes',
    trustedOutputsTitle: 'Un espacio para compartir recursos útiles con la comunidad.',
    trustedOrganizationOutputs: [
      'Un perfil propio dentro de Pocket Genes.',
      'Recursos, eventos y novedades para ayudar a entender resultados y decidir qué hacer después.',
      'Una evaluación previa para confirmar que la organización cumple nuestros criterios.',
      'Hasta 5 publicaciones semanales sin costo para organizaciones evaluadas.',
    ],
    trustedOrganizationCta: 'Solicitar la evaluación de mi organización',
    documentsEyebrow: 'Páginas',
    documentsTitle: 'Privacidad, seguridad y uso de datos en Pocket Genes.',
    documentsBody:
      'Consultá nuestras políticas sobre privacidad, seguridad, comunidad, retención, accesibilidad y uso previsto.',
    documentCta: 'Abrir página',
    approachEyebrow: 'Principios de confianza',
    approachItems: [
      {
        title: 'Privacidad desde el diseño',
        body: 'Pocket Genes usa solo los datos personales necesarios para operar la plataforma, brindar soporte y habilitar integraciones específicas.',
      },
      {
        title: 'Cada informe conserva el vínculo con su fuente',
        body: 'Pocket Genes facilita el acceso móvil a informes entregados por proveedores participantes y mantiene visible su origen.',
      },
      {
        title: 'Acceso controlado',
        body: 'Las cuentas, integraciones y funciones privadas están protegidas con autenticación y controles de acceso.',
      },
      {
        title: 'Control del usuario',
        body: 'Participar en la comunidad o compartir información son decisiones separadas del acceso privado a informes.',
      },
      {
        title: 'Responsabilidades claras',
        body: 'Pocket Genes distingue el contenido del proveedor, la información educativa de la plataforma y lo publicado por usuarios u organizaciones.',
      },
      {
        title: 'Infraestructura confiable',
        body: 'Pocket Genes usa servicios de Amazon Web Services y Google Firebase para operar distintas funciones de la plataforma.',
      },
    ],
    contactEyebrow: 'Contacto directo',
    contactTitle: 'Contactate con nosotros',
    contactBody:
      'Escribinos si tenés dudas sobre temas de privacidad, seguridad o accesibilidad. Un único correo nos permite dirigir cada consulta al equipo correspondiente.',
    primaryInbox: 'Correo de contacto',
    copyEmail: 'Copiar correo',
    copied: 'Copiado',
    contactTopicsLabel: 'Temas de contacto',
    contactRoutes: [
      {
        title: 'Privacidad',
        body: 'Acceso, corrección o eliminación de datos, cierre de cuenta y otras consultas sobre tu información.',
        tone: 'teal',
      },
      {
        title: 'Seguridad',
        body: 'Incidentes, reportes de seguridad y consultas sensibles de plataforma.',
        tone: 'rose',
      },
      {
        title: 'Accesibilidad',
        body: 'Consultas de uso accesible, tecnología de asistencia y soporte de contenido.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'Quiero solicitar la evaluación de mi organización',
    bookingTitle: 'Solicitá una evaluación para participar en Pocket Genes.',
    bookingBody:
      'Si tu organización trabaja en genética, enfermedades poco frecuentes, educación, apoyo a pacientes o acompañamiento dentro del sistema de salud, podés coordinar una reunión con nosotros. Vamos a conocer el trabajo de tu organización, los recursos que ofrece y sus criterios de publicación para evaluar de qué manera podría participar en Pocket Genes.',
  },
} as const;

const copy = pageCopy[locale];
const trustMailSubject = encodeURIComponent(
  isEnglish ? 'Pocket Genes Trust Request' : 'Consulta sobre privacidad y seguridad en Pocket Genes',
);
const supportMailHref = `mailto:${POCKET_GENES_EMAILS.hello}`;
const isSupportEmailValue = (value: string) => value === POCKET_GENES_EMAILS.hello;
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/trust-center"
>
  <main id="main" class="pg-page pg-trust-page">
    <section class="pg-trust-hero">
      <div class="pg-container pg-trust-hero-grid">
        <div>
          <p class="pg-eyebrow" set:html={formatBrandText(copy.heroEyebrow)} />
          <h1 set:html={formatBrandText(copy.heroTitle)} />
          <p set:html={formatBrandText(copy.heroBody)} />
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={`mailto:${POCKET_GENES_EMAILS.trust}`}>{copy.contactTrust}</a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/download')}>{copy.download}</a>
          </div>
        </div>

        <div class="pg-trust-snapshot" aria-label={copy.snapshotLabel}>
          {copy.snapshot.map((item) => (
            <article>
              <span set:html={formatBrandText(item.label)} />
              <strong>
                {isSupportEmailValue(item.value) ? <a class="pg-inline-email" href={supportMailHref}>{item.value}</a> : <span set:html={formatBrandText(item.value)} />}
              </strong>
              <p set:html={formatBrandText(item.body)} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-trusted-orgs">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow" set:html={formatBrandText(copy.trustedHubEyebrow)} />
          <h2 set:html={formatBrandText(copy.trustedHubTitle)} />
          <p set:html={formatBrandText(copy.trustedHubBody)} />
        </div>

        <div class="pg-trusted-orgs-grid">
          <div class="pg-trusted-criteria">
            {copy.trustedOrganizationCriteria.map((item) => (
              <article>
                <h3 set:html={formatBrandText(item.title)} />
                <p set:html={formatBrandText(item.body)} />
              </article>
            ))}
          </div>

          <aside class="pg-trusted-hub-card">
            <p class="pg-eyebrow" set:html={formatBrandText(copy.trustedOutputsEyebrow)} />
            <h3 set:html={formatBrandText(copy.trustedOutputsTitle)} />
            <ul>
              {copy.trustedOrganizationOutputs.map((item) => <li set:html={formatBrandText(item)} />)}
            </ul>
            <a class="pg-button pg-button-primary" href="#trusted-organization-meeting">{copy.trustedOrganizationCta}</a>
          </aside>
        </div>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-section-heading pg-trust-documents-heading">
          <p class="pg-eyebrow" set:html={formatBrandText(copy.documentsEyebrow)} />
          <h2 set:html={formatBrandText(copy.documentsTitle)} />
          <p set:html={formatBrandText(copy.documentsBody)} />
        </div>

        <div class="pg-trust-approach" aria-label={copy.approachEyebrow}>
          <ol class="pg-trust-approach-list">
            {copy.approachItems.map((item, index) => (
              <li>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h4 set:html={formatBrandText(item.title)} />
                  <p set:html={formatBrandText(item.body)} />
                </div>
              </li>
            ))}
          </ol>
        </div>

        <section class="pg-trust-faq" aria-labelledby="pg-trust-faq-title">
          <div class="pg-section-heading pg-trust-faq-heading">
            <p class="pg-eyebrow" set:html={formatBrandText(copy.overviewEyebrow)} />
            <h2 id="pg-trust-faq-title" set:html={formatBrandText(copy.overviewTitle)} />
            <p set:html={formatBrandText(copy.overviewBody)} />
          </div>

          <div class="pg-trust-faq-list">
            {copy.atAGlance.map((item) => (
              <details class="pg-trust-faq-item">
                <summary>
                  <span set:html={formatBrandText(item.title)} />
                </summary>
                <p set:html={formatTrustText(item.body)} />
              </details>
            ))}
            <details class="pg-trust-faq-item">
              <summary>
                <span set:html={formatBrandText(copy.responsibilityTitle)} />
              </summary>
              <dl class="pg-trust-faq-details">
                {copy.responsibilityRows.map(([label, value]) => (
                  <div>
                    <dt set:html={formatBrandText(label)} />
                    <dd>
                      {isSupportEmailValue(value) ? <a class="pg-inline-email" href={supportMailHref}>{value}</a> : <span set:html={formatBrandText(value)} />}
                    </dd>
                  </div>
                ))}
              </dl>
            </details>
          </div>
        </section>

        <div class="pg-trust-category-stack">
          {categories.map(({ category, documents }) => (
            <section class="pg-trust-category" aria-labelledby={`trust-${category.toLowerCase().replaceAll(' ', '-')}`}>
              <h3 id={`trust-${category.toLowerCase().replaceAll(' ', '-')}`} set:html={formatBrandText(category)} />
              <div class="pg-trust-doc-grid">
                {documents.map((document) => (
                  <a class="pg-trust-doc" href={localizePath(`/pocket-genes/trust-center/${document.slug}`)}>
                    <span class="pg-trust-doc-status" set:html={formatBrandText(document.status)} />
                    <strong set:html={formatBrandText(document.title)} />
                    <p set:html={formatBrandText(document.summary)} />
                    <span class="pg-trust-doc-action">{copy.documentCta}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-trust-contact" aria-labelledby="pg-trust-contact-title">
      <div class="pg-container">
        <div class="pg-trust-contact-band">
          <div class="pg-contact-orbits" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="pg-contact-main">
            <p class="pg-eyebrow" set:html={formatBrandText(copy.contactEyebrow)} />
            <h2 id="pg-trust-contact-title" set:html={formatBrandText(copy.contactTitle)} />
            <p set:html={formatBrandText(copy.contactBody)} />
          </div>
          <div class="pg-contact-panel">
            <div class="pg-contact-actions">
              <a class="pg-contact-email" href={`mailto:${POCKET_GENES_EMAILS.hello}?subject=${trustMailSubject}`}>
                <span>{copy.primaryInbox}</span>
                <strong>{POCKET_GENES_EMAILS.hello}</strong>
              </a>
              <button class="pg-contact-copy-button" type="button" data-copy-email={POCKET_GENES_EMAILS.hello} data-copy-label={copy.copyEmail} data-copied-label={copy.copied}>
                {copy.copyEmail}
              </button>
            </div>
            <div class="pg-contact-route-grid" aria-label={copy.contactTopicsLabel}>
              {copy.contactRoutes.map((route) => (
                <article class={`pg-contact-route tone-${route.tone}`}>
                  <span class="pg-route-marker" aria-hidden="true"></span>
                  <div>
                    <h3 set:html={formatBrandText(route.title)} />
                    <p set:html={formatBrandText(route.body)} />
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="trusted-organization-meeting" class="pg-section pg-trusted-booking">
      <div class="pg-container pg-trusted-booking-grid">
        <div>
          <p class="pg-eyebrow" set:html={formatBrandText(copy.bookingEyebrow)} />
          <h2 set:html={formatBrandText(copy.bookingTitle)} />
          <p set:html={formatBrandText(copy.bookingBody)} />
        </div>
        <div class="pg-trusted-calendar-wrapper">
          <ClientBookingWidget
            context="pocket-genes-trust-center"
            eventTitle={isEnglish ? 'Trusted organization review' : 'Reunión para organizaciones'}
            brandName="Golden Crow Venture Studio"
            emphasizeBrandName
          />
        </div>
      </div>
    </section>
    <script>
      const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

      copyEmailButtons.forEach((button) => {
        const originalText = button.textContent?.trim() || button.getAttribute('data-copy-label') || '';
        const copiedText = button.getAttribute('data-copied-label') || originalText;
        const email = button.getAttribute('data-copy-email');

        button.addEventListener('click', async () => {
          if (!email || !navigator.clipboard) return;

          try {
            await navigator.clipboard.writeText(email);
            button.textContent = copiedText;
            window.setTimeout(() => {
              button.textContent = originalText;
            }, 1800);
          } catch {
            button.textContent = originalText;
          }
        });
      });
    </script>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-hero {
    min-height: 620px;
    display: flex;
    align-items: center;
