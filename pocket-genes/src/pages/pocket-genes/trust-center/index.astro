---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import ClientBookingWidget from '../../../components/ClientBookingWidget.astro';
import { POCKET_GENES_EMAILS, getLocalizedTrustDocuments } from '../../../data/pocketGenesPublic';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);
const locale = isEnglish ? 'en' : 'es';
const trustDocuments = getLocalizedTrustDocuments(locale);
const categories = Array.from(new Set(trustDocuments.map((document) => document.category))).map((category) => ({
  category,
  documents: trustDocuments.filter((document) => document.category === category),
}));

const pageCopy = {
  en: {
    title: 'Pocket Genes Trust Center',
    description: 'Privacy, safety, security, data handling, scientific methodology, trusted organizations, and intended-use material for Pocket Genes.',
    heroEyebrow: 'Trust Center',
    heroTitle: 'Pocket Genes Trust Center',
    heroBody:
      'Pocket Genes is designed to make genetic information easier to access, understand, and navigate while keeping privacy, security, and user control at the center of the experience. This Trust Center explains how we handle personal information, protect accounts and platform services, work with report providers and trusted organizations, manage consent and retention, and maintain clear boundaries around community and educational features.',
    contactTrust: 'Contact Trust',
    download: 'Download Pocket Genes',
    snapshotLabel: 'Pocket Genes trust snapshot',
    snapshot: [
      {
        label: 'Product identity',
        value: 'Pocket Genes',
        body: 'Mobile access to genetic reports, education, and controlled community participation.',
      },
      {
        label: 'Product contact',
        value: POCKET_GENES_EMAILS.hello,
        body: 'Use this address for Pocket Genes support, trust, accessibility, and incident reporting.',
      },
      {
        label: 'Trusted organizations',
        value: 'Carefully reviewed',
        body: 'Selected organizations can publish curated posts, events, and resources that help users move from result to understanding to action.',
      },
    ],
    trustedHubEyebrow: 'Trusted Organizations Hub',
    trustedHubTitle: 'We review organizations before giving them a trusted place in the ecosystem.',
    trustedHubBody:
      'Pocket Genes is not only a document library. As genetic testing becomes more common, people need more than a PDF: they need context, support, and trustworthy next steps. Selected organizations can help fill that gap by sharing useful posts, events, resources, and education updates with the broader Pocket Genes community.',
    trustedOrganizationCriteria: [
      {
        title: 'Clear public identity',
        body: 'We look for an accountable organization, a real mission, and a clear way for members to understand who is publishing.',
      },
      {
        title: 'Relevant community value',
        body: 'Priority goes to organizations that help people move from a genetic result into understanding, useful resources, events, and a clearer next step.',
      },
      {
        title: 'Curated content standards',
        body: 'Posts should be useful, reviewed before publishing, and appropriate for a community that includes patients, families, caregivers, and people newly trying to understand results.',
      },
      {
        title: 'Safety and trust fit',
        body: 'Organizations must respect privacy boundaries, avoid medical pressure, and keep promotional content clearly separated from education, support, and patient-engagement material.',
      },
    ],
    trustedOutputsEyebrow: 'What trusted organizations can receive',
    trustedOutputsTitle: 'A curated publishing space inside Pocket Genes.',
    trustedOrganizationOutputs: [
      'A trusted organization profile inside the Pocket Genes environment.',
      'Curated posts, event announcements, resources, and education updates for people navigating the post-result journey.',
      'A review path for organizations that want to become visible to users looking for trustworthy next steps after confusing reports.',
      'Up to 5 curated posts per week for free as a trusted organization.',
    ],
    trustedOrganizationCta: 'I want to be a trusted organization',
    documentsEyebrow: 'Documents',
    documentsTitle: 'Privacy, safety, and data documents.',
    documentsBody:
      'Read the privacy, security, community safety, data retention, accessibility, and intended-use pages for Pocket Genes.',
    approachEyebrow: 'Trust principles',
    approachTitle: 'Our approach',
    approachItems: [
      {
        title: 'Privacy by design',
        body: 'Pocket Genes limits the personal information it processes to what is needed to operate the platform, support users, and provide specific integrations.',
      },
      {
        title: 'Reports stay connected to their source',
        body: 'Pocket Genes provides a simpler mobile experience for accessing genetic reports delivered by participating providers while preserving the relationship with the original report and its source.',
      },
      {
        title: 'Controlled access',
        body: 'Account, integration, and private platform functionality are protected through authentication and access controls.',
      },
      {
        title: 'User choice',
        body: 'Community participation and intentional sharing are separate from private report access.',
      },
      {
        title: 'Clear responsibilities',
        body: 'Pocket Genes distinguishes between information originating from a report provider, educational information provided by the platform, and content published by users or organizations.',
      },
      {
        title: 'Trusted infrastructure',
        body: 'Pocket Genes uses established infrastructure and service providers, including Amazon Web Services and Google Firebase, to operate different parts of the platform.',
      },
    ],
    contactEyebrow: 'Direct contacts',
    contactTitle: 'Contact Pocket Genes about privacy, security, or accessibility.',
    contactBody: 'One inbox routes trust requests to the right review path.',
    primaryInbox: 'Primary inbox',
    copyEmail: 'Copy email',
    copied: 'Copied',
    contactTopicsLabel: 'Contact topics',
    contactRoutes: [
      {
        title: 'Privacy',
        body: 'Data access, deletion, and account questions.',
        tone: 'teal',
      },
      {
        title: 'Security',
        body: 'Incident reports and sensitive platform concerns.',
        tone: 'rose',
      },
      {
        title: 'Accessibility',
        body: 'Usability barriers, assistive access, and content issues.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'I want to be a trusted organization',
    bookingTitle: 'Coordinate a trusted organization review.',
    bookingBody:
      'If your organization supports genetics, rare disease, patient advocacy, education, or care navigation, schedule a meeting with us. We will review fit, publishing standards, and how curated posts or events can appear inside Pocket Genes.',
  },
  es: {
    title: 'Privacidad, seguridad y confianza en Pocket Genes',
    description: 'Privacidad, seguridad, uso de datos, metodología científica, organizaciones evaluadas y límites del producto.',
    heroEyebrow: 'Privacidad, seguridad y transparencia',
    heroTitle: 'Privacidad, seguridad y confianza en Pocket Genes',
    heroBody:
      'Pocket Genes está diseñado para que la información genética sea más fácil de acceder, entender y navegar, con privacidad, seguridad y control del usuario en el centro de la experiencia. Este Centro de confianza explica cómo manejamos información personal, protegemos cuentas y servicios de la plataforma, trabajamos con proveedores de informes y organizaciones de confianza, gestionamos consentimiento y retención, y mantenemos límites claros en funciones comunitarias y educativas.',
    contactTrust: 'Contactar al equipo de privacidad y seguridad',
    download: 'Descargar Pocket Genes',
    snapshotLabel: 'Resumen de privacidad y seguridad de Pocket Genes',
    snapshot: [
      {
        label: 'Acerca de Pocket Genes',
        value: 'Pocket Genes',
        body: 'Acceso móvil a informes genéticos, educación y participación comunitaria controlada.',
      },
      {
        label: 'Contacto',
        value: POCKET_GENES_EMAILS.hello,
        body: 'Escribinos por consultas de soporte, privacidad, seguridad, accesibilidad o para informar un incidente.',
      },
      {
        label: 'Organizaciones de confianza',
        value: 'Evaluadas antes de publicar contenido',
        body: 'Pueden compartir recursos, eventos y contenido revisado que ayuden a entender los resultados y decidir qué hacer después.',
      },
    ],
    trustedHubEyebrow: 'Organizaciones de confianza',
    trustedHubTitle: 'Revisamos cada organización antes de permitirle publicar en Pocket Genes.',
    trustedHubBody:
      'Los estudios genéticos son cada vez más accesibles, pero muchas personas reciben un informe sin saber cómo interpretarlo o qué hacer después. Las organizaciones evaluadas pueden aportar explicaciones, recursos, eventos y novedades útiles para la comunidad.',
    trustedOrganizationCriteria: [
      {
        title: 'Identidad transparente',
        body: 'Debe quedar claro quién publica el contenido, cuál es la misión de la organización y cómo contactarla.',
      },
      {
        title: 'Utilidad para la comunidad',
        body: 'Priorizamos organizaciones que ayuden a entender resultados, encontrar recursos, participar en eventos o preparar preguntas para una consulta.',
      },
      {
        title: 'Contenido revisado',
        body: 'El contenido debe ser útil, estar revisado antes de publicarse y ser apropiado para personas y familias que buscan entender un resultado genético.',
      },
      {
        title: 'Diferenciación entre información y promoción',
        body: 'Las organizaciones deben respetar la privacidad, evitar recomendaciones médicas no respaldadas e identificar claramente cualquier contenido promocional.',
      },
    ],
    trustedOutputsEyebrow: 'Qué pueden hacer las organizaciones',
    trustedOutputsTitle: 'Un espacio para compartir contenido revisado dentro de Pocket Genes.',
    trustedOrganizationOutputs: [
      'Un perfil propio dentro de Pocket Genes.',
      'Publicaciones, eventos, recursos y novedades para quienes buscan entender sus resultados y decidir qué hacer después.',
      'Un proceso de evaluación previo para las organizaciones que quieran participar en la comunidad.',
      'Hasta 5 publicaciones por semana sin costo para organizaciones evaluadas.',
    ],
    trustedOrganizationCta: 'Solicitar la evaluación de mi organización',
    documentsEyebrow: 'Documentos',
    documentsTitle: 'Documentos sobre privacidad, seguridad y uso de datos.',
    documentsBody:
      'Consultá nuestras políticas de privacidad, seguridad, comunidad, retención de datos, accesibilidad y uso previsto.',
    approachEyebrow: 'Principios de confianza',
    approachTitle: 'Nuestro enfoque',
    approachItems: [
      {
        title: 'Privacidad desde el diseño',
        body: 'Pocket Genes limita la información personal que procesa a lo necesario para operar la plataforma, brindar soporte a usuarios y ofrecer integraciones específicas.',
      },
      {
        title: 'Los informes permanecen conectados a su fuente',
        body: 'Pocket Genes brinda una experiencia móvil más simple para acceder a informes genéticos entregados por proveedores participantes, preservando la relación con el informe original y su fuente.',
      },
      {
        title: 'Acceso controlado',
        body: 'Las cuentas, integraciones y funciones privadas de la plataforma están protegidas mediante autenticación y controles de acceso.',
      },
      {
        title: 'Elección del usuario',
        body: 'La participación comunitaria y el intercambio intencional de información son acciones separadas del acceso privado a informes.',
      },
      {
        title: 'Responsabilidades claras',
        body: 'Pocket Genes distingue entre información que se origina en un proveedor de informes, información educativa provista por la plataforma y contenido publicado por usuarios u organizaciones.',
      },
      {
        title: 'Infraestructura confiable',
        body: 'Pocket Genes usa infraestructura y proveedores de servicios establecidos, incluidos Amazon Web Services y Google Firebase, para operar distintas partes de la plataforma.',
      },
    ],
    contactEyebrow: 'Contacto directo',
    contactTitle: 'Contactá a Pocket Genes por temas de privacidad, seguridad o accesibilidad.',
    contactBody: 'Un único correo nos permite dirigir cada consulta al equipo correspondiente.',
    primaryInbox: 'Correo de contacto',
    copyEmail: 'Copiar correo',
    copied: 'Copiado',
    contactTopicsLabel: 'Temas de contacto',
    contactRoutes: [
      {
        title: 'Privacidad',
        body: 'Solicitudes de acceso o eliminación y consultas sobre tus datos o tu cuenta.',
        tone: 'teal',
      },
      {
        title: 'Seguridad',
        body: 'Problemas de seguridad, posibles vulnerabilidades o incidentes relacionados con la plataforma.',
        tone: 'rose',
      },
      {
        title: 'Accesibilidad',
        body: 'Barreras de uso, compatibilidad con tecnologías de asistencia o dificultades para acceder al contenido.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'Quiero solicitar la evaluación de mi organización',
    bookingTitle: 'Solicitá una evaluación para participar en Pocket Genes.',
    bookingBody:
      'Si tu organización trabaja en genética, enfermedades poco frecuentes (EPOF), enfermedades raras, apoyo a pacientes, educación o navegación del sistema de salud, podés solicitar una reunión. Evaluaremos su experiencia, sus recursos y sus estándares de contenido para determinar cómo podría participar en Pocket Genes.',
  },
} as const;

const copy = pageCopy[locale];
const trustMailSubject = encodeURIComponent(
  isEnglish ? 'Pocket Genes Trust Request' : 'Consulta sobre privacidad y seguridad en Pocket Genes',
);
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/trust-center"
>
  <main id="main" class="pg-page pg-trust-page">
    <section class="pg-trust-hero">
      <div class="pg-container pg-trust-hero-grid">
        <div>
          <p class="pg-eyebrow">{copy.heroEyebrow}</p>
          <h1>{copy.heroTitle}</h1>
          <p>
            {copy.heroBody}
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={`mailto:${POCKET_GENES_EMAILS.trust}`}>{copy.contactTrust}</a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/download')}>{copy.download}</a>
          </div>
        </div>

        <div class="pg-trust-snapshot" aria-label={copy.snapshotLabel}>
          {copy.snapshot.map((item) => (
            <article>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-trusted-orgs">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.trustedHubEyebrow}</p>
          <h2>{copy.trustedHubTitle}</h2>
          <p>
            {copy.trustedHubBody}
          </p>
        </div>

        <div class="pg-trusted-orgs-grid">
          <div class="pg-trusted-criteria">
            {copy.trustedOrganizationCriteria.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))}
          </div>

          <aside class="pg-trusted-hub-card">
            <p class="pg-eyebrow">{copy.trustedOutputsEyebrow}</p>
            <h3>{copy.trustedOutputsTitle}</h3>
            <ul>
              {copy.trustedOrganizationOutputs.map((item) => <li>{item}</li>)}
            </ul>
            <a class="pg-button pg-button-primary" href="#trusted-organization-meeting">{copy.trustedOrganizationCta}</a>
          </aside>
        </div>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.documentsEyebrow}</p>
          <h2>{copy.documentsTitle}</h2>
          <p>
            {copy.documentsBody}
          </p>
        </div>

        <div class="pg-trust-approach" aria-labelledby="pg-trust-approach-title">
          <div class="pg-trust-approach-heading">
            <p class="pg-eyebrow">{copy.approachEyebrow}</p>
            <h3 id="pg-trust-approach-title">{copy.approachTitle}</h3>
          </div>
          <div class="pg-trust-approach-grid">
            {copy.approachItems.map((item) => (
              <article>
                <h4>{item.title}</h4>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="pg-trust-category-stack">
          {categories.map(({ category, documents }) => (
            <section class="pg-trust-category" aria-labelledby={`trust-${category.toLowerCase().replaceAll(' ', '-')}`}>
              <h3 id={`trust-${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</h3>
              <div class="pg-trust-doc-grid">
                {documents.map((document) => (
                  <a class="pg-trust-doc" href={localizePath(`/pocket-genes/trust-center/${document.slug}`)}>
                    <span>{document.status}</span>
                    <strong>{document.title}</strong>
                    <p>{document.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-trust-contact" aria-labelledby="pg-trust-contact-title">
      <div class="pg-container">
        <div class="pg-trust-contact-band">
          <div class="pg-contact-orbits" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="pg-contact-main">
            <p class="pg-eyebrow">{copy.contactEyebrow}</p>
            <h2 id="pg-trust-contact-title">{copy.contactTitle}</h2>
            <p>
              {copy.contactBody}
            </p>
          </div>
          <div class="pg-contact-panel">
            <div class="pg-contact-actions">
              <a class="pg-contact-email" href={`mailto:${POCKET_GENES_EMAILS.hello}?subject=${trustMailSubject}`}>
                <span>{copy.primaryInbox}</span>
                <strong>{POCKET_GENES_EMAILS.hello}</strong>
              </a>
              <button class="pg-contact-copy-button" type="button" data-copy-email={POCKET_GENES_EMAILS.hello} data-copy-label={copy.copyEmail} data-copied-label={copy.copied}>
                {copy.copyEmail}
              </button>
            </div>
            <div class="pg-contact-route-grid" aria-label={copy.contactTopicsLabel}>
              {copy.contactRoutes.map((route) => (
                <article class={`pg-contact-route tone-${route.tone}`}>
                  <span class="pg-route-marker" aria-hidden="true"></span>
                  <div>
                    <h3>{route.title}</h3>
                    <p>{route.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="trusted-organization-meeting" class="pg-section pg-trusted-booking">
      <div class="pg-container pg-trusted-booking-grid">
        <div>
          <p class="pg-eyebrow">{copy.bookingEyebrow}</p>
          <h2>{copy.bookingTitle}</h2>
          <p>
            {copy.bookingBody}
          </p>
        </div>
        <div class="pg-trusted-calendar-wrapper">
          <ClientBookingWidget context="pocket-genes-trust-center" />
        </div>
      </div>
    </section>
    <script>
      const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

      copyEmailButtons.forEach((button) => {
        const originalText = button.textContent?.trim() || button.getAttribute('data-copy-label') || '';
        const copiedText = button.getAttribute('data-copied-label') || originalText;
        const email = button.getAttribute('data-copy-email');

        button.addEventListener('click', async () => {
          if (!email || !navigator.clipboard) return;

          try {
            await navigator.clipboard.writeText(email);
            button.textContent = copiedText;
            window.setTimeout(() => {
              button.textContent = originalText;
            }, 1800);
          } catch {
            button.textContent = originalText;
          }
        });
      });
    </script>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-hero {
    min-height: 620px;
    display: flex;
    align-items: center;
    padding: 112px 0 60px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.78)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
  }

  .pg-trust-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: 48px;
    align-items: center;
  }

  .pg-trust-hero h1 {
    margin: 0;
    max-width: 700px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-trust-hero p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-trust-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-hero .pg-button-row {
    margin-top: 26px;
  }

  .pg-trust-snapshot {
    display: grid;
    gap: 14px;
  }

  .pg-trust-snapshot article {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    padding: 20px;
  }

  .pg-trust-snapshot span {
    display: block;
    margin-bottom: 6px;
    color: #7de4d7;
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-trust-snapshot strong {
    display: block;
    font-size: 1.08rem;
  }

  .pg-trust-snapshot p {
    margin: 8px 0 0;
    font-size: 0.96rem;
  }

  .pg-trusted-orgs {
    background: #eef8f7;
  }

  .pg-trusted-orgs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.82fr);
    gap: 28px;
    align-items: start;
  }

  .pg-trusted-criteria {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .pg-trusted-criteria article {
    min-height: 100%;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 20px;
  }

  .pg-trusted-criteria h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .pg-trusted-criteria p {
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-trusted-hub-card {
    border: 1px solid rgba(20, 149, 143, 0.28);
    border-radius: 8px;
    background: #172033;
    color: #ffffff;
    padding: 28px;
    box-shadow: var(--pg-shadow);
  }

  .pg-trusted-hub-card .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trusted-hub-card h3 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-trusted-hub-card ul {
    display: grid;
    gap: 12px;
    margin: 22px 0;
    padding: 0;
    list-style: none;
  }

  .pg-trusted-hub-card li {
    position: relative;
    padding-left: 22px;
    color: rgba(255, 255, 255, 0.82);
  }

  .pg-trusted-hub-card li::before {
    content: "";
    position: absolute;
    top: 0.67em;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #7de4d7;
  }

  .pg-trust-approach {
    display: grid;
    gap: 20px;
    margin-bottom: 36px;
    border: 1px solid rgba(20, 149, 143, 0.18);
    border-radius: 8px;
    background: #f8fbfc;
    padding: clamp(22px, 4vw, 32px);
  }

  .pg-trust-approach-heading h3 {
    margin: 0;
    color: var(--pg-ink);
    font-size: clamp(1.8rem, 3vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .pg-trust-approach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .pg-trust-approach article {
    min-height: 100%;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 18px;
  }

  .pg-trust-approach h4 {
    margin: 0 0 8px;
    color: var(--pg-ink);
    font-size: 1rem;
    line-height: 1.25;
  }

  .pg-trust-approach p {
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-trust-category-stack {
    display: grid;
    gap: 34px;
  }

  .pg-trust-category h3 {
    margin: 0 0 14px;
    font-size: 1.35rem;
  }

  .pg-trust-doc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .pg-trust-doc {
    min-height: 100%;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 20px;
    text-decoration: none;
