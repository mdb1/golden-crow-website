---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import { POCKET_GENES_EMAILS, trustDocuments } from '../../../data/pocketGenesPublic';

const categories = Array.from(new Set(trustDocuments.map((document) => document.category))).map((category) => ({
  category,
  documents: trustDocuments.filter((document) => document.category === category),
}));
---

<PocketGenesPublicLayout
  title="Pocket Genes Trust Center"
  description="Privacy, safety, security, data handling, scientific methodology, and intended-use material for Pocket Genes."
  canonicalPath="/pocket-genes/trust-center"
>
  <main id="main" class="pg-page pg-trust-page">
    <section class="pg-trust-hero">
      <div class="pg-container pg-trust-hero-grid">
        <div>
          <p class="pg-eyebrow">Trust Center</p>
          <h1>Pocket Genes Trust Center</h1>
          <p>
            A visible hub for privacy, security, community safety, scientific methodology, intended use, data retention, subprocessors, accessibility, and incident reporting.
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={`mailto:${POCKET_GENES_EMAILS.trust}`}>Contact Trust</a>
            <a class="pg-button pg-button-secondary" href="/pocket-genes/demo">Inspect public demo</a>
          </div>
        </div>

        <div class="pg-trust-snapshot" aria-label="Pocket Genes trust snapshot">
          <article>
            <span>Product identity</span>
            <strong>Pocket Genes</strong>
            <p>Personal genomic report organization, education, and controlled community participation.</p>
          </article>
          <article>
            <span>Product contact</span>
            <strong>{POCKET_GENES_EMAILS.hello}</strong>
            <p>Use product-domain contacts for Pocket Genes support, trust, accessibility, and incident reporting.</p>
          </article>
          <article>
            <span>Incident reporting</span>
            <strong>{POCKET_GENES_EMAILS.security}</strong>
            <p>Use this address for privacy, security, or community safety incidents.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">Documents</p>
          <h2>Trust materials linked from one visible page.</h2>
          <p>
            These pages are written as public drafts for institutional review. They show the expected policy structure before Pocket Genes expands integrations or community distribution.
          </p>
        </div>

        <div class="pg-trust-category-stack">
          {categories.map(({ category, documents }) => (
            <section class="pg-trust-category" aria-labelledby={`trust-${category.toLowerCase().replaceAll(' ', '-')}`}>
              <h3 id={`trust-${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</h3>
              <div class="pg-trust-doc-grid">
                {documents.map((document) => (
                  <a class="pg-trust-doc" href={`/pocket-genes/trust-center/${document.slug}`}>
                    <span>{document.status}</span>
                    <strong>{document.title}</strong>
                    <p>{document.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-trust-contact">
      <div class="pg-container pg-trust-contact-band">
        <div>
          <p class="pg-eyebrow">Direct contacts</p>
          <h2>Trust questions should have visible company-domain email addresses.</h2>
        </div>
        <div class="pg-contact-list">
          <a href={`mailto:${POCKET_GENES_EMAILS.hello}`}>{POCKET_GENES_EMAILS.hello}</a>
          <a href={`mailto:${POCKET_GENES_EMAILS.trust}`}>{POCKET_GENES_EMAILS.trust}</a>
          <a href={`mailto:${POCKET_GENES_EMAILS.security}`}>{POCKET_GENES_EMAILS.security}</a>
          <a href={`mailto:${POCKET_GENES_EMAILS.accessibility}`}>{POCKET_GENES_EMAILS.accessibility}</a>
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-hero {
    min-height: 620px;
    display: flex;
    align-items: center;
    padding: 112px 0 60px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.78)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
  }

  .pg-trust-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: 48px;
    align-items: center;
  }

  .pg-trust-hero h1 {
    margin: 0;
    max-width: 700px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-trust-hero p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-trust-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-hero .pg-button-row {
    margin-top: 26px;
  }

  .pg-trust-snapshot {
    display: grid;
    gap: 14px;
  }

  .pg-trust-snapshot article {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    padding: 20px;
  }

  .pg-trust-snapshot span {
    display: block;
    margin-bottom: 6px;
    color: #7de4d7;
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-trust-snapshot strong {
    display: block;
    font-size: 1.08rem;
  }

  .pg-trust-snapshot p {
    margin: 8px 0 0;
    font-size: 0.96rem;
  }

  .pg-trust-category-stack {
    display: grid;
    gap: 34px;
  }

  .pg-trust-category h3 {
    margin: 0 0 14px;
    font-size: 1.35rem;
  }

  .pg-trust-doc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .pg-trust-doc {
    min-height: 100%;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 20px;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .pg-trust-doc:hover {
    transform: translateY(-2px);
    border-color: var(--pg-teal);
    box-shadow: 0 12px 26px rgba(20, 149, 143, 0.12);
  }

  .pg-trust-doc span {
    display: block;
    margin-bottom: 8px;
    color: var(--pg-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .pg-trust-doc strong {
    display: block;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .pg-trust-doc p {
    margin: 10px 0 0;
    color: var(--pg-ink-soft);
  }

  .pg-trust-contact {
    background: #ffffff;
  }

  .pg-trust-contact-band {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 28px;
    align-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 28px;
  }

  .pg-trust-contact h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pg-contact-list a {
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    padding: 10px 12px;
    color: var(--pg-blue);
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .pg-trust-hero-grid,
    .pg-trust-contact-band {
      grid-template-columns: 1fr;
    }

    .pg-trust-doc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pg-trust-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-trust-hero h1 {
      font-size: 2.85rem;
    }

    .pg-trust-doc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
