---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import { POCKET_GENES_EMAILS, getTrustDocument, trustDocuments, type TrustDocument } from '../../../data/pocketGenesPublic';

export function getStaticPaths() {
  return trustDocuments.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }));
}

interface Props {
  document: TrustDocument;
}

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);
const locale = isEnglish ? 'en' : 'es';
const routeDocument = Astro.props.document;
const document = getTrustDocument(routeDocument.slug, locale) ?? routeDocument;
const isDataFlow = document.slug === 'data-flow-diagram';

const pageCopy = {
  en: {
    trustCenterTitle: 'Pocket Genes Trust Center',
    breadcrumbLabel: 'Breadcrumb',
    home: 'Home',
    trustCenter: 'Trust Center',
    metadataLabel: 'Document metadata',
    detailsTitle: 'Document details',
    status: 'Status',
    owner: 'Owner',
    lastReviewed: 'Last reviewed',
    contact: 'Contact',
    dataFlowTitle: 'Pocket Genes data-flow diagram',
    dataFlowLabel: 'Pocket Genes data flow',
    relatedPages: 'Related pages',
    download: 'Download Pocket Genes',
    flowSteps: [
      {
        title: 'Report provider',
        body: 'A participating provider makes a genetic report available to its user and remains the source of the report and its findings.',
      },
      {
        title: 'Pocket Genes integration',
        body: 'Pocket Genes receives the information required to connect the intended user with the corresponding mobile experience.',
      },
      {
        title: 'User identification and consent',
        body: 'Where applicable, limited contact information is used to communicate with the intended user and complete the required consent or access process.',
      },
      {
        title: 'Mobile report access',
        body: 'Pocket Genes provides a simple mobile path for the user to reach and navigate the report made available by the provider.',
      },
      {
        title: 'Educational context',
        body: 'Pocket Genes connects the experience with definitions, lessons, relevant resources, and other educational information that can help users understand the concepts around their results.',
      },
      {
        title: 'Discover and community',
        body: 'Users can independently discover organizations, resources, events, and communities related to their interests.',
      },
      {
        title: 'User-controlled participation',
        body: 'Community participation and sharing are separate actions. Accessing a report does not automatically publish its contents or disclose it to other Pocket Genes users.',
      },
    ],
  },
  es: {
    trustCenterTitle: 'Centro de confianza de Pocket Genes',
    breadcrumbLabel: 'Ruta de navegación',
    home: 'Inicio',
    trustCenter: 'Centro de confianza',
    metadataLabel: 'Metadatos del documento',
    detailsTitle: 'Detalles del documento',
    status: 'Estado',
    owner: 'Responsable',
    lastReviewed: 'Última revisión',
    contact: 'Contacto',
    dataFlowTitle: 'Diagrama de flujo de datos de Pocket Genes',
    dataFlowLabel: 'Flujo de datos de Pocket Genes',
    relatedPages: 'Páginas relacionadas',
    download: 'Descargar Pocket Genes',
    flowSteps: [
      {
        title: 'Proveedor del informe',
        body: 'Un proveedor participante pone un informe genético a disposición de su usuario y sigue siendo la fuente del informe y sus hallazgos.',
      },
      {
        title: 'Integración de Pocket Genes',
        body: 'Pocket Genes recibe la información necesaria para conectar a la persona prevista con la experiencia móvil correspondiente.',
      },
      {
        title: 'Identificación y consentimiento',
        body: 'Cuando corresponde, se usa información limitada de contacto para comunicarse con la persona prevista y completar el proceso requerido de consentimiento o acceso.',
      },
      {
        title: 'Acceso móvil al informe',
        body: 'Pocket Genes brinda un camino móvil simple para que el usuario llegue y navegue el informe puesto a disposición por el proveedor.',
      },
      {
        title: 'Contexto educativo',
        body: 'Pocket Genes conecta la experiencia con definiciones, lecciones, recursos relevantes y otra información educativa que puede ayudar a entender conceptos alrededor de los resultados.',
      },
      {
        title: 'Descubrimiento y comunidad',
        body: 'Los usuarios pueden descubrir de forma independiente organizaciones, recursos, eventos y comunidades relacionadas con sus intereses.',
      },
      {
        title: 'Participación controlada por el usuario',
        body: 'La participación comunitaria y el intercambio son acciones separadas. Acceder a un informe no publica automáticamente su contenido ni lo revela a otros usuarios de Pocket Genes.',
      },
    ],
  },
} as const;

const copy = pageCopy[locale];
---

<PocketGenesPublicLayout
  title={`${document.title} - ${copy.trustCenterTitle}`}
  description={document.summary}
  canonicalPath={`/pocket-genes/trust-center/${document.slug}`}
>
  <main id="main" class="pg-page pg-trust-detail">
    <section class="pg-trust-detail-hero">
      <div class="pg-container">
        <nav class="pg-breadcrumb" aria-label={copy.breadcrumbLabel}>
          <a href={localizePath('/pocket-genes/home')}>{copy.home}</a>
          <span>/</span>
          <a href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
        </nav>
        <p class="pg-eyebrow">{document.category}</p>
        <h1>{document.title}</h1>
        <p>{document.summary}</p>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container pg-trust-detail-grid">
        <aside class="pg-trust-meta" aria-label={copy.metadataLabel}>
          <h2>{copy.detailsTitle}</h2>
          <dl>
            <div>
              <dt>{copy.status}</dt>
              <dd>{document.status}</dd>
            </div>
            <div>
              <dt>{copy.owner}</dt>
              <dd>{document.owner}</dd>
            </div>
            <div>
              <dt>{copy.lastReviewed}</dt>
              <dd>{document.lastReviewed}</dd>
            </div>
            <div>
              <dt>{copy.contact}</dt>
              <dd><a href={`mailto:${POCKET_GENES_EMAILS.trust}`}>{POCKET_GENES_EMAILS.trust}</a></dd>
            </div>
          </dl>
        </aside>

        <article class="pg-trust-article">
          {document.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.body && <p>{section.body}</p>}
              {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              )}
              {section.subsections && (
                <div class="pg-trust-subsection-stack">
                  {section.subsections.map((subsection) => (
                    <section>
                      <h3>{subsection.heading}</h3>
                      {subsection.body && <p>{subsection.body}</p>}
                      {subsection.bullets && (
                        <ul>
                          {subsection.bullets.map((bullet) => <li>{bullet}</li>)}
                        </ul>
                      )}
                    </section>
                  ))}
                </div>
              )}
              {section.table && (
                <div class="pg-trust-table-wrapper">
                  <table>
                    <thead>
                      <tr>
                        {section.table.headers.map((header) => <th scope="col">{header}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell) => <td>{cell}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>
          ))}

          {isDataFlow && (
            <section class="pg-data-flow">
              <h2>{copy.dataFlowTitle}</h2>
              <div class="pg-flow-track" aria-label={copy.dataFlowLabel}>
                {copy.flowSteps.map((step, index) => (
                  <article class:list={['pg-flow-step', { 'is-last': index === copy.flowSteps.length - 1 }]}>
                    <span>{index + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </article>
                ))}
              </div>
            </section>
          )}

          <section class="pg-trust-next">
            <h2>{copy.relatedPages}</h2>
            <div>
              <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
              <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/download')}>{copy.download}</a>
            </div>
          </section>
        </article>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-detail-hero {
    padding: 128px 0 64px;
    background: #172033;
    color: #ffffff;
  }

  .pg-trust-detail-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-detail-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: 3.6rem;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .pg-trust-detail-hero p {
    max-width: 780px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    color: rgba(255, 255, 255, 0.72);
    font-weight: 780;
  }

  .pg-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .pg-breadcrumb a:hover {
    color: #ffffff;
  }

  .pg-trust-detail-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .pg-trust-meta {
    position: sticky;
    top: 100px;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 20px;
  }

  .pg-trust-meta h2 {
    margin: 0 0 16px;
    font-size: 1.12rem;
  }

  .pg-trust-meta dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .pg-trust-meta dt {
    color: var(--pg-muted);
    font-size: 0.8rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-trust-meta dd {
    margin: 4px 0 0;
    color: var(--pg-ink);
    font-weight: 760;
  }

  .pg-trust-meta a {
    color: var(--pg-blue);
  }

  .pg-trust-article {
    display: grid;
    gap: 24px;
  }

  .pg-trust-article > section {
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #ffffff;
    padding: 26px;
  }

  .pg-trust-article h2 {
    margin: 0 0 12px;
    font-size: 1.55rem;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .pg-trust-article h3 {
    margin: 0 0 6px;
    font-size: 1.04rem;
  }

  .pg-trust-article p {
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-trust-article p + p {
    margin-top: 12px;
  }

  .pg-trust-article ul {
    margin: 14px 0 0;
    padding-left: 22px;
    color: var(--pg-ink-soft);
  }

  .pg-trust-article li + li {
    margin-top: 8px;
  }

  .pg-trust-subsection-stack {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .pg-trust-subsection-stack section {
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 16px;
  }

  .pg-trust-table-wrapper {
    width: 100%;
    margin-top: 18px;
    overflow-x: auto;
  }

  .pg-trust-table-wrapper table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    color: var(--pg-ink-soft);
    font-size: 0.94rem;
  }

  .pg-trust-table-wrapper th,
  .pg-trust-table-wrapper td {
    border: 1px solid var(--pg-border);
    padding: 12px;
    text-align: left;
    vertical-align: top;
  }

  .pg-trust-table-wrapper th {
    background: #f8fbfc;
    color: var(--pg-ink);
    font-weight: 850;
  }

  .pg-flow-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  .pg-flow-step {
    position: relative;
    min-height: 100%;
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 16px;
  }

  .pg-flow-step span {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--pg-teal);
    color: #ffffff;
    display: inline-grid;
    place-items: center;
    font-weight: 900;
    margin-bottom: 12px;
  }

  .pg-flow-step p {
    font-size: 0.94rem;
  }

  .pg-trust-next div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 980px) {
    .pg-trust-detail-grid {
      grid-template-columns: 1fr;
    }

    .pg-trust-meta {
      position: static;
    }

    .pg-flow-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pg-trust-detail-hero {
      padding: 112px 0 48px;
    }

    .pg-trust-detail-hero h1 {
      font-size: 2.45rem;
    }

    .pg-trust-article > section {
      padding: 20px;
    }

    .pg-flow-track {
      grid-template-columns: 1fr;
    }
  }
</style>
