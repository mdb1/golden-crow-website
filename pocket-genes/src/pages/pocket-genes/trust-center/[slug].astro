---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import {
  POCKET_GENES_EMAILS,
  getLocalizedTrustDocuments,
  getTrustDocument,
  trustDocuments,
  type TrustDocument,
} from '../../../data/pocketGenesPublic';
import { escapeHtml, formatBrandHtml, formatBrandText } from '../../../utils/brandFormatting';

export function getStaticPaths() {
  return trustDocuments.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }));
}

interface Props {
  document: TrustDocument;
}

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);
const locale = isEnglish ? 'en' : 'es';
const routeDocument = Astro.props.document;
const document = getTrustDocument(routeDocument.slug, locale) ?? routeDocument;
const navigationDocuments = getLocalizedTrustDocuments(locale);
const navigationCategories = Array.from(new Set(navigationDocuments.map((navDocument) => navDocument.category))).map((category) => ({
  category,
  documents: navigationDocuments.filter((navDocument) => navDocument.category === category),
}));
const trustDocumentHrefByTitle = new Map(
  navigationDocuments.map((navDocument) => [
    navDocument.title,
    localizePath(`/pocket-genes/trust-center/${navDocument.slug}`),
  ]),
);
const linkTrustEmail = (value: string) =>
  formatBrandHtml(escapeHtml(value)).replaceAll(
    POCKET_GENES_EMAILS.trust,
    `<a class="pg-trust-email-link" href="mailto:${POCKET_GENES_EMAILS.trust}">${POCKET_GENES_EMAILS.trust}</a>`,
  );
const relatedDocumentHeadings = new Set(['Related pages', 'Páginas relacionadas']);
const linkRelatedTrustDocument = (value: string, sectionHeading: string) => {
  const href = trustDocumentHrefByTitle.get(value);

  if (!href || !relatedDocumentHeadings.has(sectionHeading)) {
    return linkTrustEmail(value);
  }

  return `<a class="pg-trust-document-link" href="${escapeHtml(href)}">${formatBrandText(value)}</a>`;
};

const pageCopy = {
  en: {
    trustCenterTitle: 'Pocket Genes Trust Center',
    breadcrumbLabel: 'Breadcrumb',
    home: 'Home',
    trustCenter: 'Trust Center',
    metadataLabel: 'Page metadata',
    detailsTitle: 'Page details',
    status: 'Status',
    owner: 'Owner',
    effectiveDate: 'Effective date',
    version: 'Version',
    lastReviewed: 'Last reviewed',
    contact: 'Contact',
    navigationTitle: 'Navigation',
    relatedPages: 'Related pages',
    download: 'Download Pocket Genes',
  },
  es: {
    trustCenterTitle: 'Centro de confianza de Pocket Genes',
    breadcrumbLabel: 'Ruta de navegación',
    home: 'Inicio',
    trustCenter: 'Centro de confianza',
    metadataLabel: 'Metadatos de la página',
    detailsTitle: 'Detalles de la página',
    status: 'Estado',
    owner: 'Responsable',
    effectiveDate: 'Vigencia',
    version: 'Versión',
    lastReviewed: 'Última revisión',
    contact: 'Contacto',
    navigationTitle: 'Navegación',
    relatedPages: 'Páginas relacionadas',
    download: 'Descargar Pocket Genes',
  },
} as const;

const copy = pageCopy[locale];
---

<PocketGenesPublicLayout
  title={`${document.title} - ${copy.trustCenterTitle}`}
  description={document.summary}
  canonicalPath={`/pocket-genes/trust-center/${document.slug}`}
>
  <main id="main" class="pg-page pg-trust-detail">
    <section class="pg-trust-detail-hero">
      <div class="pg-container">
        <nav class="pg-breadcrumb" aria-label={copy.breadcrumbLabel}>
          <a href={localizePath('/pocket-genes/home')}>{copy.home}</a>
          <span>/</span>
          <a href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
        </nav>
        <p class="pg-eyebrow" set:html={linkTrustEmail(document.category)} />
        <h1 set:html={linkTrustEmail(document.title)} />
        <p set:html={linkTrustEmail(document.summary)} />
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container pg-trust-detail-grid">
        <aside class="pg-trust-meta" aria-label={copy.metadataLabel} data-trust-scroll-sync-sidebar>
          <nav class="pg-trust-detail-nav" aria-labelledby="pg-trust-detail-nav-title">
            <h2 id="pg-trust-detail-nav-title">{copy.navigationTitle}</h2>
            <div class="pg-trust-detail-nav-groups">
              {navigationCategories.map(({ category, documents }) => (
                <section>
                  <h3>{category}</h3>
                  <ul>
                    {documents.map((navDocument) => {
                      const isCurrent = navDocument.slug === document.slug;

                      return (
                        <li>
                          <a
                            class:list={['pg-trust-detail-nav-link', { 'is-active': isCurrent }]}
                            href={localizePath(`/pocket-genes/trust-center/${navDocument.slug}`)}
                            aria-current={isCurrent ? 'page' : undefined}
                          >
                            <span set:html={formatBrandText(navDocument.title)} />
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              ))}
            </div>
          </nav>

          <h2>{copy.detailsTitle}</h2>
          <dl>
            <div>
              <dt>{copy.status}</dt>
              <dd set:html={linkTrustEmail(document.status)} />
            </div>
            <div>
              <dt>{copy.owner}</dt>
              <dd set:html={linkTrustEmail(document.owner)} />
            </div>
            {document.effectiveDate && (
              <div>
                <dt>{copy.effectiveDate}</dt>
                <dd set:html={linkTrustEmail(document.effectiveDate)} />
              </div>
            )}
            {document.version && (
              <div>
                <dt>{copy.version}</dt>
                <dd set:html={linkTrustEmail(document.version)} />
              </div>
            )}
            <div>
              <dt>{copy.lastReviewed}</dt>
              <dd set:html={linkTrustEmail(document.lastReviewed)} />
            </div>
            <div>
              <dt>{copy.contact}</dt>
              <dd><a href={`mailto:${POCKET_GENES_EMAILS.trust}`}>{POCKET_GENES_EMAILS.trust}</a></dd>
            </div>
          </dl>
        </aside>

        <article class="pg-trust-article" data-trust-scroll-sync-content>
          {document.sections.map((section) => (
            <section>
              <h2 set:html={linkTrustEmail(section.heading)} />
              {section.body && <p set:html={linkTrustEmail(section.body)} />}
              {section.paragraphs?.map((paragraph) => <p set:html={linkTrustEmail(paragraph)} />)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li set:html={linkRelatedTrustDocument(bullet, section.heading)} />)}
                </ul>
              )}
              {section.subsections && (
                <div class="pg-trust-subsection-stack">
                  {section.subsections.map((subsection) => (
                    <section>
                      <h3 set:html={linkTrustEmail(subsection.heading)} />
                      {subsection.body && <p set:html={linkTrustEmail(subsection.body)} />}
                      {subsection.bullets && (
                        <ul>
                          {subsection.bullets.map((bullet) => <li set:html={linkTrustEmail(bullet)} />)}
                        </ul>
                      )}
                    </section>
                  ))}
                </div>
              )}
              {section.table && (
                <div class="pg-trust-table-wrapper">
                  <table>
                    <thead>
                      <tr>
                        {section.table.headers.map((header) => <th scope="col" set:html={linkTrustEmail(header)} />)}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell) => <td set:html={linkTrustEmail(cell)} />)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.flow && (
                <div class="pg-trust-flow-journey" aria-label={section.heading}>
                  {section.flow.steps.map((step, index) => (
                    <article class:list={['pg-trust-flow-step', { 'is-last': index === section.flow.steps.length - 1 }]}>
                      <div class="pg-trust-flow-marker" aria-hidden="true">
                        <span>{String(index + 1).padStart(2, '0')}</span>
                      </div>
                      <div class="pg-trust-flow-content">
                        <p class="pg-trust-flow-actor">
                          <span set:html={linkTrustEmail(section.flow.labels.actor)} />
                          <strong set:html={linkTrustEmail(step.actor)} />
                        </p>
                        <h3 set:html={linkTrustEmail(step.title)} />
                        <p class="pg-trust-flow-description">
                          <span set:html={linkTrustEmail(section.flow.labels.action)} />
                          <strong set:html={linkTrustEmail(step.action)} />
                        </p>
                        <dl class="pg-trust-flow-facts">
                          <div>
                            <dt set:html={linkTrustEmail(section.flow.labels.information)} />
                            <dd set:html={linkTrustEmail(step.information)} />
                          </div>
                          <div>
                            <dt set:html={linkTrustEmail(section.flow.labels.retained)} />
                            <dd set:html={linkTrustEmail(step.retained)} />
                          </div>
                          <div>
                            <dt set:html={linkTrustEmail(section.flow.labels.control)} />
                            <dd set:html={linkTrustEmail(step.control)} />
                          </div>
                        </dl>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </section>
          ))}

          <section class="pg-trust-next">
            <h2>{copy.relatedPages}</h2>
            <div>
              <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
              <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/download')}>{copy.download}</a>
            </div>
          </section>
        </article>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-detail-hero {
    padding: 128px 0 64px;
    background: #172033;
    color: #ffffff;
  }

  .pg-trust-detail-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-detail-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: 3.6rem;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .pg-trust-detail-hero p {
    max-width: 780px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    color: rgba(255, 255, 255, 0.72);
    font-weight: 780;
  }

  .pg-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .pg-breadcrumb a:hover {
    color: #ffffff;
  }

  .pg-trust-detail-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .pg-trust-meta {
    --pg-trust-sticky-top: 100px;
    position: sticky;
    top: var(--pg-trust-sticky-top);
    max-height: calc(100vh - var(--pg-trust-sticky-top) - 24px);
    max-height: calc(100svh - var(--pg-trust-sticky-top) - 24px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    border-top: 1px solid var(--pg-border);
    border-bottom: 1px solid var(--pg-border);
    background: transparent;
    padding: 18px 8px 18px 0;
  }

  .pg-trust-meta::-webkit-scrollbar {
    width: 8px;
  }

  .pg-trust-meta::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgba(20, 149, 143, 0.28);
  }

  .pg-trust-meta::-webkit-scrollbar-track {
    background: transparent;
  }

  .pg-trust-meta h2 {
    margin: 0 0 16px;
    font-size: 1.12rem;
  }

  .pg-trust-meta dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .pg-trust-meta dt {
    color: var(--pg-muted);
    font-size: 0.8rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-trust-meta dd {
    margin: 4px 0 0;
    color: var(--pg-ink);
    font-weight: 760;
  }

  .pg-trust-meta a {
    color: var(--pg-blue);
  }

  .pg-trust-detail-nav {
    margin-bottom: 22px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--pg-border);
  }

  .pg-trust-detail-nav h2 {
    margin: 0 0 16px;
    font-size: 1.12rem;
  }

  .pg-trust-detail-nav-groups {
    display: grid;
    gap: 18px;
  }

  .pg-trust-detail-nav section {
    display: grid;
    gap: 8px;
  }

  .pg-trust-detail-nav h3 {
    margin: 0;
    color: var(--pg-muted);
    font-size: 0.76rem;
    font-weight: 850;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .pg-trust-detail-nav ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-trust-detail-nav-link {
    display: block;
    border-left: 3px solid transparent;
    padding: 7px 8px 7px 10px;
    color: var(--pg-ink-soft);
    font-size: 0.9rem;
    font-weight: 720;
    line-height: 1.25;
    text-decoration: none;
  }

  .pg-trust-detail-nav-link:hover,
  .pg-trust-detail-nav-link:focus-visible {
    color: var(--pg-ink);
    background: #f8fbfc;
  }

  .pg-trust-detail-nav-link.is-active {
    border-left-color: var(--pg-teal);
    background: #eef8f7;
    color: var(--pg-ink);
    font-weight: 880;
  }

  .pg-trust-article {
    display: grid;
    gap: 0;
    max-width: 880px;
  }

  .pg-trust-article > section {
    padding: 0 0 30px;
    border-bottom: 1px solid var(--pg-border);
    background: transparent;
  }

  .pg-trust-article > section + section {
    padding-top: 30px;
  }

  .pg-trust-article > section:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .pg-trust-article h2 {
    margin: 0 0 12px;
    font-size: 1.7rem;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .pg-trust-article h3 {
    margin: 0 0 8px;
    font-size: 1.08rem;
    line-height: 1.24;
  }

  .pg-trust-article p {
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-trust-article p + p {
    margin-top: 12px;
  }

  .pg-trust-article ul {
    margin: 14px 0 0;
    padding-left: 22px;
    color: var(--pg-ink-soft);
  }

  .pg-trust-article li + li {
    margin-top: 8px;
  }

  .pg-trust-detail :global(.pg-trust-email-link),
  .pg-trust-article :global(.pg-trust-document-link) {
    color: var(--pg-blue);
    font-weight: 760;
  }

  .pg-trust-detail :global(.pg-trust-email-link:hover),
  .pg-trust-detail :global(.pg-trust-email-link:focus-visible),
  .pg-trust-article :global(.pg-trust-document-link:hover),
  .pg-trust-article :global(.pg-trust-document-link:focus-visible) {
    color: var(--pg-teal);
  }

  .pg-trust-subsection-stack {
    display: grid;
    gap: 20px;
    margin-top: 22px;
  }

  .pg-trust-subsection-stack section {
    padding-left: 18px;
    border-left: 3px solid rgba(20, 149, 143, 0.28);
    background: transparent;
  }

  .pg-trust-table-wrapper {
    width: 100%;
    margin-top: 18px;
    overflow-x: auto;
  }

  .pg-trust-table-wrapper table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    color: var(--pg-ink-soft);
    font-size: 0.94rem;
  }

  .pg-trust-table-wrapper th,
  .pg-trust-table-wrapper td {
    border: 1px solid var(--pg-border);
    padding: 12px;
    text-align: left;
    vertical-align: top;
  }

  .pg-trust-table-wrapper th {
    background: #f8fbfc;
    color: var(--pg-ink);
    font-weight: 850;
  }

  .pg-trust-flow-journey {
    display: grid;
    gap: 0;
    margin-top: 24px;
  }

  .pg-trust-flow-step {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 18px;
    padding: 0 0 28px;
  }

  .pg-trust-flow-step::before {
    content: "";
    position: absolute;
    top: 56px;
    bottom: 0;
    left: 27px;
    border-left: 2px dashed rgba(20, 149, 143, 0.34);
  }

  .pg-trust-flow-step.is-last {
    padding-bottom: 0;
  }

  .pg-trust-flow-step.is-last::before {
    display: none;
  }

  .pg-trust-flow-marker {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid rgba(20, 149, 143, 0.32);
    border-radius: 999px;
    background:
      radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.92), transparent 34%),
      linear-gradient(145deg, #e8fbf8 0%, #ccefeb 100%);
    box-shadow: 0 12px 28px rgba(20, 149, 143, 0.12);
  }

  .pg-trust-flow-marker::after {
    content: "";
    position: absolute;
    right: 5px;
    bottom: 6px;
    width: 10px;
    height: 10px;
    border: 2px solid #ffffff;
    border-radius: 999px;
    background: var(--pg-rose);
  }

  .pg-trust-flow-marker span {
    color: var(--pg-teal);
    font-size: 0.84rem;
    font-weight: 900;
    line-height: 1;
  }

  .pg-trust-flow-content {
    min-width: 0;
    border: 1px solid rgba(20, 149, 143, 0.18);
    border-radius: 8px;
    background:
      linear-gradient(90deg, rgba(238, 248, 247, 0.72), rgba(255, 255, 255, 0.96)),
      #ffffff;
    padding: 20px;
  }

  .pg-trust-flow-actor {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 8px;
    color: var(--pg-ink-soft);
    font-size: 0.86rem;
  }

  .pg-trust-flow-actor span {
    color: var(--pg-teal);
    font-weight: 880;
    text-transform: uppercase;
  }

  .pg-trust-flow-actor strong {
    color: var(--pg-ink);
    font-weight: 780;
  }

  .pg-trust-flow-content h3 {
    margin: 0 0 8px;
    color: var(--pg-ink);
    font-size: 1.24rem;
    line-height: 1.22;
  }

  .pg-trust-flow-description {
    display: grid;
    gap: 5px;
    max-width: 760px;
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-trust-flow-description span {
    color: var(--pg-muted);
    font-size: 0.74rem;
    font-weight: 850;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .pg-trust-flow-description strong {
    color: var(--pg-ink-soft);
    font-weight: 520;
  }

  .pg-trust-flow-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0 0;
  }

  .pg-trust-flow-facts div {
    min-width: 0;
    border-top: 2px solid rgba(20, 149, 143, 0.2);
    padding-top: 10px;
  }

  .pg-trust-flow-facts dt {
    color: var(--pg-muted);
    font-size: 0.74rem;
    font-weight: 850;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .pg-trust-flow-facts dd {
    margin: 5px 0 0;
    color: var(--pg-ink-soft);
    font-size: 0.9rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .pg-trust-next div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 980px) {
    .pg-trust-detail-grid {
      grid-template-columns: 1fr;
    }

    .pg-trust-meta {
      position: static;
      max-height: none;
      overflow: visible;
      padding-right: 0;
    }

  }

  @media (max-width: 640px) {
    .pg-trust-detail-hero {
      padding: 112px 0 48px;
    }

    .pg-trust-detail-hero h1 {
      font-size: 2.45rem;
    }

    .pg-trust-flow-step {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
    }

    .pg-trust-flow-step::before {
      left: 21px;
    }

    .pg-trust-flow-marker {
      width: 44px;
      height: 44px;
    }

    .pg-trust-flow-content {
      padding: 16px;
    }

    .pg-trust-flow-facts {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const setupTrustSidebarSync = () => {
      const sidebar = document.querySelector('[data-trust-scroll-sync-sidebar]');
      const content = document.querySelector('[data-trust-scroll-sync-content]');

      if (!sidebar || !content) {
        return;
      }

      const desktopQuery = window.matchMedia('(min-width: 981px)');
      let frame = 0;

      const syncSidebar = () => {
        frame = 0;

        if (!desktopQuery.matches) {
          sidebar.scrollTop = 0;
          return;
        }

        const sidebarScrollMax = sidebar.scrollHeight - sidebar.clientHeight;

        if (sidebarScrollMax <= 0) {
          sidebar.scrollTop = 0;
          return;
        }

        const stickyTop = Number.parseFloat(getComputedStyle(sidebar).top) || 0;
        const pageY = window.scrollY || window.pageYOffset;
        const contentRect = content.getBoundingClientRect();
        const contentTop = pageY + contentRect.top;
        const contentTravel = Math.max(content.offsetHeight - window.innerHeight + stickyTop, 1);
        const progress = Math.min(
          1,
          Math.max(0, (pageY - contentTop + stickyTop) / contentTravel),
        );

        sidebar.scrollTop = sidebarScrollMax * progress;
      };

      const requestSync = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(syncSidebar);
      };

      window.addEventListener('scroll', requestSync, { passive: true });
      window.addEventListener('resize', requestSync);

      if (typeof desktopQuery.addEventListener === 'function') {
        desktopQuery.addEventListener('change', requestSync);
      }

      if ('ResizeObserver' in window) {
        const observer = new ResizeObserver(requestSync);
        observer.observe(sidebar);
        observer.observe(content);
      }

      requestSync();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTrustSidebarSync, { once: true });
      return;
    }

    setupTrustSidebarSync();
  })();
</script>
