---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import {
  POCKET_GENES_EMAILS,
  getLocalizedTrustDocuments,
  getTrustDocument,
  trustDocuments,
  type TrustDocument,
} from '../../../data/pocketGenesPublic';

export function getStaticPaths() {
  return trustDocuments.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }));
}

interface Props {
  document: TrustDocument;
}

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);
const locale = isEnglish ? 'en' : 'es';
const routeDocument = Astro.props.document;
const document = getTrustDocument(routeDocument.slug, locale) ?? routeDocument;
const isDataFlow = document.slug === 'data-flow-diagram';
const navigationDocuments = getLocalizedTrustDocuments(locale);
const navigationCategories = Array.from(new Set(navigationDocuments.map((navDocument) => navDocument.category))).map((category) => ({
  category,
  documents: navigationDocuments.filter((navDocument) => navDocument.category === category),
}));
const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
const linkTrustEmail = (value: string) =>
  escapeHtml(value).replaceAll(
    POCKET_GENES_EMAILS.trust,
    `<a class="pg-trust-email-link" href="mailto:${POCKET_GENES_EMAILS.trust}">${POCKET_GENES_EMAILS.trust}</a>`,
  );

const pageCopy = {
  en: {
    trustCenterTitle: 'Pocket Genes Trust Center',
    breadcrumbLabel: 'Breadcrumb',
    home: 'Home',
    trustCenter: 'Trust Center',
    metadataLabel: 'Document metadata',
    detailsTitle: 'Document details',
    status: 'Status',
    owner: 'Owner',
    effectiveDate: 'Effective date',
    version: 'Version',
    lastReviewed: 'Last reviewed',
    contact: 'Contact',
    navigationTitle: 'Navigation',
    dataFlowTitle: 'Pocket Genes data-flow diagram',
    dataFlowLabel: 'Pocket Genes data flow',
    relatedPages: 'Related pages',
    download: 'Download Pocket Genes',
    flowSteps: [
      {
        title: 'Report provider',
        body: 'A participating provider makes a genetic report available to its user and remains the source of the report and its findings.',
      },
      {
        title: 'Pocket Genes integration',
        body: 'Pocket Genes receives the information required to connect the intended user with the corresponding mobile experience.',
      },
      {
        title: 'User identification and consent',
        body: 'Where applicable, limited contact information is used to communicate with the intended user and complete the required consent or access process.',
      },
      {
        title: 'Mobile report access',
        body: 'Pocket Genes provides a simple mobile path for the user to reach and navigate the report made available by the provider.',
      },
      {
        title: 'Educational context',
        body: 'Pocket Genes connects the experience with definitions, lessons, relevant resources, and other educational information that can help users understand the concepts around their results.',
      },
      {
        title: 'Discover and community',
        body: 'Users can independently discover organizations, resources, events, and communities related to their interests.',
      },
      {
        title: 'User-controlled participation',
        body: 'Community participation and sharing are separate actions. Accessing a report does not automatically publish its contents or disclose it to other Pocket Genes users.',
      },
    ],
  },
  es: {
    trustCenterTitle: 'Centro de confianza de Pocket Genes',
    breadcrumbLabel: 'Ruta de navegación',
    home: 'Inicio',
    trustCenter: 'Centro de confianza',
    metadataLabel: 'Metadatos del documento',
    detailsTitle: 'Detalles del documento',
    status: 'Estado',
    owner: 'Responsable',
    effectiveDate: 'Vigencia',
    version: 'Versión',
    lastReviewed: 'Última revisión',
    contact: 'Contacto',
    navigationTitle: 'Navegación',
    dataFlowTitle: 'Diagrama de flujo de datos de Pocket Genes',
    dataFlowLabel: 'Flujo de datos de Pocket Genes',
    relatedPages: 'Páginas relacionadas',
    download: 'Descargar Pocket Genes',
    flowSteps: [
      {
        title: 'Proveedor del informe',
        body: 'Un proveedor participante pone un informe genético a disposición de su usuario y sigue siendo la fuente del informe y sus hallazgos.',
      },
      {
        title: 'Integración de Pocket Genes',
        body: 'Pocket Genes recibe la información necesaria para conectar a la persona prevista con la experiencia móvil correspondiente.',
      },
      {
        title: 'Identificación y consentimiento',
        body: 'Cuando corresponde, se usa información limitada de contacto para comunicarse con la persona prevista y completar el proceso requerido de consentimiento o acceso.',
      },
      {
        title: 'Acceso móvil al informe',
        body: 'Pocket Genes brinda un camino móvil simple para que el usuario llegue y navegue el informe puesto a disposición por el proveedor.',
      },
      {
        title: 'Contexto educativo',
        body: 'Pocket Genes conecta la experiencia con definiciones, lecciones, recursos relevantes y otra información educativa que puede ayudar a entender conceptos alrededor de los resultados pero que de ningún modo exponen información personal o sensible del usuario.',
      },
      {
        title: 'Descubrimiento y comunidad',
        body: 'Los usuarios pueden participar de forma independiente y voluntaria de organizaciones, recursos, eventos y comunidades relacionadas con sus intereses.',
      },
      {
        title: 'Participación controlada por el usuario',
        body: 'La participación comunitaria y el intercambio son acciones separadas. Acceder a un informe no publica automáticamente su contenido ni lo revela a otros usuarios de Pocket Genes.',
      },
    ],
  },
} as const;

const copy = pageCopy[locale];
---

<PocketGenesPublicLayout
  title={`${document.title} - ${copy.trustCenterTitle}`}
  description={document.summary}
  canonicalPath={`/pocket-genes/trust-center/${document.slug}`}
>
  <main id="main" class="pg-page pg-trust-detail">
    <section class="pg-trust-detail-hero">
      <div class="pg-container">
        <nav class="pg-breadcrumb" aria-label={copy.breadcrumbLabel}>
          <a href={localizePath('/pocket-genes/home')}>{copy.home}</a>
          <span>/</span>
          <a href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
        </nav>
        <p class="pg-eyebrow">{document.category}</p>
        <h1>{document.title}</h1>
        <p>{document.summary}</p>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container pg-trust-detail-grid">
        <aside class="pg-trust-meta" aria-label={copy.metadataLabel}>
          <nav class="pg-trust-detail-nav" aria-labelledby="pg-trust-detail-nav-title">
            <h2 id="pg-trust-detail-nav-title">{copy.navigationTitle}</h2>
            <div class="pg-trust-detail-nav-groups">
              {navigationCategories.map(({ category, documents }) => (
                <section>
                  <h3>{category}</h3>
                  <ul>
                    {documents.map((navDocument) => {
                      const isCurrent = navDocument.slug === document.slug;

                      return (
                        <li>
                          <a
                            class:list={['pg-trust-detail-nav-link', { 'is-active': isCurrent }]}
                            href={localizePath(`/pocket-genes/trust-center/${navDocument.slug}`)}
                            aria-current={isCurrent ? 'page' : undefined}
                          >
                            {navDocument.title}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              ))}
            </div>
          </nav>

          <h2>{copy.detailsTitle}</h2>
          <dl>
            <div>
              <dt>{copy.status}</dt>
              <dd>{document.status}</dd>
            </div>
            <div>
              <dt>{copy.owner}</dt>
              <dd>{document.owner}</dd>
            </div>
            {document.effectiveDate && (
              <div>
                <dt>{copy.effectiveDate}</dt>
                <dd>{document.effectiveDate}</dd>
              </div>
            )}
            {document.version && (
              <div>
                <dt>{copy.version}</dt>
                <dd>{document.version}</dd>
              </div>
            )}
            <div>
              <dt>{copy.lastReviewed}</dt>
              <dd>{document.lastReviewed}</dd>
            </div>
            <div>
              <dt>{copy.contact}</dt>
              <dd><a href={`mailto:${POCKET_GENES_EMAILS.trust}`}>{POCKET_GENES_EMAILS.trust}</a></dd>
            </div>
          </dl>
        </aside>

        <article class="pg-trust-article">
          {document.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.body && <p set:html={linkTrustEmail(section.body)} />}
              {section.paragraphs?.map((paragraph) => <p set:html={linkTrustEmail(paragraph)} />)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li set:html={linkTrustEmail(bullet)} />)}
                </ul>
              )}
              {section.subsections && (
                <div class="pg-trust-subsection-stack">
                  {section.subsections.map((subsection) => (
                    <section>
                      <h3>{subsection.heading}</h3>
                      {subsection.body && <p set:html={linkTrustEmail(subsection.body)} />}
                      {subsection.bullets && (
                        <ul>
                          {subsection.bullets.map((bullet) => <li set:html={linkTrustEmail(bullet)} />)}
                        </ul>
                      )}
                    </section>
                  ))}
                </div>
              )}
              {section.table && (
                <div class="pg-trust-table-wrapper">
                  <table>
                    <thead>
                      <tr>
                        {section.table.headers.map((header) => <th scope="col" set:html={linkTrustEmail(header)} />)}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell) => <td set:html={linkTrustEmail(cell)} />)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>
          ))}

          {isDataFlow && (
            <section class="pg-data-flow">
              <h2>{copy.dataFlowTitle}</h2>
              <div class="pg-flow-track" aria-label={copy.dataFlowLabel}>
                {copy.flowSteps.map((step, index) => (
                  <article class:list={['pg-flow-step', { 'is-last': index === copy.flowSteps.length - 1 }]}>
                    <span>{index + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </article>
                ))}
              </div>
            </section>
          )}

          <section class="pg-trust-next">
            <h2>{copy.relatedPages}</h2>
            <div>
              <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>{copy.trustCenter}</a>
              <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/download')}>{copy.download}</a>
            </div>
          </section>
        </article>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-trust-detail-hero {
    padding: 128px 0 64px;
    background: #172033;
    color: #ffffff;
  }

  .pg-trust-detail-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-detail-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: 3.6rem;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .pg-trust-detail-hero p {
    max-width: 780px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    color: rgba(255, 255, 255, 0.72);
    font-weight: 780;
  }

  .pg-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .pg-breadcrumb a:hover {
    color: #ffffff;
  }

  .pg-trust-detail-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .pg-trust-meta {
    position: sticky;
    top: 100px;
    border-top: 1px solid var(--pg-border);
    border-bottom: 1px solid var(--pg-border);
    background: transparent;
    padding: 18px 0;
  }

  .pg-trust-meta h2 {
    margin: 0 0 16px;
    font-size: 1.12rem;
  }

  .pg-trust-meta dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .pg-trust-meta dt {
    color: var(--pg-muted);
    font-size: 0.8rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .pg-trust-meta dd {
    margin: 4px 0 0;
    color: var(--pg-ink);
    font-weight: 760;
  }

  .pg-trust-meta a {
    color: var(--pg-blue);
  }

  .pg-trust-detail-nav {
    margin-bottom: 22px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--pg-border);
  }

  .pg-trust-detail-nav h2 {
    margin: 0 0 16px;
    font-size: 1.12rem;
  }

  .pg-trust-detail-nav-groups {
    display: grid;
    gap: 18px;
  }

  .pg-trust-detail-nav section {
    display: grid;
    gap: 8px;
  }

  .pg-trust-detail-nav h3 {
    margin: 0;
    color: var(--pg-muted);
    font-size: 0.76rem;
    font-weight: 850;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .pg-trust-detail-nav ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-trust-detail-nav-link {
    display: block;
    border-left: 3px solid transparent;
    padding: 7px 8px 7px 10px;
    color: var(--pg-ink-soft);
    font-size: 0.9rem;
    font-weight: 720;
    line-height: 1.25;
    text-decoration: none;
  }

  .pg-trust-detail-nav-link:hover,
  .pg-trust-detail-nav-link:focus-visible {
    color: var(--pg-ink);
    background: #f8fbfc;
  }

  .pg-trust-detail-nav-link.is-active {
    border-left-color: var(--pg-teal);
    background: #eef8f7;
    color: var(--pg-ink);
    font-weight: 880;
  }

  .pg-trust-article {
    display: grid;
    gap: 0;
    max-width: 880px;
  }

  .pg-trust-article > section {
    padding: 0 0 30px;
    border-bottom: 1px solid var(--pg-border);
    background: transparent;
  }

  .pg-trust-article > section + section {
    padding-top: 30px;
  }

  .pg-trust-article > section:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .pg-trust-article h2 {
    margin: 0 0 12px;
    font-size: 1.7rem;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .pg-trust-article h3 {
    margin: 0 0 8px;
    font-size: 1.08rem;
    line-height: 1.24;
  }

  .pg-trust-article p {
    margin: 0;
    color: var(--pg-ink-soft);
  }

  .pg-trust-article p + p {
    margin-top: 12px;
  }

  .pg-trust-article ul {
    margin: 14px 0 0;
    padding-left: 22px;
    color: var(--pg-ink-soft);
  }

  .pg-trust-article li + li {
    margin-top: 8px;
  }

  .pg-trust-article :global(.pg-trust-email-link) {
    color: var(--pg-blue);
    font-weight: 760;
  }

  .pg-trust-article :global(.pg-trust-email-link:hover),
  .pg-trust-article :global(.pg-trust-email-link:focus-visible) {
    color: var(--pg-teal);
  }

  .pg-trust-subsection-stack {
    display: grid;
    gap: 20px;
    margin-top: 22px;
  }

  .pg-trust-subsection-stack section {
    padding-left: 18px;
    border-left: 3px solid rgba(20, 149, 143, 0.28);
    background: transparent;
  }

  .pg-trust-table-wrapper {
    width: 100%;
    margin-top: 18px;
    overflow-x: auto;
  }

  .pg-trust-table-wrapper table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    color: var(--pg-ink-soft);
    font-size: 0.94rem;
  }

  .pg-trust-table-wrapper th,
  .pg-trust-table-wrapper td {
    border: 1px solid var(--pg-border);
    padding: 12px;
    text-align: left;
    vertical-align: top;
  }

  .pg-trust-table-wrapper th {
    background: #f8fbfc;
    color: var(--pg-ink);
    font-weight: 850;
  }

  .pg-flow-track {
    display: grid;
    gap: 0;
    margin-top: 18px;
  }

  .pg-flow-step {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 14px;
    min-height: 0;
    padding: 18px 0;
    border-top: 1px solid var(--pg-border);
    background: transparent;
  }

  .pg-flow-step:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .pg-flow-step span {
    width: 34px;
    height: 34px;
    border: 1px solid rgba(20, 149, 143, 0.32);
    border-radius: 999px;
    background: #eef8f7;
    color: var(--pg-teal);
    display: inline-grid;
    place-items: center;
    font-weight: 900;
  }

  .pg-flow-step h3,
  .pg-flow-step p {
    grid-column: 2;
  }

  .pg-flow-step p {
    font-size: 0.94rem;
  }

  .pg-trust-next div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 980px) {
    .pg-trust-detail-grid {
      grid-template-columns: 1fr;
    }

    .pg-trust-meta {
      position: static;
    }

  }

  @media (max-width: 640px) {
    .pg-trust-detail-hero {
      padding: 112px 0 48px;
    }

    .pg-trust-detail-hero h1 {
      font-size: 2.45rem;
    }

    .pg-flow-step {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
