} from '../../../data/discoverPublisherWizard';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const locale = isEnglish ? 'en' : 'es';
const homeHref = isEnglish ? '/en/pocket-genes/home/' : '/pocket-genes/home/';
const otherLanguageHref = isEnglish
  ? '/pocket-genes/join-us/new/'
  : '/en/pocket-genes/join-us/new/';
const sdkUrl =
  import.meta.env.PUBLIC_GOLDENCROW_SDK_URL || 'https://golden-crow-sdk.vercel.app';
const organizationCategories = getWizardCategoryOptions('organization', locale);
const individualCategories = getWizardCategoryOptions('individual', locale);
const countryGroups = getWizardCountryGroups(locale);
const geneticReportCategories = getWizardGeneticReportCategoryOptions(locale);
const socialOptions = getWizardSocialOptions(locale);
const profileColorOptions = ['#6F3CC3', '#E45080', '#14958F', '#2176AE', '#3C9B68', '#D99232'];

