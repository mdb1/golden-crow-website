      const length = descriptionPrimary.value.trim().length;
      const done = length >= DESCRIPTION_MIN_LENGTH;
      const remaining = Math.max(0, DESCRIPTION_MIN_LENGTH - length);
      const progress = Math.min(1, length / DESCRIPTION_MIN_LENGTH);

      descriptionCard?.classList.toggle('is-started', length > 0);
      descriptionCard?.classList.toggle('is-complete', done);

      if (descriptionMeter) {
        descriptionMeter.style.transform = `scaleX(${progress})`;
      }

      if (descriptionCount) {
        descriptionCount.textContent = `${length} / ${DESCRIPTION_MIN_LENGTH} ${copy.descriptionCountLabel}`;
      }

      if (descriptionHelper) {
        descriptionHelper.textContent = done
          ? copy.descriptionReady
          : `${remaining} ${copy.descriptionRemainingLabel}`;
