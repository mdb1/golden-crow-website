    providerBody: 'Esto aplica solo a organizaciones. Contanos si los usuarios de las regiones que listaste pueden recibir un reporte genómico a partir de tus servicios.',
    providerYes: 'Sí',
    providerNo: 'No',
    reportTitle: '¿Qué categoría de reporte genético ofrecen?',
    reportBody: 'Elegí la categoría más cercana. Si no es exacta, elegí Otro o No estoy seguro todavía.',
    step: 'Paso',
    of: 'de',
    back: 'Volver',
    continue: 'Continuar',
    finish: 'Enviar solicitud',
    sending: 'Enviando...',
    selectedCountries: 'países seleccionados',
    selectedCategories: 'categorías seleccionadas',
    required: 'Completá este paso para continuar.',
    urlError: 'Usá una URL HTTP o HTTPS válida.',
    imageUrlError: 'Usá una URL HTTPS de imagen válida.',
    emailError: 'Usá un email válido.',
    submitError: 'No pudimos enviar la solicitud. Intentá nuevamente.',
    successTitle: 'Listo. Lo lograste.',
    successBody: 'Recibimos tu solicitud y vamos a contactarte dentro de las próximas 24 a 48 horas con las credenciales. Si tenemos dudas, vamos a escribirte para coordinar una reunión.',
    callTitle: '¿Querés saber más?',
    callButton: 'Agendar una llamada con nosotros',
    exploreButton: 'Seguir explorando',
    bookingTitle: 'Llamada para publicadores Pocket Genes',
  },
} as const;

const copy = pageCopy[locale];
const wizardClientCopy = {
  step: copy.step,
  of: copy.of,
  continue: copy.continue,
  finish: copy.finish,
  sending: copy.sending,
  back: copy.back,
  selectedCountries: copy.selectedCountries,
  selectedCategories: copy.selectedCategories,
  countryPlaceholder: copy.countryPlaceholder,
  categorySearch: copy.categorySearch,
  countryEmpty: copy.countryEmpty,
  required: copy.required,
  urlError: copy.urlError,
  imageUrlError: copy.imageUrlError,
  emailError: copy.emailError,
  submitError: copy.submitError,
  organizationNameLabel: copy.nameLabelOrganization,
  individualNameLabel: copy.nameLabelIndividual,
  organizationNamePlaceholder: copy.namePlaceholderOrganization,
  individualNamePlaceholder: copy.namePlaceholderIndividual,
  imagePreviewAlt: copy.imagePreviewAlt,
};
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/join-us/new"
  showFooter={false}
>
  <main
    id="main"
    class="pg-wizard-page"
    data-publisher-wizard
    data-locale={locale}
    data-sdk-url={sdkUrl}
    data-home-href={homeHref}
    data-copy={JSON.stringify(wizardClientCopy)}
  >
    <aside class="pg-wizard-intro" aria-label="Pocket Genes">
      <a class="pg-wizard-logo" href={homeHref} aria-label="Pocket Genes">
        <img src="/pocket-genes/icon_simple.png" alt="" width="52" height="52" />
      </a>
      <div class="pg-wizard-intro-copy">
        <h1>{copy.sidebarTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
        <p>{copy.sidebarBody}</p>
        <small>{copy.sidebarHint}</small>
      </div>
    </aside>

    <section class="pg-wizard-panel" aria-labelledby="wizard-current-title">
      <div class="pg-wizard-topbar">
        <a href={otherLanguageHref} aria-label={copy.languageAria}>{copy.languageLabel}</a>
        <a href="https://golden-crow-backoffice.vercel.app/login">{copy.signIn}</a>
      </div>

      <form class="pg-wizard-form" data-wizard-form novalidate>
        <input
          class="pg-wizard-honeypot"
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <div class="pg-wizard-progress" aria-hidden="true">
          <span data-step-dot></span>
          <span data-step-dot></span>
          <span data-step-dot></span>
          <span data-step-dot></span>
          <span data-step-dot></span>
        </div>

        <p class="pg-wizard-step-count" data-step-count></p>

        <div class="pg-wizard-step" data-step-panel="type">
          <div class="pg-step-heading">
            <h2 id="wizard-current-title">{copy.typeTitle}</h2>
            <p>{copy.typeBody}</p>
          </div>
          <div class="pg-choice-grid pg-kind-grid">
            <button type="button" class="pg-choice is-selected" data-kind-option="organization" aria-pressed="true">
              <span>{copy.organizationLabel}</span>
              <small>{copy.organizationBody}</small>
            </button>
            <button type="button" class="pg-choice" data-kind-option="individual" aria-pressed="false">
              <span>{copy.individualLabel}</span>
              <small>{copy.individualBody}</small>
            </button>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="country" hidden>
          <div class="pg-step-heading">
            <h2>{copy.countryTitle}</h2>
            <p>{copy.countryBody}</p>
          </div>
          <div class="pg-picker-shell">
            <button type="button" class="pg-large-field" data-country-toggle aria-expanded="false">
              <span>{copy.countryButtonLabel}</span>
              <strong data-country-summary>{copy.countryPlaceholder}</strong>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="pg-picker-popover" data-country-popover hidden>
              <input type="search" data-country-search placeholder={copy.countrySearch} autocomplete="off" />
              <div class="pg-country-list" data-country-list>
                {countryGroups.map((group) => (
                  <div class="pg-country-group">
                    <p>{group.label}</p>
                    {group.options.map((option) => (
                      <button
                        type="button"
                        data-country-option={option.value}
                        data-label={option.label}
                        aria-pressed="false"
                      >
                        {option.label}
                      </button>
                    ))}
                  </div>
                ))}
              </div>
              <p class="pg-picker-empty" data-country-empty hidden>{copy.countryEmpty}</p>
            </div>
          </div>
          <div class="pg-chip-row" data-country-chips></div>
        </div>

        <div class="pg-wizard-step" data-step-panel="category" hidden>
          <div class="pg-step-heading">
            <h2>{copy.categoryTitle}</h2>
            <p>{copy.categoryBody}</p>
          </div>
          <input class="pg-search-field" type="search" data-category-search placeholder={copy.categorySearch} autocomplete="off" />
          <div class="pg-category-list" data-category-list="organization">
            {organizationCategories.map((option) => (
              <button type="button" data-category-option={option.value} data-label={option.label} aria-pressed="false">
                {option.label}
              </button>
            ))}
          </div>
          <div class="pg-category-list" data-category-list="individual" hidden>
            {individualCategories.map((option) => (
              <button type="button" data-category-option={option.value} data-label={option.label} aria-pressed="false">
                {option.label}
              </button>
            ))}
          </div>
          <p class="pg-selected-note" data-category-summary></p>
        </div>

        <div class="pg-wizard-step" data-step-panel="name" hidden>
          <div class="pg-step-heading">
            <h2>{copy.nameTitle}</h2>
            <p>{copy.nameBody}</p>
          </div>
          <label class="pg-input-shell">
            <span data-name-label>{copy.nameLabelOrganization}</span>
            <input
              type="text"
              name="publisherName"
              data-publisher-name
              maxlength="180"
              autocomplete="organization"
              placeholder={copy.namePlaceholderOrganization}
            />
          </label>
        </div>

        <div class="pg-wizard-step" data-step-panel="description" hidden>
          <div class="pg-step-heading">
            <h2>{copy.descriptionTitle}</h2>
            <p>{copy.descriptionBody}</p>
          </div>
          <label class="pg-input-shell pg-textarea-shell">
            <span>{copy.descriptionLabel}</span>
            <textarea
              name="descriptionPrimary"
              data-description-primary
              maxlength="5000"
              rows="7"
              placeholder={copy.descriptionPlaceholder}
            ></textarea>
          </label>
          <button type="button" class="pg-secondary-action" data-alt-description-toggle>
            {copy.altDescriptionButton}
          </button>
          <label class="pg-input-shell pg-textarea-shell" data-alt-description-field hidden>
            <span>{copy.altDescriptionLabel}</span>
            <textarea name="descriptionAlternative" data-description-alternative maxlength="5000" rows="5"></textarea>
          </label>
        </div>

        <div class="pg-wizard-step" data-step-panel="email" hidden>
          <div class="pg-step-heading">
            <h2>{copy.emailTitle}</h2>
            <p>{copy.emailBody}</p>
          </div>
          <label class="pg-input-shell">
            <span>{copy.emailLabel}</span>
            <input
              type="email"
              name="contactEmail"
              data-contact-email
              maxlength="180"
              autocomplete="email"
              placeholder={copy.emailPlaceholder}
            />
          </label>
        </div>

        <div class="pg-wizard-step" data-step-panel="website" hidden>
          <div class="pg-step-heading">
            <h2>{copy.websiteTitle}</h2>
            <p>{copy.websiteBody}</p>
          </div>
          <label class="pg-input-shell">
            <span>{copy.websiteLabel}</span>
            <input
              type="url"
              name="websiteUrl"
              data-website-url
              maxlength="1000"
              placeholder={copy.websitePlaceholder}
            />
          </label>
          <p class="pg-skip-hint">{copy.skipHint}</p>
        </div>

        <div class="pg-wizard-step" data-step-panel="image" hidden>
          <div class="pg-step-heading">
            <h2>{copy.imageTitle}</h2>
            <p>{copy.imageBody}</p>
          </div>
          <div class="pg-image-grid">
            <div>
              <label class="pg-input-shell">
                <span>{copy.imageLabel}</span>
                <input
                  type="url"
                  name="imageUrl"
                  data-image-url
                  maxlength="1000"
                  placeholder={copy.imagePlaceholder}
                />
              </label>
              <p class="pg-skip-hint">{copy.skipHint}</p>
            </div>
            <div class="pg-profile-preview" data-profile-preview>
              <div class="pg-preview-image" data-preview-image>
                <span>PG</span>
              </div>
              <label>
                <span>{copy.colorLabel}</span>
                <input type="color" value="#6F3CC3" data-color-input />
              </label>
              <button type="button" data-use-suggested-color>{copy.colorSuggested}</button>
            </div>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="social" hidden>
          <div class="pg-step-heading">
            <h2>{copy.socialTitle}</h2>
            <p>{copy.socialBody}</p>
          </div>
          <div class="pg-social-list" data-social-list></div>
          <button
            type="button"
            class="pg-secondary-action"
            data-add-social
            data-platform-label={copy.socialPlatformLabel}
            data-url-label={copy.socialUrlLabel}
            data-url-placeholder={copy.socialUrlPlaceholder}
            data-social-options={JSON.stringify(WIZARD_SOCIAL_OPTIONS)}
          >
            {copy.addSocial}
          </button>
          <p class="pg-skip-hint">{copy.skipHint}</p>
        </div>

        <div class="pg-wizard-step" data-step-panel="provider" hidden>
          <div class="pg-step-heading">
            <h2>{copy.providerTitle}</h2>
            <p>{copy.providerBody}</p>
          </div>
          <div class="pg-choice-grid pg-answer-grid">
            <button type="button" class="pg-choice" data-provider-option="true" aria-pressed="false">
              <span>{copy.providerYes}</span>
            </button>
            <button type="button" class="pg-choice" data-provider-option="false" aria-pressed="false">
              <span>{copy.providerNo}</span>
            </button>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="report" hidden>
          <div class="pg-step-heading">
            <h2>{copy.reportTitle}</h2>
            <p>{copy.reportBody}</p>
          </div>
          <div class="pg-category-list pg-report-list">
            {geneticReportCategories.map((option) => (
              <button
                type="button"
                data-report-category-option={option.value}
                aria-pressed={option.value === '' ? 'true' : 'false'}
                class:list={[{ 'is-selected': option.value === '' }]}
              >
                {option.label}
              </button>
            ))}
          </div>
        </div>

        <p class="pg-wizard-error" data-wizard-error role="alert" hidden></p>
      </form>

      <div class="pg-wizard-actionbar">
        <button type="button" class="pg-back-button" data-wizard-back>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span>{copy.back}</span>
        </button>
        <button type="button" class="pg-primary-button" data-wizard-next>{copy.continue}</button>
      </div>
    </section>

    <section class="pg-wizard-success" data-wizard-success hidden>
      <span class="pg-success-circle" aria-hidden="true"></span>
      <div class="pg-success-content">
        <div class="pg-success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>
        <h2>{copy.successTitle}</h2>
        <p>{copy.successBody}</p>
        <div class="pg-success-actions">
          <button type="button" data-open-booking>
            <span>{copy.callTitle}</span>
            <strong>{copy.callButton}</strong>
          </button>
          <a href={homeHref}>{copy.exploreButton}</a>
        </div>
        <div class="pg-success-booking" data-success-booking hidden>
          <ClientBookingWidget
            context="pocket-genes-join-us-wizard"
            eventTitle={copy.bookingTitle}
            brandName="Pocket Genes"
            emphasizeBrandName={false}
          />
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<script>
  const wizardRoot = document.querySelector('[data-publisher-wizard]');

  if (wizardRoot) {
    const copy = JSON.parse(wizardRoot.getAttribute('data-copy') || '{}');
    const locale = wizardRoot.getAttribute('data-locale') || 'es';
    const sdkUrl = wizardRoot.getAttribute('data-sdk-url') || 'https://golden-crow-sdk.vercel.app';
    const state = {
      kind: 'organization',
      countries: [],
      categories: {
        organization: [],
        individual: [],
      },
      geneticReportProvider: null,
      geneticReportCategory: '',
      currentStep: 0,
      color: '#6F3CC3',
      suggestedColor: '#6F3CC3',
      colorCustomized: false,
      submitting: false,
      startedAt: new Date().toISOString(),
    };

    const form = wizardRoot.querySelector('[data-wizard-form]');
    const panels = Array.from(wizardRoot.querySelectorAll('[data-step-panel]'));
    const stepCount = wizardRoot.querySelector('[data-step-count]');
    const dots = Array.from(wizardRoot.querySelectorAll('[data-step-dot]'));
    const nextButton = wizardRoot.querySelector('[data-wizard-next]');
    const backButton = wizardRoot.querySelector('[data-wizard-back]');
    const errorBox = wizardRoot.querySelector('[data-wizard-error]');
    const countryToggle = wizardRoot.querySelector('[data-country-toggle]');
    const countryPopover = wizardRoot.querySelector('[data-country-popover]');
    const countrySearch = wizardRoot.querySelector('[data-country-search]');
    const countrySummary = wizardRoot.querySelector('[data-country-summary]');
    const countryChips = wizardRoot.querySelector('[data-country-chips]');
    const countryEmpty = wizardRoot.querySelector('[data-country-empty]');
    const categorySearch = wizardRoot.querySelector('[data-category-search]');
    const categorySummary = wizardRoot.querySelector('[data-category-summary]');
    const nameInput = wizardRoot.querySelector('[data-publisher-name]');
    const nameLabel = wizardRoot.querySelector('[data-name-label]');
    const descriptionPrimary = wizardRoot.querySelector('[data-description-primary]');
    const descriptionAlternative = wizardRoot.querySelector('[data-description-alternative]');
    const altDescriptionToggle = wizardRoot.querySelector('[data-alt-description-toggle]');
    const altDescriptionField = wizardRoot.querySelector('[data-alt-description-field]');
    const contactEmail = wizardRoot.querySelector('[data-contact-email]');
    const websiteUrl = wizardRoot.querySelector('[data-website-url]');
    const imageUrl = wizardRoot.querySelector('[data-image-url]');
    const previewImage = wizardRoot.querySelector('[data-preview-image]');
    const colorInput = wizardRoot.querySelector('[data-color-input]');
    const useSuggestedColor = wizardRoot.querySelector('[data-use-suggested-color]');
    const addSocialButton = wizardRoot.querySelector('[data-add-social]');
    const socialList = wizardRoot.querySelector('[data-social-list]');
    const success = wizardRoot.querySelector('[data-wizard-success]');
    const openBooking = wizardRoot.querySelector('[data-open-booking]');
    const successBooking = wizardRoot.querySelector('[data-success-booking]');

    function visibleSteps() {
      const steps = ['type', 'country', 'category', 'name', 'description', 'email', 'website', 'image', 'social'];

      if (state.kind === 'organization') {
        steps.push('provider');
        if (state.geneticReportProvider === true) {
          steps.push('report');
        }
      }

      return steps;
    }

    function activeStepKey() {
      return visibleSteps()[state.currentStep] || 'type';
    }

    function setError(message) {
      if (!errorBox) return;
      errorBox.textContent = message || '';
      errorBox.hidden = !message;
    }

    function validUrl(value, httpsOnly = false) {
      if (!value.trim()) return true;
      try {
        const parsed = new URL(value.trim());
        return httpsOnly
          ? parsed.protocol === 'https:'
          : parsed.protocol === 'http:' || parsed.protocol === 'https:';
      } catch {
        return false;
      }
    }

    function validEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
    }

    function selectedCategoryValues() {
      return state.categories[state.kind] || [];
    }

    function validateCurrentStep({ silent = false } = {}) {
      const step = activeStepKey();
      let message = '';

      if (step === 'country' && state.countries.length === 0) {
        message = copy.required;
      } else if (step === 'category' && selectedCategoryValues().length === 0) {
        message = copy.required;
      } else if (step === 'name' && !nameInput?.value.trim()) {
        message = copy.required;
      } else if (step === 'description' && !descriptionPrimary?.value.trim()) {
        message = copy.required;
      } else if (step === 'email') {
        message = contactEmail?.value.trim() && validEmail(contactEmail.value)
          ? ''
          : copy.emailError;
      } else if (step === 'website' && websiteUrl && !validUrl(websiteUrl.value)) {
        message = copy.urlError;
      } else if (step === 'image' && imageUrl && !validUrl(imageUrl.value, true)) {
        message = copy.imageUrlError;
      } else if (step === 'social') {
        const invalidSocial = Array.from(wizardRoot.querySelectorAll('[data-social-url]')).some(
          (input) => input.value.trim() && !validUrl(input.value),
        );
        message = invalidSocial ? copy.urlError : '';
      } else if (step === 'provider' && state.geneticReportProvider === null) {
        message = copy.required;
      }

      if (!silent) {
        setError(message);
      }

      return !message;
    }

    function updateNameCopy() {
      if (!nameInput || !nameLabel) return;

      if (state.kind === 'organization') {
        nameLabel.textContent = copy.organizationNameLabel;
        nameInput.setAttribute('placeholder', copy.organizationNamePlaceholder);
        nameInput.setAttribute('autocomplete', 'organization');
      } else {
        nameLabel.textContent = copy.individualNameLabel;
        nameInput.setAttribute('placeholder', copy.individualNamePlaceholder);
        nameInput.setAttribute('autocomplete', 'name');
      }
    }

    function updateCountryUi() {
      const selected = new Set(state.countries);
      let selectedLabels = [];

      wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
        const value = button.getAttribute('data-country-option');
        const active = selected.has(value);
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        if (active) {
          selectedLabels.push(button.getAttribute('data-label') || value);
        }
      });

      if (countrySummary) {
        countrySummary.textContent = selectedLabels.length
          ? `${selectedLabels.length} ${copy.selectedCountries}`
          : copy.countryPlaceholder;
      }

      if (countryChips) {
        countryChips.replaceChildren(
          ...selectedLabels.map((label) => {
            const chip = document.createElement('span');
            chip.textContent = label;
            return chip;
          }),
        );
      }
    }

    function updateCategoryUi() {
      const selected = new Set(selectedCategoryValues());
      wizardRoot.querySelectorAll('[data-category-list]').forEach((list) => {
        const listKind = list.getAttribute('data-category-list');
        list.hidden = listKind !== state.kind;
      });

      wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
        const value = button.getAttribute('data-category-option');
        const active = selected.has(value);
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      if (categorySummary) {
        const count = selectedCategoryValues().length;
        categorySummary.textContent = count ? `${count} ${copy.selectedCategories}` : '';
      }
    }

    function updateProviderUi() {
      wizardRoot.querySelectorAll('[data-provider-option]').forEach((button) => {
        const active = String(state.geneticReportProvider) === button.getAttribute('data-provider-option');
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      wizardRoot.querySelectorAll('[data-report-category-option]').forEach((button) => {
        const active = state.geneticReportCategory === button.getAttribute('data-report-category-option');
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function updateColor(value) {
      state.color = value;
      if (colorInput) colorInput.value = value;
      if (previewImage) {
        previewImage.style.setProperty('--wizard-preview-color', value);
      }
    }

    function renderStep() {
      const steps = visibleSteps();
      if (state.currentStep >= steps.length) {
        state.currentStep = steps.length - 1;
      }

      const step = activeStepKey();
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-step-panel') !== step;
      });

      if (stepCount) {
        stepCount.textContent = `${copy.step} ${state.currentStep + 1} ${copy.of} ${steps.length}`;
      }

      dots.forEach((dot, index) => {
        const progressIndex = Math.round((index / Math.max(dots.length - 1, 1)) * (steps.length - 1));
        dot.classList.toggle('is-active', progressIndex <= state.currentStep);
      });

      if (backButton) {
        backButton.disabled = state.currentStep === 0 || state.submitting;
      }

      if (nextButton) {
        const last = state.currentStep === steps.length - 1;
        nextButton.textContent = state.submitting
          ? copy.sending
          : last
            ? copy.finish
            : copy.continue;
        nextButton.disabled = state.submitting || !validateCurrentStep({ silent: true });
      }

      updateNameCopy();
      updateCountryUi();
      updateCategoryUi();
      updateProviderUi();
    }

    function toggleCountry(value) {
      if (!value) return;

      if (value === 'GLOBAL') {
        state.countries = state.countries.includes('GLOBAL') ? [] : ['GLOBAL'];
      } else {
        const current = state.countries.filter((code) => code !== 'GLOBAL');
        state.countries = current.includes(value)
          ? current.filter((code) => code !== value)
          : [...current, value];
      }

      setError('');
      renderStep();
    }

    function toggleCategory(value) {
      if (!value) return;
      const current = selectedCategoryValues();
      state.categories[state.kind] = current.includes(value)
        ? current.filter((category) => category !== value)
        : [...current, value];
      setError('');
      renderStep();
    }

    function filterCountryOptions(query) {
      const normalized = query.trim().toLowerCase();
      let visibleCount = 0;

      wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
        const label = (button.getAttribute('data-label') || '').toLowerCase();
        const visible = !normalized || label.includes(normalized);
        button.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      wizardRoot.querySelectorAll('.pg-country-group').forEach((group) => {
        const visibleButtons = Array.from(group.querySelectorAll('[data-country-option]')).some(
          (button) => !button.hidden,
        );
        group.hidden = !visibleButtons;
      });

      if (countryEmpty) {
        countryEmpty.hidden = visibleCount > 0;
      }
    }

    function filterCategoryOptions(query) {
      const normalized = query.trim().toLowerCase();
      wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
        const label = (button.getAttribute('data-label') || '').toLowerCase();
        button.hidden = Boolean(normalized) && !label.includes(normalized);
      });
    }

    function deterministicColor(seed) {
      const colors = ['#6F3CC3', '#E45080', '#14958F', '#2176AE', '#3C9B68', '#D99232'];
      let hash = 0;
      const text = seed || nameInput?.value || 'Pocket Genes';

      for (let index = 0; index < text.length; index += 1) {
        hash = (hash * 31 + text.charCodeAt(index)) % 9973;
      }

      return colors[Math.abs(hash) % colors.length];
    }

    function averageImageColor(url) {
      return new Promise((resolve) => {
        if (!url.trim()) {
          resolve(deterministicColor('Pocket Genes'));
          return;
        }

        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => {
          try {
            const canvas = document.createElement('canvas');
            const size = 24;
            canvas.width = size;
            canvas.height = size;
            const context = canvas.getContext('2d', { willReadFrequently: true });
            context.drawImage(image, 0, 0, size, size);
            const { data } = context.getImageData(0, 0, size, size);
            let r = 0;
            let g = 0;
            let b = 0;
            let count = 0;

            for (let index = 0; index < data.length; index += 4) {
              const alpha = data[index + 3];
              if (alpha < 80) continue;
              r += data[index];
              g += data[index + 1];
              b += data[index + 2];
              count += 1;
            }

            if (!count) {
              resolve(deterministicColor(url));
              return;
            }

            const hex = [r / count, g / count, b / count]
              .map((channel) => Math.max(0, Math.min(255, Math.round(channel))).toString(16).padStart(2, '0'))
              .join('');
            resolve(`#${hex}`.toUpperCase());
          } catch {
            resolve(deterministicColor(url));
          }
        };
        image.onerror = () => resolve(deterministicColor(url));
        image.src = url.trim();
      });
    }

    let colorTimer;
    function updateImagePreview() {
      if (!imageUrl || !previewImage) return;
      const url = imageUrl.value.trim();
      previewImage.replaceChildren();

      if (url && validUrl(url, true)) {
        const image = document.createElement('img');
        image.src = url;
        image.alt = copy.imagePreviewAlt;
        previewImage.append(image);
      } else {
        const initials = document.createElement('span');
        const text = nameInput?.value.trim() || 'Pocket Genes';
        initials.textContent = text
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0])
          .join('')
          .toUpperCase() || 'PG';
        previewImage.append(initials);
      }

      window.clearTimeout(colorTimer);
      colorTimer = window.setTimeout(async () => {
        const suggested = await averageImageColor(url);
        state.suggestedColor = suggested;
        if (!state.colorCustomized) {
          updateColor(suggested);
        }
      }, 350);
    }

    function createSocialRow() {
      if (!addSocialButton || !socialList) return;
      const options = JSON.parse(addSocialButton.getAttribute('data-social-options') || '[]');
      const row = document.createElement('div');
      row.className = 'pg-social-row';

      const selectLabel = document.createElement('label');
      const selectCaption = document.createElement('span');
      selectCaption.textContent = addSocialButton.getAttribute('data-platform-label') || 'Platform';
      const select = document.createElement('select');
      select.setAttribute('data-social-platform', '');
      options.forEach((option) => {
        const item = document.createElement('option');
        item.value = option.value;
        item.textContent = option.label;
        select.append(item);
      });
      selectLabel.append(selectCaption, select);

      const urlLabel = document.createElement('label');
      const urlCaption = document.createElement('span');
      urlCaption.textContent = addSocialButton.getAttribute('data-url-label') || 'URL';
      const url = document.createElement('input');
      url.type = 'url';
      url.maxLength = 1000;
      url.placeholder = addSocialButton.getAttribute('data-url-placeholder') || 'https://...';
      url.setAttribute('data-social-url', '');
      url.addEventListener('input', () => renderStep());
      urlLabel.append(urlCaption, url);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'pg-social-remove';
      remove.textContent = 'x';
      remove.setAttribute('aria-label', locale === 'es' ? 'Quitar red social' : 'Remove social link');
      remove.addEventListener('click', () => {
        row.remove();
        renderStep();
      });

      row.append(selectLabel, urlLabel, remove);
      socialList.append(row);
      url.focus();
      renderStep();
    }

    function collectSocialLinks() {
      const social = {};
      wizardRoot.querySelectorAll('.pg-social-row').forEach((row) => {
        const platform = row.querySelector('[data-social-platform]')?.value;
        const url = row.querySelector('[data-social-url]')?.value.trim();
        if (platform && url) {
          social[platform] = url;
        }
      });
      return Object.keys(social).length ? social : undefined;
    }

    function optionalValue(input) {
      const value = input?.value.trim();
      return value || undefined;
    }

    function buildPayload() {
      const payload = {
        kind: state.kind,
        locale,
        name: nameInput.value.trim(),
        contactEmail: contactEmail.value.trim().toLowerCase(),
        countryCode: state.countries.join(','),
        color_hex: state.color,
        websiteUrl: optionalValue(websiteUrl),
        imageUrl: optionalValue(imageUrl),
        social: collectSocialLinks(),
        startedAt: state.startedAt,
        website: form?.elements.website?.value || undefined,
        source: {
          pageUrl: window.location.href,
          referrer: document.referrer || undefined,
        },
      };

      if (locale === 'en') {
        payload.description_en = descriptionPrimary.value.trim();
        payload.description = optionalValue(descriptionAlternative);
      } else {
        payload.description = descriptionPrimary.value.trim();
        payload.description_en = optionalValue(descriptionAlternative);
      }

      if (state.kind === 'organization') {
        payload.organizationType = state.categories.organization.join(',');
        payload.is_genetic_report_provider = state.geneticReportProvider === true;
        payload.genetic_report_category =
          state.geneticReportProvider === true
            ? state.geneticReportCategory || null
            : null;
      } else {
        payload.individualType = state.categories.individual.join(',');
      }

      return payload;
    }

    async function submitWizard() {
      state.submitting = true;
      renderStep();
      setError('');

      try {
        const response = await fetch(`${sdkUrl.replace(/\/$/, '')}/discover/publisher-requests`, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify(buildPayload()),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || copy.submitError);
        }

        if (success) {
          success.hidden = false;
          requestAnimationFrame(() => {
            success.classList.add('is-visible');
          });
        }
      } catch (error) {
        setError(error instanceof Error ? error.message : copy.submitError);
      } finally {
        state.submitting = false;
        renderStep();
      }
    }

    wizardRoot.querySelectorAll('[data-kind-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.kind = button.getAttribute('data-kind-option') || 'organization';
        state.currentStep = Math.min(state.currentStep, visibleSteps().length - 1);
        wizardRoot.querySelectorAll('[data-kind-option]').forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-selected', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        setError('');
        renderStep();
      });
    });

    wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleCountry(button.getAttribute('data-country-option'));
      });
    });

    wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleCategory(button.getAttribute('data-category-option'));
      });
    });

    wizardRoot.querySelectorAll('[data-provider-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.geneticReportProvider = button.getAttribute('data-provider-option') === 'true';
        setError('');
        renderStep();
      });
    });

    wizardRoot.querySelectorAll('[data-report-category-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.geneticReportCategory = button.getAttribute('data-report-category-option') || '';
        setError('');
        renderStep();
      });
    });

    countryToggle?.addEventListener('click', () => {
      if (!countryPopover) return;
      countryPopover.hidden = !countryPopover.hidden;
      countryToggle.setAttribute('aria-expanded', countryPopover.hidden ? 'false' : 'true');
      if (!countryPopover.hidden) {
        countrySearch?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!countryPopover || countryPopover.hidden) return;
      if (!event.target.closest('.pg-picker-shell')) {
        countryPopover.hidden = true;
        countryToggle?.setAttribute('aria-expanded', 'false');
      }
    });

    countrySearch?.addEventListener('input', () => filterCountryOptions(countrySearch.value));
    categorySearch?.addEventListener('input', () => filterCategoryOptions(categorySearch.value));
    addSocialButton?.addEventListener('click', createSocialRow);
    altDescriptionToggle?.addEventListener('click', () => {
      if (!altDescriptionField) return;
      altDescriptionField.hidden = false;
      altDescriptionToggle.hidden = true;
      descriptionAlternative?.focus();
    });
    colorInput?.addEventListener('input', () => {
      state.colorCustomized = true;
      updateColor(colorInput.value);
    });
    useSuggestedColor?.addEventListener('click', () => {
      state.colorCustomized = false;
      updateColor(state.suggestedColor);
    });
    imageUrl?.addEventListener('input', () => {
      updateImagePreview();
      renderStep();
    });
    nameInput?.addEventListener('input', () => {
      if (!state.colorCustomized && !imageUrl?.value.trim()) {
        state.suggestedColor = deterministicColor(nameInput.value);
        updateColor(state.suggestedColor);
      }
      updateImagePreview();
      renderStep();
    });
    [descriptionPrimary, descriptionAlternative, contactEmail, websiteUrl].forEach((input) => {
      input?.addEventListener('input', () => renderStep());
    });

    nextButton?.addEventListener('click', () => {
      if (!validateCurrentStep()) return;

      const steps = visibleSteps();
      if (state.currentStep === steps.length - 1) {
        void submitWizard();
        return;
      }

      state.currentStep += 1;
      setError('');
      renderStep();
    });

    backButton?.addEventListener('click', () => {
      state.currentStep = Math.max(0, state.currentStep - 1);
      setError('');
      renderStep();
    });

    openBooking?.addEventListener('click', () => {
      if (!successBooking) return;
      successBooking.hidden = false;
      successBooking.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    renderStep();
    updateImagePreview();
  }
</script>

