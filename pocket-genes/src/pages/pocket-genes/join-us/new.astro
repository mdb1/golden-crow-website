  .pg-suggested-color-button {
    color: var(--wizard-purple);
    font-weight: 760;
  }

  .pg-suggested-color-button [data-suggested-color-swatch] {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    border-radius: 999px;
    background: var(--wizard-purple);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.85);
  }

  .pg-color-preview {
    position: relative;
    justify-self: end;
    width: 132px;
    min-height: 132px;
    display: grid;
    place-items: center;
    gap: 8px;
  }

  .pg-color-swatch {
    width: 78px;
    height: 78px;
    border-radius: 26px;
    background: var(--wizard-purple);
    box-shadow: 0 18px 34px rgba(111, 60, 195, 0.24);
  }

  .pg-color-orbit {
    position: absolute;
    inset: 13px;
    border: 1px solid rgba(111, 60, 195, 0.24);
    border-radius: 999px;
    animation: pgColorOrbit 2800ms ease-in-out infinite;
  }

  .pg-color-preview small {
    align-self: end;
    color: var(--wizard-muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
  }

  .pg-social-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.92fr);
    gap: 18px;
    align-items: start;
  }

  .pg-social-picker-panel,
  .pg-social-selected-panel {
    border: 1px solid rgba(200, 203, 210, 0.86);
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 18px 38px rgba(32, 33, 39, 0.06);
    padding: 18px;
  }

  .pg-social-picker-panel {
    background:
      linear-gradient(135deg, rgba(111, 60, 195, 0.055), rgba(20, 149, 143, 0.035)),
      #ffffff;
  }

  .pg-social-panel-heading {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
  }

  .pg-social-panel-heading > span {
    width: fit-content;
    border-radius: 999px;
    background: #eef8f7;
    color: #0f6f6a;
    padding: 5px 10px;
    font-size: 0.76rem;
    line-height: 1;
    font-weight: 780;
    text-transform: uppercase;
  }

  .pg-social-panel-heading h3 {
    margin: 0;
    color: var(--wizard-ink);
    font-size: 1.08rem;
    line-height: 1.24;
  }

  .pg-social-panel-heading p {
    margin: 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.42;
  }

