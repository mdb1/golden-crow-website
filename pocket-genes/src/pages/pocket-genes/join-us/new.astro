    font-size: clamp(1.2rem, 2vw, 1.72rem);
    line-height: 1.25;
  }

  .pg-modal-close {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: inline-grid;
    place-items: center;
    border: 1px solid rgba(200, 203, 210, 0.9);
    border-radius: 999px;
    background: #ffffff;
    color: var(--wizard-muted);
    font: inherit;
    font-size: 1rem;
    font-weight: 820;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  .pg-modal-close:hover,
  .pg-modal-close:focus-visible {
    transform: scale(1.04);
    border-color: rgba(111, 60, 195, 0.38);
    color: var(--wizard-purple);
    box-shadow: 0 12px 26px rgba(111, 60, 195, 0.12);
  }

  .pg-picker-popover input,
  .pg-search-field {
    width: 100%;
    height: 52px;
    border: 1px solid var(--wizard-border);
    border-radius: 999px;
    padding: 0 18px;
    color: var(--wizard-ink);
    font: inherit;
  }

  .pg-country-list {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: 16px;
    border: 1px solid rgba(226, 229, 235, 0.9);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.86);
    overflow: auto;
    padding: 16px;
    overscroll-behavior: contain;
  }

  .pg-country-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 8px;
  }

  .pg-country-group + .pg-country-group {
    margin-top: 22px;
  }

  .pg-country-group p {
    grid-column: 1 / -1;
    margin: 0 0 8px;
    color: var(--wizard-muted);
    font-size: 0.78rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .pg-country-list button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 58px;
    border-radius: 18px;
    margin: 0;
    padding: 12px 14px;
    text-align: left;
    font: inherit;
    font-weight: 680;
    box-shadow: 0 8px 20px rgba(32, 33, 39, 0.045);
  }

  .pg-picker-empty {
    margin: 12px 4px 4px;
    color: var(--wizard-muted);
  }

  .pg-picker-modal-actions {
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid rgba(236, 238, 242, 0.95);
    margin-top: 16px;
    padding-top: 16px;
  }

  .pg-picker-done {
    min-height: 52px;
    min-width: 132px;
    border: 0;
    border-radius: 999px;
    background: var(--wizard-purple);
    color: #ffffff;
    padding: 0 24px;
    font: inherit;
    font-weight: 780;
    cursor: pointer;
    box-shadow: 0 14px 28px rgba(111, 60, 195, 0.2);
  }

  .pg-country-selected-summary {
    max-width: 580px;
    min-height: 48px;
    display: grid;
    gap: 4px;
    margin-top: 16px;
    border: 1px solid rgba(20, 149, 143, 0.18);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(238, 248, 247, 0.96), rgba(243, 236, 255, 0.72));
    color: #0f6f6a;
    padding: 10px 14px;
    animation: pgStepIn 220ms ease both;
  }

  .pg-country-selected-summary strong {
    color: var(--wizard-ink);
    font-size: 0.92rem;
    line-height: 1.25;
  }

  .pg-country-selected-summary span {
    min-width: 0;
    overflow: hidden;
    color: #0f6f6a;
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pg-country-flag,
  .pg-country-summary-flag {
    width: 24px;
    flex: 0 0 24px;
    display: inline-grid;
    place-items: center;
    font-size: 1.05rem;
    line-height: 1;
  }

  .pg-large-field strong span {
    color: inherit;
    line-height: inherit;
    font-weight: inherit;
  }

  .pg-large-field strong span:not(.pg-country-summary-flag) {
    font-size: inherit;
  }

  .pg-search-field {
    max-width: 520px;
    margin-bottom: 18px;
  }

  .pg-category-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: 12px;
    max-height: none;
    overflow: visible;
    padding: 2px 2px 8px;
  }

  .pg-category-list button {
    min-height: 54px;
    border-radius: 999px;
    padding: 13px 18px;
    font: inherit;
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 650;
  }

  .pg-selected-note,
  .pg-skip-hint {
    margin: 18px 0 0;
    color: var(--wizard-muted);
    font-size: 0.98rem;
  }

  .pg-input-shell {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pg-input-shell input,
  .pg-input-shell textarea {
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--wizard-ink);
    font: inherit;
    font-size: 1.16rem;
    line-height: 1.35;
  }

  .pg-textarea-shell {
    min-height: 210px;
  }

  .pg-input-shell textarea {
    resize: vertical;
    min-height: 144px;
  }

  .pg-description-composer {
    display: grid;
    gap: 18px;
    max-width: 760px;
  }

  .pg-description-card {
    position: relative;
    isolation: isolate;
    min-height: 278px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(111, 60, 195, 0.055), rgba(20, 149, 143, 0.035)),
      #ffffff;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .pg-description-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 24px -70px auto;
    width: 160px;
    height: 160px;
    border-radius: 999px;
    background: rgba(111, 60, 195, 0.1);
    filter: blur(18px);
    opacity: 0;
    transform: scale(0.75);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .pg-description-card.is-started {
    border-color: rgba(111, 60, 195, 0.42);
  }

  .pg-description-card.is-writing {
    transform: translateY(-1px);
    box-shadow: 0 22px 45px rgba(32, 33, 39, 0.12);
  }

  .pg-description-card.is-writing::before,
  .pg-description-card.is-complete::before {
    opacity: 1;
    transform: scale(1);
  }

  .pg-description-card.is-complete {
    border-color: rgba(20, 149, 143, 0.65);
    box-shadow: 0 18px 38px rgba(20, 149, 143, 0.12);
  }

  .pg-description-card textarea {
    position: relative;
    z-index: 1;
    min-height: 156px;
  }

  .pg-description-meter {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: #eceef4;
  }

  .pg-description-meter span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--wizard-purple), #14958f);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .pg-description-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .pg-description-footer small {
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.42;
  }

  .pg-description-footer strong {
    flex: 0 0 auto;
    border: 1px solid rgba(111, 60, 195, 0.2);
    border-radius: 999px;
    color: var(--wizard-purple);
    padding: 7px 12px;
    font-size: 0.84rem;
    line-height: 1;
    white-space: nowrap;
  }

  .pg-description-card.is-complete .pg-description-footer strong {
    border-color: rgba(20, 149, 143, 0.25);
    background: #eef8f7;
    color: #0f6f6a;
  }

  .pg-writing-pulses {
    position: absolute;
    right: 22px;
    bottom: 72px;
    display: inline-flex;
    gap: 5px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .pg-writing-pulses span {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--wizard-purple);
  }

  .pg-description-card.is-writing .pg-writing-pulses {
    opacity: 1;
  }

  .pg-description-card.is-writing .pg-writing-pulses span {
    animation: pgWritingPulse 720ms ease-in-out infinite;
  }

  .pg-description-card.is-writing .pg-writing-pulses span:nth-child(2) {
    animation-delay: 90ms;
  }

  .pg-description-card.is-writing .pg-writing-pulses span:nth-child(3) {
    animation-delay: 180ms;
  }

  .pg-description-prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pg-description-prompts span {
    border: 1px solid rgba(111, 60, 195, 0.14);
    border-radius: 999px;
    background: rgba(111, 60, 195, 0.06);
    color: #553096;
    padding: 8px 13px;
    font-size: 0.88rem;
    font-weight: 680;
  }

  .pg-alt-description-offer,
  .pg-alt-description-panel {
    border: 1px solid rgba(200, 203, 210, 0.9);
    border-radius: 20px;
    background: #ffffff;
    padding: 18px;
  }

  .pg-alt-description-offer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .pg-alt-description-offer strong,
  .pg-alt-description-heading strong {
    display: block;
    color: var(--wizard-ink);
    font-size: 1rem;
    line-height: 1.25;
  }

  .pg-alt-description-offer p,
  .pg-alt-description-heading p {
    margin: 5px 0 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .pg-alt-description-offer .pg-secondary-action {
    flex: 0 0 auto;
    margin-top: 0;
  }

  .pg-alt-description-panel {
    display: grid;
    gap: 14px;
    animation: pgSoftReveal 240ms ease both;
  }

  .pg-alt-description-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .pg-alt-description-heading button {
    flex: 0 0 auto;
    border: 1px solid rgba(200, 203, 210, 0.9);
    border-radius: 999px;
    background: #fbfcfd;
    color: var(--wizard-ink);
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .pg-alt-description-input {
    min-height: 160px;
  }

  .pg-input-shell:focus-within,
  .pg-large-field:focus-visible,
  .pg-picker-popover input:focus,
  .pg-search-field:focus,
  .pg-social-row:focus-within {
    border-color: var(--wizard-purple);
    box-shadow: 0 0 0 4px rgba(111, 60, 195, 0.12);
  }

  .pg-secondary-action {
    margin-top: 18px;
    border: 1.5px solid var(--wizard-border);
    border-radius: 999px;
    background: #ffffff;
    color: var(--wizard-ink);
    min-height: 48px;
    padding: 0 20px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .pg-profile-flow {
    display: grid;
    gap: 18px;
  }

  .pg-logo-discovery {
    min-height: clamp(360px, 58svh, 560px);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 18px;
    border: 1px solid rgba(200, 203, 210, 0.8);
    border-radius: 28px;
    background:
      radial-gradient(circle at 50% 18%, rgba(111, 60, 195, 0.12), transparent 34%),
      linear-gradient(135deg, rgba(111, 60, 195, 0.075), rgba(20, 149, 143, 0.055)),
      #ffffff;
    padding: clamp(26px, 5vw, 54px);
    text-align: center;
    box-shadow: 0 24px 58px rgba(32, 33, 39, 0.08);
    animation: pgSoftReveal 240ms ease-out both;
  }

  .pg-logo-discovery[hidden] {
    display: none;
  }

  .pg-logo-discovery-image {
    width: clamp(178px, 30svh, 260px);
    height: clamp(178px, 30svh, 260px);
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.46)),
      var(--wizard-purple-soft);
    box-shadow:
      0 26px 64px rgba(111, 60, 195, 0.18),
      0 0 0 10px rgba(255, 255, 255, 0.92),
      0 0 0 12px rgba(111, 60, 195, 0.13);
    overflow: hidden;
  }

  .pg-logo-discovery-image::before {
    content: '';
    width: 40px;
    height: 40px;
    border: 3px solid rgba(111, 60, 195, 0.16);
    border-top-color: var(--wizard-purple);
    border-radius: 999px;
    animation: pgSpin 850ms linear infinite;
  }

  .pg-logo-discovery.is-found .pg-logo-discovery-image::before {
    display: none;
  }

  .pg-logo-discovery-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    padding: 0;
    box-sizing: border-box;
    animation: pgImageHeroIn 440ms cubic-bezier(0.2, 0.84, 0.24, 1.24) both;
  }

  .pg-logo-discovery-copy {
    display: grid;
    justify-items: center;
    gap: 8px;
    max-width: 34rem;
  }

  .pg-logo-discovery-copy h3 {
    margin: 0;
    color: var(--wizard-ink);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.12;
  }

  .pg-logo-discovery-copy p {
    margin: 0;
    color: var(--wizard-muted);
    font-size: 1rem;
    line-height: 1.48;
  }

  .pg-tertiary-button {
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--wizard-purple);
    min-height: 42px;
    padding: 0 16px;
    font: inherit;
    font-weight: 820;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    transition:
      color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .pg-tertiary-button:hover,
  .pg-tertiary-button:focus-visible {
    background: var(--wizard-purple-soft);
    color: #4b2596;
    transform: translateY(-1px);
    outline: none;
  }

  .pg-profile-flow.is-url-path .pg-profile-row-main {
    animation: pgSoftReveal 220ms ease both;
  }

  .pg-profile-row {
    display: grid;
    grid-template-columns: minmax(170px, 220px) minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    border: 1px solid rgba(200, 203, 210, 0.8);
    border-radius: 24px;
    background: #ffffff;
    padding: 20px;
    box-shadow: 0 18px 38px rgba(32, 33, 39, 0.06);
  }

  .pg-profile-flow.has-selected-image .pg-profile-image-row {
    min-height: clamp(340px, 54svh, 500px);
    grid-template-columns: 1fr;
    justify-items: center;
    overflow: hidden;
    text-align: center;
    background:
      repeating-linear-gradient(135deg, rgba(111, 60, 195, 0.04) 0 1px, transparent 1px 18px),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--wizard-suggested-color, #6f3cc3) 12%, transparent),
        rgba(111, 60, 195, 0.065)
      ),
      #ffffff;
  }

  .pg-profile-flow.has-selected-image .pg-profile-image-row > .pg-profile-row-copy,
  .pg-profile-flow.has-selected-image .pg-profile-image-row > .pg-profile-row-main {
    display: none;
  }

  .pg-profile-row-copy {
    display: grid;
    gap: 8px;
  }

  .pg-profile-row-copy > span {
    display: inline-grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 14px;
    background: var(--wizard-purple-soft);
    color: var(--wizard-purple);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .pg-profile-row-copy h3 {
    margin: 0;
    color: var(--wizard-ink);
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .pg-profile-row-copy p {
    margin: 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.42;
  }

  .pg-profile-row-main {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .pg-profile-preview {
    position: relative;
    justify-self: end;
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .pg-preview-image {
    --wizard-preview-color: #6f3cc3;
    width: 132px;
    height: 132px;
    display: grid;
    place-items: center;
    border-radius: 34px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.42)),
      var(--wizard-preview-color);
    color: #ffffff;
    font-size: 2rem;
    font-weight: 800;
    position: relative;
    z-index: 1;
    box-shadow: 0 16px 34px rgba(111, 60, 195, 0.18);
    transition:
      width 280ms ease,
      height 280ms ease,
      border-radius 280ms ease,
      box-shadow 280ms ease,
      transform 280ms ease;
  }

  .pg-profile-flow.has-selected-image .pg-profile-preview {
    --wizard-selected-image-size: clamp(174px, 30svh, 252px);
    justify-self: center;
    place-items: center;
    width: min(100%, 420px);
  }

  .pg-profile-flow.has-selected-image .pg-profile-preview::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: calc(var(--wizard-selected-image-size) / 2);
    left: 50%;
    width: calc(var(--wizard-selected-image-size) * 1.62);
    height: calc(var(--wizard-selected-image-size) * 1.62);
    border-radius: 999px;
    background:
      radial-gradient(
        circle,
        color-mix(in srgb, var(--wizard-suggested-color, #6f3cc3) 20%, transparent) 0 44%,
        transparent 45%
      ),
      repeating-conic-gradient(
        from -12deg,
        color-mix(in srgb, var(--wizard-suggested-color, #6f3cc3) 52%, transparent) 0 7deg,
        transparent 7deg 18deg,
        rgba(111, 60, 195, 0.28) 18deg 23deg,
        transparent 23deg 36deg
      );
    opacity: 0.42;
    transform: translate(-50%, -50%) scale(0.88);
    animation: pgImageBurst 1900ms ease-in-out infinite;
    -webkit-mask-image: radial-gradient(circle, transparent 0 55%, #000 56% 70%, transparent 71%);
    mask-image: radial-gradient(circle, transparent 0 55%, #000 56% 70%, transparent 71%);
  }

  .pg-profile-flow.has-selected-image .pg-preview-image {
    width: var(--wizard-selected-image-size);
    height: var(--wizard-selected-image-size);
    border-radius: 999px;
    box-shadow:
      0 24px 60px rgba(111, 60, 195, 0.24),
      0 0 0 10px rgba(255, 255, 255, 0.92),
      0 0 0 12px rgba(111, 60, 195, 0.16);
    animation: pgImageHeroIn 440ms cubic-bezier(0.2, 0.84, 0.24, 1.24) both;
  }

  .pg-preview-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .pg-preview-image.is-loading::after {
    content: '';
    position: absolute;
    width: 34px;
    height: 34px;
    border: 3px solid rgba(255, 255, 255, 0.48);
    border-top-color: #ffffff;
    border-radius: 999px;
    animation: pgSpin 850ms linear infinite;
  }

  .pg-image-reset-button {
    position: absolute;
    z-index: 3;
    top: -4px;
    right: 52px;
    width: 38px;
    height: 38px;
    display: inline-grid;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, 0.96);
    border-radius: 999px;
    background: #e11d48;
    color: #ffffff;
    font: inherit;
    font-size: 0.94rem;
    font-weight: 860;
    box-shadow: 0 14px 26px rgba(225, 29, 72, 0.28);
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .pg-image-reset-button:hover,
  .pg-image-reset-button:focus-visible {
    transform: scale(1.08) rotate(5deg);
    background: #be123c;
    box-shadow: 0 18px 34px rgba(225, 29, 72, 0.34);
  }

  .pg-image-selected-copy {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 8px;
    max-width: 360px;
    animation: pgImagePraiseIn 420ms ease 120ms both;
  }

  .pg-image-selected-copy strong {
    width: fit-content;
    border: 1px solid rgba(111, 60, 195, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--wizard-purple);
    padding: 8px 16px;
    font-size: 1.15rem;
    line-height: 1.2;
    font-weight: 860;
    box-shadow: 0 14px 28px rgba(111, 60, 195, 0.1);
  }

  .pg-image-selected-copy span {
    color: var(--wizard-muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .pg-image-status {
    margin: 2px 0 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.4;
