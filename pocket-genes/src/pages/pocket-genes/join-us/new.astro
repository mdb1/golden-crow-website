const copy = pageCopy[locale];
const wizardClientCopy = {
  step: copy.step,
  of: copy.of,
  continue: copy.continue,
  skip: copy.skip,
  finish: copy.finish,
  sending: copy.sending,
  back: copy.back,
  selectedCountries: copy.selectedCountries,
  selectedCategories: copy.selectedCategories,
  countryPlaceholder: copy.countryPlaceholder,
  categorySearch: copy.categorySearch,
  countryEmpty: copy.countryEmpty,
  required: copy.required,
  urlError: copy.urlError,
  imageUrlError: copy.imageUrlError,
  emailError: copy.emailError,
  submitError: copy.submitError,
  organizationNameLabel: copy.nameLabelOrganization,
  individualNameLabel: copy.nameLabelIndividual,
  organizationNamePlaceholder: copy.namePlaceholderOrganization,
  individualNamePlaceholder: copy.namePlaceholderIndividual,
  imagePreviewAlt: copy.imagePreviewAlt,
  descriptionMinHint: copy.descriptionMinHint,
  descriptionReady: copy.descriptionReady,
  descriptionCountLabel: copy.descriptionCountLabel,
  descriptionRemainingLabel: copy.descriptionRemainingLabel,
  descriptionMinError: copy.descriptionMinError,
  imageLoading: copy.imageLoading,
  imageLoaded: copy.imageLoaded,
  imageLoadError: copy.imageLoadError,
  colorAutoExplanation: copy.colorAutoExplanation,
  colorCustomExplanation: copy.colorCustomExplanation,
  socialUrlLabel: copy.socialUrlLabel,
  socialUrlPlaceholder: copy.socialUrlPlaceholder,
  socialNoLinks: copy.socialNoLinks,
  socialAllAdded: copy.socialAllAdded,
  socialSelectedLabel: copy.socialSelectedLabel,
  socialSelectedSingleLabel: copy.socialSelectedSingleLabel,
  socialSelectedEmptyLabel: copy.socialSelectedEmptyLabel,
  socialRemoveLabel: copy.socialRemoveLabel,
  socialLinkError: copy.socialLinkError,
  socialEmptySearch: copy.socialEmptySearch,
