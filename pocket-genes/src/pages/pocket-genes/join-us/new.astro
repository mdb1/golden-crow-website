  }

  .pg-country-list button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    border-radius: 12px;
    margin: 4px 0;
    padding: 10px 12px;
    text-align: left;
    font: inherit;
  }

  .pg-picker-empty {
    margin: 12px 4px 4px;
    color: var(--wizard-muted);
  }

  .pg-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .pg-chip-row > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    border-radius: 999px;
    background: #eef8f7;
    color: #0f6f6a;
    padding: 8px 14px;
    font-weight: 650;
  }

  .pg-country-flag,
  .pg-country-summary-flag,
  .pg-chip-flag {
    width: 24px;
    flex: 0 0 24px;
    display: inline-grid;
    place-items: center;
    font-size: 1.05rem;
    line-height: 1;
  }

  .pg-chip-row .pg-chip-flag {
    min-height: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    padding: 0;
    font-weight: inherit;
  }

  .pg-large-field strong span {
    color: inherit;
    line-height: inherit;
    font-weight: inherit;
  }

  .pg-large-field strong span:not(.pg-country-summary-flag) {
    font-size: inherit;
  }

  .pg-search-field {
    max-width: 520px;
    margin-bottom: 18px;
  }

  .pg-category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    max-height: min(45vh, 420px);
    overflow: auto;
    padding: 2px 2px 8px;
  }

  .pg-category-list button {
    min-height: 54px;
    border-radius: 999px;
    padding: 13px 28px;
    font: inherit;
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 650;
  }

  .pg-selected-note,
  .pg-skip-hint {
    margin: 18px 0 0;
    color: var(--wizard-muted);
    font-size: 0.98rem;
  }

  .pg-input-shell {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pg-input-shell input,
  .pg-input-shell textarea,
  .pg-social-url-field input {
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--wizard-ink);
    font: inherit;
    font-size: 1.16rem;
    line-height: 1.35;
  }

  .pg-textarea-shell {
    min-height: 210px;
  }

  .pg-input-shell textarea {
    resize: vertical;
    min-height: 144px;
  }

  .pg-description-composer {
    display: grid;
    gap: 18px;
    max-width: 760px;
  }

  .pg-description-card {
    position: relative;
    isolation: isolate;
    min-height: 278px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(111, 60, 195, 0.055), rgba(20, 149, 143, 0.035)),
      #ffffff;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .pg-description-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 24px -70px auto;
    width: 160px;
    height: 160px;
    border-radius: 999px;
    background: rgba(111, 60, 195, 0.1);
    filter: blur(18px);
    opacity: 0;
    transform: scale(0.75);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .pg-description-card.is-started {
    border-color: rgba(111, 60, 195, 0.42);
  }

  .pg-description-card.is-writing {
    transform: translateY(-1px);
    box-shadow: 0 22px 45px rgba(32, 33, 39, 0.12);
  }

  .pg-description-card.is-writing::before,
  .pg-description-card.is-complete::before {
    opacity: 1;
    transform: scale(1);
  }

  .pg-description-card.is-complete {
    border-color: rgba(20, 149, 143, 0.65);
    box-shadow: 0 18px 38px rgba(20, 149, 143, 0.12);
  }

  .pg-description-card textarea {
    position: relative;
    z-index: 1;
    min-height: 156px;
  }

  .pg-description-meter {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: #eceef4;
  }

  .pg-description-meter span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--wizard-purple), #14958f);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .pg-description-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .pg-description-footer small {
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.42;
  }

  .pg-description-footer strong {
    flex: 0 0 auto;
    border: 1px solid rgba(111, 60, 195, 0.2);
    border-radius: 999px;
    color: var(--wizard-purple);
    padding: 7px 12px;
    font-size: 0.84rem;
    line-height: 1;
    white-space: nowrap;
  }

  .pg-description-card.is-complete .pg-description-footer strong {
    border-color: rgba(20, 149, 143, 0.25);
    background: #eef8f7;
    color: #0f6f6a;
  }

  .pg-writing-pulses {
    position: absolute;
    right: 22px;
    bottom: 72px;
    display: inline-flex;
    gap: 5px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .pg-writing-pulses span {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--wizard-purple);
  }

  .pg-description-card.is-writing .pg-writing-pulses {
    opacity: 1;
  }

  .pg-description-card.is-writing .pg-writing-pulses span {
    animation: pgWritingPulse 720ms ease-in-out infinite;
  }

  .pg-description-card.is-writing .pg-writing-pulses span:nth-child(2) {
    animation-delay: 90ms;
  }

  .pg-description-card.is-writing .pg-writing-pulses span:nth-child(3) {
    animation-delay: 180ms;
  }

  .pg-description-prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pg-description-prompts span {
    border: 1px solid rgba(111, 60, 195, 0.14);
    border-radius: 999px;
    background: rgba(111, 60, 195, 0.06);
    color: #553096;
    padding: 8px 13px;
    font-size: 0.88rem;
    font-weight: 680;
  }

  .pg-alt-description-offer,
  .pg-alt-description-panel {
    border: 1px solid rgba(200, 203, 210, 0.9);
    border-radius: 20px;
    background: #ffffff;
    padding: 18px;
  }

  .pg-alt-description-offer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .pg-alt-description-offer strong,
  .pg-alt-description-heading strong {
    display: block;
    color: var(--wizard-ink);
    font-size: 1rem;
    line-height: 1.25;
  }

  .pg-alt-description-offer p,
  .pg-alt-description-heading p {
    margin: 5px 0 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .pg-alt-description-offer .pg-secondary-action {
    flex: 0 0 auto;
    margin-top: 0;
  }

  .pg-alt-description-panel {
    display: grid;
    gap: 14px;
    animation: pgSoftReveal 240ms ease both;
  }

  .pg-alt-description-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .pg-alt-description-heading button {
    flex: 0 0 auto;
    border: 1px solid rgba(200, 203, 210, 0.9);
    border-radius: 999px;
    background: #fbfcfd;
    color: var(--wizard-ink);
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .pg-alt-description-input {
    min-height: 160px;
  }

  .pg-input-shell:focus-within,
  .pg-large-field:focus-visible,
  .pg-picker-popover input:focus,
  .pg-search-field:focus,
  .pg-social-url-field:focus-within,
  .pg-social-row:focus-within {
    border-color: var(--wizard-purple);
    box-shadow: 0 0 0 4px rgba(111, 60, 195, 0.12);
  }

  .pg-secondary-action {
    margin-top: 18px;
    border: 1.5px solid var(--wizard-border);
    border-radius: 999px;
    background: #ffffff;
    color: var(--wizard-ink);
    min-height: 48px;
    padding: 0 20px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .pg-profile-flow {
    display: grid;
    gap: 18px;
  }

  .pg-profile-row {
    display: grid;
    grid-template-columns: minmax(170px, 220px) minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    border: 1px solid rgba(200, 203, 210, 0.8);
    border-radius: 24px;
    background: #ffffff;
    padding: 20px;
    box-shadow: 0 18px 38px rgba(32, 33, 39, 0.06);
  }

  .pg-profile-row-copy {
    display: grid;
    gap: 8px;
  }

  .pg-profile-row-copy > span {
    display: inline-grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 14px;
    background: var(--wizard-purple-soft);
    color: var(--wizard-purple);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .pg-profile-row-copy h3 {
    margin: 0;
    color: var(--wizard-ink);
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .pg-profile-row-copy p {
    margin: 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    line-height: 1.42;
  }

  .pg-profile-row-main {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .pg-profile-preview {
    justify-self: end;
    display: grid;
    justify-items: center;
  }

  .pg-preview-image {
    --wizard-preview-color: #6f3cc3;
    width: 132px;
    height: 132px;
    display: grid;
    place-items: center;
    border-radius: 34px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.42)),
      var(--wizard-preview-color);
    color: #ffffff;
    font-size: 2rem;
    font-weight: 800;
    position: relative;
    box-shadow: 0 16px 34px rgba(111, 60, 195, 0.18);
  }

  .pg-preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pg-preview-image.is-loading::after {
    content: '';
    position: absolute;
    width: 34px;
    height: 34px;
    border: 3px solid rgba(255, 255, 255, 0.48);
    border-top-color: #ffffff;
    border-radius: 999px;
    animation: pgSpin 850ms linear infinite;
  }

  .pg-image-status {
    margin: 2px 0 0;
    color: var(--wizard-muted);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .pg-image-status[data-status='loading'] {
    color: var(--wizard-purple);
  }

  .pg-image-status[data-status='loaded'] {
    color: #0f6f6a;
  }

  .pg-image-status[data-status='failed'],
  .pg-image-status[data-status='invalid'] {
    color: #9f1239;
  }

  .pg-image-status[data-status='loading']::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 999px;
    background: currentColor;
    animation: pgStatusPulse 900ms ease-in-out infinite;
  }

  .pg-color-row {
    border-color: rgba(111, 60, 195, 0.2);
    background:
      linear-gradient(135deg, rgba(111, 60, 195, 0.055), rgba(20, 149, 143, 0.04)),
