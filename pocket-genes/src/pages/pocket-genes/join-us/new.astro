  .pg-social-option-grid strong,
  .pg-social-row-identity strong {
    display: block;
    overflow: hidden;
    color: var(--wizard-ink);
    font-size: 0.94rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pg-social-option-grid small,
  .pg-social-row-identity small {
    display: block;
    overflow: hidden;
    margin-top: 4px;
    color: var(--wizard-muted);
    font-size: 0.78rem;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pg-social-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: inline-grid;
    place-items: center;
