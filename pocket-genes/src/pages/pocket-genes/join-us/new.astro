    function updateSocialUi() {
      const selected = selectedSocialKeys();
      const query = socialSearch?.value.trim().toLowerCase() || '';
      let availableVisibleCount = 0;
      let filledCount = 0;

      wizardRoot.querySelectorAll('[data-social-option]').forEach((button) => {
        const value = button.getAttribute('data-social-option');
        const label = button.getAttribute('data-label') || '';
        const placeholder = button.getAttribute('data-placeholder') || '';
        const selectedAlready = selected.has(value);
        const matches = !query || `${label} ${placeholder}`.toLowerCase().includes(query);
        const visible = !selectedAlready && matches;

        button.hidden = !visible;
        button.classList.toggle('is-selected', selectedAlready);
        button.setAttribute('aria-pressed', selectedAlready ? 'true' : 'false');
        if (visible) availableVisibleCount += 1;
      });

      wizardRoot.querySelectorAll('[data-social-row]').forEach((row) => {
        const input = row.querySelector('[data-social-url]');
        const error = row.querySelector('[data-social-url-error]');
        const platform = row.getAttribute('data-social-row') || '';
        const hasValue = Boolean(input?.value.trim());
        const valid = !hasValue || validSocialValue(platform, input.value);

        row.classList.toggle('has-value', hasValue);
        row.classList.toggle('has-error', !valid);
        input?.setAttribute('aria-invalid', valid ? 'false' : 'true');
        if (error) {
          error.hidden = valid;
        }
        if (hasValue && valid) filledCount += 1;
      });

      if (socialEmptySearch) {
        socialEmptySearch.hidden = availableVisibleCount > 0;
        socialEmptySearch.textContent = selected.size === socialOptions.length
          ? copy.socialAllAdded
          : copy.socialEmptySearch;
      }

      if (socialEmptyState) {
        socialEmptyState.hidden = selected.size > 0;
      }

      if (socialCount) {
        if (filledCount === 0) {
          socialCount.textContent = selected.size > 0
            ? copy.socialSelectedEmptyLabel
            : copy.socialNoLinks;
        } else {
          socialCount.textContent = `${filledCount} ${
            filledCount === 1 ? copy.socialSelectedSingleLabel : copy.socialSelectedLabel
          }`;
        }
      }

      if (socialPickerOpen) {
        const allSelected = selected.size === socialOptions.length;
        socialPickerOpen.disabled = allSelected;
        if (socialPickerLabel) {
          socialPickerLabel.textContent = allSelected ? copy.socialAllAdded : copy.socialOpenPicker;
        }
      }

      socialWorkbench?.classList.toggle('has-social-links', selected.size > 0);
      socialOptionGrid?.classList.toggle('is-empty', availableVisibleCount === 0);
    }

    function upsertSocialRow(option, value, existingRow = null) {
      if (!socialList || !option) return;

      let row = existingRow;
      if (!row && selectedSocialKeys().has(option.value)) return;

      if (!row) {
        row = document.createElement('div');
        row.className = 'pg-social-row';
        row.setAttribute('data-social-row', option.value);

        const icon = document.createElement('span');
        icon.className = 'pg-social-cell-icon';
        icon.setAttribute('aria-hidden', 'true');
        setSocialIcon(icon, option);

        const valueButton = document.createElement('button');
        valueButton.type = 'button';
        valueButton.className = 'pg-social-cell-main';
        valueButton.setAttribute('aria-label', `${copy.socialEditLabel} ${option.label}`);

        const copyWrap = document.createElement('span');
        copyWrap.className = 'pg-social-cell-copy';
        const name = document.createElement('strong');
        name.textContent = option.label;
        const valueText = document.createElement('span');
        valueText.className = 'pg-social-cell-url';
        valueText.setAttribute('data-social-value-text', '');
        copyWrap.append(name, valueText);

        const editIcon = document.createElement('span');
        editIcon.className = 'pg-social-cell-edit';
        editIcon.append(createPencilIcon());
        valueButton.append(copyWrap, editIcon);
        valueButton.addEventListener('click', () => beginSocialLinkFlow(option, { row }));

        const input = document.createElement('input');
        input.type = 'hidden';
        input.maxLength = 1000;
        input.setAttribute('data-social-url', '');
        input.setAttribute('aria-label', option.label);

        const inputError = document.createElement('small');
        inputError.className = 'pg-social-url-error';
        inputError.setAttribute('data-social-url-error', '');
        inputError.textContent = copy.socialLinkError;
        inputError.hidden = true;

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'pg-social-cell-remove';
        remove.setAttribute('aria-label', `${copy.socialRemoveLabel} ${option.label}`);
        const removeIcon = document.createElement('span');
        removeIcon.setAttribute('aria-hidden', 'true');
        removeIcon.textContent = 'x';
        remove.append(removeIcon);
        remove.addEventListener('click', () => {
          row.remove();
          updateSocialUi();
          renderStep();
        });

        row.append(icon, valueButton, input, inputError, remove);
        socialList.append(row);
      }

      const input = row.querySelector('[data-social-url]');
      const valueText = row.querySelector('[data-social-value-text]');
      if (input) {
        input.value = value;
      }
      if (valueText) {
        valueText.textContent = displaySocialValue(value);
      }

      updateSocialUi();
      renderStep();
    }

    function submitSocialDraft() {
      const option = state.socialDraftOption;
      const value = socialDraftInput?.value.trim() || '';

      if (!option || !updateSocialDraftUi({ showError: true })) return;

      const normalizedValue = normalizedSocialDraftValue(option, value);
      upsertSocialRow(option, normalizedValue, state.socialDraftRow);
      showSocialCollected(option);
      window.clearTimeout(socialCollectTimer);
      socialCollectTimer = window.setTimeout(() => {
        setSocialPickerOpen(false);
      }, 980);
    }

    function collectSocialLinks() {
      const social = {};
      wizardRoot.querySelectorAll('[data-social-row]').forEach((row) => {
        const platform = row.getAttribute('data-social-row');
        const url = row.querySelector('[data-social-url]')?.value.trim();
        if (platform && url) {
          social[platform] = platform === 'email' ? url : optionalUrlValue({ value: url });
        }
      });
      return Object.keys(social).length ? social : undefined;
    }

    function optionalValue(input) {
      const value = input?.value.trim();
      return value || undefined;
    }

    function buildPayload() {
      const payload = {
        kind: state.kind,
        locale,
        name: nameInput.value.trim(),
        contactEmail: contactEmail.value.trim().toLowerCase(),
        countryCode: state.countries.join(','),
        colorHex: state.color,
        websiteUrl: optionalUrlValue(websiteUrl),
        imageUrl: state.uploadedImageDataUrl ? undefined : optionalUrlValue(imageUrl, { httpsOnly: true }),
        imageUploadDataUrl: state.uploadedImageDataUrl || undefined,
        imageUploadName: state.uploadedImageName || undefined,
        imageUploadMimeType: state.uploadedImageMimeType || undefined,
        social: collectSocialLinks(),
        startedAt: state.startedAt,
        website: form?.elements.website?.value || undefined,
        source: {
          pageUrl: window.location.href,
          referrer: document.referrer || undefined,
        },
      };

      if (locale === 'en') {
        payload.descriptionEn = descriptionPrimary.value.trim();
        payload.description = optionalValue(descriptionAlternative);
      } else {
        payload.description = descriptionPrimary.value.trim();
        payload.descriptionEn = optionalValue(descriptionAlternative);
      }

      if (state.kind === 'organization') {
        payload.organizationType = state.categories.organization.join(',');
        payload.isGeneticReportProvider = state.geneticReportProvider === true;
        payload.geneticReportCategory =
          state.geneticReportProvider === true
            ? state.geneticReportCategory || null
            : null;
      } else {
        payload.individualType = state.categories.individual.join(',');
      }

      return payload;
    }

    async function submitWizard() {
      state.submitting = true;
      startSubmitLoading();
      renderStep();
      setError('');
      let didSubmit = false;

      try {
        const response = await fetch(`${sdkUrl.replace(/\/$/, '')}/discover/publisher-requests`, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify(buildPayload()),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || copy.submitError);
        }

        didSubmit = true;
        stopSubmitLoading({ transitionToSuccess: true });
        if (success) {
          success.hidden = false;
          requestAnimationFrame(() => {
            success.classList.add('is-visible');
          });
        }
      } catch (error) {
        stopSubmitLoading();
        setError(error instanceof Error ? error.message : copy.submitError);
      } finally {
        state.submitting = false;
        renderStep();
        if (!didSubmit) {
          syncSubmitLoadingUi();
        }
      }
    }

    wizardRoot.querySelectorAll('[data-kind-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.kind = button.getAttribute('data-kind-option') || 'organization';
        state.currentStep = Math.min(state.currentStep, visibleSteps().length - 1);
        wizardRoot.querySelectorAll('[data-kind-option]').forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-selected', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        setError('');
        renderStep();
      });
    });

    wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleCountry(button.getAttribute('data-country-option'));
      });
    });

    wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleCategory(button.getAttribute('data-category-option'));
      });
    });

    wizardRoot.querySelectorAll('[data-provider-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.geneticReportProvider = button.getAttribute('data-provider-option') === 'true';
        setError('');
        renderStep();
      });
    });

    wizardRoot.querySelectorAll('[data-report-category-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleReportCategory(button.getAttribute('data-report-category-option'));
      });
    });

    countryToggle?.addEventListener('click', () => {
      if (!countryPopover) return;
      setCountryPopoverOpen(countryPopover.hidden);
    });

    countryCloseButtons.forEach((button) => {
      button.addEventListener('click', () => setCountryPopoverOpen(false));
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      if (countryPopover && !countryPopover.hidden && target === countryPopover) {
        setCountryPopoverOpen(false);
      }

      if (socialPickerPanel && !socialPickerPanel.hidden && target === socialPickerPanel) {
        setSocialPickerOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setCountryPopoverOpen(false);
      setSocialPickerOpen(false);
    });

    countrySearch?.addEventListener('input', () => filterCountryOptions(countrySearch.value));
    categorySearch?.addEventListener('input', () => filterCategoryOptions(categorySearch.value));
    socialSearch?.addEventListener('input', updateSocialUi);
    socialPickerOpen?.addEventListener('click', () => setSocialPickerOpen(true));
    socialPickerCloseButtons.forEach((button) => {
      button.addEventListener('click', () => setSocialPickerOpen(false));
    });
    socialDraftInput?.addEventListener('input', () => updateSocialDraftUi());
    socialDraftInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        submitSocialDraft();
      }
    });
    socialDraftBack?.addEventListener('click', () => {
      resetSocialDraft();
      setSocialPickerView('choose');
      updateSocialUi();
      requestAnimationFrame(() => socialSearch?.focus());
    });
    socialDraftSave?.addEventListener('click', submitSocialDraft);
    wizardRoot.querySelectorAll('[data-social-option]').forEach((button) => {
      button.addEventListener('click', () => {
        const option = socialOptionsByValue.get(button.getAttribute('data-social-option'));
        beginSocialLinkFlow(option);
      });
    });
    altDescriptionToggle?.addEventListener('click', () => {
      if (!altDescriptionField) return;
      altDescriptionField.hidden = false;
      if (altDescriptionOffer) {
        altDescriptionOffer.hidden = true;
      }
      altDescriptionToggle.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => descriptionAlternative?.focus());
    });
    altDescriptionRemove?.addEventListener('click', () => {
      if (!altDescriptionField) return;
      altDescriptionField.hidden = true;
      if (altDescriptionOffer) {
        altDescriptionOffer.hidden = false;
      }
      altDescriptionToggle?.setAttribute('aria-expanded', 'false');
      if (descriptionAlternative) {
        descriptionAlternative.value = '';
      }
      renderStep();
    });
    colorInput?.addEventListener('input', () => {
      state.colorCustomized = true;
      updateColor(colorInput.value);
    });
    colorPresetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const color = button.getAttribute('data-color-preset') || '#6F3CC3';
        state.colorCustomized = true;
        updateColor(color);
      });
    });
    useSuggestedColor?.addEventListener('click', () => {
      state.colorCustomized = false;
      updateColor(state.suggestedColor);
    });
    imageUrl?.addEventListener('input', () => {
      if (imageUrl.value.trim() && (state.uploadedImageDataUrl || state.imageCompressing)) {
        clearUploadedImage({ rerender: false });
      }
      updateImagePreview();
      renderStep();
    });
    imageUrl?.addEventListener('blur', () => {
      normalizeUrlInput(imageUrl, { httpsOnly: true });
      updateImagePreview();
      renderStep();
    });
    imageUpload?.addEventListener('change', () => {
      const file = imageUpload.files?.[0];
      if (file) {
        readUploadedImage(file);
      }
    });
    imageUploadCard?.addEventListener('dragenter', handleImageUploadDragEnter);
    imageUploadCard?.addEventListener('dragover', handleImageUploadDragOver);
    imageUploadCard?.addEventListener('dragleave', handleImageUploadDragLeave);
    imageUploadCard?.addEventListener('drop', handleImageUploadDrop);
    imageUploadClear?.addEventListener('click', () => clearUploadedImage());
    imageReset?.addEventListener('click', () => resetImageSelection());
    logoDiscoveryDiscard?.addEventListener('click', discardScrapedLogo);
    nameInput?.addEventListener('input', () => {
      if (!state.colorCustomized && !imageUrl?.value.trim() && !state.uploadedImageDataUrl) {
        state.suggestedColor = deterministicColor(nameInput.value);
        updateColor(state.suggestedColor);
      }
      updateImagePreview();
      renderStep();
    });
    descriptionPrimary?.addEventListener('input', () => {
      pulseDescriptionWriting();
      renderStep();
    });
    [descriptionAlternative, contactEmail].forEach((input) => {
      input?.addEventListener('input', () => renderStep());
    });
    websiteUrl?.addEventListener('input', () => {
      const hadScrapedUpload =
        state.scrapedLogoDataUrl && state.uploadedImageDataUrl === state.scrapedLogoDataUrl;
      resetScrapedLogo({ keepDismissedUrl: false });
      if (hadScrapedUpload) {
        clearUploadedImage({ rerender: false });
      }
      renderStep();
    });
    websiteUrl?.addEventListener('blur', () => {
      normalizeUrlInput(websiteUrl);
      renderStep();
    });

    nextButton?.addEventListener('click', () => {
      if (!validateCurrentStep()) return;

      const steps = visibleSteps();
      if (state.currentStep === steps.length - 1) {
        void submitWizard();
        return;
      }

      const leavingStep = activeStepKey();
      const nextStep = steps[state.currentStep + 1] || '';
      const logoDiscoveryRequest =
        leavingStep === 'website' && nextStep === 'image'
          ? prepareLogoDiscovery()
          : null;

      state.currentStep += 1;
      state.hasAdvanced = true;
      setError('');
      renderStep();
      void runLogoDiscovery(logoDiscoveryRequest);
    });

    backButton?.addEventListener('click', () => {
      if (activeStepKey() === 'image' && state.scrapedLogoStatus === 'loading') {
        resetScrapedLogo();
      }
      state.currentStep = Math.max(0, state.currentStep - 1);
      setError('');
      renderStep();
    });

    openBooking?.addEventListener('click', () => {
      if (!successBooking) return;
      successBooking.hidden = false;
      successBooking.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    renderStep();
    updateImagePreview();
  }
</script>

