    function visibleSteps() {
      const steps = ['type', 'country', 'category', 'name', 'description', 'email', 'website', 'image', 'social'];

      if (state.kind === 'organization') {
        steps.push('provider');
        if (state.geneticReportProvider === true) {
          steps.push('report');
        }
      }

      return steps;
    }

    function activeStepKey() {
      return visibleSteps()[state.currentStep] || 'type';
    }

    const contentScrollSteps = new Set(['category', 'description', 'image', 'social', 'report']);
    const modalScrollSteps = new Set([]);

    function scrollModeForStep(step) {
      if (contentScrollSteps.has(step)) return 'content';
      if (modalScrollSteps.has(step)) return 'modal';
      return 'none';
    }

    function setError(message) {
      if (!errorBox) return;
      errorBox.textContent = message || '';
      errorBox.hidden = !message;
    }

    function urlWithProtocol(value) {
      const trimmed = value.trim();
      if (!trimmed) return '';
      return /^[a-z][a-z\d+.-]*:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
    }

    function normalizedUrl(value, { httpsOnly = false } = {}) {
      const candidate = urlWithProtocol(value);
      if (!candidate) return '';

      try {
        const parsed = new URL(candidate);
        const allowedProtocol = httpsOnly
          ? parsed.protocol === 'https:'
          : parsed.protocol === 'http:' || parsed.protocol === 'https:';
        if (!allowedProtocol || !parsed.hostname) return '';
        return parsed.toString();
      } catch {
        return '';
      }
    }

    function validUrl(value, httpsOnly = false) {
      if (!value.trim()) return true;
      return Boolean(normalizedUrl(value, { httpsOnly }));
    }

    function normalizeUrlInput(input, { httpsOnly = false } = {}) {
      const value = input?.value.trim();
      if (!value) return;

      const normalized = normalizedUrl(value, { httpsOnly });
      if (normalized) {
        input.value = normalized;
      }
    }

    function optionalUrlValue(input, options = {}) {
      const value = input?.value.trim();
      if (!value) return undefined;

      const normalized = normalizedUrl(value, options);
      return normalized || value;
    }

    function currentWebsiteLookupUrl() {
      return optionalUrlValue(websiteUrl) || '';
    }

    function resetScrapedLogo({ keepDismissedUrl = true } = {}) {
      if (!keepDismissedUrl) {
        state.scrapedLogoDismissedUrl = '';
      }
      state.scrapedLogoStatus = 'idle';
      state.scrapedLogoWebsiteUrl = '';
      state.scrapedLogoDataUrl = '';
      state.scrapedLogoName = '';
      state.scrapedLogoMimeType = '';
      state.scrapedLogoLookupToken += 1;
      syncLogoDiscoveryUi();
    }

    function shouldLookupWebsiteLogo(website) {
      return (
        Boolean(website) &&
        state.scrapedLogoDismissedUrl !== website &&
        !state.uploadedImageDataUrl &&
        !imageUrl?.value.trim()
      );
    }

    function prepareLogoDiscovery() {
      const website = currentWebsiteLookupUrl();
      if (!shouldLookupWebsiteLogo(website)) {
        return null;
      }

      state.scrapedLogoLookupToken += 1;
      state.scrapedLogoStatus = 'loading';
      state.scrapedLogoWebsiteUrl = website;
      state.scrapedLogoDataUrl = '';
      state.scrapedLogoName = '';
      state.scrapedLogoMimeType = '';

      return {
        token: state.scrapedLogoLookupToken,
        website,
      };
    }

    function syncLogoDiscoveryUi() {
      const status = state.scrapedLogoStatus;
      const active = status === 'loading' || status === 'found';
      if (logoDiscovery) {
        logoDiscovery.hidden = !active;
        logoDiscovery.classList.toggle('is-loading', status === 'loading');
        logoDiscovery.classList.toggle('is-found', status === 'found');
      }
      if (profileFlow) {
        profileFlow.hidden = active;
      }
      if (imageStepHeading) {
        imageStepHeading.hidden = active;
      }
      if (logoDiscoveryImageWrap) {
        logoDiscoveryImageWrap.setAttribute('aria-busy', status === 'loading' ? 'true' : 'false');
      }
      if (logoDiscoveryImage) {
        logoDiscoveryImage.hidden = status !== 'found' || !state.scrapedLogoDataUrl;
        if (status === 'found' && state.scrapedLogoDataUrl) {
          logoDiscoveryImage.src = state.scrapedLogoDataUrl;
        } else {
          logoDiscoveryImage.removeAttribute('src');
        }
      }
      if (logoDiscoveryTitle) {
        logoDiscoveryTitle.textContent =
          status === 'found' ? copy.logoFoundTitle : copy.logoLookupTitle;
      }
      if (logoDiscoveryBody) {
        logoDiscoveryBody.textContent =
          status === 'found' ? copy.logoFoundBody : copy.logoLookupBody;
      }
      if (logoDiscoveryDiscard) {
        logoDiscoveryDiscard.hidden = status !== 'found';
      }
    }

    async function runLogoDiscovery(discovery) {
      if (!discovery) return;

      syncLogoDiscoveryUi();
      try {
        const response = await fetch(`${sdkUrl.replace(/\/$/, '')}/discover/publisher-favicon`, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify({
            websiteUrl: discovery.website,
            startedAt: state.startedAt,
          }),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.imageUploadDataUrl) {
          throw new Error('NO_LOGO');
        }

        if (discovery.token !== state.scrapedLogoLookupToken) return;

        state.scrapedLogoStatus = 'found';
        state.scrapedLogoDataUrl = result.imageUploadDataUrl;
        state.scrapedLogoName = result.imageUploadName || 'favicon';
        state.scrapedLogoMimeType = result.imageUploadMimeType || result.contentType || '';
        state.uploadedImageDataUrl = state.scrapedLogoDataUrl;
        state.uploadedImageName = state.scrapedLogoName;
        state.uploadedImageMimeType = state.scrapedLogoMimeType;
        if (imageUrl) {
          imageUrl.value = '';
        }

        setImageStatus('loaded', copy.imageUploadReady);
        const suggested = await averageImageColor(state.scrapedLogoDataUrl);
        if (discovery.token !== state.scrapedLogoLookupToken) return;
        state.suggestedColor = suggested.toUpperCase();
        if (!state.colorCustomized) {
          updateColor(state.suggestedColor);
        } else {
          updateColorUi();
        }
        syncUploadedImageUi();
        syncLogoDiscoveryUi();
        renderStep();
      } catch {
        if (discovery.token !== state.scrapedLogoLookupToken) return;

        resetScrapedLogo();
        if (!imageUrl?.value.trim() && !state.uploadedImageDataUrl) {
          setImageStatus('empty', '');
        }
        updateImagePreview();
        renderStep();
      }
    }

    function discardScrapedLogo() {
      const dismissedUrl = state.scrapedLogoWebsiteUrl;
      state.scrapedLogoDismissedUrl = dismissedUrl;
      resetScrapedLogo();
      clearUploadedImage({ rerender: false });
      setImageStatus('empty', '');
      updateImagePreview();
      renderStep();
    }

    function currentImageChoiceState() {
      const rawUrl = imageUrl?.value.trim() || '';
      const hasUpload = Boolean(state.uploadedImageDataUrl);
      const hasUrl = Boolean(rawUrl);
      const path = hasUpload ? 'upload' : hasUrl ? 'url' : 'none';
      const hasSelectedImage = hasUpload
        ? state.imageStatus !== 'failed' && state.imageStatus !== 'invalid'
        : hasUrl && state.imageStatus === 'loaded';

      return {
        path,
        hasUrl,
        hasUpload,
        hasSelectedImage,
      };
    }

    function updateImageChoiceUi() {
      const imageChoice = currentImageChoiceState();
      const lockPicker = imageChoice.hasSelectedImage;

      profileFlow?.classList.toggle('is-url-path', imageChoice.path === 'url' && !lockPicker);
      profileFlow?.classList.toggle('is-upload-path', imageChoice.path === 'upload');
      profileFlow?.classList.toggle('has-selected-image', lockPicker);

      if (imageUrlSegment) {
        imageUrlSegment.hidden = imageChoice.path === 'upload' || lockPicker;
      }
      if (imageDivider) {
        imageDivider.hidden = imageChoice.path !== 'none' || lockPicker;
      }
      if (imageUploadCard) {
        imageUploadCard.hidden = imageChoice.path === 'url' || lockPicker;
      }
      if (imageUploadState) {
        imageUploadState.hidden = !imageChoice.hasUpload || lockPicker;
      }
      if (imageReset) {
        imageReset.hidden = !lockPicker;
      }
      if (imageSelectedCopy) {
        imageSelectedCopy.hidden = !lockPicker;
      }
    }

    function clearUploadedImage({ rerender = true, cancelCompression = true } = {}) {
      if (cancelCompression) {
        state.imageCompressionToken += 1;
        state.imageCompressing = false;
      }

      state.uploadedImageReadyMessage = '';
      state.uploadedImageDataUrl = '';
      state.uploadedImageName = '';
      state.uploadedImageMimeType = '';

      if (imageUpload && 'value' in imageUpload) {
        imageUpload.value = '';
      }

      imageUploadCard?.classList.remove('has-upload', 'is-dragging', 'is-compressing');
      if (imageUploadState) {
        imageUploadState.hidden = true;
      }
      if (imageUploadName) {
        imageUploadName.textContent = '';
      }
      updateImageChoiceUi();

      if (rerender) {
        updateImagePreview();
        renderStep();
      }
    }

    function resetImageSelection() {
      clearUploadedImage({ rerender: false });
      if (imageUrl) {
        imageUrl.value = '';
      }

      state.colorCustomized = false;
      state.suggestedColor = deterministicColor(nameInput?.value || 'Pocket Genes');
      updateColor(state.suggestedColor);
      setImageStatus('empty', '');
      setColorRowVisible(false);
      updateImageChoiceUi();
      updateImagePreview();
      renderStep();
    }

    function syncUploadedImageUi() {
      const hasUpload = Boolean(state.uploadedImageDataUrl);
      imageUploadCard?.classList.toggle('has-upload', hasUpload);

      if (imageUploadState) {
        imageUploadState.hidden = !hasUpload;
      }
      if (imageUploadName) {
        imageUploadName.textContent = state.uploadedImageName;
      }
      updateImageChoiceUi();
    }

    function imageCompressionFileName(file, mimeType) {
      const extension = mimeType === 'image/webp' ? 'webp' : 'jpg';
      const rawName = file.name || `profile-image.${extension}`;
      const baseName = rawName.replace(/\.[^.]+$/, '') || 'profile-image';
      return `${baseName}-compressed.${extension}`;
    }

    function loadImageElementFromFile(file) {
      return new Promise((resolve, reject) => {
        const image = new Image();
        const objectUrl = URL.createObjectURL(file);

        image.onload = () => {
          URL.revokeObjectURL(objectUrl);
          resolve(image);
        };
        image.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          reject(new Error('IMAGE_LOAD_FAILED'));
        };
        image.src = objectUrl;
      });
    }

    function imageCompressionDimensions(image) {
      const sourceMax = Math.max(
        image.naturalWidth || image.width || 0,
        image.naturalHeight || image.height || 0,
      );

      if (!sourceMax) return [];

      return Array.from(
        new Set(
          [sourceMax, ...IMAGE_COMPRESSION_DIMENSION_STEPS]
            .map((dimension) => Math.min(sourceMax, dimension))
            .filter((dimension) => Number.isFinite(dimension) && dimension > 0),
        ),
      ).sort((a, b) => b - a);
    }

    function drawCompressedImage(image, maxDimension, mimeType) {
      const sourceWidth = image.naturalWidth || image.width || 0;
      const sourceHeight = image.naturalHeight || image.height || 0;

      if (!sourceWidth || !sourceHeight) {
        throw new Error('IMAGE_DIMENSIONS_UNAVAILABLE');
      }

      const sourceMax = Math.max(sourceWidth, sourceHeight);
      const scale = Math.min(1, maxDimension / sourceMax);
      const targetWidth = Math.max(1, Math.round(sourceWidth * scale));
      const targetHeight = Math.max(1, Math.round(sourceHeight * scale));
      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d');

      if (!context) {
        throw new Error('CANVAS_UNAVAILABLE');
      }

      canvas.width = targetWidth;
      canvas.height = targetHeight;
      context.imageSmoothingEnabled = true;
      context.imageSmoothingQuality = 'high';

      if (mimeType === 'image/jpeg') {
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, targetWidth, targetHeight);
      }

      context.drawImage(image, 0, 0, targetWidth, targetHeight);
      return canvas;
    }

    function canvasToBlob(canvas, mimeType, quality) {
      return new Promise((resolve) => {
        canvas.toBlob(resolve, mimeType, quality);
      });
    }

    async function compressUploadedImageFile(file) {
      const image = await loadImageElementFromFile(file);
      const dimensions = imageCompressionDimensions(image);

      for (const mimeType of IMAGE_COMPRESSION_MIME_TYPES) {
        for (const maxDimension of dimensions) {
          const canvas = drawCompressedImage(image, maxDimension, mimeType);

          for (const quality of IMAGE_COMPRESSION_QUALITY_STEPS) {
            const blob = await canvasToBlob(canvas, mimeType, quality);

            if (!blob || blob.size === 0) continue;

            if (blob.size <= IMAGE_UPLOAD_MAX_BYTES) {
              return new File([blob], imageCompressionFileName(file, mimeType), {
                type: mimeType,
                lastModified: Date.now(),
              });
            }
          }
        }
      }

      throw new Error('IMAGE_COMPRESSION_FAILED');
    }

    function loadAcceptedUploadedImage(
      file,
      { loadingMessage = copy.imageLoading, readyMessage = copy.imageUploadReady } = {},
    ) {
      state.imageCompressionToken += 1;
      state.imageCompressing = false;
      state.uploadedImageReadyMessage = readyMessage;
      imageUploadCard?.classList.remove('is-compressing');

      const reader = new FileReader();
      reader.onload = () => {
        const result = typeof reader.result === 'string' ? reader.result : '';
        if (!result) {
          setImageStatus('failed', copy.imageLoadError);
          renderStep();
          return;
        }

        state.uploadedImageDataUrl = result;
        state.uploadedImageName = file.name;
        state.uploadedImageMimeType = file.type;
        if (imageUrl) {
          imageUrl.value = '';
        }
        setImageStatus('loading', loadingMessage);
        syncUploadedImageUi();
        updateImagePreview();
        renderStep();
      };
      reader.onerror = () => {
        clearUploadedImage({ rerender: false });
        setImageStatus('failed', copy.imageLoadError);
        renderStep();
      };
      reader.readAsDataURL(file);
    }

    async function autoCompressUploadedImage(file) {
      clearUploadedImage({ rerender: false, cancelCompression: false });
      state.imageCompressionToken += 1;
      const token = state.imageCompressionToken;
      state.imageCompressing = true;
      imageUploadCard?.classList.add('is-compressing');
      setImageStatus('loading', copy.imageUploadCompressing);
      updateImagePreview();
      renderStep();

      try {
        const compressedFile = await compressUploadedImageFile(file);
        if (token !== state.imageCompressionToken) return;

        state.imageCompressing = false;
        imageUploadCard?.classList.remove('is-compressing');
        loadAcceptedUploadedImage(compressedFile, {
          loadingMessage: copy.imageLoading,
          readyMessage: copy.imageUploadCompressed,
        });
      } catch {
        if (token !== state.imageCompressionToken) return;

        state.imageCompressing = false;
        imageUploadCard?.classList.remove('is-compressing');
        clearUploadedImage({ rerender: false, cancelCompression: false });
        setImageStatus('warning', copy.imageUploadTooLarge, {
          href: IMAGE_REDUCER_URL,
          label: copy.imageUploadReduceLink,
        });
        updateImagePreview();
        renderStep();
      }
    }

    function readUploadedImage(file) {
      if (!file) return;

      if (!IMAGE_UPLOAD_TYPES.has(file.type)) {
        clearUploadedImage({ rerender: false });
        setImageStatus('invalid', copy.imageUploadInvalid);
        renderStep();
        return;
      }

      if (file.size > IMAGE_UPLOAD_MAX_BYTES) {
        void autoCompressUploadedImage(file);
        return;
      }

      loadAcceptedUploadedImage(file);
    }

    let imageUploadDragDepth = 0;

    function setImageUploadDragging(active) {
      imageUploadCard?.classList.toggle('is-dragging', active);
    }

    function imageFileFromDataTransfer(dataTransfer) {
      const itemFiles = Array.from(dataTransfer?.items || [])
        .filter((item) => item.kind === 'file')
        .map((item) => item.getAsFile())
        .filter(Boolean);
      const files = [...itemFiles, ...Array.from(dataTransfer?.files || [])];
      return files.find((file) => file.type.startsWith('image/')) || files[0];
    }

    function imageUrlFromDataTransfer(dataTransfer) {
      const uri = dataTransfer?.getData('text/uri-list') || dataTransfer?.getData('text/plain') || '';
      return uri
        .split(/\r?\n/)
        .map((line) => line.trim())
        .find((line) => line && !line.startsWith('#')) || '';
    }

    function handleImageUploadDragEnter(event) {
      if (!event.dataTransfer) return;
      event.preventDefault();
      imageUploadDragDepth += 1;
      event.dataTransfer.dropEffect = 'copy';
      setImageUploadDragging(true);
    }

    function handleImageUploadDragOver(event) {
      if (!event.dataTransfer) return;
      event.preventDefault();
      event.dataTransfer.dropEffect = 'copy';
      setImageUploadDragging(true);
    }

    function handleImageUploadDragLeave(event) {
      event.preventDefault();
      imageUploadDragDepth = Math.max(0, imageUploadDragDepth - 1);
      if (imageUploadDragDepth === 0) {
        setImageUploadDragging(false);
      }
    }

    function handleImageUploadDrop(event) {
      if (!event.dataTransfer) return;
      event.preventDefault();
      imageUploadDragDepth = 0;
      setImageUploadDragging(false);
      const file = imageFileFromDataTransfer(event.dataTransfer);
      if (file) {
        readUploadedImage(file);
        return;
      }

      const droppedUrl = imageUrlFromDataTransfer(event.dataTransfer);
      if (droppedUrl && imageUrl) {
        clearUploadedImage({ rerender: false });
        imageUrl.value = droppedUrl;
        normalizeUrlInput(imageUrl, { httpsOnly: true });
        updateImagePreview();
        renderStep();
      }
    }

    function validEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
    }

    function validSocialValue(platform, value) {
      const trimmed = value.trim();
      if (!trimmed) return true;

      if (platform === 'email') {
        if (validEmail(trimmed)) return true;
        if (!trimmed.startsWith('mailto:')) return false;
        return validEmail(trimmed.replace(/^mailto:/, ''));
      }

      return validUrl(trimmed);
    }

    function selectedCategoryValues() {
      return state.categories[state.kind] || [];
    }

    function shortCountryLabel(label) {
      return String(label || '').replace(/\s+\([A-Z]{2,6}\)$/, '');
    }

    function countrySelectionText(selectedItems) {
      if (!selectedItems.length) {
        return copy.countryPlaceholder;
      }

      const limit = selectedItems.length > 10 ? 4 : 10;
      const labels = selectedItems.slice(0, limit).map((item) => shortCountryLabel(item.label));
      return selectedItems.length > limit
        ? `${labels.join(', ')} ${copy.countryAndMore}`
        : labels.join(', ');
    }

    function reportCategoryValues() {
      return Array.from(wizardRoot.querySelectorAll('[data-report-category-option]'))
        .map((button) => button.getAttribute('data-report-category-option'))
        .filter(Boolean);
    }

    function selectedReportCategoryValues() {
      const selected = new Set(
        String(state.geneticReportCategory || '')
          .split(',')
          .map((value) => value.trim())
          .filter(Boolean),
      );

      return reportCategoryValues().filter((value) => selected.has(value));
    }

    function serializeReportCategoryValues(values) {
      const selected = new Set(values.filter(Boolean));
      return reportCategoryValues().filter((value) => selected.has(value)).join(',');
    }

    function isEmptySkippableStep(step) {
      if (step === 'website') {
        return !websiteUrl?.value.trim();
      }

      if (step === 'image') {
        return !imageUrl?.value.trim() && !state.uploadedImageDataUrl;
      }

      if (step === 'social') {
        return selectedSocialKeys().size === 0;
      }

      return false;
    }

    function validateCurrentStep({ silent = false } = {}) {
      const step = activeStepKey();
      let message = '';

      if (step === 'country' && state.countries.length === 0) {
        message = copy.required;
      } else if (step === 'category' && selectedCategoryValues().length === 0) {
        message = copy.required;
      } else if (step === 'name' && !nameInput?.value.trim()) {
        message = copy.required;
      } else if (
        step === 'description' &&
        (descriptionPrimary?.value.trim().length || 0) < DESCRIPTION_MIN_LENGTH
      ) {
        message = copy.descriptionMinError;
      } else if (step === 'email') {
        message = contactEmail?.value.trim() && validEmail(contactEmail.value)
          ? ''
          : copy.emailError;
      } else if (step === 'website' && websiteUrl && !validUrl(websiteUrl.value)) {
        message = copy.urlError;
      } else if (step === 'image' && imageUrl) {
        const url = imageUrl.value.trim();
        if (state.scrapedLogoStatus === 'loading') {
          message = copy.logoLookupTitle;
        } else if (state.imageCompressing) {
          message = copy.imageUploadCompressing;
        } else if (url && !validUrl(url, true)) {
          message = copy.imageUrlError;
        } else if ((url || state.uploadedImageDataUrl) && state.imageStatus === 'loading') {
          message = copy.imageLoading;
        } else if ((url || state.uploadedImageDataUrl) && state.imageStatus === 'failed') {
          message = copy.imageLoadError;
        }
      } else if (step === 'social') {
        const invalidSocial = Array.from(wizardRoot.querySelectorAll('[data-social-url]')).some(
          (input) => {
            const platform = input.closest('[data-social-row]')?.getAttribute('data-social-row') || '';
            return input.value.trim() && !validSocialValue(platform, input.value);
          },
        );
        message = invalidSocial ? copy.socialLinkError : '';
      } else if (step === 'provider' && state.geneticReportProvider === null) {
        message = copy.required;
      } else if (step === 'report' && selectedReportCategoryValues().length === 0) {
        message = copy.required;
      }

      if (!silent) {
        setError(message);
      }

      return !message;
    }

    function updateNameCopy() {
      if (!nameInput || !nameLabel) return;

      if (state.kind === 'organization') {
        nameLabel.textContent = copy.organizationNameLabel;
        nameInput.setAttribute('placeholder', copy.organizationNamePlaceholder);
        nameInput.setAttribute('autocomplete', 'organization');
      } else {
        nameLabel.textContent = copy.individualNameLabel;
        nameInput.setAttribute('placeholder', copy.individualNamePlaceholder);
        nameInput.setAttribute('autocomplete', 'name');
      }
    }

