    function displaySocialValue(value) {
      const trimmed = value.trim();
      if (!trimmed) return '';
      if (trimmed.startsWith('mailto:')) {
        return trimmed.replace(/^mailto:/, '');
      }

      try {
        const parsed = new URL(urlWithProtocol(trimmed));
        return parsed.hostname.replace(/^www\./, '') + parsed.pathname.replace(/\/$/, '');
      } catch {
        return trimmed;
      }
    }

    function createPencilIcon() {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z');
      svg.append(path);
      return svg;
    }

