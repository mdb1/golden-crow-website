    function renderStep() {
      const steps = visibleSteps();
      if (state.currentStep >= steps.length) {
        state.currentStep = steps.length - 1;
      }

      const step = activeStepKey();
      const previousStep = state.renderedStep;
      const stepChanged = Boolean(previousStep && previousStep !== step);
      state.renderedStep = step;
      wizardRoot.dataset.activeStep = step;
      wizardRoot.dataset.scrollMode = scrollModeForStep(step);

      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-step-panel') !== step;
      });

      if (stepChanged && form) {
        form.scrollTo({ top: 0, left: 0, behavior: 'auto' });
      }

      if (stepCount) {
        stepCount.textContent = `${copy.step} ${state.currentStep + 1} ${copy.of} ${steps.length}`;
      }

      dots.forEach((dot, index) => {
        const progressIndex = Math.round((index / Math.max(dots.length - 1, 1)) * (steps.length - 1));
        dot.classList.toggle('is-active', progressIndex <= state.currentStep);
      });

      if (backButton) {
        backButton.disabled = state.currentStep === 0 || state.submitting;
      }

      if (languageSwitch) {
        languageSwitch.hidden = state.hasAdvanced || state.currentStep !== 0;
      }

      if (nextButton) {
        const last = state.currentStep === steps.length - 1;
        let nextLabel = copy.continue;
        if (state.submitting) {
          nextLabel = submitLoadingLabel();
        } else if (step === 'image' && state.scrapedLogoStatus === 'loading') {
          nextLabel = copy.logoLookupTitle;
        } else if (step === 'image' && state.imageCompressing) {
          nextLabel = copy.imageUploadCompressing;
        } else if (isEmptySkippableStep(step)) {
          nextLabel = copy.skip;
        } else if (last) {
          nextLabel = copy.finish;
        }

        nextButton.textContent = nextLabel;
        nextButton.disabled = state.submitting || !validateCurrentStep({ silent: true });
      }

      updateNameCopy();
      updateCountryUi();
      updateCategoryUi();
      updateProviderUi();
      updateDescriptionUi();
      syncUploadedImageUi();
      updateImageChoiceUi();
      syncLogoDiscoveryUi();
      updateColorUi();
      updateSocialUi();
    }

