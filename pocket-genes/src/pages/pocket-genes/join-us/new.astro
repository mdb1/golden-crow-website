---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/join-us/new"
  showFooter={false}
>
  <main
    id="main"
    class="pg-wizard-page"
    data-publisher-wizard
    data-locale={locale}
    data-sdk-url={sdkUrl}
    data-home-href={homeHref}
    data-copy={JSON.stringify(wizardClientCopy)}
  >
    <aside class="pg-wizard-intro" aria-label="Pocket Genes">
      <a class="pg-wizard-logo" href={homeHref} aria-label="Pocket Genes">
        <img src="/pocket-genes/icon_simple.png" alt="" width="52" height="52" />
      </a>
      <div class="pg-wizard-intro-copy">
        <h1>{copy.sidebarTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
        <p>{copy.sidebarBody}</p>
        <small>{copy.sidebarHint}</small>
      </div>
    </aside>

    <section class="pg-wizard-panel" aria-labelledby="wizard-current-title">
      <div class="pg-wizard-topbar">
        <a href={otherLanguageHref} aria-label={copy.languageAria}>{copy.languageLabel}</a>
      </div>

      <form class="pg-wizard-form" data-wizard-form novalidate>
        <input
          class="pg-wizard-honeypot"
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <div class="pg-wizard-progress" aria-hidden="true">
          <span data-step-dot></span>
          <span data-step-dot></span>
          <span data-step-dot></span>
          <span data-step-dot></span>
          <span data-step-dot></span>
        </div>

        <p class="pg-wizard-step-count" data-step-count></p>

        <div class="pg-wizard-step" data-step-panel="type">
          <div class="pg-step-heading">
            <h2 id="wizard-current-title">{copy.typeTitle}</h2>
            <p>{copy.typeBody}</p>
          </div>
          <div class="pg-choice-grid pg-kind-grid">
            <button type="button" class="pg-choice is-selected" data-kind-option="organization" aria-pressed="true">
              <span>{copy.organizationLabel}</span>
              <small>{copy.organizationBody}</small>
            </button>
            <button type="button" class="pg-choice" data-kind-option="individual" aria-pressed="false">
              <span>{copy.individualLabel}</span>
              <small>{copy.individualBody}</small>
            </button>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="country" hidden>
          <div class="pg-step-heading">
            <h2>{copy.countryTitle}</h2>
            <p>{copy.countryBody}</p>
          </div>
          <div class="pg-picker-shell">
            <button type="button" class="pg-large-field" data-country-toggle aria-expanded="false">
              <span>{copy.countryButtonLabel}</span>
              <strong data-country-summary>{copy.countryPlaceholder}</strong>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="pg-picker-popover" data-country-popover hidden>
              <input type="search" data-country-search placeholder={copy.countrySearch} autocomplete="off" />
              <div class="pg-country-list" data-country-list>
                {countryGroups.map((group) => (
                  <div class="pg-country-group">
                    <p>{group.label}</p>
                    {group.options.map((option) => (
                      <button
                        type="button"
                        data-country-option={option.value}
                        data-label={option.label}
                        data-flag={option.flag}
                        aria-pressed="false"
                      >
                        <span class="pg-country-flag" aria-hidden="true">{option.flag}</span>
                        <span>{option.label}</span>
                      </button>
                    ))}
                  </div>
                ))}
              </div>
              <p class="pg-picker-empty" data-country-empty hidden>{copy.countryEmpty}</p>
            </div>
          </div>
          <div class="pg-chip-row" data-country-chips></div>
        </div>

        <div class="pg-wizard-step" data-step-panel="category" hidden>
          <div class="pg-step-heading">
            <h2>{copy.categoryTitle}</h2>
            <p>{copy.categoryBody}</p>
          </div>
          <input class="pg-search-field" type="search" data-category-search placeholder={copy.categorySearch} autocomplete="off" />
          <div class="pg-category-list" data-category-list="organization">
            {organizationCategories.map((option) => (
              <button type="button" data-category-option={option.value} data-label={option.label} aria-pressed="false">
                {option.label}
              </button>
            ))}
          </div>
          <div class="pg-category-list" data-category-list="individual" hidden>
            {individualCategories.map((option) => (
              <button type="button" data-category-option={option.value} data-label={option.label} aria-pressed="false">
                {option.label}
              </button>
            ))}
          </div>
          <p class="pg-selected-note" data-category-summary></p>
        </div>

        <div class="pg-wizard-step" data-step-panel="name" hidden>
          <div class="pg-step-heading">
            <h2>{copy.nameTitle}</h2>
            <p>{copy.nameBody}</p>
          </div>
          <label class="pg-input-shell">
            <span data-name-label>{copy.nameLabelOrganization}</span>
            <input
              type="text"
              name="publisherName"
              data-publisher-name
              maxlength="180"
              autocomplete="organization"
              placeholder={copy.namePlaceholderOrganization}
            />
          </label>
        </div>

        <div class="pg-wizard-step" data-step-panel="description" hidden>
          <div class="pg-step-heading">
            <h2>{copy.descriptionTitle}</h2>
            <p>{copy.descriptionBody}</p>
          </div>
          <div class="pg-description-composer">
            <label class="pg-input-shell pg-textarea-shell pg-description-card" data-description-card>
              <span>{copy.descriptionLabel}</span>
              <textarea
                name="descriptionPrimary"
                data-description-primary
                maxlength="5000"
                rows="7"
                placeholder={copy.descriptionPlaceholder}
              ></textarea>
              <div class="pg-description-meter" aria-hidden="true">
                <span data-description-meter></span>
              </div>
              <div class="pg-description-footer">
                <small data-description-helper>{copy.descriptionMinHint}</small>
                <strong data-description-count>0 / 30</strong>
              </div>
              <div class="pg-writing-pulses" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
            </label>
            <div class="pg-description-prompts">
              {copy.descriptionPrompts.map((prompt) => <span>{prompt}</span>)}
            </div>
            <section class="pg-alt-description-offer" data-alt-description-offer>
              <div>
                <strong>{copy.altDescriptionTitle}</strong>
                <p>{copy.altDescriptionBody}</p>
              </div>
              <button type="button" class="pg-secondary-action" data-alt-description-toggle aria-expanded="false">
                {copy.altDescriptionButton}
              </button>
            </section>
            <section class="pg-alt-description-panel" data-alt-description-field hidden>
              <div class="pg-alt-description-heading">
                <div>
                  <strong>{copy.altDescriptionLabel}</strong>
                  <p>{copy.altDescriptionBody}</p>
                </div>
                <button type="button" data-alt-description-remove>
                  {copy.altDescriptionRemove}
                </button>
              </div>
              <label class="pg-input-shell pg-textarea-shell pg-alt-description-input">
                <textarea
                  name="descriptionAlternative"
                  data-description-alternative
                  maxlength="5000"
                  rows="5"
                  placeholder={copy.altDescriptionPlaceholder}
                ></textarea>
              </label>
            </section>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="email" hidden>
          <div class="pg-step-heading">
            <h2>{copy.emailTitle}</h2>
            <p>{copy.emailBody}</p>
          </div>
          <label class="pg-input-shell">
            <span>{copy.emailLabel}</span>
            <input
              type="email"
              name="contactEmail"
              data-contact-email
              maxlength="180"
              autocomplete="email"
              placeholder={copy.emailPlaceholder}
            />
          </label>
        </div>

        <div class="pg-wizard-step" data-step-panel="website" hidden>
          <div class="pg-step-heading">
            <h2>{copy.websiteTitle}</h2>
            <p>{copy.websiteBody}</p>
          </div>
          <label class="pg-input-shell">
            <span>{copy.websiteLabel}</span>
            <input
              type="url"
              name="websiteUrl"
              data-website-url
              maxlength="1000"
              placeholder={copy.websitePlaceholder}
            />
          </label>
          <p class="pg-skip-hint">{copy.skipHint}</p>
        </div>

        <div class="pg-wizard-step" data-step-panel="image" hidden>
          <div class="pg-step-heading">
            <h2>{copy.imageTitle}</h2>
            <p>{copy.imageBody}</p>
          </div>
          <div class="pg-profile-flow">
            <section class="pg-profile-row pg-profile-image-row">
              <div class="pg-profile-row-copy">
                <span>01</span>
                <h3>{copy.imageRowTitle}</h3>
                <p>{copy.imageRowBody}</p>
              </div>
              <div class="pg-profile-row-main">
                <label class="pg-input-shell">
                  <span>{copy.imageLabel}</span>
                  <input
                    type="url"
                    name="imageUrl"
                    data-image-url
                    maxlength="1000"
                    placeholder={copy.imagePlaceholder}
                  />
                </label>
                <p class="pg-image-status" data-image-status aria-live="polite"></p>
                <p class="pg-skip-hint">{copy.skipHint}</p>
              </div>
              <div class="pg-profile-preview" data-profile-preview>
                <div class="pg-preview-image" data-preview-image>
                  <span>PG</span>
                </div>
              </div>
            </section>

            <section class="pg-profile-row pg-color-row" data-color-row hidden>
              <div class="pg-profile-row-copy">
                <span>02</span>
                <h3>{copy.colorRowTitle}</h3>
                <p>{copy.colorRowBody}</p>
              </div>
              <div class="pg-profile-row-main">
                <p class="pg-color-story" data-color-story>{copy.colorAutoExplanation}</p>
                <div class="pg-color-controls">
                  <label class="pg-color-picker">
                    <span>{copy.customColorLabel}</span>
                    <input type="color" value="#6F3CC3" data-color-input />
                    <strong data-color-hex>#6F3CC3</strong>
                  </label>
                  <button type="button" class="pg-suggested-color-button" data-use-suggested-color>
                    <span data-suggested-color-swatch></span>
                    <span>{copy.colorSuggested}</span>
                  </button>
                </div>
              </div>
              <div class="pg-color-preview" aria-hidden="true">
                <span class="pg-color-orbit"></span>
                <span class="pg-color-swatch" data-color-swatch></span>
                <small>{copy.colorHexLabel}</small>
              </div>
            </section>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="social" hidden>
          <div class="pg-step-heading">
            <h2>{copy.socialTitle}</h2>
            <p>{copy.socialBody}</p>
          </div>
          <div
            class="pg-social-workbench"
            data-social-workbench
            data-social-options={JSON.stringify(socialOptions)}
          >
            <section class="pg-social-picker-panel">
              <div class="pg-social-panel-heading">
                <span>{copy.socialOptional}</span>
                <h3>{copy.socialPickerTitle}</h3>
                <p>{copy.socialPickerBody}</p>
              </div>
              <input
                class="pg-search-field pg-social-search"
                type="search"
                data-social-search
                placeholder={copy.socialSearch}
                autocomplete="off"
              />
              <div class="pg-social-option-grid" data-social-option-grid>
                {socialOptions.map((option) => (
                  <button
                    type="button"
                    data-social-option={option.value}
                    data-label={option.label}
                    data-placeholder={option.placeholder}
                    data-asset={option.assetName}
                    aria-pressed="false"
                  >
                    <span class="pg-social-icon" aria-hidden="true">
                      <img src={`/discover/social-network-assets/${option.assetName}.png`} alt="" loading="lazy" />
                    </span>
                    <span>
                      <strong>{option.label}</strong>
                      <small>{option.placeholder}</small>
                    </span>
                  </button>
                ))}
              </div>
              <p class="pg-social-empty-search" data-social-empty-search hidden>
                {copy.socialEmptySearch}
              </p>
            </section>
            <section class="pg-social-selected-panel">
              <div class="pg-social-panel-heading">
                <span>{copy.socialOptional}</span>
                <h3>{copy.socialAddedTitle}</h3>
                <p>{copy.socialAddedBody}</p>
              </div>
              <strong class="pg-social-count" data-social-count>0</strong>
              <div class="pg-social-list" data-social-list>
                <p class="pg-social-empty-state" data-social-empty-state>
                  {copy.socialNoLinks}
                </p>
              </div>
            </section>
          </div>
          <p class="pg-skip-hint">{copy.skipHint}</p>
        </div>

        <div class="pg-wizard-step" data-step-panel="provider" hidden>
          <div class="pg-step-heading">
            <h2>{copy.providerTitle}</h2>
            <p>{copy.providerBody}</p>
          </div>
          <div class="pg-choice-grid pg-answer-grid">
            <button type="button" class="pg-choice" data-provider-option="true" aria-pressed="false">
              <span>{copy.providerYes}</span>
            </button>
            <button type="button" class="pg-choice" data-provider-option="false" aria-pressed="false">
              <span>{copy.providerNo}</span>
            </button>
          </div>
        </div>

        <div class="pg-wizard-step" data-step-panel="report" hidden>
          <div class="pg-step-heading">
            <h2>{copy.reportTitle}</h2>
            <p>{copy.reportBody}</p>
          </div>
          <div class="pg-category-list pg-report-list">
            {geneticReportCategories.map((option) => (
              <button
                type="button"
                data-report-category-option={option.value}
                aria-pressed={option.value === '' ? 'true' : 'false'}
                class:list={[{ 'is-selected': option.value === '' }]}
              >
                {option.label}
              </button>
            ))}
          </div>
        </div>

        <p class="pg-wizard-error" data-wizard-error role="alert" hidden></p>
      </form>

      <div class="pg-wizard-actionbar">
        <button type="button" class="pg-back-button" data-wizard-back>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span>{copy.back}</span>
        </button>
        <button type="button" class="pg-primary-button" data-wizard-next>{copy.continue}</button>
      </div>
    </section>

    <section class="pg-wizard-success" data-wizard-success hidden>
      <span class="pg-success-circle" aria-hidden="true"></span>
      <div class="pg-success-content">
        <div class="pg-success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>
        <h2>{copy.successTitle}</h2>
        <p>{copy.successBody}</p>
        <div class="pg-success-actions">
          <button type="button" data-open-booking>
            <span>{copy.callTitle}</span>
            <strong>{copy.callButton}</strong>
          </button>
          <a href={homeHref}>{copy.exploreButton}</a>
        </div>
        <div class="pg-success-booking" data-success-booking hidden>
          <ClientBookingWidget
            context="pocket-genes-join-us-wizard"
            eventTitle={copy.bookingTitle}
            brandName="Pocket Genes"
            emphasizeBrandName={false}
          />
        </div>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<script>
  const wizardRoot = document.querySelector('[data-publisher-wizard]');

  if (wizardRoot) {
    const copy = JSON.parse(wizardRoot.getAttribute('data-copy') || '{}');
    const locale = wizardRoot.getAttribute('data-locale') || 'es';
    const sdkUrl = wizardRoot.getAttribute('data-sdk-url') || 'https://golden-crow-sdk.vercel.app';
    const DESCRIPTION_MIN_LENGTH = 30;
    const state = {
      kind: 'organization',
      countries: [],
      categories: {
        organization: [],
        individual: [],
      },
      geneticReportProvider: null,
      geneticReportCategory: '',
      currentStep: 0,
      color: '#6F3CC3',
      suggestedColor: '#6F3CC3',
      colorCustomized: false,
      imageStatus: 'empty',
      imageLoadToken: 0,
      submitting: false,
      startedAt: new Date().toISOString(),
    };

    const form = wizardRoot.querySelector('[data-wizard-form]');
    const panels = Array.from(wizardRoot.querySelectorAll('[data-step-panel]'));
    const stepCount = wizardRoot.querySelector('[data-step-count]');
    const dots = Array.from(wizardRoot.querySelectorAll('[data-step-dot]'));
    const nextButton = wizardRoot.querySelector('[data-wizard-next]');
    const backButton = wizardRoot.querySelector('[data-wizard-back]');
    const errorBox = wizardRoot.querySelector('[data-wizard-error]');
    const countryToggle = wizardRoot.querySelector('[data-country-toggle]');
    const countryPopover = wizardRoot.querySelector('[data-country-popover]');
    const countrySearch = wizardRoot.querySelector('[data-country-search]');
    const countrySummary = wizardRoot.querySelector('[data-country-summary]');
    const countryChips = wizardRoot.querySelector('[data-country-chips]');
    const countryEmpty = wizardRoot.querySelector('[data-country-empty]');
    const categorySearch = wizardRoot.querySelector('[data-category-search]');
    const categorySummary = wizardRoot.querySelector('[data-category-summary]');
    const nameInput = wizardRoot.querySelector('[data-publisher-name]');
    const nameLabel = wizardRoot.querySelector('[data-name-label]');
    const descriptionPrimary = wizardRoot.querySelector('[data-description-primary]');
    const descriptionAlternative = wizardRoot.querySelector('[data-description-alternative]');
    const descriptionCard = wizardRoot.querySelector('[data-description-card]');
    const descriptionMeter = wizardRoot.querySelector('[data-description-meter]');
    const descriptionHelper = wizardRoot.querySelector('[data-description-helper]');
    const descriptionCount = wizardRoot.querySelector('[data-description-count]');
    const altDescriptionToggle = wizardRoot.querySelector('[data-alt-description-toggle]');
    const altDescriptionOffer = wizardRoot.querySelector('[data-alt-description-offer]');
    const altDescriptionField = wizardRoot.querySelector('[data-alt-description-field]');
    const altDescriptionRemove = wizardRoot.querySelector('[data-alt-description-remove]');
    const contactEmail = wizardRoot.querySelector('[data-contact-email]');
    const websiteUrl = wizardRoot.querySelector('[data-website-url]');
    const imageUrl = wizardRoot.querySelector('[data-image-url]');
    const imageStatus = wizardRoot.querySelector('[data-image-status]');
    const previewImage = wizardRoot.querySelector('[data-preview-image]');
    const colorRow = wizardRoot.querySelector('[data-color-row]');
    const colorStory = wizardRoot.querySelector('[data-color-story]');
    const colorInput = wizardRoot.querySelector('[data-color-input]');
    const colorSwatch = wizardRoot.querySelector('[data-color-swatch]');
    const suggestedColorSwatch = wizardRoot.querySelector('[data-suggested-color-swatch]');
    const colorHex = wizardRoot.querySelector('[data-color-hex]');
    const useSuggestedColor = wizardRoot.querySelector('[data-use-suggested-color]');
    const socialWorkbench = wizardRoot.querySelector('[data-social-workbench]');
    const socialOptions = JSON.parse(socialWorkbench?.getAttribute('data-social-options') || '[]');
    const socialOptionsByValue = new Map(socialOptions.map((option) => [option.value, option]));
    const socialSearch = wizardRoot.querySelector('[data-social-search]');
    const socialOptionGrid = wizardRoot.querySelector('[data-social-option-grid]');
    const socialEmptySearch = wizardRoot.querySelector('[data-social-empty-search]');
    const socialCount = wizardRoot.querySelector('[data-social-count]');
    const socialEmptyState = wizardRoot.querySelector('[data-social-empty-state]');
    const socialList = wizardRoot.querySelector('[data-social-list]');
    const success = wizardRoot.querySelector('[data-wizard-success]');
    const openBooking = wizardRoot.querySelector('[data-open-booking]');
    const successBooking = wizardRoot.querySelector('[data-success-booking]');

    function visibleSteps() {
      const steps = ['type', 'country', 'category', 'name', 'description', 'email', 'website', 'image', 'social'];

      if (state.kind === 'organization') {
        steps.push('provider');
        if (state.geneticReportProvider === true) {
          steps.push('report');
        }
      }

      return steps;
    }

    function activeStepKey() {
      return visibleSteps()[state.currentStep] || 'type';
    }

    function setError(message) {
      if (!errorBox) return;
      errorBox.textContent = message || '';
      errorBox.hidden = !message;
    }

    function validUrl(value, httpsOnly = false) {
      if (!value.trim()) return true;
      try {
        const parsed = new URL(value.trim());
        return httpsOnly
          ? parsed.protocol === 'https:'
          : parsed.protocol === 'http:' || parsed.protocol === 'https:';
      } catch {
        return false;
      }
    }

    function validEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
    }

    function validSocialValue(platform, value) {
      const trimmed = value.trim();
      if (!trimmed) return true;

      if (platform === 'email') {
        if (validEmail(trimmed)) return true;
        if (!trimmed.startsWith('mailto:')) return false;
        return validEmail(trimmed.replace(/^mailto:/, ''));
      }

      return validUrl(trimmed);
    }

    function selectedCategoryValues() {
      return state.categories[state.kind] || [];
    }

    function isEmptySkippableStep(step) {
      if (step === 'website') {
        return !websiteUrl?.value.trim();
      }

      if (step === 'image') {
        return !imageUrl?.value.trim();
      }

      if (step === 'social') {
        return selectedSocialKeys().size === 0;
      }

      return false;
    }

    function validateCurrentStep({ silent = false } = {}) {
      const step = activeStepKey();
      let message = '';

      if (step === 'country' && state.countries.length === 0) {
        message = copy.required;
      } else if (step === 'category' && selectedCategoryValues().length === 0) {
        message = copy.required;
      } else if (step === 'name' && !nameInput?.value.trim()) {
        message = copy.required;
      } else if (
        step === 'description' &&
        (descriptionPrimary?.value.trim().length || 0) < DESCRIPTION_MIN_LENGTH
      ) {
        message = copy.descriptionMinError;
      } else if (step === 'email') {
        message = contactEmail?.value.trim() && validEmail(contactEmail.value)
          ? ''
          : copy.emailError;
      } else if (step === 'website' && websiteUrl && !validUrl(websiteUrl.value)) {
        message = copy.urlError;
      } else if (step === 'image' && imageUrl) {
        const url = imageUrl.value.trim();
        if (url && !validUrl(url, true)) {
          message = copy.imageUrlError;
        } else if (url && state.imageStatus === 'loading') {
          message = copy.imageLoading;
        } else if (url && state.imageStatus === 'failed') {
          message = copy.imageLoadError;
        }
      } else if (step === 'social') {
        const invalidSocial = Array.from(wizardRoot.querySelectorAll('[data-social-url]')).some(
          (input) => {
            const platform = input.closest('[data-social-row]')?.getAttribute('data-social-row') || '';
            return input.value.trim() && !validSocialValue(platform, input.value);
          },
        );
        message = invalidSocial ? copy.socialLinkError : '';
      } else if (step === 'provider' && state.geneticReportProvider === null) {
        message = copy.required;
      }

      if (!silent) {
        setError(message);
      }

      return !message;
    }

    function updateNameCopy() {
      if (!nameInput || !nameLabel) return;

      if (state.kind === 'organization') {
        nameLabel.textContent = copy.organizationNameLabel;
        nameInput.setAttribute('placeholder', copy.organizationNamePlaceholder);
        nameInput.setAttribute('autocomplete', 'organization');
      } else {
        nameLabel.textContent = copy.individualNameLabel;
        nameInput.setAttribute('placeholder', copy.individualNamePlaceholder);
        nameInput.setAttribute('autocomplete', 'name');
      }
    }

    function updateCountryUi() {
      const selected = new Set(state.countries);
      let selectedItems = [];

      wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
        const value = button.getAttribute('data-country-option');
        const active = selected.has(value);
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        if (active) {
          selectedItems.push({
            label: button.getAttribute('data-label') || value,
            flag: button.getAttribute('data-flag') || '',
          });
        }
      });

      if (countrySummary) {
        countrySummary.replaceChildren();

        if (selectedItems.length === 1) {
          const flag = document.createElement('span');
          flag.className = 'pg-country-summary-flag';
          flag.setAttribute('aria-hidden', 'true');
          flag.textContent = selectedItems[0].flag;
          const label = document.createElement('span');
          label.textContent = selectedItems[0].label;
          countrySummary.append(flag, label);
        } else {
          countrySummary.textContent = selectedItems.length
            ? `${selectedItems.length} ${copy.selectedCountries}`
            : copy.countryPlaceholder;
        }
      }

      if (countryChips) {
        countryChips.replaceChildren(
          ...selectedItems.map((item) => {
            const chip = document.createElement('span');
            const flag = document.createElement('span');
            flag.className = 'pg-chip-flag';
            flag.setAttribute('aria-hidden', 'true');
            flag.textContent = item.flag;
            const label = document.createElement('span');
            label.textContent = item.label;
            chip.append(flag, label);
            return chip;
          }),
        );
      }
    }

    function updateCategoryUi() {
      const selected = new Set(selectedCategoryValues());
      wizardRoot.querySelectorAll('[data-category-list]').forEach((list) => {
        const listKind = list.getAttribute('data-category-list');
        list.hidden = listKind !== state.kind;
      });

      wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
        const value = button.getAttribute('data-category-option');
        const active = selected.has(value);
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      if (categorySummary) {
        const count = selectedCategoryValues().length;
        categorySummary.textContent = count ? `${count} ${copy.selectedCategories}` : '';
      }
    }

    function updateProviderUi() {
      wizardRoot.querySelectorAll('[data-provider-option]').forEach((button) => {
        const active = String(state.geneticReportProvider) === button.getAttribute('data-provider-option');
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      wizardRoot.querySelectorAll('[data-report-category-option]').forEach((button) => {
        const active = state.geneticReportCategory === button.getAttribute('data-report-category-option');
        button.classList.toggle('is-selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function updateDescriptionUi() {
      if (!descriptionPrimary) return;

      const length = descriptionPrimary.value.trim().length;
      const done = length >= DESCRIPTION_MIN_LENGTH;
      const remaining = Math.max(0, DESCRIPTION_MIN_LENGTH - length);
      const progress = Math.min(1, length / DESCRIPTION_MIN_LENGTH);

      descriptionCard?.classList.toggle('is-started', length > 0);
      descriptionCard?.classList.toggle('is-complete', done);

      if (descriptionMeter) {
        descriptionMeter.style.transform = `scaleX(${progress})`;
      }

      if (descriptionCount) {
        descriptionCount.textContent = `${length} / ${DESCRIPTION_MIN_LENGTH} ${copy.descriptionCountLabel}`;
      }

      if (descriptionHelper) {
        descriptionHelper.textContent = done
          ? copy.descriptionReady
          : `${remaining} ${copy.descriptionRemainingLabel}`;
      }
    }

    let descriptionPulseTimer;
    function pulseDescriptionWriting() {
      if (!descriptionCard) return;

      descriptionCard.classList.add('is-writing');
      window.clearTimeout(descriptionPulseTimer);
      descriptionPulseTimer = window.setTimeout(() => {
        descriptionCard.classList.remove('is-writing');
      }, 760);
    }

    function updateColorUi() {
      const current = state.color.toUpperCase();
      const suggested = state.suggestedColor.toUpperCase();

      if (colorInput) colorInput.value = current;
      if (previewImage) previewImage.style.setProperty('--wizard-preview-color', current);
      if (colorSwatch) colorSwatch.style.backgroundColor = current;
      if (suggestedColorSwatch) suggestedColorSwatch.style.backgroundColor = suggested;
      if (colorHex) colorHex.textContent = current;
      if (colorStory) {
        colorStory.textContent = state.colorCustomized
          ? copy.colorCustomExplanation
          : copy.colorAutoExplanation;
      }
      colorRow?.classList.toggle('is-custom', state.colorCustomized);
    }

    function setColorRowVisible(visible) {
      if (!colorRow) return;

      colorRow.hidden = !visible;
      colorRow.classList.toggle('is-visible', visible);
      if (visible) {
        updateColorUi();
      }
    }

    function setImageStatus(status, message = '') {
      state.imageStatus = status;

      if (imageStatus) {
        imageStatus.textContent = message;
        imageStatus.hidden = !message;
        imageStatus.dataset.status = status;
      }
    }

    function updateColor(value) {
      state.color = value.toUpperCase();
      updateColorUi();
    }

    function renderStep() {
      const steps = visibleSteps();
      if (state.currentStep >= steps.length) {
        state.currentStep = steps.length - 1;
      }

      const step = activeStepKey();
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-step-panel') !== step;
      });

      if (stepCount) {
        stepCount.textContent = `${copy.step} ${state.currentStep + 1} ${copy.of} ${steps.length}`;
      }

      dots.forEach((dot, index) => {
        const progressIndex = Math.round((index / Math.max(dots.length - 1, 1)) * (steps.length - 1));
        dot.classList.toggle('is-active', progressIndex <= state.currentStep);
      });

      if (backButton) {
        backButton.disabled = state.currentStep === 0 || state.submitting;
      }

      if (nextButton) {
        const last = state.currentStep === steps.length - 1;
        let nextLabel = copy.continue;
        if (state.submitting) {
          nextLabel = copy.sending;
        } else if (isEmptySkippableStep(step)) {
          nextLabel = copy.skip;
        } else if (last) {
          nextLabel = copy.finish;
        }

        nextButton.textContent = nextLabel;
        nextButton.disabled = state.submitting || !validateCurrentStep({ silent: true });
      }

      updateNameCopy();
      updateCountryUi();
      updateCategoryUi();
      updateProviderUi();
      updateDescriptionUi();
      updateColorUi();
      updateSocialUi();
    }

    function toggleCountry(value) {
      if (!value) return;

      if (value === 'GLOBAL') {
        state.countries = state.countries.includes('GLOBAL') ? [] : ['GLOBAL'];
      } else {
        const current = state.countries.filter((code) => code !== 'GLOBAL');
        state.countries = current.includes(value)
          ? current.filter((code) => code !== value)
          : [...current, value];
      }

      setError('');
      renderStep();
    }

    function toggleCategory(value) {
      if (!value) return;
      const current = selectedCategoryValues();
      state.categories[state.kind] = current.includes(value)
        ? current.filter((category) => category !== value)
        : [...current, value];
      setError('');
      renderStep();
    }

    function filterCountryOptions(query) {
      const normalized = query.trim().toLowerCase();
      let visibleCount = 0;

      wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
        const label = (button.getAttribute('data-label') || '').toLowerCase();
        const visible = !normalized || label.includes(normalized);
        button.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      wizardRoot.querySelectorAll('.pg-country-group').forEach((group) => {
        const visibleButtons = Array.from(group.querySelectorAll('[data-country-option]')).some(
          (button) => !button.hidden,
        );
        group.hidden = !visibleButtons;
      });

      if (countryEmpty) {
        countryEmpty.hidden = visibleCount > 0;
      }
    }

    function filterCategoryOptions(query) {
      const normalized = query.trim().toLowerCase();
      wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
        const label = (button.getAttribute('data-label') || '').toLowerCase();
        button.hidden = Boolean(normalized) && !label.includes(normalized);
      });
    }

    function positionCountryPopover() {
      if (!countryPopover || countryPopover.hidden || !countryToggle) return;

      const rect = countryToggle.getBoundingClientRect();
      const viewportPadding = 16;
      const gap = 10;
      const width = Math.min(rect.width, window.innerWidth - viewportPadding * 2);
      const left = Math.min(
        Math.max(viewportPadding, rect.left),
        Math.max(viewportPadding, window.innerWidth - width - viewportPadding),
      );
      let top = rect.bottom + gap;
      let maxHeight = Math.min(460, window.innerHeight - top - viewportPadding);

      if (maxHeight < 240) {
        const spaceAbove = rect.top - viewportPadding - gap;
        if (spaceAbove > maxHeight) {
          maxHeight = Math.min(460, spaceAbove);
          top = Math.max(viewportPadding, rect.top - gap - maxHeight);
        }
      }

      countryPopover.style.setProperty('--country-popover-left', `${left}px`);
      countryPopover.style.setProperty('--country-popover-top', `${top}px`);
      countryPopover.style.setProperty('--country-popover-width', `${width}px`);
      countryPopover.style.setProperty(
        '--country-popover-max-height',
        `${Math.max(180, maxHeight)}px`,
      );
    }

    function setCountryPopoverOpen(open) {
      if (!countryPopover || !countryToggle) return;

      countryPopover.hidden = !open;
      countryToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      countryToggle.closest('.pg-picker-shell')?.classList.toggle('is-open', open);
      wizardRoot.classList.toggle('has-open-picker', open);

      if (open) {
        positionCountryPopover();
        countrySearch?.focus();
      }
    }

    function deterministicColor(seed) {
      const colors = ['#6F3CC3', '#E45080', '#14958F', '#2176AE', '#3C9B68', '#D99232'];
      let hash = 0;
      const text = seed || nameInput?.value || 'Pocket Genes';

      for (let index = 0; index < text.length; index += 1) {
        hash = (hash * 31 + text.charCodeAt(index)) % 9973;
      }

      return colors[Math.abs(hash) % colors.length];
    }

    function averageImageColor(url) {
      return new Promise((resolve) => {
        if (!url.trim()) {
          resolve(deterministicColor('Pocket Genes'));
          return;
        }

        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => {
          try {
            const canvas = document.createElement('canvas');
            const size = 24;
            canvas.width = size;
            canvas.height = size;
            const context = canvas.getContext('2d', { willReadFrequently: true });
            context.drawImage(image, 0, 0, size, size);
            const { data } = context.getImageData(0, 0, size, size);
            let r = 0;
            let g = 0;
            let b = 0;
            let count = 0;

            for (let index = 0; index < data.length; index += 4) {
              const alpha = data[index + 3];
              if (alpha < 80) continue;
              r += data[index];
              g += data[index + 1];
              b += data[index + 2];
              count += 1;
            }

            if (!count) {
              resolve(deterministicColor(url));
              return;
            }

            const hex = [r / count, g / count, b / count]
              .map((channel) => Math.max(0, Math.min(255, Math.round(channel))).toString(16).padStart(2, '0'))
              .join('');
            resolve(`#${hex}`.toUpperCase());
          } catch {
            resolve(deterministicColor(url));
          }
        };
        image.onerror = () => resolve(deterministicColor(url));
        image.src = url.trim();
      });
    }

    function updateImagePreview() {
      if (!imageUrl || !previewImage) return;
      const url = imageUrl.value.trim();
      state.imageLoadToken += 1;
      const token = state.imageLoadToken;

      function renderInitials() {
        const initials = document.createElement('span');
        const text = nameInput?.value.trim() || 'Pocket Genes';
        initials.textContent = text
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0])
          .join('')
          .toUpperCase() || 'PG';
        previewImage.replaceChildren(initials);
      }

      previewImage.classList.remove('is-loading', 'is-loaded', 'is-error');
      setColorRowVisible(false);

      if (url && validUrl(url, true)) {
        setImageStatus('loading', copy.imageLoading);
        previewImage.classList.add('is-loading');
        const image = document.createElement('img');
        image.alt = copy.imagePreviewAlt;
        image.onload = async () => {
          if (token !== state.imageLoadToken) return;

          const suggested = await averageImageColor(url);
          if (token !== state.imageLoadToken) return;

          state.suggestedColor = suggested.toUpperCase();
          if (!state.colorCustomized) {
            updateColor(state.suggestedColor);
          } else {
            updateColorUi();
          }

          previewImage.classList.remove('is-loading');
          previewImage.classList.add('is-loaded');
          setImageStatus('loaded', copy.imageLoaded);
          setColorRowVisible(true);
          renderStep();
        };
        image.onerror = () => {
          if (token !== state.imageLoadToken) return;

          previewImage.classList.remove('is-loading');
          previewImage.classList.add('is-error');
          renderInitials();
          setImageStatus('failed', copy.imageLoadError);
          setColorRowVisible(false);
          renderStep();
        };
        previewImage.append(image);
        image.src = url;
      } else {
        renderInitials();
        setImageStatus(url ? 'invalid' : 'empty', url ? copy.imageUrlError : '');
      }
    }

    function socialAssetSrc(assetName) {
      return `/discover/social-network-assets/${assetName}.png`;
    }

    function selectedSocialKeys() {
      return new Set(
        Array.from(wizardRoot.querySelectorAll('[data-social-row]')).map((row) =>
          row.getAttribute('data-social-row'),
        ),
      );
    }

    function updateSocialUi() {
      const selected = selectedSocialKeys();
      const query = socialSearch?.value.trim().toLowerCase() || '';
      let availableVisibleCount = 0;
      let filledCount = 0;

      wizardRoot.querySelectorAll('[data-social-option]').forEach((button) => {
        const value = button.getAttribute('data-social-option');
        const label = button.getAttribute('data-label') || '';
        const placeholder = button.getAttribute('data-placeholder') || '';
        const selectedAlready = selected.has(value);
        const matches = !query || `${label} ${placeholder}`.toLowerCase().includes(query);
        const visible = !selectedAlready && matches;

        button.hidden = !visible;
        button.classList.toggle('is-selected', selectedAlready);
        button.setAttribute('aria-pressed', selectedAlready ? 'true' : 'false');
        if (visible) availableVisibleCount += 1;
      });

      wizardRoot.querySelectorAll('[data-social-row]').forEach((row) => {
        const input = row.querySelector('[data-social-url]');
        const error = row.querySelector('[data-social-url-error]');
        const platform = row.getAttribute('data-social-row') || '';
        const hasValue = Boolean(input?.value.trim());
        const valid = !hasValue || validSocialValue(platform, input.value);

        row.classList.toggle('has-value', hasValue);
        row.classList.toggle('has-error', !valid);
        input?.setAttribute('aria-invalid', valid ? 'false' : 'true');
        if (error) {
          error.hidden = valid;
        }
        if (hasValue && valid) filledCount += 1;
      });

      if (socialEmptySearch) {
        socialEmptySearch.hidden = availableVisibleCount > 0;
        socialEmptySearch.textContent = selected.size === socialOptions.length
          ? copy.socialAllAdded
          : copy.socialEmptySearch;
      }

      if (socialEmptyState) {
        socialEmptyState.hidden = selected.size > 0;
      }

      if (socialCount) {
        if (filledCount === 0) {
          socialCount.textContent = selected.size > 0
            ? copy.socialSelectedEmptyLabel
            : copy.socialNoLinks;
        } else {
          socialCount.textContent = `${filledCount} ${
            filledCount === 1 ? copy.socialSelectedSingleLabel : copy.socialSelectedLabel
          }`;
        }
      }

      socialWorkbench?.classList.toggle('has-social-links', selected.size > 0);
      socialOptionGrid?.classList.toggle('is-empty', availableVisibleCount === 0);
    }

    function createSocialRow(option) {
      if (!socialList || !option || selectedSocialKeys().has(option.value)) return;

      const row = document.createElement('div');
      row.className = 'pg-social-row';
      row.setAttribute('data-social-row', option.value);

      const identity = document.createElement('div');
      identity.className = 'pg-social-row-identity';

      const icon = document.createElement('span');
      icon.className = 'pg-social-icon';
      icon.setAttribute('aria-hidden', 'true');
      const image = document.createElement('img');
      image.src = socialAssetSrc(option.assetName);
      image.alt = '';
      image.loading = 'lazy';
      icon.append(image);

      const label = document.createElement('span');
      const name = document.createElement('strong');
      name.textContent = option.label;
      const hint = document.createElement('small');
      hint.textContent = option.placeholder || copy.socialUrlPlaceholder;
      label.append(name, hint);
      identity.append(icon, label);

      const inputWrap = document.createElement('label');
      inputWrap.className = 'pg-social-url-field';
      const inputCaption = document.createElement('span');
      inputCaption.textContent = copy.socialUrlLabel;
      const input = document.createElement('input');
      input.type = option.value === 'email' ? 'text' : 'url';
      input.maxLength = 1000;
      input.placeholder = option.placeholder || copy.socialUrlPlaceholder;
      input.setAttribute('data-social-url', '');
      input.setAttribute('aria-label', option.label);
      const inputError = document.createElement('small');
      inputError.className = 'pg-social-url-error';
      inputError.setAttribute('data-social-url-error', '');
      inputError.textContent = copy.socialLinkError;
      inputError.hidden = true;
      input.addEventListener('input', () => {
        updateSocialUi();
        renderStep();
      });
      inputWrap.append(inputCaption, input, inputError);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'pg-social-remove';
      remove.setAttribute('aria-label', `${copy.socialRemoveLabel} ${option.label}`);
      const removeIcon = document.createElement('span');
      removeIcon.setAttribute('aria-hidden', 'true');
      removeIcon.textContent = 'x';
      remove.append(removeIcon);
      remove.addEventListener('click', () => {
        row.remove();
        updateSocialUi();
        renderStep();
      });

      row.append(identity, inputWrap, remove);
      socialList.append(row);
      updateSocialUi();
      renderStep();
      requestAnimationFrame(() => input.focus());
    }

    function collectSocialLinks() {
      const social = {};
      wizardRoot.querySelectorAll('[data-social-row]').forEach((row) => {
        const platform = row.getAttribute('data-social-row');
        const url = row.querySelector('[data-social-url]')?.value.trim();
        if (platform && url) {
          social[platform] = url;
        }
      });
      return Object.keys(social).length ? social : undefined;
    }

    function optionalValue(input) {
      const value = input?.value.trim();
      return value || undefined;
    }

    function buildPayload() {
      const payload = {
        kind: state.kind,
        locale,
        name: nameInput.value.trim(),
        contactEmail: contactEmail.value.trim().toLowerCase(),
        countryCode: state.countries.join(','),
        color_hex: state.color,
        websiteUrl: optionalValue(websiteUrl),
        imageUrl: optionalValue(imageUrl),
        social: collectSocialLinks(),
        startedAt: state.startedAt,
        website: form?.elements.website?.value || undefined,
        source: {
          pageUrl: window.location.href,
          referrer: document.referrer || undefined,
        },
      };

      if (locale === 'en') {
        payload.description_en = descriptionPrimary.value.trim();
        payload.description = optionalValue(descriptionAlternative);
      } else {
        payload.description = descriptionPrimary.value.trim();
        payload.description_en = optionalValue(descriptionAlternative);
      }

      if (state.kind === 'organization') {
        payload.organizationType = state.categories.organization.join(',');
        payload.is_genetic_report_provider = state.geneticReportProvider === true;
        payload.genetic_report_category =
          state.geneticReportProvider === true
            ? state.geneticReportCategory || null
            : null;
      } else {
        payload.individualType = state.categories.individual.join(',');
      }

      return payload;
    }

    async function submitWizard() {
      state.submitting = true;
      renderStep();
      setError('');

      try {
        const response = await fetch(`${sdkUrl.replace(/\/$/, '')}/discover/publisher-requests`, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify(buildPayload()),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || copy.submitError);
        }

        if (success) {
          success.hidden = false;
          requestAnimationFrame(() => {
            success.classList.add('is-visible');
          });
        }
      } catch (error) {
        setError(error instanceof Error ? error.message : copy.submitError);
      } finally {
        state.submitting = false;
        renderStep();
      }
    }

    wizardRoot.querySelectorAll('[data-kind-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.kind = button.getAttribute('data-kind-option') || 'organization';
        state.currentStep = Math.min(state.currentStep, visibleSteps().length - 1);
        wizardRoot.querySelectorAll('[data-kind-option]').forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-selected', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        setError('');
        renderStep();
      });
    });

    wizardRoot.querySelectorAll('[data-country-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleCountry(button.getAttribute('data-country-option'));
      });
    });

    wizardRoot.querySelectorAll('[data-category-option]').forEach((button) => {
      button.addEventListener('click', () => {
        toggleCategory(button.getAttribute('data-category-option'));
      });
    });

    wizardRoot.querySelectorAll('[data-provider-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.geneticReportProvider = button.getAttribute('data-provider-option') === 'true';
        setError('');
        renderStep();
      });
    });

    wizardRoot.querySelectorAll('[data-report-category-option]').forEach((button) => {
      button.addEventListener('click', () => {
        state.geneticReportCategory = button.getAttribute('data-report-category-option') || '';
        setError('');
        renderStep();
      });
    });

    countryToggle?.addEventListener('click', () => {
      if (!countryPopover) return;
      setCountryPopoverOpen(countryPopover.hidden);
    });

    document.addEventListener('click', (event) => {
      if (!countryPopover || countryPopover.hidden) return;
      const target = event.target instanceof Element ? event.target : null;
      if (!target?.closest('.pg-picker-shell')) {
        setCountryPopoverOpen(false);
      }
    });

    window.addEventListener('resize', positionCountryPopover);
    window.addEventListener('scroll', positionCountryPopover, true);

    countrySearch?.addEventListener('input', () => filterCountryOptions(countrySearch.value));
    categorySearch?.addEventListener('input', () => filterCategoryOptions(categorySearch.value));
    socialSearch?.addEventListener('input', updateSocialUi);
    wizardRoot.querySelectorAll('[data-social-option]').forEach((button) => {
      button.addEventListener('click', () => {
        const option = socialOptionsByValue.get(button.getAttribute('data-social-option'));
        createSocialRow(option);
      });
    });
    altDescriptionToggle?.addEventListener('click', () => {
      if (!altDescriptionField) return;
      altDescriptionField.hidden = false;
      if (altDescriptionOffer) {
        altDescriptionOffer.hidden = true;
      }
      altDescriptionToggle.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => descriptionAlternative?.focus());
    });
    altDescriptionRemove?.addEventListener('click', () => {
      if (!altDescriptionField) return;
      altDescriptionField.hidden = true;
      if (altDescriptionOffer) {
        altDescriptionOffer.hidden = false;
      }
      altDescriptionToggle?.setAttribute('aria-expanded', 'false');
      if (descriptionAlternative) {
        descriptionAlternative.value = '';
      }
      renderStep();
    });
    colorInput?.addEventListener('input', () => {
      state.colorCustomized = true;
      updateColor(colorInput.value);
    });
    useSuggestedColor?.addEventListener('click', () => {
      state.colorCustomized = false;
      updateColor(state.suggestedColor);
    });
    imageUrl?.addEventListener('input', () => {
      updateImagePreview();
      renderStep();
    });
    nameInput?.addEventListener('input', () => {
      if (!state.colorCustomized && !imageUrl?.value.trim()) {
        state.suggestedColor = deterministicColor(nameInput.value);
        updateColor(state.suggestedColor);
      }
      updateImagePreview();
      renderStep();
    });
    descriptionPrimary?.addEventListener('input', () => {
      pulseDescriptionWriting();
      renderStep();
    });
    [descriptionAlternative, contactEmail, websiteUrl].forEach((input) => {
      input?.addEventListener('input', () => renderStep());
    });

    nextButton?.addEventListener('click', () => {
      if (!validateCurrentStep()) return;

      const steps = visibleSteps();
      if (state.currentStep === steps.length - 1) {
        void submitWizard();
        return;
      }

      state.currentStep += 1;
      setError('');
      renderStep();
    });

    backButton?.addEventListener('click', () => {
      state.currentStep = Math.max(0, state.currentStep - 1);
      setError('');
      renderStep();
    });

    openBooking?.addEventListener('click', () => {
      if (!successBooking) return;
      successBooking.hidden = false;
      successBooking.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    renderStep();
    updateImagePreview();
  }
</script>

