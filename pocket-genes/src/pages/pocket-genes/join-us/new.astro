    function deterministicColor(seed) {
      const colors = ['#6F3CC3', '#E45080', '#14958F', '#2176AE', '#3C9B68', '#D99232'];
      let hash = 0;
      const text = seed || nameInput?.value || 'Pocket Genes';

      for (let index = 0; index < text.length; index += 1) {
        hash = (hash * 31 + text.charCodeAt(index)) % 9973;
      }

      return colors[Math.abs(hash) % colors.length];
    }

    function averageImageColor(url) {
      return new Promise((resolve) => {
        if (!url.trim()) {
          resolve(deterministicColor('Pocket Genes'));
          return;
        }

        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => {
          try {
            const canvas = document.createElement('canvas');
            const size = 24;
            canvas.width = size;
            canvas.height = size;
            const context = canvas.getContext('2d', { willReadFrequently: true });
            context.drawImage(image, 0, 0, size, size);
            const { data } = context.getImageData(0, 0, size, size);
            let r = 0;
            let g = 0;
            let b = 0;
            let count = 0;

            for (let index = 0; index < data.length; index += 4) {
              const alpha = data[index + 3];
              if (alpha < 80) continue;
              r += data[index];
              g += data[index + 1];
              b += data[index + 2];
              count += 1;
            }

            if (!count) {
              resolve(deterministicColor(url));
              return;
            }

            const hex = [r / count, g / count, b / count]
              .map((channel) => Math.max(0, Math.min(255, Math.round(channel))).toString(16).padStart(2, '0'))
              .join('');
            resolve(`#${hex}`.toUpperCase());
          } catch {
            resolve(deterministicColor(url));
          }
        };
        image.onerror = () => resolve(deterministicColor(url));
        image.src = url.trim();
      });
    }

    function updateImagePreview() {
      if (!previewImage) return;
      const rawUrl = imageUrl?.value.trim() || '';
      const normalizedImageUrl = rawUrl ? normalizedUrl(rawUrl, { httpsOnly: true }) : '';
      const previewSource = state.uploadedImageDataUrl || normalizedImageUrl;
      state.imageLoadToken += 1;
      const token = state.imageLoadToken;

      function renderInitials() {
        const initials = document.createElement('span');
        const text = nameInput?.value.trim() || 'Pocket Genes';
        initials.textContent = text
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0])
          .join('')
          .toUpperCase() || 'PG';
        previewImage.replaceChildren(initials);
      }

      previewImage.classList.remove('is-loading', 'is-loaded', 'is-error');
      setColorRowVisible(false);

      if (state.imageCompressing) {
        previewImage.classList.add('is-loading');
        previewImage.replaceChildren();
        setImageStatus('loading', copy.imageUploadCompressing);
        return;
      }

      if (previewSource) {
        setImageStatus('loading', copy.imageLoading);
        previewImage.classList.add('is-loading');
        const image = document.createElement('img');
        image.alt = copy.imagePreviewAlt;
        image.onload = async () => {
          if (token !== state.imageLoadToken) return;

          const suggested = await averageImageColor(previewSource);
          if (token !== state.imageLoadToken) return;

          state.suggestedColor = suggested.toUpperCase();
          if (!state.colorCustomized) {
            updateColor(state.suggestedColor);
          } else {
            updateColorUi();
          }

          previewImage.classList.remove('is-loading');
          previewImage.classList.add('is-loaded');
          setImageStatus(
            'loaded',
            state.uploadedImageDataUrl
              ? state.uploadedImageReadyMessage || copy.imageUploadReady
              : copy.imageLoaded,
          );
          setColorRowVisible(true);
          renderStep();
        };
        image.onerror = () => {
          if (token !== state.imageLoadToken) return;

          previewImage.classList.remove('is-loading');
          previewImage.classList.add('is-error');
          renderInitials();
          setImageStatus('failed', copy.imageLoadError);
          setColorRowVisible(false);
          renderStep();
        };
        previewImage.replaceChildren(image);
        image.src = previewSource;
      } else {
        renderInitials();
        setImageStatus(rawUrl ? 'invalid' : 'empty', rawUrl ? copy.imageUrlError : '');
      }
    }

