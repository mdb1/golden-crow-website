    countrySearch: 'Buscar países',
    countryEmpty: 'No hay países que coincidan',
    categoryTitle: 'Elegí las categorías que mejor describen tu trabajo',
    categoryBody: 'Podés elegir más de una categoría si tu trabajo cubre varias áreas.',
    categorySearch: 'Buscar categorías',
