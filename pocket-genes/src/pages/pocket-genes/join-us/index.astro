---
import PocketGenesPublicLayout from '../../../layouts/PocketGenesPublicLayout.astro';
import ClientBookingWidget from '../../../components/ClientBookingWidget.astro';
import { POCKET_GENES_EMAILS } from '../../../data/pocketGenesPublic';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const locale = isEnglish ? 'en' : 'es';

const pageCopy = {
  en: {
    title: 'Pocket Genes for Organizations | Join for free',
    description: 'Join the Pocket Genes trusted organization network for free.',
    heroTitle: 'Join our network for free.',
    heroCta: 'I want to join',
    freeBenefitsTitle: 'Everything your organization gets',
    freeBenefitsBody:
      'This is not just an organization listing. Trusted organizations can publish, participate, communicate, and remain discoverable across Pocket Genes.',
    freeBenefits: [
      {
        icon: 'profile',
        title: 'Trusted profile',
        body: 'Present your organization, mission, services, and resources.',
        qualifier: '',
      },
      {
        icon: 'news',
        title: 'News and updates',
        body: 'Publish curated news, educational content, and organizational updates.',
        qualifier: 'Up to five curated posts per week.',
      },
      {
        icon: 'events',
        title: 'Events',
        body: 'Promote conferences, workshops, webinars, meetings, and community events.',
        qualifier: '',
      },
      {
        icon: 'services',
        title: 'Professional services',
        body: 'Make relevant professional services easier for users to find.',
        qualifier: '',
      },
      {
        icon: 'opportunities',
        title: 'Opportunities',
        body: 'Share research, employment, education, collaboration, and support opportunities.',
        qualifier: '',
      },
      {
        icon: 'community',
        title: 'Community participation',
        body: 'Join conversations and respond when users mention or tag your organization.',
        qualifier: '',
      },
      {
        icon: 'circles',
        title: 'Closed circles',
        body: 'Create focused spaces for programs, communities, professionals, or report recipients.',
        qualifier: '',
      },
      {
        icon: 'communication',
        title: 'Ongoing communication',
        body: 'Maintain a direct channel with the people who follow and interact with your organization.',
        qualifier: '',
      },
      {
        icon: 'discovery',
        title: 'Relevant discovery',
        body:
          'Reach users looking for paid services, screening reports or guidance on their next step.',
        qualifier: '',
      },
    ],
    freeBenefitsStatement: 'All of this is available at no cost to approved trusted organizations.',
    contactEyebrow: 'Still have questions?',
    contactTitle: "Let's talk.",
    contactBody:
      'Write to us about joining the trusted network, report delivery, privacy, security, accessibility, or anything you want to clarify before moving forward.',
    primaryInbox: 'Talk with Pocket Genes',
    copyEmail: 'Copy email',
    copied: 'Copied',
    contactTopicsLabel: 'Questions we can help with',
    contactRoutes: [
      {
        title: 'Trusted organization',
        body: 'Ask about review fit, publishing standards, and joining the free trusted network.',
        tone: 'teal',
      },
      {
        title: 'Report delivery',
        body: 'Discuss delivery requirements, expected volume, implementation, or next steps.',
        tone: 'rose',
      },
      {
        title: 'Platform standards',
        body: 'Clarify privacy, security, accessibility, data handling, or incident-reporting questions.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'I want to be a trusted organization',
    bookingTitle: 'Book a call\nwith us.',
    bookingBody:
      'If your organization supports genetics, rare disease, patient advocacy, education, care navigation, or simply offers genetic screening services, schedule a meeting with us. Let\'s explore together how your posts and events could be featured in Pocket Genes. We’d love to hear from you.',
  },
  es: {
    title: 'Pocket Genes para organizaciones | Sumate gratis',
    description: 'Sumá tu organización gratis a la red de confianza de Pocket Genes.',
    heroTitle: 'Sumate gratis a nuestra red.',
    heroCta: 'Quiero ser parte',
    freeBenefitsTitle: 'Todo lo que podés hacer siendo parte',
    freeBenefitsBody:
      'Pocket Genes no es simplemente un directorio. Tu organización y vos pueden compartir información útil, interactuar mediante la plataforma, mantenerte enterado de eventos y novedades y llevar un vínculo activo con otros actores importantes del rubro. Sé parte de nuestra comunidad totalmente gratis, ¡no tenés nada que perder!',
    freeBenefits: [
      {
        icon: 'profile',
        title: 'Perfil de organización',
        body: 'Presentá la misión, los servicios y los recursos de tu organización.',
        qualifier: '',
      },
      {
        icon: 'news',
        title: 'Noticias y contenidos',
        body: 'Compartí noticias relevantes, contenido educativo y novedades de tu organización.',
        qualifier: 'Hasta cinco publicaciones por semana.',
      },
      {
        icon: 'events',
        title: 'Eventos',
        body: 'Difundí conferencias, talleres, encuentros virtuales y actividades para la comunidad.',
        qualifier: '',
      },
      {
        icon: 'services',
        title: 'Servicios profesionales',
        body: 'Mostrá tus servicios para que las personas que los necesitan puedan encontrarlos.',
        qualifier: '',
      },
      {
        icon: 'opportunities',
        title: 'Oportunidades',
        body: 'Difundí oportunidades de investigación, trabajo, educación, colaboración y apoyo.',
        qualifier: '',
      },
      {
        icon: 'community',
        title: 'Participación en la comunidad',
        body: 'Participá en conversaciones y respondé cuando alguien mencione o etiquete a tu organización.',
        qualifier: '',
      },
      {
        icon: 'circles',
        title: 'Círculos privados',
        body: 'Creá espacios específicos para programas, comunidades, profesionales o personas que recibieron un informe.',
        qualifier: '',
      },
      {
        icon: 'communication',
        title: 'Contacto directo',
        body: 'Mantenete en contacto con las personas que siguen o interactúan con tu organización.',
        qualifier: '',
      },
      {
        icon: 'discovery',
        title: 'Más oportunidades de ser encontrada',
        body:
          'Tu organización podrá aparecer cuando alguien busque servicios pagos, estudios genéticos u orientación para decidir qué hacer después.',
        qualifier: '',
      },
    ],
    freeBenefitsStatement: 'Todo esto es gratuito para las organizaciones aprobadas.',
    contactEyebrow: '¿Todavía tenés preguntas?',
    contactTitle: 'Hablemos.',
    contactBody:
      'Escribinos para conversar sobre la red de organizaciones, la entrega de informes, la privacidad, la seguridad o cualquier duda que quieras resolver antes de avanzar.',
    primaryInbox: 'Escribinos',
    copyEmail: 'Copiar correo',
    copied: 'Copiado',
    contactTopicsLabel: 'Temas sobre los que podemos ayudarte',
    contactRoutes: [
      {
        title: 'Organizaciones de confianza',
        body: 'Preguntanos cómo evaluamos a cada organización, qué esperamos de sus publicaciones y cómo sumarte gratis.',
        tone: 'teal',
      },
      {
        title: 'Entrega de informes',
        body: 'Contanos qué tipo de informes entregás y conversemos sobre volumen, implementación y próximos pasos.',
        tone: 'rose',
      },
      {
        title: 'Privacidad y seguridad',
        body: 'Consultanos sobre privacidad, seguridad, accesibilidad, uso de datos o cómo informar un incidente.',
        tone: 'blue',
      },
    ],
    bookingEyebrow: 'Sumá tu organización',
    bookingTitle: 'Agendá una llamada con nosotros.',
    bookingBody:
      'Una vez aprobada, tu organización puede crear su perfil, compartir contenido y eventos, participar en la comunidad y mantenerse en contacto con las personas que la siguen. Todo sin pagar por formar parte de la plataforma.',
  },
} as const;

const copy = pageCopy[locale];
const trustMailSubject = encodeURIComponent(
  isEnglish ? 'Question for Pocket Genes' : 'Consulta para Pocket Genes',
);
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/join-us"
>
  <main id="main" class="pg-page pg-trust-page">
    <section class="pg-trust-hero pg-pricing-hero">
      <div class="pg-container pg-trust-hero-grid">
        <div class="pg-hero-copy">
          <h1>{copy.heroTitle}</h1>
          <a class="pg-hero-cta" href="#trusted-organization-meeting">{copy.heroCta}</a>
        </div>
      </div>
    </section>

    <div class="pg-join-shared-band">
      <section id="free-benefits" class="pg-section pg-free-benefits" aria-labelledby="free-benefits-title">
        <div class="pg-container">
          <div class="pg-section-heading">
            <h2 id="free-benefits-title">{copy.freeBenefitsTitle}</h2>
            <p>
              {copy.freeBenefitsBody}
            </p>
          </div>

          <div class="pg-benefits-package">
            <div class="pg-benefits-grid">
              {copy.freeBenefits.map((benefit) => (
                <article class="pg-benefit-item">
                  <span class={`pg-benefit-icon icon-${benefit.icon}`} aria-hidden="true"></span>
                  <div>
                    <h3>{benefit.title}</h3>
                    <p>{benefit.body}</p>
                    {benefit.qualifier && <small>{benefit.qualifier}</small>}
                  </div>
                </article>
              ))}
            </div>

            <div class="pg-benefits-close">
              <p>{copy.freeBenefitsStatement}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="pg-section-tight pg-trust-contact" aria-labelledby="pg-trust-contact-title">
        <div class="pg-container">
          <div class="pg-trust-contact-band">
            <div class="pg-contact-main">
              <p class="pg-eyebrow">{copy.contactEyebrow}</p>
              <h2 id="pg-trust-contact-title">{copy.contactTitle}</h2>
              <p>
                {copy.contactBody}
              </p>
            </div>
            <div class="pg-contact-panel">
              <div class="pg-contact-actions">
                <a class="pg-contact-email" href={`mailto:${POCKET_GENES_EMAILS.hello}?subject=${trustMailSubject}`}>
                  <span>{copy.primaryInbox}</span>
                  <strong>{POCKET_GENES_EMAILS.hello}</strong>
                </a>
                <button class="pg-contact-copy-button" type="button" data-copy-email={POCKET_GENES_EMAILS.hello} data-copy-label={copy.copyEmail} data-copied-label={copy.copied}>
                  {copy.copyEmail}
                </button>
              </div>
              <div class="pg-contact-route-grid" aria-label={copy.contactTopicsLabel}>
                {copy.contactRoutes.map((route) => (
                  <article class={`pg-contact-route tone-${route.tone}`}>
                    <span class="pg-route-marker" aria-hidden="true"></span>
                    <div>
                      <h3>{route.title}</h3>
                      <p>{route.body}</p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section id="trusted-organization-meeting" class="pg-section pg-trusted-booking">
      <div class="pg-container pg-trusted-booking-grid">
        <div>
          <p class="pg-eyebrow">{copy.bookingEyebrow}</p>
          <h2>{copy.bookingTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
          <p>
            {copy.bookingBody}
          </p>
        </div>
        <div class="pg-trusted-calendar-wrapper">
          <ClientBookingWidget context="pocket-genes-join-us" />
        </div>
      </div>
    </section>
    <script>
      const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

      copyEmailButtons.forEach((button) => {
        const originalText = button.textContent?.trim() || button.getAttribute('data-copy-label') || '';
        const copiedText = button.getAttribute('data-copied-label') || originalText;
        const email = button.getAttribute('data-copy-email');

        button.addEventListener('click', async () => {
          if (!email || !navigator.clipboard) return;

          try {
            await navigator.clipboard.writeText(email);
            button.textContent = copiedText;
            window.setTimeout(() => {
              button.textContent = originalText;
            }, 1800);
          } catch {
            button.textContent = originalText;
          }
        });
      });
    </script>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-pricing-hero {
    position: relative;
    isolation: isolate;
    min-height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding: 124px 0 8px;
    background: #ffffff;
    color: var(--pg-ink);
  }

  .pg-pricing-hero::before,
  .pg-pricing-hero::after {
    content: none;
  }

  .pg-trust-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    justify-items: center;
    text-align: center;
  }

  .pg-hero-copy {
    display: flex;
    max-width: 1040px;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    text-align: center;
  }

  .pg-pricing-hero h1 {
    margin: 0;
    max-width: 980px;
    font-size: 5.75rem;
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .pg-hero-cta {
    display: inline-flex;
    min-height: 72px;
    align-items: center;
    justify-content: center;
    margin-top: 64px;
    border-radius: 999px;
    padding: 0 48px;
    background: #2d7edc;
    color: #ffffff;
    font-size: 1.45rem;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 18px 38px rgba(33, 118, 174, 0.28), 0 7px 18px rgba(41, 49, 139, 0.14);
    transition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .pg-hero-cta:hover {
    background: #3389ed;
    box-shadow: 0 24px 48px rgba(33, 118, 174, 0.34), 0 10px 22px rgba(41, 49, 139, 0.16);
    transform: translateY(-2px);
  }

  .pg-join-shared-band {
    --pg-join-blue-background:
      linear-gradient(116deg, transparent 0 34%, rgba(255, 255, 255, 0.08) 34% 35%, transparent 35% 54%, rgba(125, 228, 215, 0.1) 54% 55%, transparent 55%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 92px),
      linear-gradient(132deg, #141a45 0%, #172033 42%, #29318b 67%, #0d6d70 100%),
      linear-gradient(90deg, rgba(228, 80, 128, 0.28), rgba(20, 149, 143, 0.2));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--pg-join-blue-background);
    color: #ffffff;
  }

  .pg-join-shared-band::before {
    content: "";
    position: absolute;
    top: -54px;
    left: 50%;
    z-index: 0;
    width: 118%;
    height: 108px;
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    background: #ffffff;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .pg-join-shared-band > section {
    position: relative;
    z-index: 1;
  }

  .pg-free-benefits {
    padding-top: 168px;
  }

  .pg-free-benefits::before {
    content: none;
  }

  .pg-free-benefits > .pg-container {
    position: relative;
    z-index: 1;
  }

  .pg-free-benefits .pg-section-heading h2 {
    color: #ffffff;
  }

  .pg-free-benefits .pg-section-heading p {
    color: rgba(255, 255, 255, 0.76);
  }

  .pg-benefits-package {
    border-top: 4px solid transparent;
    background: transparent;
    padding: 28px 0 0;
  }

  .pg-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .pg-benefit-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 14px;
    min-height: 150px;
    border-top: 1px solid transparent;
    padding: 22px 20px;
  }

  .pg-benefit-item:nth-child(3n + 2),
  .pg-benefit-item:nth-child(3n + 3) {
    border-left: 1px solid transparent;
  }

  .pg-benefit-icon {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: #eef8f7;
    color: var(--pg-teal);
  }

  .pg-benefit-icon::before,
  .pg-benefit-icon::after {
    content: "";
    position: absolute;
    background: currentColor;
  }

  .icon-profile {
    color: var(--pg-teal);
  }

  .icon-profile::before {
    width: 12px;
    height: 12px;
    top: 10px;
    left: 15px;
    border-radius: 999px;
  }

  .icon-profile::after {
    width: 22px;
    height: 10px;
    left: 10px;
    bottom: 9px;
    border-radius: 999px 999px 4px 4px;
  }

  .icon-news {
    color: var(--pg-rose);
  }

  .icon-news::before {
    width: 20px;
    height: 16px;
    left: 11px;
    top: 13px;
    border-radius: 3px;
  }

  .icon-news::after {
    width: 12px;
    height: 2px;
    left: 15px;
    top: 19px;
    box-shadow: 0 5px 0 currentColor;
    background: #ffffff;
  }

  .icon-events {
    color: var(--pg-blue);
  }

  .icon-events::before {
    width: 22px;
    height: 20px;
    left: 10px;
    top: 12px;
    border-radius: 4px;
  }

  .icon-events::after {
    width: 22px;
    height: 4px;
    left: 10px;
    top: 16px;
    background: #ffffff;
  }

  .icon-services {
    color: #29318b;
  }

  .icon-services::before {
    width: 22px;
    height: 16px;
    left: 10px;
    top: 14px;
    border-radius: 5px;
  }

  .icon-services::after {
    width: 10px;
    height: 3px;
    left: 16px;
    top: 10px;
    border-radius: 999px;
  }

  .icon-opportunities {
    color: #d99232;
  }

  .icon-opportunities::before {
    width: 10px;
    height: 20px;
    left: 16px;
    top: 11px;
    border-radius: 999px;
  }

  .icon-opportunities::after {
    width: 20px;
    height: 10px;
    left: 11px;
    top: 16px;
    border-radius: 999px;
  }

  .icon-community {
    color: #3c9b68;
  }

  .icon-community::before {
    width: 14px;
    height: 14px;
    left: 8px;
    top: 12px;
    border-radius: 999px;
    box-shadow: 13px 0 0 currentColor;
  }

  .icon-community::after {
    width: 28px;
    height: 8px;
    left: 7px;
    bottom: 8px;
    border-radius: 999px 999px 4px 4px;
  }

  .icon-circles {
    color: var(--pg-teal);
  }

  .icon-circles::before {
    width: 24px;
    height: 24px;
    left: 9px;
    top: 9px;
    border: 4px solid currentColor;
    border-radius: 999px;
    background: transparent;
  }

  .icon-circles::after {
    width: 12px;
    height: 12px;
    right: 8px;
    bottom: 8px;
    border: 3px solid currentColor;
    border-radius: 999px;
    background: #eef8f7;
  }

  .icon-communication {
    color: var(--pg-rose);
  }

  .icon-communication::before {
    width: 24px;
    height: 17px;
    left: 9px;
    top: 12px;
    border-radius: 4px;
  }

  .icon-communication::after {
    width: 9px;
    height: 9px;
    left: 16px;
    bottom: 9px;
    transform: rotate(45deg);
  }

  .icon-discovery {
    color: var(--pg-blue);
  }

  .icon-discovery::before {
    width: 18px;
    height: 18px;
    left: 9px;
    top: 9px;
    border: 4px solid currentColor;
    border-radius: 999px;
    background: transparent;
  }

  .icon-discovery::after {
    width: 14px;
    height: 4px;
    right: 9px;
    bottom: 11px;
    border-radius: 999px;
    transform: rotate(45deg);
  }

  .pg-benefit-item h3 {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .pg-benefit-item p {
    margin: 7px 0 0;
    color: rgba(255, 255, 255, 0.76);
  }

  .pg-benefit-item small {
    display: block;
    margin-top: 7px;
    color: #7de4d7;
    font-size: 0.82rem;
    font-weight: 760;
  }

  .pg-benefits-close {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid transparent;
    padding: 22px 20px 0;
  }

  .pg-benefits-close p {
    max-width: 640px;
    margin: 0;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 850;
  }

  .pg-trust-contact {
    margin-top: -1px;
    color: #ffffff;
  }

  .pg-trust-contact-band {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(24px, 4vw, 46px);
    align-items: center;
    min-height: 330px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    padding: clamp(26px, 5vw, 54px);
    color: #ffffff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .pg-trust-contact-band::before,
  .pg-trust-contact-band::after {
    content: none;
  }

  .pg-contact-main,
  .pg-contact-panel {
    position: relative;
    z-index: 1;
  }

  .pg-trust-contact .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-trust-contact h2 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(2.25rem, 4.5vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-contact-main p:not(.pg-eyebrow) {
    max-width: 520px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.08rem;
  }

  .pg-contact-panel {
    display: grid;
    gap: 16px;
  }

  .pg-contact-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: stretch;
  }

  .pg-contact-email,
  .pg-contact-copy-button,
  .pg-contact-route {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: none;
  }

  .pg-contact-email {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 16px 18px;
    color: #ffffff;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .pg-contact-email:hover {
    transform: translateY(-3px);
    border-color: rgba(125, 228, 215, 0.62);
    background: rgba(255, 255, 255, 0.15);
  }

  .pg-contact-email span {
    color: #7de4d7;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pg-contact-email strong {
    overflow-wrap: anywhere;
