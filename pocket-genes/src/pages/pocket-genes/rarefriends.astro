---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';
import { formatBrandText } from '../../utils/brandFormatting';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const pageCopy = {
  en: {
    title: 'RareFriends™ by Pocket Genes',
    description: 'RareFriends™ by Pocket Genes is the opt-in community layer connected to Pocket Genes.',
    heroEyebrow: 'Community layer',
    heroBody:
      'A careful peer-support layer for the moment after genetic results arrive. RareFriends™ helps you find people, organizations, events, resources, and updates that are relevant to your genetic context without making your private report public by default.',
    downloadCta: 'Download the app',
    joinUsCta: 'Join us',
    imageAlt: 'Pocket Genes RareFriends™ community screen',
    howEyebrow: 'How community works',
    howTitle: 'Find people and groups that match your rare-disease journey.',
    howBody:
      'More people are receiving genetic results, but the path after the report can still feel fragmented. RareFriends™ by Pocket Genes can use information you choose to add, such as gene, condition family, symptoms, role, language, country, and journey stage. Those fields can reveal health or genetic context, so participation is opt-in and separate from private report access.',
    principles: [
      {
        title: 'People who fit your context',
        body: 'Find support using optional profile fields such as gene, condition family, symptoms, role, country, language, or journey stage, even when the exact match is not obvious yet.',
      },
      {
        title: 'Organizations and events',
        body: 'Follow verified organizations, webinars, support programs, and events that can help after a confusing result, not just during the test itself.',
      },
      {
        title: 'Practical next steps',
        body: 'Move from result to understanding to a saved appointment question, resource, event, or learning module.',
      },
      {
        title: 'Emotional and practical support',
        body: 'A rare journey can feel isolating. The goal is useful responses, daily-living support, and shared experience.',
      },
      {
        title: 'Pseudonymous participation',
        body: 'Participate without exposing a full identity, exact variant, or original report.',
      },
      {
        title: 'Moderated safety',
        body: 'Clear rules, reporting, blocking, and moderation help prevent misinformation, pressure, and re-identification.',
      },
    ],
    matchingEyebrow: 'Layered matching',
    matchingTitle: 'You do not need an exact diagnosis match to find useful support.',
    matchingBody:
      'The post-result journey is rarely linear. Someone might belong to an exact-gene circle, a broader condition family, a caregiver circle, a regional group, and a newly diagnosed journey at the same time. Private reports stay separate unless the person chooses to share specific information.',
    matchingLayers: [
      'Exact gene',
      'Condition or disease family',
      'Symptoms or diagnostic journey',
      'Patient, parent, caregiver, or learner role',
      'Country, language, and local resources',
      'Newly diagnosed, undiagnosed, or long-term management stage',
    ],
    trustEyebrow: 'Trust first',
    trustTitle: 'Community works best when usefulness, moderation, and trust come first.',
    trustBody:
      'A meaningful next step can be understanding a report section, getting a useful answer, following a trusted organization, registering for an event, or preparing a better appointment question.',
    trustCta: 'Open Trust Center',
  },
  es: {
    title: 'RareFriends™ by Pocket Genes',
    description: 'RareFriends™ de Pocket Genes es la comunidad para encontrar personas, organizaciones y recursos relacionados con tu experiencia genética.',
    heroEyebrow: 'Comunidad y apoyo',
    heroBody:
      'RareFriends™ es la comunidad de Pocket Genes. Encontrá personas, organizaciones, eventos y recursos relacionados con tu experiencia genética, aunque no compartan exactamente el mismo diagnóstico. Tu informe permanece privado y vos decidís qué información compartir.',
    downloadCta: 'Descargar la app',
    joinUsCta: 'Sumate',
    imageAlt: 'Pantalla de comunidad RareFriends™ en Pocket Genes',
    howEyebrow: 'Cómo funciona',
    howTitle: 'Encontrá personas y recursos relacionados con tu experiencia.',
    howBody:
      'Después de recibir un resultado genético, es normal tener preguntas y no saber con quién hablar. RareFriends™ de Pocket Genes puede usar información que vos decidís agregar, como gen, grupo de condición, síntomas, rol, idioma, país y etapa del recorrido. Esos campos pueden revelar contexto de salud o genético, por eso la participación es voluntaria y separada del acceso privado a informes.',
    principles: [
      {
        title: 'Personas con experiencias similares',
        body: 'Conectá usando campos opcionales como gen, grupo de condición, síntomas, rol, país, idioma o etapa del recorrido.',
      },
      {
        title: 'Organizaciones y eventos',
        body: 'Seguí organizaciones de confianza y encontrá charlas, programas de apoyo y eventos que puedan ayudarte después de recibir un resultado.',
      },
      {
        title: 'Próximos pasos concretos',
        body: 'Prepará tus preguntas, guardá recursos útiles y organizá próximos pasos para decidir qué hacer después.',
      },
      {
        title: 'Apoyo entre personas',
        body: 'Hablar con personas que pasaron por situaciones similares puede aportar contexto, ideas y apoyo práctico.',
      },
      {
        title: 'Vos decidís qué compartir',
        body: 'Compartí solo lo que elijas. No necesitás mostrar tu identidad completa ni publicar tu informe original.',
      },
      {
        title: 'Moderación y seguridad',
        body: 'Las reglas de la comunidad, las denuncias, los bloqueos y la moderación ayudan a reducir la desinformación, el acoso y los intentos de obtener datos personales.',
      },
    ],
    matchingEyebrow: 'Distintas formas de encontrar apoyo',
    matchingTitle: 'No necesitás un diagnóstico exacto para encontrar apoyo útil.',
    matchingBody:
      'No todas las conexiones nacen de compartir exactamente el mismo diagnóstico. También podés encontrar apoyo por síntomas, experiencias, idioma, ubicación o intereses comunes. Tus informes privados se mantienen separados salvo que decidas compartir información específica.',
    matchingLayers: [
      'Gen relacionado',
      'Condición o grupo de condiciones relacionadas',
      'Síntomas o proceso de diagnóstico',
      'Persona afectada, familiar, cuidador o alguien que busca aprender',
      'País, idioma y recursos disponibles en tu región',
      'Diagnóstico reciente, búsqueda de diagnóstico o seguimiento a largo plazo',
    ],
    trustEyebrow: 'Seguridad y confianza',
    trustTitle: 'Una comunidad segura necesita reglas claras, moderación y fuentes confiables.',
    trustBody:
      'RareFriends™ te ayuda a convertir un resultado en algo útil: una explicación clara, una pregunta para tu próxima consulta, un recurso, un evento o una organización confiable. Las experiencias de la comunidad pueden ayudarte a informarte y preparar preguntas, pero no reemplazan el asesoramiento de un profesional de la salud.',
    trustCta: 'Abrir Centro de confianza',
  },
} as const;

const copy = pageCopy[isEnglish ? 'en' : 'es'];
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/rarefriends"
>
  <main id="main" class="pg-page pg-rf-page">
    <section class="pg-rf-hero">
      <div class="pg-container pg-rf-hero-grid">
        <div>
          <p class="pg-eyebrow" set:html={formatBrandText(copy.heroEyebrow)} />
          <h1><em>RareFriends™</em> by Pocket Genes</h1>
          <p set:html={formatBrandText(copy.heroBody)} />
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={localizePath('/pocket-genes/download')}>{copy.downloadCta}</a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/join-us')}>{copy.joinUsCta}</a>
          </div>
        </div>
        <figure class="pg-rf-visual">
          <img src="/pocket-genes/screenshots/sample_rare_friends.PNG" alt={copy.imageAlt} fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow" set:html={formatBrandText(copy.howEyebrow)} />
          <h2 set:html={formatBrandText(copy.howTitle)} />
          <p set:html={formatBrandText(copy.howBody)} />
        </div>
        <div class="pg-card-grid pg-rf-grid">
          {copy.principles.map((principle) => (
            <article class="pg-card">
              <h3 set:html={formatBrandText(principle.title)} />
              <p set:html={formatBrandText(principle.body)} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-rf-matching">
      <div class="pg-container pg-rf-matching-grid">
        <div class="pg-section-heading">
          <p class="pg-eyebrow" set:html={formatBrandText(copy.matchingEyebrow)} />
          <h2 set:html={formatBrandText(copy.matchingTitle)} />
          <p set:html={formatBrandText(copy.matchingBody)} />
        </div>
        <div class="pg-match-list">
          {copy.matchingLayers.map((layer) => (
            <article>
              <span></span>
              <strong set:html={formatBrandText(layer)} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-rf-band-section">
      <div class="pg-container pg-rf-band">
        <div>
          <p class="pg-eyebrow" set:html={formatBrandText(copy.trustEyebrow)} />
          <h2 set:html={formatBrandText(copy.trustTitle)} />
          <p set:html={formatBrandText(copy.trustBody)} />
        </div>
        <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>{copy.trustCta}</a>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-rf-hero {
    min-height: 680px;
    display: flex;
    align-items: center;
    padding: 112px 0 60px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.72)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
    overflow: hidden;
  }

  .pg-rf-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 0.75fr);
    gap: 48px;
    align-items: center;
  }

  .pg-rf-hero h1 {
    margin: 0;
    max-width: 780px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-rf-hero p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-rf-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-rf-hero .pg-button-row {
    margin-top: 26px;
  }

  .pg-rf-visual {
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .pg-rf-visual img {
    width: 270px;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-rf-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pg-rf-matching {
    background: #eef5f7;
  }

  .pg-rf-matching-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(360px, 1.14fr);
    gap: 36px;
    align-items: start;
  }

  .pg-match-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .pg-match-list article {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    padding: 16px;
  }

  .pg-match-list span {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--pg-teal);
    flex: 0 0 auto;
  }

  .pg-match-list strong {
    line-height: 1.25;
  }

  .pg-rf-band-section {
    background: #ffffff;
  }

  .pg-rf-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 28px;
  }

  .pg-rf-band h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-rf-band p {
    margin: 12px 0 0;
    color: var(--pg-ink-soft);
  }

  @media (max-width: 980px) {
    .pg-rf-hero-grid,
    .pg-rf-band,
    .pg-rf-matching-grid {
      grid-template-columns: 1fr;
    }

    .pg-rf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pg-rf-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-rf-hero h1 {
      font-size: 2.8rem;
    }

    .pg-rf-grid {
      grid-template-columns: 1fr;
    }

    .pg-match-list {
      grid-template-columns: 1fr;
    }
  }
</style>
