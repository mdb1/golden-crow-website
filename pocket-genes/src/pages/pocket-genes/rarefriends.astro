---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const principles = [
  {
    title: 'People who fit your context',
    body: 'Find support by same gene, condition, symptom family, role, country, language, or journey stage, even when the exact match is not obvious yet.',
  },
  {
    title: 'Organizations and events',
    body: 'Follow verified organizations, webinars, support programs, and events that can help after a confusing result, not just during the test itself.',
  },
  {
    title: 'Practical next steps',
    body: 'Move from result to understanding to a saved appointment question, resource, event, or learning module.',
  },
  {
    title: 'Emotional and practical support',
    body: 'A rare journey can feel isolating. The goal is useful responses, daily-living support, and shared experience.',
  },
  {
    title: 'Pseudonymous participation',
    body: 'Participate without exposing a full identity, exact variant, or original report.',
  },
  {
    title: 'Moderated safety',
    body: 'Clear rules, reporting, blocking, and moderation help prevent misinformation, pressure, and re-identification.',
  },
];

const matchingLayers = [
  'Exact gene',
  'Condition or disease family',
  'Symptoms or diagnostic journey',
  'Patient, parent, caregiver, or learner role',
  'Country, language, and local resources',
  'Newly diagnosed, undiagnosed, or long-term management stage',
];
---

<PocketGenesPublicLayout
  title="RareFriends by Pocket Genes"
  description="RareFriends by Pocket Genes is the opt-in community layer connected to Pocket Genes."
  canonicalPath="/pocket-genes/rarefriends"
  image="/pocket-genes/screenshots/sample_rare_friends.PNG"
>
  <main id="main" class="pg-page pg-rf-page">
    <section class="pg-rf-hero">
      <div class="pg-container pg-rf-hero-grid">
        <div>
          <p class="pg-eyebrow">Community layer</p>
          <h1>RareFriends by Pocket Genes</h1>
          <p>
            A careful peer-support layer for the moment after genetic results arrive. RareFriends helps you find people, organizations, events, resources, and updates that are relevant to your genetic context without making your private report public by default.
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={localizePath('/pocket-genes/trust-center/community-terms')}>Community terms</a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center/community-safety-policy')}>Safety policy</a>
          </div>
        </div>
        <figure class="pg-rf-visual">
          <img src="/pocket-genes/screenshots/sample_rare_friends.PNG" alt="Pocket Genes RareFriends community screen" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">How community works</p>
          <h2>Find people and groups that match your rare-disease journey.</h2>
          <p>
            More people are receiving genetic results, but the path after the report can still feel fragmented. RareFriends by Pocket Genes can match by gene, condition family, symptoms, role, language, country, and journey stage, so support is still useful when an exact-gene circle is quiet.
          </p>
        </div>
        <div class="pg-card-grid pg-rf-grid">
          {principles.map((principle) => (
            <article class="pg-card">
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-rf-matching">
      <div class="pg-container pg-rf-matching-grid">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">Layered matching</p>
          <h2>You do not need an exact diagnosis match to find useful support.</h2>
          <p>
            The post-result journey is rarely linear. Someone might belong to an exact-gene circle, a broader condition family, a caregiver circle, a regional group, and a newly diagnosed journey at the same time.
          </p>
        </div>
        <div class="pg-match-list">
          {matchingLayers.map((layer) => (
            <article>
              <span></span>
              <strong>{layer}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-rf-band-section">
      <div class="pg-container pg-rf-band">
        <div>
          <p class="pg-eyebrow">Trust first</p>
          <h2>Community works best when usefulness, moderation, and trust come first.</h2>
          <p>
            A meaningful next step can be understanding a report section, getting a useful answer, following a trusted organization, registering for an event, or preparing a better appointment question.
          </p>
        </div>
        <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>Open Trust Center</a>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-rf-hero {
    min-height: 680px;
    display: flex;
    align-items: center;
    padding: 112px 0 60px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.72)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
    overflow: hidden;
  }

  .pg-rf-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 0.75fr);
    gap: 48px;
    align-items: center;
  }

  .pg-rf-hero h1 {
    margin: 0;
    max-width: 780px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-rf-hero p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-rf-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-rf-hero .pg-button-row {
    margin-top: 26px;
  }

  .pg-rf-visual {
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .pg-rf-visual img {
    width: 270px;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-rf-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pg-rf-matching {
    background: #eef5f7;
  }

  .pg-rf-matching-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(360px, 1.14fr);
    gap: 36px;
    align-items: start;
  }

  .pg-match-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .pg-match-list article {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    padding: 16px;
  }

  .pg-match-list span {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--pg-teal);
    flex: 0 0 auto;
  }

  .pg-match-list strong {
    line-height: 1.25;
  }

  .pg-rf-band-section {
    background: #ffffff;
  }

  .pg-rf-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 28px;
  }

  .pg-rf-band h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-rf-band p {
    margin: 12px 0 0;
    color: var(--pg-ink-soft);
  }

  @media (max-width: 980px) {
    .pg-rf-hero-grid,
    .pg-rf-band,
    .pg-rf-matching-grid {
      grid-template-columns: 1fr;
    }

    .pg-rf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pg-rf-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-rf-hero h1 {
      font-size: 2.8rem;
    }

    .pg-rf-grid {
      grid-template-columns: 1fr;
    }

    .pg-match-list {
      grid-template-columns: 1fr;
    }
  }
</style>
