---
import PocketGenesPublicLayout from '../../layouts/PocketGenesPublicLayout.astro';

const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const localizePath = (path: string) => (isEnglish ? `/en${path}` : path);

const pageCopy = {
  en: {
    title: 'RareFriends by Pocket Genes',
    description: 'RareFriends by Pocket Genes is the opt-in community layer connected to Pocket Genes.',
    heroEyebrow: 'Community layer',
    heroTitle: 'RareFriends by Pocket Genes',
    heroBody:
      'A careful peer-support layer for the moment after genetic results arrive. RareFriends helps you find people, organizations, events, resources, and updates that are relevant to your genetic context without making your private report public by default.',
    communityTerms: 'Community terms',
    safetyPolicy: 'Safety policy',
    imageAlt: 'Pocket Genes RareFriends community screen',
    howEyebrow: 'How community works',
    howTitle: 'Find people and groups that match your rare-disease journey.',
    howBody:
      'More people are receiving genetic results, but the path after the report can still feel fragmented. RareFriends by Pocket Genes can match by gene, condition family, symptoms, role, language, country, and journey stage, so support is still useful when an exact-gene circle is quiet.',
    principles: [
      {
        title: 'People who fit your context',
        body: 'Find support by same gene, condition, symptom family, role, country, language, or journey stage, even when the exact match is not obvious yet.',
      },
      {
        title: 'Organizations and events',
        body: 'Follow verified organizations, webinars, support programs, and events that can help after a confusing result, not just during the test itself.',
      },
      {
        title: 'Practical next steps',
        body: 'Move from result to understanding to a saved appointment question, resource, event, or learning module.',
      },
      {
        title: 'Emotional and practical support',
        body: 'A rare journey can feel isolating. The goal is useful responses, daily-living support, and shared experience.',
      },
      {
        title: 'Pseudonymous participation',
        body: 'Participate without exposing a full identity, exact variant, or original report.',
      },
      {
        title: 'Moderated safety',
        body: 'Clear rules, reporting, blocking, and moderation help prevent misinformation, pressure, and re-identification.',
      },
    ],
    matchingEyebrow: 'Layered matching',
    matchingTitle: 'You do not need an exact diagnosis match to find useful support.',
    matchingBody:
      'The post-result journey is rarely linear. Someone might belong to an exact-gene circle, a broader condition family, a caregiver circle, a regional group, and a newly diagnosed journey at the same time.',
    matchingLayers: [
      'Exact gene',
      'Condition or disease family',
      'Symptoms or diagnostic journey',
      'Patient, parent, caregiver, or learner role',
      'Country, language, and local resources',
      'Newly diagnosed, undiagnosed, or long-term management stage',
    ],
    trustEyebrow: 'Trust first',
    trustTitle: 'Community works best when usefulness, moderation, and trust come first.',
    trustBody:
      'A meaningful next step can be understanding a report section, getting a useful answer, following a trusted organization, registering for an event, or preparing a better appointment question.',
    trustCta: 'Open Trust Center',
  },
  es: {
    title: 'RareFriends by Pocket Genes',
    description: 'RareFriends by Pocket Genes es la capa comunitaria opcional conectada a Pocket Genes.',
    heroEyebrow: 'Capa comunitaria',
    heroTitle: 'RareFriends by Pocket Genes',
    heroBody:
      'Una capa de apoyo entre pares para el momento posterior a recibir resultados genéticos. RareFriends te ayuda a encontrar personas, organizaciones, eventos, recursos y actualizaciones relevantes para tu contexto genético sin hacer público tu informe privado por defecto.',
    communityTerms: 'Términos de comunidad',
    safetyPolicy: 'Política de seguridad',
    imageAlt: 'Pantalla de comunidad RareFriends en Pocket Genes',
    howEyebrow: 'Cómo funciona la comunidad',
    howTitle: 'Encontrá personas y grupos que coincidan con tu recorrido EPOF.',
    howBody:
      'Cada vez más personas reciben resultados genéticos, pero el camino posterior al informe todavía puede sentirse fragmentado. RareFriends by Pocket Genes puede conectar por gen, familia de condición, síntomas, rol, idioma, país y etapa del recorrido, para que el apoyo siga siendo útil incluso cuando un círculo de gen exacto está quieto.',
    principles: [
      {
        title: 'Personas con contexto similar',
        body: 'Encontrá apoyo por mismo gen, condición, familia de síntomas, rol, país, idioma o etapa del recorrido, incluso cuando el match exacto todavía no es evidente.',
      },
      {
        title: 'Organizaciones y eventos',
        body: 'Seguí organizaciones verificadas, webinars, programas de apoyo y eventos que puedan ayudar después de un resultado confuso, no solo durante el estudio.',
      },
      {
        title: 'Próximos pasos prácticos',
        body: 'Pasá de resultado a comprensión y de ahí a una pregunta guardada para consulta, un recurso, un evento o un módulo de aprendizaje.',
      },
      {
        title: 'Apoyo emocional y práctico',
        body: 'Un recorrido EPOF puede sentirse aislante. El objetivo es recibir respuestas útiles, apoyo cotidiano y experiencia compartida.',
      },
      {
        title: 'Participación seudónima',
        body: 'Participá sin exponer tu identidad completa, variante exacta o informe original.',
      },
      {
        title: 'Seguridad moderada',
        body: 'Reglas claras, reportes, bloqueos y moderación ayudan a prevenir desinformación, presión y reidentificación.',
      },
    ],
    matchingEyebrow: 'Matching por capas',
    matchingTitle: 'No necesitás un diagnóstico exacto para encontrar apoyo útil.',
    matchingBody:
      'El recorrido posterior al resultado rara vez es lineal. Una persona puede pertenecer al mismo tiempo a un círculo de gen exacto, una familia de condiciones más amplia, un círculo de cuidadores, un grupo regional y una etapa de diagnóstico reciente.',
    matchingLayers: [
      'Gen exacto',
      'Condición o familia de enfermedad',
      'Síntomas o recorrido diagnóstico',
      'Rol de paciente, madre, padre, cuidador o aprendiz',
      'País, idioma y recursos locales',
      'Diagnóstico reciente, sin diagnóstico o manejo a largo plazo',
    ],
    trustEyebrow: 'Confianza primero',
    trustTitle: 'La comunidad funciona mejor cuando utilidad, moderación y confianza van primero.',
    trustBody:
      'Un próximo paso significativo puede ser entender una sección del informe, recibir una respuesta útil, seguir una organización confiable, registrarse a un evento o preparar una mejor pregunta para consulta.',
    trustCta: 'Abrir Centro de confianza',
  },
} as const;

const copy = pageCopy[isEnglish ? 'en' : 'es'];
---

<PocketGenesPublicLayout
  title={copy.title}
  description={copy.description}
  canonicalPath="/pocket-genes/rarefriends"
  image="/pocket-genes/screenshots/sample_rare_friends.PNG"
>
  <main id="main" class="pg-page pg-rf-page">
    <section class="pg-rf-hero">
      <div class="pg-container pg-rf-hero-grid">
        <div>
          <p class="pg-eyebrow">{copy.heroEyebrow}</p>
          <h1>{copy.heroTitle}</h1>
          <p>
            {copy.heroBody}
          </p>
          <div class="pg-button-row">
            <a class="pg-button pg-button-primary" href={localizePath('/pocket-genes/trust-center/community-terms')}>{copy.communityTerms}</a>
            <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center/community-safety-policy')}>{copy.safetyPolicy}</a>
          </div>
        </div>
        <figure class="pg-rf-visual">
          <img src="/pocket-genes/screenshots/sample_rare_friends.PNG" alt={copy.imageAlt} fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.howEyebrow}</p>
          <h2>{copy.howTitle}</h2>
          <p>
            {copy.howBody}
          </p>
        </div>
        <div class="pg-card-grid pg-rf-grid">
          {copy.principles.map((principle) => (
            <article class="pg-card">
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section pg-rf-matching">
      <div class="pg-container pg-rf-matching-grid">
        <div class="pg-section-heading">
          <p class="pg-eyebrow">{copy.matchingEyebrow}</p>
          <h2>{copy.matchingTitle}</h2>
          <p>
            {copy.matchingBody}
          </p>
        </div>
        <div class="pg-match-list">
          {copy.matchingLayers.map((layer) => (
            <article>
              <span></span>
              <strong>{layer}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-section-tight pg-rf-band-section">
      <div class="pg-container pg-rf-band">
        <div>
          <p class="pg-eyebrow">{copy.trustEyebrow}</p>
          <h2>{copy.trustTitle}</h2>
          <p>
            {copy.trustBody}
          </p>
        </div>
        <a class="pg-button pg-button-secondary" href={localizePath('/pocket-genes/trust-center')}>{copy.trustCta}</a>
      </div>
    </section>
  </main>
</PocketGenesPublicLayout>

<style>
  .pg-rf-hero {
    min-height: 680px;
    display: flex;
    align-items: center;
    padding: 112px 0 60px;
    background:
      linear-gradient(90deg, rgba(23, 32, 51, 0.94), rgba(23, 32, 51, 0.72)),
      url("/mobile2.webp");
    background-size: cover;
    background-position: center;
    color: #ffffff;
    overflow: hidden;
  }

  .pg-rf-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 0.75fr);
    gap: 48px;
    align-items: center;
  }

  .pg-rf-hero h1 {
    margin: 0;
    max-width: 780px;
    font-size: 4rem;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .pg-rf-hero p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.12rem;
  }

  .pg-rf-hero .pg-eyebrow {
    color: #7de4d7;
  }

  .pg-rf-hero .pg-button-row {
    margin-top: 26px;
  }

  .pg-rf-visual {
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .pg-rf-visual img {
    width: 270px;
    border: 8px solid #101522;
    border-radius: 28px;
    background: #101522;
    box-shadow: var(--pg-shadow);
  }

  .pg-rf-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pg-rf-matching {
    background: #eef5f7;
  }

  .pg-rf-matching-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(360px, 1.14fr);
    gap: 36px;
    align-items: start;
  }

  .pg-match-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .pg-match-list article {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--pg-border-strong);
    border-radius: 8px;
    background: #ffffff;
    padding: 16px;
  }

  .pg-match-list span {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--pg-teal);
    flex: 0 0 auto;
  }

  .pg-match-list strong {
    line-height: 1.25;
  }

  .pg-rf-band-section {
    background: #ffffff;
  }

  .pg-rf-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 8px;
    background: #f8fbfc;
    padding: 28px;
  }

  .pg-rf-band h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
  }

  .pg-rf-band p {
    margin: 12px 0 0;
    color: var(--pg-ink-soft);
  }

  @media (max-width: 980px) {
    .pg-rf-hero-grid,
    .pg-rf-band,
    .pg-rf-matching-grid {
      grid-template-columns: 1fr;
    }

    .pg-rf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pg-rf-hero {
      min-height: auto;
      padding: 104px 0 52px;
    }

    .pg-rf-hero h1 {
      font-size: 2.8rem;
    }

    .pg-rf-grid {
      grid-template-columns: 1fr;
    }

    .pg-match-list {
      grid-template-columns: 1fr;
    }
  }
</style>
