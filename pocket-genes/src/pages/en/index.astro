---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/index';
import type { Lang } from '../../i18n/ui';
import { defaultLang } from '../../i18n/ui';

const t = useTranslations(Astro.currentLocale);
const lang = (Astro.currentLocale || defaultLang) as Lang;

function localPath(path: string) {
  return getLocalizedPath(path, lang);
}
---

<BaseLayout title={t.index.title} activePage="home">
  <main class="home-page">
    <section class="hero-section">
      <div class="hero-bg-effects">
        <div class="floating-orb orb-1"></div>
        <div class="floating-orb orb-2"></div>
        <div class="floating-orb orb-3"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            <span class="title-accent">{t.index.heroAccent}</span>
            <span class="title-main">{t.index.heroMain}</span>
          </h1>
          <p class="hero-subtitle">{t.index.heroSubtitle}</p>
          <div class="hero-actions">
            <a href={localPath('/pocket-genes')} class="btn-primary">{t.index.explorePocketGenes}</a>
            <a href={localPath('/about')} class="btn-secondary">{t.index.learnMore}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="features-section">
      <div class="container">
        <h2>{t.index.ourSolutions}</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🧬</div>
            <h3>{t.index.genomicAnalysisTitle}</h3>
            <p>{t.index.genomicAnalysisDesc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>{t.index.mobileIntegrationTitle}</h3>
            <p>{t.index.mobileIntegrationDesc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>{t.index.realTimeTitle}</h3>
            <p>{t.index.realTimeDesc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>{t.index.securePlatformTitle}</h3>
            <p>{t.index.securePlatformDesc}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>{t.index.ctaTitle}</h2>
        <p>{t.index.ctaDesc}</p>
        <a href={localPath('/contact')} class="btn-primary">{t.index.ctaButton}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    min-height: clamp(600px, 100vh, 1200px);
    display: flex;
    align-items: center;
    overflow: hidden;
    margin-top: clamp(60px, 10vw, 80px);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .hero-bg-effects { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .floating-orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.4; animation: floating 20s ease-in-out infinite; }
  .orb-1 { width: 300px; height: 300px; background: linear-gradient(135deg, rgba(103, 126, 234, 0.3) 0%, rgba(79, 172, 254, 0.2) 100%); top: 20%; left: 5%; }
  .orb-2 { width: 220px; height: 220px; background: linear-gradient(135deg, rgba(240, 147, 251, 0.25) 0%, rgba(103, 126, 234, 0.15) 100%); bottom: 20%; right: 10%; animation-delay: -8s; }
  .orb-3 { width: 160px; height: 160px; background: linear-gradient(135deg, rgba(79, 172, 254, 0.3) 0%, rgba(240, 147, 251, 0.18) 100%); top: 60%; left: 70%; animation-delay: -15s; }

  @keyframes floating {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25% { transform: translateY(-40px) rotate(90deg); }
    50% { transform: translateY(25px) rotate(180deg); }
    75% { transform: translateY(-20px) rotate(270deg); }
  }

  .hero-content { position: relative; z-index: 2; text-align: center; }
  .hero-title { font-size: clamp(3rem, 8vw, 6rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.5rem; }
  .title-accent { display: block; background: var(--accent-gradient); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 0.5em; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0.5rem; }
  .title-main { display: block; background: var(--primary-gradient); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-subtitle { font-size: clamp(1.25rem, 3vw, 1.5rem); color: var(--text-secondary); margin-bottom: 2.5rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn-primary, .btn-secondary { display: inline-block; padding: 1rem 2rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; transition: all 0.3s ease; border: none; cursor: pointer; }
  .btn-primary { background: var(--accent-gradient); color: #000; text-shadow: none; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(79, 172, 254, 0.4); }
  .btn-secondary { background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); color: var(--text-primary); }
  .btn-secondary:hover { transform: translateY(-2px); box-shadow: var(--glass-shadow); }

  .features-section { padding: clamp(3rem, 8vw, 6rem) 0; background: linear-gradient(135deg, var(--dark-surface) 0%, var(--dark-elevated) 100%); }
  .features-section h2 { text-align: center; font-size: clamp(1.75rem, 5vw, 3rem); font-weight: 700; margin-bottom: clamp(2rem, 4vw, 3rem); background: var(--primary-gradient); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(1.5rem, 3vw, 2rem); }
  .feature-card { background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 1rem; padding: clamp(1.5rem, 3vw, 2rem); text-align: center; transition: all 0.3s ease; }
  .feature-card:hover { transform: translateY(-5px); box-shadow: var(--glass-shadow); }
  .feature-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .feature-card h3 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; color: var(--text-primary); }
  .feature-card p { color: var(--text-secondary); line-height: 1.6; }

  .cta-section { padding: clamp(3rem, 8vw, 6rem) 0; text-align: center; }
  .cta-section h2 { font-size: clamp(1.75rem, 5vw, 3rem); font-weight: 700; margin-bottom: 1rem; background: var(--secondary-gradient); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .cta-section p { font-size: clamp(1rem, 2.5vw, 1.25rem); color: var(--text-secondary); margin-bottom: clamp(1.5rem, 3vw, 2rem); max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.6; }

  @media (max-width: 768px) {
    .hero-actions { flex-direction: column; align-items: center; }
    .btn-primary, .btn-secondary { width: 100%; max-width: 280px; text-align: center; }
  }

  @media (max-width: 480px) {
    .features-grid { grid-template-columns: 1fr; }
    .orb-1, .orb-2, .orb-3 { display: none; }
    .hero-section { min-height: clamp(500px, 80vh, 600px); }
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  @media (min-width: 1800px) {
    .hero-title {
      font-size: clamp(4rem, 6vw, 8rem);
    }

    .hero-subtitle {
      font-size: clamp(1.5rem, 2vw, 2rem);
    }
  }
</style>
