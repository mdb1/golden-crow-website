---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PocketGenesIntegrationContent from '../../../components/PocketGenesIntegrationContent.astro';
import { useTranslations } from '../../../i18n/index';

const t = useTranslations(Astro.currentLocale);
const pocketGenesIcon = '/pocket-genes/icon_simple.png';
---

<BaseLayout
  title={t.pocketGenes.integrationTitle}
  showFooter={false}
  brandLogoSrc={pocketGenesIcon}
  brandLogoAlt="Pocket Genes app icon"
  brandText="Pocket Genes"
  brandHref="/pocket-genes"
  faviconHref={pocketGenesIcon}
  favicon32Href={pocketGenesIcon}
  favicon16Href={pocketGenesIcon}
  appleTouchIconHref={pocketGenesIcon}
  socialImage={pocketGenesIcon}
>
  <PocketGenesIntegrationContent />
</BaseLayout>
