---
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section class="container">
  <div class="content-wrapper">
    <h1 id="title">
      <span class="title-accent">{t.introPlan.title1}</span>
      <span class="title-main">{t.introPlan.title2}</span>
    </h1>
    <p id="description">{t.introPlan.subtitle}</p>
    <div class="features-preview">
      <div class="feature-badge">
        <span class="badge-icon">&#x26A1;</span>
        <span>{t.introPlan.instantIntegration}</span>
      </div>
      <div class="feature-badge">
        <span class="badge-icon">&#x1F3A8;</span>
        <span>{t.introPlan.customBranding}</span>
      </div>
      <div class="feature-badge">
        <span class="badge-icon">&#x1F4F1;</span>
        <span>{t.introPlan.mobileFirst}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: none;
    position: relative;
    min-height: 100vh;
    background: var(--bg-secondary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 5rem 8%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 80%;
  }

  #title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
  }

  .title-accent {
    display: block;
    color: var(--text-secondary);
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  #description {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--text-secondary);
    margin: 0 0 2.5rem 0;
    line-height: 1.4;
    max-width: 85%;
    font-weight: 500;
  }

  .features-preview {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .feature-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    padding: 1rem 1.5rem;
    box-shadow: var(--card-shadow);
    transition: all 0.3s ease;
    color: var(--text-primary);
    font-weight: 500;
  }

  .feature-badge:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }

  .badge-icon {
    font-size: 1.25rem;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .container {
      text-align: center;
      justify-content: center;
    }

    .content-wrapper {
      max-width: 100%;
    }

    .features-preview {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 5%;
      min-height: 80vh;
    }

    #description {
      max-width: 100%;
    }

    .features-preview {
      gap: 1rem;
    }

    .feature-badge {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 2rem 4%;
    }

    .features-preview {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .feature-badge {
      width: fit-content;
    }
  }
</style>
