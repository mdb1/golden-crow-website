---
import DetailedPlan from "../components/DetailedPlan.astro";
import PlanSeparator from "../components/PlanSeparator.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section class="container">
  <div class="content-wrapper">
    <div class="section-header">
      <h1 class="title">
        <span class="title-accent">{t.choosePlan.title1}</span>
        <span class="title-main">{t.choosePlan.title2}</span>
      </h1>
      <p class="section-subtitle">{t.choosePlan.subtitle}</p>
    </div>
    <div class="plans_container">
    <DetailedPlan
      title={t.choosePlan.freePlan}
      subtitle={t.choosePlan.freeDesc}
      items={t.choosePlan.freeItems}
    />
    <PlanSeparator />
    <DetailedPlan
      title={t.choosePlan.plusPlan}
      subtitle={t.choosePlan.plusDesc}
      items={t.choosePlan.plusItems}
    />
    <PlanSeparator />
    <DetailedPlan
      title={t.choosePlan.fullPlan}
      subtitle={t.choosePlan.fullDesc}
      items={t.choosePlan.fullItems}
      isHighlighted={true}
    />
    </div>
  </div>
</section>

<style>
  .container {
    max-width: none;
    position: relative;
    min-height: 100vh;
    background: var(--bg-secondary);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 4%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    margin: 0 0 1.5rem 0;
    line-height: 1.1;
  }

  .title-accent {
    display: block;
    color: var(--text-primary);
    font-size: 0.6em;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
    max-width: 600px;
  }

  .plans_container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: 3rem;
    width: 100%;
    max-width: 1400px;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .plans_container {
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 4%;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    .plans_container {
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 2rem 4%;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .plans_container {
      gap: 1.5rem;
    }
  }
</style>
