---
import { useTranslations, getLocalizedPath } from '../i18n/index';
import type { Lang } from '../i18n/ui';
import { defaultLang } from '../i18n/ui';

interface Props {
  title: string;
  showFooter?: boolean;
  showNav?: boolean;
  extraHeadScripts?: string[];
}

const { title, showFooter = true, showNav = true, extraHeadScripts = [] } = Astro.props;
const lang = (Astro.currentLocale || defaultLang) as Lang;
const t = useTranslations(Astro.currentLocale);

function localPath(path: string) {
  return getLocalizedPath(path, lang);
}

// Determine alternate lang path for the switcher
const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(/^\/en\//, '/').replace(/^\/en$/, '/');
const alternateLang = lang === 'es' ? 'en' : 'es';
const switcherPath = alternateLang === 'en'
  ? `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`
  : pathWithoutLocale;
const switcherLabel = alternateLang === 'en' ? 'EN' : 'ES';

// hreflang URLs
const siteBase = 'https://goldencrowvs.com';
const esPath = pathWithoutLocale;
const enPath = `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
---

<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:url" content={`${siteBase}${Astro.url.pathname}`} />
  <meta property="og:image" content={`${siteBase}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:type" content="image/png" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:image" content={`${siteBase}/og-image.png`} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css" rel="stylesheet">
  <link rel="alternate" hreflang="es" href={`${siteBase}${esPath}`} />
  <link rel="alternate" hreflang="en" href={`${siteBase}${enPath}`} />
  <link rel="alternate" hreflang="x-default" href={`${siteBase}${esPath}`} />
  {extraHeadScripts.map(src => <script src={src} type="text/javascript" />)}
  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1488176746649069');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1488176746649069&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->
</head>
<body>
  {showNav && (
    <nav class="main-nav">
      <div class="nav-container">
        <div class="logo">
          <a href={localPath('/')}>
            <img src="/logo1024.webp" alt="Golden Crow VS Logo" />
            <span class="logo-text">{t.hero.brand}</span>
          </a>
        </div>
        <button class="mobile-menu-toggle" aria-label="Toggle navigation">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
        <div class="nav-links">
          <a href={`${localPath('/')}#about`} class="nav-link">{t.nav.about}</a>
          <a href={localPath('/work')} class="nav-link">{t.nav.work}</a>
          <a href={`${localPath('/')}#why-us`} class="nav-link">{t.nav.whyUs}</a>
          <a href={`${localPath('/')}#team`} class="nav-link">{t.nav.team}</a>
          <div class="lang-switcher">
            <a href={esPath} class:list={['lang-option', { active: lang === 'es' }]}>ES</a>
            <span class="lang-divider">|</span>
            <a href={enPath} class:list={['lang-option', { active: lang === 'en' }]}>EN</a>
          </div>
          <a href={`${localPath('/')}#booking`} class="nav-cta">{t.nav.contact}</a>
        </div>
      </div>
    </nav>
  )}

  <slot />

  {showFooter && (
    <footer class="main-footer">
      <div class="container">
        <nav class="footer-nav">
          <a href={`${localPath('/')}#about`}>{t.nav.about}</a>
          <span class="footer-nav-divider">&middot;</span>
          <a href={localPath('/work')}>{t.nav.work}</a>
          <span class="footer-nav-divider">&middot;</span>
          <a href={`${localPath('/')}#why-us`}>{t.nav.whyUs}</a>
          <span class="footer-nav-divider">&middot;</span>
          <a href={`${localPath('/')}#team`}>{t.nav.team}</a>
          <span class="footer-nav-divider">&middot;</span>
          <a href={`${localPath('/')}#booking`}>{t.nav.contact}</a>
        </nav>

        <div class="footer-social">
          <a href="https://www.linkedin.com/company/golden-crow-vs/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/goldencrowvs/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>

        <div class="footer-bottom">
          <p>{t.footer.copyright}</p>
        </div>
      </div>
    </footer>
  )}
</body>
</html>

<style is:global>
  :root {
    --brand-color: #AF8232;
    --brand-hover: #8D6928;
    --bg-primary: #f9fafb;
    --bg-secondary: #ffffff;
    --bg-tertiary: #f3f4f6;
    --text-primary: #111827;
    --text-secondary: #4b5563;
    --text-tertiary: #9ca3af;
    --text-accent: #AF8232;
    --card-bg: #ffffff;
    --card-border: #e5e7eb;
    --card-shadow: 0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px -1px rgba(0,0,0,0.1);
    --card-shadow-hover: 0 10px 25px -5px rgba(0,0,0,0.08);

    /* Backward-compat aliases */
    --dark-bg: var(--bg-primary);
    --dark-surface: var(--bg-secondary);
    --dark-elevated: var(--bg-tertiary);
    --glass-bg: var(--card-bg);
    --glass-border: var(--card-border);
    --glass-shadow: var(--card-shadow);
    --primary-gradient: #D4A94E;
    --secondary-gradient: #e06666;
    --accent-gradient: #c27ba0;
    --success-gradient: #93c47d;
    --warning-gradient: #f6b26b;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: "Geist Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    min-width: 320px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  @media (min-width: 1400px) {
    .container {
      max-width: 1400px;
    }
  }
</style>

<style>
  .main-nav {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 60px;
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: 1100px;
    width: calc(100% - 2rem);
    z-index: 1000;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
  }

  .nav-container {
    padding: 0.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .logo a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    height: clamp(32px, 5vw, 40px);
    width: auto;
    max-width: clamp(80px, 15vw, 120px);
    border-radius: 4px;
  }

  .logo-text {
    font-weight: 700;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    color: var(--text-primary);
    white-space: nowrap;
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background: #1a1f3a;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .mobile-menu-toggle.active .hamburger-line:first-child {
    transform: rotate(45deg) translate(6px, 6px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:last-child {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  .nav-links {
    display: flex;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    align-items: center;
  }

  .nav-link {
    color: #1a1f3a;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--brand-color);
  }

  .nav-cta {
    background: var(--brand-color);
    color: #fff;
    padding: 0.5rem 1.5rem;
    border-radius: 60px;
    font-weight: 600;
    text-decoration: none;
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .nav-cta:hover {
    background: var(--brand-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(175, 130, 50, 0.3);
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .lang-option {
    color: #1a1f3a;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
    padding: 0.1rem 0.2rem;
  }

  .lang-option:hover {
    color: var(--brand-color);
  }

  .lang-option.active {
    color: var(--brand-color);
    font-weight: 700;
  }

  .lang-divider {
    color: #1a1f3a;
    opacity: 0.3;
    font-size: 0.8rem;
  }

  .main-footer {
    background: var(--bg-primary);
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(1.5rem, 2vw, 2rem);
    border-top: 1px solid var(--card-border);
    text-align: center;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .footer-nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .footer-nav a:hover {
    color: var(--brand-color);
  }

  .footer-nav-divider {
    color: var(--text-tertiary);
    user-select: none;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .footer-social a {
    color: var(--text-tertiary);
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
  }

  .footer-social a:hover {
    color: var(--brand-color);
  }

  .footer-bottom {
    text-align: center;
  }

  .footer-bottom p {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .main-nav {
      border-radius: 16px;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 16px;
      flex-direction: column;
      padding: 1rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      transform: translateY(-10px);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 999;
    }

    .nav-links.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-link {
      color: #1a1f3a;
      font-size: 1rem;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      transition: all 0.3s ease;
      width: 100%;
    }

    .nav-link:hover {
      background: rgba(175, 130, 50, 0.08);
    }

    .lang-switcher {
      align-self: flex-start;
      padding: 0.5rem 1rem;
    }

    .nav-cta {
      width: 100%;
      text-align: center;
      padding: 0.75rem 1.5rem;
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer-nav a {
      font-size: 0.8rem;
    }

    .footer-bottom p {
      font-size: 0.78rem;
    }
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    if (mobileMenuToggle && navLinks) {
      mobileMenuToggle.addEventListener('click', function() {
        navLinks.classList.toggle('active');
        mobileMenuToggle.classList.toggle('active');
      });

      const allNavLinks = navLinks.querySelectorAll('.nav-link, .nav-cta');
      allNavLinks.forEach(link => {
        link.addEventListener('click', function() {
          navLinks.classList.remove('active');
          mobileMenuToggle.classList.remove('active');
        });
      });

      document.addEventListener('click', function(event) {
        if (!mobileMenuToggle.contains(event.target) && !navLinks.contains(event.target)) {
          navLinks.classList.remove('active');
          mobileMenuToggle.classList.remove('active');
        }
      });
    }
  });

  // Re-scroll to hash target after layout settles (fixes race condition on
  // initial page load where async content like iframes shift the layout).
  if (location.hash) {
    const scrollToHash = () => {
      const el = document.querySelector(location.hash);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    };
    // Wait for the page to fully load (images, iframes, etc.)
    window.addEventListener('load', () => setTimeout(scrollToHash, 400));
  }
</script>
