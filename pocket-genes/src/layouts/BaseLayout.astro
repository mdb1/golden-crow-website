---
import { useTranslations, getLocalizedPath } from '../i18n/index';
import type { Lang } from '../i18n/ui';
import { defaultLang } from '../i18n/ui';

interface Props {
  title: string;
  activePage?: string;
  showFooter?: boolean;
  footerVariant?: 'default' | 'landing';
  extraHeadScripts?: string[];
}

const { title, activePage = '', showFooter = true, footerVariant = 'default', extraHeadScripts = [] } = Astro.props;
const lang = (Astro.currentLocale || defaultLang) as Lang;
const t = useTranslations(Astro.currentLocale);

function localPath(path: string) {
  return getLocalizedPath(path, lang);
}

// Determine alternate lang path for the switcher
const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(/^\/en\//, '/').replace(/^\/en$/, '/');
const alternateLang = lang === 'es' ? 'en' : 'es';
const switcherPath = alternateLang === 'en'
  ? `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`
  : pathWithoutLocale;
const switcherLabel = alternateLang === 'en' ? 'EN' : 'ES';

// hreflang URLs
const siteBase = 'https://goldencrowvs.com';
const esPath = pathWithoutLocale;
const enPath = `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
---

<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="alternate" hreflang="es" href={`${siteBase}${esPath}`} />
  <link rel="alternate" hreflang="en" href={`${siteBase}${enPath}`} />
  <link rel="alternate" hreflang="x-default" href={`${siteBase}${esPath}`} />
  {extraHeadScripts.map(src => <script src={src} type="text/javascript" />)}
</head>
<body>
  <nav class="main-nav">
    <div class="nav-container">
      <div class="logo">
        <a href={localPath('/')}>
          <img src="/logo1024.png" alt="Golden Crow VS Logo" />
        </a>
      </div>
      <button class="mobile-menu-toggle" aria-label="Toggle navigation">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
      <div class="nav-links">
        <a href={localPath('/')} class:list={['nav-link', { active: activePage === 'home' }]}>{t.nav.home}</a>
        <a href={localPath('/about')} class:list={['nav-link', { active: activePage === 'about' }]}>{t.nav.about}</a>
        <a href={localPath('/pocket-genes')} class:list={['nav-link', { active: activePage === 'pocket-genes' }]}>{t.nav.pocketGenes}</a>
        <a href={localPath('/contact')} class:list={['nav-link', { active: activePage === 'contact' }]}>{t.nav.contact}</a>
        <div class="lang-switcher">
          <a href={esPath} class:list={['lang-option', { active: lang === 'es' }]}>ES</a>
          <span class="lang-divider">/</span>
          <a href={enPath} class:list={['lang-option', { active: lang === 'en' }]}>EN</a>
        </div>
      </div>
    </div>
  </nav>

  <slot />

  {showFooter && (
    <footer class="main-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-brand">
            <div class="logo">
              <img src="/logo1024.png" alt="Golden Crow VS Logo" />
            </div>
            <p>{footerVariant === 'landing' ? t.footer.taglineLanding : t.footer.tagline}</p>
          </div>
          <div class="footer-links">
            <div class="footer-section">
              <h4>{t.footer.company}</h4>
              <ul>
                <li><a href={localPath('/about')}>{t.footer.aboutUs}</a></li>
                <li><a href={localPath('/contact')}>{t.footer.contactLink}</a></li>
              </ul>
            </div>
            <div class="footer-section">
              <h4>{t.footer.products}</h4>
              <ul>
                <li><a href={localPath('/pocket-genes')}>{t.footer.pocketGenes}</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <p>{t.footer.copyright}</p>
          {footerVariant === 'landing' && <p class="footer-tagline">{t.footer.developedWith}</p>}
        </div>
      </div>
    </footer>
  )}
</body>
</html>

<style is:global>
  :root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    --accent-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    --success-gradient: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    --warning-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);

    --dark-bg: #0a0e27;
    --dark-surface: #1a1f3a;
    --dark-elevated: #2d3561;
    --text-primary: #ffffff;
    --text-secondary: #b8c5d1;
    --text-accent: #64b5f6;

    --glass-bg: rgba(255, 255, 255, 0.1);
    --glass-border: rgba(255, 255, 255, 0.2);
    --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    background: var(--dark-bg);
    background-image:
      radial-gradient(circle at 25% 25%, #667eea20 0%, transparent 50%),
      radial-gradient(circle at 75% 75%, #764ba240 0%, transparent 50%);
    color: var(--text-primary);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    min-width: 320px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  @media (min-width: 1400px) {
    .container {
      max-width: 1400px;
    }
  }
</style>

<style>
  .main-nav {
    background: rgba(26, 31, 58, 0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(0.75rem, 2vw, 1rem) clamp(1rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .logo a {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: clamp(32px, 5vw, 40px);
    width: auto;
    max-width: clamp(80px, 15vw, 120px);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    border-radius: 4px;
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .mobile-menu-toggle.active .hamburger-line:first-child {
    transform: rotate(45deg) translate(6px, 6px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:last-child {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  .nav-links {
    display: flex;
    gap: clamp(0.5rem, 3vw, 2rem);
    flex-wrap: wrap;
    align-items: center;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    font-size: clamp(0.8rem, 2vw, 1rem);
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-gradient);
    border-radius: 1px;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(79, 172, 254, 0.1);
    border: 1px solid rgba(79, 172, 254, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .lang-option {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
    padding: 0.1rem 0.2rem;
  }

  .lang-option:hover {
    color: var(--text-primary);
  }

  .lang-option.active {
    color: var(--text-accent);
    font-weight: 700;
  }

  .lang-divider {
    color: var(--text-secondary);
    opacity: 0.5;
    font-size: 0.8rem;
  }

  .main-footer {
    background: var(--dark-surface);
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(1rem, 2vw, 1rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .footer-brand p {
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .footer-links {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
  }

  .footer-section h4 {
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section ul li {
    margin-bottom: 0.5rem;
  }

  .footer-section ul li a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-section ul li a:hover {
    color: var(--text-primary);
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--text-secondary);
  }

  .footer-tagline {
    margin-top: 0.5rem;
    font-style: italic;
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(26, 31, 58, 0.95);
      backdrop-filter: blur(20px);
      flex-direction: column;
      padding: 1rem;
      box-shadow: var(--glass-shadow);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 999;
    }

    .nav-links.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-link {
      font-size: 1rem;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      transition: all 0.3s ease;
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .nav-link.active::after {
      display: none;
    }

    .lang-switcher {
      align-self: flex-start;
    }
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-links {
      justify-content: center;
    }
  }

  @media (min-width: 1400px) {
    .nav-container {
      max-width: 1400px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    if (mobileMenuToggle && navLinks) {
      mobileMenuToggle.addEventListener('click', function() {
        navLinks.classList.toggle('active');
        mobileMenuToggle.classList.toggle('active');
      });

      const navLinksElements = navLinks.querySelectorAll('.nav-link');
      navLinksElements.forEach(link => {
        link.addEventListener('click', function() {
          navLinks.classList.remove('active');
          mobileMenuToggle.classList.remove('active');
        });
      });

      document.addEventListener('click', function(event) {
        if (!mobileMenuToggle.contains(event.target) && !navLinks.contains(event.target)) {
          navLinks.classList.remove('active');
          mobileMenuToggle.classList.remove('active');
        }
      });
    }
  });
</script>
