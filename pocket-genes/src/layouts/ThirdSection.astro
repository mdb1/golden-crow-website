---
import ImageCard from "../components/ImageCard.astro";
import IntegrationText from "../components/IntegrationText.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section id="integration-layers" class="integration_body">
    <div class="content-wrapper">
        <div class="text">
            <h2 class="integration_text">
                <span class="text-gradient">{t.thirdSection.title1}</span>{' '}
                <span class="text-accent">{t.thirdSection.title2}</span>
            </h2>
            <p class="integration-subtitle">{t.thirdSection.description}</p>
            <div class="features-grid">
                <IntegrationText
                    src="/launch-faster.svg"
                    bold_text={t.thirdSection.launchFaster}
                    text={t.thirdSection.launchFasterDesc}
                />
                <IntegrationText
                    src="/save-costs.svg"
                    bold_text={t.thirdSection.saveCosts}
                    text={t.thirdSection.saveCostsDesc}
                />
                <IntegrationText
                    src="/boost-engagement.svg"
                    bold_text={t.thirdSection.boostEngagement}
                    text={t.thirdSection.boostEngagementDesc}
                />
                <IntegrationText
                    src="/scale-easily.svg"
                    bold_text={t.thirdSection.scaleEasily}
                    text={t.thirdSection.scaleEasilyDesc}
                />
            </div>
        </div>
        <div class="image-wrapper">
            <ImageCard src="/integrate1.webp" alt="Pocket Genes App" />
            <ImageCard src="/integrate2.webp" alt="Pocket Genes Card" />
        </div>
    </div>
</section>

<style>
    .integration_body {
        min-height: 100vh;
        position: relative;
        background: var(--bg-primary);
        display: flex;
        align-items: center;
        padding: 5rem 5%;
        overflow: hidden;
    }

    .content-wrapper {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5rem;
        position: relative;
        z-index: 2;
    }

    .text {
        flex: 1;
        color: var(--text-primary);
    }

    .integration_text {
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1.5rem;
    }

    .text-gradient {
        color: var(--brand-color);
    }

    .text-accent {
        color: var(--text-primary);
    }

    .integration-subtitle {
        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        color: var(--text-secondary);
        margin-bottom: 3rem;
        line-height: 1.6;
    }

    .features-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .image-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        position: relative;
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
        .content-wrapper {
            flex-direction: column;
            text-align: center;
            gap: 4rem;
        }

        .text {
            width: 100%;
        }

        .features-grid {
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .image-wrapper {
            flex-direction: row;
            justify-content: center;
            align-items: center;
        }
    }

    @media (max-width: 768px) {
        .integration_body {
            padding: 3rem 4%;
        }

        .content-wrapper {
            gap: 3rem;
        }

        .features-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .image-wrapper {
            flex-direction: column;
            gap: 1.5rem;
        }
    }

    @media (max-width: 480px) {
        .integration_body {
            padding: 2rem 4%;
        }
    }
</style>
