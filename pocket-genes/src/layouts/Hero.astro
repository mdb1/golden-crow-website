---
import { getLocalizedPath, useTranslations } from '../i18n/index';
import { defaultLang, type Lang } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
const lang = (Astro.currentLocale || defaultLang) as Lang;

function localPath(path: string) {
  return getLocalizedPath(path, lang);
}

const heroStats = [
  {
    href: '#app-screenshots',
    number: t.hero.stat1Number,
    label: t.hero.stat1Label,
  },
  {
    href: localPath('/pocket-genes/integration/rarefriends'),
    number: t.hero.stat2Number,
    label: t.hero.stat2Label,
  },
  {
    href: '#provider-discovery',
    number: t.hero.stat3Number,
    label: t.hero.stat3Label,
  },
];
---

<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">
      <span class="title-main">{t.hero.product}</span>
      <span class="title-sub">{t.hero.tagline}</span>
    </h1>
    <p class="hero-description">
      {t.hero.description}
      <span class="highlight">{t.hero.highlight}</span>
    </p>
    <div class="hero-actions">
      <a href="#booking" class="primary-action">{t.hero.primaryCta}</a>
      <a href="#app-screenshots" class="secondary-action">{t.hero.secondaryCta}</a>
    </div>
    <div class="hero-stats" aria-label={t.hero.statsLabel}>
      {heroStats.map((stat) => (
        <a class="stat" href={stat.href}>
          <span class="stat-number">{stat.number}</span>
          <span class="stat-label">{stat.label}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="hero-images">
    <img src="/mobile1.webp" alt={t.hero.appAlt} class="img1" fetchpriority="high" />
    <img src="/mobile2.webp" alt={t.hero.mobileAlt} class="img2" fetchpriority="high" />
  </div>
  <a href="#screen2" class="scroll-button">
    <span>{t.hero.explorePlatform}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 4L12 20M12 20L18 14M12 20L6 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 5%;
    background: var(--bg-primary);
    overflow: hidden;
  }

  /* Hero Content */
  .hero-content {
    flex: 1;
    max-width: 50%;
    position: relative;
    z-index: 2;
    padding-right: 2rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .title-main {
    display: block;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .title-sub {
    display: block;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 300;
    color: var(--text-secondary);
  }

  .hero-description {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 90%;
  }

  .highlight {
    color: var(--brand-color);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .primary-action {
    min-height: 64px;
    padding: 1.2rem 2.25rem;
    background: linear-gradient(135deg, #b57c22 0%, #f0c05b 48%, #8f5c14 100%);
    color: #fff;
    box-shadow: 0 18px 42px rgba(175, 130, 50, 0.34), 0 0 0 1px rgba(255, 255, 255, 0.28) inset;
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .primary-action:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 52px rgba(175, 130, 50, 0.42), 0 0 0 1px rgba(255, 255, 255, 0.34) inset;
  }

  .secondary-action {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    color: var(--text-primary);
    box-shadow: var(--card-shadow);
  }

  .secondary-action:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }

  .hero-stats {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .stat {
    min-width: 132px;
    text-align: left;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    padding: 0.9rem 1rem;
    box-shadow: var(--card-shadow);
    color: inherit;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .stat:hover,
  .stat:focus-visible {
    border-color: rgba(175, 130, 50, 0.35);
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-3px);
  }

  .stat:focus-visible {
    outline: 3px solid rgba(175, 130, 50, 0.22);
    outline-offset: 3px;
  }

  .stat-number {
    display: block;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    font-weight: 800;
    color: var(--brand-color);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stat-label {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  /* Hero Images */
  .hero-images {
    flex: 1;
    position: relative;
    height: 600px;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  .hero-images img {
    width: 280px;
    border-radius: 24px;
    box-shadow: var(--card-shadow);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    position: absolute;
  }

  .img1 {
    top: -50px;
    left: 50px;
    transform: rotate(-8deg) scale(0.95);
    z-index: 1;
  }

  .img2 {
    bottom: -50px;
    right: 50px;
    transform: rotate(8deg);
    z-index: 2;
  }

  .hero-images img:hover {
    transform: rotate(0deg) scale(1.05);
    box-shadow: var(--card-shadow-hover);
  }

  /* Scroll Button */
  .scroll-button {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 3rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    box-shadow: var(--card-shadow);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
  }

  .scroll-button:hover {
    transform: translateX(-50%) translateY(-4px);
    box-shadow: var(--card-shadow-hover);
  }

  .scroll-button svg {
    transition: transform 0.3s ease;
  }

  .scroll-button:hover svg {
    transform: translateY(4px);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .hero {
      flex-direction: column;
      text-align: center;
      padding: 2rem 5%;
      gap: 3rem;
    }

    .hero-content {
      max-width: 100%;
      padding-right: 0;
    }

    .hero-stats {
      justify-content: center;
      gap: 1rem;
      align-items: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-images {
      height: 400px;
    }

    .hero-images img {
      width: 240px;
    }

    .img1 {
      left: 20px;
      top: 0;
    }

    .img2 {
      right: 20px;
      bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 1rem 4%;
      gap: 2rem;
    }

    .hero-description {
      max-width: 100%;
    }

    .hero-stats {
      flex-direction: row;
      gap: 1rem;
      align-items: center;
    }

    .stat {
      text-align: center;
    }

    .hero-images {
      height: 300px;
    }

    .hero-images img {
      width: 180px;
    }

    .img1 {
      left: 10px;
      transform: rotate(-5deg) scale(0.95);
    }

    .img2 {
      right: 10px;
      transform: rotate(5deg);
    }

    .scroll-button {
      bottom: 1rem;
      padding: 0.75rem 1.5rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    .primary-action,
    .secondary-action {
      width: 100%;
    }

    .primary-action {
      min-height: 58px;
      padding-left: 1rem;
      padding-right: 1rem;
      font-size: 0.95rem;
    }

    .hero-images {
      height: 250px;
    }

    .hero-images img {
      width: 140px;
    }
  }
</style>
