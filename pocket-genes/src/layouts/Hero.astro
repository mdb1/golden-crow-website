---
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">
      <span class="title-main">{t.hero.product}</span>
      <span class="title-sub">{t.hero.tagline}</span>
    </h1>
    <p class="hero-description">
      {t.hero.description}
      <span class="highlight">{t.hero.highlight}</span>
    </p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-number">{t.hero.support247}</span>
        <span class="stat-label">{t.hero.supportLabel}</span>
      </div>
      <a href="https://apps.apple.com/us/app/pocket-genes/id6748587627" target="_blank" class="app-store-button">
        <img src="/appStore.png" alt={t.hero.appAlt} class="app-store-badge" />
      </a>
    </div>
  </div>
  <div class="hero-images">
    <img src="/mobile1.webp" alt={t.hero.appAlt} class="img1" fetchpriority="high" />
    <img src="/mobile2.webp" alt={t.hero.mobileAlt} class="img2" fetchpriority="high" />
  </div>
  <a href="#screen2" class="scroll-button">
    <span>{t.hero.explorePlatform}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 4L12 20M12 20L18 14M12 20L6 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 5%;
    background: var(--bg-primary);
    overflow: hidden;
  }

  /* Hero Content */
  .hero-content {
    flex: 1;
    max-width: 50%;
    position: relative;
    z-index: 2;
    padding-right: 2rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .title-main {
    display: block;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .title-sub {
    display: block;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 300;
    color: var(--text-secondary);
  }

  .hero-description {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    max-width: 90%;
  }

  .highlight {
    color: var(--brand-color);
    font-weight: 600;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--brand-color);
  }

  .stat-label {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .app-store-button {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem;
    border-radius: 12px;
    background: transparent;
    border: none;
  }

  .app-store-button:hover {
    transform: translateY(-3px);
  }

  .app-store-badge {
    height: 50px;
    width: auto;
    transition: all 0.3s ease;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
  }

  .app-store-button:hover .app-store-badge {
    filter: drop-shadow(0 8px 16px rgba(64, 37, 239, 0.2)) brightness(1.05);
  }

  /* Hero Images */
  .hero-images {
    flex: 1;
    position: relative;
    height: 600px;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  .hero-images img {
    width: 280px;
    border-radius: 24px;
    box-shadow: var(--card-shadow);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    position: absolute;
  }

  .img1 {
    top: -50px;
    left: 50px;
    transform: rotate(-8deg) scale(0.95);
    z-index: 1;
  }

  .img2 {
    bottom: -50px;
    right: 50px;
    transform: rotate(8deg);
    z-index: 2;
  }

  .hero-images img:hover {
    transform: rotate(0deg) scale(1.05);
    box-shadow: var(--card-shadow-hover);
  }

  /* Scroll Button */
  .scroll-button {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 3rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    box-shadow: var(--card-shadow);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
  }

  .scroll-button:hover {
    transform: translateX(-50%) translateY(-4px);
    box-shadow: var(--card-shadow-hover);
  }

  .scroll-button svg {
    transition: transform 0.3s ease;
  }

  .scroll-button:hover svg {
    transform: translateY(4px);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .hero {
      flex-direction: column;
      text-align: center;
      padding: 2rem 5%;
      gap: 3rem;
    }

    .hero-content {
      max-width: 100%;
      padding-right: 0;
    }

    .hero-stats {
      justify-content: center;
      gap: 3rem;
      align-items: center;
    }

    .hero-images {
      height: 400px;
    }

    .hero-images img {
      width: 240px;
    }

    .img1 {
      left: 20px;
      top: 0;
    }

    .img2 {
      right: 20px;
      bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 1rem 4%;
      gap: 2rem;
    }

    .hero-description {
      max-width: 100%;
    }

    .hero-stats {
      flex-direction: row;
      gap: 2rem;
      align-items: center;
    }

    .app-store-badge {
      height: 40px;
    }

    .stat-number {
      font-size: 1.5rem;
    }

    .hero-images {
      height: 300px;
    }

    .hero-images img {
      width: 180px;
    }

    .img1 {
      left: 10px;
      transform: rotate(-5deg) scale(0.95);
    }

    .img2 {
      right: 10px;
      transform: rotate(5deg);
    }

    .scroll-button {
      bottom: 1rem;
      padding: 0.75rem 1.5rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .app-store-badge {
      height: 35px;
    }

    .hero-images {
      height: 250px;
    }

    .hero-images img {
      width: 140px;
    }
  }
</style>
