---
const { subtitle, amount, description, items } = Astro.props;
import Icon from "../components/Icon.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<div class="container">
  <div class="title_container">
    <h1 class="title">{t.integrationProcess.title}</h1>
    <h2 class="subtitle">{subtitle}</h2>
  </div>
  <div class="pill_container">

    <div class="left">
        <p class="amount_pill">{amount}</p>
        <p class="description">{description}</p>
    </div>
    <div class="right">
        {
          items.map((item: object) => {
            return <Icon icon={item.icon} title={item.title} text={item.description} />;
          })
        }
      </div>
  </div>

</div>

<style>
  .container {
    max-width: none;
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    height: auto;
    position: relative;
    overflow: hidden;
    padding: 2rem 0;
  }

  .title_container {
    position: relative;
    z-index: 2;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    padding: 3rem 4rem;
    margin: 2rem 4rem;
    box-shadow: var(--card-shadow);
  }

  .title {
    color: var(--brand-color);
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin: 0 0 1rem 0;
    font-weight: 800;
    text-align: center;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: clamp(1.1rem, 2vw, 1.75rem);
    margin: 0;
    font-weight: 600;
    text-align: center;
  }

  .left {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 60%;
  }

  .right {
    z-index: 10;
    width: 100%;
    display: flex;
    flex-direction: row;
    text-align: center;
    margin-right: 2rem;
    position: relative;
  }

  .amount_pill {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    z-index: 10;
    color: var(--text-primary);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    padding: 1.5rem 6rem;
    border-radius: 50px;
    width: fit-content;
    box-shadow: var(--card-shadow);
    transition: all 0.3s ease;
  }

  .amount_pill:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
  }

  .pill_container{
    display: flex;
    flex-direction: row;
  }

  .description {
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    margin-top: 2rem;
    width: 70%;
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1.5rem;
    box-shadow: var(--card-shadow);
    transition: all 0.3s ease;
    text-align: center;
  }

  .description:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
  }

  @media screen and (max-width: 768px) {
    .title_container {
      margin: 1rem 2rem;
      padding: 2rem;
    }

    .amount_pill {
      padding: 1rem 4rem;
      font-size: clamp(1.25rem, 3vw, 2rem);
    }

    .description {
      font-size: clamp(1rem, 2vw, 1.15rem);
      line-height: 1.5;
      margin: 1rem auto;
      width: 90%;
      padding: 1.5rem;
    }

    .pill_container{
      flex-direction: column;
      padding: 0 1rem;
    }

    .left {
      width: auto;
      align-items: center;
      margin-bottom: 2rem;
    }

    .right{
      flex-direction: column;
    }
  }

  @media (min-width: 769px) and (max-width: 1440px) {
    .title_container {
      margin: 2rem;
      padding: 2.5rem;
    }

    .amount_pill {
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      padding: 1rem 5rem;
    }

    .description {
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      line-height: 1.6;
      margin: 1rem auto;
      width: 80%;
      padding: 1.5rem;
    }

    .pill_container{
      flex-direction: column;
      padding: 0 2rem;
    }

    .left {
      width: auto;
      align-items: center;
      margin-bottom: 2rem;
    }

    .right{
      flex-direction: column;
    }
  }

  @media (min-width: 1441px) {
    .right::before {
      content: '';
      position: absolute;
      height: 3px;
      background-color: var(--card-border);
      top: calc(2rem + clamp(75px, 7.5vw, 100px));
      left: 0;
      right: 0;
      z-index: 0;
    }
  }
</style>
