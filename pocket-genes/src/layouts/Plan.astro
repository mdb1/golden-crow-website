---
import PlanCard from "../components/PlanCard.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section class="container">
  <div class="content-wrapper">
    <h1 id="title">{t.plan.title}</h1>
    <p class="section-subtitle">{t.plan.subtitle}</p>
    <div class="card_container">
      <PlanCard
        title={t.plan.quickStartTitle}
        text={t.plan.quickStartDesc}
        subtext={t.plan.quickStartFeature}
        plan={t.plan.quickStartPlan}
        description={t.plan.quickStartLabel}
      />
      <PlanCard
        title={t.plan.proBrandingTitle}
        text={t.plan.proBrandingDesc}
        subtext={t.plan.proBrandingFeature}
        plan={t.plan.proBrandingPlan}
        description={t.plan.proBrandingLabel}
      />
      <PlanCard
        title={t.plan.enterpriseTitle}
        text={t.plan.enterpriseDesc}
        subtext={t.plan.enterpriseFeature}
        plan={t.plan.enterprisePlan}
        description={t.plan.enterpriseLabel}
        isHighlighted=true
      />
    </div>
  </div>
</section>

<style>
  .container {
    max-width: none;
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 5%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  #title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 90%;
  }

  .section-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-secondary);
    margin: 0 0 4rem 0;
    line-height: 1.5;
    max-width: 70%;
  }

  .card_container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    gap: 2rem;
    margin-top: auto;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .container {
      padding: 4rem 5%;
      text-align: center;
      align-items: center;
      justify-content: center;
    }

    .content-wrapper {
      align-items: center;
    }

    #title {
      max-width: 100%;
      margin-bottom: 1rem;
    }

    .section-subtitle {
      max-width: 100%;
      margin-bottom: 3rem;
    }

    .card_container {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 4%;
    }

    .card_container {
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 2rem 4%;
    }
  }
</style>
