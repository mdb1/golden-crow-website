---
import Card from "../components/Card.astro";
import Item from "../components/Item.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section id="screen3" class="body">
  <div class="content-wrapper">
    <div class="container">
      <h1 class="title">
        <span class="title-accent">{t.moreToCome.title1}</span>
        <span class="title-main">{t.moreToCome.title2}</span>
      </h1>
      <h3 class="subtitle">
        {t.moreToCome.description}
      </h3>
      <div class="features-container">
        <div class="features-list">
          <Item title={t.moreToCome.sportsTitle} description={t.moreToCome.sportsDesc}/>
          <Item title={t.moreToCome.personalityTitle} description={t.moreToCome.personalityDesc}/>
          <Item title={t.moreToCome.physicalTitle} description={t.moreToCome.physicalDesc}/>
          <Item title={t.moreToCome.cognitiveTitle} description={t.moreToCome.cognitiveDesc}/>
          <Item title={t.moreToCome.endlessTitle} description={t.moreToCome.endlessDesc}/>
        </div>
      </div>
    </div>
    <div class="image-wrapper">
      <div class="image_row">
        <Card src="/more1.webp" alt="" text={t.moreToCome.cardSports}/>
        <Card src="/more2.webp" alt="" text={t.moreToCome.cardPersonality}/>
        <Card src="/more3.webp" alt="" text={t.moreToCome.cardPhysical}/>
      </div>
      <div class="image_row">
          <Card src="/more4.webp" alt="" text={t.moreToCome.cardCognitive}/>
          <Card src="/more5.webp" alt="" text={t.moreToCome.cardVariants}/>
          <Card src="/more6.webp" alt="" text={t.moreToCome.cardDeep}/>
      </div>
    </div>
  </div>
</section>

<style>
  .body {
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    overflow-x: hidden;
    display: flex;
    align-items: center;
    padding: 5rem 5%;
    box-sizing: border-box;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 5rem;
    box-sizing: border-box;
  }

  .container {
    flex: 1;
    max-width: 45%;
    position: relative;
    box-sizing: border-box;
  }

  .title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    margin: 0 0 1.5rem 0;
    line-height: 1.2;
  }

  .title-accent {
    display: inline;
    color: var(--brand-color);
    margin-right: 0.5rem;
  }

  .title-main {
    display: inline;
    color: var(--text-primary);
  }

  .subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 3rem 0;
    font-weight: 400;
  }

  .features-container {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .image-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
    max-width: 50%;
    min-width: 600px;
  }

  .image_row {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    width: 100%;
    justify-content: center;
    align-items: stretch;
  }

  .image_row > * {
    flex: 0 0 auto;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .content-wrapper {
      flex-direction: column;
      gap: 4rem;
      text-align: center;
    }

    .container {
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
    }

    .image-wrapper {
      max-width: 100%;
      min-width: unset;
      gap: 2rem;
    }

    .image_row {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
      align-items: stretch;
    }
  }

  @media (min-width: 1201px) {
    .content-wrapper {
      align-items: flex-start;
    }

    .container {
      padding-right: 2rem;
    }
  }

  @media (max-width: 768px) {
    .body {
      padding: 3rem 0;
      box-sizing: border-box;
    }

    .content-wrapper {
      gap: 3rem;
      padding: 0 1.25rem;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .container {
      padding: 0;
      width: 100%;
      max-width: 100%;
    }

    .features-container {
      padding: 0;
      margin: 0;
      width: 100%;
      max-width: 100%;
    }

    .image_row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      justify-items: center;
      align-items: start;
    }
  }

  @media (max-width: 480px) {
    .body {
      padding: 2rem 0;
      box-sizing: border-box;
    }

    .content-wrapper {
      gap: 2rem;
      padding: 0 1rem;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .container {
      padding: 0;
      width: 100%;
      max-width: 100%;
    }

    .features-container {
      padding: 0;
      margin: 0;
      width: 100%;
      max-width: 100%;
    }

    .features-list {
      padding: 0;
      margin: 0;
      width: 100%;
      max-width: 100%;
    }

    .image-wrapper {
      gap: 1.5rem;
      padding: 0;
      width: 100%;
      max-width: 100%;
    }

    .image_row {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }
  }

  @media (max-width: 390px) {
    .body {
      padding: 1.5rem 0;
      box-sizing: border-box;
    }

    .content-wrapper {
      padding: 0 0.75rem;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .container {
      padding: 0;
      width: 100%;
      max-width: 100%;
    }

    .features-container {
      padding: 0;
      margin: 0;
      width: 100%;
      max-width: 100%;
    }

    .features-list {
      gap: 0.375rem;
      width: 100%;
      max-width: 100%;
      padding: 0;
      margin: 0;
    }
  }

  @media (max-width: 375px) {
    .body {
      padding: 1.5rem 0;
    }

    .content-wrapper {
      padding: 0 0.5rem;
      box-sizing: border-box;
    }

    .container {
      padding: 0;
    }

    .features-container {
      padding: 0;
      margin: 0;
    }

    .features-list {
      gap: 0.25rem;
      padding: 0;
      margin: 0;
    }
  }
</style>
