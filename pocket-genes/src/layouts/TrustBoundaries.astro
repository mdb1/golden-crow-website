---
import { useTranslations } from '../i18n/index';

const t = useTranslations(Astro.currentLocale);
---

<section class="trust-boundaries">
  <div class="content-wrapper">
    <div class="section-header">
      <p class="eyebrow">{t.integrationRevamp.trust.eyebrow}</p>
      <h2 class="section-title">
        <span class="title-accent">{t.integrationRevamp.trust.title1}</span>
        <span class="title-main">{t.integrationRevamp.trust.title2}</span>
      </h2>
      <p class="section-description">{t.integrationRevamp.trust.description}</p>
    </div>

    <div class="trust-grid">
      {t.integrationRevamp.trust.cards.map((card) => (
        <article class="trust-card" tabindex="0">
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-boundaries {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 5%;
    overflow: hidden;
  }

  .content-wrapper {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .section-header {
    max-width: 820px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--brand-color);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.06;
  }

  .title-accent,
  .title-main {
    display: block;
  }

  .title-accent {
    color: var(--text-secondary);
    font-size: 0.58em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-description {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .trust-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1.5rem;
    box-shadow: var(--card-shadow);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .trust-card::before,
  .trust-card::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .trust-card::before {
    inset: 0;
    background: linear-gradient(135deg, rgba(175, 130, 50, 0.14), rgba(175, 130, 50, 0));
  }

  .trust-card::after {
    right: -2.5rem;
    top: -2.5rem;
    width: 7rem;
    height: 7rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(175, 130, 50, 0.24), rgba(175, 130, 50, 0));
    transform: scale(0.72);
  }

  .trust-card:hover,
  .trust-card:focus-visible {
    transform: translateY(-0.55rem);
    border-color: rgba(175, 130, 50, 0.35);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 24px 58px rgba(17, 24, 39, 0.13), 0 0 0 1px rgba(175, 130, 50, 0.1);
  }

  .trust-card:hover::before,
  .trust-card:hover::after,
  .trust-card:focus-visible::before,
  .trust-card:focus-visible::after {
    opacity: 1;
  }

  .trust-card:hover::after,
  .trust-card:focus-visible::after {
    transform: scale(1);
  }

  .trust-card:focus-visible {
    outline: 3px solid rgba(175, 130, 50, 0.3);
    outline-offset: 5px;
  }

  .trust-card h3 {
    margin: 0 0 0.75rem;
    color: var(--text-primary);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.25;
    transition: color 0.3s ease;
  }

  .trust-card p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.65;
    transition: color 0.3s ease;
  }

  .trust-card:hover h3,
  .trust-card:focus-visible h3 {
    color: var(--brand-color);
  }

  .trust-card:hover p,
  .trust-card:focus-visible p {
    color: var(--text-primary);
  }

  @media (max-width: 980px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .trust-boundaries {
      padding: clamp(2.75rem, 8vw, 4rem) 5%;
    }

    .trust-grid {
      grid-template-columns: 1fr;
    }

    .trust-card:hover,
    .trust-card:focus-visible {
      transform: translateY(-0.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-card,
    .trust-card::before,
    .trust-card::after,
    .trust-card h3,
    .trust-card p {
      transition: none;
    }
  }
</style>
