---
import ListItem from "../components/ListItem.astro";
import PanelImage from "../components/PanelImage.astro"
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section id="screen3" class="panels_body">
  <div class="content-wrapper">
    <div class="panels_container">
      <div class="section-header">
        <h1 class="panels_title">
          <span class="title-highlight">{t.panels.title1}</span>
          <span class="title-main">{t.panels.title2}</span>
        </h1>
        <p class="panels_subtitle">
          {t.panels.description}
        </p>
      </div>
      <div class="panels-grid">
        <ListItem
          title={t.panels.healthTitle}
          description={t.panels.healthDesc}
          color="primary"
        />
        <ListItem
          title={t.panels.nutritionTitle}
          description={t.panels.nutritionDesc}
          color="secondary"
        />
        <ListItem
          title={t.panels.medicationTitle}
          description={t.panels.medicationDesc}
          color="success"
        />
        <ListItem
          title={t.panels.ancestryTitle}
          description={t.panels.ancestryDesc}
          color="accent"
        />
        <ListItem
          title={t.panels.educationTitle}
          description={t.panels.educationDesc}
          color="warning"
        />
      </div>
    </div>
    <div class="image-wrapper">
      <PanelImage />
    </div>
  </div>
</section>

<style>
  .panels_body {
    position: relative;
    min-height: 100vh;
    background: var(--bg-secondary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: clamp(3rem, 6vw, 5rem) clamp(2%, 5vw, 5%);
    z-index: 10;
    position: relative;
  }

  .content-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5rem;
    position: relative;
    z-index: 2;
  }

  .panels_container {
    flex: 1;
    max-width: 50%;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .panels_title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .title-highlight {
    display: block;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.7em;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  .panels_subtitle {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 90%;
  }

  .panels-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .image-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .content-wrapper {
      flex-direction: column;
      gap: 4rem;
      text-align: center;
    }

    .panels_container {
      max-width: 100%;
    }

    .section-header {
      margin-bottom: 2.5rem;
    }

    .panels_subtitle {
      max-width: 100%;
    }

    .panels-grid {
      max-width: 600px;
      margin: 0 auto;
    }
  }

  @media (max-width: 850px) {
    .panels_body {
      padding: 3rem 4%;
    }

    .content-wrapper {
      gap: 3rem;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .panels-grid {
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .panels_body {
      padding: 2rem 4%;
    }

    .content-wrapper {
      gap: 2rem;
    }

    .panels-grid {
      gap: 1rem;
    }
  }
</style>
