---
import ListItem from "../components/ListItem.astro";
import PanelImage from "../components/PanelImage.astro"
import { useTranslations } from '../i18n/index';
import { formatBrandText } from '../utils/brandFormatting';
const t = useTranslations(Astro.currentLocale);
---

<section id="screen3" class="panels_body">
  <div class="content-wrapper">
    <div class="panels_container">
      <div class="section-header">
        <h1 class="panels_title">
          <span class="title-highlight" set:html={formatBrandText(t.panels.title1)} />
          <span class="title-main" set:html={formatBrandText(t.panels.title2)} />
        </h1>
        <p class="panels_subtitle" set:html={formatBrandText(t.panels.description)} />
      </div>
      <div class="panels-grid">
        <ListItem
          title={t.panels.healthTitle}
          description={t.panels.healthDesc}
          color="primary"
          panelKeys="reports"
        />
        <ListItem
          title={t.panels.nutritionTitle}
          description={t.panels.nutritionDesc}
          color="secondary"
          panelKeys="genetics-learning"
        />
        <ListItem
          title={t.panels.medicationTitle}
          description={t.panels.medicationDesc}
          color="success"
          panelKeys="medical-questions"
        />
        <ListItem
          title={t.panels.ancestryTitle}
          description={t.panels.ancestryDesc}
          color="accent"
          panelKeys="rarefriends"
        />
        <ListItem
          title={t.panels.educationTitle}
          description={t.panels.educationDesc}
          color="warning"
          panelKeys="provider-directory resources"
        />
      </div>
    </div>
    <div class="image-wrapper">
      <PanelImage />
    </div>
  </div>
</section>

<script>
  const panelSection = document.querySelector('#screen3');

  if (panelSection) {
    const cards = Array.from(panelSection.querySelectorAll('[data-panel-card]'));
    const nodes = Array.from(panelSection.querySelectorAll('[data-panel-node]'));
    const hubs = Array.from(panelSection.querySelectorAll('[data-panel-hub]'));
    const interactiveElements = [...cards, ...nodes, ...hubs];

    const readKeys = (element) =>
      (element.getAttribute('data-panel-keys') || '')
        .split(/\s+/)
        .filter(Boolean);

    const hasSharedKey = (element, activeKeys) => {
      const keys = readKeys(element);
      return keys.some((key) => activeKeys.includes(key));
    };

    const setActive = (source) => {
      const activeKeys = readKeys(source);
      if (!activeKeys.length) return;

      panelSection.setAttribute('data-active-panel', activeKeys.join(' '));

      for (const element of [...cards, ...nodes]) {
        const isActive = hasSharedKey(element, activeKeys);
        element.classList.toggle('is-linked-active', isActive);
        element.classList.toggle('is-linked-dimmed', !isActive);
      }

      for (const hub of hubs) {
        hub.classList.add('is-linked-active');
      }
    };

    const clearActive = () => {
      panelSection.removeAttribute('data-active-panel');

      for (const element of interactiveElements) {
        element.classList.remove('is-linked-active', 'is-linked-dimmed');
      }
    };

    for (const element of interactiveElements) {
      element.addEventListener('pointerenter', () => setActive(element));
      element.addEventListener('pointerleave', clearActive);
      element.addEventListener('focusin', () => setActive(element));
      element.addEventListener('focusout', clearActive);
    }
  }
</script>

<style>
  .panels_body {
    position: relative;
    min-height: 100vh;
    background: var(--bg-secondary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: clamp(3rem, 6vw, 5rem) clamp(2%, 5vw, 5%);
    z-index: 10;
    position: relative;
  }

  .content-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5rem;
    position: relative;
    z-index: 2;
  }

  .panels_container {
    flex: 1;
    max-width: 50%;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .panels_title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .title-highlight {
    display: block;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.7em;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  .panels_subtitle {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 90%;
  }

  .panels-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .image-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .content-wrapper {
      flex-direction: column;
      gap: 4rem;
      text-align: center;
    }

    .panels_container {
      max-width: 100%;
    }

    .section-header {
      margin-bottom: 2.5rem;
    }

    .panels_subtitle {
      max-width: 100%;
    }

    .panels-grid {
      max-width: 600px;
      margin: 0 auto;
    }
  }

  @media (max-width: 850px) {
    .panels_body {
      padding: 3rem 4%;
    }

    .content-wrapper {
      gap: 3rem;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .panels-grid {
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .panels_body {
      padding: 2rem 4%;
    }

    .content-wrapper {
      gap: 2rem;
    }

    .panels-grid {
      gap: 1rem;
    }
  }
</style>
