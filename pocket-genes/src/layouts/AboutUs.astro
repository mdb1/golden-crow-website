---
import TeamCard from "../components/TeamCard.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<div class="container">
  <div class="content-wrapper">
    <div class="section-header">
      <h1 class="team-title">
        <span class="title-gradient">{t.aboutUs.title1}</span> {t.aboutUs.title2}
      </h1>
    </div>
    <div class="image_container">
      <TeamCard
        src="/aboutus1.png"
        alt="Team1"
        text={t.aboutUs.manuelName}
        description={t.aboutUs.manuelRole}
        skills={["LEADERSHIP"]}
      />
      <TeamCard
        src="/aboutus2.png"
        alt="Team2"
        text={t.aboutUs.federicoName}
        description={t.aboutUs.federicoRole}
        skills={["LEADERSHIP", "INNOVATION"]}
      />
      <TeamCard
        src="/aboutus3.png"
        alt="Team3"
        text={t.aboutUs.santiagoName}
        description={t.aboutUs.santiagoRole}
        skills={["MARKETING"]}
      />
      <TeamCard
        src="/aboutus4.png"
        alt="Team4"
        text={t.aboutUs.matiasName}
        description={t.aboutUs.matiasRole}
        skills={["ENGINEERING"]}
      />
    </div>
  </div>
</div>

<style>
  .container {
    max-width: none;
    position: relative;
    background: var(--bg-primary);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 5%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .team-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .title-gradient {
    color: var(--brand-color);
  }

  .team-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: var(--text-secondary);
    font-weight: 400;
    line-height: 1.6;
  }

  .image_container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .container {
      padding: 4rem 5%;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    .image_container {
      gap: 1.5rem;
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 2rem 4%;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .team-title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
    }

    .team-subtitle {
      font-size: clamp(1rem, 4vw, 1.2rem);
    }

    .image_container {
      flex-direction: column;
      gap: 1.5rem;
      align-items: center;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 1.5rem 1rem;
      box-sizing: border-box;
    }

    .section-header {
      margin-bottom: 1.5rem;
    }

    .team-title {
      font-size: clamp(1.5rem, 6vw, 2rem);
      margin-bottom: 0.75rem;
    }

    .team-subtitle {
      font-size: clamp(0.9rem, 4.5vw, 1rem);
    }

    .image_container {
      gap: 1.25rem;
      width: 100%;
      max-width: 100%;
      padding: 0;
    }
  }

  @media (max-width: 390px) {
    .container {
      padding: 1.25rem 0.75rem;
      box-sizing: border-box;
    }

    .image_container {
      gap: 1rem;
      padding: 0;
      width: 100%;
    }
  }

  @media (max-width: 320px) {
    .container {
      padding: 1rem 0.5rem;
      box-sizing: border-box;
    }

    .team-title {
      font-size: 1.5rem;
    }

    .team-subtitle {
      font-size: 0.875rem;
    }

    .image_container {
      gap: 0.75rem;
      width: 100%;
      padding: 0;
    }
  }
</style>
