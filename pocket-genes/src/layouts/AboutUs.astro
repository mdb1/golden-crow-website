---
import TeamCard from "../components/TeamCard.astro";
import Carousel from "../components/Carousel.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<div class="container">
  <div class="content-wrapper">
    <div class="section-header">
      <h1 class="team-title">
        <span class="title-gradient">{t.aboutUs.title1}</span> {t.aboutUs.title2}
      </h1>
    </div>
    <Carousel
      ariaLabel="Team members"
      showDots={false}
      itemFlexMobile="0 0 auto"
      itemFlexTablet="0 0 auto"
      itemFlexDesktop="0 0 auto"
      gap="2rem"
    >
      <TeamCard
        src="/aboutus1.webp"
        alt="Manuel Herrera"
        text={t.aboutUs.manuelName}
        description={t.aboutUs.manuelRole}
        skills={["LEADERSHIP"]}
        linkedinUrl="https://www.linkedin.com/in/manuh/"
      />
      <TeamCard
        src="/aboutus2.webp"
        alt="Federico Bustos"
        text={t.aboutUs.federicoName}
        description={t.aboutUs.federicoRole}
        skills={["LEADERSHIP", "INNOVATION"]}
        linkedinUrl="https://www.linkedin.com/in/federico-bustos-fierro/"
      />
      <TeamCard
        src="/aboutus3.webp"
        alt="Santiago Canosa"
        text={t.aboutUs.santiagoName}
        description={t.aboutUs.santiagoRole}
        skills={["LEADERSHIP", "GROWTH"]}
        linkedinUrl="https://www.linkedin.com/in/santiagocanosa/"
      />
      <TeamCard
        src="/aboutus5.webp"
        alt="Leonardo Saqueta"
        text={t.aboutUs.leonardoName}
        description={t.aboutUs.leonardoRole}
        skills={["PRODUCT"]}
        linkedinUrl="https://www.linkedin.com/in/leonardo-saqueta-melo/"
      />
      <TeamCard
        src="/aboutus6.webp"
        alt="Lucio Filetto"
        text={t.aboutUs.lucioName}
        description={t.aboutUs.lucioRole}
        skills={["ENGINEERING"]}
        linkedinUrl="https://www.linkedin.com/in/lucio-filetto-a8165b174/"
      />
      <TeamCard
        src="/aboutus7.webp"
        alt="Marco Filetto"
        text={t.aboutUs.marcoName}
        description={t.aboutUs.marcoRole}
        skills={["ENGINEERING"]}
        linkedinUrl="https://www.linkedin.com/in/mfiletto/"
      />
      <TeamCard
        src="/aboutus8.webp"
        alt="Sebastian Posadas"
        text={t.aboutUs.sebastianName}
        description={t.aboutUs.sebastianRole}
        skills={["ENGINEERING"]}
        linkedinUrl="https://www.linkedin.com/in/scaposadas/"
      />
      <TeamCard
        src="/aboutus9.webp"
        alt="Nicolas Carba"
        text={t.aboutUs.nicolasName}
        description={t.aboutUs.nicolasRole}
        skills={["ENGINEERING"]}
        linkedinUrl="https://www.linkedin.com/in/nicolas-c-49167a9a/"
      />
      <TeamCard
        src="/aboutus4.webp"
        alt="Matias Ezcurra"
        text={t.aboutUs.matiasName}
        description={t.aboutUs.matiasRole}
        skills={["ENGINEERING"]}
      />
    </Carousel>
  </div>
</div>

<style>
  .container {
    max-width: none;
    position: relative;
    background: var(--bg-primary);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 5%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .team-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .title-gradient {
    color: var(--brand-color);
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .container {
      padding: 4rem 5%;
    }

    .section-header {
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 2rem 4%;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .team-title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 1.5rem 1rem;
      box-sizing: border-box;
    }

    .section-header {
      margin-bottom: 1.5rem;
    }

    .team-title {
      font-size: clamp(1.5rem, 6vw, 2rem);
      margin-bottom: 0.75rem;
    }
  }

  @media (max-width: 390px) {
    .container {
      padding: 1.25rem 0.75rem;
      box-sizing: border-box;
    }
  }

  @media (max-width: 320px) {
    .container {
      padding: 1rem 0.5rem;
      box-sizing: border-box;
    }

    .team-title {
      font-size: 1.5rem;
    }
  }
</style>
