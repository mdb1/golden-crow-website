---
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section id="screen2" class="interactive">
  <div class="content-wrapper">
    <div class="text">
      <h1 class="section-title">
        <span class="title-accent">{t.secondSection.title1}</span>
        <span class="title-main">{t.secondSection.title2}</span>
      </h1>
      <p class="section-description">
        {t.secondSection.description}
      </p>
      <div class="feature-highlights">
        <div class="highlight-item">
          <span class="highlight-icon">&#x1F4CA;</span>
          <span>{t.secondSection.interactiveReports}</span>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">&#x1F3A8;</span>
          <span>{t.secondSection.beautifulUI}</span>
        </div>
      </div>
    </div>
    <div class="image-wrapper">
      <div class="image-card">
        <div class="lightning"></div>
        <img src="/interactive1.png" alt={t.secondSection.appAlt} />
      </div>
    </div>
  </div>
</section>

<style>
  .interactive {
    position: relative;
    min-height: 100vh;
    background: var(--bg-secondary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 5rem 8%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  /* TEXT STYLES */
  .text {
    flex: 1;
    max-width: 55%;
    position: relative;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 2rem 0;
  }

  .title-accent {
    display: block;
    color: var(--text-secondary);
    font-size: 0.7em;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  .section-description {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
    max-width: 90%;
  }

  .feature-highlights {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1.5rem;
    padding: 1rem 1.5rem;
    box-shadow: var(--card-shadow);
    transition: all 0.3s ease;
    color: var(--text-primary);
    font-weight: 500;
  }

  .highlight-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }

  .highlight-icon {
    font-size: 1.25rem;
  }

  /* IMAGE STYLES */
  .image-wrapper {
    flex: 1;
    max-width: 45%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .image-card {
    position: relative;
    width: 100%;
    max-width: 400px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    box-shadow: var(--card-shadow);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    transform: rotate(5deg);
    padding: 1rem;
  }

  .image-card:hover {
    transform: rotate(5deg) translateY(-10px) scale(1.05);
    box-shadow: var(--card-shadow-hover);
  }

  .image-card img {
    width: 100%;
    height: auto;
    border-radius: 1.5rem;
    transition: all 0.3s ease;
  }

  .image-card:hover img {
    transform: scale(1.02);
  }

  /* LIGHTNING SHIMMER EFFECT */
  .lightning {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    transition: left 0.3s ease-out;
    z-index: 1;
  }

  .image-card:hover .lightning {
    left: 120%;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .content-wrapper {
      flex-direction: column;
      text-align: center;
      gap: 3rem;
    }

    .text {
      max-width: 100%;
    }

    .image-wrapper {
      max-width: 60%;
    }

    .feature-highlights {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .interactive {
      padding: 3rem 5%;
      min-height: 80vh;
    }

    .content-wrapper {
      gap: 2rem;
    }

    .image-wrapper {
      max-width: 80%;
    }

    .image-card {
      transform: rotate(2deg);
      max-width: 320px;
    }

    .image-card:hover {
      transform: rotate(2deg) translateY(-5px) scale(1.02);
    }

    .feature-highlights {
      gap: 1rem;
    }

    .highlight-item {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .interactive {
      padding: 2rem 4%;
    }

    .feature-highlights {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .highlight-item {
      width: fit-content;
    }

    .image-card {
      max-width: 280px;
    }
  }
</style>
