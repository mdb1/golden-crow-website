---
import ExperienceCard from '../components/ExperienceCard.astro'
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<div class="container">
  <div class="content-wrapper">
    <div class="left">
      <div class="text-content">
        <h1 class="title">
          <span class="title-gradient">{t.experience.title1}</span> {t.experience.title2}
        </h1>
        <div class="experience-stats">
          <div class="stat-item">
            <span class="stat-number">{t.experience.years}</span>
            <span class="stat-label">{t.experience.yearsLabel}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{t.experience.decade}</span>
            <span class="stat-label">{t.experience.decadeLabel}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{t.experience.projects}</span>
            <span class="stat-label">{t.experience.projectsLabel}</span>
          </div>
        </div>
        <p class="text highlight-text">
          {t.experience.paragraph1}
        </p>
        <p class="text">
          {t.experience.paragraph2}
        </p>
        <p class="text emphasis-text">
          {t.experience.paragraph3}
        </p>
      </div>
    </div>
    <div class="experiences_container">
      <ExperienceCard src="/experience1.png" alt="" text={t.experience.strongerUTitle} description={t.experience.strongerUDesc}/>
      <ExperienceCard src="/experience2.png" alt="" text={t.experience.anytimeTitle} description={t.experience.anytimeDesc}/>
    </div>
  </div>
</div>

<style>
  .container {
    max-width: none;
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 5rem 5%;
  }

  .content-wrapper {
    width: 100%;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .left {
    grid-row: 1 / -1;
  }

  .text-content {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    padding: 3rem;
    box-shadow: var(--card-shadow);
    height: 100%;
  }

  .title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .title-gradient {
    color: var(--brand-color);
  }

  .experience-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
  }

  .stat-item {
    text-align: center;
    flex: 1;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--brand-color);
  }

  .stat-label {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .text {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .highlight-text {
    font-size: clamp(1.1rem, 2.8vw, 1.4rem);
    color: var(--brand-color);
    font-weight: 600;
  }

  .emphasis-text {
    font-weight: 600;
    color: var(--text-accent);
    font-style: italic;
    margin-bottom: 0;
  }

  .experiences_container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    grid-row: 1 / -1;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .content-wrapper {
      text-align: center;
    }

    .experience-stats {
      justify-content: center;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 4%;
    }

    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .text-content {
      padding: 2rem;
    }

    .experience-stats {
      flex-direction: row;
      gap: 2rem;
    }

    .experiences_container {
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 2rem 4%;
    }

    .text-content {
      padding: 1.5rem;
    }

    .experience-stats {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem 0;
    }

    .stat-number {
      font-size: 1.5rem;
    }
  }
</style>
