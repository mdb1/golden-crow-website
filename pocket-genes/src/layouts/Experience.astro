---
import ExperienceCard from '../components/ExperienceCard.astro'
import ExperienceCardMobile from '../components/ExperienceCardMobile.astro'
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<!-- Desktop layout -->
<div class="experience-section">
  <div class="content-wrapper">
    <div class="left">
      <div class="text-content">
        <h1 class="title">
          <span class="title-gradient">{t.experience.title1}</span> {t.experience.title2}
        </h1>
        <div class="experience-stats">
          <div class="stat-item">
            <span class="stat-number">{t.experience.years}</span>
            <span class="stat-label">{t.experience.yearsLabel}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{t.experience.decade}</span>
            <span class="stat-label">{t.experience.decadeLabel}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{t.experience.projects}</span>
            <span class="stat-label">{t.experience.projectsLabel}</span>
          </div>
        </div>
        <p class="text highlight-text">
          {t.experience.paragraph1}
        </p>
        <p class="text">
          {t.experience.paragraph2}
        </p>
        <p class="text emphasis-text">
          {t.experience.paragraph3}
        </p>
      </div>
    </div>
    <div class="experiences_container">
      <ExperienceCard src="/experience1.png" alt="" text={t.experience.strongerUTitle} description={t.experience.strongerUDesc}/>
      <ExperienceCard src="/experience2.png" alt="" text={t.experience.anytimeTitle} description={t.experience.anytimeDesc}/>
    </div>
  </div>
</div>

<!-- Mobile layout -->
<div class="mobile-experience">
  <div class="mobile-container">
    <h1 class="mobile-title">
      <span class="mobile-title-gradient">{t.experience.title1}</span> {t.experience.title2}
    </h1>

    <div class="mobile-stats">
      <div class="mobile-stat-item">
        <span class="mobile-stat-number">{t.experience.years}</span>
        <span class="mobile-stat-label">{t.experience.yearsLabel}</span>
      </div>
      <div class="mobile-stat-item">
        <span class="mobile-stat-number">{t.experience.decade}</span>
        <span class="mobile-stat-label">{t.experience.decadeLabel}</span>
      </div>
      <div class="mobile-stat-item">
        <span class="mobile-stat-number">{t.experience.projects}</span>
        <span class="mobile-stat-label">{t.experience.projectsLabel}</span>
      </div>
    </div>

    <p class="mobile-text">{t.experience.paragraph2}</p>
    <p class="mobile-emphasis">{t.experience.paragraph3}</p>

    <div class="mobile-cards">
      <ExperienceCardMobile src="/experience1.png" alt="" text={t.experience.strongerUTitle} description={t.experience.strongerUDesc}/>
      <ExperienceCardMobile src="/experience2.png" alt="" text={t.experience.anytimeTitle} description={t.experience.anytimeDesc}/>
    </div>
  </div>
</div>

<style>
  /* === Desktop styles === */
  .experience-section {
    max-width: none;
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 5rem 5%;
  }

  .content-wrapper {
    width: 100%;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .left {
    grid-row: 1 / -1;
  }

  .text-content {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    padding: 3rem;
    box-shadow: var(--card-shadow);
    height: 100%;
  }

  .title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .title-gradient {
    color: var(--brand-color);
  }

  .experience-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
  }

  .stat-item {
    text-align: center;
    flex: 1;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--brand-color);
  }

  .stat-label {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .text {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .highlight-text {
    font-size: clamp(1.1rem, 2.8vw, 1.4rem);
    color: var(--brand-color);
    font-weight: 600;
  }

  .emphasis-text {
    font-weight: 600;
    color: var(--text-accent);
    font-style: italic;
    margin-bottom: 0;
  }

  .experiences_container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    grid-row: 1 / -1;
  }

  /* === Desktop/Mobile toggle === */
  .mobile-experience {
    display: none;
  }

  /* Desktop responsive */
  @media (max-width: 1200px) {
    .content-wrapper {
      text-align: center;
    }

    .experience-stats {
      justify-content: center;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    /* Hide desktop, show mobile */
    .experience-section {
      display: none;
    }

    .mobile-experience {
      display: block;
    }
  }

  /* === Mobile styles === */
  .mobile-experience {
    background: var(--bg-primary);
  }

  .mobile-container {
    padding: 3rem 5%;
  }

  .mobile-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-align: center;
  }

  .mobile-title-gradient {
    color: var(--brand-color);
  }

  .mobile-stats {
    display: flex;
    justify-content: space-around;
    padding: 1.25rem 0;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
  }

  .mobile-stat-item {
    text-align: center;
  }

  .mobile-stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand-color);
  }

  .mobile-stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .mobile-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    text-align: center;
  }

  .mobile-emphasis {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-accent);
    font-weight: 600;
    font-style: italic;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .mobile-container {
      padding: 2rem 4%;
    }

    .mobile-title {
      font-size: 1.5rem;
    }

    .mobile-stat-number {
      font-size: 1.25rem;
    }
  }
</style>
