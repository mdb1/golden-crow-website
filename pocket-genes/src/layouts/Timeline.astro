---
import Quarter from "../components/Quarter.astro";
import Separator from "../components/Separator.astro";
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<div class="container">
  <h1 class="title">{t.timeline.title}</h1>
  <div class="quarter_container">
    <Quarter
      time={t.timeline.q1Period}
      text_1={t.timeline.q1Title1}
      text_2={t.timeline.q1Title2}
      items={t.timeline.q1Items}
    />
    <Separator />
    <Quarter
      time={t.timeline.q2Period}
      text_1={t.timeline.q2Title1}
      text_2={t.timeline.q2Title2}
      items={t.timeline.q2Items}
    />
    <Separator />
    <Quarter
      time={t.timeline.q3Period}
      text_1={t.timeline.q3Title1}
      text_2={t.timeline.q3Title2}
      items={t.timeline.q3Items}
    />
    <Separator />
    <Quarter
      time={t.timeline.q4Period}
      text_1={t.timeline.q4Title1}
      text_2={t.timeline.q4Title2}
      items={t.timeline.q4Items}
    />
  </div>
</div>

<style>
  .container {
    max-width: none;
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding: 2rem 0;
  }

  .quarter_container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    position: relative;
    z-index: 2;
    padding: 0 2rem;
  }

  .title {
    color: var(--brand-color);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    margin: 2rem 4rem 4rem 4rem;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 1440px) {
    .container {
      min-height: auto;
      padding: 3rem 0;
    }
    .title {
      margin: 2rem;
    }
    .quarter_container {
      flex-direction: column;
      align-items: center;
      gap: 3rem;
      padding: 0 1rem;
    }
    .quarter_container > * {
      margin-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .quarter_container {
      gap: 1.5rem;
      padding: 0 1rem;
      width: 100%;
    }

    .title {
      margin: 1.5rem 1rem 2rem 1rem;
    }
  }
</style>
