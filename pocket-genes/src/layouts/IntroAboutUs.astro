---
import { useTranslations } from '../i18n/index';
const t = useTranslations(Astro.currentLocale);
---

<section class="container">
  <div class="content-wrapper">
    <h1 class="title">
      <span class="title-accent">{t.introAboutUs.title1}</span>
      <span class="title-main">{t.introAboutUs.title2}</span>
    </h1>
    <p class="description">{t.introAboutUs.description}</p>
    <div class="mission-highlights">
      <div class="highlight-card">
        <span class="highlight-icon">&#x1F9EC;</span>
        <div class="highlight-content">
          <h3>{t.introAboutUs.missionTitle}</h3>
          <p>{t.introAboutUs.missionDesc}</p>
        </div>
      </div>
      <div class="highlight-card">
        <span class="highlight-icon">&#x1F680;</span>
        <div class="highlight-content">
          <h3>{t.introAboutUs.visionTitle}</h3>
          <p>{t.introAboutUs.visionDesc}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: none;
    position: relative;
    min-height: 100vh;
    background: var(--bg-secondary);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 5rem 8%;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 80%;
  }

  .title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 2rem 0;
  }

  .title-accent {
    display: block;
    color: var(--text-secondary);
    font-size: 0.75em;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .title-main {
    display: block;
    color: var(--text-primary);
  }

  .description {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--text-secondary);
    margin: 0 0 4rem 0;
    line-height: 1.6;
    max-width: 95%;
    font-weight: 400;
  }

  .mission-highlights {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .highlight-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 2rem;
    padding: 2rem 1.75rem;
    box-shadow: var(--card-shadow);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 320px;
    max-width: 380px;
    position: relative;
    overflow: hidden;
  }

  .highlight-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--card-shadow-hover);
  }

  .highlight-icon {
    font-size: 1.75rem;
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(64, 37, 239, 0.08);
    border-radius: 50%;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .highlight-card:hover .highlight-icon {
    transform: scale(1.1) rotate(10deg);
    background: rgba(64, 37, 239, 0.12);
  }

  .highlight-content h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .highlight-content p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .container {
      text-align: center;
      justify-content: center;
    }

    .content-wrapper {
      max-width: 100%;
    }

    .mission-highlights {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 5%;
      min-height: 80vh;
    }

    .mission-highlights {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .highlight-card {
      min-width: auto;
      max-width: 100%;
      width: 100%;
      padding: 1.75rem 1.5rem;
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .highlight-icon {
      width: 44px;
      height: 44px;
      font-size: 1.6rem;
      margin: 0 auto;
    }

    .highlight-content h3 {
      font-size: 1.3rem;
    }

    .highlight-content p {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 2rem 1rem;
      min-height: 70vh;
    }

    .mission-highlights {
      gap: 1.25rem;
      padding: 0 1rem;
    }

    .highlight-card {
      padding: 1.25rem 1rem;
      gap: 0.75rem;
      min-width: auto;
      max-width: calc(100% - 2rem);
      width: calc(100% - 2rem);
    }

    .highlight-icon {
      width: 40px;
      height: 40px;
      font-size: 1.4rem;
    }

    .highlight-content h3 {
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
    }

    .highlight-content p {
      font-size: 1rem;
      line-height: 1.4;
    }
  }

  @media (max-width: 390px) {
    .container {
      padding: 1.5rem 0.75rem;
    }

    .mission-highlights {
      padding: 0 0.5rem;
    }

    .highlight-card {
      padding: 1rem 0.875rem;
      min-width: auto;
      max-width: calc(100% - 1rem);
      width: calc(100% - 1rem);
    }

    .highlight-icon {
      width: 36px;
      height: 36px;
      font-size: 1.3rem;
    }

    .highlight-content h3 {
      font-size: 1.1rem;
    }

    .highlight-content p {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 360px) {
    .container {
      padding: 1.5rem 0.5rem;
    }

    .mission-highlights {
      padding: 0 0.25rem;
    }

    .highlight-card {
      padding: 1rem 0.75rem;
      max-width: calc(100% - 0.5rem);
      width: calc(100% - 0.5rem);
    }
  }
</style>
