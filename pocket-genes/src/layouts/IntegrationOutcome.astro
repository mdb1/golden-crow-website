---
import { useTranslations } from '../i18n/index';
import { formatBrandText } from '../utils/brandFormatting';

const t = useTranslations(Astro.currentLocale);
---

<section class="integration-outcome">
  <div class="content-wrapper">
    <div class="section-header">
      <p class="eyebrow" set:html={formatBrandText(t.integrationRevamp.outcome.eyebrow)} />
      <h2 class="section-title">
        <span class="title-accent" set:html={formatBrandText(t.integrationRevamp.outcome.title1)} />
        <span class="title-main" set:html={formatBrandText(t.integrationRevamp.outcome.title2)} />
      </h2>
      <p class="section-description" set:html={formatBrandText(t.integrationRevamp.outcome.description)} />
    </div>

    <div class="before-after-grid">
      <article class="comparison-card muted-card">
        <h3 set:html={formatBrandText(t.integrationRevamp.outcome.beforeTitle)} />
        <ul>
          {t.integrationRevamp.outcome.beforeItems.map((item) => (
            <li set:html={formatBrandText(item)} />
          ))}
        </ul>
      </article>

      <article class="comparison-card strong-card">
        <h3 set:html={formatBrandText(t.integrationRevamp.outcome.afterTitle)} />
        <ul>
          {t.integrationRevamp.outcome.afterItems.map((item) => (
            <li set:html={formatBrandText(item)} />
          ))}
        </ul>
      </article>
    </div>

    <div class="provider-fit">
      <div class="provider-fit-copy">
        <h3 set:html={formatBrandText(t.integrationRevamp.outcome.providerTitle)} />
        <p set:html={formatBrandText(t.integrationRevamp.outcome.providerDescription)} />
      </div>
      <div class="provider-cards">
        {t.integrationRevamp.outcome.providerTypes.map((provider) => (
          <article class="provider-card">
            <h4 set:html={formatBrandText(provider.title)} />
            <p set:html={formatBrandText(provider.description)} />
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .integration-outcome {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 5%;
    overflow: hidden;
  }

  .content-wrapper {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .section-header {
    max-width: 820px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--brand-color);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.06;
  }

  .title-accent,
  .title-main {
    display: block;
  }

  .title-accent {
    color: var(--text-secondary);
    font-size: 0.58em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-description {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.7;
  }

  .before-after-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .comparison-card,
  .provider-card,
  .provider-fit {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1.5rem;
    box-shadow: var(--card-shadow);
  }

  .comparison-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .comparison-card h3,
  .provider-fit-copy h3 {
    margin: 0 0 1.25rem;
    color: var(--text-primary);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    line-height: 1.2;
  }

  .strong-card {
    border-color: rgba(175, 130, 50, 0.35);
    background: rgba(175, 130, 50, 0.06);
  }

  ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.55;
  }

  li::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--brand-color);
  }

  .muted-card li::before {
    background: var(--text-tertiary);
  }

  .provider-fit {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.5fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .provider-fit-copy p,
  .provider-card p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .provider-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .provider-card {
    --provider-accent: var(--brand-color);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 1.25rem;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      background 220ms ease;
  }

  .provider-card::before,
  .provider-card::after {
    content: '';
    position: absolute;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  .provider-card::before {
    inset: 0 auto 0 0;
    z-index: -1;
    width: 0.32rem;
    background: linear-gradient(180deg, var(--provider-accent), color-mix(in srgb, var(--provider-accent) 35%, transparent));
    opacity: 0.62;
    transform: scaleY(0.34);
    transform-origin: top;
  }

  .provider-card::after {
    inset: auto -22% -45% auto;
    z-index: -2;
    width: 9rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--provider-accent) 18%, transparent);
    filter: blur(14px);
    opacity: 0;
    transform: translate3d(18px, 18px, 0) scale(0.72);
  }

  .provider-card:nth-child(2) {
    --provider-accent: #7c5cff;
  }

  .provider-card:nth-child(3) {
    --provider-accent: #d75f99;
  }

  .provider-card:nth-child(4) {
    --provider-accent: #3bb28a;
  }

  @media (hover: hover) and (pointer: fine) {
    .provider-card:hover {
      transform: translateY(-0.38rem);
      border-color: color-mix(in srgb, var(--provider-accent) 48%, var(--card-border));
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--provider-accent) 10%, transparent), transparent 58%),
        var(--card-bg);
      box-shadow: 0 1.25rem 2.75rem color-mix(in srgb, var(--provider-accent) 18%, transparent), var(--card-shadow);
    }

    .provider-card:hover::before {
      opacity: 1;
      transform: scaleY(1);
    }

    .provider-card:hover::after {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }

    .provider-card:hover h4 {
      color: var(--provider-accent);
      transform: translateX(0.24rem);
    }
  }

  .provider-card h4 {
    margin: 0 0 0.55rem;
    color: var(--text-primary);
    font-size: 1.05rem;
    line-height: 1.25;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .provider-card,
    .provider-card::before,
    .provider-card::after,
    .provider-card h4 {
      transition: none;
    }

    .provider-card:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .before-after-grid,
    .provider-fit,
    .provider-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .integration-outcome {
      padding: clamp(2.75rem, 8vw, 4rem) 5%;
    }

    .comparison-card,
    .provider-fit,
    .provider-card {
      border-radius: 1.1rem;
    }
  }
</style>
