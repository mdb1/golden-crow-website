---
import { useTranslations } from '../i18n/index';

const t = useTranslations(Astro.currentLocale);
---

<section class="integration-journey">
  <div class="content-wrapper">
    <div class="section-header">
      <p class="eyebrow">{t.integrationRevamp.journey.eyebrow}</p>
      <h2 class="section-title">
        <span class="title-accent">{t.integrationRevamp.journey.title1}</span>
        <span class="title-main">{t.integrationRevamp.journey.title2}</span>
      </h2>
      <p class="section-description">{t.integrationRevamp.journey.description}</p>
    </div>

    <div class="steps-grid">
      {t.integrationRevamp.journey.steps.map((step, index) => (
        <article class="step-card">
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .integration-journey {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 5%;
    overflow: hidden;
  }

  .content-wrapper {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .section-header {
    max-width: 820px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--brand-color);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.06;
  }

  .title-accent,
  .title-main {
    display: block;
  }

  .title-accent {
    color: var(--text-secondary);
    font-size: 0.58em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-description {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .step-card {
    min-height: 250px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.8rem);
    box-shadow: var(--card-shadow);
    transition: all 0.3s ease;
  }

  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--card-shadow-hover);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    margin-bottom: 1.25rem;
    background: rgba(175, 130, 50, 0.1);
    color: var(--brand-color);
    font-weight: 900;
  }

  .step-card h3 {
    margin: 0 0 0.75rem;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.25;
  }

  .step-card p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .integration-journey {
      padding: clamp(2.75rem, 8vw, 4rem) 5%;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .step-card {
      min-height: auto;
    }
  }
</style>
