---
import { useTranslations } from '../i18n/index';
import { formatBrandText } from '../utils/brandFormatting';

const t = useTranslations(Astro.currentLocale);
const cycleAngles = ['-90deg', '-18deg', '54deg', '126deg', '198deg'];
const cycleReverseAngles = ['90deg', '18deg', '-54deg', '-126deg', '-198deg'];
const cycleArrowAngles = ['-54deg', '18deg', '90deg', '162deg', '234deg'];
const cyclePalette = [
  {
    color: 'var(--pocket_genes_pink, #e45080)',
    soft: 'rgba(228, 80, 128, 0.12)',
    border: 'rgba(228, 80, 128, 0.34)',
    shadow: 'rgba(228, 80, 128, 0.26)',
  },
  {
    color: 'var(--pg-teal, #14958f)',
    soft: 'rgba(20, 149, 143, 0.12)',
    border: 'rgba(20, 149, 143, 0.32)',
    shadow: 'rgba(20, 149, 143, 0.22)',
  },
  {
    color: 'var(--pg-blue, #2176ae)',
    soft: 'rgba(33, 118, 174, 0.12)',
    border: 'rgba(33, 118, 174, 0.31)',
    shadow: 'rgba(33, 118, 174, 0.22)',
  },
  {
    color: 'var(--pg-green, #3c9b68)',
    soft: 'rgba(60, 155, 104, 0.12)',
    border: 'rgba(60, 155, 104, 0.31)',
    shadow: 'rgba(60, 155, 104, 0.2)',
  },
  {
    color: 'var(--pg-amber, #d99232)',
    soft: 'rgba(217, 146, 50, 0.13)',
    border: 'rgba(217, 146, 50, 0.33)',
    shadow: 'rgba(217, 146, 50, 0.22)',
  },
];
const cycleItems = t.integrationRevamp.discovery.loopItems.map(
  (item, index) => ({
    item,
    angle: cycleAngles[index % cycleAngles.length],
    angleBack: cycleReverseAngles[index % cycleReverseAngles.length],
    arrowAngle: cycleArrowAngles[index % cycleArrowAngles.length],
    delay: `${index * 140}ms`,
    palette: cyclePalette[index % cyclePalette.length],
  }),
);
---

<section id="provider-discovery" class="provider-discovery">
  <div class="content-wrapper">
    <div class="copy-column">
      <p
        class="eyebrow"
        set:html={formatBrandText(t.integrationRevamp.discovery.eyebrow)}
      />
      <h2 class="section-title">
        <span
          class="title-accent"
          set:html={formatBrandText(t.integrationRevamp.discovery.title1)}
        />
        <span
          class="title-main"
          set:html={formatBrandText(t.integrationRevamp.discovery.title2)}
        />
      </h2>
      <p
        class="section-description"
        set:html={formatBrandText(t.integrationRevamp.discovery.description)}
      />
    </div>

    <div class="directory-panel">
      <h3
        set:html={formatBrandText(t.integrationRevamp.discovery.directoryTitle)}
      />
      <p
        set:html={formatBrandText(
          t.integrationRevamp.discovery.directoryDescription,
        )}
      />

      <div
        class="category-grid"
        aria-label={t.integrationRevamp.discovery.categoriesLabel}
      >
        {t.integrationRevamp.discovery.categories.map((category) => (
          <span set:html={formatBrandText(category)} />
        ))}
      </div>
    </div>

    <div class="value-cycle-block">
      <h3 set:html={formatBrandText(t.integrationRevamp.discovery.loopTitle)} />
      <div
        class="value-cycle"
        role="list"
        aria-label={t.integrationRevamp.discovery.loopTitle}
      >
        <div class="cycle-core" aria-label="Pocket Genes">
          <span>
            <span>Pocket</span>
            <span>Genes</span>
          </span>
        </div>
        {cycleItems.map((cycleItem) => (
          <span
            class="cycle-arrow"
            style={`--arrow-angle: ${cycleItem.arrowAngle}; --arrow-color: ${cycleItem.palette.color}; --cycle-delay: ${cycleItem.delay};`}
            aria-hidden="true"
          ></span>
        ))}
        {cycleItems.map((cycleItem, index) => (
          <span
            class="cycle-node"
            role="listitem"
            style={`--cycle-angle: ${cycleItem.angle}; --cycle-angle-back: ${cycleItem.angleBack}; --cycle-color: ${cycleItem.palette.color}; --cycle-soft: ${cycleItem.palette.soft}; --cycle-border: ${cycleItem.palette.border}; --cycle-shadow: ${cycleItem.palette.shadow}; --cycle-delay: ${cycleItem.delay};`}
          >
            <span class="cycle-index">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span
              class="cycle-node-label"
              set:html={formatBrandText(cycleItem.item)}
            />
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .provider-discovery {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 5%;
    overflow: hidden;
  }

  .content-wrapper {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--brand-color);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.06;
  }

  .title-accent,
  .title-main {
    display: block;
  }

  .title-accent {
    color: var(--text-secondary);
    font-size: 0.58em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-description {
    max-width: 700px;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .directory-panel {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1.5rem;
    box-shadow: var(--card-shadow);
  }

  .directory-panel h3 {
    margin: 0 0 1rem;
    color: var(--text-primary);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.2;
  }

  .directory-panel {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .directory-panel > p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }

  .category-grid span {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(175, 130, 50, 0.22);
    border-radius: 1rem;
    background: rgba(175, 130, 50, 0.05);
    color: var(--text-primary);
    font-weight: 700;
    line-height: 1.25;
  }

  .value-cycle-block {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(820px, 100%);
    margin: clamp(0.5rem, 1.5vw, 1rem) auto 0;
    text-align: center;
  }

  .value-cycle-block h3 {
    max-width: 680px;
    margin: 0 auto clamp(0.35rem, 1vw, 0.7rem);
    color: var(--text-primary);
    font-size: clamp(1.45rem, 2.8vw, 2.05rem);
    line-height: 1.12;
    white-space: pre-line;
  }

  .value-cycle {
    --cycle-size: min(100%, 720px);
    --cycle-radius: clamp(8rem, 31vw, 16.2rem);
    --cycle-arrow-radius: clamp(6.6rem, 26vw, 13.8rem);
    --cycle-node-width: clamp(8.7rem, 22vw, 13rem);
    --cycle-track-width: clamp(18px, 2.6vw, 28px);
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: var(--cycle-size);
    aspect-ratio: 1;
    margin: 0 auto;
  }

  .value-cycle::before,
  .value-cycle::after {
    content: '';
    position: absolute;
    border-radius: 50%;
  }

  .value-cycle::before {
    inset: 10%;
    z-index: 0;
    background: conic-gradient(
      from -90deg,
      rgba(228, 80, 128, 0.86) 0deg 58deg,
      transparent 58deg 65deg,
      rgba(20, 149, 143, 0.86) 65deg 130deg,
      transparent 130deg 137deg,
      rgba(33, 118, 174, 0.88) 137deg 202deg,
      transparent 202deg 209deg,
      rgba(60, 155, 104, 0.86) 209deg 274deg,
      transparent 274deg 281deg,
      rgba(217, 146, 50, 0.9) 281deg 353deg,
      transparent 353deg 360deg
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--cycle-track-width) - 1px),
      #000 calc(100% - var(--cycle-track-width)),
      #000 calc(100% - 1px),
      transparent 100%
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--cycle-track-width) - 1px),
      #000 calc(100% - var(--cycle-track-width)),
      #000 calc(100% - 1px),
      transparent 100%
    );
    box-shadow:
      0 30px 70px -44px rgba(17, 24, 39, 0.38),
      inset 0 0 0 1px rgba(17, 24, 39, 0.04);
  }

  .value-cycle::after {
    inset: 8.5%;
    z-index: 1;
    background: repeating-conic-gradient(
      from -86deg,
      transparent 0deg 10deg,
      rgba(255, 255, 255, 0.9) 10deg 12deg,
      transparent 12deg 22deg
    );
    opacity: 0.7;
    filter: drop-shadow(0 0 12px rgba(228, 80, 128, 0.18));
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--cycle-track-width) - 8px),
      #000 calc(100% - var(--cycle-track-width) - 7px),
      #000 calc(100% - 3px),
      transparent calc(100% - 2px)
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - var(--cycle-track-width) - 8px),
      #000 calc(100% - var(--cycle-track-width) - 7px),
      #000 calc(100% - 3px),
      transparent calc(100% - 2px)
    );
    animation: pgValueCycleSpin 18s linear infinite;
  }

  .cycle-core {
    position: relative;
    z-index: 5;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 17vw, 9.2rem);
    aspect-ratio: 1;
    padding: 1rem;
    border-radius: 50%;
    background: transparent;
    color: var(--pocket_genes_pink, #e45080);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    text-shadow: 0 12px 28px rgba(228, 80, 128, 0.24);
    animation: pgCycleCoreBreath 5.2s ease-in-out infinite;
  }

  .cycle-core::before,
  .cycle-core::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .cycle-core::before {
    inset: -0.8rem;
    border: 1px solid rgba(228, 80, 128, 0.24);
    box-shadow:
      0 0 0 8px rgba(228, 80, 128, 0.05),
      0 18px 36px -30px rgba(228, 80, 128, 0.72);
  }

  .cycle-core::after {
    inset: -1.35rem;
    background: conic-gradient(
      from 0deg,
      transparent,
      rgba(228, 80, 128, 0.3),
      transparent 34%,
      transparent
    );
    opacity: 0.72;
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      #000 calc(100% - 1px),
      transparent 100%
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      #000 calc(100% - 1px),
      transparent 100%
    );
    animation: pgValueCycleSpin 11s linear infinite reverse;
  }

  .cycle-core > span > span {
    display: block;
  }

  .cycle-core > span {
    position: relative;
    z-index: 1;
  }

  .cycle-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    width: clamp(1.65rem, 4vw, 2.45rem);
    height: clamp(0.72rem, 2vw, 0.95rem);
    opacity: 0.86;
    transform: translate(-50%, -50%) rotate(var(--arrow-angle))
      translateX(var(--cycle-arrow-radius)) rotate(90deg);
    transform-origin: center;
    animation: pgCycleArrowPulse 3.4s ease-in-out infinite;
    animation-delay: var(--cycle-delay);
  }

  .cycle-arrow::before,
  .cycle-arrow::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .cycle-arrow::before {
    right: 38%;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--arrow-color));
  }

  .cycle-arrow::after {
    right: 0;
    width: clamp(0.55rem, 1.7vw, 0.85rem);
    aspect-ratio: 1;
    background: var(--arrow-color);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    filter: drop-shadow(0 0 8px var(--arrow-color));
  }

  .cycle-node {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 4;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: var(--cycle-node-width);
    min-height: clamp(3.7rem, 7vw, 4.65rem);
    padding: 0.9rem 1.05rem 0.82rem;
    border: 1px solid var(--cycle-border);
    border-radius: 999px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.86)),
      var(--cycle-soft);
    color: var(--text-primary);
    box-shadow:
      0 22px 48px -30px var(--cycle-shadow),
      0 12px 28px -22px rgba(17, 24, 39, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    font-size: clamp(0.78rem, 1.8vw, 0.98rem);
    font-weight: 850;
    line-height: 1.13;
    transform: translate(-50%, -50%) rotate(var(--cycle-angle))
      translate(var(--cycle-radius)) rotate(var(--cycle-angle-back));
    animation: pgCycleNodeFloat 5.6s ease-in-out infinite;
    animation-delay: var(--cycle-delay);
    transition: box-shadow 180ms ease, filter 180ms ease, scale 180ms ease;
  }

  .cycle-node::before {
    content: '';
    position: absolute;
    inset: 0.32rem;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--cycle-soft), transparent 64%);
  }

  .cycle-node::after {
    content: '';
    position: absolute;
    right: 1rem;
    bottom: 0.62rem;
    left: 1rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--cycle-color), transparent);
    opacity: 0.42;
  }

  .cycle-node:hover {
    z-index: 6;
    scale: 1.05;
    filter: saturate(1.12);
    box-shadow:
      0 26px 54px -26px var(--cycle-shadow),
      0 18px 34px -24px rgba(17, 24, 39, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);
  }

  .cycle-index {
    position: absolute;
    top: -0.54rem;
    left: 1.1rem;
    display: inline-flex;
    min-width: 1.8rem;
    min-height: 1.8rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cycle-border);
    border-radius: 999px;
    background: #ffffff;
    color: var(--cycle-color);
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1;
  }

  .cycle-node-label {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 100%;
  }

  .cycle-node-label :global(.pg-brand-name) {
    display: block;
    margin-top: 0.1rem;
    font-weight: 900;
  }

  @keyframes pgValueCycleSpin {
    to {
      rotate: 1turn;
    }
  }

  @keyframes pgCycleArrowPulse {
    0%,
    100% {
      opacity: 0.42;
      scale: 0.92;
    }

    45%,
    60% {
      opacity: 1;
      scale: 1.08;
    }
  }

  @keyframes pgCycleNodeFloat {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -7px;
    }
  }

  @keyframes pgCycleCoreBreath {
    0%,
    100% {
      scale: 1;
      text-shadow: 0 12px 28px rgba(228, 80, 128, 0.22);
    }

    50% {
      scale: 1.04;
      text-shadow: 0 16px 34px rgba(228, 80, 128, 0.34);
    }
  }

  @media (max-width: 960px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .provider-discovery {
      padding: clamp(2.75rem, 8vw, 4rem) 5%;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .value-cycle-block {
      width: min(25rem, 100%);
      margin-top: 0;
    }

    .value-cycle {
      --cycle-size: min(100%, 24rem);
      --cycle-radius: clamp(6rem, 29vw, 7.4rem);
      --cycle-arrow-radius: clamp(5.05rem, 24vw, 6.45rem);
      --cycle-node-width: clamp(6.5rem, 31vw, 8.4rem);
      --cycle-track-width: clamp(12px, 4vw, 17px);
    }

    .cycle-core {
      width: clamp(5rem, 21vw, 6.25rem);
      padding: 0.75rem;
      font-size: clamp(0.82rem, 3vw, 0.98rem);
    }

    .cycle-arrow {
      width: clamp(1.15rem, 4.8vw, 1.55rem);
      height: clamp(0.55rem, 2.6vw, 0.7rem);
    }

    .cycle-node {
      min-height: 3.3rem;
      padding: 0.7rem 0.56rem 0.64rem;
      font-size: clamp(0.68rem, 2.7vw, 0.78rem);
    }

    .cycle-index {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-cycle::after,
    .cycle-core,
    .cycle-core::after,
    .cycle-arrow,
    .cycle-node {
      animation: none;
    }
  }
</style>
